}]);
'use strict'; // User controller

angular.module('users').controller('UsersController', ['$stateParams', '$state', '$location', 'Authentication', 'BusinessService', 'Outlets', 'Users', 'UserService', 'FhdMessenger', 'UserPhotoService', 'NgTableParams', '$http', 'Address', 'WorkDepartmentService', 'WorkPositions', function ($stateParams, $state, $location, Authentication, BusinessService, Outlets, Users, UserService, FhdMessenger, UserPhotoService, NgTableParams, $http, Address, WorkDepartmentService, WorkPositions) {
  const vm = this;
  vm.authentication = Authentication;
  vm.theUser = Authentication.user;
  vm.isShow = _.intersection(vm.theUser.roles, ['admin', 'tro-ly-ns']).length;
  vm.writerBadgeLevels = [0, 1, 2, 3];

  function getCity(district) {
    if (district.includes('Hồ Chí Minh')) {
      return 'TP. Hồ Chí Minh';
    }

    return 'Hà Nội';
  }

  vm.getWard = () => {
    vm.user.residentialAddress = vm.user.residentialAddress || {};
    vm.user.residentialAddress.city = getCity(vm.district);
    vm.user.residentialAddress.district = _.head(vm.district.split(','));
    vm.data.currentWards = vm.data.wards[vm.user.residentialAddress.city][vm.user.residentialAddress.district];
  };

  vm.init = () => {
    vm.data = vm.data || {};
    vm.data.districts = Address.getDistricts();
    vm.data.outlets = Outlets.query();
    BusinessService.allAsync().then(businesses => {
      vm.data.businesses = businesses;
    });
    WorkDepartmentService.allAsync().then(workDepartments => {
      vm.data.workDepartments = workDepartments;
    });
    WorkPositions.query().$promise.then(workPositions => {
      vm.data.workPositions = workPositions;
    });
    vm.getRole = UserService.getRoleMap().then(roleMap => {
      vm.roleMap = _.assign({}, roleMap, {
        'rank-a': true,
        user: true,
        staff: true,
        employee: true
      });
    });
    UserService.getRolesInTypes().then(roleTypes => {
      vm.roleTypes = roleTypes;
      vm.rolePositionsMap = _.find(vm.roleTypes, {
        id: 'positions'
      }).roles;
      vm.rolePositions = _.map(vm.rolePositionsMap, 'id');
    });
    UserService.getRoleHideMap().then(roleHideMap => {
      vm.roleHideMap = roleHideMap;
    });
  };

  vm.update = function () {
    const rolesValue = _.reduce(vm.roleMap, (rolesValue, toShow, role) => {
      if (toShow) rolesValue.push(role);
      return rolesValue;
    }, []);

    if (!_.get(vm.user.businesses, 'length', 0)) {
      return FhdMessenger.error('Người dùng chưa có business');
    }

    vm.user.business = _.head(vm.user.businesses);

    if (!(rolesValue.includes('outlet') || vm.user.roles.includes('deleted')) && !_.intersection(rolesValue, vm.rolePositions).length) {
      return FhdMessenger.error('Người dùng phải có ít nhất một quyền tại Positions');
    }

    vm.user.roles = rolesValue;
    vm.user.residentialAddress.address = `${vm.user.residentialAddress.city}, ${vm.user.residentialAddress.district}, ${vm.user.residentialAddress.ward}, ${vm.user.residentialAddress.street}`;
    vm.waiting = true;

    if (vm.theUser.roles.includes('admin')) {
      vm.user.$update(function () {
        $location.path('users');
      }, function (errorResponse) {
        vm.waiting = false;
        vm.error = errorResponse.data.message;
        FhdMessenger.error(vm.error);
      });
    } else if (!vm.isShow && !_.includes(vm.theUser.roles, 'tro-ly-ns')) {
      vm.user.$updateImage(function () {
        $location.path('users');
      }, function (errorResponse) {
        vm.waiting = false;
        vm.error = errorResponse.data.message;
        FhdMessenger.error(vm.error);
      });
    } else {
      vm.user.$updateByAssistant(function () {
        $location.path('users');
      }, function (errorResponse) {
        vm.waiting = false;
        vm.error = errorResponse.data.message;
        FhdMessenger.error(vm.error);
      });
    }
  };

  vm.choosePhotos = function () {
    UserPhotoService.view().then(photos => {
      photos.forEach(photo => vm.user.images.push({
        link: photo.link
      }));
    });
  };

  vm.addUserImage = newImage => {
    if (newImage) {
      vm.user.images.push({
        data: newImage
      });
    }
  };

  vm.removeUserImage = index => {
    vm.user.images.splice(index, 1);
  }; //


  vm.findOne = function () {
    vm.user = Users.get({
      userId: $stateParams.userId
    });
    vm.user.$promise.then(() => {
      vm.getRole.then(() => {
        vm.user.roles.forEach(role => {
          if (role !== 'deleted') {
            vm.roleMap[role] = true;
          }
        });
      });
      vm.user.residentialAddress = vm.user.residentialAddress || {};
      Address.getWards().then(wards => {
        const district = _.get(vm.user, 'residentialAddress.district');

        if (district) {
          vm.district = _.find(vm.data.districts, {
            district
          });
        }

        vm.data.wards = wards;
      });
      vm.isShowUploadImage = true;

      if (!_.get(vm.user.businesses, 'length', 0)) {
        vm.user.businesses = [vm.user.business];
      }

      if (vm.theUser.outlet._id !== vm.user.outlet._id && !_.includes(_.map(vm.theUser.managingOutlets, '_id'), vm.user.outlet._id) && !_.includes(vm.theUser.roles, 'tro-ly-ns') && !_.includes(vm.theUser.roles, 'admin')) {
        vm.isShowUploadImage = false;
        FhdMessenger.error('Bạn không thể chỉnh sửa thông tin cho nhân viên này');
      }
    });
  };

  vm.removeOutlet = function (index) {
    vm.user.managingOutlets.splice(index, 1);
  };

  vm.removeBusiness = function (index) {
    vm.user.businesses.splice(index, 1);
  };

  vm.removeWorkDepartment = function (index) {
    vm.user.workDepartments.splice(index, 1);
  };

  vm.removeWorkPosition = function (index) {
    vm.user.workPositions.splice(index, 1);
  };

  vm.changeWorkDepartment = choosenWorkDepartment => {
    vm.workDepartment = null;
    vm.user.workDepartments = vm.user.workDepartments || [];

    if (!_.some(vm.user.workDepartments, workDepartment => _.isEqual(workDepartment._id, choosenWorkDepartment._id))) {
      vm.user.workDepartments.push(choosenWorkDepartment);
    }
  };

  vm.changeWorkPosition = choosenWorkPosition => {
    vm.workPosition = null;
    vm.user.workPositions = vm.user.workPositions || [];

    if (!_.some(vm.user.workPositions, workPosition => _.isEqual(workPosition._id, choosenWorkPosition._id))) {
      vm.user.workPositions.push(choosenWorkPosition);

      _.forEach(choosenWorkPosition.roles, role => {
        vm.roleMap[role] = true;
      });
    }
  };

  vm.changeBusiness = function () {
    vm.user.businesses = vm.user.businesses || [];
    vm.user.businesses.push(vm.business);
    vm.user.businesses = _.union(vm.user.businesses);
  };

  vm.addManagingOutlet = function () {
    const managingOutlet = vm.managingOutlet;
    vm.user.managingOutlets = vm.user.managingOutlets || [];
    vm.managingOutlet = null;

    if (_.some(vm.user.managingOutlets, outlet => {
      return outlet._id === managingOutlet._id;
    })) {
      return;
    }

    vm.user.managingOutlets.push(managingOutlet);
  };

  vm.searchStaff = function (user) {
    $state.go('viewUserRankAPoint', {
      userId: user._id
    });
  };
}]);
"use strict";

angular.module('users').controller('ViewMyAngelController', ['$http', 'FhdMessenger', 'Settings', 'Authentication', function ($http, FhdMessenger, Settings, Authentication) {
  const vm = this;
  vm.data = {};
  vm.data.settings = Settings.get();
  vm.user = Authentication.user;
  $http.get('/users/my-angel').then(response => {
    vm.angel = _.get(response, 'data.angel');
  }).catch(FhdMessenger.errorFromServer);

  vm.toggleAllowViewMyAngel = () => {
    FhdMessenger.info('Đang cập nhật...');
    vm.waiting = true;
    vm.data.settings.$toggleAllowViewMyAngel().then(settings => {
      const {
        allowViewMyAngel
      } = settings;
      const action = allowViewMyAngel ? 'mở' : 'đóng';
      FhdMessenger.success(`Đã ${action}`);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
