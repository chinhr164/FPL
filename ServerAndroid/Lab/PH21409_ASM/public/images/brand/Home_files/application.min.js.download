angular.module('leave-requests').controller('LeaveRequestsController', ['$stateParams', 'Authentication', 'LeaveRequests', 'LeaveRequestService', 'FhdMessenger', 'NgTableParams', '$state', function ($stateParams, Authentication, LeaveRequests, LeaveRequestService, FhdMessenger, NgTableParams, $state) {
  const vm = this;
  vm.leaveRequestsTable = new NgTableParams();
  vm.staffTable = new NgTableParams({
    count: 100
  });
  vm.user = Authentication.user;
  vm.leaveRequest = {
    type: 'Lịch cá nhân',
    reason: '',
    relative: '',
    leaveDays: 0,
    detail: '',
    startDate: null,
    endDate: null
  };
  vm.startDate = moment().subtract(1, 'years').format('YYYY-MM-DD');
  vm.endDate = moment().format('YYYY-MM-DD');
  vm.month = moment().format('YYYY-MM-DD');
  vm.leaveReasons = _.sortBy(['Nghỉ ốm', 'Lý do khác', 'Nghỉ đột xuất', 'Người thân mất', 'Du lịch', 'Nghỉ thai sản (bố)', 'Nghỉ thai sản (mẹ)', 'Làm việc tại nhà (WFH)', 'Nghỉ bù làm thêm', 'Nghỉ nửa buổi', 'Kết hôn', 'Con đẻ, con nuôi kết hôn']);

  vm.showRequire = () => {
    if (!_.get(vm.leaveRequest, 'type') || !_.get(vm.leaveRequest, 'reason')) {
      return false;
    }

    if (vm.leaveRequest.type !== 'Lịch nghỉ lễ công ty' && !['Nghỉ ốm', 'Nghỉ đột xuất', 'Nghỉ nửa buổi', 'Người thân mất', 'Làm việc tại nhà (WFH)'].includes(vm.leaveRequest.reason)) {
      return true;
    }

    return false;
  };

  vm.leaveTypes = ['Lịch cá nhân'];

  if (vm.user.roles.includes('leave-request:create-holiday')) {
    vm.leaveTypes.push('Lịch nghỉ lễ công ty');
  }

  vm.statuses = ['Chưa duyệt', 'Đã duyệt', 'Đã từ chối', 'Đã xóa'];
  vm.statusFilter = _.map(vm.statuses, status => {
    return {
      id: status,
      title: status
    };
  });
  vm.statusMap = _.reduce(vm.statuses, (result, status) => {
    result[status] = status === 'Chưa duyệt';
    return result;
  }, {});
  vm.relatives = ['bố/mẹ đẻ', 'bố/mẹ nuôi', 'con', 'vợ/chồng', 'người thân khác']; // Create new Leave request

  vm.create = function () {
    const validate = LeaveRequestService.validate(vm.leaveRequest, 'create');

    if (validate) {
      return FhdMessenger.error(validate);
    }

    vm.waiting = true;
    const leaveRequest = new LeaveRequests(vm.leaveRequest);
    leaveRequest.$save().then(response => {
      FhdMessenger.success('Tạo leave request thành công');
      vm.leaveRequest = null;
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }; // Edit Leave request


  vm.update = function () {
    const validate = LeaveRequestService.validate(vm.leaveRequest, 'update');

    if (validate) {
      return FhdMessenger.error(validate);
    }

    vm.waiting = true;
    const leaveRequest = new LeaveRequests(vm.leaveRequest);
    leaveRequest.$update().then(response => {
      FhdMessenger.success('Sửa leave request thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
      $state.go('listLeaveRequests');
    });
  }; // Tính ngày nghỉ phép


  vm.calculateLeaveDays = function () {
    if (!vm.leaveRequest.startDate || !vm.leaveRequest.endDate) {
      return;
    }

    vm.leaveRequest.leaveDays = moment(vm.leaveRequest.endDate).startOf('day').diff(moment(vm.leaveRequest.startDate).startOf('day'), 'days') + 1;

    _.forEach(_.range(vm.leaveRequest.leaveDays), date => {
      if (moment(vm.leaveRequest.startDate).add(date, 'days').day() === 0) {
        vm.leaveRequest.leaveDays -= 1;
      }
    });
  };

  vm.getMyLeaveDayRemain = function () {
    LeaveRequests.getMyLeaveDayRemain().$promise.then(res => {
      vm.usedLeaveDays = res.usedLeaveDays;
    });
  };

  vm.approve = function (leaveRequest) {
    vm.waiting = true;
    leaveRequest.$approve().then(() => {
      vm.leaveRequest.status = 'Đã duyệt';
      FhdMessenger.success('Duyệt leave request thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.disapprove = function (leaveRequest) {
    vm.waiting = true;
    leaveRequest.$disapprove().then(() => {
      vm.leaveRequest.status = 'Đã từ chối';
      FhdMessenger.success('Đã từ chối leave request');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.remove = function (leaveRequest) {
    vm.waiting = true;
    leaveRequest.$remove().then(() => {
      FhdMessenger.success('Đã xóa leave request');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.onSelectAllStatus = () => {
    let changeValue = true;
    if (_.every(vm.statusMap)) changeValue = false;

    _.forEach(vm.statusMap, (value, key) => {
      vm.statusMap[key] = changeValue;
    });
  }; // Find a list of Leave requests


  vm.find = function () {
    const statuses = _.reduce(vm.statuses, (result, status) => {
      if (vm.statusMap[status]) result.push(status);
      return result;
    }, []);

    vm.waiting = true;
    vm.leaveRequestsTable.settings({
      dataset: []
    });
    vm.leaveRequests = LeaveRequests.query({
      startDate: moment(vm.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.endDate).format('YYYY-MM-DD'),
      statuses
    });
    vm.leaveRequests.$promise.then(() => {
      vm.leaveRequestsTable.settings({
        dataset: vm.leaveRequests
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.calendar = function () {
    vm.waiting = true;
    vm.leaveRequests = LeaveRequests.calendar({
      month: moment(vm.month).format('YYYY-MM-DD')
    });
    const startDate = moment(vm.month).startOf('month');
    const length = moment(vm.month).endOf('month').diff(startDate, 'day') + 1;
    vm.formattedDates = _.range(length).map((offset, index) => {
      const date = moment(startDate).add(offset, 'day');
      return {
        date: moment(date).format('D/M'),
        day: moment(date).format('ddd')
      };
    });
    vm.leaveRequests.$promise.finally(() => {
      vm.waiting = false;
    });
  };

  vm.summary = function () {
    LeaveRequests.summary({}).$promise.then(staffs => {
      vm.staffTable.settings({
        dataset: staffs
      });
    });
  }; // Find an existing Leave request


  vm.findOne = function () {
    vm.leaveRequest = LeaveRequests.get({
      leaveRequestId: $stateParams.leaveRequestId
    });
  };
}]);
'use strict';

angular.module('leave-requests').factory('LeaveRequestService', [function () {
  return {
    validate(leaveRequest, method) {
      if (!leaveRequest.reason) {
        return 'Vui lòng chọn lý do';
      }

      if (leaveRequest.type !== 'Lịch nghỉ lễ công ty' && !leaveRequest.detail.trim().length) {
        return 'Vui lòng nhập lý do cụ thể';
      }

      if (!leaveRequest.startDate || !leaveRequest.endDate) {
        return 'Ngày bắt đầu hoặc ngày kết thúc không được để trống';
      }

      if (moment(leaveRequest.startDate).isAfter(moment(leaveRequest.endDate))) {
        return 'Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu';
      }

      if (leaveRequest.leaveDays > 5) {
        return 'Số ngày nghỉ liên tiếp không được quá 5 ngày';
      }

      if (method === 'create' && !['Nghỉ ốm', 'Nghỉ đột xuất', 'Nghỉ nửa buổi', 'Người thân mất', 'Nghỉ thai sản (bố)', 'Nghỉ thai sản (mẹ)', 'Làm việc tại nhà (WFH)'].includes(leaveRequest.reason) && moment(leaveRequest.startDate).startOf('day').diff(moment().startOf('day'), 'days') < 7) {
        return 'Leave Request phải được tạo trước 1 tuần';
      }

      if (leaveRequest.reason === 'Người thân mất' && !leaveRequest.relative) {
        return 'Vui lòng chọn người mất';
      }
    }

  };
}]);
'use strict'; // Leave requests service used to communicate Leave requests REST endpoints

angular.module('leave-requests').factory('LeaveRequests', ['$resource', function ($resource) {
  return $resource('leave-requests/:leaveRequestId', {
    leaveRequestId: '@_id'
  }, {
    approve: {
      method: 'PUT',
      url: 'leave-requests/:leaveRequestId/approve'
    },
    disapprove: {
      method: 'PUT',
      url: 'leave-requests/:leaveRequestId/disapprove'
    },
    getMyLeaveDayRemain: {
      method: 'GET',
      url: 'leave-requests/my-leave-day-remain'
    },
    summarize: {
      url: 'leave-requests/summarize',
      isArray: true
    },
    calendar: {
      url: 'leave-requests/calendar',
      isArray: true
    },
    summary: {
      url: 'leave-requests/summary',
      isArray: true
    },
    update: {
      method: 'PUT'
    }
  });
}]);
