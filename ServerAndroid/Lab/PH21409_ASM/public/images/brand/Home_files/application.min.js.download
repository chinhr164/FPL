angular.module('tet-categories').factory('TetCategoriesService', ['TetCategories', '$modal', function (TetCategories, $modal) {
  let tetCategories;

  function openCreateTetCategoryModal() {
    return $modal.open({
      templateUrl: 'modules/tet-categories/templates/modal-create-tet-category.client.view.html',
      controller: 'ModalCreateTetCategoryController',
      controllerAs: 'vm'
    });
  }

  return {
    getTags() {
      return TetCategories.query().$promise.then(tetCategories => _.map(tetCategories.sort((a, b) => {
        return a.name.localeCompare(b.name);
      }), tetCategory => ({
        id: tetCategory.name,
        title: tetCategory.name
      })));
    },

    getTetCategories() {
      if (!tetCategories) tetCategories = TetCategories.query();
      return tetCategories;
    },

    validateTetCategory(tetCategory) {
      if (!tetCategory.name) {
        return 'Bạn chưa nhập tên tết category';
      }
    },

    openCreateTetCategoryModal
  };
}]);
