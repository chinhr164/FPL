}]).controller('FhdOutletInputController', ['$scope', 'OutletService', 'Authentication', 'FhdMessenger', 'ObjectId', 'CurrentShift', function ($scope, OutletService, Authentication, FhdMessenger, ObjectId, CurrentShift) {
  const user = Authentication.user;
  const vm = $scope;
  vm.data = {
    loading: true
  };
  vm.nullOutlet = {
    code: '',
    name: '== Chưa chọn =='
  };
  vm.loadDefault = _.isUndefined(vm.loadDefault) ? true : vm.loadDefault;
  vm.showExtendOutlet = _.isUndefined(vm.showExtendOutlet) ? false : vm.showExtendOutlet;
  vm.noDefault = _.isUndefined(vm.noDefault) ? false : vm.loadDefault;
  vm.emptyOption = _.isUndefined(vm.emptyOption) ? true : vm.emptyOption;
  vm.toDisable = false;
  vm.allowedOutletCodes = _.isEmpty(vm.allowedOutletCodes) ? [] : vm.allowedOutletCodes;

  if (vm.disableExceptAdmin && !_.includes(user.roles, 'admin') && !_.get(user.managingOutlets, 'length')) {
    vm.toDisable = true;
  }

  function processOutlet(outlets) {
    const nullOutlet = _.find(outlets, {
      code: 'Không'
    }) || [];

    if (vm.isStorage) {
      return _.filter(outlets, {
        isStorage: true
      }).concat(nullOutlet);
    }

    if (vm.isPos) {
      return _.filter(outlets, outlet => {
        return outlet.sellBirthdayCake || outlet.isPos;
      }).concat(nullOutlet);
    }

    if (vm.isManufacturing) {
      return _.filter(outlets, {
        isManufacturing: true
      }).concat(nullOutlet);
    }

    if (vm.hasStaff) {
      return _.filter(outlets, {
        hasStaff: true
      }).concat(nullOutlet);
    }

    if (vm.isWarehouse) {
      return _.filter(outlets, outlet => outlet.code && (outlet.code.match(/^[DB]\d+/) || outlet.code.match(/^KHO/) || outlet.code.match(/^G1/) || outlet.isWarehouse)).concat(nullOutlet);
    }

    if (vm.isKitchen) {
      return _.filter(outlets, outlet => outlet.code && outlet.isKitchen).concat(nullOutlet);
    }

    if (vm.isSavorKitchen) {
      return _.filter(outlets, outlet => ['B1', 'B4'].includes(outlet.code));
    }

    if (_.get(user, 'managingOutlets.length', 0) && vm.disableExceptAdmin) {
      return _.filter(outlets, outlet => _.some(user.managingOutlets, managingOutlet => {
        return ObjectId.equals(outlet, managingOutlet);
      }));
    }

    if (vm.allowedOutletCodes.length) {
      const allowedOutletCodesMap = _.reduce(vm.allowedOutletCodes, (result, outletCode) => {
        result[outletCode] = true;
        return result;
      }, {});

      return _.filter(outlets, outlet => {
        return allowedOutletCodesMap[outlet.code];
      });
    }

    return outlets;
  }

  function getOutletsAsync() {
    if (vm.emptyOption) return OutletService.withAllOptionAsync();
    return OutletService.allAsync();
  }

  vm.getOutlets = getOutletsAsync().then(processOutlet).then(outlets => {
    let _outlets = outlets;

    if (!vm.showExtendOutlet) {
      _outlets = _.reject(_outlets, outlet => {
        return ['ABBY', 'SAVOR'].includes(_.get(outlet, 'code', ''));
      });
    }

    const sortedOutlets = _.sortBy(_.reduce(_outlets, (result, outlet) => {
      if (_.get(outlet, 'code') && _.get(outlet, 'code', 'W').match(/[MESBD]\d+/)) {
        outlet.priority = Number(outlet.code.slice(1));
        outlet.codeText = outlet.code.slice(0, 1);
      } else {
        outlet.codeText = outlet.code;
      }

      result.push(outlet);
      return result;
    }, []), ['codeText', 'priority']);

    return sortedOutlets;
  }).catch(FhdMessenger.errorFromServer);

  vm.getDefaultOutlet = () => {
    vm.getOutlets.then(function (outlets) {
      vm.data.loading = false;
      vm.data.outlets = outlets;

      if (vm.outlet) {
        const matchOutlet = _.find(outlets, {
          _id: ObjectId.getObjectId(vm.outlet)
        });

        if (_.get(matchOutlet, '_id')) {
          return matchOutlet;
        } else {
          return vm.outlet;
        }
      }

      const currentShift = CurrentShift.getCurrentShift();

      if (vm.loadDefault && currentShift) {
        const matchOutlet = _.find(outlets, {
          _id: ObjectId.getObjectId(currentShift.outlet)
        });

        if (matchOutlet) return matchOutlet;
      }

      if (vm.loadDefault && vm.isManufacturing && _.get(user, 'managingOutlets.length')) {
        const matchOutlet = _.find(user.managingOutlets, managingOutlet => {
          return _.some(outlets, {
            _id: ObjectId.getObjectId(managingOutlet)
          });
        });

        if (matchOutlet) return _.find(outlets, {
          _id: ObjectId.getObjectId(matchOutlet)
        });
      }

      if (vm.loadDefault && vm.isWarehouse && _.get(user, 'managingOutlets.length')) {
        const matchOutlet = _.find(user.managingOutlets, managingOutlet => {
          return _.some(outlets, {
            _id: ObjectId.getObjectId(managingOutlet)
          });
        });

        if (matchOutlet) return _.find(outlets, {
          _id: ObjectId.getObjectId(matchOutlet)
        });
      }

      if (vm.loadDefault && user.outlet && !vm.noDefault) {
        const matchUserOutlet = _.find(outlets, outlet => ObjectId.equals(outlet, user.outlet));

        if (matchUserOutlet) return matchUserOutlet;

        const matchUserManagingOutlet = _.find(outlets, outlet => {
          return _.some(user.managingOutlets, managingOutlet => ObjectId.equals(managingOutlet, outlet));
        });

        if (matchUserManagingOutlet) {
          return matchUserManagingOutlet;
        }

        const matchDefaultOutlet = _.find(outlets, {
          code: vm.defaultOutletCode
        });

        if (matchDefaultOutlet) {
          return matchDefaultOutlet;
        }

        const outlet = OutletService.loadDefaultOutlet(user, outlets);

        if (outlet) {
          return outlet;
        }
      }

      if (vm.defaultOutletCode) {
        let outlet = _.find(outlets, {
          code: vm.defaultOutletCode
        });

        if (outlet) return outlet;
      }

      return vm.nullOutlet;
    }).then(outlet => {
      vm.outlet = outlet;

      if (vm.outlet) {
        vm.outletSearch = outlet.code + ' - ' + outlet.name;
      } else {
        vm.outletSearch = '== Chưa chọn ==';
      }

      return outlet;
    });
  };

  vm.outletSearchSelected = outlet => {
    if (outlet.code === 'Không') {
      vm.outlet = vm.nullOutlet;
    } else {
      vm.outlet = outlet;

      if (vm.onSelect) {
        vm.onSelect(vm.outlet);
      }
    }
  };

  vm.remove = () => {
    vm.outletSearch = '== Chưa chọn ==';
    vm.outlet = null;
  };

  if (vm.onChange) {
    $scope.$watch('outlet', (newValue, oldValue) => {
      if (newValue !== oldValue && newValue) vm.onChange(vm.outlet);
    });
