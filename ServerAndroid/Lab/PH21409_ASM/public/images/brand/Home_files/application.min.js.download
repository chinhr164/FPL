angular.module('thumb-ups').factory('ThumbUpService', ['$modal', function ($modal) {
  function addThumbUpModal(userId, options = {}) {
    return $modal.open({
      templateUrl: 'modules/thumb-ups/views/modal-create-thumb-ups.client.view.html',
      controller: 'ModalCreateThumbUpController',
      controllerAs: 'vm',
      resolve: {
        userId: () => userId,
