}]);
'use strict'; // Shift requests controller

angular.module('shift-requests').controller('ShiftRequestsController', ['$stateParams', '$location', 'Authentication', 'ShiftRequests', 'ShiftEntries', 'toaster', '$http', 'ResourcesService', function ($stateParams, $location, Authentication, ShiftRequests, ShiftEntries, toaster, $http, ResourcesService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.data = {};
  vm.shiftRequest = {};

  function processShiftRequest(_shiftRequest) {
    return {
      shiftEntry: vm.shiftEntry._id,
      content: _shiftRequest.content,
      replaceStaff: _shiftRequest.replaceStaff._id
    };
  }

  vm.approvable = function () {
    return _.some(vm.shiftRequest.receivers, {
      _id: vm.authentication.user._id
    });
  };

  vm.approve = function (shiftRequest) {
    $http.get('/shift-requests/' + shiftRequest._id + '/approve').success(function (response) {
      toaster.success('Ok');
      shiftRequest.approvers.push(vm.authentication.user);

      if (shiftRequest.approvers.length >= 2) {
        shiftRequest.status = 'approved';
      }
    }).error(function (errorResponse) {
      toaster.error(errorResponse.message);
    });
  }; // Create new Shift request


  vm.create = function () {
    // Create new Shift request object
    const shiftRequest = new ShiftRequests(processShiftRequest(vm.shiftRequest)); // Redirect after save

    shiftRequest.$save(function (response) {
      $location.path('shift-requests/' + response._id); // Clear form fields

      vm.name = '';
    }, function (errorResponse) {
      toaster.error(errorResponse.data.message);
    });
  }; // Remove existing Shift request


  vm.remove = function (shiftRequest) {
    if (shiftRequest) {
      shiftRequest.$remove();

      for (var i in vm.shiftRequests) {
        if (vm.shiftRequests[i] === shiftRequest) {
          vm.shiftRequests.splice(i, 1);
        }
      }
    } else {
      vm.shiftRequest.$remove(function () {
        $location.path('shift-requests');
      });
    }
  }; // Find shift entry


  vm.findShiftEntry = function () {
    vm.shiftEntry = ShiftEntries.get({
      shiftEntryId: $stateParams.shiftEntryId
    });
  }; // Update existing Shift request


  vm.update = function () {
    var shiftRequest = vm.shiftRequest;
    shiftRequest.$update(function () {
      $location.path('shift-requests/' + shiftRequest._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of Shift requests


  vm.find = function () {
    vm.shiftRequests = ShiftRequests.query();
  }; // Find existing Shift request


  vm.findOne = function () {
    vm.shiftRequest = ShiftRequests.get({
      shiftRequestId: $stateParams.shiftRequestId
    });
  };
}]);
'use strict'; // Shift requests service used to communicate Shift requests REST endpoints

angular.module('shift-requests').factory('ShiftRequests', ['$resource', function ($resource) {
  return $resource('shift-requests/:shiftRequestId', {
    shiftRequestId: '@_id'
  }, {
    update: {
      method: 'PUT'
    }
  });
}]);
"use strict";

angular.module('shipping').factory('ShippingFee', ['$q', '$http', function ($q, $http) {
  let viettelShippingFee;
  let administrativeDivision;

  async function loadShippingFeeAndArea() {
    await $http.get('/online-orders/get-shipping-fee-and-area').then(response => {
      viettelShippingFee = response.data.viettelShippingFee;
      administrativeDivision = response.data.administrativeDivision;
    });
  }

  async function calculateExpectedCollect({
    orderValue,
    city,
    shipping,
    payment,
    orderType,
    created,
    district,
    deadline,
    outlet,
    ward
  }) {
    const womanDay = moment('2023-03-08');
    const freeShippingObj = {
      shipping: 0,
      payment: 0
    };

    if (orderType === 'ORDER') {
      if (deadline && moment(deadline).startOf('day').isSame(moment(womanDay).startOf('day'))) {
        if (shipping.provider === 'Giao tại cửa hàng' && moment(created).isBefore(womanDay)) {
          return freeShippingObj;
        }

        return {
          shipping: 35000,
          payment: 0
        };
      }

      if (orderValue >= 220000) {
        return freeShippingObj;
      }

      if (shipping.provider === 'Giao tại cửa hàng') {
        return freeShippingObj;
      }

      return {
        shipping: 20000,
        payment: 0
      };
    }

    if (shipping.provider === 'Giao tại cửa hàng') {
      return freeShippingObj;
    }

    if (orderType === 'NN' || orderType === 'TT') {
      return freeShippingObj;
    }

    const upperCaseCity = _.isString(city) ? city.toUpperCase() : city;

    if (upperCaseCity.match(/TP\. HỒ CHÍ MINH/i) && upperCaseCity.match(/Nội thành/gim)) {
      if (orderValue >= 990000) {
        return freeShippingObj;
      }

      return {
        shipping: 45000,
        payment: 0
      };
    }

    if (upperCaseCity === 'Hà Nội (Nội thành)'.toUpperCase()) {
      if (orderValue >= 990000) {
        return freeShippingObj;
      }

      return {
        shipping: 45000,
        payment: 0
      };
    }

    if (shipping.provider === 'Viettel') {
      let paymentCollect = 0;

      const service = _.get(shipping, 'service', '');

      const weight = _.get(shipping, 'weight', 1000);

      if (!viettelShippingFee || !administrativeDivision) {
        await loadShippingFeeAndArea();
      }

      const matchAdministrativeDivision = _.find(administrativeDivision, {
        district
      });

      if (matchAdministrativeDivision) {
        let vietteWeight = 250;

        if (weight > 250) {
          vietteWeight = 500;
        }

        let region = upperCaseCity.match(/Hà nội/gim) ? 'HN' : matchAdministrativeDivision.region;

        const matchViettelShippingFee = _.find(viettelShippingFee, _viettelShippingFee => {
          if (region === 'HN') {
            return service === _viettelShippingFee.service && _viettelShippingFee.region === region;
          }

          return service === _viettelShippingFee.service && vietteWeight === _viettelShippingFee.weight && _viettelShippingFee.region === region && _viettelShippingFee.viettelShippingArea === matchAdministrativeDivision.viettelShippingArea;
        });

        if (matchViettelShippingFee) {
          let shippingFee = matchViettelShippingFee.fixCharge + Math.max(0, weight - matchViettelShippingFee.overweight) * matchViettelShippingFee.overweightChargePerGram;

          if ([2, 3].includes(matchAdministrativeDivision.viettelShippingArea)) {
            shippingFee += Math.max(weight - matchViettelShippingFee.surchargeWeight, 0) * matchViettelShippingFee.surchargePerGram;
          }

          return {
            shipping: shippingFee,
            payment: paymentCollect
          };
        }
      }
    }

    if (shipping.provider === 'GHTK') {
      let paymentCollect = 20000;

      if (payment.method === 'transfer') {
        paymentCollect = 0;
      }

      if (moment(created).isBefore('2020-04-12')) {
        if (orderValue >= 250000) return {
          shipping: 0,
          payment: paymentCollect
        };
        if (orderValue >= 150000) return {
          shipping: 40000,
          payment: paymentCollect
        };
        if (orderValue >= 100000) return {
          shipping: 25000,
          payment: paymentCollect
        };
      } else {
        if (orderValue >= 700000) return {
          shipping: 20000,
          payment: paymentCollect
        };
        if (orderValue >= 400000) return {
          shipping: 30000,
          payment: paymentCollect
        };
        if (orderValue >= 200000) return {
          shipping: 50000,
          payment: paymentCollect
        };
      }
    }

    if (shipping.provider === 'Gửi nhà xe') {
      if (orderType === 'BUON' && orderValue >= 500000) {
        return freeShippingObj;
      }

      if (orderType === 'HN' && orderValue >= 200000) {
        return freeShippingObj;
      }

      return {
        shipping: 20000,
        payment: 0
      };
    }

    return null;
  }

  return {
    /**
      Get expected shipping and payment collect
      Result are wrapped in a promise for future server respond
      @param {Number} saleTotal Total sale
      @param {String} city
      @param {} shippingDetails { provider: String }
      @param {} paymentDetails { method: String }
    */
    async getExpectedCollect({
      orderValue = 0,
      city = null,
      shipping = null,
      payment = null,
      orderType = 'HN',
      // HN, TI, BUON
      created = moment().toDate(),
      district = null,
      outlet,
      deadline,
      ward
    }) {
      if (!_.isFinite(orderValue)) return $q.reject('Không có dữ liệu giá trị đơn hàng.');
      if (!_.isString(city)) return $q.reject('Không có dữ liệu thành phố.');
      if (!_.get(shipping, 'provider')) return $q.reject('Không có dữ liệu đơn vị vận chuyển.');
      if (!_.get(payment, 'method')) return $q.reject('Không có dữ liệu phương thức thanh toán.');
      if (!_.isString(orderType)) return $q.reject('Không có dữ liệu loại đơn hàng.');
      const uppercaseCity = _.isString(city) ? city.toUpperCase() : city;

      if (uppercaseCity === 'TP. HỒ CHÍ MINH (NỘI THÀNH)' || uppercaseCity === 'TP. HỒ CHÍ MINH') {
        if (!_.isString(district)) return $q.reject('Chưa chọn quận.');
      }

      let result = await calculateExpectedCollect({
        orderValue,
        city,
        shipping,
        payment,
        orderType,
        created,
        district,
        deadline,
        outlet,
        ward
      });
      if (result) return $q.resolve(result);
      return $q.reject('Không tương thích với trường hợp nào');
    }

  };
}]);
"use strict";

