angular.module('support-options').controller('SupportOptionsController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'SupportOptions', '$state', 'SupportOptionService', '$stateParams', function (Authentication, FhdMessenger, NgTableParams, SupportOptions, $state, SupportOptionService, $stateParams) {
  const vm = this;
  vm.user = Authentication.user;
  vm.loading = false;
  vm.supportOptionsTable = new NgTableParams({}); // Danh sách support option hiện có

  vm.find = function () {
    vm.isAdmin();
    FhdMessenger.info('Đang tìm...');
    vm.supportOptions = SupportOptions.query();
    vm.supportOptions.$promise.then(() => {
      vm.supportOptionsTable.settings({
        dataset: vm.supportOptions
      });
      FhdMessenger.success('Tải xong');
    });
  }; // Tạo một support Option mới


  vm.create = () => {
    if (!vm.problem) {
      return FhdMessenger.errorFromServer('Vui lòng nhập tên vấn đề');
    }

    if (!vm.resolver) {
      return FhdMessenger.errorFromServer('Vui lòng nhập tên người giải quyết');
    }

    vm.loading = true;
    const supportOption = new SupportOptions({
      problem: vm.problem,
      resolver: vm.resolver._id
    });
    supportOption.$save().then(() => {
      FhdMessenger.success('Tạo vấn đề thành công');
      $state.reload();
      vm.loading = false;
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      vm.loading = false;
    });
  }; // Xem support option


  vm.view = SupportOptionService.view; // Xóa support option

  vm.remove = function (supportOption) {
    const index = vm.supportOptions.findIndex(option => {
      return option._id === supportOption._id;
    });

    if (index > -1) {
      supportOption.$remove().then(() => {
        vm.supportOptions.splice(index, 1);
        vm.supportOptionsTable.reload();
      });
    }
  }; // Find One


  vm.findOne = function () {
    vm.isAdmin();
    SupportOptions.get({
      supportOptionId: $stateParams.supportOptionId
    }).$promise.then(supportOption => {
      vm.supportOption = supportOption;
    });
  }; // Xác thực admin


  vm.isAdmin = function () {
    if (!vm.user.roles.includes('admin')) {
      FhdMessenger.error('Bạn không có quyền thêm Support Option');
      return $state.go('myPoints');
    }
  }; // Update Support Option


  vm.update = function () {
    vm.loading = true;
    const supportOption = vm.supportOption;
    supportOption.$update().then(res => {
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.loading = false;
      $state.reload();
    });
  };
}]);
