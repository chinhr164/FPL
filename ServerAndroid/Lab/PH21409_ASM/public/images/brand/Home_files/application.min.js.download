angular.module('application-forms').controller('ViewFormEntriesOfCandicateController', ['$stateParams', '$http', 'ApplicationForms', 'FhdMessenger', function ($stateParams, $http, ApplicationForms, FhdMessenger) {
  const vm = this;

  vm.findFormEntries = () => {
    vm.applicationForm = ApplicationForms.get({
      applicationFormId: $stateParams.applicationFormId
    });
    $http.get(`/form-entries/findByApplicationFormId/${$stateParams.applicationFormId}`).then(response => {
      const formEntries = response.data;
      vm.internalFormEntries = _.reject(formEntries, 'formId.isPublic');
      vm.externalFormEntries = _.filter(formEntries, 'formId.isPublic');
      vm.internalFormEntriesGroupMap = _.reduce(vm.internalFormEntries, (result, internalFormEntry) => {
        result[internalFormEntry._id] = _.groupBy(internalFormEntry.fields, 'fieldGroup');
        return result;
      }, {});
      vm.externalFormEntriesGroupMap = _.reduce(vm.externalFormEntries, (result, externalFormEntry) => {
        result[externalFormEntry._id] = _.groupBy(externalFormEntry.fields, 'fieldGroup');
        return result;
      }, {});
    });
  };

  vm.getField = (data, type) => {
    switch (type) {
      case 'external':
        return _.get(vm.externalFormEntriesGroupMap, data._id);

      case 'internal':
        return _.get(vm.internalFormEntriesGroupMap, data._id);

      default:
        return FhdMessenger.err('Có lỗi xảy ra khi phân loại');
    }
  };

  vm.getPoint = (groupName = '', pointGroups) => {
    // Get total point of all groups
    if (groupName === '') {
      const totalScore = _.reduce(pointGroups, (result, value) => {
        return result + value.points;
      }, 0);

      return totalScore;
    } // Get score of per groups


    const groupScore = _.find(pointGroups, {
      pointGroup: groupName
    });

    if (groupScore) {
      return groupScore.points;
    }

    return false;
  };
}]);
'use strict';

