angular.module('wholesale-orders').controller('SummaryWholesaleOrdersController', ['Authentication', 'NgTableParams', '$filter', 'WholesaleOrderModal', 'WholesaleOrders', 'CustomerService', 'BusinessCustomerPointService', 'FhdMessenger', function (Authentication, NgTableParams, $filter, WholesaleOrderModal, WholesaleOrders, CustomerService, BusinessCustomerPointService, FhdMessenger) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {
    startDate: moment().subtract(1, 'month').startOf('month').format('YYYY-MM-DD')
  };
  vm.data.endDate = moment(vm.data.startDate).endOf('month').format('YYYY-MM-DD');

  vm.openModalCreateBusinessCustomerPoint = businessCustomer => {
    BusinessCustomerPointService.openModalCreateBusinessCustomerPoint({
      businessCustomer: businessCustomer.businessCustomer,
      customerName: businessCustomer.name,
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      originalPoint: businessCustomer.discountValue,
      totalValue: businessCustomer.totalValue,
      discountPercent: businessCustomer.discountPercent
    }).then(businessCustomerPoint => {
      businessCustomer.createdDiscountValue = businessCustomerPoint.originalPoint;
    });
  };

  vm.businessCustomerTable = new NgTableParams({
    count: 50
  });

  vm.summary = () => {
    vm.businessCustomerTable.settings({
      dataset: []
    });
    vm.waiting = true;
    WholesaleOrders.summaryByBussinessCustomer({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate
    }).$promise.then(businessCustomers => {
      vm.businessCustomerTable.settings({
        dataset: businessCustomers
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('wholesale-orders').controller('ViewWholesaleOrderController', ['$state', 'Authentication', 'CurrentShift', 'ConfirmModal', 'ObjectId', 'SaleEntryService', 'WholesaleOrders', '$stateParams', '$filter', 'CalculateService', 'FhdMessenger', '$window', 'OutletService', 'StockMap', 'WholesaleOrderModal', 'JsPrintService', '$timeout', 'StockEntries', '$http', 'OnlineOrderService', function ($state, Authentication, CurrentShift, ConfirmModal, ObjectId, SaleEntryService, WholesaleOrders, $stateParams, $filter, CalculateService, FhdMessenger, $window, OutletService, StockMap, WholesaleOrderModal, JsPrintService, $timeout, StockEntries, $http, OnlineOrderService) {
  const vm = this;
  vm.stockEntries = [];
  vm.user = Authentication.user;
  vm.data = {
    editShipping: false,
    editOrder: false,
    paymentMethods: [{
      value: 'cod',
      label: 'COD'
    }, {
      value: 'transfer',
      label: 'Chuyển khoản'
    }],
    fees: [{
      id: 'INVOICE',
      title: 'Hóa đơn'
    }]
  };
  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus;
  vm.openModalUpdateActualItemsForWholesaleOrder = WholesaleOrderModal.openModalUpdateActualItemsForWholesaleOrder;
  vm.canUpdateActualItems = _.intersection(vm.user.roles, ['admin', 'wholesale-order:edit-price']).length;

  vm.addFees = () => {
    vm.wholesaleOrder.fees = vm.wholesaleOrder.fees || [];
    vm.wholesaleOrder.fees.push({});
  };

  vm.getStockMap = function () {
    StockMap.getStockMapCache().then(data => {
      vm.stockMap = data;
    });
  };

  vm.openUpdateUsedPoint = () => {
    WholesaleOrderModal.updateUsedPoints(vm.wholesaleOrder);
  };

  vm.getStockEntries = function (wholesaleOrderId) {
    StockEntries.getStockEntriesForWholesaleOrder({
      wholesaleOrderId
    }).$promise.then(stockEntries => {
      vm.stockEntries = stockEntries;

      const allItems = _.flatten(_.map(stockEntries, 'items'));

      const deliveredItemMap = _.reduce(allItems, (result, item) => {
        result[item.sku] = result[item.sku] || 0;
        result[item.sku] += item.quantity;
        return result;
      }, {});

      _.forEach(vm.items, item => {
        item.deliveredQuantity = deliveredItemMap[item.sku] || 0;
        item.deliveredValue = item.deliveredQuantity * item.soldPrice;
      });

      vm.wholesaleOrder.deliveredValue = _.sumBy(vm.items, 'deliveredValue');
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    });
  };

  vm.changePrices = () => {
    if (_.intersection(vm.user.roles, ['admin', 'wholesale-order:edit-price']).length) {
      vm.changePrice = true;
    } else {
      vm.changePrice = false;
      return FhdMessenger.error('Bạn không có quyền sửa giá');
    }
  };

  function hasAuthorization(user, wholesaleOrder, currentShift) {
    if (_.intersection(_.get(user, 'roles'), ['admin', 'wholesale-order:edit-price', 'tro-ly', 'tro-ly-kho']).length > 0) {
      return true;
    }

    const currentShiftOutletId = ObjectId.getObjectId(_.get(currentShift, 'outlet'));
    const outletId = ObjectId.getObjectId(wholesaleOrder.outlet);

    if (currentShiftOutletId === outletId) {
      return true;
    }

    return false;
  }

  vm.viewSaleEntry = SaleEntryService.viewSaleEntry;
  vm.items = [];

  function updateShowButton(wholesaleOrder) {
    if (wholesaleOrder.status === 'created') {
      vm.showTaken = _.get(wholesaleOrder, 'businessCustomer.type', '').match(/đại lý/gim) && _.get(wholesaleOrder, 'outlet.code') === 'E0';
      vm.showReady = !vm.showTaken;
    } else {
      vm.showReady = wholesaleOrder.status === 'delivered';
      vm.showTaken = false;
    }
  }

  vm.findOne = function () {
    vm.currentDate = moment().toDate();
    vm.wholesaleOrder = WholesaleOrders.get({
      wholesaleOrderId: $stateParams.wholesaleOrderId
    });
    vm.wholesaleOrder.$promise.then(wholesaleOrder => {
      // enable fast edit
      updateShowButton(wholesaleOrder);

      if (_.includes(['done', 'cancel'], vm.wholesaleOrder.status) && !vm.user.roles.includes('admin')) {
        vm.data.editShipping = false;
      } else {
        vm.data.editShipping = true;
      }

      if (_.includes(['done', 'cancel'], vm.wholesaleOrder.status)) {
        vm.data.editOrder = false;
      } else {
        vm.data.editOrder = true;
      }

      if (vm.wholesaleOrder.receiverCustomer.district) {
        vm.districtLabel = `${vm.wholesaleOrder.receiverCustomer.district}, ${vm.wholesaleOrder.receiverCustomer.city}`;
      }

      OutletService.allAsync().then(outlets => {
        if (!hasAuthorization(vm.user, vm.wholesaleOrder, CurrentShift.getCurrentShift())) {
          FhdMessenger.error('Bạn không có quyền xử lý wholesale order này');
          return $state.go('home');
        }

        vm.data.outlets = _.filter(outlets, outlet => {
          return outlet.isPos && !outlet.code.match(/^S\d+/);
        });
        vm.assignedOutlet = _.find(outlets, {
          _id: ObjectId.getObjectId(vm.wholesaleOrder.outlet)
        });
      });
      vm.wholesaleOrder.orderValue = _.sumBy(vm.wholesaleOrder.items, 'lineTotal');
      vm.wholesaleOrder.actualValue = _.sumBy(vm.wholesaleOrder.actualItems, 'lineTotal');
      vm.items = _.map(vm.wholesaleOrder.items, item => {
        item = _.assign({}, item, {
          salePrice: item.product.salePrice,
          price: item.product.price,
          regionAttributes: item.product.regionAttributes
        });
        return item;
      });
      vm.calculate();
      vm.getListItems();
      vm.getStockMap();
      vm.getStockEntries(vm.wholesaleOrder._id);
    });
    vm.openModalCancelWholesaleOrder = WholesaleOrderModal.openModalCancelWholesaleOrder;
  };

  vm.openModalCreateRestockLists = WholesaleOrderModal.openModalCreateRestockLists;

  vm.hasAssignedOutlet = () => {
    const code = _.get(vm, 'assignedOutlet.code');

    if (!code) {
      return false;
    }

    if (['M1', 'M2'].includes(code)) {
      return true;
    } else {
      return false;
    }
  };

  vm.calculate = () => {
    let result = CalculateService.calculate({
      items: vm.items,
      assignedOutlet: vm.assignedOutlet,
      customer: vm.customer,
      saleCampaigns: vm.saleCampaigns,
      orderValue: vm.orderValue
    });

    _.assign(vm, result);

    vm.wholesaleOrder.orderValue = vm.orderValue;
  };

  vm.getListItems = () => {
    vm.listItems = _.reduce(vm.items, (result, item) => {
      result += `\n${item.sku} ${item.description}: ${$filter('number')(item.soldPrice, 0)} x ${item.quantity} = ${$filter('number')(item.lineTotal, 0)}`;
      return result;
    }, `Đây là báo giá khi đơn hàng ship từ ngách 2 ngõ 231 Chùa Bộc`);
    vm.listItems += `\nTổng ${$filter('number')(vm.wholesaleOrder.orderValue, 0)}\n`;
    vm.listItems += `Đây là đơn hàng tạm thời, sẽ có thể thay đổi tùy vào tình hình hàng tồn và sẽ được chốt khi nhân viên Abby gọi điện thoại trực tiếp.`;
  };

  vm.addProduct = function () {
    const item = vm.product;
    vm.items = vm.items || [];

    const matchItemIndex = _.findIndex(vm.items, currentItem => {
      if (currentItem.refId) {
        return currentItem.refId === item.refId || currentItem.refId === item.sku;
      }

      return currentItem.sku === item.sku;
    });

    if (matchItemIndex > -1 && !vm.items[matchItemIndex].toLock && !vm.items[matchItemIndex].addGiftItem) {
      if (item.quantityFromBarcode) {
        vm.items[matchItemIndex].quantity += item.quantity;
      } else if (item.needQuantity) {
        vm.items[matchItemIndex].quantity = 0;
      } else {
        vm.items[matchItemIndex].quantity += 1;
      }
    } else {
      vm.items.push(item);
    }

    vm.calculate();
  };

  vm.removeItem = function (index) {
    vm.items.splice(index, 1);
  };

  vm.checkWeight = function () {
    if (vm.wholesaleOrder.shipping.weight >= 10000) {
      if (!$window.confirm('Số kg bạn nhập vào đang lớn hơn 10kg, bạn có chắc chắn với khối lượng này?')) {
        vm.wholesaleOrder.shipping.weight = 0;
      }
    }
  };

  vm.update = () => {
    if (vm.newNote) {
      vm.wholesaleOrder.notes = vm.wholesaleOrder.notes || [];
      vm.wholesaleOrder.notes.push({
        content: vm.newNote,
        user: Authentication.user,
        time: new Date()
      });
    }

    vm.wholesaleOrder.items = vm.items;
    vm.waiting = true;
    return vm.wholesaleOrder.$update().then(wholesaleOrder => {
      vm.wholesaleOrder = wholesaleOrder;
      vm.newNote = '';
      FhdMessenger.success('Cập nhật thành công');
      return wholesaleOrder;
    }).catch(err => {
      FhdMessenger.error(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.calculateCalculatedWeight = function () {
    vm.wholesaleOrder.shipping.calculatedWeight = CalculateService.calculateWeight(vm.wholesaleOrder);
  };

  vm.done = () => {
    const currentShift = CurrentShift.getCurrentShift();

    if (!currentShift.outlet) {
      return FhdMessenger.error('Bạn chưa đăng nhập ca trực');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Ship đơn #${vm.wholesaleOrder.wholesaleOrderId} - ${vm.wholesaleOrder.receiverCustomer.name}?`
    }).then(() => {
      vm.wholesaleOrder.date = currentShift.date;
      vm.wholesaleOrder.shift = currentShift.shift;
      vm.wholesaleOrder.items = vm.items;
      vm.update().then(() => {
        vm.waiting = true;
        return vm.wholesaleOrder.$done().then(wholesaleOrder => {
          FhdMessenger.success('Đã chuyển trạng thái về done');
        }).catch(err => FhdMessenger.error(err.data.message)).finally(() => {
          vm.waiting = false;
        });
      });
    });
  };

  vm.printWholesaleOrder = () => {
    $timeout(() => {
      JsPrintService.printElementById('print-wholesale-order', true);
    }, 100);
  };

  vm.ready = () => {
    const currentShift = CurrentShift.getCurrentShift();

    if (!currentShift.outlet) {
      return FhdMessenger.error('Bạn chưa đăng nhập ca trực');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Tạo hóa đơn cho đơn #${vm.wholesaleOrder.wholesaleOrderId} - ${vm.wholesaleOrder.receiverCustomer.name}?`
    }).then(() => {
      vm.wholesaleOrder.date = currentShift.date;
      vm.wholesaleOrder.shift = currentShift.shift;
      vm.wholesaleOrder.items = vm.items;
      vm.update().then(() => {
        vm.waiting = true;
        return vm.wholesaleOrder.$ready().then(wholesaleOrder => {
          FhdMessenger.success('Đã chuyển trạng thái về done');
          updateShowButton(wholesaleOrder);
        }).catch(err => FhdMessenger.error(err.data.message)).finally(() => {
          vm.waiting = false;
        });
      });
    });
  };

  vm.taken = () => {
    if (_.get(vm.wholesaleOrder, 'businessCustomer.payment', '') === 'Thanh toán trước khi nhận hàng' && !_.get(vm.wholesaleOrder, 'payment.code')) {
      return FhdMessenger.error('Chưa điền mã giao dịch');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Bạn muốn chuyển trạng thái đã lấy #${vm.wholesaleOrder.wholesaleOrderId} - ${vm.wholesaleOrder.receiverCustomer.name}?`
    }).then(() => {
      return vm.wholesaleOrder.$taken().then(wholesaleOrder => {
        FhdMessenger.success('Chuyển về trạng thái đã lấy');
        updateShowButton(wholesaleOrder);
      }).catch(err => FhdMessenger.error(err.data.message));
    });
  };

  vm.deliver = () => {
    if (!_.get(vm.wholesaleOrder, 'payment.code')) {
      return FhdMessenger.error('Chưa điền mã giao dịch');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Bạn muốn chuyển trạng thái đã chuyển #${vm.wholesaleOrder.wholesaleOrderId} - ${vm.wholesaleOrder.receiverCustomer.name}?`
    }).then(() => {
      return vm.wholesaleOrder.$deliver().then(wholesaleOrder => {
        FhdMessenger.success('Chuyển về trạng thái đã lấy');
        updateShowButton(wholesaleOrder);
      }).catch(err => FhdMessenger.error(err.data.message));
    });
  };

  vm.print = () => {
    $timeout(() => {
      JsPrintService.printElementById('print-delivery-wholesale-order', true);
    }, 100);
  };

  vm.export = () => {
    const sheetTitle = `Hàng chuyển thiếu của ${vm.wholesaleOrder.wholesaleOrderId} - ${vm.wholesaleOrder.businessCustomer.name} - ${moment().format('YYYY-MM-DD hh:mm:ss')}`;
    const sheetCols = ['STT', 'SKU', 'Description', 'Đã chuyển', 'Khách đặt', 'Chuyển thiếu', 'Special Price'];
    const sheetData = [];
    let row = [];

    _.forEach(vm.items, (item, index) => {
      const specialPrice = _.get(item, 'specialPrice', 'Chưa có trong Wholesale Order');

      row.push(index + 1);
      row.push(item.sku);
      row.push(item.description);
      row.push(item.deliveredQuantity);
      row.push(item.quantity);
      row.push(item.quantity - item.deliveredQuantity);
      row.push(specialPrice);
      sheetData.push(row);
      row = [];
    });

    vm.waiting = true;
    $http.post('/sheet', {
      sheetData: sheetData,
      sheetTitle,
      sheetCols
    }).then(res => {
      vm.linkGoogleSheet = `https://docs.google.com/spreadsheets/d/${res.data.data.spreadsheetId}`;
      $window.open(vm.linkGoogleSheet);
      FhdMessenger.success('Đã tạo thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('wholesale-orders').controller('WholesaleOrdersController', ['$window', 'Authentication', 'NgTableParams', '$filter', 'WholesaleOrderModal', 'WholesaleOrders', 'CustomerService', 'OnlineOrderService', 'FhdMessenger', function ($window, Authentication, NgTableParams, $filter, WholesaleOrderModal, WholesaleOrders, CustomerService, OnlineOrderService, FhdMessenger) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {
    statuses: ['created', 'taken', 'delivered', 'ready', 'done', 'cancel'],
    types: [{
      id: 'dealer',
      title: 'Đại lý'
    }, {
      id: 'wholesale',
      title: 'Đơn sỉ'
    }]
  };
  vm.statusMap = {
    created: true,
    ready: true,
    taken: true,
    delivered: true,
    done: false,
    cancel: false
  };
  vm.summary = {};
  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus; // create for wholesale order

  vm.createWholesaleOrderModal = () => {
    WholesaleOrderModal.create().then(wholesaleOrder => {
      vm.wholesaleOrders.unshift(wholesaleOrder);
      vm.wholesaleOrdersTable.reload();
    });
  };

  vm.selectAll = function (field) {
    const map = vm[`${field}Map`];
    let newValue = true;
    if (_.every(map)) newValue = false;

    _.forEach(map, (value, key) => {
      map[key] = newValue;
    });
  };

  vm.summary = function () {
    const processingOrders = _.filter(vm.wholesaleOrders, onlineOrder => {
      return _.includes(['created', 'ready'], onlineOrder.status);
    });

    _.forEach(['created', 'ready'], status => {
      vm.summary[status] = (_.filter(processingOrders, {
        status
      }) || []).length;
    });
  }; // ng-table dynamic for list


  vm.wholesaleOrdersTable = new NgTableParams({
    count: 100
  });

  vm.find = () => {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    vm.waiting = true;
    WholesaleOrders.query({
      statuses
    }).$promise.then(wholesaleOrders => {
      vm.wholesaleOrders = _.map(wholesaleOrders, wholesaleOrder => {
        wholesaleOrder.type = _.get(wholesaleOrder, 'businessCustomer.type', '').match(/^Đại lý/gim) ? 'dealer' : 'wholesale';
        wholesaleOrder.deliveredValuePercent = Math.round(wholesaleOrder.deliveredValue / wholesaleOrder.orderValue * 10000) / 100;
        return wholesaleOrder;
      });
      vm.wholesaleOrdersTable.settings({
        dataset: vm.wholesaleOrders
      });
      vm.summary();
    }).finally(() => {
      vm.waiting = false;
    });
  };

  function indexCol($scope, row, rowIndex) {
    return `<span>${rowIndex + 1}</span>`;
  }

  function wholesaleOrderIdCell($scope, row) {
    return `<a
        ui-sref="viewWholesaleOrder({wholesaleOrderId: row._id})" target="_blank">${row.wholesaleOrderId}</a>`;
  }

  function getSaleEntry($scope, row) {
    return `<a
        ui-sref="viewSaleEntry({saleEntryId: row.saleEntry._id})" target="_blank">${_.get(row, 'saleEntry.saleEntryId', '')}</a>`;
  }

  function getOutletCode($scope, row) {
    return `<span>${row.outlet.code}</span>`;
  }

  function statusValue($scope, row) {
    return `<label class="label ${vm.getLabelFromStatus(row.status)}">${row.status}</label>`;
  }

  function typeValue($scope, row) {
    return `<label class="label" ng-class="{
          'label-primary' : row.type === 'dealer',
          'label-success' : row.type === 'wholesale'}">${_.get(_.find(vm.data.types, {
      id: row.type
    }), 'title', row.type)}</label>`;
  }

  function numberValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field, '');

    return `<span>${$filter('number')(value, 0)}</span>`;
  }

  function percentageValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field, '');

    return `<span>${$filter('number')(value, 2)}</span>`;
  }

  function hourValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${moment(_.get(row, vm.field)).format('DD/MM/YYYY') || ''}</span>`;
  }

  function normalValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${_.get(row, vm.field) || ''}</span>`;
  }

  function cellphoneValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    row.mobileProvider = CustomerService.checkProvider(_.get(row, vm.field)) || 'Khác';

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${_.get(row, vm.field) || ''}</span>
      <span
      class="label"
      ng-class="{
      'label-success' : row.mobileProvider === 'Viettel',
      'label-info' : row.mobileProvider === 'Vina',
      'label-primary' : row.mobileProvider === 'Mobi',
      'label-ready' : row.mobileProvider === 'Gmobile',
      'label-warning' : row.mobileProvider === 'Vietnammobile',
      'label-default' : row.mobileProvider === 'Khác',
    }"
      >  ${row.mobileProvider}</span
    >`;
  }

  function cancelOder($scope, row) {
    if (row.status !== 'created') {
      return '';
    }

    return `<a 
      ng-click="vm.openModalCancelWholesaleOrder(row)"
      >Hủy</a>`;
  }

  vm.openModalCancelWholesaleOrder = WholesaleOrderModal.openModalCancelWholesaleOrder;
  vm.wholesaleOrdersCols = [{
    title: 'STT',
    show: true,
    getValue: indexCol
  }, {
    field: 'wholesaleOrderId',
    title: 'Id',
    sortable: 'wholesaleOrderId',
    filter: {
      wholesaleOrderId: 'text'
    },
    show: true,
    getValue: wholesaleOrderIdCell
  }, {
    field: 'outlet.code',
    title: 'Cơ sở',
    sortable: 'outlet.code',
    filter: {
      'outlet.code': 'text'
    },
    show: true,
    getValue: getOutletCode
  }, {
    field: 'status',
    title: 'Tình trạng',
    filter: {
      status: 'select'
    },
    filterData: [{
      title: 'created',
      id: 'created'
    }, {
      title: 'ready',
      id: 'ready'
    }, {
      title: 'done',
      id: 'done'
    }],
    show: true,
    getValue: statusValue
  }, {
    field: 'type',
    title: 'Kiểu',
    filter: {
      type: 'select'
    },
    filterData: vm.data.types,
    show: true,
    getValue: typeValue
  }, {
    field: 'saleEntry',
    title: 'Sale Entry',
    filter: {
      'saleEntry.saleEntryId': 'text'
    },
    getValue: getSaleEntry
  }, {
    field: 'receiverCustomer.name',
    title: 'Tên khách',
    filter: {
      'receiverCustomer.name': 'text'
    },
    getValue: normalValue
  }, {
    field: 'receiverCustomer.cellphone',
    title: 'SĐT khách',
    filter: {
      'receiverCustomer.cellphone': 'text'
    },
    show: true,
    getValue: cellphoneValue
  }, {
    field: 'receiverCustomer.address',
    title: 'Địa chỉ',
    filter: {
      'receiverCustomer.address': 'text'
    },
    getValue: normalValue
  }, {
    field: 'orderValue',
    title: 'Giá trị',
    filter: {
      orderValue: 'text'
    },
    getValue: numberValue
  }, {
    field: 'deliveredValue',
    title: 'Giá trị đã lấy',
    filter: {
      deliveredValue: 'text'
    },
    sortable: 'deliveredValue',
    getValue: numberValue
  }, {
    field: 'deliveredValuePercent',
    title: '% Giá trị đã lấy',
    filter: {
      deliveredValuePercent: 'text'
    },
    sortable: 'deliveredValuePercent',
    getValue: percentageValue
  }, {
    field: 'created',
    title: 'Ngày tạo',
    sortable: 'created',
    show: true,
    getValue: hourValue
  }, {
    title: 'Tác vụ',
    show: true,
    getValue: cancelOder
  }];

  vm.checkReturnItems = () => {
    if (!vm.businessCustomer) {
      return FhdMessenger.error('Bạn chưa chọn khách hàng');
    }

    if (!_.get(vm, 'items.length')) {
      return FhdMessenger.error('Bạn chưa điền danh sách sản phẩm');
    }

    if (_.some(vm.items, item => {
      return !item.sku;
    })) {
      return FhdMessenger.error('Có sản phẩm chưa mã');
    }

    if (_.some(vm.items, item => {
      return !_.isNumber(item.quantity);
    })) {
      return FhdMessenger.error('Có sản phẩm chưa có số lượng hoàn trả');
    }

    vm.waiting = true;
    WholesaleOrders.checkReturnItems({
      businessCustomer: vm.businessCustomer._id,
      items: vm.items
    }).$promise.then(res => {
      FhdMessenger.success('Kiểm tra dữ liệu hoàn trả thành công');
      vm.returnItems = res;
      vm.calculateReturnItems();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.createReturnItems = () => {
    if (!vm.businessCustomer) {
      return FhdMessenger.error('Bạn chưa chọn khách hàng');
    }

    if (!_.get(vm, 'destination._id')) {
      return FhdMessenger.error('Bạn chưa chọn cơ sở nhận hàng thu hồi');
    }

    if (!_.get(vm, 'returnItems.length')) {
      return FhdMessenger.error('Bạn chưa điền danh sách sản phẩm');
    }

    vm.waiting = true;
    WholesaleOrders.createReturnItems({
      businessCustomer: vm.businessCustomer._id,
      returnItems: vm.returnItems,
      destination: vm.destination._id
    }).$promise.then(res => {
      $window.open(`#!/sale-entries/${res.saleEntry._id}`);
      $window.open(`#!/stock-entries/${res.stockEntry._id}`);
      FhdMessenger.success('Tạo hoàn trả thành công');
      vm.returnItems = [];
      vm.businessCustomer = null;
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.calculateReturnItems = () => {
    _.forEach(vm.returnItems, item => {
      item.lineTotal = item.soldPrice * item.quantity * item.returnPercent;
    });

    vm.lineTotal = _.sumBy(vm.returnItems, 'lineTotal');
  };
}]);
"use strict";

