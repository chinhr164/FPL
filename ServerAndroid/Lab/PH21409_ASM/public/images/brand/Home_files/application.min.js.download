angular.module('online-orders').controller('ModalSelectVariantsController', ['$modalInstance', 'Products', 'ProductService', 'item', function ($modalInstance, Products, ProductService, item) {
  const vm = this;
  vm.variants = ProductService.getVariantTypes();

  vm.init = function () {
    vm.item = item;
    Products.getCakeVariants().$promise.then(products => {
      vm.products = products;

      _.forEach(vm.variants, variant => {
        variant.products = _.filter(products, {
          variantType: variant.type
        });

        const exsistedVariant = _.find(item.variants, {
          type: variant.type
        });

        if (exsistedVariant) {
          vm[variant.type] = _.find(vm.products, {
            sku: exsistedVariant.sku
          });
        }
      });
    });
  };

  vm.submit = function () {
    $modalInstance.close(_.compact(_.map(vm.variants, variant => {
      if (!_.get(vm, variant.type)) {
        return;
      }

      const product = vm[variant.type];
      return {
        type: variant.type,
        sku: product.sku,
        description: product.description,
        product
      };
    })));
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
"use strict";

angular.module('online-orders').controller('AccountNumBankModalController', ['$modalInstance', 'FhdMessenger', 'OnlineOrders', 'onlineOrderId', 'totalCollect', '$state', function ($modalInstance, FhdMessenger, OnlineOrders, onlineOrderId, totalCollect, $state) {
  const vm = this;
  vm.bankAccounts = [// 'VPBank: 197346469 - Tran Anh Dung - VPbank Trần Thái Tông',
  'Vietcombank: 0451000501819 - Tran Anh Dung - CN Thanh Cong - Ha Noi'];

  vm.findOne = function () {
