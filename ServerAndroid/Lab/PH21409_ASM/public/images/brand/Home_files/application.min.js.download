angular.module('stock-entries').controller('ConfirmStockEntryController', ['$document', '$scope', 'FhdMessenger', 'StockEntries', 'StockEntryService', '$state', 'NgTableParams', 'Authentication', 'CurrentShift', 'ObjectId', function ($document, $scope, FhdMessenger, StockEntries, StockEntryService, $state, NgTableParams, Authentication, CurrentShift, ObjectId) {
  const vm = this;
  vm.stockEntry = null;
  vm.user = Authentication.user;
  vm.itemsTable = new NgTableParams();

  vm.search = searchString => {
    if (!searchString) {
      return FhdMessenger.error('Chưa nhập mã Logistic Entry');
    }

    vm.waiting = true;
    vm.stockEntry = StockEntries.search({
      searchString
    });
    vm.searchString = '';
    vm.stockEntry.$promise.then(() => {
      vm.canConfirm = canConfirm();
      vm.itemsTable.settings({
        dataset: vm.stockEntry.items
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.confirmReceived = function () {
    vm.updateFeedback(vm.stockEntry, 'received');
  };

  vm.updateFeedback = function (stockEntry, newStatus) {
    const outlet = stockEntry.outlet;
    const destination = stockEntry.destination;

    if (stockEntry.deliverEntry && _.get(stockEntry, 'deliverEntry.status') === 'delivered' && _.get(outlet, 'code', '').match(/[MED]\d+/) && _.get(destination, 'code', '').match(/[MED]\d+/) && _.get(outlet, 'region', '') === 'NORTH' && _.get(destination, 'region', '') === 'NORTH') {
      return FhdMessenger.error('Bạn chưa confirm Deliver Entry tương ứng của Logistic Entry này');
    }

    const modal = StockEntryService.openUpdateFeedback(stockEntry, newStatus);
    modal.result.then().then(() => {
      FhdMessenger.info('Cập nhật thành công');
      vm.stockEntry = null;
    });
  };

  vm.searchKeyUp = function ($event) {
    if ($event.keyCode === 13) vm.search(vm.searchString);
  };

  vm.print = function () {
    $state.go('viewStockEntry', {
      stockEntryId: vm.stockEntry._id
    });
  };

  function canConfirm() {
    const outlet = vm.user.outlet;
    const currentShift = CurrentShift.getCurrentShift();

    if (!vm.stockEntry) {
      return false;
    }

    if (_.intersection(vm.user.roles, ['admin', 'admin-stock', 'stock-entry:confirm-all']).length) {
      return true;
    }

    if (['delivered', 'lost'].includes(vm.stockEntry.currentStatus)) {
      if (_.get(vm.stockEntry, 'destination.code') === 'G4' && _.get(vm.user, 'outlet.code') === 'M6') {
        return true;
      }

      if (_.get(vm.stockEntry, 'destination.code') === 'VENDOR' && _.get(vm.user, 'outlet.code', '').match(/D\d+/)) {
        return true;
      }

      if (_.get(vm.stockEntry, 'destination.code') === 'M6' && ['G4', 'D6'].includes(_.get(vm.user, 'outlet.code'))) {
        return true;
      }

      if (_.get(vm.stockEntry, 'destination.code') === 'SS' && _.get(vm.user, 'outlet.code') === 'B3') {
        return true;
      }
    }

    if (vm.stockEntry.staff && ObjectId.getObjectId(vm.user) === ObjectId.getObjectId(vm.stockEntry.staff)) {
      return false;
    }

    if (vm.stockEntry.destination.code !== outlet.code && !_.some(vm.user.managingOutlets, managingOutlet => {
      return ObjectId.equals(managingOutlet, vm.stockEntry.destination);
    })) {
      if (!_.get(currentShift, 'outlet')) {
        return false;
      }

      if (_.get(currentShift, 'outlet.code', 'Chưa đăng nhập ca trực') !== _.get(vm.stockEntry, 'destination.code', 'Chưa có cơ sở nhận')) {
        return false;
      }
    }

    if (['delivered', 'lost'].includes(vm.stockEntry.currentStatus)) {
      return true;
    }

    return false;
  }

  function handleF4(event) {
    if (event.key === 'F4') {
      var customerSearchInput = $document[0].querySelector('#stockEntrySearch');
      customerSearchInput.focus();
      customerSearchInput.select();
    }

    vm.$apply();
  }

  $document.on('keydown', handleF4);
  $scope.$on('$destroy', function () {
    $document.unbind('keydown', handleF4);
  });
}]);
"use strict";

angular.module('stock-entries').controller('CreateConvertStockEntryController', ['FhdMessenger', 'ProductService', 'StockEntries', 'StockEntryService', '$state', 'NgTableParams', 'Authentication', 'CurrentShift', 'ObjectId', '$q', function (FhdMessenger, ProductService, StockEntries, StockEntryService, $state, NgTableParams, Authentication, CurrentShift, ObjectId, $q) {
  const vm = this;
  vm.user = Authentication.user;
  vm.listItem = vm.listItem || [];
  vm.listOutputProductsSelected = vm.listOutputProductsSelected || [];
  vm.listInputProducts = vm.listInputProducts || [];
  vm.listItemsSelected = vm.listItemsSelected || [];

  vm.checkUserRoles = () => {
    if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('tro-ly-sx') && _.get(vm.user, 'outlet.code', '') !== 'M6' && !vm.user.roles.includes('convert-stock:create') && !vm.user.roles.includes('purchaser') && !vm.user.roles.includes('probation-purchaser')) {
      $state.go('home');
    }
  };

  vm.deleteItem = function ($index) {
    vm.listItemsSelected.splice($index, 1);
  };

  vm.changeProduct = function (product) {
    if (product) {
      vm.inputProduct = product;
      vm.listOutputProducts = product.convertProducts;
    }
  };

  vm.selectConvertProduct = function (outputProduct) {
    vm.outputProduct = _.cloneDeep(outputProduct);
    vm.outputProduct.quantity *= vm.inputProduct.quantity;
    vm.listItemsSelected.push({
      inputProduct: vm.inputProduct,
      outputProduct: vm.outputProduct
    });
  };

  vm.requestConvertProduct = function () {
    if (!vm.inputProduct) {
      return FhdMessenger.error('Chưa có sản phẩm yêu cầu');
    }

    vm.waiting = true;
    const productId = ObjectId.getObjectId(vm.inputProduct);
    ProductService.requestConvertProduct(productId).then(() => {
      FhdMessenger.success('Yêu cầu sản phẩm chuyển đổi thành công');
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.create = () => {
    if (!vm.listItemsSelected.length) {
      return FhdMessenger.error('Chưa có sản phẩm cần chuyển đổi');
    }

    if (!_.get(vm.outlet, '_id')) {
      return FhdMessenger.error('Chưa chọn cơ sở quy đổi');
    }

    vm.waiting = true;
    $q.all([vm.listItemsSelected.map(item => {
      const stockEntry = new StockEntries({
        inputProduct: item.inputProduct,
        outputProduct: item.outputProduct,
        outlet: vm.outlet
      });
      return stockEntry.$createConvertStockEntry().then(response => {
        FhdMessenger.success('Tạo Logistic Entry chuyển đổi thành công ');
        item._id = response._id;
        item.stockEntryId = response.stockEntryId;
      }).catch(FhdMessenger.errorFromServer);
    })]).then(() => {
      vm.waiting = false;
    });
  };

  vm.reset = () => {
    vm.inputProduct = null;
    vm.outputProduct = null;
    vm.listOutputProducts = [];
    vm.listItemsSelected = [];
  };
}]);
"use strict";

angular.module('stock-entries').controller('CreateRecycleStockEntryController', ['FhdMessenger', '$location', '$state', 'StockEntries', 'Authentication', function (FhdMessenger, $location, $state, StockEntries, Authentication) {
  const vm = this;
  vm.user = Authentication.user;

  vm.checkUserRoles = () => {
    if (!_.intersection(vm.user.roles, ['stock-entry:create-recycle', 'kitchen']).length) {
      $state.go('home');
    }
  };

  vm.deleteItem = function ($index) {
    vm.rawProducts.splice($index, 1);
  };

  vm.changeProduct = function (product) {
    if (product) {
      vm.rawProducts = product.rawProducts;
    }
  };

  vm.create = () => {
    if (!vm.rawProducts.length) {
      return FhdMessenger.error('Chưa có sản phẩm nguyên liệu tái sử dụng');
    }

    if (!_.get(vm.outlet, '_id')) {
      return FhdMessenger.error('Chưa chọn cơ sở quy đổi');
    }

    vm.waiting = true;
    const now = moment().toDate();
    const stockEntry = new StockEntries({
      outlet: vm.outlet,
      destination: vm.outlet,
      items: _.concat([{
        product: vm.product._id,
        sku: vm.product.sku,
        description: vm.product.description,
        quantity: -1,
        note: 'Tái chế bánh sinh nhật'
      }], _.map(vm.rawProducts, product => {
        return {
          product: product,
          sku: product.sku,
          description: product.description,
          quantity: product.quantity,
          note: 'Tái chế bánh sinh nhật'
        };
      })),
      date: moment().startOf('day').toDate(),
      delivered: now,
      received: now,
      history: [{
        status: 'received',
        user: vm.user,
        time: now
      }],
      currentStatus: 'received',
      user: vm.user,
      staff: vm.user
    });
    stockEntry.$save().then(response => {
      $location.path(`stock-entries/${response._id}`);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.reset = () => {
    vm.product = null;
    vm.rawProducts = [];
  };
}]);
"use strict";

angular.module('stock-entries').controller('ConfirmMultiStockEntriesController', ['Authentication', 'FhdMessenger', 'StockEntries', function (Authentication, FhdMessenger, StockEntries) {
  const vm = this;
  vm.user = Authentication.user;
  vm.isLoading = false;

  vm.confirmMultiStockEntries = () => {
    if (vm.stockEntries.length === 0) {
      return FhdMessenger.error('Bạn chưa điền danh sách stockEntryId !');
    }

    const isCorrectFormat = !_.some(vm.stockEntries, stockEntry => {
      return !stockEntry.stockEntryId;
    });

    if (!isCorrectFormat) {
      return FhdMessenger.error('Phát hiện dòng không có stockEntryId !');
    }

    vm.waiting = true;
    vm.receivedStockEntries = [];
    StockEntries.confirmMulti({
      stockEntries: vm.stockEntries
    }).$promise.then(res => {
      vm.receivedStockEntries = res;
      FhdMessenger.success(`Đã confirm thành công ${vm.receivedStockEntries.length} Logistic Entries`);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('stock-entries').controller('LinkBuyingController', ['$http', 'FhdMessenger', function ($http, FhdMessenger) {
  const vm = this;

