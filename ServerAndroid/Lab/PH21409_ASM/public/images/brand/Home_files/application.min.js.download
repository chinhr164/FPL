function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('sale-entries').controller('ModalConfirmHideSaleEntryController', ['saleEntry', '$modalInstance', '$http', 'FhdMessenger', 'SaleEntries', function (saleEntry, $modalInstance, $http, FhdMessenger, SaleEntries) {
  const vm = this;
  vm.items = [];
  vm.saleEntry = SaleEntries.get({
    saleEntryId: saleEntry._id
  });
  vm.saleEntry.$promise.then(() => {
    vm.isSavorSaleEntry = vm.saleEntry.saleEntryId.match(/^[SKB]/);

    const combos = _.filter(vm.saleEntry.order.items, item => item.description.match(/^Combo/gim));

    if (vm.isSavorSaleEntry) {
      vm.items = _.map(_.filter(vm.saleEntry.order.items, item => {
        if (combos.length && _.intersection(['V0001', 'V0327', 'V0716'], [item.sku]).length) {
          return true;
        }

        return item.lineTotal;
      }), item => _objectSpread({}, item, {
        id: `${item._id}_${item.refId || 0}`
      }));
      vm.mapItems = _.reduce(vm.items, (result, item) => {
        result[item.id] = {
          item: item,
          value: true
        };
        return result;
      }, {});
    } else {
      vm.items = vm.saleEntry.order.items;
    }
  });

  if (_.get(saleEntry, 'outlet.code', '').match(/S\d+/)) {
    vm.showInputCreateStockEntryToTrash = true;
  } else {
    vm.showInputCreateStockEntryToTrash = false;
  } // Example: M1181231T1 or M1_2018-12-31_T_1


  vm.saleEntryIdPattern = /\D+\d?\d{6}[SCT]\d|\w+\d?_\d{4}-\d{2}-\d{2}_[SCT]_\d\d?/;

  vm.submit = function () {
    // if (!vm.saleEntry.customer) return FhdMessenger.error('Thiếu thông tin khách hàng')
    // if (!vm.saleEntry.customer.fullName) {
    //   return FhdMessenger.error('Thiếu tên khách hàng thay đổi đơn hàng.')
    // }
    // if (!vm.saleEntry.customer.cellphone) {
    //   return FhdMessenger.error('Thiếu SĐT khách hàng thay đổi đơn hàng.')
    // }
    if (!vm.group) return FhdMessenger.error('Bạn chưa chọn nhóm lý do ẩn đơn');

    if (vm.saleEntry.onlineOrder) {
      return FhdMessenger.error('Không được yêu cầu ẩn đơn tạo từ online order.');
    }

    if (['duplicate', 'changeItems', 'returnItems'].includes(vm.group) && !vm.newSaleEntryId) {
      return FhdMessenger.error('Bạn chưa nhập mã đơn mới');
    }

    if (_.get(vm.saleEntry, 'saleEntryId', '') === vm.newSaleEntryId) {
      return FhdMessenger.error('Mã đơn hàng mới phải khác với mã đơn hiện tại');
    }

    if (_.get(vm.saleEntry, 'saleEntryId', '').match(/R\d+/)) {
      return FhdMessenger.error('Không được yêu cầu ẩn đơn sau khi hoàn hàng.');
    }

    vm.originalItems = vm.saleEntry.order.items;

    if (vm.isSavorSaleEntry && vm.createStockEntryToTrash) {
      vm.destroyedGroup = _.uniq(_.map(_.reject(vm.mapItems, item => !item.value || !item.item.lineTotal), 'item.group'));
      vm.originalItems = _.map(vm.saleEntry.order.items, item => {
        let destroy = false;

        if (vm.mapItems[`${item._id}_${item.refId || 0}`]) {
          destroy = vm.mapItems[`${item._id}_${item.refId || 0}`].value;
        } else if (_.intersection(vm.destroyedGroup, [item.group]).length) {
          destroy = true;
        }

        const combinedItem = _objectSpread({}, item, {
          destroy
        });

        return combinedItem;
      });
    }

    if (vm.createStockEntryToTrash && !_.some(vm.originalItems, 'destroy')) {
      return FhdMessenger.error('Chưa có sản phẩm tiêu hủy');
    }

    if (!vm.note) return FhdMessenger.error('Thiếu lý do ẩn đơn hàng.');

    if (vm.note.length > 100) {
      return FhdMessenger.error('Lý do ẩn đơn hàng cần ít hơn hơn 100 kí tự ');
    }

    $http.post(`/sale-entries/${saleEntry._id}/hide`, {
      note: vm.note,
      newSaleEntryId: vm.newSaleEntryId,
      items: vm.originalItems,
      group: vm.group,
      hiddenItems: vm.hiddenItems,
      createStockEntryToTrash: vm.createStockEntryToTrash,
      hiddenCustomer: {
        fullName: vm.saleEntry.customer ? vm.saleEntry.customer.fullName : '',
        cellphone: vm.saleEntry.customer ? vm.saleEntry.customer.cellphone : ''
      }
    }).then(response => {
      $modalInstance.close(response.data);
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.removeItem = function (index) {
    vm.hiddenItems.splice(index, 1);
  };

  vm.productSearchSelected = function (item) {
    vm.hiddenItems = vm.hiddenItems || [];

    const matchItemIndex = _.findIndex(vm.hiddenItems, {
      sku: item.sku
    });

    if (matchItemIndex > -1) {
      vm.hiddenItems[matchItemIndex].quantity += 1;
    } else {
      vm.hiddenItems.push(item);
    }
  };
}]);
