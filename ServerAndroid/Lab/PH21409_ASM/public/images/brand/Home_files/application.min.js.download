angular.module('app-versions').controller('AppVersionsController', ['$stateParams', '$location', '$scope', '$modal', 'Authentication', 'AppVersions', 'FhdMessenger', 'NgTableParams', 'ObjectId', function ($stateParams, $location, $scope, $modal, Authentication, AppVersions, FhdMessenger, NgTableParams, ObjectId) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.appVersion = {};

  vm.findOne = function () {
    AppVersions.get({
      appVersionId: $stateParams.appVersionId
    }).$promise.then(appVersion => {
      vm.appVersion = appVersion;
    });
  };

  vm.update = function ({
    os
  }) {
    const {
      code,
      news,
      releaseDate,
      required,
      link
    } = vm.appVersion.latestVersion[os];
    const appVersion = new AppVersions({
      _id: ObjectId.getObjectId(vm.appVersion),
      os,
      code,
      news,
      releaseDate,
      required,
      link
    });
    vm.waiting = true;
    appVersion.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('app-versions/' + appVersion._id);
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.create = function ({
    os
  }) {
    const appVersion = new AppVersions(vm.appVersion);
    appVersion.$save().then(function () {
      FhdMessenger.success('Đã tạo thành công!');
      $location.path('app-versions');
      vm.app = '';
      vm.code = '';
      vm.news = '';
      vm.releaseDate = '';
      vm.link = '';
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('app-versions').factory('AppVersions', ['$resource', function ($resource) {
