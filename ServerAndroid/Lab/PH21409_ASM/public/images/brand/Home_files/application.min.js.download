angular.module('facilities').controller('FacilitiesController', ['$location', 'Facilities', 'FhdMessenger', '$stateParams', 'ObjectId', 'Authentication', 'NgTableParams', 'FacilityService', 'OutletService', 'Vendors', function ($location, Facilities, FhdMessenger, $stateParams, ObjectId, Authentication, NgTableParams, FacilityService, OutletService, Vendors) {
  const vm = this;
  const seeAllRoles = ['admin', 'hau-can'];
  vm.groups = FacilityService.getGroups();
  vm.newNote = '';
  vm.data = {};
  vm.facility = {};
  vm.facility.content = '';

  vm.loadVendor = function () {
    vm.data.vendors = Vendors.query();
  };

  vm.newId = function () {
    if (!vm.facility.group) {
      return FhdMessenger.error('Bạn chưa chọn nhóm');
    }

    if (!vm.facility.facilityType) {
      return FhdMessenger.error('Bạn chưa chọn kiểu');
    }

    if (!vm.facility.purchaseDate) {
      return FhdMessenger.error('Bạn chưa chọn ngày mua');
    }

    const text = `${vm.facility.facilityType.code}-${moment(vm.facility.purchaseDate).format('YY')}`;
    vm.waiting = true;
    FacilityService.newId(text).then(facilityId => {
      vm.facility.facilityId = facilityId;
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.getStatus = () => [{
    title: 'Bình thường',
    id: 'normal'
  }, {
    title: 'Hỏng',
    id: 'error'
  }, {
    title: 'Yêu cầu mua',
    id: 'request'
  }, {
    title: 'Duyệt mua',
    id: 'accepted'
  }, {
    title: 'Đang bảo hành',
    id: 'warranting'
  }, {
    title: 'Đã xóa',
    id: 'deleted'
  }, {
    title: 'Đã thanh lý',
    id: 'liquidated'
  }];

  vm.user = Authentication.user;
  vm.notes = vm.notes || [];

  vm.transfer = function (facility) {
    FacilityService.openModalTransfer(facility).then(transferRequest => {
      facility.destination = transferRequest.destination;
      facility.reason = transferRequest.reason;
      facility.$requestTransfer(function () {
        FhdMessenger.success('Yêu cầu chuyển thành công');
      }, function (errorResponse) {
        FhdMessenger.errorFromServer(errorResponse);
      });
    });
  };

  vm.liquidate = function (facility) {
    FacilityService.openModalLiquidate(facility).then(liquidateRequest => {
      facility.liquidationMoney = liquidateRequest.liquidationMoney;
      facility.reason = liquidateRequest.reason;
      facility.$liquidate(function () {
        FhdMessenger.success('Đã gửi yêu cầu thanh lý!');
      }, function (errorResponse) {
        FhdMessenger.errorFromServer(errorResponse);
      });
    });
  };

  vm.bought = function () {
    FacilityService.openModalEdit(vm.facility._id).then(facility => {
      vm.facility = _objectSpread({}, _.cloneDeep(vm.facility), _.cloneDeep(facility));
      vm.facility.status = 'normal';
      vm.facility = new Facilities(vm.facility);
      vm.facility.$bought(function () {
        FhdMessenger.success('Đã cập nhật thông tin!');
      }, function (errorResponse) {
        FhdMessenger.errorFromServer(errorResponse);
      });
    });
  };

  vm.reportError = function (facility) {
    FacilityService.openReportError().then(reportContent => {
      if (facility) {
        facility.reportContent = reportContent;
        facility.$reportError(function () {
          FhdMessenger.success('Báo lỗi thành công');
        }, function (errorResponse) {
          FhdMessenger.errorFromServer(errorResponse);
        });
      } else {
        vm.facility.reportContent = reportContent;
        vm.facility.$reportError(function () {
          FhdMessenger.success('Báo lỗi thành công');
        }, function (errorResponse) {
          FhdMessenger.errorFromServer(errorResponse);
        });
      }
    });
  };

  vm.deleteItem = function ($index) {
    vm.quantities.splice($index, 1);
  };

  vm.create = function () {
    if (!vm.facility.name) {
      return FhdMessenger.error('Chưa có tên của vật dụng');
    }

    if (!vm.facility.description) {
      return FhdMessenger.error('Chưa có miêu tả của vật dụng');
    }

    if (!vm.facility.group) {
      return FhdMessenger.error('Chưa chọn nhóm của vật dụng');
    }

    if (!vm.facility.outlet) {
      return FhdMessenger.error('Chưa chọn cơ sở của vật dụng');
    }

    if (!vm.facility.facilityType) {
      return FhdMessenger.error('Chưa chọn kiểu của vật dụng');
    }

    if (!vm.facility.startDepreciation) {
      return FhdMessenger.error('Chưa chọn ngày bắt đầu khấu hao của vật dụng');
    }

    if (!vm.facility.purchaseDate) {
      return FhdMessenger.error('Chưa có ngày mua CSVC');
    }

    var facility = new Facilities(vm.facility);

    if (vm.facility.isRequest) {
      facility.status = 'request';
      facility.priceRange = {
        min: vm.facility.minPrice,
        max: vm.facility.maxPrice
      };
      facility.reason = vm.facility.reason;
    } else {
      facility.price = vm.facility.price;
    } // Redirect after save


    facility.$save(function (response) {
      $location.path('facilities'); // Clear form fields

      vm.facility.name = '';
      vm.facility.description = '';
      vm.facility.content = [];
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.facilityTable = new NgTableParams({
    count: 100
  });

  vm.find = function () {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const groups = _.reduce(vm.facilityGroupsMap, (groups, toShow, group) => {
      if (toShow) groups.push(group);
      return groups;
    }, []);

    const assignedOutlets = _.reduce(vm.showOutletMap, (assignedOutlets, toShow, outlet) => {
      if (toShow) assignedOutlets.push(outlet);
      return assignedOutlets;
    }, []);

    vm.facilities = Facilities.query({
      statuses,
      groups,
      assignedOutlets
    });
    vm.facilities.$promise.then(function (facilities) {
      vm.updateSummary();

      _.forEach(facilities, facility => {
        facility.depreciationTimeRemain = moment(facility.startDepreciation).add(facility.depreciationTime, 'month').diff(moment(), 'month', true);
      });

      vm.facilityTable.settings({
        dataset: facilities
      });
    });
  };

  vm.restore = function (facility) {
    if (facility) {
      facility.$restore(function () {
        FhdMessenger.success('Đã thay đổi trạng thái về bình thường');
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
      });
    } else {
      vm.facility.$restore(function () {
        FhdMessenger.success('Đã thay đổi trạng thái về bình thường');
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
      });
    }
  };

  vm.warranty = function (facility) {
    if (facility) {
      facility.$warranty(function () {
        FhdMessenger.success('Đã thay đổi trạng thái sang đang bảo hành');
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
      });
    } else {
      vm.facility.$warranty(function () {
        FhdMessenger.success('Đã thay đổi trạng thái sang đang bảo hành');
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
      });
    }
  };

  vm.accepted = function (facility) {
    if (facility) {
      facility.$accepted(function () {
        FhdMessenger.success('Đã đồng ý mua');
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
      });
    } else {
      vm.facility.$accepted(function () {
        FhdMessenger.success('Đã đồng ý mua');
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
      });
    }
  };

  vm.update = function () {
    if (vm.newNote) {
      vm.facility.notes = vm.facility.notes || [];
      vm.facility.notes.push({
        content: vm.newNote,
        user: vm.user,
        time: new Date(),
        status: vm.facility.status
      });
    }

    const facility = vm.facility;
    facility.$update(function () {
      $location.path('facilities/' + facility._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.remove = function (facility) {
    if (facility) {
      facility.$remove();

      for (var i in vm.facilities) {
        if (vm.facilities[i] === facility) {
          vm.facilities.splice(i, 1);
        }
      }
    } else {
      vm.facility.$remove(function () {
        $location.path('facilities');
      });
    }
  };

  vm.findOne = function () {
    vm.facility = Facilities.get({
      facilityId: $stateParams.facilityId
    });
  };

  vm.updateSummary = function () {
    vm.summary = {};

    const processingFacilities = _.filter(vm.facilities, facility => {
      return _.includes(['error', 'warranting', 'normal', 'accepted', 'request', 'deleted', 'liquidated'], facility.status);
    });

    _.forEach(['error', 'warranting', 'normal', 'accepted', 'request', 'deleted', 'liquidated'], status => {
      vm.summary[status] = (_.filter(processingFacilities, {
        status
      }) || []).length;
    });

    _.forEach(_.map(vm.groups, 'group'), group => {
      vm.summary[group] = (_.filter(processingFacilities, {
        group
      }) || []).length;
    });

    vm.getOutlets.then(() => {
      _.forEach(vm.data.outlets, outlet => {
        const outletId = outlet._id;
        vm.summary[outletId] = (_.filter(processingFacilities, facility => {
          return _.get(facility, 'outlet._id') === outlet._id;
        }) || []).length;
      });
    });
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      case 'facilityTypes':
        {
          let changeValue = true;
          if (_.every(vm.facilityGroupsMap)) changeValue = false;

          _.forEach(vm.facilityGroupsMap, (value, key) => {
            vm.facilityGroupsMap[key] = changeValue;
          });

          break;
        }

      case 'outlet':
        {
          let changeValue = true;
          if (_.every(vm.showOutletMap)) changeValue = false;

          _.forEach(vm.showOutletMap, (value, key) => {
            vm.showOutletMap[key] = vm.enableOutletMap[key] && changeValue;
          });

          break;
        }

      default:
    }
  };

  vm.init = () => {
    vm.statusMap = {
      error: true,
      warranting: true,
      normal: true
    };
    vm.facilityGroupsMap = _.reduce(vm.groups, (result, group) => {
      result[group.group] = true;
      return result;
    }, {});
    vm.getOutlets = OutletService.allAsync().then(outlets => {
      vm.data.outlets = _.filter(outlets, {
        deleted: false,
        hasStaff: true
      });
      vm.showOutletMap = _.reduce(vm.data.outlets, (result, outlet) => {
        if (_.intersection(vm.user.roles, seeAllRoles).length > 0 || _.some(vm.user.managingOutlets, {
          code: outlet.code
        }) || ObjectId.equals(outlet, vm.user.outlet)) {
          result[outlet._id] = true;
        }

        return result;
      }, {});
      vm.enableOutletMap = _.clone(vm.showOutletMap);
    });
  };
}]);
"use strict";

angular.module('facilities').controller('ModalEditFacilityController', ['$modalInstance', 'FhdMessenger', 'Facilities', 'facilityId', function ($modalInstance, FhdMessenger, Facilities, facilityId) {
  const vm = this;

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.findOne = function () {
    vm.facility = Facilities.get({
      facilityId: facilityId
    });
  };

  vm.edited = function () {
    vm.facility.status = 'normal';
    $modalInstance.close(vm.facility);
  };
}]);
