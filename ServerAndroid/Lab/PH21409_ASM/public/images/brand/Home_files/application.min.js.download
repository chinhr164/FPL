angular.module('core').factory('ShiftService', [function () {
  const defaultShifts = [{
    name: 'Sáng',
    code: 'S'
  }, {
    name: 'Chiều',
    code: 'C'
  }, {
    name: 'Tối',
    code: 'T'
  }];
  const extendShifts = [{
    name: 'Sáng 5h - 8h',
    code: 'S_1'
  }, {
    name: 'Sáng 5h - 17h',
    code: 'S_7'
  }, {
    name: 'Sáng 7h - 12h',
    code: 'S_2'
  }, {
    name: 'Sáng 7h - 14h',
    code: 'S_3'
  }, {
    name: 'Sáng 7h - 17h',
    code: 'S_8'
  }, {
    name: 'Sáng 8h - 15h',
    code: 'S_4'
  }, {
    name: 'Sáng 8h - 16h',
    code: 'S_5'
  }, {
    name: 'Sáng 8h - 17h',
    code: 'S_6'
  }, {
    name: 'Chiều 14h - 21h',
    code: 'C_1'
  }, {
    name: 'Chiều 11h - 21h',
    code: 'C_2'
  }, {
    name: 'Chiều 12h - 22h',
    code: 'C_3'
  }, {
    name: 'Tối 21h - 24h',
    code: 'T_1'
  }, {
    name: 'Đêm 22h - 7h',
    code: 'D_1'
  }];

  const getCurrentShift = function () {
    const date = new Date();
    const afternoonShift = new Date();
    afternoonShift.setHours(12, 30, 0, 0);
    const nightShift = new Date();
    nightShift.setHours(17, 0, 0, 0);
    if (date < afternoonShift) return defaultShifts[0];
    if (date < nightShift) return defaultShifts[1];
    return defaultShifts[2];
  };

  return {
    currentShift: getCurrentShift,

    getShifts() {
      return defaultShifts;
    },

    getExtendShifts() {
      return extendShifts;
    },

    all(callback) {
      callback(null, defaultShifts);
    },

    withAllOption(callback) {
      const _shifts = _.cloneDeep(defaultShifts);

      _shifts.push({
        name: '== Chưa chọn ==',
        code: null
      });

      callback(null, _shifts);
    },

    getNextShift(shift) {
      const currentShift = shift || getCurrentShift();
      if (_.get(currentShift, 'code', currentShift) === 'S') return defaultShifts[1];
      if (_.get(currentShift, 'code', currentShift) === 'C') return defaultShifts[2];
      return defaultShifts[0];
    },

    getFromCode(code) {
      return _.find(defaultShifts, {
        code
      });
    }

  };
}]);
'use strict';

