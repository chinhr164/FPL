angular.module('order-entries').controller('ModalOrderMultiOrderEntriesController', ['$modalInstance', 'FhdMessenger', 'orderEntries', 'OrderEntriesService', 'Vendors', function ($modalInstance, FhdMessenger, orderEntries, OrderEntriesService, Vendors) {
  const vm = this;
  vm.orderEntries = orderEntries;

  _.forEach(vm.orderEntries, orderEntry => {
    orderEntry.cogs = orderEntry.product.cogs;
    orderEntry.orderQuantity = _.get(orderEntry, 'requestQuantity', 0);
  });

  vm.data = {};
  vm.data.vendors = Vendors.query();
  vm.images = [];

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.dismiss = $modalInstance.dismiss;

  vm.addImage = newImage => {
    vm.images = vm.images || [];

    if (newImage) {
      vm.images.push({
        data: newImage
      });
    }
  };

  vm.removeImage = index => {
    vm.images.splice(index, 1);
  };

  vm.orderMultiOrderEntries = function () {
    if (!vm.orderEntryVendor) {
      return FhdMessenger.error('Chưa có vendor cho các Order Entry');
    }

    if (!vm.assignStaff) {
      return FhdMessenger.error('Chưa có nhân viên xử lý các Order Entry');
    }

    if (_.some(vm.orderEntries, orderEntry => {
      return !orderEntry.orderQuantity;
    })) {
      return FhdMessenger.error('Có Order Entry chưa có số lượng nhập cho sản phẩm');
    }

    if (_.some(vm.orderEntries, orderEntry => {
      return !orderEntry.cogs && orderEntry.cogs !== 0;
    })) {
      return FhdMessenger.error('Có Order Entry chưa có giá vốn cho sản phẩm');
    }

    _.forEach(vm.orderEntries, orderEntry => {
      orderEntry.vendor = vm.orderEntryVendor._id || vm.orderEntryVendor;
      orderEntry.assignStaff = vm.assignStaff;
      orderEntry.exportOutlet = vm.exportOutlet;
    });

    vm.waiting = true;
    OrderEntriesService.orderMultiOrderEntries({
      orderEntries: vm.orderEntries,
      billImages: vm.images
    }).then(orderEntries => {
      FhdMessenger.success('Nhập hàng thành công');
      $modalInstance.close(orderEntries);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict'; // Buying entries controller

angular.module('order-entries').controller('ModalRequestPickingOrderEntriesController', ['$modalInstance', 'FhdMessenger', 'orderEntries', 'OrderEntriesService', 'StockMap', function ($modalInstance, FhdMessenger, orderEntries, OrderEntriesService, StockMap) {
  const vm = this;

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.chooseRawProduct = function (rawProduct, orderEntry) {
    orderEntry.rawProduct = rawProduct;
  };

  vm.dismiss = $modalInstance.dismiss;
  OrderEntriesService.getOrderEntriesWithConvertProduct(orderEntries).then(_orderEntries => {
    vm.orderEntries = _orderEntries;
  });
  StockMap.getStockMapCache().then(data => {
    vm.stockMap = data;
  });

  vm.requestPickingOrderEntries = function () {
    if (!_.get(vm.exportOutlet, '_id')) {
      return FhdMessenger.error('Chưa chọn cơ sở chuyển hàng');
    }

    if (_.some(vm.orderEntries, orderEntry => {
      return !orderEntry.rawProduct;
    })) {
      return FhdMessenger.error('Có Order Entry chưa có sản phẩm quy đổi');
    }

    _.forEach(vm.orderEntries, orderEntry => {
      orderEntry.exportOutlet = vm.exportOutlet;
    });

    vm.waiting = true;
    OrderEntriesService.requestPickingOrderEntries({
      orderEntries: vm.orderEntries
    }).then(orderEntries => {
      FhdMessenger.success('Nhập hàng thành công');
      $modalInstance.close(orderEntries);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict'; // Buying entries controller

angular.module('order-entries').controller('ModalUpdateOrderEntryController', ['$modalInstance', 'FhdMessenger', 'orderEntry', 'OrderEntries', 'Vendors', function ($modalInstance, FhdMessenger, orderEntry, OrderEntries, Vendors) {
  const vm = this;
  vm.orderEntry = OrderEntries.get({
    orderEntryId: orderEntry._id
  });

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.dismiss = $modalInstance.dismiss;
  vm.data = {};
  vm.data.vendors = Vendors.query();

  vm.update = function (orderEntry) {
    vm.waiting = true;
    orderEntry.$update().then(orderEntry => {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close(orderEntry);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.order = function (orderEntry) {
    if (!orderEntry.vendor) {
      return FhdMessenger.error('Chưa có vendor cho Order Entry');
    }

    if (!orderEntry.cogs) {
      return FhdMessenger.error('Chưa có giá vốn cho sản phẩm');
    }

    if (!orderEntry.orderQuantity) {
      return FhdMessenger.error('Chưa có số lượng nhập cho sản phẩm');
    }

    vm.waiting = true;
    orderEntry.$order().then(orderEntry => {
      FhdMessenger.success('Nhập hàng thành công');
      $modalInstance.close(orderEntry);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('order-entries').controller('ModalViewOrderEntryController', ['$modalInstance', 'FhdMessenger', 'orderEntry', 'OrderEntries', 'Vendors', function ($modalInstance, FhdMessenger, orderEntry, OrderEntries, Vendors) {
  const vm = this;

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.orderEntry = OrderEntries.get({
    orderEntryId: orderEntry._id
  });
}]);
'use strict'; // Buying entries controller

angular.module('order-entries').controller('OrderEntriesController', ['$state', '$scope', 'Authentication', 'ConfirmModal', 'OrderEntries', 'OrderEntriesService', 'ObjectId', 'FhdMessenger', 'NgTableParams', 'OutletService', function ($state, $scope, Authentication, ConfirmModal, OrderEntries, OrderEntriesService, ObjectId, FhdMessenger, NgTableParams, OutletService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.summary = {};
  vm.orderEntriesTable = new NgTableParams({
    count: 100
  });
  vm.openViewOrderEntryModal = OrderEntriesService.openViewOrderEntryModal;

  vm.importOrderEntries = function () {
    if (_.some(vm.orderEntries, orderEntry => {
      return !orderEntry.sku;
    })) {
      return FhdMessenger.error('Có Order Entry chưa có sản phẩm');
    }

    if (_.some(vm.orderEntries, orderEntry => {
      return orderEntry.sku.match(/R\d+/);
    })) {
      return FhdMessenger.error('Không được import mã R trong Order Entry');
    }

    if (_.some(vm.orderEntries, orderEntry => {
      return !orderEntry.outletCode;
    })) {
      return FhdMessenger.error('Có Order Entry chưa có cơ sở');
    }

    if (_.some(vm.orderEntries, orderEntry => {
      return !orderEntry.requestQuantity;
    })) {
      return FhdMessenger.error('Có Order Entry chưa có số lượng');
    }

    vm.orderEntries = _.reduce(vm.orderEntries, (result, orderEntry) => {
      result.push({
        sku: orderEntry.sku.trim(),
        requestQuantity: orderEntry.requestQuantity,
        outletCode: orderEntry.outletCode.trim(),
        description: orderEntry.description ? orderEntry.description.trim() : ''
      });
      return result;
    }, []);
    OutletService.allAsync().then(outlets => {
      outlets = _.filter(outlets, outlet => {
        return _.includes(_.map(vm.orderEntries, orderEntry => orderEntry.outletCode), outlet.code);
      });

      let outletIds = _.map(outlets, '_id');

      return outletIds;
    }).then(outletIds => {
      OrderEntries.query({
        statuses: ['created', 'order'],
        destinations: outletIds,
        skus: _.map(vm.orderEntries, 'sku')
      }).$promise.then(orderEntries => {
        if (orderEntries.length) {
          let orderEntryIdsText = _.reduce(orderEntries, (result, orderEntry) => {
            return `${result}\n OrderEntryId: ${orderEntry.orderEntryId}, SKU: ${orderEntry.sku}, Description: ${orderEntry.description}, Quantity: ${orderEntry.requestQuantity}, Outlet: ${orderEntry.destination.code}, Time Ordered: ${moment(orderEntry.created).format('L')}`;
          }, ``);

          ConfirmModal.showModal({}, {
            actionButtonText: `Xác nhận`,
            headerText: `Xác nhận Import Order Entries`,
            bodyText: `Các OE có vẻ trùng với OE đang import:${orderEntryIdsText}.\nBạn vẫn muốn tiếp tục?`
          }).then(() => {
            vm.waiting = true;
            OrderEntriesService.importOrderEntries(vm.orderEntries).then(orderEntries => {
              FhdMessenger.success('Import thành công');
              $state.go('listOrderEntries');
            }).catch(error => {
              FhdMessenger.error(error.data.message);
            }).finally(() => {
              vm.waiting = false;
            });
          });
        } else {
          OrderEntriesService.importOrderEntries(vm.orderEntries).then(orderEntries => {
            FhdMessenger.success('Import thành công');
            $state.go('listOrderEntries');
          }).catch(error => {
            FhdMessenger.error(error.data.message);
          }).finally(() => {
            vm.waiting = false;
          });
        }
      });
    });
  };

  vm.init = () => {
    vm.data = {
      statuses: OrderEntriesService.getStatuses() // Build status map

    };
    vm.statusMap = _.reduce(vm.data.statuses, (result, status) => {
      result[status.id] = false;
      return result;
    }, {});
    vm.statusMap.created = true;
    vm.statusMap.ordered = true;
    vm.statusMap.picking = true;
    vm.statusMap.booked = true;
    OutletService.allAsync().then(outlets => {
      vm.data.outlets = _.filter(outlets, outlet => {
        const outletCode = _.get(outlet, 'code', '');

        return outletCode.match(/^[SBDKG]\d+/) || ['OFFICE', 'R&D', 'SS'].includes(outletCode);
      });
      vm.outletMap = {};
    });
  };

  vm.searchKeyUp = function ($event) {
    if ($event.keyCode === 13) vm.find();
  };

  vm.selectAll = function (field) {
    const map = vm[`${field}Map`];
    let newValue = true;
    if (_.every(map)) newValue = false;

    _.forEach(map, (value, key) => {
      map[key] = newValue;
    });
  };

  vm.updateOrderEntry = function (orderEntry) {
    OrderEntriesService.openUpdateOrderEntryModal(orderEntry).result.then(newOrderEntry => {
      orderEntry = newOrderEntry;
      vm.find();
    });
  };

  vm.book = function (orderEntry) {
    OrderEntriesService.openBookOrderEntryModal(orderEntry).result.then(newOrderEntry => {
      orderEntry = newOrderEntry;
      vm.findPicking();
    });
  };

  vm.cancel = function (orderEntry) {
    OrderEntriesService.openCancelOrderEntryModal(orderEntry).result.then(newOrderEntry => {
      orderEntry = newOrderEntry;
      vm.find();
    });
  };

  vm.terminate = function (orderEntry) {
    if (moment(orderEntry.deadline).diff(moment()) < 0) {
      return FhdMessenger.error('Không thể hủy Order Entry quá deadline');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc muốn hủy Order Entry ${orderEntry.orderEntryId} ${orderEntry.sku} - ${orderEntry.description}`
    }).then(() => {
      vm.waiting = true;
      orderEntry.$terminate().then(orderEntry => {
        FhdMessenger.success('Hủy đơn thành công');
      }).catch(error => {
        FhdMessenger.error(error);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.restore = function (orderEntry) {
    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc muốn khôi phục Order Entry ${orderEntry.orderEntryId} ${orderEntry.sku} - ${orderEntry.description}`
    }).then(() => {
      vm.waiting = true;
      orderEntry.$restore().then(orderEntry => {
        FhdMessenger.success('Khôi phục đơn thành công');
      }).catch(error => {
        FhdMessenger.error(error);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.checkAll = function () {
    _.forEach(vm.orderEntriesTable.data, orderEntry => {
      orderEntry.checked = vm.toCheck;
    });
  };

  vm.exportForm = function () {
    const orderEntries = [{
      sku: 'V0047',
      outletCode: 'B1',
      requestQuantity: 1000
    }, {
      sku: 'V0049',
      outletCode: 'B1',
      requestQuantity: 5000
    }];
    alasql(`SELECT * INTO XLSX("form-import-order-entries.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [orderEntries]);
  };

  vm.orderMultiOrderEntries = function () {
    const orderEntries = _.filter(vm.orderEntriesTable.data, 'checked');

    if (!orderEntries.length) {
      return FhdMessenger.error('Chưa có Order Entry nào');
    }

    const destination = orderEntries[0].destination;

    if (_.some(orderEntries, orderEntry => {
      return ObjectId.getObjectId(orderEntry.destination) !== ObjectId.getObjectId(destination);
    })) {
      return FhdMessenger.error('Các Order Entry không có cùng nơi nhận');
    }

    if (_.some(orderEntries, orderEntry => {
      return !['created', 'booked'].includes(orderEntry.status);
    })) {
      return FhdMessenger.error('Có Order Entry không ở trạng thái Đã tạo hoặc Đã chuyển');
    }

    OrderEntriesService.openOrderMultiOrderEntriesModal(orderEntries).result.then(newOrderEntries => {
      vm.find();
    });
  };

  vm.assignMultiOrderEntries = function () {
    const orderEntries = _.filter(vm.orderEntriesTable.data, 'checked');

    if (!orderEntries.length) {
      return FhdMessenger.error('Chưa có Order Entry nào');
    }

    OrderEntriesService.openAssignMultiOrderEntriesModal(orderEntries).result.then(newOrderEntries => {
      vm.find();
    });
  };

  vm.requestPickingOrderEntries = function () {
    const orderEntries = _.filter(vm.orderEntriesTable.data, 'checked');

    if (!orderEntries.length) {
      return FhdMessenger.error('Chưa có Order Entry nào');
    }

    const destination = orderEntries[0].destination;

    if (_.some(orderEntries, orderEntry => {
      return ObjectId.getObjectId(orderEntry.destination) !== ObjectId.getObjectId(destination);
    })) {
      return FhdMessenger.error('Các Order Entry không có cùng nơi nhận');
    }

    OrderEntriesService.openRequestPickingOrderEntriesModal(orderEntries).result.then(newOrderEntries => {
      vm.find();
    });
  };

  vm.cancelMultiOrderEntries = function () {
    const orderEntries = _.filter(vm.orderEntriesTable.data, 'checked');

    if (!orderEntries.length) {
      return FhdMessenger.error('Chưa có Order Entry nào');
    }

    OrderEntriesService.openCancelMultiOrderEntriesModal(orderEntries).result.then(newOrderEntries => {
      vm.find();
    });
  };

  vm.updateSummary = function () {
    _.forEach(vm.data.statuses, status => {
      vm.summary[status.id] = _.filter(vm.orderEntries, {
        status: status.id
      }).length;
    });

    OutletService.allAsync().then(() => {
      _.forEach(vm.data.outlets, outlet => {
        vm.summary[outlet._id] = _.filter(vm.orderEntries, orderEntry => {
          return _.get(orderEntry, 'destination._id') === outlet._id;
        }).length;
      });
    });
  };

  vm.find = function () {
    const statuses = _.reduce(vm.statusMap, (result, value, status) => {
      if (value) result.push(status);
      return result;
    }, []);

    const destinations = _.reduce(vm.outletMap, (result, value, outlet) => {
      if (value) result.push(outlet);
      return result;
    }, []);

    FhdMessenger.info('Đang tìm...');
    vm.waiting = true;
    vm.orderEntries = OrderEntries.query({
      statuses,
      destinations,
      searchText: vm.searchText
    });
    vm.orderEntries.$promise.then(orderEntries => {
      FhdMessenger.success(`Tìm thấy ${orderEntries.length} kết quả`);
      return orderEntries;
    }).then(function (orderEntries) {
      _.forEach(orderEntries, orderEntry => {
        getDeadlineLabelForOrderEntryDeadline(orderEntry);
      });

      vm.updateSummary();
      vm.orderEntriesData = orderEntries;
      return orderEntries;
    }).then(orderEntries => {
      _.forEach(orderEntries, orderEntry => {
        if (orderEntry.buyingEntry) {
          orderEntry.stockEntry = {};
          orderEntry.stockEntry.stockEntryId = orderEntry.buyingEntry.buyingEntryId;
        }
      });

      vm.orderEntriesTable.settings({
        dataset: orderEntries
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findPicking = function () {
    const statuses = ['picking'];

    const destinations = _.reduce(vm.outletMap, (result, value, outlet) => {
      if (value) result.push(outlet);
      return result;
    }, []);

    FhdMessenger.info('Đang tìm...');
    vm.updating = true;
    vm.orderEntries = OrderEntries.query({
      statuses,
      destinations,
      searchText: vm.searchText
    });
    vm.orderEntries.$promise.then(orderEntries => {
      FhdMessenger.success(`Tìm thấy ${orderEntries.length} kết quả`);
      return orderEntries;
    }).then(function (orderEntries) {
      _.forEach(orderEntries, orderEntry => {
        orderEntry.pickingDiffTime = moment(orderEntry.picking).diff(orderEntry.created, 'hours');
      });

      vm.updateSummary();
      return orderEntries;
    }).then(orderEntries => {
      vm.orderEntriesTable.settings({
        dataset: orderEntries
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.updating = false;
    });
  };

  function getDeadlineLabelForOrderEntryDeadline(orderEntry) {
    if (!orderEntry.deadline || orderEntry.status !== 'created') {
      return;
    }

    const deadlineDiffDay = moment(orderEntry.deadline).diff(moment()) / 1000 / 60 / 60 / 24;

    if (deadlineDiffDay <= -0.5) {
      orderEntry.deadlineLabel = 'danger';
    } else if (deadlineDiffDay < 0) {
      orderEntry.deadlineLabel = 'warning';
    }
  }

  $scope.$watch(() => vm.orderEntriesTable.data, (newValue, oldValue) => {
    vm.showCancelNote = false;
    if (!newValue || newValue === oldValue) return;

    if (_.every(newValue, {
      status: 'cancelled'
    })) {
      vm.showCancelNote = true;
    }
  });
}]);
'use strict'; // Buying entries service used to communicate Buying entries REST endpoints

angular.module('order-entries').factory('OrderEntries', ['$resource', function ($resource) {
  return $resource('order-entries/:orderEntryId', {
    orderEntryId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    order: {
      method: 'PUT',
      url: 'order-entries/:orderEntryId/order'
    },
    terminate: {
      method: 'PUT',
      url: 'order-entries/:orderEntryId/terminate'
    },
    restore: {
      method: 'PUT',
      url: 'order-entries/:orderEntryId/restore'
    },
    cancel: {
      method: 'PUT',
      url: 'order-entries/:orderEntryId/cancel'
    },
    book: {
      method: 'PUT',
      url: 'order-entries/:orderEntryId/book'
    },
    importOrderEntry: {
      method: 'POST',
      url: 'order-entries/import',
      isArray: true
    }
  });
}]);
'use strict'; // Buying entries service used to communicate Buying entries REST endpoints

angular.module('order-entries').factory('OrderEntriesService', ['$http', '$modal', function ($http, $modal) {
  function importOrderEntries(orderEntries) {
    return $http.post('/order-entries/import', orderEntries).then(response => response.data);
  }

  function orderMultiOrderEntries({
    orderEntries,
    billImages
  }) {
    return $http.put('/order-entries/order-multi', {
      orderEntries,
      billImages
    }).then(response => response.data);
  }

  function requestPickingOrderEntries({
    orderEntries
  }) {
    return $http.put('/order-entries/request-picking', {
      orderEntries
    }).then(response => response.data);
  }

  function getOrderEntriesWithConvertProduct(orderEntries) {
    return $http.put('/order-entries/get-convert-product', {
      orderEntries
    }).then(response => response.data);
  }

  function assignMultiOrderEntries(orderEntries) {
    return $http.put('/order-entries/assign-multi', orderEntries).then(response => response.data);
  }

  function cancelMultiOrderEntries(orderEntries) {
    return $http.put('/order-entries/cancel-multi', orderEntries).then(response => response.data);
  }

  const statuses = [{
    id: 'created',
    title: 'Đã tạo',
    idName: 'showCreated',
    class: 'warning'
  }, {
    id: 'picking',
    title: 'Đang lấy',
    idName: 'showPicking',
    class: 'primary'
  }, {
    id: 'booked',
    title: 'Đã lấy',
    idName: 'showBooked',
    class: 'ready'
  }, {
    id: 'ordered',
    title: 'Đã nhập',
    idName: 'showOrdered',
    class: 'info'
  }, {
    id: 'done',
    title: 'Hoàn thành',
    idName: 'showDone',
    class: 'success'
  }, {
    id: 'terminated',
    title: 'Bị hủy',
    idName: 'showTerminated',
    class: 'danger'
  }, {
    id: 'cancelled',
    title: 'Đã xóa',
    idName: 'showCancelled',
    class: 'default'
  }];
  return {
    getStatuses() {
      return statuses;
    },

    importOrderEntries,
    orderMultiOrderEntries,
    assignMultiOrderEntries,
    cancelMultiOrderEntries,
    requestPickingOrderEntries,
    getOrderEntriesWithConvertProduct,

    openUpdateOrderEntryModal(orderEntry) {
      return $modal.open({
        templateUrl: 'modules/order-entries/views/modal-update-order-entry.client.view.html',
        controller: 'ModalUpdateOrderEntryController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          orderEntry: () => orderEntry
        }
      });
    },

    openViewOrderEntryModal(orderEntry) {
      return $modal.open({
        templateUrl: 'modules/order-entries/views/modal-view-order-entry.client.view.html',
        controller: 'ModalViewOrderEntryController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          orderEntry: () => orderEntry
        }
      });
    },

    openOrderMultiOrderEntriesModal(orderEntries) {
      return $modal.open({
        templateUrl: 'modules/order-entries/views/modal-order-multi-order-entries.client.view.html',
        controller: 'ModalOrderMultiOrderEntriesController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          orderEntries: () => orderEntries
        }
      });
    },

    openAssignMultiOrderEntriesModal(orderEntries) {
      return $modal.open({
        templateUrl: 'modules/order-entries/views/modal-assign-multi-order-entries.client.view.html',
        controller: 'ModalAssignMultiOrderEntriesController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          orderEntries: () => orderEntries
        }
      });
    },

    openRequestPickingOrderEntriesModal(orderEntries) {
      return $modal.open({
        templateUrl: 'modules/order-entries/views/modal-request-picking-order-entries.client.view.html',
        controller: 'ModalRequestPickingOrderEntriesController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          orderEntries: () => orderEntries
        }
      });
    },

    openCancelMultiOrderEntriesModal(orderEntries) {
      return $modal.open({
        templateUrl: 'modules/order-entries/views/modal-cancel-multi-order-entries.client.view.html',
        controller: 'ModalCancelOrderEntriesController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          orderEntries: () => orderEntries
        }
      });
    },

    openOrderedForOrderEntryModal(orderEntry) {
      return $modal.open({
        templateUrl: 'modules/order-entries/views/modal-ordered-for-order-entry.client.view.html',
        controller: 'ModalUpdateOrderEntryController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          orderEntry: () => orderEntry
        }
      });
    },

    openCancelOrderEntryModal(orderEntry) {
      return $modal.open({
        templateUrl: 'modules/order-entries/views/modal-cancel-order-entry.client.view.html',
        controller: 'ModalCancelOrderEntryController',
        controllerAs: 'vm',
        resolve: {
          orderEntry: () => orderEntry
        }
      });
    },

    openBookOrderEntryModal(orderEntry) {
      return $modal.open({
        templateUrl: 'modules/order-entries/views/modal-book-order-entry.client.view.html',
        controller: 'ModalBookOrderEntryController',
        controllerAs: 'vm',
        resolve: {
          orderEntry: () => orderEntry
        }
      });
    }

  };
}]);
"use strict";

// Setting up route
angular.module('outlet-reports').config(['$stateProvider', function ($stateProvider) {
  // Outlet report state routing
  $stateProvider.state('createOutletReport', {
    url: '/outlet-reports/create',
    templateUrl: 'modules/outlet-reports/views/create-outlet-reports.client.view.html',
    resolve: {
      $title: _.constant('Create Outlet Report')
    }
  }).state('listOutletReports', {
    url: '/outlet-reports',
    templateUrl: 'modules/outlet-reports/views/list-outlet-reports.client.view.html',
    resolve: {
      $title: _.constant('List Outlet Report')
    }
  }).state('importOutletReportsForSaleCodes', {
    url: '/outlet-reports/create-for-sale-codes',
    templateUrl: 'modules/outlet-reports/views/import-outlet-reports-for-sale-codes.client.view.html',
    resolve: {
      $title: _.constant('Import Outlet Reports For Sale Codes')
    }
  }).state('summarizeOutletReport', {
    url: '/outlet-reports/summarize',
    templateUrl: 'modules/outlet-reports/views/summarize-outlet-reports.client.view.html',
    resolve: {
      $title: _.constant('Summarize Outlet Report')
    }
  }).state('editOutletReport', {
    url: '/outlet-reports/:outletReportId',
    templateUrl: 'modules/outlet-reports/views/edit-outlet-report.client.view.html',
    resolve: {
      $title: _.constant('Edit Outlet Report')
    }
  }).state('viewSummarizeOutletReport', {
    url: '/outlet-reports/:outletReportId/view-summarize',
    templateUrl: 'modules/outlet-reports/views/view-summarize-outlet-report.client.view.html',
    resolve: {
      $title: _.constant('View Summarize Outlet Report')
    }
  }).state('doneOutletReport', {
    url: '/outlet-reports/:outletReportId/done',
    templateUrl: 'modules/outlet-reports/views/done-outlet-report.client.view.html',
    resolve: {
      $title: _.constant('Done Outlet Report')
    }
  });
}]);
'use strict';

angular.module('outlet-reports').controller('ImportOutletReportsForSaleCodesController', ['Authentication', 'FhdMessenger', '$http', '$location', 'OutletReports', 'ConfirmModal', 'helper', function (Authentication, FhdMessenger, $http, $location, OutletReports, ConfirmModal, helper) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;

  vm.import = () => {
    if (!_.intersection(vm.user.roles, ['outlet-report:create', 'admin']).length) {
      return FhdMessenger.error('Bạn không có quyền import');
    }

    if (_.some(vm.rawItems, item => {
      return !item.saleCodeId;
    })) {
      return FhdMessenger.error('Bạn chưa điền mã sale code');
    }

    if (_.some(vm.rawItems, item => {
      return !item.outlet;
    })) {
      return FhdMessenger.error('Bạn chưa điền mã cơ sở của sale code');
    }

    if (_.some(vm.rawItems, item => {
      return !['Update Stock', 'Chuyển hàng', 'Cập nhật giá sale'].includes(item.title);
    })) {
      return FhdMessenger.error('Tiêu đề Outlet Report chỉ thuộc 1 trong 3 kiểu Update Stock, Chuyển hàng, Cập nhật giá sale');
    }

    vm.waiting = true;
    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ tạo ${vm.rawItems.length} Outlet Report cho Sale Code?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      OutletReports.createForSaleCodes({
        rawItems: vm.rawItems
      }).$promise.then(outletReports => {
        vm.outletReports = outletReports;
        return FhdMessenger.success('Import thành công');
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

// Modal general Outlet report controller
angular.module('outlet-reports').controller('ModalCreateOutletReportController', ['$modalInstance', 'data', 'FhdMessenger', 'ObjectId', 'OutletReports', 'OutletReportService', function ($modalInstance, data, FhdMessenger, ObjectId, OutletReports, OutletReportService) {
  const vm = this;
  vm.dismiss = $modalInstance.dismiss;
  vm.data = {
    types: OutletReportService.getTypes()
  };
  vm.outletReport = {};

  if (data.announcement) {
    const announcement = data.announcement;
    vm.outletReport = {
      announcement: announcement,
      type: 'check-label',
      outlets: _.filter(announcement.outlets, {
