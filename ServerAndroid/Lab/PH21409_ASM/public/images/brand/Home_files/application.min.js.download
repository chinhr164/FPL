// Setting up route
angular.module('contacts').config(['$stateProvider', function ($stateProvider) {
  // Buying entries state routing
  $stateProvider.state('createContact', {
    url: '/contacts/create',
    templateUrl: 'modules/contacts/views/create-contact.client.view.html',
    resolve: {
      $title: _.constant('Create Contact')
    }
  }).state('listContacts', {
    url: '/contacts',
    templateUrl: 'modules/contacts/views/list-contacts.client.view.html',
    resolve: {
      $title: _.constant('List Contact')
    }
  }).state('editContact', {
