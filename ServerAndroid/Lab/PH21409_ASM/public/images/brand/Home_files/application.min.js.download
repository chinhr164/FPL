angular.module('thumb-ups').controller('ImportThumbUpsController', ['Authentication', 'ThumbUps', 'FhdMessenger', '$http', '$location', '$state', 'ConfirmModal', function (Authentication, ThumbUps, FhdMessenger, $http, $location, $state, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.requireFields = 'code content amount type'.split(' ');

  function isAllValidField(field) {
    return _.some(vm.rawItems, item => {
      return !_.get(item, field) && _.get(item, field) !== 0;
    });
  }

  function validateItems() {
    let errors = [];

    if (!_.intersection(vm.user.roles, ['admin', 'thumb-up:create']).length) {
      errors.push(`Bạn không có quyền import thumb ups`);
      return errors;
    }

    _.forEach(vm.requireFields, requireField => {
      if (isAllValidField(requireField)) {
        errors.push(`Bạn chưa điền đủ ${requireField}`);
      }
    });

    return errors;
  }

  vm.import = () => {
    if (!vm.rawItems) {
      return;
    }

    const errCreate = validateItems();

    if (errCreate.length) {
      _.forEach(errCreate, err => {
        return FhdMessenger.error(err);
      });

      return;
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ import ${vm.rawItems.length} thumb ups ?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      ThumbUps.importThumbUps({
        rawItems: vm.rawItems
      }).$promise.then(thumbUps => {
        vm.thumbUps = thumbUps;

        _.forEach(vm.thumbUps, thumbUp => {
          thumbUp.salaryDate = moment(thumbUp.salaryDate).format('L');
        });

        return FhdMessenger.success(`Import ${thumbUps.length} thumb ups thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
'use strict';

angular.module('thumb-ups').controller('ModalCreateThumbUpController', ['userId', 'FhdMessenger', 'Users', 'ThumbUps', '$modalInstance', '$state', 'options', 'ObjectId', '$q', function (userId, FhdMessenger, Users, ThumbUps, $modalInstance, $state, options, ObjectId, $q) {
  const vm = this;
  const AMOUNT_OF_REPORTS_NEED_RECEIVED_THUMB_UP = 5;
  const {
    reports,
    amount = 1,
    checklist
  } = options;
  const isDiv = !(_.get(reports, 'length') % AMOUNT_OF_REPORTS_NEED_RECEIVED_THUMB_UP);
  const chunkedReports = isDiv ? _.chunk(reports, AMOUNT_OF_REPORTS_NEED_RECEIVED_THUMB_UP) : _.chunk(reports, AMOUNT_OF_REPORTS_NEED_RECEIVED_THUMB_UP).slice(0, amount);

  vm.init = function () {
    vm.type = 'week';

    if (userId) {
      vm.staff = Users.get({
        userId: userId
      });
    }
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  }; // Create new Rank a point


  vm.create = function () {
    vm.waiting = true;

    if (!vm.staff) {
      FhdMessenger.errorFromServer('Chưa có nhân viên');
      return;
    }

    if (!vm.name) {
      FhdMessenger.errorFromServer('Chưa có lý do nhận Thumb Up');
      return;
    }

    if (!vm.prizeMoney) {
      FhdMessenger.errorFromServer('Chưa có số tiền thưởng Thumb Up');
      return;
    }

    if (!chunkedReports.length) {
      const thumbUp = new ThumbUps({
        staff: vm.staff,
        name: vm.name,
        thumbUpType: vm.type,
        prizeMoney: vm.prizeMoney,
        startDate: new Date(),
        endDate: new Date(),
        refObject: {
          checkListEntry: checklist
        },
        salaryDate: vm.salaryDate
      });
      return thumbUp.$save().then(thumbUp => {
        FhdMessenger.success('Tạo thumb up thành công');
        $modalInstance.close(thumbUp);
      }).catch(err => {
        return FhdMessenger.error('Có lỗi xảy ra :', err.message);
      }).finally(() => {
        vm.waiting = false;
      });
    }

    $q.all(_.map(chunkedReports, report => {
      const thumbUp = new ThumbUps({
        staff: vm.staff,
        name: vm.name,
        thumbUpType: vm.type,
        prizeMoney: vm.prizeMoney,
        startDate: new Date(),
        endDate: new Date(),
        salaryDate: vm.salaryDate,
        refObject: {
          saleReports: _.map(_.filter(report, 'saleReportId'), ObjectId.getObjectId),
          shiftReports: _.map(_.filter(report, 'shiftReportId'), ObjectId.getObjectId)
        }
      });
      thumbUp.$save();
    })).then(() => {
      FhdMessenger.success('Tạo thumb up thành công');
      $modalInstance.close(); // $state.reload()
    }).catch(err => {
      return FhdMessenger.error('Có lỗi xảy ra :', err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

