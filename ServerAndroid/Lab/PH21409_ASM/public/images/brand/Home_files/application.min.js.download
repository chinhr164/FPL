"use strict";

/* eslint-disable angular/controller-as */
angular.module('users').directive('fhdStaffInput', [function () {
  return {
    templateUrl: '/modules/users/templates/fhd-staff-input.client.template.html',
    restrict: 'E',
    scope: {
      staff: '=?',
      staffs: '=?',
      labelColumn: '@',
      label: '@',
      noLabel: '=?',
      placeholder: '@',
      isBom: '@',
      includeDeleted: '@',
      onSelectStaff: '&',
      hasRemoveButton: '=?',
      loadDefaultUser: '=?',
      onChange: '=?'
    },
    controller: 'FhdStaffInputController',

    compile(tElm, tAttrs) {
      const fhdTypeaheadElm = tElm.find('fhd-typeahead');
      if (!tAttrs.staff) fhdTypeaheadElm.removeAttr('fhd-item');
      return {
        post(scope, element) {
          if (scope.labelColumn) {
            const labelElm = element.find('label');
            const inputElm = element.find('fhd-controls');
            labelElm.addClass(`col-sm-${scope.labelColumn}`);
            inputElm.addClass(`col-sm-${12 - scope.labelColumn}`);
          }
        }

      };
    },

    replace: true
  };
}]).controller('FhdStaffInputController', ['$scope', 'FhdMessenger', 'UserService', 'Authentication', function ($scope, FhdMessenger, UserService, Authentication) {
  $scope.data = {};
  let staffPromise;

  if ($scope.includeDeleted) {
    staffPromise = UserService.includeDeleted;
  } else {
    staffPromise = UserService.allStaffs;
  }

  staffPromise(function (err, staffs) {
    $scope.data.staffs = staffs;

    if ([true, 'true'].includes($scope.isBom)) {
      $scope.data.staffs = _.filter($scope.data.staffs, staff => {
        return ['F432', 'F688', 'F262', 'D327', 'D388'].includes(staff.code);
      });
    }

    if ($scope.loadDefaultUser) {
      const user = Authentication.user;

      const matchUser = _.find(staffs, {
        _id: _.get(user, '_id')
      });

      if (matchUser) $scope.staff = matchUser;
    }

    if (err) FhdMessenger.errorFromServer(err);
  });

  $scope.remove = function () {
    $scope.staff = null;
  };

  $scope.$watch('staff', (newValue, oldValue) => {
    if (newValue && newValue !== oldValue) {
      if ($scope.onChange) {
        $scope.onChange(newValue);
      }

      if ($scope.onSelectStaff) {
        $scope.onSelectStaff({
          $staff: newValue
        });
      }
    }
  });
}]);
/* eslint-disable angular/window-service */

/* eslint-disable angular/controller-as  */
'use strict';

angular.module('users').controller('AccountController', ['$scope', '$http', '$location', '$modal', '$state', '$window', '$localStorage', 'Users', 'Authentication', 'PopQuizzesService', 'UserAccounts', 'PlTaskService', 'toaster', 'FhdMessenger', 'NgTableParams', 'ConfirmModal', 'UserService', 'RankAPointService', 'ShiftPositions', 'ShiftReports', 'SaleReports', 'ThumbUpService', 'BusinessService', 'OutletService', 'ObjectId', '$q', 'EnvironmentService', 'Stories', 'UserNoteService', 'PortraitService', 'UpdateApplicationVersionService', '$document', function ($scope, $http, $location, $modal, $state, $window, $localStorage, Users, Authentication, PopQuizzesService, UserAccounts, PlTaskService, toaster, FhdMessenger, NgTableParams, ConfirmModal, UserService, RankAPointService, ShiftPositions, ShiftReports, SaleReports, ThumbUpService, BusinessService, OutletService, ObjectId, $q, EnvironmentService, Stories, UserNoteService, PortraitService, UpdateApplicationVersionService, $document) {
  const vm = this;
  vm.environment = EnvironmentService.getEnvironment();
  vm.user = Authentication.user;
  vm.theUser = Authentication.user;
  vm.authentication = Authentication;

  vm.getInformationStatus = () => [{
    id: 'unconfirmed',
    title: 'Chưa xác thực'
  }, {
    id: 'waiting',
    title: 'Chờ duyệt'
  }, {
    id: 'done',
    title: 'Đã xác thực'
  }];

  vm.todayIsBirthday = user => {
    const birthday = _.get(user, 'birthday');

    if (!birthday) {
      return false;
    }

    return moment().format('DD/MM/YYYY') === moment(birthday).year(moment().year()).format('DD/MM/YYYY');
  };

  vm.canShowButton = _.intersection(vm.theUser.roles, ['admin', 'tro-ly-ns', 'tro-ly-dt', 'accountant', 'tro-ly']).length;
  vm.selectedStatus = [{
    id: true,
    title: 'Có'
  }, {
    id: false,
    title: 'Không'
  }];
  vm.isAbbyFrontendStaff = vm.user.outlet.code.match(/[ME]\d+/);
  vm.isHuyER = vm.user.code === 'D6789';
  vm.canCreateStory = _.intersection(vm.user.roles, ['admin', 'story:add']).length;
  vm.waiting = false;
  vm.isManager = _.intersection(['admin', 'tro-ly-ns', 'accountant', 'tro-ly-dt', 'user:edit'], vm.user.roles).length;

  vm.canEdit = user => {
    if (vm.isManager) {
      return true;
    }

    if (!_.intersection(vm.user.roles, ['tro-ly', 'tro-ly-kho', 'tro-ly-sx']).length) {
      return false;
    }

    return _.intersection([ObjectId.getObjectId(user.outlet)], _.map(vm.user.managingOutlets, ObjectId.getObjectId)).length || ObjectId.equals(vm.user.outlet, user.outlet);
  }; // If user is not signed in then redirect back home


  if (!vm.user) $location.path('/'); // My Pl Tasks

  vm.endDate = moment().format('YYYY-MM-DD');
  vm.startDate = moment(vm.endDate).startOf('month').format('YYYY-MM-DD');
  vm.shiftReport = {};
  vm.data = {};
  vm.ranks = UserService.getAvailableRanks();
  vm.openModalAssessUser = UserService.openModalAssessUser;
  vm.myPlTasksTable = new NgTableParams({
    count: 1000
  });
  vm.prizeMoneyTable = new NgTableParams({
    count: 100
  });
  vm.fineMoneyTable = new NgTableParams({
    count: 100
  });
  vm.myUserNotesTable = new NgTableParams({});
  vm.myWorkResultEntriesTable = new NgTableParams({
    count: 10
  });
  vm.referApplicationFormsTable = new NgTableParams({});
  vm.userOutlet = _.get(vm.user.outlet, '_id', '5a40649459d16308d536a17d');
  vm.outlets = [vm.userOutlet];

  vm.findMyPlTasks = function (startDate, endDate) {
    PlTaskService.myPlTasks(startDate, endDate).then(data => {
      vm.myPlTasksTable.settings({
        dataset: data
      });
    });
  };

  vm.shiftReport.employeeNotes = [];

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.outlets = _.map(selectedOutlets, '_id');
  };

  $scope.$watch(() => {
    return {
      businessMap: vm.showBusinessMap
    };
  }, () => {
    _.forEach(_.values(vm.showBusinessMap), business => {
      const businessId = _.get(business, 'business._id');

      const outlets = _.filter(vm.showOutletMap, outlet => {
        return _.get(outlet, 'outlet.business._id') === businessId;
      });

      _.forEach(outlets, outlet => {
        outlet.enable = business.value;
      });
    });
  }, true);

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'outlet':
        {
          let changeValue = true;
          if (_.every(_.map(vm.showOutletMap, 'value'))) changeValue = false;

          _.forEach(vm.showOutletMap, (outlet, key) => {
            vm.showOutletMap[key].value = changeValue;
          });

          break;
        }

      default:
    }
  }; // if (_.includes(vm.user.roles, 'sx')) {
  //   UserService.getTotalProductionTime().then((data) => {
  //     vm.totalProductionTime = data.totalProductionTime
  //   })
  //   // vm.findMyPlTasks(vm.startDate, vm.endDate)
  // }


  UserService.getMyRetireRequests().then(retireRequests => {
    vm.retireRequests = retireRequests;
  }); // if (vm.user.roles.includes('kho')) {
  //   UserService.getLogisticsKPIsByUser({ user: vm.user }).then((data) => {
  //     vm.stats = data
  //   })
  // }

  $scope.$watch(() => vm.myPlTasksTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.allProductionTime = _.reduce(newValue, (result, plTask) => {
      result = result + (plTask.inputProductionTime || plTask.product.productionTime) * (plTask.confirmQuantity || 0) / plTask.assignedStaffs.length;
      return result;
    }, 0);
  });

  if (vm.user.roles.includes('sale') || vm.user.roles.includes('tro-ly')) {
    $http.get('/potraits/sale-report-with-portraits').then(res => {
      vm.listSaleReportWithPortraits = res.data;
    });
  } // Open modal create story


  vm.openCreateStoryModal = function () {
    UserService.openCreateStoryModal();
  }; // End for My Pl Tasks


  vm.myCalendar = function () {
    $http.get('/shift-entry/my-process').then(res => {
      vm.shiftEntries = res.data;
    });
  };

  vm.getStories = function () {
    vm.stories = Stories.query().$promise.then(stories => {
      vm.stories = stories;
    });
  };

  vm.myUserNotes = function () {
    UserNoteService.getMyUserNotesAsync().then(userNotes => {
      vm.myUserNotesTable.settings({
        dataset: userNotes
      });
    });
    vm.myUserNotesTable.reload();
  };

  vm.myEvaluationEntries = function () {
    $http.get('/evaluation-entries/my').then(({
      data
    }) => {
      vm.myWorkResultEntriesTable.settings({
        dataset: data
      });
    });
  };

  vm.processStatus = evaluationEntry => {
    if (evaluationEntry.assessed) {
      return {
        label: 'label-success',
        value: 'Đã đánh giá'
      };
    }

    if (!evaluationEntry.assessed && moment(evaluationEntry.date).date() > 3) {
      return {
        label: 'label-default',
        value: 'Hết hạn đánh giá'
      };
    }

    return {
      label: 'label-primary',
      value: 'Chưa đánh giá'
    };
  };

  vm.getSpinInfo = function () {
    $http.get('/spins').then(function (response) {
      vm.remainingSpins = _.filter(response.data, {
        status: 'active'
      });
      vm.usedSpins = _.reject(response.data, {
        status: 'active'
      });
    });
  };

  vm.getPopQuizInfo = function () {
    $http.get('/pop-quizzes/get-one').then(function (response) {
      if (_.get(response, 'data.status') === 'not-answer') {
        vm.canDoQuiz = true;
      } else {
        vm.canDoQuiz = false;
      }
    });
  };

  vm.openModalAnswerPopQuiz = () => {
    PopQuizzesService.openModalAnswerPopQuiz().then(() => {
      $state.reload();
    });
  };

  vm.myPoints = function () {
    $http.get('/users/summary-my-points').then(function (response) {
      var data = response.data;
      vm.points = data.user.points || 0;

      var currentRankIndex = _.findLastIndex(vm.ranks, function (rank) {
        return vm.points >= rank.point;
      });

      vm.currentRank = vm.ranks[currentRankIndex];
      if (currentRankIndex < vm.ranks.length - 1) vm.nextRank = vm.ranks[currentRankIndex + 1];
      var entries = data.entries;
      vm.addPointEntries = _.filter(entries, {
        isMinus: false
      });
      vm.minusPointEntries = _.filter(entries, {
        isMinus: true
      });
    }, function (response) {
      var data = response.data;
      FhdMessenger.errorFromServer(data);
    });
    $http.get('/users/my-tickets').then(function (response) {
      const tickets = response.data;
      vm.tickets = _.filter(tickets, ticket => {
        return _.includes(['done', 'complainted'], _.get(ticket, 'status'));
      });
      vm.deletedTickets = _.filter(tickets, 'isDeletedByThumbUp').length;

      _.forEach(tickets, function (ticket) {
        ticket.content = _.truncate(ticket.content, 80);
      });
    });
    $http.get('/users/my-support-salaries').then(function (response) {
      vm.supportSalaries = response.data;
    });
    $http.get('/users/my-thumb-ups').then(function (response) {
      vm.thumbUps = response.data;
    });
    $http.get('/papers/my').then(function (response) {
      vm.papers = _.filter(response.data, paper => {
        if (paper && paper.quiz) {
          if (angular.isUndefined(_.get(paper, 'isPass'))) return false;
          return true;
        }
      });
    });
    $http.get('/application-forms/my-refer', {
      params: {
        referStaff: vm.user._id
      }
    }).then(function (response) {
      vm.applicationForms = response.data;
    });
    $http.get(`/users/${vm.user._id}/over-time-shifts`).then(function (response) {
      vm.overShifts = response.data;
    });
  };

  vm.myVote = function () {
    $http.get('/votes/get-user-vote-staff-of-year').then(function (response) {
      vm.existVote = response.data;

      if (vm.existVote) {
        $modal.open({
          templateUrl: '/modules/votes/views/modal-view-user-vote.client.view.html',
          controller: 'ModalViewUserVoteController',
          controllerAs: 'vm',
          resolve: {
            vote: () => vm.existVote
          }
        });
      }
    });
  };

  vm.checkAndUpdateOverTimeShiftReport = function () {
    if (!vm.shiftReport.date) {
      return FhdMessenger.error('Chưa có ngày của ca trực');
    }

    const endOfToday = moment().endOf('day');

    if (moment(vm.shiftReport.date).isAfter(endOfToday)) {
      return FhdMessenger.error('Không được chọn ca trực trong tương lai');
    }

    if (!_.get(vm.shiftReport, 'shift.code')) {
      return FhdMessenger.error('Bạn chưa chọn ca trực');
    }

    if (!_.get(vm, 'shiftReport.outlet._id')) {
      return FhdMessenger.error('Chưa chọn cơ sở tăng ca');
    }

    if (!_.get(vm, 'shiftReport.overTime')) {
      return FhdMessenger.error('Chưa có thời gian tăng ca');
    }

    const shift = vm.shiftReport.shift.code;
    const outletShifts = vm.shiftReport.outlet.shifts;
    let date = moment(vm.shiftReport.date);

    let {
      endTime
    } = _.find(outletShifts, outletShift => outletShift.shift === shift);

    endTime = moment(endTime); // Giữ nguyên giờ, phút, giây. Thay ngày, tháng, năm bằng ngày mà user chọn

    endTime.year(date.year()).month(date.month()).date(date.date());

    if (moment().isAfter(endTime.add(1, 'day'))) {
      return FhdMessenger.error('Bạn chỉ được cập nhật giờ tăng ca trong vòng 24h kể từ khi kết thúc ca trực');
    }

    let notes = _.filter(vm.notes, note => _.get(vm, `shiftReport.noteMap.${note}`));

    if (_.get(vm, 'shiftReport.otherNote')) {
      notes.push(vm.shiftReport.otherNote);
    }

    if (!_.get(notes, 'length')) {
      return FhdMessenger.error('Chưa có lý do tăng ca');
    } // if (!vm.shiftReport.startOverTime || !vm.shiftReport.endOverTime) {
    //   return FhdMessenger.error('Chưa có thời gian bắt đầu hoặc kết thúc giờ tăng ca của ca trực')
    // }


    const positions = _.reduce(vm.shiftReport.positions, (result, position) => {
      if (vm.shiftReport[position.code]) {
        result.push(position.code);
      }

      return result;
    }, []); // if (!positions.length) {
    //   return FhdMessenger.error('Chưa có vị trí trong ca trực')
    // }


    vm.waiting = true;
    ShiftReports.checkAndUpdateOverTime({
      outlet: vm.shiftReport.outlet,
      shift: vm.shiftReport.shift,
      date: vm.shiftReport.date,
      startOverTime: vm.shiftReport.startOverTime,
      overTime: vm.shiftReport.overTime,
      endOverTime: vm.shiftReport.endOverTime,
      note: notes.join(', '),
      positions
    }).$promise.then(shiftReport => {
      FhdMessenger.success('Đã cập nhật giờ tăng ca');
      vm.waiting = false;
      vm.shiftReport = {};
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      vm.waiting = false;
    });
  };

  vm.usersTable = new NgTableParams({
    count: 100
  }, {});

  vm.allUsers = () => {
    vm.waiting = true;
    const promise = $q(resolve => {
      resolve(UserAccounts.list());
    }).then(users => {
      vm.usersTable.settings({
        dataset: users
      });
      vm.usersTable.sorting({
        points: 'desc'
      });
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải rank a point...', promise, () => {
      FhdMessenger.success('Tải xong!');
    });
  };

  vm.staffTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    vm.waiting = true;
    vm.users = UserAccounts.all.query({
      isShowOutletAccounts: false,
      outlets: vm.outlets
    }, function (users) {
      _.forEach(users, user => {
        user.noteContent = _.map(user.notes, 'content').join(', ');
        user.canEdit = vm.canEdit(user);
      });

      vm.staffTable.settings({
        dataset: users
      });
      vm.waiting = false;
    });
  };

  vm.disabledUsersTable = new NgTableParams({
    count: 20
  });

  vm.findDisabledUsers = function () {
    vm.waiting = true;
    const outlets = vm.outlets;
    vm.users = UserAccounts.listDisabledUsers(outlets).then(users => {
      vm.users = _.map(users, user => {
        user.isSalary = user.roles.includes('inactive');
        return user;
      });
      vm.disabledUsersTable.settings({
        dataset: vm.users
      });
      vm.waiting = false;
    });
  };

  vm.disable = UserService.openModalDisableUser;
  $scope.$watch(() => vm.shiftReport.outlet, function (newValue, oldValue) {
    if (newValue === oldValue || !newValue) {
      return;
    }

    vm.shiftReport.positions = ShiftPositions.getPostions(vm.shiftReport.outlet);

    const isPos = _.get(vm.shiftReport.outlet, 'isPos', false);

    vm.notes = ['Lấy hàng cho cơ sở', 'Nhận hàng về/ chuyển hàng đi cơ sở', 'Dán mã, kiểm hàng, sắp xếp hàng hóa về nhiều', 'Đóng gói, sản xuất chưa xong task được giao', 'Đóng gói, sản xuất task gấp được giao từ QL'];

    if (isPos) {
      vm.notes = ['Bán hàng giờ cao điểm ca sau', 'Kiểm hàng, confirm LE khi hàng về số lượng lớn', 'Đổi layout, trang trí, trưng bày hàng hóa'];
    }

    vm.shiftReport.employeeNotes = [];
  });
  vm.viewUser = UserService.openViewUserModal;
  vm.editUser = UserService.openEditUserModal;
  vm.addRankAPoint = RankAPointService.addRankAPointModal;
  vm.resetRankAPoint = RankAPointService.resetRankAPointModal;

  vm.addThumbUps = function (userId) {
    ThumbUpService.addThumbUpModal(userId).then(() => {
      $state.reload();
    });
  };

  vm.switch = user => {
    user.$switch().then(() => {
      $window.location.reload();
    });
  };

  vm.openModalCreatePortrait = saleReport => {
    PortraitService.openCreatePortraitModal(saleReport);
  };

  vm.showApplicationForm = applicationForm => {
    if (!applicationForm) {
      return false;
    }

    return ['created', 'confirmed', 'interviewed', 'probationary', 'training'].includes(applicationForm.status);
  };

  vm.salaryShiftTable = new NgTableParams({
    count: 500
  });

  vm.getSalaryShifts = () => {
    if (!vm.startDate || !vm.endDate) {
      return FhdMessenger.error('Bạn chưa chọn khoảng thời gian tìm ca đã trực');
    }

    vm.waiting = true;
    $http.get('/reports/salary-shifts', {
      params: {
        startDate: vm.startDate,
        endDate: vm.endDate
      }
    }).then(res => {
      const data = res.data;
      vm.totalHours = _.sumBy(data, shift => {
        return shift.hours * shift.salaryFactor;
      });
      vm.totalOverTime = _.sumBy(data, shift => {
        return shift.overTime * shift.salaryFactor;
      }) / 60;
      vm.salaryShiftTable.settings({
        dataset: data
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.checkServerVersion = function () {
    // if (!_.includes(_.get(vm.user, 'roles', []), 'admin')) {
    //   return
    // }
    $http.get('/settings/update-application-version').then(response => {
      if (!response.data) {
        return;
      }

      if (angular.isUndefined($localStorage.get('updatedAt'))) {
        return UpdateApplicationVersionService.toggleUpdateVersionModal();
      }

      const currentVersionUpdatedTime = $localStorage.get('updatedAt');
      const serverUpdatedAt = response.data;

      if (currentVersionUpdatedTime < serverUpdatedAt) {
        return UpdateApplicationVersionService.toggleUpdateVersionModal();
      }
    }).catch(FhdMessenger.errorFromServer);
  };
}]);
'use strict';

angular.module('users').controller('AngelController', ['$scope', 'Authentication', '$http', 'FhdMessenger', '$timeout', function ($scope, Authentication, $http, FhdMessenger, $timeout) {
  const vm = this;
  vm.user = Authentication.user;

  vm.init = () => {
    if (!vm.user.angelOf) {
      FhdMessenger.notifySticky('Bạn hãy CTRL + R để tải lại trang web nhé.');
      vm.disableView = true;
    }
  };

  vm.markViewedAngel = () => {
    if (vm.user.viewedAngel) return;
    vm.waiting = true;
    $timeout(() => {
      $http.get('/users/angel').then(() => {
        vm.user.viewedAngel = true;
        vm.showAngel = true;
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    }, 3000);
  };

  vm.sendEmail = () => {
    vm.waiting = true;
    return $http.get('/users/angel/remind').then(() => {
      vm.emailSent = true;
      FhdMessenger.success('Đã gửi email');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
