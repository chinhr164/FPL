angular.module('users').controller('ModalUniformReceivedController', ['userId', '$location', 'Authentication', 'FhdMessenger', 'Users', 'UserService', '$modalInstance', 'UserNotes', 'NgTableParams', function (userId, $location, Authentication, FhdMessenger, Users, UserService, $modalInstance, UserNotes, NgTableParams) {
  const vm = this;
