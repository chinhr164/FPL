      vm.waitingB1Product = false;
    });
  };

  $scope.$watch(() => vm.customerRequest.outlet, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    vm.filterToolProducts(newValue);
  });

  vm.checkQuantity = item => {
    const warehouseStock = _.get(vm.warehouseStockMap, `${item._id}.warehouseStock`, 0);

    if (item.quantity > warehouseStock) {
      item.showExpectedArrivalDate = true;
    } else {
      item.showExpectedArrivalDate = false;
    }
  };

  vm.changeOrderToolProducts = () => {
    if ((vm.orderToolProducts || vm.orderB1Products) && _.get(vm, 'customerRequest.outlet._id')) {
      vm.customerRequest.fullName = vm.customerRequest.outlet.name;
      vm.customerRequest.cellphone = vm.customerRequest.outlet.phone;
      vm.showRecentCustomerRequest();
    }
  };

  vm.init = function () {
    vm.customerProduct = false;
    vm.customerOther = false;
    const currentShift = CurrentShift.getCurrentShift();
    vm.customerRequest.outlet = currentShift.outlet;
    vm.customerRequest.deposit = {
      amount: 0,
      depositType: 'cash'
    };
    vm.loadToolProducts();
    StockMap.getWarehouseTotalStockMap().then(stockMap => {
      vm.warehouseStockMap = stockMap;
    });
    CustomerRequestService.loadArrivingItems().then(arrivingItems => {
      vm.expectedArrivalDatesMap = arrivingItems;
    });
  };

  vm.selectSaleEntry = saleEntry => {
    vm.customerRequest.saleEntries = vm.customerRequest.saleEntries || [];

    const matchSaleEntry = _.find(vm.customerRequest.saleEntries, {
      saleEntryId: saleEntry.saleEntryId
    });

    if (!matchSaleEntry) {
      vm.customerRequest.saleEntries.push({
        saleEntry: saleEntry._id,
        saleEntryId: saleEntry.saleEntryId
      });
    }
  };

  if (saleEntry) {
    vm.selectSaleEntry(saleEntry);
    vm.exportVATBill = true;
  }

  vm.customerSearchSelected = function (customer) {
    if (customer) {
      vm.fullName = customer.fullName;
      vm.cellphone = customer.cellphone;
      vm.email = customer.email;
      vm.customer = customer;
      vm.showRecentCustomerRequest();
    }
  };

  vm.showRecentCustomerRequest = () => {
    if (!_.get(vm, 'customerRequest.cellphone')) {
      return;
    }

    vm.recentCustomerRequests = [];
    CustomerRequests.findByCellphone({
      cellphone: vm.customerRequest.cellphone
    }).$promise.then(recentCustomerRequests => {
      vm.recentCustomerRequests = recentCustomerRequests;
    }).catch(err => {
      FhdMessenger.error(err);
    });
  };

  vm.openModalAddPayment = CustomerRequestService.openModalAddPayment;

  vm.create = function () {
    // Create new Customer request object
    const currentShift = CurrentShift.getCurrentShift();
    const error = CustomerRequestService.validateCreateCustomerRequest({
      vm,
      currentShift
    });

    if (error) {
      return FhdMessenger.error(error);
    }

    $q((resolve, reject) => {
      if (vm.customerRequest.deposit.amount > 0) {
        const now = moment();
        vm.deposit = _objectSpread({}, vm.customerRequest.deposit, {
          date: _.get(currentShift, 'date', now),
          shift: _.get(currentShift, 'shift', null),
          staff: Authentication.user
        });
        resolve(CustomerRequestService.openModalAddPayment(vm.deposit));
      } else {
        resolve(vm.deposit);
      }
    }).then(deposit => {
      const customerRequest = new CustomerRequests(vm.customerRequest);

      if (_.get(deposit, 'amount', 0) > 0) {
        customerRequest.deposits = [deposit];
      }

      vm.waiting = true; // Redirect after save

      customerRequest.$save().then(function (response) {
        FhdMessenger.success('Đã tạo Customer Request');
        $modalInstance.close(response);
        vm.customer = '';
        vm.cellphone = '';
        vm.fullName = '';
        vm.email = '';
      }).catch(function (errorResponse) {
        FhdMessenger.errorFromServer(errorResponse);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.productSearchSelected = function (item) {
    vm.customerRequest.requestItems = vm.customerRequest.requestItems || [];

    const warehouseStock = _.get(vm.warehouseStockMap, `${item._id}.warehouseStock`, 0);

    vm.customerRequest.requestItems = CustomerRequestService.productSearchSelected(item, vm.customerRequest.requestItems, warehouseStock);

    _.forEach(vm.customerRequest.requestItems, requestItem => {
      requestItem.expectedArrivalDate = _.get(vm.expectedArrivalDatesMap, requestItem.sku, null);
    });
  };

  vm.removeItem = function (index) {
    vm.customerRequest.requestItems.splice(index, 1);
  };
}]);
'use strict';

angular.module('customer-requests').controller('ModalCustomerRequestHistoryController', ['CustomerRequests', 'customerRequestId', 'CustomerRequestService', 'Authentication', 'FhdMessenger', 'JsPrintService', '$modalInstance', 'SaleEntryService', 'NgTableParams', '$window', '$location', function (CustomerRequests, customerRequestId, CustomerRequestService, Authentication, FhdMessenger, JsPrintService, $modalInstance, SaleEntryService, NgTableParams, $window, $location) {
  const vm = this;
  vm.now = moment().format('LTS');
  vm.user = Authentication.user;
  vm.actionsTable = new NgTableParams({});
  vm.openSaleEntry = SaleEntryService.viewSaleEntry;

  vm.findOne = function () {
    vm.customerRequest = CustomerRequests.get({
      customerRequestId
    });
    vm.customerRequest.$promise.then(() => {
      vm.customerRequest.totalDeposit = _.reduce(vm.customerRequest.deposits, (result, deposit) => {
        result += deposit.amount;
        return result;
      }, 0);
      vm.actions = vm.customerRequest.actions;
      vm.actionsTable.settings({
        dataset: vm.actions
      });

      _.forEach(vm.customerRequest.requestItems, item => {
        item.unsentQuantity = item.quantity - (item.sentQuantity || 0);
      });
    });
  };

  vm.printCR = function () {
    if ($window.Cypress) return;
    const printer = JsPrintService.getActivePrinter();
    const printContents = $window.document.getElementById('receipt-table').innerHTML;
    const popupWin = $window.open('');
    const origin = `${$location.protocol()}://${$window.location.host}`;

    if (!popupWin) {
      // eslint-disable-next-line
      console.log('Hãy cho phép mở popup để có thể in CR');
      return;
    } // console.log(vm.saleEntry)


    popupWin.document.open();
    popupWin.document.write(`<!DOCTYPE html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-type" content="text/html;charset=UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <link rel="stylesheet" type="text/css" href="${origin}/lib/bootstrap/dist/css/bootstrap.css"/>
  <link rel="stylesheet" type="text/css" href="${origin}/css/jsprint.css"/>
  <link rel="stylesheet" type="text/css" href="${origin}/modules/sale-entries/css/sale-entries.css"/>
  <link rel="stylesheet" type="text/css" href="${origin}/css/custom/custom-jsprint.css"/>
</head>
<body>
<script type="text/javascript" src="${origin}/lib/jquery/dist/jquery.min.js"></script>
${printContents}
<script>
$(function(){
  if (window.jsPrintSetup)  {
    jsPrintSetup.setPrinter('${printer}')
    jsPrintSetup.definePaperSize(45, 45, 'vnm_receipt2', 'vnm_receipt_80mm', 'Receipt layout2', 80, 297, jsPrintSetup.kPaperSizeMillimeters)
    jsPrintSetup.setOption('orientation', jsPrintSetup.kPortraitOrientation);
    jsPrintSetup.setOption('paperData', 45);
    jsPrintSetup.setPaperSizeData(45)

    // set top margins in millimeters
    jsPrintSetup.setOption('marginTop', 0);
    jsPrintSetup.setOption('marginRight', 0);
    jsPrintSetup.setOption('marginLeft', 0);
    // jsPrintSetup.setOption('headerStrRight', '&PT');
    // set empty page footer
    jsPrintSetup.setOption('footerStrLeft', '');
    jsPrintSetup.setOption('footerStrRight', '');
    jsPrintSetup.setOption('footerStrCenter', '');

    jsPrintSetup.clearSilentPrint();

    // Suppress print dialog
    jsPrintSetup.setSilentPrint(true);/** Set silent printing */
    // Do Print

    // Restore print dialog
    jsPrintSetup.print();
  } else {
    console.log('print')
    window.print()
  }
})
</script>
</body>
</html>`);
    popupWin.document.close();
  };

  vm.addNote = function () {
    if (!vm.newNote) {
      return FhdMessenger.error('Chưa có ghi chú');
    }

    vm.customerRequest.actions = vm.customerRequest.actions || [];
    vm.customerRequest.actions.push({
      content: vm.newNote,
      staff: vm.user,
      status: 'created',
      time: new Date()
    });
    vm.customerRequest.isAddNote = true;
    const customerRequest = vm.customerRequest;
    customerRequest.$update();
    vm.newNote = '';
  };

  vm.done = function () {
    vm.customerRequest.currentStatus = 'done';
    vm.customerRequest.actions = vm.customerRequest.actions || [];
    vm.customerRequest.actions.push({
      content: 'Hoàn thành',
      staff: Authentication.user,
      status: 'done',
      time: new Date()
    });
    vm.customerRequest.isAddNote = false;
    const customerRequest = vm.customerRequest;
    customerRequest.$update().then(response => {
      $modalInstance.close(response.data);
    }, response => FhdMessenger.errorFromServer(response));
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.addDeposit = customerRequest => CustomerRequestService.addDeposit(customerRequest).then(response => {
    vm.cancel();
  });

  vm.markSentItem = function () {
    if (vm.customerRequest.requestItems.length > 0) {
      vm.customerRequest.sentItems = vm.customerRequest.sentItems || [];
      vm.sentItems = _.forEach(vm.customerRequest.requestItems, item => {
        if (item.unsentQuantity > 0) {
          vm.customerRequest.sentItems.push({
            product: item.product,
            sku: item.sku,
            description: item.description,
            quantity: item.unsentQuantity
          });
        }
      });
    }

    const customerRequest = vm.customerRequest;
    customerRequest.$markSentItem().then(response => {
      $modalInstance.close(response);
    }, response => FhdMessenger.errorFromServer(response));
  };

  vm.approveItem = function (item) {
    const customerRequest = vm.customerRequest;
    customerRequest.sku = item.sku;
    customerRequest.$approveItem().then(response => {
      FhdMessenger.success('Đã chuyển trạng thái duyệt');
    }, response => FhdMessenger.errorFromServer(response));
  };

  vm.disapproveItem = function (item) {
    const customerRequest = vm.customerRequest;
    customerRequest.sku = item.sku;
    customerRequest.$disapproveItem().then(response => {
      FhdMessenger.success('Đã chuyển trạng thái không duyệt');
    }, response => FhdMessenger.errorFromServer(response));
  };
}]);
'use strict';

angular.module('customer-requests').factory('CustomerRequestService', ['$http', '$modal', 'FhdMessenger', 'ReportStats', function ($http, $modal, FhdMessenger, ReportStats) {
  function showRequestHistory(customerRequestId) {
    return $modal.open({
      animation: true,
      controller: 'ModalCustomerRequestHistoryController',
      controllerAs: 'vm',
      size: 'lg',
      templateUrl: '/modules/customer-requests/views/modal-customer-request-history.client.view.html',
      resolve: {
        customerRequestId: () => customerRequestId
      }
    }).result;
  }

  function createCustomerRequest(customer, saleEntry) {
    return $modal.open({
      animation: true,
      controller: 'ModalCreateCustomerRequestController',
      controllerAs: 'vm',
      size: 'lg',
      templateUrl: '/modules/customer-requests/views/modal-create-customer-request.client.view.html',
      resolve: {
        customer: () => customer,
        saleEntry: () => saleEntry
      }
    });
  }

  function addDeposit(customerRequest) {
    return $modal.open({
      animation: true,
      controller: 'ModalAddDepositController',
      controllerAs: 'vm',
      size: 'md',
      templateUrl: '/modules/customer-requests/views/modal-add-deposit.client.view.html',
      resolve: {
        customerRequest: () => customerRequest
      }
    }).result;
  }

  function openModalAddPayment(deposit) {
    return $modal.open({
      animation: true,
      controller: 'ModalAddPaymentCustomerRequestController',
      controllerAs: 'vm',
      size: 'lg',
      templateUrl: '/modules/customer-requests/views/modal-add-payment-customer-request.client.view.html',
      resolve: {
        deposit: () => deposit
      }
    }).result;
  }

  return {
    showRequestHistory,
    createCustomerRequest,
    addDeposit,
    openModalAddPayment,

    validateCreateCustomerRequest({
      vm,
      currentShift
    }) {
      if (vm.customerRequest.deposit.amount > 0 && !currentShift._id) {
        return 'Đăng nhập ca trực để thêm tiền đặt cọc';
      }

      if (!vm.customerRequest.fullName) {
        return 'Không có tên khách hàng';
      }

      if (!vm.customerRequest.cellphone) {
        return 'Không có SĐT khách hàng';
      }

      if (_.get(vm.customerRequest, 'requestItems.length') && vm.customerRequest.deposit.amount && !vm.customerRequest.totalPrice) {
        return 'Chưa có tổng tiền hàng';
      }

      if (!_.get(vm.customerRequest.outlet, '_id')) {
        return 'Chưa có có sở của customer request';
      }

      if (vm.customerRequest.deadline && moment(vm.customerRequest.deadline).isBefore(moment().add(2, 'day').startOf('day'))) {
        return 'Deadline phải là sau 2 ngày từ ngày tạo CR';
      }

      const toolItems = vm.toolProductsTable.data;

      if (_.get(vm.customerRequest.outlet, 'code', '').match(/[SKME]\d+/) && vm.orderToolProducts) {
        const outletCode = _.get(vm.customerRequest.outlet, 'code');

        const wrongQuantityItems = _.filter(toolItems, item => {
          if (item.restockQuantity > 0 && item.packageQuantity && item.packageQuantity > 1) {
            return item.restockQuantity % item.packageQuantity !== 0;
          }

          return false;
        });

        if (wrongQuantityItems.length) {
          return 'Số lượng hàng vận hành đặt phải là bội số của đơn vị Restock ' + _.map(wrongQuantityItems, item => {
            return `${item.sku} - ${item.description}`;
          }).join(' ,');
        }

        const overMaxDisplayStockItems = _.filter(toolItems, item => {
          if (!item.restockQuantity) {
            return false;
          }

          const maxDisplayStock = _.get(item.maxDisplayStockOutlets, outletCode);

          const stock = _.get(item.stockMap, outletCode, 0);

          return maxDisplayStock > 0 && stock > maxDisplayStock;
        });

        if (overMaxDisplayStockItems.length) {
          return 'Có sản phẩm số tồn hiện tại số tồn tối đa: ' + _.map(overMaxDisplayStockItems, item => {
            return `${item.sku} - ${item.description}`;
          }).join(' ,') + '. Vui lòng update lại số tồn thực tại cơ sở nhé';
        }

        const overQuantityItems = _.filter(toolItems, item => {
          return item.restockQuantity > 0 && item.maxRestockQuantity > 0 && item.restockQuantity > item.maxRestockQuantity;
        });

        if (overQuantityItems.length) {
          return 'Có sản phẩm đặt quá số lượng được phép đặt. Vui lòng sửa lại số restock ' + _.map(overQuantityItems, item => {
            return `${item.sku} - ${item.description}`;
          }).join(' ,');
        }
      }

      if (vm.orderToolProducts) {
        vm.customerRequest.requestItems = vm.customerRequest.requestItems.concat(_.map(_.filter(vm.toolProductsTable.data, product => {
          const matchRequestItem = _.find(vm.customerRequest.requestItems, {
            sku: product.sku
          });

          if (matchRequestItem) {
            return false;
          }

          return product.restockQuantity > 0;
        }), product => {
          return {
            product: product._id,
            sku: product.sku,
            description: product.description,
            quantity: product.restockQuantity,
            urgent: product.urgent,
            needImageInCustomerRequest: product.needImageInCustomerRequest
          };
        }));
      }

      if (vm.orderB1Products) {
        const kitchenItems = vm.kitchenProductsTable.data;

        if (_.some(kitchenItems, product => {
          if (product.restockQuantity > 0 && product.maxRestockQuantity > 0 && product.restockQuantity > product.maxRestockQuantity) {
            return true;
          }

          return false;
        })) {
          return 'Có sản phẩm đặt quá số lượng được phép đặt. Vui lòng sửa lại số restock';
        }

        if (moment().hour() > 16 && _.some(kitchenItems, {
          urgent: true
        })) {
          return 'Đã quá giờ báo hàng cần gấp của B1 và B2.';
        }

        vm.customerRequest.requestItems = vm.customerRequest.requestItems.concat(_.map(_.filter(kitchenItems, product => {
          const matchRequestItem = _.find(vm.customerRequest.requestItems, {
            sku: product.sku
          });

          if (matchRequestItem) {
            return false;
          }

          return product.restockQuantity > 0;
        }), product => {
          return {
            product: product._id,
            sku: product.sku,
            description: product.description,
            quantity: product.restockQuantity,
            urgent: product.urgent,
            tags: product.tags
          };
        }));
      }

      if (!_.get(vm.customerRequest, 'requestItems.length') && !vm.customerRequest.notSellingItems && !vm.exportVATBill) {
        return 'Không có ghi chú hoặc sản phẩm cho Customer Request';
      }

      const needImageSkus = _.map(_.filter(vm.customerRequest.requestItems, {
        needImageInCustomerRequest: true
      }), 'sku');

      if (_.get(vm.customerRequest, 'images.length') < needImageSkus.length) {
        return `Có ${needImageSkus.length} sản phẩm cần ảnh trong khi bạn mới chỉ thêm ${_.get(vm.customerRequest, 'images.length')} ảnh. Vui lòng bổ sung thêm ảnh`;
      }

      if (vm.exportVATBill) {
        if (!_.get(vm.customerRequest, 'companyName')) {
          return 'Chưa điền tên công ty cần xuất VAT';
        }

        if (!_.get(vm.customerRequest, 'taxNumber')) {
          return 'Chưa điền mã số thuế công ty cần xuất VAT';
        }

        if (!_.get(vm.customerRequest, 'address')) {
          return 'Chưa điền địa chỉ công ty cần xuất VAT';
        }

        if (!_.get(vm.customerRequest, 'saleEntries.length')) {
          return 'Chưa điền mã hóa đơn cần xuất VAT';
        }
      }
    },

    productSearchSelected(item, requestItems, warehouseStock) {
      if (item.notBuying === true && warehouseStock < 1) {
        FhdMessenger.error('Không thể thêm mặt hàng không nhập nữa!');
        return requestItems;
      }

      const matchItemIndex = _.findIndex(requestItems, {
        sku: item.sku
      });

      if (matchItemIndex > -1) {
        requestItems[matchItemIndex].quantity += 1;
      } else {
        requestItems.push(item);
      }

      return requestItems;
    },

    loadArrivingItems() {
      return ReportStats.getArrivingItems().then(arrivingItems => {
        if (!arrivingItems.length) {
          return;
        }

        return _.reduce(arrivingItems, (result, arrivingItem) => {
          if (moment().isBefore(arrivingItem.expectedArrivalDate)) {
            result[arrivingItem.sku] = arrivingItem.expectedArrivalDate;
          }

          return result;
        }, {});
      }).catch(FhdMessenger.errorFromServer);
    }

  };
}]);
'use strict'; // Customer requests service used to communicate Customer requests REST endpoints

angular.module('customer-requests').factory('CustomerRequests', ['$resource', function ($resource) {
  return $resource('customer-requests/:customerRequestId', {
    customerRequestId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    markSentItem: {
      method: 'PUT',
      url: 'customer-requests/:customerRequestId/mark-sent-item'
    },
    approveItem: {
      method: 'PUT',
      url: 'customer-requests/:customerRequestId/approve-item'
    },
    disapproveItem: {
      method: 'PUT',
      url: 'customer-requests/:customerRequestId/disapprove-item'
    },
    disable: {
      method: 'PUT',
      url: 'customer-requests/:customerRequestId/disable'
    },
    findByCode: {
      method: 'GET',
      url: 'customer-requests/findByCode'
    },
    findByCellphone: {
      method: 'GET',
      url: 'customer-requests/findByCellphone',
      isArray: true
    }
  });
}]);
'use strict';

