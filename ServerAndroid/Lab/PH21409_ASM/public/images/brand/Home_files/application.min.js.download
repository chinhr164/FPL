angular.module('outlets').directive('fhdOutletCheckboxes', [function () {
  return {
    template: `
      <label class="checkbox-inline" ng-repeat="outlet in vm.data.outlets">
        <input type="checkbox" ng-model="outlet.value"> {{outlet.code}}
      </label>
      `,
    restrict: 'E',
    scope: {
      hasStaff: '=?',
      isStorage: '=?',
      isPos: '=?',
      outlets: '='
    },
    controller: 'FhdOutletCheckboxesController',
    controllerAs: 'vm'
  };
}]).controller('FhdOutletCheckboxesController', ['$scope', 'Outlets', 'FhdMessenger', 'ObjectId', function ($scope, Outlets, FhdMessenger, ObjectId) {
  const vm = this;
  vm.data = {
    outlets: null
  };
  vm.getOutlets = Outlets.query({
    hasStaff: $scope.hasStaff,
    isPos: $scope.isPos,
    isStorage: $scope.isStorage
  }).$promise.then(outlets => {
    vm.data.outlets = outlets;
    return outlets;
  }).catch(FhdMessenger.errorFromServer);
  $scope.$watch(() => {
    return _.reduce(vm.data.outlets, (result, outlet) => {
      result[outlet.code] = outlet.value;
      return result;
    }, {});
  }, (newValue, oldValue) => {
    if (newValue !== oldValue) {
      $scope.outlets = _.filter(vm.data.outlets, {
        value: true
      });
    }
  }, true);
  $scope.$watch('outlets', (newValue, oldValue) => {
    if (newValue === oldValue || angular.isUndefined(newValue)) return;

    if (_.get($scope.outlets, 'length')) {
      vm.getOutlets.then(vmOutlets => {
        _.forEach(vmOutlets, vmOutlet => {
          if (_.some($scope.outlets, outlet => ObjectId.getObjectId(outlet) === ObjectId.getObjectId(vmOutlet))) {
            vmOutlet.value = true;
          }
        });
      });
    }
  });
}]);
