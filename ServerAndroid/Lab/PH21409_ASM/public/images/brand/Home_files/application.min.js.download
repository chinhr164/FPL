    }

    const expectedArrivalDatesMap = _.get(vm.expectedArrivalDatesMap, product.sku);

    if (expectedArrivalDatesMap) {
      return `(Dự kiến: ${moment(expectedArrivalDatesMap).format('YYYY-MM-DD')})`;
    }

    return '';
  };

  vm.checkQuantity = item => {
    const warehouseStock = _.get(vm.warehouseStockMap, `${item._id}.warehouseStock`, 0);

