angular.module('products').factory('BuyingProfiles', ['$q', function ($q) {
  const buyingProfiles = [{
    id: 'all',
    label: 'all'
  }, {
    id: 'top-outlets',
    label: 'Chỉ bán ở M1 M2 E5'
  }, {
    id: 'north',
    label: 'Chỉ bán Hà Nội'
  }, {
    id: 'south',
    label: 'Chỉ bán HCM'
  }, {
    id: 'central',
    label: 'Chỉ bán ĐN'
  }];
  return {
    query() {
      return $q.when(buyingProfiles);
    },

    getIsDirect(buyingProfileId, outletCode, region) {
      if (buyingProfileId === 'top-outlets') {
        return outletCode === 'M1' || outletCode === 'M2' || outletCode === 'E5';
      }

      if (buyingProfileId === 'south') {
        return region === 'SOUTH';
      }

      if (buyingProfileId === 'central') {
        return region === 'CENTRAL';
      }

      if (buyingProfileId === 'north') {
        return region === 'NORTH';
      }

      if (buyingProfileId === 'all') {
        return true;
      }

      return false;
    }

  };
}]);
