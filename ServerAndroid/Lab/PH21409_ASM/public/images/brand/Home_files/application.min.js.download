angular.module('online-orders').controller('CakeItemsController', ['$stateParams', '$state', 'CurrentShift', 'ConfirmModal', 'NgTableParams', 'FhdMessenger', 'PlTasks', '$scope', 'OutletService', 'OnlineOrderService', 'Authentication', 'ObjectId', function ($stateParams, $state, CurrentShift, ConfirmModal, NgTableParams, FhdMessenger, PlTasks, $scope, OutletService, OnlineOrderService, Authentication, ObjectId) {
  const vm = this;
  let outletCode = $stateParams.outletCode;
  vm.cakeItemsTable = new NgTableParams({
    count: 500
  });
  vm.summaryCakeItems = new NgTableParams({
    count: 100
  });
  vm.cakeItemsTable.sorting({
    'onlineOrder.deliverStartTime': 'asc',
    created: 'asc',
    deadline: 'asc'
  });
  vm.cakeItemsTable.filter().status = 'pending';
  vm.summaryCakeItems.sorting({
    description: 'asc'
  });

  const fetchCakeItemsToTable = cakeItems => {
    vm.cakeItems = cakeItems;
    vm.cakeItemsTable.settings({
      dataset: vm.cakeItems
    });
    vm.summary(cakeItems);
  };

  vm.summary = cakeItems => {
    const items = _.reject(cakeItems, {
      status: 'skipped'
    });

    const summary = _.reduce(items, (result, item) => {
      result[item.sku] = result[item.sku] || {
        sku: item.sku,
        description: item.description,
        quantity: 0,
        doneQuantity: 0
      };
      result[item.sku].quantity += item.orderQuantity;

      if (item.status === 'done') {
        result[item.sku].doneQuantity += item.orderQuantity;
      }

      return result;
    }, {});

    const values = _.values(summary);

    vm.summaryCakeItems.settings({
      dataset: values
    });
    vm.totalQuantity = _.sumBy(values, 'quantity');
    vm.totalDoneQuantity = _.sumBy(values, 'doneQuantity');
  };

  vm.resetTable = () => {
    vm.cakeItemsTable.settings({
      dataset: []
    });
    vm.summaryCakeItems.settings({
      dataset: []
    });
  };

  vm.find = function () {
    vm.waiting = true;
    vm.resetTable();
    vm.cakeItems = PlTasks.cakeItemsQuery({
      startDate: moment(vm.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.endDate).format('YYYY-MM-DD'),
      outletCode
    });
    let promise = vm.cakeItems.$promise.then(cakeItems => {
      _.forEach(cakeItems, cakeItem => {
        if (!cakeItem.onlineOrder) {
          return;
        }

        const baseItem = _.find(cakeItem.onlineOrder.items, item => {
          return ['V1953', 'V1954', 'V1955'].includes(item.sku);
        });

        if (baseItem) {
          cakeItem.baseDescription = baseItem.description;
        }
      });

      return cakeItems;
    }).then(fetchCakeItemsToTable).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
    return promise;
  };

  vm.goToState = () => {
    return $state.go('cakeItems', {
      outletCode
    }, {
      notify: false,
      reload: false
    });
  };

  if (outletCode) {
    OutletService.findOutletFromCode($stateParams.outletCode).then(outlet => {
      vm.outlet = outlet;
      vm.find();
    });
  } else {
    const currentShift = CurrentShift.getCurrentShift();

    if (_.get(currentShift.outlet, 'code')) {
      if (currentShift.outlet.code === 'B5') {
        OutletService.findOutletFromCode('B1').then(outlet => {
          vm.outlet = outlet;
          outletCode = currentShift.outlet.code;
          vm.goToState();
          vm.find();
        });
      } else {
        vm.outlet = currentShift.outlet;
        outletCode = vm.outlet.code;
        vm.goToState();
        vm.find();
      }
    } else {
      vm.find();
    }
  }

  vm.updateOutlet = outlet => {
    outletCode = outlet.code;
    vm.resetTable();
    vm.goToState();
  };

  $scope.$watch(() => vm.cakeItemsTable.data, (newValue, oldValue) => {
    if (oldValue === newValue) {
      return;
    }

    vm.totalItemQuantity = _.sumBy(newValue, item => {
      return item.orderQuantity || 0;
    });
  });
  $scope.$watch(() => vm.startDate, (newValue, oldValue) => {
    if (oldValue && newValue && !ObjectId.equals(oldValue, newValue)) {
      vm.resetTable();
    }
  });
  $scope.$watch(() => vm.endDate, (newValue, oldValue) => {
    if (oldValue && newValue && !ObjectId.equals(oldValue, newValue)) {
      vm.resetTable();
    }
  });

  vm.now = function () {
    return moment().format('MM-DD HH:mm');
  };

  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus;
  vm.user = Authentication.user;
  vm.cakeStatuses = ['pending', 'done', 'skipped'].map(it => {
    return {
      id: it,
      title: it
    };
  });
  vm.onlineOrderStatuses = ['confirm', 'ready', 'done'].map(it => {
    return {
      id: it,
      title: it
    };
  });

  vm.doneCakeItem = plTask => {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Hoàn thành bánh ${plTask.description}}`,
      bodyText: `Bạn chắc chắn muốn hoàn thành bánh ${plTask.description} chứ?}`
    }).then(() => {
      vm.waiting = true;
      plTask.$savorDone().then(newPlTask => {
        plTask = newPlTask;
        vm.summary(vm.cakeItems);
      }).then(() => {
        FhdMessenger.success('Đã hoàn thành');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.skipCakeItem = plTask => {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Skip bánh ${plTask.description}}`,
      bodyText: `Bạn chắc chắn muốn skip bánh ${plTask.description} chứ?}`
    }).then(() => {
      vm.waiting = true;
      plTask.$savorSkip().then(newPlTask => {
        plTask = newPlTask;
        vm.summary(vm.cakeItems);
      }).then(() => {
        FhdMessenger.success('Đã hoàn thành');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
'use strict';

angular.module('online-orders').controller('CakeOnlineOrdersController', ['$document', '$timeout', '$window', '$state', '$location', 'helper', 'CurrentShift', 'JsPrintService', 'NgTableParams', '$http', 'FhdMessenger', 'OnlineOrderModal', 'OnlineOrders', '$scope', 'Sockets', 'OutletService', 'OnlineOrderService', 'CustomerService', 'Authentication', 'ObjectId', 'SaleEntryService', function ($document, $timeout, $window, $state, $location, helper, CurrentShift, JsPrintService, NgTableParams, $http, FhdMessenger, OnlineOrderModal, OnlineOrders, $scope, Sockets, OutletService, OnlineOrderService, CustomerService, Authentication, ObjectId, SaleEntryService) {
  const vm = this;
  vm.tabMap = {
    table: {
      active: $state.params.tab === 'table',
      loaded: $state.params.tab === 'table'
    },
    summary: {
      active: $state.params.tab === 'summary',
      loaded: $state.params.tab === 'summary'
    }
  };
  const seeAllRoles = ['admin', 'tro-ly', 'accountant', 'ship', 'marketing', 'purchaser', 'probation-purchaser'];
  vm.booleanFilter = [{
    id: true,
    title: 'Có'
  }, {
    id: false,
    title: 'Không'
  }];
  vm.paymentMethods = [{
    id: 'cod',
    title: 'COD'
  }, {
    id: 'transfer',
    title: 'Chuyển khoản'
  }];

  vm.now = function () {
    return moment().format('MM-DD HH:mm');
  };

  vm.copyToClipboard = helper.copyToClipboard;
  vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().endOf('day').format('YYYY-MM-DD');
  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus;
  vm.isNumber = _.isNumber;
  const currentShift = CurrentShift.getCurrentShift();
  vm.user = Authentication.user;
  vm.data = {
    statuses: OnlineOrderService.getStatuses()
  };
  vm.data.mooncakes = [];
  vm.stockMap = [];

  vm.init = () => {
    vm.statusMap = {
      created: true,
      processing: true,
      confirm: true,
      ready: true,
      done: false,
      cancel: false,
      return: false
    };

    if (vm.user.roles.includes('marketing')) {
      vm.statusMap.confirm = false;
      vm.statusMap.ready = false;
    }

    if (_.intersection(vm.user.roles, ['kitchen', 'baker-fulltime', 'baker-parttime']).length) {
      vm.statusMap.created = false;
      vm.statusMap.processing = false;
    }

    vm.getShippingOutlets = OutletService.allAsync().then(outlets => {
      vm.data.outlets = _.filter(outlets, outlet => {
        return outlet.sellBirthdayCake || outlet.code === 'B4';
      });
      vm.showOutletMap = _.reduce(vm.data.outlets, (result, outlet) => {
        if (_.intersection(vm.user.roles, seeAllRoles).length > 0 || ObjectId.equals(outlet, vm.user.outlet) || ObjectId.equals(outlet, currentShift.outlet)) {
          result[outlet._id] = true;
        }

        return result;
      }, {});
      vm.enableOutletMap = _.clone(vm.showOutletMap);
      vm.find();
    });
  };

  vm.getTotalValue = OnlineOrderService.getTotalValue;
  vm.onlineOrdersTable = new NgTableParams({
    count: 100
  });
  vm.onlineOrdersTable.sorting({
    deliverStartTime: 'asc'
  });

  function fitCurrentFilters(onlineOrder) {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const assignedOutlets = _.reduce(vm.showOutletMap, (assignedOutlets, toShow, outlet) => {
      if (toShow) assignedOutlets.push(outlet);
      return assignedOutlets;
    }, []);

    return _.includes(statuses, onlineOrder.status) && _.includes(assignedOutlets, ObjectId.getObjectId(onlineOrder.assignedOutlet));
  }

  const fetchOnlineOrdersToTable = onlineOrders => {
    vm.onlineOrders = onlineOrders;

    _.forEach(vm.onlineOrders, onlineOrder => {
      onlineOrder.note = _.map(onlineOrder.notes || [], 'content').join('; ');

      if (onlineOrder.receiverCustomer.district) {
        onlineOrder.fullAddress = `${onlineOrder.receiverCustomer.city} > ${onlineOrder.receiverCustomer.district} > ${onlineOrder.receiverCustomer.street}`;
      } else {
        onlineOrder.fullAddress = onlineOrder.receiverCustomer.address;
      }

      const cellphone = onlineOrder.orderCustomer.cellphone;

      if (cellphone) {
        onlineOrder.maskCellphone = cellphone.replace(cellphone.substring(3, 6), '****');
      }

      onlineOrder.mobileProvider = CustomerService.checkProvider(cellphone) || 'Khác';
      onlineOrder.hasShipperPhoneNumber = !!onlineOrder.shipping.shipperPhoneNumber;
      onlineOrder.printCount = onlineOrder.printCount || 0;
    });

    vm.onlineOrdersTable.settings({
      dataset: vm.onlineOrders
    });
  };

  vm.currentResult = [];

  vm.clearSearch = () => {
    if (!vm.omnisearch) {
      vm.currentResult = [];
      vm.showDone = false;
    }
  };

  vm.updateSummary = function () {
    vm.summary = {};

    const processingOrders = _.filter(vm.onlineOrders, onlineOrder => {
      return _.includes(['created', 'processing', 'confirm'], onlineOrder.status);
    });

    _.forEach(['created', 'processing', 'confirm'], status => {
      vm.summary[status] = (_.filter(processingOrders, {
        status
      }) || []).length;
    });

    vm.summary.totalOrderValue = _.sumBy(processingOrders, 'orderValue');
    vm.getShippingOutlets.then(() => {
      _.forEach(vm.data.outlets, outlet => {
        const outletId = outlet._id;
        vm.summary[outletId] = (_.filter(processingOrders, onlineOrder => {
          return _.get(onlineOrder, 'assignedOutlet._id') === outlet._id;
        }) || []).length;
      });
    });
  };

  vm.find = function () {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const assignedOutlets = _.reduce(vm.showOutletMap, (assignedOutlets, toShow, outlet) => {
      if (toShow) assignedOutlets.push(outlet);
      return assignedOutlets;
    }, []);

    vm.waiting = true;
    vm.onlineOrders = OnlineOrders.getCakeOrderes({
      statuses,
      assignedOutlets,
      deadline: vm.deadline,
      currentShiftOutlet: _.get(currentShift, 'outlet._id'),
      searchQuery: vm.omnisearch || null
    });
    const startDeliveryTime = vm.startDeliveryTime ? moment(vm.startDeliveryTime) : undefined;
    const endDeliveryTime = vm.endDeliveryTime ? moment(vm.endDeliveryTime) : undefined;
    let promise = vm.onlineOrders.$promise.then(onlineOrders => {
      return onlineOrders;
    }).then(onlineOrders => {
      vm.updateSummary();
      return onlineOrders;
    }).then(onlineOrders => {
      _.forEach(onlineOrders, onlineOrder => {
        getStatusForOnlineOrderDeadline(onlineOrder);
        onlineOrder.deadline = moment(onlineOrder.deadline).format('YYYY/MM/DD');
      });

      return onlineOrders;
    }).then(onlineOrders => {
      if (startDeliveryTime && endDeliveryTime) {
        onlineOrders = _.filter(onlineOrders, onlineOrder => {
          let orderStartTime = moment(onlineOrder.deliverStartTime);
          let orderEndTime = moment(onlineOrder.deliverEndTime);
          let filterStartTime = moment(onlineOrder.deliverStartTime).set({
            hour: startDeliveryTime.get('hour'),
            minute: startDeliveryTime.get('minute')
          });
          let filterEndTime = moment(onlineOrder.deliverEndTime).set({
            hour: endDeliveryTime.get('hour'),
            minute: endDeliveryTime.get('minute')
          });
          return orderStartTime > filterStartTime && orderEndTime < filterEndTime;
        });
      }

      return onlineOrders;
    }).then(fetchOnlineOrdersToTable).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
    return promise;
  };

  vm.createOnlineOrderModal = orderType => {
    OnlineOrderModal.create(orderType).then(onlineOrder => {
      vm.onlineOrders.push(onlineOrder);
      fetchOnlineOrdersToTable(vm.onlineOrders);
      vm.onlineOrdersTable.reload();
    });
  };

  vm.openViewOnlineOrdersByUser = OnlineOrderModal.openViewOnlineOrdersByUser;

  vm.searchKeyUp = function ($event) {
    if ($event.keyCode === 13) vm.find();
  };

  vm.viewSaleEntry = SaleEntryService.viewSaleEntry;

  function listenUpdateOnlineOrder(onlineOrder) {
    if (!onlineOrder) return;
    if (vm.waiting) return;
    if (vm.omnisearch) return;

    const matchOrder = _.find(vm.onlineOrders, {
      _id: onlineOrder._id
    });

    if (!matchOrder && fitCurrentFilters(onlineOrder)) {
      if (!onlineOrder.updated) {
        FhdMessenger.info(`Đơn ${onlineOrder.onlineOrderId} từ ${onlineOrder.source} đã thêm vào danh sách.`);
      }

      vm.onlineOrders.push(_.assign({}, onlineOrder, {
        created: new Date(onlineOrder.created)
      }));

      if (!vm.omnisearch) {
        _.forEach(vm.onlineOrders, onlineOrder => {
          getStatusForOnlineOrderDeadline(onlineOrder);
        });

        fetchOnlineOrdersToTable(vm.onlineOrders);
        vm.onlineOrdersTable.reload();
        vm.updateSummary();
        $scope.$apply();
      }
    }

    if (matchOrder) {
      _.assign(matchOrder, onlineOrder);

      if (matchOrder.deadline) {
        matchOrder.deadline = moment(matchOrder.deadline).format('YYYY/MM/DD');
      }

      fetchOnlineOrdersToTable(vm.onlineOrders);
      vm.onlineOrdersTable.reload();
      vm.updateSummary();
      $scope.$apply();
    }
  }

  function getStatusForOnlineOrderDeadline(onlineOrder) {
    if (!onlineOrder.deadline) {
      return;
    }

    const deadlineDiffDay = moment(onlineOrder.deadline).startOf('day').diff(moment().startOf('day'), 'days');

    if (deadlineDiffDay <= 0) {
      onlineOrder.deadlineLabel = 'danger';
    } else if (deadlineDiffDay <= 2) {
      onlineOrder.deadlineLabel = 'warning';
    } else {
      onlineOrder.deadlineLabel = 'primary';
    }
  }

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      case 'outlet':
        {
          let changeValue = true;
          if (_.every(vm.showOutletMap)) changeValue = false;

          _.forEach(vm.showOutletMap, (value, key) => {
            vm.showOutletMap[key] = vm.enableOutletMap[key] && changeValue;
          });

          break;
        }

      default:
    }
  };

  vm.updateShippingFee = function () {
    _.forEach(vm.shippings, shipping => {
      shipping.shippingFee = parseFloat(shipping.shippingFee);
    });

    if (_.some(vm.shippings, shipping => {
      return !shipping.billNumber;
    })) {
      return FhdMessenger.error('Chưa có mã đơn vận');
    }

    if (_.some(vm.shippings, shipping => {
      return !shipping.shippingFee && shipping.shippingFee !== 0;
    })) {
      return FhdMessenger.error('Chưa có phí ship');
    }

    vm.waiting = true;
    OnlineOrders.updateShippingFee(vm.shippings).$promise.then(() => {
      FhdMessenger.notifySticky('Đã cập nhật xong');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    }); // console.log(vm.shippings)
  };

  vm.assignOutlet = (onlineOrder, outlet) => {
    // eslint-disable-next-line
    if (vm.user.roles.includes('admin')) {
      $http.put(`/online-orders/${onlineOrder._id}/change-outlet`, outlet).then(response => {
        if (response.data !== 'Có cập nhật') {
          FhdMessenger.success(response.data);
        }
      }).catch(err => {
        FhdMessenger.error(err.message);
      });
    }
  };

  vm.editShipperPhoneNumber = ($event, onlineOrder) => {
    onlineOrder.editingShipperPhoneNumber = !onlineOrder.editingShipperPhoneNumber;
    onlineOrder.shipperPhoneNumber = onlineOrder.shipping.shipperPhoneNumber || ''; // find input next to element and focus using angular element

    const input = angular.element($event.target).next();
    $timeout(() => {
      input.focus();
    });
  };

  vm.validatePhoneNumber = phoneNumber => {
    if (!phoneNumber) {
      return '';
    }

    if (phoneNumber.length < 10) {
      return 'Số điện thoại không hợp lệ';
    }
  };

  vm.modifierShipperPhoneNumber = onlineOrder => {
    const phoneNumber = _.get(onlineOrder, 'shipperPhoneNumber');

    if (_.isString(phoneNumber) && !phoneNumber.match(/^0/)) {
      onlineOrder.shipperPhoneNumber = '0' + phoneNumber;
    }
  };

  vm.saveShipperPhoneNumber = ($event, onlineOrder) => {
    if ($event.keyCode === 13) {
      const error = vm.validatePhoneNumber(onlineOrder.shipperPhoneNumber);

      if (error) {
        return FhdMessenger.error(error);
      }

      $http.put(`/online-orders/${onlineOrder._id}/change-shipper-phone-number`, {
        shipperPhoneNumber: onlineOrder.shipperPhoneNumber
      }).then(response => {
        onlineOrder.editingShipperPhoneNumber = false;
        FhdMessenger.success(`Đã cập nhật số điện thoại shipper cho đơn ${onlineOrder.onlineOrderId}`);
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
    } // handle escape key


    if ($event.keyCode === 27) {
      onlineOrder.editingShipperPhoneNumber = false;
    }
  };

  vm.print = onlineOrder => {
    vm.onlineOrder = onlineOrder;
    vm.items = onlineOrder.items;
    vm.cakeTotal = OnlineOrderService.getCakeTotal(vm.onlineOrder.items);
    vm.addOnTotal = vm.cakeTotal + OnlineOrderService.getAddOnTotal(vm.onlineOrder.items);
    vm.printLink = 'work.4-handy.com/#!/online-orders/' + onlineOrder._id; //  + '/update-product-images'

    vm.assignedOutlet = onlineOrder.assignedOutlet;
    if ($window.Cypress) return;
    const customStyle = true;
    const autoPrint = true;
    $timeout(() => {
      convertQrCodeSaleEntryToImage();
      JsPrintService.printElementById('receipt-table', autoPrint, customStyle);
      vm.waiting = true;
      vm.onlineOrder.$updatePrintCount().then().catch(FhdMessenger.err).finally(() => {
        vm.waiting = false;
      });
    }, 500);
  };

  vm.selectTab = tab => {
    vm.tabMap[tab].active = true;
    vm.tabMap[tab].loaded = true;

    _.forEach(vm.tabMap, (value, key) => {
      if (key !== tab) {
        vm.tabMap[key].active = false;
      }
    });

    $location.search('tab', tab);
  };

  function convertQrCodeSaleEntryToImage() {
    const qrCodeCanvas = $document[0].querySelector('#qrcode > canvas');
    if (!qrCodeCanvas) return;
    let img = $document[0].createElement('img');
    img.src = qrCodeCanvas.toDataURL('image/png');
    const qrCode = $document[0].querySelector('#qrcode');
    qrCode.removeChild(qrCodeCanvas);
    qrCode.appendChild(img);
  }

  vm.openModalViewOnlineOrder = onlineOrder => {
    OnlineOrderModal.view(onlineOrder);
  };

  Sockets.on('updateOnlineOrder', listenUpdateOnlineOrder);
  $scope.$on('$destroy', function () {
    Sockets.removeListener('updateOnlineOrder', listenUpdateOnlineOrder);
  });
}]);
'use strict';

angular.module('online-orders').controller('CreateOnlineOrderModalController', ['helper', 'orderType', '$modalInstance', '$scope', '$http', '$window', 'FhdMessenger', 'JsPrintService', 'ObjectId', 'OnlineOrderModal', 'OnlineOrderService', 'ShippingAreaService', 'Authentication', 'OnlineOrders', '$filter', 'StockMap', 'OutletService', 'Address', 'CurrentShift', 'PromotionService', 'CustomerService', 'SaleCampaigns', 'Vouchers', 'CalculateService', 'ConfirmModal', function (helper, orderType, $modalInstance, $scope, $http, $window, FhdMessenger, JsPrintService, ObjectId, OnlineOrderModal, OnlineOrderService, ShippingAreaService, Authentication, OnlineOrders, $filter, StockMap, OutletService, Address, CurrentShift, PromotionService, CustomerService, SaleCampaigns, Vouchers, CalculateService, ConfirmModal) {
  const vm = this;
  vm.user = Authentication.user;
  vm.close = $modalInstance.dismiss;
  vm.requireWard = false;
  const currentShift = CurrentShift.getCurrentShift();
  vm.chooseFillingTypeSkus = OnlineOrderService.getFillingTypeSkus();
  vm.needPhotoSkus = _.concat(OnlineOrderService.getNeedPhotoSkus(), vm.chooseFillingTypeSkus);
  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus;
  vm.sources = OnlineOrderService.getSources(orderType);
  vm.localPickupMethod = 'Ship';
  vm.openModalSelectCakeFillingType = OnlineOrderModal.openModalSelectCakeFillingType;

  vm.openModalSelectVariants = async item => {
    vm.items = await OnlineOrderService.openModalSelectVariants({
      item,
      items: vm.items,
      assignedOutlet: vm.assignedOutlet,
      source: vm.source
    });
    vm.calculate();
  };

  vm.openModalSelectManufacturingDate = OnlineOrderModal.openModalSelectManufacturingDate;

  vm.updateFacebookConversationIdByOriginalLink = () => {
    if (!_.isString(vm.originalLink)) {
      return;
    }

    vm.facebookConversationId = vm.originalLink;
    vm.updateFacebookConversationId();
  };

  vm.updateFacebookConversationId = () => {
    if (!_.isString(vm.facebookConversationId)) {
      return;
    }

    const match = vm.facebookConversationId.match(/\d{16}_\d{16}/);

    if (match) {
      vm.facebookConversationId = _.head(match);
    }
  };

  vm.data = OnlineOrderService.getSharedData();

  vm.checkLocalPickUpMethod = () => {
    vm.data.paymentMethods = OnlineOrderService.getPaymentMethodByShippingProvider(vm.localPickupMethod);
  };

  vm.isCakeOrder = orderType === 'ORDER';
  vm.isValentine = false;

  if (vm.isCakeOrder) {
    vm.payment = {
      method: 'transfer'
    };
  }

  vm.includeBill = true;

  vm.autoDeliverEndTime = () => {
    vm.deliverEndTime = moment(vm.deliverStartTime).add(1, 'hour');
  };

  vm.showManufacturingDate = function (item) {
    if (!vm.isCakeOrder) {
      return false;
    }

    if (item.sku === 'V1408') {
      return false;
    }

    return _.get(item, 'category.cat.name') === 'Bánh sinh nhật';
  };

  vm.findVoucher = () => {
    vm.waiting = true;
    Vouchers.searchVoucher({
      couponCode: vm.couponCode.trim()
    }).$promise.then(voucher => {
      vm.voucher = voucher;
      vm.vouchers = [voucher];
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.suggestShippingOutlet = function () {
    if (!vm.isCakeOrder) {
      return;
    }

    const district = _.head(_.split(vm.receiverCustomerDistrict, ','));

    ShippingAreaService.getSavorShippingArea().then(shippingArea => {
      const matchItem = _.find(shippingArea.items, {
        district,
        ward: vm.receiverCustomerWard
      });

      vm.suggestOutlet = _.get(matchItem, 'outlet', 'Chưa rõ');
      vm.suggestKitchen = _.get(matchItem, 'kitchen', 'Chưa rõ');
    });
  };

  vm.getStockMap = () => {
    StockMap.getStockMapCache().then(data => {
      vm.stockMap = data;
    });
  };

  vm.initOne = () => {
    vm.source = 'facebook';
    vm.items = [];
    vm.deadline = null;
    vm.getStockMap();
    vm.deliverStartTime = vm.deliverEndTime = moment().startOf('day').toDate();
    Address.getWards().then(wards => {
      vm.data.wards = wards;
    });
    OutletService.allAsync().then(outlets => {
      vm.data.outlets = _.filter(outlets, outlet => {
        if (vm.isCakeOrder) {
          return outlet.sellBirthdayCake;
        }

        return outlet.isPos && outlet.code.match(/[ME]\d+/);
      });

      if (currentShift && _.get(currentShift, 'outlet.code', '').match(/[ME]\d+/)) {
        const outletCode = _.get(currentShift, 'outlet.code');

        vm.assignedOutlet = _.find(outlets, {
          code: outletCode
        });
      }
    });
  };

  vm.duplicateCustomerInformation = () => {
    vm.receiverCustomerName = vm.customerName;
    vm.receiverCustomerCellphone = vm.customerCellphone;
  };

  vm.submit = () => {
    if (vm.requireWard && !vm.receiverCustomerWard) {
      return FhdMessenger.error('Cần điền phường của người nhận hàng');
    }

    if ([('abby.vn', 'facebook')].includes(vm.source) && !_.get(vm, 'originalLink')) {
      return FhdMessenger.error('Thiếu link nguồn');
    }

    const voucherType = _.get(vm.voucher, 'voucherType', '');

    if (voucherType === 'DISCOUNT_CAKE_ORDER_NORMAL' && !_.some(vm.items, item => {
      return item.description.match(/(cỡ|size) nhỏ/gim) || ['V1408'].includes(item.sku);
    })) {
      return FhdMessenger.error('Trong danh sách sản phẩm không có bánh cỡ nhỏ để sử dụng voucher');
    }

    if (voucherType === 'DISCOUNT_CAKE_ORDER_BIG' && !_.some(vm.items, item => {
      return item.description.match(/(cỡ|size) vừa/gim) || ['V1788'].includes(item.sku);
    })) {
      return FhdMessenger.error('Trong danh sách sản phẩm không có bánh cỡ vừa để sử dụng voucher');
    }

    if (vm.source === 'shopee' && !vm.shopeeId) {
      return FhdMessenger.error('Thiếu Shopee ID');
    }

    if (vm.source === 'tiktok' && !vm.tiktokId) {
      return FhdMessenger.error('Thiếu Tiktok ID');
    }

    if (vm.requestCard && !vm.requestCardContent) {
      return FhdMessenger.error('Chưa có nội dung của thiệp khách yêu cầu thêm');
    }

    if (vm.isCakeOrder && (!vm.textInBase || !vm.textInCake) && !vm.disableTexts) {
      vm.waiting = true;
      let textType = 'đế + mặt bánh';

      if (vm.textInBase) {
        textType = 'mặt bánh';
      }

      if (vm.textInCake) {
        textType = 'đế bánh';
      }

      return ConfirmModal.showModal({}, {
        actionButtonText: `Tạo đơn`,
        closeButtonText: 'Kiểm tra lại',
        headerText: `Chưa có chữ viết trên ${textType}`,
        bodyText: `Bạn có muốn tiếp tục tạo đơn?`
      }).then(() => {
        create();
      }).finally(() => {
        vm.waiting = false;
      });
    }

    return create();
  };

  function create() {
    if (vm.resolvedOulet) {
      if (vm.user.roles.includes('sale')) {
        if (!currentShift.outlet) {
          return FhdMessenger.error('Bạn chưa đăng nhập ca trực');
        }

        if (!_.get(currentShift, 'outlet.code', '').match(/[MESB]\d+/)) {
          return FhdMessenger.error('Chỉ được chuyển đơn về cơ sở xử lý là M hoặc E');
        }

        vm.assignedOutlet = currentShift.outlet._id;
      } else {
        vm.assignedOutlet = vm.user.outlet._id;
      }
    } else if (vm.isCakeOrder) {
      if (!_.get(vm, 'assignedOutlet.code')) {
        return FhdMessenger.error('Bạn chưa chọn cơ sở Savor xử lý cho đơn bánh ngọt');
      }
    } else if (!vm.user || !vm.user.roles.includes('admin')) {
      vm.assignedOutlet = undefined;
    }

    if (vm.isCakeOrder) {
      if (!vm.deadline) {
        return FhdMessenger.error('Bạn chưa chọn thời gian giao bánh cho khách hàng');
      } else if (moment(helper.combineTimeAndDate(vm.deadline, vm.deliverStartTime)).isBefore(moment())) {
        return FhdMessenger.error('Bạn không được tạo đơn bánh sinh nhật cho quá khứ');
      }
    }

    vm.receiverCustomerAddress = `${vm.receiverCustomerStreet}, ${vm.receiverCustomerDistrict}`;

    const receiverDistrict = _.find(vm.data.districts, {
      label: vm.receiverCustomerDistrict
    });

    if (!receiverDistrict) {
      return FhdMessenger.error('Chưa chọn quận của địa chỉ nhận hàng');
    }

    if (vm.requireWard && !vm.receiverCustomerWard) {
      return FhdMessenger.error('Cần điền phường của người nhận hàng');
    }

    if (['Hà Nội (Nội thành)'].includes(receiverDistrict.city)) {// if (vm.orderValue < 300000 && !_.get(currentShift, 'outlet.code', '').match(/[ME]\d+/)) {
      //   return FhdMessenger.error('Đơn hàng nội thành Hà nội chưa đủ 300,000đ')
      // }
    } else if (['TP. Hồ Chí Minh (Nội thành)'].includes(receiverDistrict.city)) {// if (vm.orderValue < 300000 && !_.get(currentShift, 'outlet.code', '').match(/[ME]\d+/)) {
      //   return FhdMessenger.error('Đơn hàng nội thành HCM chưa đủ 300,000đ')
      // }
    } else {
      if (!vm.isCakeOrder && !['tiktok', 'shopee'].includes(vm.source) && vm.orderValue < 200000) {
        return FhdMessenger.error('Đơn hàng tỉnh chưa đủ 200,000đ');
      }
    }

    const validate = OnlineOrderService.validate(vm);

    if (vm.isCakeOrder) {
      if (!vm.localPickupMethod) {
        return FhdMessenger.error('Bạn chưa chọn phương thức giao hàng cho đơn bánh sinh nhật');
      }

      const WOMENDAY = moment().set({
        month: 2,
        date: 8
      }).startOf('day').toDate();

      if (moment().isAfter(moment(WOMENDAY)) && moment(vm.deadline).startOf('day').isSame(moment(WOMENDAY)) && vm.localPickupMethod === 'Giao tại cửa hàng') {
        return FhdMessenger.error('Đơn tạo sau 0h 8/3 thì không được chọn lấy tại cửa hàng');
      }

      const validateSpecialSkusWomenDay = validate.validateSpecialSkusOnSpecialDays(PromotionService.getSpecialCakeSkus(), moment().set({
        month: 2,
        date: 7
      }).startOf('day'), moment(WOMENDAY).endOf('day'));

      if (validateSpecialSkusWomenDay) {
        return FhdMessenger.error(validateSpecialSkusWomenDay);
      } // if (!_.trim(vm.facebookConversationId)) {
      //   return FhdMessenger.error('Bạn phải điền facebook conversation id')
      // }


      if (_.some(vm.items, item => {
        return !item.sku.match(/V\d+/);
      })) {
        return FhdMessenger.error('Đơn bánh sinh nhật/trung thu chỉ được thêm mã V');
      }

      if (vm.isCakeOrder) {
        const deliveryTimeError = validate.validateDeliveryTime();

        if (deliveryTimeError) {
          return FhdMessenger.error(deliveryTimeError);
        }

        const transferOnlyError = validate.validateTransferOnly();

        if (transferOnlyError) {
          return FhdMessenger.error(transferOnlyError);
        }
      }

      const cakeDepositError = validate.validateCakeDeposit({
        chooseFillingTypeSkus: vm.chooseFillingTypeSkus,
        isNew: true,
        orderValue: vm.orderValue
      });

      if (cakeDepositError) {
        return FhdMessenger.error(cakeDepositError);
      }
    }

    if (_.some(vm.items, item => {
      return vm.needPhotoSkus.includes(item.sku);
    })) {
      if (!vm.images.length) {
        return FhdMessenger.error('Đơn bánh vẽ/tulip phải có ảnh mẫu');
      }
    }

    const depositAmountError = validate.validateDepositAmount(vm.depositAmount, vm.deposit, true);

    if (depositAmountError) {
      return FhdMessenger.error(depositAmountError);
    }

    const paymentCodeError = validate.validatePaymentCode();

    if (paymentCodeError) {
      return FhdMessenger.error(paymentCodeError);
    }

    if (_.some(vm.items, item => {
      return vm.chooseFillingTypeSkus.includes(item.sku) && !item.cakeFillingType;
    })) {
      return FhdMessenger.error('Bánh vẽ/order phải chọn hương vị');
    }

    FhdMessenger.info('Đang tạo...');
    const user = Authentication.user;
    const {
      date,
      outlet,
      shift
    } = currentShift;
    const onlineOrder = new OnlineOrders({
      items: vm.items,
      customer: vm.customer,
      orderCustomer: {
        name: vm.customerName,
        email: vm.customerEmail,
        cellphone: vm.customerCellphone
      },
      fees: [],
      resolvedOulet: vm.resolvedOulet,
      payment: vm.payment,
      images: vm.images,
      voucher: vm.voucher,
      facebookConversationId: vm.facebookConversationId,
      deliverEndTime: vm.deliverEndTime,
      deliverStartTime: vm.deliverStartTime,
      textInCake: vm.textInCake,
      textInBase: vm.textInBase,
      requestCard: vm.requestCard,
      requestCardContent: vm.requestCardContent,
      localPickupMethod: vm.localPickupMethod,
      currentShiftOutlet: currentShift.outlet ? currentShift.outlet : undefined,
      receiverCustomer: {
        name: vm.receiverCustomerName,
        email: vm.receiverCustomerEmail,
        cellphone: vm.receiverCustomerCellphone,
        address: vm.receiverCustomerAddress,
        city: receiverDistrict.city,
        district: receiverDistrict.district,
        street: vm.receiverCustomerStreet,
        ward: vm.receiverCustomerWard || null
      },
      assignedOutlet: vm.assignedOutlet,
      shiftCreated: {
        outlet,
        date,
        shift
      },
      // expectDeliverDate: vm.expectDeliverDate,
      source: vm.source,
      shopeeId: vm.shopeeId,
      tiktokId: vm.tiktokId,
      originalLink: vm.originalLink,
      orderValue: vm.orderValue,
      status: 'created',
      staff: ObjectId.getObjectId(vm.staff),
      deadline: vm.deadline,
      orderType: vm.orderType,
      orderNote: vm.orderNote,
      includeBill: vm.includeBill,
      notes: vm.note ? [{
        content: vm.note,
        user: ObjectId.getObjectId(user),
        time: Date.now()
      }] : [],
      deposits: _.get(vm.deposit, 'amount') > 0 ? [{
        amount: _.get(vm.deposit, 'amount'),
        transferCode: _.get(vm.deposit, 'code'),
        depositType: 'transfer'
      }] : []
    });
    vm.waiting = true;
    return onlineOrder.$save().then(onlineOrder => {
      FhdMessenger.success('Tạo xong!');
      $window.open('#!/online-orders/' + onlineOrder._id, '_blank');
      return onlineOrder;
    }).then(onlineOrder => $modalInstance.close(onlineOrder)).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }

  vm.removeItem = index => {
    if (_.get(vm.items[index], 'uid')) {
      const uid = vm.items[index].uid;
      vm.items = _.reject(vm.items, item => {
        return item.uid === uid || item.parentUid === uid;
      });
    } else {
      vm.items.splice(index, 1);
    }

    vm.calculate();
  };

  function isCity(city, district) {
    const districts = Address.getDistricts();

    const matchDistrict = _.find(districts, {
      label: district
    });

    return matchDistrict && matchDistrict.city === city;
  }

  vm.changeDistrict = () => {
    const district = vm.receiverCustomerDistrict;

    if (isCity('TP. Hồ Chí Minh (Nội thành)', district)) {
      vm.region = 'HCM';
    } else if (isCity('Hà Nội (Nội thành)', district)) {
      vm.region = 'HN';
    } else {
      vm.region = 'OTHER';
    }

    vm.calculate();
  };

  vm.calculate = () => {
    vm.isValentine = _.some(vm.items, item => {
      return ['V2204', 'V2205'].includes(item.sku);
    });
    let result = CalculateService.calculate({
      items: vm.items,
      voucher: vm.voucher,
      source: vm.source,
      assignedOutlet: vm.assignedOutlet,
      customer: vm.customer,
      saleCampaigns: vm.saleCampaigns,
      orderValue: vm.orderValue,
      isCakeOrder: vm.isCakeOrder,
      localPickupMethod: vm.localPickupMethod,
      textInCake: vm.textInCake,
      textInBase: vm.textInBase,
      deadline: vm.deadline,
      deliverStartTime: vm.deliverStartTime,
      deliverEndTime: vm.deliverEndTime,
      orderNote: vm.orderNote,
      receiverCustomerCellphone: vm.receiverCustomerCellphone,
      receiverCustomerStreet: vm.receiverCustomerStreet,
      receiverCustomerWard: vm.receiverCustomerWard,
      receiverCustomerDistrict: vm.receiverCustomerDistrict,
      paymentMethod: _.get(vm.payment, 'method'),
      isStaff: _.get(vm.customer, 'isStaff', false)
    });

    _.assign(vm, result);

    vm.disableTexts = OnlineOrderService.checkDisableCakeTexts(vm.items);

    if (vm.disableTexts) {
      vm.textInBase = '';
      vm.textInCake = '';
    }
  };

  vm.selectCustomer = customer => {
    if (!customer) {
      vm.customer = null;
      vm.saleCampaigns = null;
      vm.vouchers = [];
      vm.customerPoints = 0;
      vm.calculate();
      return;
    }

    vm.customerName = customer.fullName;
    vm.customerCellphone = customer.cellphone;
    vm.receiverCustomerName = customer.fullName;
    vm.receiverCustomerCellphone = customer.cellphone;

    if (customer.email) {
      vm.customerEmail = customer.email;
      vm.receiverCustomerEmail = customer.email;
    }

    if (_.get(customer, 'address.district')) {
      vm.receiverCustomerDistrict = _.find(vm.data.districts, {
        district: customer.address.district
      }).label;
    }

    if (_.get(customer, 'address.street')) {
      vm.receiverCustomerStreet = `${customer.address.houseNumber ? `${customer.address.houseNumber},` : ``} ${customer.address.street ? customer.address.street : ``}`;
    }

    if (_.get(customer, 'cellphone')) {
      const cellphone = customer.cellphone;
      $http.get(`online-orders/get-customer-online-orders`, {
        params: {
          cellphone: cellphone
        }
      }).then(response => {
        vm.passOnlineOrders = response.data;
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
    }

    CustomerService.getValueAndVouchers(customer.customerId).then(customer => {
      _.set(vm.customer, 'isStaff', _.get(customer, 'isStaff', false));

      if (!vm.voucher) {
        vm.vouchers = customer.vouchers;
        vm.voucher = _.last(vm.vouchers);
      }

      vm.customerPoints = customer.customerPoints;
      vm.calculate();
    });
    SaleCampaigns.fromCustomer(customer).$promise.then(saleCampaigns => {
      vm.saleCampaigns = saleCampaigns;
      vm.calculate();
    });
  };

  $scope.$watch(() => vm.product, (newValue, oldValue) => {
    if (newValue === oldValue || !newValue) return;
    const inputItem = newValue;

    if (inputItem.sku === 'V1408') {
      PromotionService.openComboModal(inputItem).result.then(selectedItems => {
        const cogs = _.reduce(selectedItems, (result, selectedItem) => {
          return result + _.get(selectedItem, 'item.cogs', 0) * _.get(selectedItem, 'quantity', 1);
        }, 0);

        const price = Math.floor(_.sumBy(selectedItems, item => {
          return _.get(item, 'item.price', 0) * item.quantity;
        }) * 0.75 / 10000) * 10000;

        const newItem = _.assign({}, inputItem, {
          product: inputItem._id,
          quantity: inputItem.needQuantity ? 0 : 1,
          price: price,
          originalPrice: price,
          soldPrice: price,
          lineTotal: price,
          discount: 0,
          cogs,
          isCombo: true,
          bundledProducts: _.map(selectedItems, selectedItem => ({
            product: _.get(selectedItem, 'item._id'),
            sku: _.get(selectedItem, 'item.sku'),
            description: _.get(selectedItem, 'item.description'),
            quantity: _.get(selectedItem, 'quantity')
          })),
          toLock: true
        });

        const allItems = CalculateService.addProduct({
          inputItem: newItem,
          items: vm.items,
          assignedOutlet: vm.assignedOutlet,
          source: vm.source
        });
        vm.items = allItems;
        vm.calculate();
      });
      return;
    }

    const allItems = CalculateService.addProduct({
      inputItem,
      items: vm.items,
      assignedOutlet: vm.assignedOutlet,
      source: vm.source
    });
    vm.items = allItems;
    vm.calculate();
  });

  function checkRequireWard(district) {
    if (!district) {
      return false;
    }

    if ((district.includes('Hồ Chí Minh') || district.includes('Hà Nội')) && district.includes('(Nội thành)')) {
      return true;
    }

    return false;
  }

  function getCity(district) {
    if (district.includes('Hồ Chí Minh')) {
      return 'TP. Hồ Chí Minh';
    }

    return 'Hà Nội';
  }

  vm.getWard = () => {
    if (checkRequireWard(vm.receiverCustomerDistrict)) {
      vm.requireWard = true;
      const city = getCity(vm.receiverCustomerDistrict);

      const district = _.head(vm.receiverCustomerDistrict.split(','));

      vm.data.currentWards = vm.data.wards[city][district];

      if (!_.get(vm.data.currentWards, 'length', 0)) {
        vm.requireWard = false;
      }
    } else {
      vm.requireWard = false;
      vm.data.currentWards = [];
    }
  };

  $scope.$watch(() => vm.assignedOutlet, () => {
    vm.calculate();
  });
  $scope.$watch(() => vm.receiverCustomerDistrict, () => {
    vm.getWard();
  });

  vm.copyInfoOrderCustomer = onlineOrder => {
    vm.customerName = onlineOrder.orderCustomer.name;
    vm.customerEmail = onlineOrder.orderCustomer.email;
    vm.customerCellphone = onlineOrder.orderCustomer.cellphone;
    FhdMessenger.success('Đã copy thông tin người đặt');
  };

  vm.copyInfoRecieverCustomer = onlineOrder => {
    vm.receiverCustomerName = onlineOrder.receiverCustomer.name;
    vm.receiverCustomerCellphone = onlineOrder.receiverCustomer.cellphone;
    vm.receiverCustomerDistrict = onlineOrder.receiverCustomer.district;
    vm.receiverCustomerWard = onlineOrder.receiverCustomer.ward;
    vm.receiverCustomerStreet = onlineOrder.receiverCustomer.street;
    FhdMessenger.success('Đã copy thông tin người nhận');
  };

  vm.printOnlineOrder = function () {
    if ($window.Cypress) return;
    const customStyle = true;
    const autoPrint = true;
    JsPrintService.printElementById('receipt-table', autoPrint, customStyle);
  };

  vm.now = function () {
    return moment().format('MM-DD HH:mm');
  };
}]);
"use strict";

angular.module('online-orders').controller('GetReasonModalController', ['type', 'items', '$modalInstance', 'FhdMessenger', function (type, items, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.type = type;
  vm.items = items;

  if (type === 'cancel') {
    vm.reasons = ['Khách không nghe máy', 'Hết hàng', 'Phí ship cao', 'Trùng đơn', 'Khác'];
  } else {
    vm.reasons = ['Khách không nghe máy', 'Ship sai hàng', 'Khác'];
  }

  vm.submit = function () {
    if (!vm.reason) {
      FhdMessenger.error('Chưa có lý do');
      return;
    }

    if (_.includes(['Khác'], vm.reason) && !vm.detail) {
      FhdMessenger.error('Chưa có giải thích cụ thể');
      return;
    }

    if (vm.reason === 'Hết hàng') {
      if (!_.some(vm.items, {
        stockOut: true
      })) {
        FhdMessenger.error('Chưa đánh dấu sản phẩm hết hàng');
        return;
      }
    }

    let reason = vm.reason;

    if (_.includes(['Khác'], vm.reason)) {
      reason = `${reason}: ${vm.detail}`;
    }

    const items = _.filter(vm.items, {
      stockOut: true
    });

    const data = {
      items,
      reason // console.log(items)

    };
    $modalInstance.close(data);
  };

  vm.cancel = $modalInstance.dismiss();
}]);
"use strict";

angular.module('online-orders').controller('ImportOnlineOrderFeeController', ['ConfirmModal', 'OnlineOrders', 'FhdMessenger', function (ConfirmModal, OnlineOrders, FhdMessenger) {
  const vm = this;

  vm.import = () => {
    if (!vm.googleSheetLink) {
      return FhdMessenger.error('Bạn chưa điền link google sheet');
    }

    if (!_.includes(vm.googleSheetLink, 'https://docs.google.com/spreadsheets/d/')) {
      return FhdMessenger.error('Link google sheet không đúng định dạng');
    }

    ConfirmModal.showModal({}, {
      headerText: `Hành động này sẽ import phí của online order từ link gg sheet?`,
      bodyText: `<strong>Lưu ý</strong>: <p>Link google sheet <a href="${vm.googleSheetLink}">này</a> cần được cấp quyền xem cho tài khoản chuthang205@gmail.com</p>`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      OnlineOrders.importFee({
        googleSheetLink: vm.googleSheetLink
      }).$promise.then(onlineOrders => {
        return FhdMessenger.success(`Import ${onlineOrders.length} phí cho Online Order thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('online-orders').controller('ModalChangeAssignedOutletController', ['onlineOrder', 'ObjectId', 'OnlineOrders', '$modalInstance', 'FhdMessenger', function (onlineOrder, ObjectId, OnlineOrders, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.waiting = true;
  OnlineOrders.get({
    onlineOrderId: onlineOrder._id
  }).$promise.then(onlineOrder => {
    vm.onlineOrder = onlineOrder;
    vm.waiting = false;
    vm.requireTransferInfo = onlineOrder.assignedOutlet.code.match(/B\d+/);
  });
  vm.providers = ['Xe restock', 'Lalamove', 'Ahamove', 'Ship ngoài'];

  vm.requireBillNumber = () => {
    return ['Lalamove', 'Ahamove'].includes(_.get(vm.onlineOrder, 'transfer.provider'));
  };

  vm.requirePay = () => {
    return ['Lalamove', 'Ahamove', 'Ship ngoài'].includes(_.get(vm.onlineOrder, 'transfer.provider'));
  };

  vm.submit = function () {
    if (!vm.onlineOrder.newAssignedOutlet) {
      return FhdMessenger.error('Chưa có cơ sở mới của online order');
    }

    if (vm.onlineOrder.orderType === 'ORDER' && _.some(vm.onlineOrder.items, item => {
      return item.description.match(/bánh.*(size|cỡ)/gim);
    }) && !vm.onlineOrder.newAssignedOutlet.sellBirthdayCake) {
      return FhdMessenger.error('Đơn đặt bánh sinh nhật chỉ chuyển về cơ sở có bán bánh sinh nhật');
    }

    if (!vm.onlineOrder.reason) {
      return FhdMessenger.error('Chưa có lý do');
    }

    if (ObjectId.equals(vm.onlineOrder.assignedOutlet, vm.onlineOrder.newAssignedOutlet)) {
      return FhdMessenger.error('Cơ sở mới phải khác cơ sở hiện tại');
    }

    if (!vm.onlineOrder.deadline) {
      return FhdMessenger.error('Chưa có ngày khác muốn nhận');
    }

    if (vm.requireTransferInfo) {
      if (!_.get(vm.onlineOrder, 'transfer.provider')) {
        return FhdMessenger.error('Chưa có phương thức chuyển bánh ra cơ sở');
      }

      if (vm.requireBillNumber() && !_.get(vm.onlineOrder, 'transfer.billNumber')) {
        return FhdMessenger.error('Chưa có mã đơn ' + _.get(vm.onlineOrder, 'transfer.provider'));
      }

      if (vm.requirePay() && !_.get(vm.onlineOrder, 'transfer.pay')) {
        return FhdMessenger.error('Chưa có phí ship ' + _.get(vm.onlineOrder, 'transfer.provider'));
      }
    }

    vm.waiting = true;
    vm.onlineOrder.$requestChangeOutlet().then(onlineOrder => {
      $modalInstance.close();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.cancel = $modalInstance.dismiss;
}]);
"use strict";

angular.module('online-orders').controller('ModalChangeCakeDeadlineController', ['onlineOrder', 'OnlineOrders', '$modalInstance', 'FhdMessenger', function (onlineOrder, OnlineOrders, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.cakeDeadlineStatus = [{
    name: 'Ship thường',
    value: 'ship-normaly'
  }, {
    name: 'Ship gấp',
    value: 'ship-urgently'
  }, {
    name: 'Restock cơ sở',
    value: 'restock'
  }];
  vm.waiting = true;
  OnlineOrders.get({
    onlineOrderId: onlineOrder._id
  }).$promise.then(onlineOrder => {
    vm.onlineOrder = onlineOrder;
    vm.waiting = false;
  });

  vm.submit = function () {
    if (!vm.onlineOrder.cakeDeadline) {
      return FhdMessenger.error('Bạn chưa nhập deadline mới');
    }

    if (moment(vm.onlineOrder.cakeDeadline).isBefore(moment())) {
      return FhdMessenger.error('Bạn không thể nhập deadline trong quá khứ');
    }

    if (moment(vm.onlineOrder.cakeDeadline).isAfter(moment(vm.onlineOrder.deliverStartTime))) {
      return FhdMessenger.error('Bạn không thể nhập deadline sau thời điểm bắt đầu giao bánh');
    }

    vm.waiting = true;
    vm.onlineOrder.$changeCakeDeadline().then(() => {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.cancel = $modalInstance.dismiss;
}]);
"use strict";

angular.module('online-orders').controller('ModalConfirmInfoController', ['onlineOrder', 'OnlineOrders', '$modalInstance', 'FhdMessenger', 'UserPhotos', '$window', 'Authentication', function (onlineOrder, OnlineOrders, $modalInstance, FhdMessenger, UserPhotos, $window, Authentication) {
  const vm = this;
  vm.onlineOrder = onlineOrder;
  vm.user = Authentication.user;

  async function createConfirmInfoImage() {
    const dataUrl = await $window.domtoimage.toPng($window.document.getElementById('confirm-info'), {
      bgcolor: '#fff'
    });
    const resizePhoto = new UserPhotos({
      data: dataUrl,
      user: vm.user.username
    });
    const resizedPhoto = await resizePhoto.$resizeAndUpload();
    return _.get(_.head(resizedPhoto.uploadedImage), 'link');
  }

  vm.sendMessageToCustomer = async () => {
    vm.waiting = true;
    const onlineOrder = vm.onlineOrder;
    onlineOrder.confirmImageLink = await createConfirmInfoImage();
    const promise = OnlineOrders.sendConfirmMessageToCustomer(onlineOrder).$promise.then(() => {
      FhdMessenger.success('Gửi tin nhắn cho khách thành công.');
      $modalInstance.close();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang gửi tin nhắn cho khách...', promise);
  };

  vm.cancel = $modalInstance.dismiss;
}]);
"use strict";

