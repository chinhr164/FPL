angular.module('compare-money-transferred').controller('CompareMoneyTransferredController', ['FhdMessenger', '$http', 'MoneyEntryService', 'NgTableParams', function (FhdMessenger, $http, MoneyEntryService, NgTableParams) {
  const vm = this;
  vm.startDate = moment().subtract(1, 'week').startOf('week').format('YYYY-MM-DD');
  vm.endDate = moment().endOf('week').format('YYYY-MM-DD');
  vm.tableListMoneyEntries = new NgTableParams({
    count: 100
  });
  vm.tableListSaleReports = new NgTableParams({
    count: 100
  });
  vm.openViewMoneyEntryModal = MoneyEntryService.openViewMoneyEntryModal;

  vm.find = function () {
    $http.get('/compare-money-transferred', {
      params: {
        startDate: vm.startDate,
        endDate: vm.endDate,
        outlet: _.get(vm.outlet, '_id')
      }
    }).then(res => {
      var data = res.data;
      vm.totalMoneyTransferredAmount = data.totalMoneyTransferredAmount;
      vm.totalCashInSaleReports = data.totalCashInSaleReports;
      vm.compareMoneyTransferred = data.compareMoneyTransferred;

      _.forEach(data.moneyEntries, moneyEntry => {
        if (_.some(moneyEntry.saleReportDays, saleReport => {
          return !moment(saleReport.date).isBetween(moment(vm.startDate).startOf('day'), moment(vm.endDate).endOf('day'), null, '[]');
        })) {
          moneyEntry.wrongDate = true;
        }
      }); // _.forEach(data.moneyEntries, moneyEntry => {
      //   console.log(moneyEntry.wrongDate)
      // })


      vm.tableListMoneyEntries.settings({
        dataset: data.moneyEntries
      });
      vm.tableListSaleReports.settings({
        dataset: data.saleReports
      });
    });
  };
}]);
"use strict";

angular.module('competition-products').config(['$stateProvider', function ($stateProvider) {
  // CogsModifiers state routing
  $stateProvider.state('listCompetitionProducts', {
