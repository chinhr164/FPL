angular.module('competitors').controller('CompetitorsController', ['$scope', '$stateParams', '$location', 'Authentication', 'Competitors', function ($scope, $stateParams, $location, Authentication, Competitors) {
  const vm = this;
  vm.authentication = Authentication; // Create new Competitor

  vm.create = function () {
    // Create new Competitor object
    var competitor = new Competitors({
      name: vm.name
    }); // Redirect after save

    competitor.$save(function (response) {
      $location.path('competitors/' + response._id); // Clear form fields

      vm.name = '';
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Remove existing Competitor


  vm.remove = function (competitor) {
    if (competitor) {
      competitor.$remove();

      for (var i in vm.competitors) {
        if (vm.competitors[i] === competitor) {
          vm.competitors.splice(i, 1);
        }
      }
    } else {
      vm.competitor.$remove(function () {
        $location.path('competitors');
      });
    }
  }; // Update existing Competitor


  vm.update = function () {
    var competitor = vm.competitor;
    competitor.$update(function () {
      $location.path('competitors/' + competitor._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of Competitors


  vm.find = function () {
    vm.competitors = Competitors.query();
  }; // Find existing Competitor


  vm.findOne = function () {
    vm.competitor = Competitors.get({
      competitorId: $stateParams.competitorId
    });
  };
}]);
'use strict'; // Competitors service used to communicate Competitors REST endpoints

