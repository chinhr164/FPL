angular.module('core').factory('NumberService', ['FhdMessenger', function (FhdMessenger) {
  function numberWithCommas(x, round = true) {
    let y = x;
    if (round) y = Math.round(x);
    var parts = y.toString().split('.');
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return parts.join('.');
  } //


  function findLeastCommonDivisor(a, b) {
    if (!b) {
      return a;
    }

    return findLeastCommonDivisor(b, a % b);
  }

  return {
    numberWithCommas,
    findLeastCommonDivisor
  };
}]);
'use strict';

angular.module('core').factory('ObjectId', [function () {
  function getObjectId(obj) {
    if (!obj) return null;
    if (obj._id) return obj._id;
    if (obj.code === null || obj.code === 'Không' || obj.code === '') return null;
    if (obj.code) return obj.code;
    return obj;
  }

  function arrayWithObjectIds(array, path) {
    return _.map(array, function (item) {
      const newItem = _.clone(item);

      newItem[path] = getObjectId(newItem[path]);
      return newItem;
    });
  }

  return {
    getObjectId,
    arrayWithObjectIds,

    newObjectId() {
      const timestamp = (new Date().getTime() / 1000 | 0).toString(16);
      return timestamp + 'xxxxxxxxxxxxxxxx'.replace(/[x]/g, function () {
        return (Math.random() * 16 | 0).toString(16);
      }).toLowerCase();
    },

    getNewObjectWithObjectIds(properties, obj) {
      const newObj = _.reduce(properties, function (result, property) {
        if (obj[property]) {
          result[property] = getObjectId(obj[property]);
          return result;
        }

        return result;
      }, {});

      return _.assign({}, obj, newObj);
    },

    equals(a, b) {
      return getObjectId(a) === getObjectId(b);
    }

  };
}]);
"use strict";

angular.module('core').factory('OfflineMode', ['Sockets', '$window', '$rootScope', 'FhdMessenger', 'PreventUnsave', function (Sockets, $window, $rootScope, FhdMessenger, PreventUnsave) {
  const data = {
    offlineMode: false
  };

  function activateOfflineMode() {
    PreventUnsave.setPreventUnsave(true);
    FhdMessenger.error('Mất kết nối với server. Bạn đừng tắt trang này để có thể tiếp tục thanh toán nhé.');
    data.offlineMode = true;
  }

  function deactivateOfflineMode() {
    // FhdMessenger.success('Đã kết nối với server trở lại.')
    data.offlineMode = false;
    PreventUnsave.setPreventUnsave(false);
  }

  if (Sockets.noSocket) activateOfflineMode();
  Sockets.on('reconnect_error', function () {
    if (!data.offlineMode) {
      activateOfflineMode();
      $rootScope.$apply();
    }
  });
  Sockets.on('connect', function () {
    deactivateOfflineMode();
    $rootScope.$apply();
  });
  Sockets.on('disconnect', function (reason) {
    if (reason === 'io server disconnect') {
      Sockets.connect();
    }
  });
  return {
    activateOfflineMode,
    deactivateOfflineMode,
    getOfflineMode: () => data.offlineMode,
    offlineModeData: data
  };
}]);
"use strict";

angular.module('core').factory('PreventUnsave', ['$window', function ($window) {
  return {
    setPreventUnsave(value) {
      if (value) {
        $window.onbeforeunload = _.constant(true);
      } else {
        $window.onbeforeunload = null;
      }
    }

  };
}]);
