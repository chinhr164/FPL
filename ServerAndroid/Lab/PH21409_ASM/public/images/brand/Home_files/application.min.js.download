angular.module('users').filter('informationStatus', [function () {
  return function (input) {
    switch (input) {
      case 'unconfirmed':
        return 'Chưa xác thực';

      case 'waiting':
        return 'Chờ duyệt';

      case 'done':
        return 'Xác thực';

      default:
        return input;
    }
  };
}]);
