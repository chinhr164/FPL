angular.module('sale-entries').factory('SaleEntryService', ['$modal', '$http', function ($modal, $http) {
  function canUpdateReturnItems(user) {
    return _.intersection(_.get(user, 'roles', []), ['superadmin', 'admin', 'sale-entry:edit-payment']).length;
  }

  return {
    confirmHideSaleEntry(saleEntry) {
      return $modal.open({
        templateUrl: '/modules/sale-entries/views/modal-confirm-hide-sale-entry.client.view.html',
        controller: 'ModalConfirmHideSaleEntryController',
        controllerAs: 'vm',
        resolve: {
          saleEntry() {
            return saleEntry;
          }

        }
      });
    },

    addCustomerToSaleEntry(saleEntry) {
      return $modal.open({
        templateUrl: '/modules/sale-entries/views/modal-add-customer-to-sale-entry.client.view.html',
        controller: 'ModalAddCustomerToSaleEntryController',
        controllerAs: 'vm',
        resolve: {
          saleEntry() {
            return saleEntry;
          }

        }
      });
    },

    inputPermissionReturnItems(saleEntry) {
      return $modal.open({
        templateUrl: '/modules/sale-entries/views/modal-update-permission-return-items.client.view.html',
        controller: 'ModalUpdatePermissionReturnItemsController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          saleEntry() {
            return saleEntry;
          }

        }
      });
    },

    viewSaleEntry(saleEntryId) {
      return $modal.open({
        templateUrl: '/modules/sale-entries/views/modal-view-sale-entry.client.view.html',
        controller: 'ModalViewSaleEntryController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          saleEntryId: () => saleEntryId
        }
      });
    },

    openChooseMooncakeGiftModal(avaiableGifts) {
      return $modal.open({
        templateUrl: '/modules/sale-entries/views/modal-choose-mooncake-gifts.client.view.html',
        controller: 'ModalChooseMooncakeGiftsController',
        controllerAs: 'vm',
        resolve: {
          avaiableGifts: () => avaiableGifts
        }
      });
    },

    openAddBillNumberModal(saleEntry) {
      return $modal.open({
        templateUrl: 'modules/sale-entries/views/modal-add-bill-number.client.view.html',
        controller: 'ModalAddBillNumberForSaleEntryController',
        controllerAs: 'vm',
        resolve: {
          saleEntry: () => saleEntry
        }
      });
    },

    getIsWholesale(item, defaultValue) {
      if (item.classificationStrategy === 'always-wholesale') return true;
      if (item.classificationStrategy === 'always-retail') return false;
      return defaultValue || false;
    },

    openReturnItemsModal() {
      return $modal.open({
        templateUrl: '/modules/sale-entries/views/modal-return-items.client.view.html',
        controller: 'ModalReturnItemsController',
        controllerAs: 'vm',
        windowClass: 'cy-modal-add-return-items'
      }).result;
    },

    viewListVouchers(cellphone) {
      return $modal.open({
        templateUrl: '/modules/sale-entries/views/modal-list-vouchers.client.view.html',
        controller: 'ModalListVouchersController',
        controllerAs: 'vm',
        resolve: {
          cellphone: () => cellphone
        }
      });
    },

    openDeleteSaleEntryModal(saleEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalDeleteSaleEntryController',
        controllerAs: 'vm',
        templateUrl: 'modules/sale-entries/views/modal-delete-sale-entry.client.view.html',
        resolve: {
          saleEntryId() {
            return saleEntry._id;
          }

        }
      }).result;
    },

    openAddPaymentSaleEntryModal(saleEntry, customerRequest, editPaymentMethod) {
      return $modal.open({
        animation: true,
        controller: 'ModalAddPaymentSaleEntryController',
        controllerAs: 'vm',
        templateUrl: 'modules/sale-entries/views/modal-add-payment.client.view.html',
        size: 'lg',
        resolve: {
          saleEntry() {
            return saleEntry;
          },

          customerRequest() {
            return customerRequest;
          },

          editPaymentMethod() {
            return editPaymentMethod;
          }

        }
      }).result;
    },

    openFindCustomerRequestModal(outlet) {
      return $modal.open({
        animation: true,
        controller: 'ModalFindCustomerRequestController',
        controllerAs: 'vm',
        templateUrl: 'modules/sale-entries/views/modal-find-customer-request.client.view.html',
        size: 'md',
        resolve: {
          Outlet() {
            return outlet;
          }

        }
      }).result;
    },

    searchSaleEntry: saleEntryId => $http.get('/api/sale-entries/search-sale-entry', {
      params: {
        saleEntryId
      }
    }).then(response => response.data),
    canUpdateReturnItems: canUpdateReturnItems,

    getContentButtonUpdateReturnItem(user) {
      if (canUpdateReturnItems(user)) {
        return 'Cập nhật đổi trả';
      }

      return 'Gửi yêu cầu đổi trả';
    }

  };
}]);
