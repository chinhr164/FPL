angular.module('vendors').controller('ModalCreateVendorController', ['Vendors', '$modalInstance', 'FhdMessenger', function (Vendors, $modalInstance, FhdMessenger) {
  const vm = this;

  vm.create = () => {
    if (!_.get(vm, 'vendor.name')) {
      return FhdMessenger.error('Chưa nhập tên công ty');
    }

    if (!_.get(vm, 'vendor.code')) {
      return FhdMessenger.error('Chưa nhập mã công ty');
    }

    if (!_.get(vm, 'vendor.country')) {
      return FhdMessenger.error('Chưa chọn quốc gia');
    }

    const vendor = new Vendors(vm.vendor);

    if (vendor.country === 'Việt Nam') {
      vendor.pilot = true;
    }

    vendor.$save().then(vendor => {
      $modalInstance.close(vendor);
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.dismiss = () => {
    $modalInstance.dismiss();
  };
}]);
"use strict";

angular.module('vendors').controller('ModalViewVendorBackupsController', ['$modalInstance', 'vendor', function ($modalInstance, vendor) {
  const vm = this;
  vm.vendor = vendor;

  vm.closeModal = () => $modalInstance.dismiss();
}]);
