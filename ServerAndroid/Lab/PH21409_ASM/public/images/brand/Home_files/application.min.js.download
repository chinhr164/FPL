function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('products').factory('CalculateService', ['FhdMessenger', 'BundlePricesService', 'PromotionService', 'SaleCampaignService', 'ProductService', '$http', function (FhdMessenger, BundlePricesService, PromotionService, SaleCampaignService, ProductService, $http) {
  const getOutletProperty = ProductService.getOutletProperty;

  function calculate({
    items,
    assignedOutlet,
    source,
    voucher,
    isCakeOrder,
    saleCampaigns,
    orderValue,
    businessCustomer,
    specialPrice,
    deadline,
    deliverStartTime,
    isStaff
  }) {
    const region = _.get(assignedOutlet, 'region', 'NORTH');

    const lunarCatName = 'Bánh kẹo Tết';
    const valentineCatName = 'Valentine';

    function isDiscountCat(category) {
      return [lunarCatName, valentineCatName].includes(category);
    }

    const totalLunarNewYearItemQuantity = _.sumBy(items, item => {
      if (_.get(item, 'category.cat.name') === lunarCatName && item.description.includes('1kg')) {
        return item.quantity;
      }

      return 0;
    });

    let availableDiscount = 0;

    if (isStaff && moment().isBefore('2023-02-13') && _.some(items, item => {
      return isDiscountCat(_.get(item, 'category.cat.name'));
    })) {
      availableDiscount = 500000;
    }

    const jarSkus = PromotionService.getJarSkus();

    const totalJarItemValue = _.sumBy(items, item => {
      if (jarSkus.includes(item.sku)) {
        return item.price * item.quantity;
      }

      return 0;
    });

    _.forEach(items, item => {
      if (item.addGiftItem || item.toLock) return;
      if (item.isShockSale) return;
      if (item.quantity < 0) item.quantity = -item.quantity;
      let salePrice = getOutletProperty('salePrice', assignedOutlet, item, source);
      const price = getOutletProperty('price', assignedOutlet, item, source);

      if (salePrice > price) {
        salePrice = null;
      }

      item.soldPrice = salePrice || price;
      item.onSale = salePrice && salePrice < price;
      const bundlePrices = BundlePricesService.getBundlePrices(item, region, null, source);

      if (bundlePrices.length) {
        const matchBundlePrices = _.filter(bundlePrices, bundlePrice => {
          if (jarSkus.includes(item.sku)) {
            return totalJarItemValue >= bundlePrice.value;
          }

          if (_.get(item, 'category.cat.name') === lunarCatName && item.description.includes('1kg')) {
            return totalLunarNewYearItemQuantity >= bundlePrice.quantity;
          }

          return item.quantity >= bundlePrice.quantity;
        });

        if (_.get(matchBundlePrices, 'length')) {
          const matchBundlePrice = _.minBy(matchBundlePrices, 'price');

          item.wholesalePrice = matchBundlePrice.price;

          if (item.wholesalePrice < (item.specialPrice || item.soldPrice)) {
            item.soldPrice = item.wholesalePrice;
            item.noLoyalty = true;
          }
        }
      }

      if (item.businessSoldPrice) {
        if (item.soldPrice > item.businessSoldPrice) {
          item.soldPrice = item.businessSoldPrice;
        }
      }

      if (item.specialPrice > 0 && item.specialPrice < item.soldPrice) {
        item.soldPrice = item.specialPrice;
      }

      if (_.isFinite(item.maxQuantityPerOnlineOrder) && item.maxQuantityPerOnlineOrder > 0 && item.quantity > item.maxQuantityPerOnlineOrder) {
        FhdMessenger.error(`Sản phẩm ${item.description} bán tối đa số lượng là ${item.maxQuantityPerOnlineOrder}.`);
        item.quantity = item.maxQuantityPerOnlineOrder;
      }

      if (isDiscountCat(_.get(item, 'category.cat.name'))) {
        const discount = Math.min(item.price * 0.3 * item.quantity, availableDiscount);

        if (discount > 0) {
          item.soldPrice = (item.price * item.quantity - discount) / item.quantity;
          availableDiscount -= discount;
          item.onSale = true;
        }
      }

      if (item.hasSaltedEgg) {
        item.soldPrice += 10000;
      }
    });

    _.forEach(items, item => {
      item.lineTotal = item.soldPrice * item.quantity;
    });

    items = PromotionService.processMoonCakeDiscount(items, isStaff);

    if (isCakeOrder) {
      items = PromotionService.getSpecialDayPromotion(items, deadline);
      items = PromotionService.processPromotionLunarNewYear(items);
      items = PromotionService.getDiscountAlmostExpiredCake({
        items,
        deadline,
        deliverStartTime
      });
    }

    SaleCampaignService.processSaleCampaigns(items, saleCampaigns); // // Sale shock price handling

    let numShockPriceItems = 0;
    let shockPriceMessage = ''; // if (_.get(customer, 'customerId', '').match(/^C\w\d{7}/)) {

    const shockSale = PromotionService.processShockSalePrice(items);
    items = shockSale.shockPriceItems;
    numShockPriceItems = shockSale.numShockPriceItems;
    shockPriceMessage = shockSale.shockPriceMessage; // }

    const {
      monthlyShockPriceItems
    } = PromotionService.processMonthlyShockSalePrice(items, assignedOutlet);
    items = monthlyShockPriceItems; // End sale shock price handling

    let subTotal = 0;

    _.forEach(items, item => {
      item.lineTotal = item.soldPrice * item.quantity - _.get(item, 'discount', 0);

      if (specialPrice && specialPrice[item.sku]) {
        item.businessSoldPrice = specialPrice[item.sku].expectPrice;
        item.specialPriceEntry = specialPrice[item.sku]._id;

        if (businessCustomer) {
          item.lineTotal = item.businessSoldPrice * item.quantity - _.get(item, 'discount', 0);
        }
      }

      subTotal += item.lineTotal;
    });

    orderValue = subTotal - _.get(voucher, 'quantity', 0);
    return {
      items,
      numShockPriceItems,
      shockPriceMessage,
      orderValue
    };
  }

  function addProduct({
    inputItem,
    items,
    assignedOutlet,
    source,
    addIndex
  }) {
    const currentItems = _.cloneDeep(items || []);

    const matchItemIndex = _.findIndex(currentItems, currentItem => {
      const currentSku = currentItem.sku;

      if (inputItem.uid || currentItem.uid) {
        return currentItem.uid === inputItem.uid && currentSku === inputItem.sku;
      }

      if (inputItem.parentUid || currentItem.uid) {
        return currentItem.parentUid === inputItem.parentUid && currentSku === inputItem.sku;
      }

      if (currentItem.cakeFillingType) {
        return currentItem.cakeFillingType === inputItem.cakeFillingType && currentSku === inputItem.sku;
      }

      if (currentItem.refId) {
        return currentItem.refId === inputItem.refId || currentItem.refId === inputItem.sku;
      }

      return currentSku === inputItem.sku;
    });

    if (matchItemIndex > -1 && !currentItems[matchItemIndex].toLock && !currentItems[matchItemIndex].addGiftItem) {
      if (inputItem.quantityFromBarcode) {
        currentItems[matchItemIndex].quantity += inputItem.quantity;
      } else if (inputItem.needQuantity) {
        currentItems[matchItemIndex].quantity = 0;
      } else {
        currentItems[matchItemIndex].quantity += 1;
      }
    } else {
      let salePrice = getOutletProperty('salePrice', assignedOutlet, inputItem, source);
      const price = getOutletProperty('price', assignedOutlet, inputItem, source);

      if (salePrice > price) {
        salePrice = null;
      }

      const newItem = _objectSpread({}, inputItem, {
        salePrice,
        price,
        originalPrice: price
      });

      if (addIndex > -1) {
        currentItems.splice(addIndex, 0, newItem);
      } else {
        currentItems.push(newItem);
      }
    }

    return currentItems;
  }

  function getSpecialPrice(businessCustomer) {
    return $http.get(`/business-customers/${businessCustomer._id}/special-price-entries`).then(res => {
      return _.reduce(res.data, (result, specialPriceEntry) => {
        _.forEach(specialPriceEntry.items, item => {
          result[item.sku] = item;
        });

        return result;
      }, {});
    });
  }

  function calculateWeight(order) {
    const {
      length,
      width,
      height
    } = _.get(order, 'shipping.dimensions');

    const weight = _.get(order, 'shipping.weight');

    if (!length || !width || !height || !weight) {
      FhdMessenger.error('Chưa điền đủ dữ liệu để tính trọng lượng khai báo.');
      return;
    }

    const volumeWeight = length * width * height / 4;
    let candidateWeight = 0;

    if (volumeWeight < 2000) {
      if (Math.min(weight, volumeWeight) + 200 > Math.max(weight, volumeWeight)) {
        candidateWeight = Math.max(weight, volumeWeight);
      } else {
        candidateWeight = Math.min(weight, volumeWeight) + 200;
      }
    } else if (Math.max(weight, volumeWeight) > 4000) {
      candidateWeight = Math.max(weight, volumeWeight) - 500;
    } else {
      candidateWeight = Math.floor(Math.max(weight, volumeWeight) / 1000) * 1000 - _.random(50, 250);
    }

    return Math.max(candidateWeight, weight);
  }

  return {
    calculate,
    addProduct,
    getSpecialPrice,
    calculateWeight
  };
}]);
'use strict';

angular.module('products').factory('PlProductService', ['Products', function (Products) {
  const convertProductsToText = function (products) {
    const length = _.get(products, 'length', 0);

    return _.reduce(products, (result, product, index) => {
      // eslint-disable-next-line camelcase
      const sku = product.sku;
      const description = product.description; // eslint-disable-next-line camelcase

      if (length > 1) {
        result += `${index + 1}. `;
      }

      result += `${sku || ''} - ${description}`;

      if (product.quantity) {
        result += ` x ${product.quantity}`;
      }

      if (length > 1) {
        result += '<br>';

        if (index < length) {
          result += '<br>';
        }
      }

      return result;
    }, '');
  };

  return {
    convertProductsToText
  };
}]);
'use strict';

angular.module('products').factory('ProductService', ['helper', 'Products', '$modal', '$http', 'BundlePricesService', 'FhdMessenger', 'ngDexie', '$rootScope', 'ngStore', '$interval', '$q', function (helper, Products, $modal, $http, BundlePricesService, FhdMessenger, ngDexie, $rootScope, ngStore, $interval, $q) {
  let initialSync = null;
  let loadEssentialProducts = null;
  let loadAllProducts = null;
  let essentialsQuery;
  let availablesQuery;
  let includeDeletedQuery; // Sync products client với server
  // Dùng 3 biến productsUpdated, loadedProducts, loadedEssentialProducts lưu ở
  // localStorage để quyết định xem có gửi lệnh lấy sản phẩm mới update không.
  // Nếu đã từng load full DSSP thì (như ở list-products) loadedProducts được set là true
  // Nếu đã từng load DSSP hàng bán (như ở phần create-sale-entry) thì loadedEssentialProducts được set là true
  // Dù là load kiểu gì thì sau khi load xong sản phẩm từ server sẽ đánh dấu lại thời điểm load
  // vào loadedProducts (ở dạng unix. VD: 1559298899343)

  const syncProductsFromServer = () => {
    const localProductsUpdated = ngStore.get('productsUpdated');
    const loadedProducts = ngStore.get('loadedProducts');
    const loadedEssentialProducts = ngStore.get('loadedEssentialProducts');
    let productsUpdated = localProductsUpdated && moment(localProductsUpdated).isValid() ? moment(localProductsUpdated).valueOf() : null; // Chỉ khi nào đã load DSSP (1 trong 2 kiểu) và có dữ liệu thời điểm load DSSP rõ ràng
    // thì mới gửi lệnh lên server để kiểm tra từ thời điểm load DSSP đến hiện tại có thêm
    // sản phẩm nào thay đổi hay không.
    // Trường hợp không gửi lệnh lên server thì đảm bảo là dữ liệu clean bằng cách xóa toàn bộ
    // các dữ liệu cũ đi. Lần tới tải lại trang web các hàm essentialProductsAsync() và allAsync()
    // ở dưới chắc chắn sẽ gọi lên server để lấy dữ liệu và update lại.

    if (!loadedProducts && !loadedEssentialProducts || !_.isNumber(productsUpdated)) {
      clearLocalSettings();
      return $q.when(null); // Lưu ý hàm này luôn trả về 1 promise để còn .then được dù thế nào đi chăng nữa
    }

    return Products.getUpdatedProducts({
      date: productsUpdated
    }).$promise.then(products => {
      const promises = [];

      if (products && products.length) {
        FhdMessenger.success(`Cập nhật thành công ${products.length} sản phẩm từ máy chủ!`); // Để tránh code trùng lặp thì chỉ có 1 end point duy nhất để lấy sản phẩm mới cập nhật
        // nên dữ liệu trả về luôn là full danh sách (bao gồm hàng essential và các hàng khác).
        // Vì thế có bước lọc này để chỉ update các sản phẩm bán (toSell là true) vào essentialProducts

        if (loadedEssentialProducts) {
          const _essentialProducts = _.filter(products, {
            toSell: true,
            deleted: false
          });

          if (_essentialProducts && _essentialProducts.length) {
            promises.push(ngDexie.getDb().essentialProducts.bulkPut(_essentialProducts).then(() => {
              $rootScope.$apply();
              $rootScope.$broadcast('essentialProductsUpdated', _essentialProducts);
            }));
          }
        } // Đoạn này để phát hiện các sản phẩm mới bị xóa (soft delete) ở trên server
        // và xóa trong 2 db ở client. Sản phẩm trên server bị xóa thì có trường deleted là true


        const deletedProducts = _.filter(products, {
          deleted: true
        });

        if (deletedProducts && deletedProducts.length) {
          const deletedIds = _.map(deletedProducts, '_id');

          promises.push(ngDexie.getDb().products.bulkDelete(deletedIds), ngDexie.getDb().essentialProducts.bulkDelete(deletedIds));
        }

        if (loadedProducts) {
          promises.push(ngDexie.getDb().products.bulkPut(_.filter(products, {
            deleted: false
          })).then(() => {
            $rootScope.$apply();
            $rootScope.$broadcast('productsUpdated', products);
          }));
        }

        saveMaxUnixUpdated(products);
      }

      return $q.all(promises);
    }).catch(() => {
      // Cứ có lỗi thì đảm bảo dữ liệu clean và bắt buộc các hàm load allAsync() và essentialProductsAsync()
      // sẽ gọi dữ liệu từ server
      FhdMessenger.error('Có lỗi khi tải DSSP cập nhật. Sẽ tải lại từ đầu.'); // Tạm bỏ phần clear databsae khi có lỗi
      // clearLocalSettings()
    });
  };

  function clearLocalSettings(all) {
    ngStore.remove('productsUpdated');
    ngStore.remove('products');
    ngStore.remove('loadedEssentialProducts');
    ngStore.remove('loadedProducts');

    if (all) {
      if (ngDexie.getDb().essentialProducts) {
        ngDexie.getDb().essentialProducts.clear();
      }

      if (ngDexie.getDb().products) {
        ngDexie.getDb().products.clear();
      }
    }
  }

  function initInitialSync() {
    if (!initialSync) {
      initialSync = syncProductsFromServer();
    }

    return initialSync;
  } // Có thể đặt giờ tự động để load sản phẩm và update tại đây
  // cơ mà risk khả năng 2 cửa sổ cùng mở 1 lúc và 1 cửa sổ sẽ
  // không được update nên chưa áp dụng vào thực tế
  //
  // $interval(syncProductsFromServer, 1000 * 10)
  // Lấy thời điểm sản phẩm được update gần đây nhất, tối đa là thời điểm hiện tại


  function saveMaxUnixUpdated(products) {
    const maxUnixUpdated = Math.min(Math.max(..._.map(products, product => {
      const value = product.unixUpdated && moment(product.unixUpdated).isValid() ? moment(product.unixUpdated).valueOf() : null;
      return value;
    })), moment().valueOf());

    if (products && products.length && moment(maxUnixUpdated).isValid()) {
      ngStore.set('productsUpdated', maxUnixUpdated);
    }
  }

  function getAllProducts() {
    return Products.availables().$promise.then(products => {
      saveMaxUnixUpdated(products);
      return ngDexie.getDb().products.clear().then(() => ngDexie.getDb().products.bulkAdd(products)).then(() => {
        ngStore.set('loadedProducts', true);
        $rootScope.$apply();
        return products;
      }).catch(err => {
        FhdMessenger.error(err.message);
        throw err;
      });
    });
  }

  function getOutletProperty(prop, outlet, item, source) {
    const outletCode = _.get(outlet, 'code', '');

    const region = _.get(outlet, 'region', '');

    if (['tiktok', 'shopee'].includes(source)) {
      const matchRegionAttribute = _.find(item.regionAttributes, {
        region
      });

      if (matchRegionAttribute) {
        if (prop === 'price' && matchRegionAttribute.shopeePrice) {
          return matchRegionAttribute.shopeePrice;
        }

        if (prop === 'salePrice' && matchRegionAttribute.shopeeSalePrice) {
          return matchRegionAttribute.shopeeSalePrice;
        }
      }

      if (prop === 'price' && item.shopeePrice) {
        return item.shopeePrice;
      }

      if (prop === 'salePrice' && item.shopeeSalePrice) {
        return item.shopeeSalePrice;
      }
    }

    if (item.outletAttributeMap) {
      const matchProp = _.get(item.outletAttributeMap, `${outletCode}.${prop}`);

      if (matchProp) {
        return matchProp;
      }
    }

    const getOutletAttribute = _.find(item.outletAttributes, {
      outletCode
    });

    if (_.get(getOutletAttribute, prop)) {
      return _.get(getOutletAttribute, prop);
    }

    const matchRegionAttribute = _.find(item.regionAttributes, {
      region
    });

    if (_.get(matchRegionAttribute, prop)) {
      return _.get(matchRegionAttribute, prop);
    }

    return _.get(item, prop);
  }

  function getSoldPrice(product, outlet) {
    let soldPrice;
    const salePrice = getOutletProperty('salePrice', outlet, product);
    const price = getOutletProperty('price', outlet, product);
    soldPrice = Math.min(salePrice || Infinity, price);
    return soldPrice;
  }

  function getEssentialProducts() {
    return Products.essentials().$promise.then(products => {
      saveMaxUnixUpdated(products);
      return ngDexie.getDb().essentialProducts.clear().then(() => ngDexie.getDb().essentialProducts.bulkAdd(products)).then(() => {
        ngStore.set('loadedEssentialProducts', true);
        $rootScope.$apply();
        return products;
      }).catch(err => {
        FhdMessenger.error(err.message);
        throw err;
      });
    });
  }

  function sortProducts(products) {
    return products.sort((a, b) => {
      return a.sku > b.sku ? 1 : -1;
    });
  }

  function allAsync() {
    function getProductsAndNotify() {
      FhdMessenger.info('Bắt đầu tải Full DSSP từ máy chủ và lưu vào bộ nhớ. Xin vui lòng đợi trong giây lát...');
      return getAllProducts().then(products => {
        FhdMessenger.success('Tải xong Full DSSP từ máy chủ');
        return products;
      });
    }

    if (!loadAllProducts) {
      loadAllProducts = initInitialSync().then(() => {
        const productsUpdated = ngStore.get('productsUpdated');
        const loadedProducts = ngStore.get('loadedProducts');

        if (!_.isNumber(productsUpdated) || !loadedProducts) {
          return getProductsAndNotify();
        }

        return ngDexie.list('products').then(products => {
          if (!products || !products.length) {
            return getProductsAndNotify();
          } else {
            FhdMessenger.success('Tải xong Full DSSP từ bộ nhớ');
            return products;
          }
        });
      }).then(sortProducts);
    }

    return loadAllProducts;
  }

  function essentialProductsAsync() {
    function getProductsAndNotify() {
      FhdMessenger.info('Bắt đầu tải DSSP bán hàng từ máy chủ và lưu vào bộ nhớ. Xin vùi lòng đợi trong giây lát...');
      return getEssentialProducts().then(products => {
        FhdMessenger.success('Tải xong DSSP bán hàng từ máy chủ');
        return products;
      });
    }

    if (!loadEssentialProducts) {
      loadEssentialProducts = initInitialSync().then(() => {
        const productsUpdated = ngStore.get('productsUpdated');
        const loadedProducts = ngStore.get('loadedEssentialProducts');

        if (!_.isNumber(productsUpdated) || !loadedProducts) {
          return getProductsAndNotify();
        }

        return ngDexie.list('essentialProducts').then(products => {
          if (!products || !products.length) {
            return getProductsAndNotify();
          }

          FhdMessenger.success('Tải xong DSSP bán hàng từ bộ nhớ');
          return products;
        });
      }).then(sortProducts);
    }

    return loadEssentialProducts;
  }

  function isFoodProduct(product) {
    return _.get(product, 'category.department.name', '') === 'Nguyên liệu làm bánh' || _.get(product, 'category.group.name', '') === 'FOOD';
  }

  function isFacility(product) {
    return ['CCDC - CS', 'TSCĐHH - TBDC', 'TSCĐHH - MMTB'].includes(product.savorTag);
  }

  function isFrozenProduct(warehouseGroup) {
    return ['Tủ đông', 'Tủ mát'].includes(_.get(warehouseGroup, 'name'));
  }

  return {
    isFacility,
    isFoodProduct,
    isFrozenProduct,
    clearLocalSettings,
    allAsync,
    essentialProductsAsync,

    getAllProductsFromServer() {
      if (!availablesQuery) {
        availablesQuery = Products.availables();
      }

      return availablesQuery.$promise.then(products => {
        return products;
      });
    },

    getIncludeDeletedProductsFromServer() {
      if (!includeDeletedQuery) {
        includeDeletedQuery = Products.includeDeleted();
      }

      return includeDeletedQuery.$promise.then(products => {
        return products;
      });
    },

    getAllSellingProductsFromServer() {
      if (!essentialsQuery) {
        essentialsQuery = Products.essentials();
      }

      return essentialsQuery.$promise.then(products => {
        return products;
      });
    },

    getProductWithSpecialSku() {
      return Products.getProductWithSpecialSku().$promise.then(products => {
        return products;
      });
    },

    getAllProductsTagsFromServer() {
      return Products.getAllProductsTags().$promise.then(tags => {
        return _.map(tags, tag => ({
          id: tag,
          title: tag
        }));
      });
    },

    getAllProductsTags() {
      return ngDexie.list('essentialProducts').then(products => {
        const allProductTags = [];

        _.forEach(products, product => {
          const productTags = _.get(product, 'tag', '').split(', ');

          allProductTags.push(...productTags);
        });

        const tags = allProductTags.sort((a, b) => a.localeCompare(b));
        return tags;
      }).then(allProductTags => {
        return _.map(_.uniq(_.compact(allProductTags)), productTag => ({
          id: productTag,
          title: productTag
        }));
      });
    },

    fullDescriptionAsync() {
      return allAsync().then(products => {
        return _.filter(products, {
          toSell: true
        });
      });
    },

    listConvertProducts() {
      return $http.get('/products/get-convert-products').then(response => response.data);
    },

    quickEditProduct(product, openTab) {
      return $modal.open({
        templateUrl: '/modules/products/views/modal-quick-edit-product.client.view.html',
        controller: 'ModalQuickEditProductController',
        controllerAs: 'vm',
        size: 'lg',
        windowClass: 'modal-quick-edit-product',
        backdrop: 'static',
        resolve: {
          product() {
            return product;
          },

          openTab: () => openTab
        }
      }).result;
    },

    createProductModal() {
      return $modal.open({
        templateUrl: '/modules/products/templates/modal-create-product-client-template.html',
        controller: 'ModalCreateProductController',
        size: 'lg',
        backdrop: 'static',
        controllerAs: 'vm'
      });
    },

    quickEditProductAttributes(product) {
      return $modal.open({
        templateUrl: '/modules/products/views/modal-quick-edit-product-attributes.client.view.html',
        controller: 'ModalQuickEditProductAttributesController',
        controllerAs: 'vm',
        size: 'lg',
        backdrop: 'static',
        resolve: {
          product() {
            return product;
          }

        }
      }).result;
    },

    editBuyerInfo(product) {
      return $modal.open({
        templateUrl: '/modules/products/views/modal-edit-buyer-info.client.view.html',
        controller: 'ModalEditProductController',
        controllerAs: 'vm',
        backdrop: 'static',
        resolve: {
          product() {
            return product;
          },

          role: _.constant('buyer')
        }
      });
    },

    editInfoInfo(product) {
      return $modal.open({
        templateUrl: '/modules/products/views/modal-edit-info-info.client.view.html',
        controller: 'ModalEditProductController',
        controllerAs: 'vm',
        backdrop: 'static',
        resolve: {
