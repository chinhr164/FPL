angular.module('facility-types').controller('FacilityTypeController', ['$stateParams', '$location', '$scope', 'Authentication', 'FacilityService', 'FacilityTypes', 'FacilityTypeService', 'FhdMessenger', 'NgTableParams', 'ObjectId', function ($stateParams, $location, $scope, Authentication, FacilityService, FacilityTypes, FacilityTypeService, FhdMessenger, NgTableParams, ObjectId) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.facilityType = {};
  vm.groups = FacilityService.getGroups();

  vm.create = function () {
    const error = FacilityTypeService.validate(vm.facilityType);

    if (error) {
      return FhdMessenger.error(error);
    }

    const facilityType = new FacilityTypes(vm.facilityType);
    vm.waiting = true;
    facilityType.$save().then(() => {
      FhdMessenger.success('Tạo Facility Type thành công');
      vm.facilityType = {};
      $location.path('facility-types');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.facilityTypesTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    FacilityTypes.query().$promise.then(facilityTypes => {
      vm.facilityTypes = facilityTypes;
      vm.facilityTypesTable.settings({
        dataset: vm.facilityTypes
      });
    });
  };

  vm.findOne = async () => {
    vm.facilityType = FacilityTypes.get({
      facilityTypeId: $stateParams.facilityTypeId
    }).$promise.then(facilityType => {
      vm.facilityType = facilityType;
    });
  };

  vm.update = () => {
    vm.waiting = true;
    vm.facilityType.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('facility-types');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('facility-types').factory('FacilityTypeService', ['$resource', 'FacilityTypes', function ($resource, FacilityTypes) {
  let facilityTypes;

  function getFacilityTypes() {
    if (!facilityTypes) facilityTypes = FacilityTypes.query();
    return facilityTypes.$promise;
  }

  function validate(facilityType) {
    if (!facilityType.name) {
      return 'Bạn chưa điền tên';
    }

    if (!facilityType.code) {
      return 'Bạn chưa điền code';
    }

    if (!facilityType.group) {
      return 'Bạn chưa điền nhóm';
    }

    return false;
  }

  return {
    getFacilityTypes,
    validate
  };
}]);
"use strict";

