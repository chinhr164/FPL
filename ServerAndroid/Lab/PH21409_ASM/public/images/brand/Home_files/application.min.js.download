angular.module('core').factory('geolocationSvc', ['$q', '$window', function ($q, $window) {
  function getCurrentPosition() {
    var deferred = $q.defer();

    if (!$window.navigator.geolocation) {
      deferred.resolve({
        message: 'Geolocation not supported.'
      });
    } else {
      $window.navigator.geolocation.getCurrentPosition(function (position) {
        deferred.resolve(position);
      }, function (err) {
        deferred.resolve(err);
      });
    }

    return deferred.promise;
  }

  return {
    getCurrentPosition: getCurrentPosition
  };
}]);
'use strict';

angular.module('core').factory('helper', ['FhdMessenger', 'ObjectId', function (FhdMessenger, ObjectId) {
  function combineTimeAndDate(date, time) {
    const hour = moment(time).hour();
    const minute = moment(time).minute();
    return moment(date).set({
      hour,
      minute
    });
  }

  function sortByProperty(array = [], property = '') {
    return [...array].sort((a, b) => {
      let defaultFirstValue = '';
      let defaultSecondtValue = '';

      if (!_.isObject(a) && !_.isArray(b)) {
        defaultFirstValue = a;
        defaultSecondtValue = b;
      }

      return _.get(a, property, defaultFirstValue).localeCompare(_.get(b, property, defaultSecondtValue), undefined, {
        numeric: true,
        sensitivity: 'base'
      });
    });
  }

  function isAllValidField(items, field) {
    return _.some(items, item => {
      return !_.get(item, field);
    });
  }

  function sortObjectByKey(object) {
    return sortByProperty(Object.keys(object)).reduce(function (result, key) {
      result[key] = object[key];
      return result;
    }, {});
  }

  function removeValueFromArray(array, index) {
    array.splice(index, 1);
  }

  function createListFibonacci(max) {
    let fibonacci = [0, 1];

    for (let i = 1; i < max; i++) {
      fibonacci.push(fibonacci[i] + fibonacci[i - 1]);
    }

    return fibonacci.join(', ');
  }

  function addDecimalNumber(a, b) {
    return (Math.round(a * 100) + Math.round(b * 100)) / 100;
  }

  function convertObjectToText(object, keys, separator) {
    return _.reduce(keys, (result, key) => {
      const value = _.get(object, key);

      if (!value) {
        return result;
      }

      result.push(value);
      return result;
    }, []).join(separator);
  }

  function isProbationShift(positions = []) {
    if (_.intersection(['PROBATION_A', 'PROBATION_B', 'TRAINING'], positions).length) {
      return true;
    }

    return false;
  }

  function formatWeek(date, format = 'month') {
    let week = '';

    switch (format) {
      case 'year':
        {
          week = moment(date).format('W');
          break;
        }

      default:
        {
          week = Math.ceil(moment(date).date() / 7);
        }
    }

    return `W${week}`;
  }

  const makeMap = (items, keyPath) => {
    if (_.isUndefined(keyPath)) throw new Error('`keyPath` for `makeMap` was not provided!');
    return _.reduce(items, (result, item) => {
      const attr = _.get(item, keyPath);

      let key = attr;

      if (_.isFunction(attr)) {
        key = _.invokeMap(item, keyPath);
      }

      if (_.isUndefined(key)) throw new Error(`Không tìm thấy key cho ${item}`);
      result[key] = item;
      return result;
    }, {});
  };

  const addLeadZero = (number, size) => {
    if (!_.isNumber(number) || !_.isNumber(size)) return null;
    const missingZerosLength = size - number.toString().length;
    return _.repeat('0', missingZerosLength) + number.toString();
  };

  function sumObjectProperty(firstObj, secondObj) {
    const totalKeys = _.uniq([..._.keys(firstObj), ..._.keys(secondObj)]);

    const result = _.reduce(totalKeys, (result, key) => {
      let defaultValue = 0;

      if (_.isString(_.get(firstObj, key)) || _.isString(_.get(secondObj, key))) {
        defaultValue = '';
      }

      result[key] = _.get(firstObj, key, defaultValue) + _.get(secondObj, key, defaultValue);
      return result;
    }, {});

    return result;
  }

  function getRegionName(region) {
    if (region === 'SOUTH') {
      return 'Nam';
    }

    if (region === 'NORTH') {
      return 'Bắc';
    }

    if (region === 'CENTRAL') {
      return 'Trung';
    }

    return region;
  }

  const hasRoles = function (myRoles, roles) {
    return _.intersection(roles, myRoles).length;
  };

  const joinArrayWithProperties = function (array, properties, separator) {
    const cloneArray = [...array];
    return _.map(cloneArray, ele => {
      return convertObjectToText(ele, properties, separator);
    }).join(', ');
  };

  const minutesOfDay = function (m) {
    return +moment(m).minute() + +moment(m).hour() * 60;
  };

  function getIntersectionObjectIds(arr1, arr2, property) {
    return _.intersection(_.map(arr1, value => ObjectId.getObjectId(value)), _.map(arr2, value => ObjectId.getObjectId(value)));
  } // Add a field to object with key


  function addToObject(obj, key, value, index) {
    let temp = {};
    let i = 0;

    for (let prop in obj) {
      if (obj.hasOwnProperty(prop)) {
        if (i === index && key && value) {
          temp[key] = value;
        }

        temp[prop] = obj[prop];
        i++;
      }
    }

    if (!index && key && value) {
      temp[key] = value;
    }

    return temp;
  }

  function copyToClipboard(content) {
    navigator.clipboard.writeText(content);
    FhdMessenger.success('Đã copy');
  }

  function calculateDiffHours(startTime, endTime) {
    if (moment(startTime).hour() > moment(endTime).hour()) {
      return moment(endTime).add(1, 'day').diff(startTime, 'hours', true);
    }

    return moment(endTime).diff(startTime, 'hours', true);
  }

  return {
    sortByProperty,
    copyToClipboard,
    sortObjectByKey,
    convertObjectToText,
    calculateDiffHours,
    getIntersectionObjectIds,
    isProbationShift,
    formatWeek,
    makeMap,
    addLeadZero,
    sumObjectProperty,
    hasRoles,
    combineTimeAndDate,
    joinArrayWithProperties,
    minutesOfDay,
    addDecimalNumber,
    removeValueFromArray,
    addToObject,
    isAllValidField,
    getRegionName,
    createListFibonacci
  };
}]);
'use strict';

angular.module('core').factory('$localStorage', ['$window', function ($window) {
  const supported = function () {
    try {
      $window.localStorage.world = 'hello';
      delete $window.localStorage.world;
      return true;
    } catch (ex) {
      return false;
    }
  }();

  return {
    set: function (key, value) {
      if (supported) {
        $window.localStorage[key] = value;
      }
    },
    get: function (key) {
      if (supported) {
        return $window.localStorage[key];
      }

      return null;
    },
    setObject: function (key, value) {
      if (supported) {
        $window.localStorage[key] = angular.toJson(value);
      }
    },
    getObject: function (key) {
      if (supported) {
        var value = $window.localStorage[key];
        if (!value || value === 'undefined' || value === 'null') return {};
        return angular.fromJson($window.localStorage[key] || {});
      }

      return null;
    },
    reset: function () {
      if (supported) {
        angular.forEach($window.localStorage, function (value, key) {
          if (key.match(/^Dexie/)) return;

          if (['productsUpdated', 'loadedProducts', 'loadedEssentialProducts'].includes(key)) {
            return;
          }

          $window.localStorage[key] = null;
        });
      }
    }
  };
}]);
"use strict";

angular.module('core').factory('LunarService', [function () {
  /*
   * Copyright (c) 2006 Ho Ngoc Duc. All Rights Reserved.
   * Astronomical algorithms from the book "Astronomical Algorithms" by Jean Meeus, 1998
   *
   * Permission to use, copy, modify, and redistribute this software and its
   * documentation for personal, non-commercial use is hereby granted provided that
   * this copyright notice and appropriate documentation appears in all copies.
   */
  var PI = Math.PI;
  /* Discard the fractional part of a number, e.g., INT(3.2) = 3 */

  function INT(d) {
    return Math.floor(d);
  }
  /* Compute the (integral) Julian day number of day dd/mm/yyyy, i.e., the number
   * of days between 1/1/4713 BC (Julian calendar) and dd/mm/yyyy.
   * Formula from http://www.tondering.dk/claus/calendar.html
   */


  function jdFromDate(dd, mm, yy) {
    var a, y, m, jd;
    a = INT((14 - mm) / 12);
    y = yy + 4800 - a;
    m = mm + 12 * a - 3;
    jd = dd + INT((153 * m + 2) / 5) + 365 * y + INT(y / 4) - INT(y / 100) + INT(y / 400) - 32045;

    if (jd < 2299161) {
      jd = dd + INT((153 * m + 2) / 5) + 365 * y + INT(y / 4) - 32083;
    }

    return jd;
  }
  /* Convert a Julian day number to day/month/year. Parameter jd is an integer */


  function jdToDate(jd) {
    var a, b, c, d, e, m, day, month, year;

    if (jd > 2299160) {
      // After 5/10/1582, Gregorian calendar
      a = jd + 32044;
      b = INT((4 * a + 3) / 146097);
      c = a - INT(b * 146097 / 4);
    } else {
      b = 0;
      c = jd + 32082;
    }

    d = INT((4 * c + 3) / 1461);
    e = c - INT(1461 * d / 4);
    m = INT((5 * e + 2) / 153);
    day = e - INT((153 * m + 2) / 5) + 1;
    month = m + 3 - 12 * INT(m / 10);
    year = b * 100 + d - 4800 + INT(m / 10);
    return [day, month, year];
  }
  /* Compute the time of the k-th new moon after the new moon of 1/1/1900 13:52 UCT
   * (measured as the number of days since 1/1/4713 BC noon UCT, e.g., 2451545.125 is 1/1/2000 15:00 UTC).
   * Returns a floating number, e.g., 2415079.9758617813 for k=2 or 2414961.935157746 for k=-2
   * Algorithm from: "Astronomical Algorithms" by Jean Meeus, 1998
   */


  function NewMoon(k) {
    var T, T2, T3, dr, Jd1, M, Mpr, F, C1, deltat, JdNew;
    T = k / 1236.85; // Time in Julian centuries from 1900 January 0.5

    T2 = T * T;
    T3 = T2 * T;
    dr = PI / 180;
    Jd1 = 2415020.75933 + 29.53058868 * k + 0.0001178 * T2 - 0.000000155 * T3;
    Jd1 = Jd1 + 0.00033 * Math.sin((166.56 + 132.87 * T - 0.009173 * T2) * dr); // Mean new moon

    M = 359.2242 + 29.10535608 * k - 0.0000333 * T2 - 0.00000347 * T3; // Sun's mean anomaly

    Mpr = 306.0253 + 385.81691806 * k + 0.0107306 * T2 + 0.00001236 * T3; // Moon's mean anomaly

    F = 21.2964 + 390.67050646 * k - 0.0016528 * T2 - 0.00000239 * T3; // Moon's argument of latitude

    C1 = (0.1734 - 0.000393 * T) * Math.sin(M * dr) + 0.0021 * Math.sin(2 * dr * M);
    C1 = C1 - 0.4068 * Math.sin(Mpr * dr) + 0.0161 * Math.sin(dr * 2 * Mpr);
    C1 = C1 - 0.0004 * Math.sin(dr * 3 * Mpr);
    C1 = C1 + 0.0104 * Math.sin(dr * 2 * F) - 0.0051 * Math.sin(dr * (M + Mpr));
    C1 = C1 - 0.0074 * Math.sin(dr * (M - Mpr)) + 0.0004 * Math.sin(dr * (2 * F + M));
    C1 = C1 - 0.0004 * Math.sin(dr * (2 * F - M)) - 0.0006 * Math.sin(dr * (2 * F + Mpr));
    C1 = C1 + 0.001 * Math.sin(dr * (2 * F - Mpr)) + 0.0005 * Math.sin(dr * (2 * Mpr + M));

    if (T < -11) {
      deltat = 0.001 + 0.000839 * T + 0.0002261 * T2 - 0.00000845 * T3 - 0.000000081 * T * T3;
    } else {
      deltat = -0.000278 + 0.000265 * T + 0.000262 * T2;
    }

    JdNew = Jd1 + C1 - deltat;
    return JdNew;
