angular.module('online-orders').factory('OrderTypes', [function () {
  const BOX4_SKUS = ['B2032', 'B2033', 'B2034', 'B2035', 'B2064', 'B2065'];

  function isWholesaleItem(item) {
    const WHOLESALE_SKUS = ['B2198', 'B2197', 'B2196', 'B2195', 'B2194', 'B2193', 'B2196', 'B2195', 'B2194', 'B2193'];
    if (_.includes(WHOLESALE_SKUS, item.sku)) return true;
    if (item.isWholesale) return true;
    return false;
  }

  function isWholesaleOrder(items) {
    const numBox4 = _.reduce(items, (result, item) => {
      if (_.includes(BOX4_SKUS, item.sku)) return result + item.quantity;
      return result;
    }, 0);

    if (numBox4 > 50) return true;

    const totalValue = _.reduce(items, (result, item) => {
      return result + item.quantity * (item.soldPrice || item.price);
    }, 0);

    const wholesaleValue = _.reduce(items, (result, item) => {
      if (item.isWholesale) {
        result += +item.quantity * (item.soldPrice || item.price);
      }

      return result;
    }, 0);

    if (_.some(items, isWholesaleItem) && items.length <= 3 && totalValue >= 700000 && _.some(items, item => item.quantity > 0) && wholesaleValue > 100000) return true;
    return false;
  }

  return {
    getOrderType(items, _city) {
      if (_.some(items, item => {
        return item.sku.match(/^V/);
      })) {
        return 'ORDER';
      }

      const city = _.isString(_city) ? _city.toUpperCase() : _city;

      if (isWholesaleOrder(items)) {
        return 'BUON';
      }

      if (city === 'Hà Nội (Nội thành)'.toUpperCase()) {
        return 'HN';
      }

      return 'TI';
    }

  };
}]);
