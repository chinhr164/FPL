angular.module('stock-count-entries').controller('StockCountEntriesController', ['$scope', '$stateParams', '$location', 'Authentication', 'ConfirmModal', 'StockCountEntries', 'ObjectId', 'FhdMessenger', 'ResourcesService', 'Products', 'ProductService', '$http', 'NgTableParams', function ($scope, $stateParams, $location, Authentication, ConfirmModal, StockCountEntries, ObjectId, FhdMessenger, ResourcesService, Products, ProductService, $http, NgTableParams) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.json = [];
  vm.data = {};

  vm.loadProducts = function () {
    ProductService.getAllProductsFromServer().then(products => {
      vm.data.products = products;
    });
  };

  vm.watchItems = function () {
    $scope.$watch(function () {
      return vm.items;
    }, function (newValue, oldValue) {
      if (newValue === oldValue) return;

      _.forEach(vm.items, function (item, key) {
        var matchProduct = _.find(vm.data.products, {
          sku: item.sku
        });

        if (matchProduct) {
          item.product = matchProduct._id;

          if (item.description !== matchProduct.description) {
            item.description = matchProduct.description;
          }
        } else {
          delete vm.items[key];
          FhdMessenger.error('Không tìm thấy id cho sản phẩm ' + item.sku + ' - ' + item.description);
        }
      });
    });
  }; // Create new Stock count entry


  vm.create = function () {
    if (!vm.reason) {
      return FhdMessenger.error('Chưa có lý do cập nhật số stock sản phẩm');
    }

    if (!_.intersection(vm.user.roles, ['admin', 'stock:edit', 'admin-stock', 'stock-count-entry:create']).length && ObjectId.getObjectId(vm.outlet) !== ObjectId.getObjectId(vm.user.outlet) && !_.some(vm.user.managingOutlets, managingOutlet => {
      return ObjectId.getObjectId(managingOutlet) === ObjectId.getObjectId(vm.outlet);
    })) {
      return FhdMessenger.error('Bạn chỉ được tạo Stock Modifier cho cơ sở mình quản lý');
    }

    if (_.some(vm.items, item => {
      return !_.isNumber(item.quantity);
    })) {
      return FhdMessenger.error('Có sản phẩm chưa có số tồn hiện tại');
    }

    ConfirmModal.showModal({}, {
      actionButtonText: `Hoàn thành`,
      headerText: `Bạn có muốn tạo Stock Modifier cho cơ sở ${vm.outlet.code}`,
      bodyText: `Bạn chắc chắn muốn tạo Stock Modifier với các sản phẩm ${_.reduce(vm.items, (result, item) => {
        return `${result}
${item.sku} - ${item.description} số lượng ${item.quantity}`;
      }, '')}`
    }).then(() => {
      FhdMessenger.info('Bắt đầu tạo...');
      vm.waiting = true; // Create new Stock count entry object

      var stockCountEntry = new StockCountEntries({
        outlet: ObjectId.getObjectId(vm.outlet),
        items: vm.items,
        reason: vm.reason
      }); // Redirect after save

      stockCountEntry.$save().then(response => {
        FhdMessenger.success('Đã tạo Stock Modifier thành công');
        $location.path('stock-modifiers/' + response._id);
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  }; // Remove existing Stock count entry


  vm.remove = function (stockCountEntry) {
    stockCountEntry.$remove().then(function () {
      $location.path('stock-modifiers');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.init = function () {
    vm.stockCountEntries = StockCountEntries.query();
  };

  vm.exportForm = function () {
    const stockCountEntries = vm.stockCountEntries.map(stockCountEntry => {
      return {
        stockCountEntryId: stockCountEntry.stockCountEntryId,
        outlet: stockCountEntry.outlet.code,
        sku: stockCountEntry.items.sku,
        description: stockCountEntry.items.description,
        quantity: stockCountEntry.items.quantity,
        diffQuantity: stockCountEntry.items.diffQuantity,
        byUser: stockCountEntry.user.displayName,
        date: moment(stockCountEntry.date).format('DD/MM/YYYY'),
        reason: stockCountEntry.reason
      };
    });
    alasql(`SELECT * INTO XLSX("export-order-entries.xlsx",{headers:true, utf8Bom: true,}) FROM ? ORDER BY stockCountEntryId ASC  `, [stockCountEntries]);
  }; // Update existing Stock count entry


  vm.update = function () {
    var stockCountEntry = vm.stockCountEntry;
    stockCountEntry.$update(function () {
      $location.path('stock-modifiers/' + stockCountEntry._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of Stock count entries


  vm.find = function () {
    vm.stockCountEntries = StockCountEntries.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      outlet: ObjectId.getObjectId(vm.data.outlet)
    });
    vm.stockCountEntries.$promise.then(stockCountEntries => {
      vm.stockCountEntries = stockCountEntries;
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    });
  }; // Find existing Stock count entry


  vm.findOne = function () {
    vm.stockCountEntry = StockCountEntries.get({
      stockCountEntryId: $stateParams.stockCountEntryId
    });
  };
}]);
'use strict';

angular.module('stock-count-entries').directive('fhdStockCountEntryItemsInput', ['hotkeys', function (hotkeys) {
  return {
    templateUrl: '/modules/stock-count-entries/templates/fhd-stock-count-entry-items-input.client.template.html',
    scope: {
      items: '=',
      saleTotal: '='
    },
    controller: 'FhdStockCountEntryItemsInputController',
    link: function (scope, element, attrs) {
      hotkeys.add({
        combo: 'f4',
        allowIn: ['INPUT'],
        description: 'Tìm đến ô số lượng của sản phẩm mới nhất',
        callback: function () {
          var lastRow = angular.element(_.last(element.find('tr')));
          if (!lastRow) return;

          var lastRowInput = _.head(lastRow.find('input'));

          if (!lastRowInput) return;
          lastRowInput.focus();
          lastRowInput.select();
        }
      });
      hotkeys.add({
        combo: 'f2',
        allowIn: ['INPUT'],
        description: 'Tìm đến ô nhập sản phẩm',
        callback: function () {
          var elm = _.head(element.find('input'));

          elm.focus();
          elm.select();
        }
      });
    }
  };
}]).controller('FhdStockCountEntryItemsInputController', ['$scope', function ($scope) {
  $scope.$watch(function () {
    return $scope.product;
  }, function (newValue, oldValue) {
    if (newValue === oldValue || !$scope.product) return;
    const item = $scope.product;
    $scope.items = $scope.items || [];

    const matchItemIndex = _.findIndex($scope.items, {
      sku: item.sku
    });

    if (matchItemIndex > -1) {
      $scope.items[matchItemIndex].quantity++;
    } else $scope.items.push({
      product: item._id,
      sku: item.sku,
      description: item.description,
      quantity: 1
    });

    $scope.product = null;
  });

  $scope.removeItem = function (index) {
    $scope.items.splice(index, 1);
  };
}]);
'use strict'; // Stock count entries service used to communicate Stock count entries REST endpoints

