  const vm = this;

  vm.addNote = function () {
    vm.notes = vm.notes || [];
    vm.notes.push({
      user: Authentication.user,
      time: new Date(),
      content: vm.newNote
    });

    if (vm.saveHook) {
      const fn = vm.saveHook(vm.param);

      if (fn.then) {
        fn.then(() => {
          vm.newNote = '';
        });
      }
    }
  };

  vm.removeNote = function (note) {
    const matchNoteIndex = _.findIndex(vm.notes, {
      _id: note._id
    });

    if (matchNoteIndex > -1) {
      vm.onlineOrder.notes.splice(matchNoteIndex, 1);
    }
  };
