angular.module('sale-campaigns').controller('SaleCampaignsController', ['SaleCampaigns', 'SaleCampaignService', 'Outlets', 'Products', 'CustomerService', 'FhdMessenger', '$location', 'ConfirmModal', '$stateParams', 'NgTableParams', function (SaleCampaigns, SaleCampaignService, Outlets, Products, CustomerService, FhdMessenger, $location, ConfirmModal, $stateParams, NgTableParams) {
  const vm = this;
  vm.conditions = vm.conditions || [];
  vm.products = vm.products || [];
  vm.customers = vm.customers || [];
  vm.conditionMap = SaleCampaignService.getConditionType();
  vm.saleCampaignTable = new NgTableParams({
    count: 100
  });

  vm.searchCustomers = searchText => {
    return CustomerService.searchCustomers(searchText).then(customers => {
      vm.searchingCustomers = customers || [];
      return customers || [];
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      vm.searchingCustomers = [];
      return [];
    }).finally(() => {
      vm.searchingCustomer = false;
    });
  };

  vm.addCondition = function () {
    if (!vm.conditionType || !vm.conditionValue) {
      return FhdMessenger.error('Bạn phải chọn điều kiện áp dụng và giá trị áp dụng!');
    }

    if (vm.saleCampaign) {
      vm.saleCampaign.conditions.push({
        conditionType: vm.conditionType,
        conditionValue: vm.conditionValue
      });
      return;
    }

    vm.conditions.push({
      conditionType: vm.conditionType,
      conditionValue: vm.conditionValue
    });
  };

  vm.productSearchSelected = function (item) {
    vm.products = vm.products || [];

    const matchItemIndex = _.findIndex(vm.products, {
      sku: item.sku
    });

    if (matchItemIndex > -1) {
      return FhdMessenger.error('Sản phẩm đã có trong danh sách');
    } else {
      if (vm.saleCampaign) {
        vm.saleCampaign.products.push({
          product: item._id,
          sku: item.sku,
          description: item.description,
          price: item.price,
          noLoyalty: true,
          isWholesale: false
        });
      } else {
        vm.products.push({
          product: item._id,
          sku: item.sku,
          description: item.description,
          price: item.price,
          noLoyalty: true,
          isWholesale: false
        });
      }
    }
  };

  vm.deleteCondition = function ($index) {
    if (vm.saleCampaign) {
      vm.saleCampaign.conditions.splice($index, 1);
      return;
    }

    vm.conditions.splice($index, 1);
  };

  vm.deleteProduct = function ($index) {
    if (vm.saleCampaign) {
      vm.saleCampaign.products.splice($index, 1);
      return;
    }

    vm.products.splice($index, 1);
  };

  vm.create = function () {
    ConfirmModal.show({}, {
      headerText: 'Tạo Sale Campaign mới?',
      bodyText: `Bạn có thực sự tạo Sale Campaign cho những khách hàng này ?`
    }).then(() => {
      var saleCampaign = new SaleCampaigns({
        customers: vm.customers,
        conditions: vm.conditions,
        products: vm.products,
        startDate: vm.startDate,
        endDate: vm.endDate
      });
      saleCampaign.$save(function (response) {
        FhdMessenger.success('Tạo Sale Campaign thành công!');
        $location.path('sale-campaigns/create');
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
      });
    });
  };

  vm.remove = function (saleCampaign) {
    if (saleCampaign) {
      saleCampaign.$remove();

      for (var i in vm.saleCampaigns) {
        if (vm.saleCampaigns[i] === saleCampaign) {
          vm.saleCampaigns.splice(i, 1);
        }
      }
    } else {
      vm.saleCampaign.$remove(function () {
        $location.path('sale-campaigns');
      });
    }
  };

  vm.update = function () {
    var saleCampaign = vm.saleCampaign;
    saleCampaign.$update(function () {
      $location.path('sale-campaigns');
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.findOne = function () {
    vm.saleCampaign = SaleCampaigns.get({
      saleCampaignId: $stateParams.saleCampaignId
    });
  };

  vm.find = function () {
    vm.saleCampaigns = SaleCampaigns.query({
      startDate: vm.startDate,
      endDate: vm.endDate
    });
    vm.saleCampaigns.$promise.then(() => {
      vm.saleCampaignTable.settings({
        dataset: vm.saleCampaigns
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

