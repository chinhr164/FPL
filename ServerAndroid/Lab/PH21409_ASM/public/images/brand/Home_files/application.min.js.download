angular.module('user-tag-entries').controller('UserTagEntriesController', ['$stateParams', '$location', '$scope', 'Authentication', 'UserTagEntries', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'ConfirmModal', 'UserTagEntriesService', function ($stateParams, $location, $scope, Authentication, UserTagEntries, FhdMessenger, NgTableParams, ObjectId, ConfirmModal, UserTagEntriesService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.userTagEntry = {};
  vm.user = Authentication.user;
  vm.data = {};
  vm.recurringPeriodMap = [{
    type: 'none',
    name: 'Không lặp'
  }, {
    type: 'daily',
    name: 'Hàng ngày'
  }, {
    type: 'weekly',
    name: 'Hàng tuần'
  }, {
    type: 'monthly',
    name: 'Hàng tháng'
  }];

  vm.getRecurringPeriod = function (recurringPeriodType) {
    return _.get(_.find(vm.recurringPeriodMap, recurringPeriod => {
      return recurringPeriod.type === recurringPeriodType;
    }), 'name');
  };

  vm.getStatus = _.map(['inactive', 'active'], status => {
    return {
      title: status,
      id: status
    };
  });

  vm.changeTaggedUser = function (user) {
    vm.staff = null;
    vm.userTagEntry.taggedUsers = vm.userTagEntry.taggedUsers || [];

    if (_.some(vm.userTagEntry.taggedUsers, taggedUser => {
      return _.isEqual(ObjectId.getObjectId(taggedUser.user), ObjectId.getObjectId(user));
    })) {
      return;
    }

    vm.userTagEntry.taggedUsers.push({
      user
    });
  };

  vm.removeTaggedUser = index => {
    vm.userTagEntry.taggedUsers.splice(index, 1);
  };

  vm.create = function () {
    if (!vm.userTagEntry.notiId) {
      return FhdMessenger.error('Bạn chưa nhập noti id');
    }

    if (!vm.userTagEntry.description) {
      return FhdMessenger.error('Bạn chưa nhập mô tả ');
    }

    if (!vm.userTagEntry.taggedUsers.length) {
      return FhdMessenger.error('Cần ít nhất một người được tag');
    }

    const userTagEntry = new UserTagEntries(vm.userTagEntry);
    vm.waiting = true; // Redirect after save

    userTagEntry.$save().then(() => {
      FhdMessenger.success('Tạp user tag entry thành công');
      $location.path(`user-tag-entries`);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.userTagEntriesTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    UserTagEntries.query().$promise.then(userTagEntries => {
      vm.userTagEntries = userTagEntries;

      _.forEach(vm.userTagEntries, userTagEntry => {
        userTagEntry.taggedUsersText = UserTagEntriesService.convertTaggedUsersToText(userTagEntry.taggedUsers);
      });

      vm.userTagEntriesTable.settings({
        dataset: vm.userTagEntries
      });
    });
  };

  vm.findOne = async () => {
    vm.userTagEntry = UserTagEntries.get({
      userTagEntryId: $stateParams.userTagEntryId
    }).$promise.then(userTagEntry => {
      vm.userTagEntry = userTagEntry;
      vm.taggedUsers = vm.userTagEntry.taggedUsers;
    });
  };

  vm.update = () => {
    if (!vm.userTagEntry.description) {
      return FhdMessenger.error('Chưa có miêu tả');
    }

    if (!vm.userTagEntry.taggedUsers.length) {
      return FhdMessenger.error('Chưa có người được tags');
    }

    vm.waiting = true;
    vm.userTagEntry.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path(`user-tag-entries`);
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.deactivate = (userTagEntry, index) => {
    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc là muốn xóa User Tag Entry: ${userTagEntry.notiId}\nDescription: ${userTagEntry.description}`,
      actionButtonText: 'Accept',
      closeButtonText: 'close'
    }).then(() => {
      vm.waiting = true;
      userTagEntry.$deactivate().then(_userTagEntry => {
        _userTagEntry.taggedUsersText = UserTagEntriesService.convertTaggedUsersToText(_userTagEntry.taggedUsers);
        FhdMessenger.success('Xóa thành công');
        vm.userTagEntriesTable.reload();
      }).catch(err => {
        FhdMessenger.error(err.message);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.activate = (userTagEntry, index) => {
    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc là muốn kích hoạt User Tag Entry: ${userTagEntry.notiId}\nDescription: ${userTagEntry.description}`,
      actionButtonText: 'Accept',
      closeButtonText: 'close'
    }).then(() => {
      vm.waiting = true;
      userTagEntry.$activate().then(_userTagEntry => {
        _userTagEntry.taggedUsersText = UserTagEntriesService.convertTaggedUsersToText(_userTagEntry.taggedUsers);
        FhdMessenger.success('Kích hoạt thành công');
        vm.userTagEntriesTable.reload();
      }).catch(err => {
        FhdMessenger.error(err.message);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
'use strict'; // Complaints service used to communicate Complaints REST endpoints

angular.module('user-tag-entries').factory('UserTagEntries', ['$resource', function ($resource) {
  return $resource('user-tag-entries/:userTagEntryId', {
    userTagEntryId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    deactivate: {
      method: 'PUT',
      url: 'user-tag-entries/:userTagEntryId/deactivate'
    },
    activate: {
      method: 'PUT',
      url: 'user-tag-entries/:userTagEntryId/activate'
    }
  });
}]);
'use strict';

angular.module('user-tag-entries').factory('UserTagEntriesService', ['UserTagEntries', function (UserTagEntries) {
  const convertTaggedUsersToText = function (taggedUsers, showSlackId = false) {
    return _.reduce(taggedUsers, (result, taggedUser) => {
      // eslint-disable-next-line camelcase
      const {
        code,
        displayName,
        slack_id
      } = taggedUser.user; // eslint-disable-next-line camelcase

      result += `${code || ''} ${displayName} ${showSlackId ? slack_id : ''}, `;
      return result;
    }, '');
  };

  return {
    convertTaggedUsersToText
  };
}]);
'use strict';

