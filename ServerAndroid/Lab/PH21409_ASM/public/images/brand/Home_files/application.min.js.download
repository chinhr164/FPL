angular.module('sale-codes').controller('ModalSalePriceController', ['saleCode', '$modalInstance', 'Authentication', '$modal', 'FhdMessenger', '$http', '$window', function (saleCode, $modalInstance, Authentication, $modal, FhdMessenger, $http, $window) {
  const vm = this;
  vm.user = Authentication.user;
  vm.saleCode = saleCode;
  vm.cancel = $modalInstance.dismiss;

  vm.updateSalePrice = () => {
    vm.waiting = true;
    vm.saleCode.$updateSalePrice().then(res => {
      FhdMessenger.success('Cập nhật giá thành công');
      $modalInstance.close();
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };
}]);
