angular.module('core').filter('momentDate', [function () {
  return function (input, format) {
    if (!input) {
      return '';
    }

    let outputFormat = format;

    if (format === 'L-V') {
      outputFormat = 'DD/MM/YYYY';
    }

    var date = moment(input || 'N/A');
    if (date.isValid()) return _.capitalize(date.format(outputFormat));else return '';
  };
}]);
'use strict';

angular.module('core').filter('momentDuration', [function () {
  return function (input, format) {
    if (!input) return '';
    var duration = moment.duration(input);

    switch (format) {
      case 'seconds':
        duration = duration.asSeconds();
        break;

      case 'minutes':
        duration = duration.asMinutes();
        break;

      case 'hours':
        duration = duration.asHours();
        break;

      case 'time':
        duration = (duration.hours() ? `${Math.floor(duration.asHours())}h` : '') + duration.minutes() + "'" + duration.seconds() + '"';
        break;

      default:
        duration = duration.humanize();
    }

    return duration;
  };
}]);
'use strict';

angular.module('core').filter('month', [function () {
  var months = moment.months();
  return function (input) {
    // console.log('input', input)
    if (_.isUndefined(input) || !_.isFinite(input) || input < 0 || input > 11) return 'Không xác định';
    return _.capitalize(months[input]);
  };
}]);
'use strict';

angular.module('core').filter('paymentMethod', [function () {
