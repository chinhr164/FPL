angular.module('facilities').controller('ModalLiquidateFacillityController', ['$modalInstance', 'facility', 'FhdMessenger', function ($modalInstance, facility, FhdMessenger) {
  const vm = this;
  vm.facility = facility;

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.sendRequest = function () {
    if (!vm.reason) {
      return FhdMessenger.error('Cần nhập lý do thanh lý');
    }

    if (!vm.liquidationMoney) {
      return FhdMessenger.error('Cần nhập số tiền thanh lý');
    }

    vm.liquidateRequest = {
      liquidationMoney: vm.liquidationMoney,
      reason: vm.reason
    };
    $modalInstance.close(vm.liquidateRequest);
  };
}]);
"use strict";

angular.module('facilities').controller('ModalReportErrorFacilityController', ['$modalInstance', 'FhdMessenger', function ($modalInstance, FhdMessenger) {
  const vm = this;

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.sendReport = function () {
    if (!vm.reportContent) {
      return FhdMessenger.error('Chưa có nội dung báo cáo lỗi');
    }

    $modalInstance.close(vm.reportContent);
  };
}]);
"use strict";

/* eslint-disable prettier/prettier */
angular.module('facilities').controller('ModalRequestTransferFacilityController', ['$modalInstance', 'facility', 'FhdMessenger', function ($modalInstance, facility, FhdMessenger) {
  const vm = this;
  vm.facility = facility;

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.sendRequest = function () {
    if (!vm.destination) {
      return FhdMessenger.error('Chưa có cơ sở nhận');
    }

    if (vm.facility.facilityType.partiallyTransfer) {
      if (!vm.transferQuantity) {
        return FhdMessenger.error('Bạn chưa điền số lượng chuyển đi');
      }

      if (vm.transferQuantity > facility.quantity) {
        return FhdMessenger.error('Số lượng chuyển quá số lượng hiện có');
      }
    }

    vm.transferRequest = {
      destination: vm.destination,
      reason: vm.reason,
      transferQuantity: vm.transferQuantity
    };
    $modalInstance.close(vm.transferRequest);
  };
}]);
"use strict";

/* eslint-disable angular/controller-as */
angular.module('facilities').filter('filterFacilityInput', [function () {
  return function (facilities, viewValue, facilitySearch) {
    const lowerCaseViewValue = viewValue.toLowerCase();

    const matchFacility = _.find(facilities, facility => facility.facilityId.toLowerCase() === lowerCaseViewValue);

    if (matchFacility) {
      return [matchFacility];
    }

    if (facilitySearch && viewValue !== facilitySearch) {
      return _.filter(facilities, facility => {
        return facility.facilityId.toLowerCase().includes(lowerCaseViewValue) || facility.fullName.toLowerCase().includes(lowerCaseViewValue);
      });
    }

    return facilities;
  };
}]).directive('fhdFacilityInput', [function () {
  return {
    templateUrl: '/modules/facilities/templates/fhd-facility-input.client.template.html',
    restrict: 'AE',
    scope: {
      facility: '=?',
      label: '@',
      labelColumn: '@',
      onChange: '=?',
      outlet: '=?',
      group: '=?'
    },

    link(scope, element) {
      const vm = scope.vm;

      if (vm.labelColumn) {
        const labelElm = element.find('label');
        const inputElm = element.find('fhd-controls');
        labelElm.addClass(`col-sm-${vm.labelColumn}`);
        inputElm.addClass(`col-sm-${12 - vm.labelColumn}`);
      }
    },

    controller: 'FhdFacilityInputController',
    controllerAs: 'vm',
    bindToController: true,
    replace: true
  };
}]).controller('FhdFacilityInputController', ['$scope', 'FhdMessenger', 'Facilities', 'ObjectId', 'CurrentShift', function ($scope, FhdMessenger, Facilities, ObjectId, CurrentShift) {
  const vm = this;
  vm.data = {};
  vm.loadDefault = _.isUndefined(vm.loadDefault) ? true : vm.loadDefault;
  const notSelected = '';
  vm.facilitySearch = notSelected;
  const currentShift = CurrentShift.getCurrentShift();
  let currentShiftOutlet;

  if (currentShift.outlet) {
    currentShiftOutlet = ObjectId.getObjectId(currentShift.outlet);
  }

  Facilities.query({
    currentShiftOutlet,
    statuses: ['error', 'normal']
  }, facilities => {
    FhdMessenger.success('Đã lấy dữ liệu CSVC!');
    vm.data.facilities = _.map(facilities, facility => {
      facility.fullName = `${facility.facilityId} - ${facility.name}`;
      return facility;
    });
    filterFacilites();

    if (vm.facility) {
      const facility = _.find(vm.data.facilities, facility => {
        return ObjectId.equals(facility, vm.facility);
      });

      if (facility) {
        vm.facilitySearch = facility.fullName;
        vm.facility = facility;
      }
    }
  });

  if (vm.onChange) {
    $scope.$watch('vm.facilitySearch', (newValue, oldValue) => {
      if (newValue && newValue !== oldValue) {
        $scope.onChange(newValue);
      }
    });
  }

  function filterFacilites() {
    if (!vm.group || !vm.outlet) {
      return;
    }

    vm.data._facilities = _.sortBy(_.filter(vm.data.facilities, facility => {
      return ObjectId.equals(facility.outlet, vm.outlet) && facility.group === vm.group;
    }), 'fullName');
  }

  $scope.$watch('vm.group', (newValue, oldValue) => {
    if (newValue !== oldValue && newValue) {
      filterFacilites();
    }
  });
  $scope.$watch('vm.outlet', (newValue, oldValue) => {
    if (newValue !== oldValue && newValue) {
      filterFacilites();
    }
  });

  vm.remove = function () {
    vm.facility = null;
    vm.facilitySearch = null;
  };

  vm.selectFacility = item => {
    vm.facility = item;
  };
}]);
"use strict";

angular.module('facilities').filter('facilityStatus', [function () {
  return function (input) {
    switch (input) {
      case 'normal':
        return 'Bình thường';

      case 'error':
        return 'Lỗi';

      case 'warranting':
        return 'Đang bảo hành';

      case 'deleted':
        return 'Hủy';

      case 'accepted':
        return 'Đã duyệt';

      case 'request':
        return 'Yêu cầu mua';

      case 'liquidated':
        return 'Đã thanh lý';
    }
  };
}]);
"use strict";

angular.module('facilities').filter('facilityTypes', [function () {
  return function (input) {
    switch (input) {
      case 'computer':
        return 'Máy tính và đồ công nghệ';

      case 'null':
        return 'Không có';
    }
  };
}]);
"use strict";

/* eslint-disable prettier/prettier */
angular.module('facilities').factory('FacilityService', ['$modal', '$http', function ($modal, $http) {
  return {
    openReportError(facility) {
      return $modal.open({
        templateUrl: 'modules/facilities/views/modal-report-error-facility.client.view.html',
        controller: 'ModalReportErrorFacilityController',
        controllerAs: 'vm',
        resolve: {
          source: () => facility
        }
      }).result;
    },

    openModalTransfer(facility) {
      return $modal.open({
        templateUrl: 'modules/facilities/views/modal-request-transfer.client.view.html',
        controller: 'ModalRequestTransferFacilityController',
        controllerAs: 'vm',
        resolve: {
          facility: () => facility
        }
      }).result;
    },

    openModalLiquidate(facility) {
      return $modal.open({
        templateUrl: 'modules/facilities/views/modal-liquidate.client.view.html',
        controller: 'ModalLiquidateFacillityController',
        controllerAs: 'vm',
        resolve: {
          facility: () => facility
        }
      }).result;
    },

    openModalEdit(facilityId) {
      return $modal.open({
        templateUrl: 'modules/facilities/views/modal-edit-facility.client.view.html',
        controller: 'ModalEditFacilityController',
        controllerAs: 'vm',
        resolve: {
          facilityId: () => facilityId
        }
      }).result;
    },

    newId: text => $http({
      url: '/new-facility-id',
      method: 'GET',
      params: {
        text
      }
    }).then(response => {
      return response.data.facilityId;
    }),
    getGroups: () => {
      return [{
        group: 'partnership-app',
        name: 'App đối tác'
      }, {
        group: 'computer',
        name: 'Máy tính/Mạng/Camera'
      }, {
        group: 'waterAndElectricEquipment',
        name: 'Thiết bị điện/Cấp thoát nước'
      }, {
        group: 'infrastructure',
        name: 'Cơ sở hạ tầng'
      }, {
        group: 'other',
        name: 'Khác'
      }];
    }
  };
}]);
