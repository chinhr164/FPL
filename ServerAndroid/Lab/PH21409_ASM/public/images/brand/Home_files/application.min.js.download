angular.module('carton-entries').controller('ModalEditCartonEntryController', ['cartonEntry', '$modalInstance', 'CartonEntries', 'FhdMessenger', function (cartonEntry, $modalInstance, CartonEntries, FhdMessenger) {
  const vm = this;
  vm.cancel = $modalInstance.dismiss;
  vm.cartonEntry = CartonEntries.get({
    cartonEntryId: cartonEntry._id
  });
  vm.data = {};

  vm.edit = function () {
    if (!vm.cartonEntry.weight) {
      return FhdMessenger.error('Bạn chưa nhập khối lượng');
