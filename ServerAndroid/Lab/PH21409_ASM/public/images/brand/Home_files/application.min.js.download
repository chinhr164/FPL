angular.module('restock-lists').controller('ImportRestockListsController', ['Authentication', 'FhdMessenger', '$http', '$location', function (Authentication, FhdMessenger, $http, $location) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().endOf('day').format('YYYY-MM-DD');

  vm.import = () => {
    if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('purchaser') && !vm.user.roles.includes('restock-lists:import')) {
      return FhdMessenger.error('Bạn không có quyền import');
    }

    if (_.some(vm.rawItems, item => {
      return !item.sku;
    })) {
      return FhdMessenger.error('Bạn chưa điền mã sản phẩm cần import');
    }

    if (_.some(vm.rawItems, item => {
      return !item.outletCode;
    })) {
      return FhdMessenger.error('Bạn chưa điền mã cơ sở cần import');
    }

    if (_.some(vm.rawItems, item => {
      return !item.restockQuantity;
    })) {
      return FhdMessenger.error('Bạn chưa điền số lượng restock của sản phẩm');
    }

    if (moment(vm.endDate).isBefore(vm.startDate)) {
      return FhdMessenger.error('Ngày kết thúc không thể trước ngày bắt đầu');
    }

    vm.waiting = true;
    $http.post('/restock-lists/import', {
      rawItems: vm.rawItems,
      startDate: vm.startDate,
      endDate: vm.endDate
    }).then(() => {
      $location.path('restock-lists');
      return FhdMessenger.success('Import restock lists thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

angular.module('restock-lists').controller('RestockListsController', ['Authentication', 'FhdMessenger', 'RestockLists', 'NgTableParams', 'ConfirmModal', 'CurrentShift', '$location', '$http', '$stateParams', function (Authentication, FhdMessenger, RestockLists, NgTableParams, ConfirmModal, CurrentShift, $location, $http, $stateParams) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.sku = '';
  vm.currentShift = CurrentShift.getCurrentShift();
  vm.warehouseRestock = _.get(vm.currentShift, 'outlet._id');

  vm.init = function () {
    vm.restockListsTable = new NgTableParams({
      count: 20
    });
    vm.startDate = moment().subtract(1, 'week').format('YYYY-MM-DD');
    vm.endDate = moment().format('YYYY-MM-DD');
    vm.find();
  };

  vm.checkAll = function () {
    _.forEach(vm.restockListsTable.data, item => {
      item.checked = vm.checked;
    });
  };

  vm.find = function () {
    vm.waiting = true;
    const sku = _.isString(vm.sku) ? vm.sku.toUpperCase() : null;
    const promise = RestockLists.query({
      startDate: vm.startDate,
      endDate: vm.endDate,
      sku: sku,
      warehouseRestock: vm.warehouseRestock
    }).$promise.then(restockLists => {
      _.forEach(restockLists, restockList => {
        if (_.get(restockList, 'items.length')) restockList.warehouseRestock = _.head(restockList.items).warehouseRestock;
      });

      vm.restockListsTable.settings({
        dataset: restockLists
      });
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải danh sách restock lists...', promise, () => {
      FhdMessenger.success('Đã tải xong');
    });
  };

  vm.remove = function (restockList, index) {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Hủy',
      actionButtonText: 'Xóa Restock List',
      headerText: 'Xóa Restock List?',
      bodyText: `Bạn có chắc là bạn muốn xóa restock list: ${restockList.title}?`
    }).then(() => {
      vm.waiting = true;
      restockList.$remove().then(() => {
        FhdMessenger.success(`Đã xoá !`);
        vm.restockListsTable.data.splice(index, 1);
        vm.restockListsTable.settings({
          dataset: vm.restockListsTable.data
        });
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.findOne = async () => {
    RestockLists.get({
      restockListId: $stateParams.restockListId
    }).$promise.then(restockList => {
      vm.restockList = _.assign(restockList, {
        startDate: moment(restockList.startDate).toDate(),
        endDate: moment(restockList.endDate).toDate()
      });
    });
  };

  vm.update = async () => {
    vm.waiting = true;
    vm.restockList.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path(`restock-lists`);
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.markKeepStock = async restockList => {
    vm.waiting = true;
    restockList.$markKeepStock().then(response => {
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.createOutletReport = function (restockList) {
    vm.waiting = true;

    if (restockList) {
      restockList.$createOutletReport().then(() => {
        FhdMessenger.success('Tạo Outlet Report thành công');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    }

    vm.restockLists = _.filter(vm.restockListsTable.data, {
      checked: true
    });

    const restockListIds = _.map(vm.restockLists, '_id');

    RestockLists.createGroupedOutletReport({
      restockListIds
    }).$promise.then(res => {
      FhdMessenger.success('Tạo outlet report thành công');
      vm.find();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('restock-lists').controller('ViewRestockListController', ['Authentication', 'ConfirmModal', 'RestockLists', '$stateParams', 'NgTableParams', 'TetCategories', '$interval', 'hotkeys', '$state', '$window', '$timeout', '$scope', 'RestockListService', '$localStorage', '$http', 'FhdMessenger', '$document', function (Authentication, ConfirmModal, RestockLists, $stateParams, NgTableParams, TetCategories, $interval, hotkeys, $state, $window, $timeout, $scope, RestockListService, $localStorage, $http, FhdMessenger, $document) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {};
  vm.data.now = new Date();
  $interval(() => {
    vm.data.now = new Date();
  }, 1000);
  vm.warehouseGroupFilter = [{
    id: 'Tủ đông',
    title: 'Tủ đông'
  }, {
    id: 'Tủ mát',
    title: 'Tủ mát'
  }, {
    id: 'Nhiệt độ phòng',
    title: 'Nhiệt độ phòng'
  }, {
    id: '',
    title: 'Tất cả'
  }];
  vm.statuses = [{
    code: 'all',
    name: 'Tất cả'
  }, {
    code: 'lack',
    name: 'thiếu'
  }, {
    code: 'excess',
    name: 'thừa'
  }, {
    code: 'enough',
    name: 'đủ'
  }];
  vm.data.catHeader = 'Tết Tag';

  vm.getSpecialCategories = () => {
    const mapCategories = categories => {
      return _.map(categories, x => ({
        id: x.name,
        title: x.name
      }));
    };

    _.forEach(vm.restockList.items, item => {
      item.product.specialCategory = item.product[`tetCategory`];
    });

    return TetCategories.query().$promise.then(tetCategories => {
      vm.data.catHeader = 'Tết Tag';
      return mapCategories(tetCategories);
    });
  };

  vm.itemsTable = new NgTableParams({
    count: 1000
  });

  vm.fetchTable = function (items) {
    vm.itemsTable.settings({
      dataset: items
    });
    vm.itemsTable.reload();
  };

  vm.findOne = function (sortByLocation) {
    vm.waiting = true;
    vm.restockList = RestockLists.get({
      restockListId: $stateParams.restockListId
    }).$promise.then(restockList => {
      vm.restockList = restockList;

      _.forEach(vm.restockList.items, item => {
        item.khoDiff = item.khoQuantity - item.restockQuantity;

        if (!item.warehouseRestock) {
          item.warehouseRestock = item.product.warehouseRestock;
        }
      });

      vm.isWarehouse = _.get(_.head(vm.restockList.items), 'warehouseRestock.code', '').match(/D\d+/);
      vm.fetchTable(vm.restockList.items);

      const itemByStatusMap = _.countBy(vm.restockList.items, 'status');

      vm.itemByStatuses = _.sortBy(_.reduce(itemByStatusMap, (result, numItem, status) => {
        result.push({
          status: status,
          numItem: numItem,
          percent: numItem / vm.restockList.items.length * 100
        });
        return result;
      }, []), 'status');

      if (sortByLocation) {
        _.forEach(vm.restockList.items, item => {
          if (!_.get(item, 'product.lastInventoryLocation.order')) {
            _.set(item, 'product.lastInventoryLocation.order', 0);
          }
        });

        vm.restockList.items = _.orderBy(vm.restockList.items, ['product.lastInventoryLocation.code', 'description'], ['asc', 'asc']);
        $timeout(() => {
          $window.print();
        }, 1000);
      }
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.exportTable = () => {
    vm.waiting = true;

    if (vm.linkGoogleSheet) {
      const confirm = $window.confirm('Bạn đã tạo link google sheet, bạn muốn tạo mới chứ?');

      if (!confirm) {
        return;
      }
    }

    FhdMessenger.info('Đang tạo');
    const cols = $document[0].querySelectorAll("span[ng-bind='$column.title(this)']");
    const colNames = [];

    _.forEach(cols, col => {
      colNames.push(col.innerText);
    });

    colNames.splice(-1, 1);

    const itemsTable = _.get(vm, 'itemsTable.data', []);

    if (!itemsTable.length) {
      return FhdMessenger.error('Chưa có data truyền vào');
    }

    const sheetData = [];
    let row = [];

    _.forEach(itemsTable, (sheetDatum, index) => {
      const productTag = _.get(sheetDatum, 'product.tag', '');

      const specialCategoryName = _.get(sheetDatum, 'product.specialCategory.name', '');

      const vendorCountry = _.get(sheetDatum, 'product.vendor.country', '');

      const warehouseRestockCode = _.get(sheetDatum, 'warehouseRestock.code', '');

      const condition = _.get(sheetDatum, 'product.warehouseGroup.name', '');

      let noteContent = '';

      if (sheetDatum.notes.length) {
        noteContent = _.reduce(sheetDatum.notes, (result, note) => {
          result += `• ${note.content} | ${_.get(note, 'user.code', '')} ${_.get(note, 'user.firstName', '')} @${moment(note.time).format('hh:mm DD/MM')}\n`;
          return result;
        }, '');
      }

      row.push(index + 1);
      row.push(sheetDatum.status);
      row.push(sheetDatum.sku);
      row.push(sheetDatum.description);
      row.push(sheetDatum.price);
      row.push(productTag);
      row.push(specialCategoryName);
      row.push(condition);
      row.push(vendorCountry);
      row.push(sheetDatum.khoQuantity);
      row.push(warehouseRestockCode);
      row.push(sheetDatum.khoDiff);
      row.push(sheetDatum.restockQuantity);
      row.push(sheetDatum.actualQuantity);
      row.push(sheetDatum.diffQuantity);
      row.push(`Đã chuyển: ${sheetDatum.delivered}\nĐã nhận: ${sheetDatum.received}`);
      row.push(noteContent);
      sheetData.push(row);
      row = [];
    });

    $http.post('/sheet', {
      sheetData: sheetData,
      sheetTitle: vm.restockList.title,
      sheetCols: colNames
    }).then(res => {
      vm.linkGoogleSheet = `https://docs.google.com/spreadsheets/d/${res.data.data.spreadsheetId}`;
      $window.open(vm.linkGoogleSheet);
      FhdMessenger.success('Đã tạo thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.filter = function () {
    let items = _.get(vm.restockList, 'items', []);

    if (vm.status && vm.status.code !== 'all') {
      items = _.filter(items, {
        status: vm.status.name
      });
    }

    vm.fetchTable(items);
  };

  vm.addNote = function (restockList, item) {
    RestockListService.addNote(restockList, item).then(res => {
      $state.reload();
    });
  };

  vm.removeItem = function (item) {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Xóa sản phẩm ${item.sku} - ${item.description}`,
      bodyText: `Bạn chắc chắn muốn xóa sản phẩm ${item.sku} - ${item.description}`
    }).then(() => {
      vm.restockList.skuRemoved = item.sku;
      vm.restockList.$removeItem().then(res => {
        $state.reload();
      });
    });
  };

  vm.addItems = () => {
    const restockList = vm.restockList;
    RestockListService.addItems(restockList).then(_restockList => {
      $state.reload();
    });
  };

  vm.createStockEntry = function () {
    $localStorage.setObject('restockList', vm.restockList);
    const url = $state.href('createStockEntry');
    $window.open(url, '_blank');
  };

  vm.createOutletReport = function () {
    vm.waiting = true;
    vm.restockList.$createOutletReport().then(() => {
      $state.reload();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.print = () => {
    $state.go('printRestockList', {
      restockListId: _.get(vm.restockList, '_id')
    });
  };

  hotkeys.bindTo($scope).add({
    combo: ['ctrl+p', 'cmd+p'],
    description: 'Print',
    callback: vm.print
  });
}]);
'use strict';

angular.module('restock-lists').factory('RestockListService', ['$modal', function ($modal) {
  return {
    addNote(restockList, item) {
      return $modal.open({
        templateUrl: '/modules/restock-lists/templates/modal-add-note-restock-list.client.view.html',
        controller: 'ModalAddNoteRestockListController',
        size: 'md',
        controllerAs: 'vm',
        resolve: {
          restockList: () => restockList,
          item: () => item
        }
      }).result;
    },

    addItems(restockList) {
      return $modal.open({
        templateUrl: '/modules/restock-lists/templates/modal-add-items-to-restock-list.client.view.html',
        controller: 'ModalAddItemsToRestockListController',
        size: 'md',
        controllerAs: 'vm',
        resolve: {
          restockList: () => restockList
        }
      }).result;
    }

  };
}]);
"use strict";

angular.module('restock-lists').factory('RestockLists', ['$resource', function ($resource) {
  return $resource('/restock-lists/:restockListId', {
    restockListId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    createGroupedOutletReport: {
      method: 'POST',
      url: 'restock-lists/create-grouped-outlet-report',
      isArray: true
    },
    explain: {
      method: 'PUT',
      url: 'restock-lists/:restockListId/explain'
    },
    removeItem: {
      method: 'PUT',
      url: 'restock-lists/:restockListId/remove-item'
    },
    addItems: {
      method: 'PUT',
      url: 'restock-lists/:restockListId/add-items'
    },
    markKeepStock: {
      method: 'PUT',
      url: 'restock-lists/:restockListId/mark-keep-stock'
    },
    createOutletReport: {
      method: 'PUT',
      url: 'restock-lists/:restockListId/create-outlet-report'
    }
  });
}]);
'use strict'; // Setting up route

angular.module('restock-reports').config(['$stateProvider', function ($stateProvider) {
  // Restock Entries state routing
  $stateProvider.state('printRestockReport', {
    url: '/restock-reports/:restockReportId/print',
    templateUrl: 'modules/restock-reports/views/print-restock-report.client.view.html',
    resolve: {
      $title: _.constant('Print Restock Entry')
    }
  }).state('auto-restock', {
    url: '/restock-reports/auto',
    templateUrl: 'modules/restock-reports/views/auto-restock-report.client.view.html',
    resolve: {
      $title: _.constant('Auto Restock')
    }
  }).state('listRestockReports', {
    url: '/restock-reports',
    templateUrl: 'modules/restock-reports/views/list-restock-reports.client.view.html',
    resolve: {
      $title: _.constant('Restock Entries')
    }
  }).state('viewRestockReport', {
    url: '/restock-reports/:restockReportId',
    templateUrl: 'modules/restock-reports/views/view-restock-report.client.view.html',
    resolve: {
      $title: _.constant('View Restock Entry')
    }
  });
}]);
"use strict";

angular.module('restock-reports').controller('ModalReadyRestockReportController', ['$modalInstance', 'restockReportId', 'FhdMessenger', 'RestockReports', function ($modalInstance, restockReportId, FhdMessenger, RestockReports) {
  const vm = this;
  vm.restockReport = RestockReports.get({
    restockReportId
  });

  vm.submit = () => {
    vm.waiting = true;
    vm.restockReport.$ready().then(restockReport => {
      FhdMessenger.success('Đã gửi thông báo thành công');
      $modalInstance.close(restockReport);
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('restock-reports').controller('PrintRestockReportController', ['OutletService', 'RestockReports', 'RestockReportService', '$stateParams', '$interval', function (OutletService, RestockReports, RestockReportService, $stateParams, $interval) {
  const vm = this;
  vm.data = {};

  vm.findOne = () => {
    vm.data.now = new Date();
    $interval(() => {
      vm.data.now = new Date();
    }, 1000 * 60);
    vm.restockReport = RestockReports.get({
      restockReportId: $stateParams.restockReportId
    });
    vm.restockReport.$promise.then(() => {
      RestockReportService.attachProductionContionTypeText(vm.restockReport);
      vm.filterItems();
    });
  };

  vm.filterItems = function () {
    const restockWithoutCheckingStock = _.get(vm.restockReport, 'warehouseRestock.restockWithoutCheckingStock', false);

    const items = restockWithoutCheckingStock ? vm.restockReport.items : _.filter(vm.restockReport.items, item => {
      const enoughStock = (item.sku && item.sku.match(/^Z\d/) || item.khoQuantity >= 1 || _.get(item, 'product.mooncakeCategory.name') === 'Nhân handmade' || ['B2117', 'B3682'].includes(item.sku)) && item.restockQuantity > 0;
      const alwaysShowWhenRestock = item.alwaysShowWhenRestock;
      return enoughStock || alwaysShowWhenRestock;
    });
    vm.items = _.orderBy(items, ['currentLocation.code', 'description'], ['asc', 'asc']);

    _.forEach(vm.items, item => {
      item.restockQuantity = Math.round(item.restockQuantity * 10) / 10;
      item.khoQuantity = Math.round(item.khoQuantity * 10) / 10;
    });
  };
}]);
'use strict'; // Restock Entries controller

angular.module('restock-reports').controller('RestockReportsController', ['$scope', '$stateParams', '$location', 'Authentication', 'RestockReports', '$http', 'NgTableParams', 'ProductService', 'OutletService', 'ShiftService', 'ObjectId', 'FhdMessenger', 'Products', '$state', '$localStorage', 'ConfirmModal', '$window', 'RestockReportService', 'CurrentShift', function ($scope, $stateParams, $location, Authentication, RestockReports, $http, NgTableParams, ProductService, OutletService, ShiftService, ObjectId, FhdMessenger, Products, $state, $localStorage, ConfirmModal, $window, RestockReportService, CurrentShift) {
  const vm = this;
  vm.authentication = Authentication;
  vm.shift = 'C';
  vm.date = moment().format('L LT');
  vm.submitting = false;
  vm.noosMode = false;
  vm.user = Authentication.user;
  vm.startDate = moment().format('YYYY-MM-DD');
  vm.endDate = moment().format('YYYY-MM-DD');
  vm.unresolved = true;
  vm.resolved = false;
  vm.searchText = '';

  vm.canViewRestockReportFormula = () => {
    return _.intersection(vm.user.roles, ['admin', 'tro-ly-kho']).length || ['LOGISTICS', 'BUYING'].includes(_.get(vm.user, 'outlet.code'));
  };

  vm.resetProductConditionTypes = warehouseRestock => {
    vm.productConditionTypeMap = _.reduce(vm.productConditionTypes, (result, type) => {
      result[type.id] = warehouseRestock !== 'D4';
      return result;
    }, {});
  };

  const currentShift = CurrentShift.getCurrentShift();
  vm.currentWarehouse = _.get(currentShift, 'outlet.code');
  vm.warehouseRestock = /^D\d+/.test(vm.currentWarehouse) ? vm.currentWarehouse : '';
  vm.resetProductConditionTypes(vm.warehouseRestock);
  vm.productConditionTypes = RestockReportService.getProductConditionTypes();
  vm.productConditionTypeMap = _.reduce(vm.productConditionTypes, (result, type) => {
    result[type.id] = true;
    return result;
  }, {});
  vm.data = {
    mooncake: true,
    warehouseRestocks: ['D1', 'D2', 'D3', 'D4', 'D5'],
    productConditionTypeMap: _.reduce() // Remove existing Restock Entry

  };

  vm.remove = function (index, restockReport) {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Thôi',
      actionButtonText: 'Xóa Restock Entry',
      headerText: 'Xóa Restock Entry?',
      bodyText: `Bạn có chắc là bạn muốn xóa restock entry ${restockReport.restockReportId}?`
    }).then(() => {
      if (restockReport) {
        restockReport.$remove();
        vm.restockReportsTable.data.splice(index, 1);
        vm.restockReportsTable.settings({
          dataset: vm.restockReportsTable.data
        });
      } else {
        vm.restockReport.$remove(function () {
          $location.path('restock-reports');
        });
      }
    });
  };

  vm.selectedRestockReports = [];

  vm.selectedRestockReportsChanged = function (restockReport) {
    vm.selectedRestockReports = _.filter(vm.restockReports, {
      checked: true
    });
    vm.numberSelectedRestockReports = vm.selectedRestockReports.length;
  };

  vm.viewGroupedRestockReport = function () {
    var params = _.map(vm.selectedRestockReports, '_id');

    $state.go('groupedRestockReports', {
      'restock-reports': params
    });
  };

  vm.restockReportsTable = new NgTableParams({
    count: 10,
    sorting: {
      created: 'desc'
    }
  });
  vm.filterRestockReports = _.noop; // Find a list of Restock Entries

  vm.find = function () {
    vm.waiting = true;
    FhdMessenger.info('Đang tải...!');
    const searchText = _.isString(vm.searchText) ? vm.searchText.toUpperCase() : null;
    vm.restockReports = RestockReports.query({
      resolved: vm.resolved,
      unresolved: vm.unresolved,
      startDate: vm.startDate,
      endDate: vm.endDate,
      searchText: searchText
    });
    vm.restockReports.$promise.then(restockReports => {
      _.forEach(restockReports, RestockReportService.attachProductionContionTypeText);

      vm.restockReportsTable.settings({
        dataset: restockReports
      });
      FhdMessenger.success('Tải xong !');
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.restockTable = new NgTableParams({
    count: 1000
  }); // Load current stocks with sale data

  vm.productTable = new NgTableParams({
    count: 1000,
    counts: [20, 50, 100, 2000]
  });
  vm.suggestionProducts = []; // Restock Quantity changed

  vm.restockProducts = {};

  vm.restockQuantityChanged = function (product) {
    if (!product._id) return FhdMessenger.error('Không thấy _id sản phẩm ' + product.sku);
    vm.restockProducts[product._id] = product;

    if (vm.outlet) {
      let outletId = ObjectId.getObjectId(vm.outlet);
      $localStorage.setObject('restockReport-' + outletId, vm.restockProducts);
    }
  };

  vm.openReadyRestockReportModal = restockReport => {
    RestockReportService.openReadyRestockReportModal(restockReport._id).result.then(result => {
      restockReport.ready = result.ready;
    });
  };

  vm.resolve = function (restockReport) {
    $http.put('/restock-reports/' + restockReport._id + '/resolve').then(response => {
      const returnRestockReport = response.data;
      restockReport.resolved = returnRestockReport.resolved;
      FhdMessenger.success('Ok!');
    }, err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.filterProductByOutlet = _.curry((outlet, product) => {
    return product.format && outlet ? product.format[outlet.format] : true;
  });

  vm.autoRestock = () => {
    if (!_.get(vm.outlet, 'code')) return FhdMessenger.error('Chưa chọn cơ sở');
    if (!vm.warehouseRestock) return FhdMessenger.error('Chưa đăng nhập ca trực của kho');

    if (!vm.outlet.code.match(/^[ME]\d+/)) {
      return FhdMessenger.error('Cơ sở được chọn không nằm trong danh sách được tạo auto restock từ KHO');
    }

    const productConditionTypes = _.reduce(vm.productConditionTypeMap, (result, value, type) => {
      if (value) return result.concat(type);
      return result;
    }, []);

    if (!productConditionTypes.length) {
      return FhdMessenger.error('Bạn chưa chọn điều kiện bảo quản của sản phẩm restock');
    }

    vm.waiting = true;
    RestockReportService.getDuplicateRestockReport(vm.outlet.code, vm.warehouseRestock, productConditionTypes).then(duplicateRestockReport => {
      if (!duplicateRestockReport) {
        return createAutoRestockReport();
      }

      const content = `đã được tạo bởi ${duplicateRestockReport.user.displayName} - vào ${moment(duplicateRestockReport.created).format('L LT')}`;
      ConfirmModal.showModal({}, {
        actionButtonText: `Xác nhận`,
        bodyText: `Restock Reports cho ${vm.outlet.code} ${content} , bạn có muốn tiếp tục tạo ?`
      }).then(() => {
        createAutoRestockReport();
      });
    });

    function createAutoRestockReport() {
      let promise = $http.get('/manage/restock', {
        params: {
          outletCode: vm.outlet.code,
          warehouseRestock: vm.warehouseRestock,
          productConditionTypes
        }
      }).then(response => response.data).then(restockReports => {
        $state.go('listRestockReports');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
      FhdMessenger.notifyLoading('Đang tạo...', promise, () => {
        FhdMessenger.success('Ok!');
      });
    }
  };

  vm.checkMissingRestock = restockReport => {
    vm.waiting = true;
    FhdMessenger.info('Đang kiểm tra missing');
    restockReport.$checkMissingRestock().then(missingRestock => {
      const url = $state.href('viewMissingRestock', {
        missingRestockId: missingRestock._id
      });
      $window.open(url, '_blank');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.createStockEntry = restockReport => {
    $localStorage.setObject('restockReport', restockReport);
    $window.open(`${$location.protocol()}://${$location.host()}${$location.port() !== 80 ? `:${$location.port()}` : ''}/#!/stock-entries/create`, '_blank');
  };
}]);
"use strict";

angular.module('restock-reports').controller('ViewRestockReportController', ['$stateParams', 'Authentication', 'RestockReports', 'FhdMessenger', '$state', 'NgTableParams', 'RestockReportService', function ($stateParams, Authentication, RestockReports, FhdMessenger, $state, NgTableParams, RestockReportService) {
  const vm = this;
  vm.data = {};
  vm.user = Authentication.user;
  vm.statuses = ['Yes', 'No'].map(it => {
    return {
      id: it,
      title: it
    };
  });
  vm.restockTable = new NgTableParams();

  vm.findOne = () => {
    vm.restockReport = RestockReports.get({
      restockReportId: $stateParams.restockReportId
    });
    vm.restockReport.$promise.then(() => {
      RestockReportService.attachProductionContionTypeText(vm.restockReport);

      const restockWithoutCheckingStock = _.get(vm.restockReport, 'warehouseRestock.restockWithoutCheckingStock', false);

      const items = _.map(vm.restockReport.items, item => {
        if (restockWithoutCheckingStock) {
          item.status = 'Yes';
          return item;
        }

        item.status = item.restockQuantity <= 0 || item.khoQuantity <= 0 && _.get(item, 'product.mooncakeCategory.name') !== 'Nhân handmade' && !['B2117', 'B3682'].includes(item.sku) && !item.alwaysShowWhenRestock ? 'No' : 'Yes';
        return item;
      });

      vm.restockTable.settings({
        dataset: items
      });
      vm.restockTable.filter().status = 'Yes';
    });
  };
}]);
'use strict'; // Restock Entries service used to communicate Restock Entries REST endpoints

