angular.module('sale-code-requests').controller('SaleCodeRequestsController', ['Authentication', 'SaleCodeRequests', 'ProductService', 'FhdMessenger', '$state', 'NgTableParams', '$scope', 'CurrentShift', '$window', function (Authentication, SaleCodeRequests, ProductService, FhdMessenger, $state, NgTableParams, $scope, CurrentShift, $window) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.waiting = false;
  vm.images = [];
  vm.saleCodeRequest = {};

  const currentOutlet = _.get(CurrentShift.getCurrentShift(), 'outlet', vm.user.outlet);

  vm.getType = () => [{
    id: 'closeToDate',
    title: 'Cận date'
  }, {
    id: 'defectiveProduct',
    title: 'Lỗi hàng nhà sản xuất'
  }, {
    id: 'defectivePl',
    title: 'Lỗi hàng Pl'
  }, {
    id: 'defectiveAtStore',
    title: 'Lỗi phát hiện tại cửa hàng'
  }];

  function makeSaleCodeId() {
    var text = 'S';
    var possible = '0123456789';

    for (var i = 0; i < 8; i++) text += possible.charAt(Math.floor(Math.random() * possible.length));

    return text;
  }

  vm.saleCodeRequestTable = new NgTableParams();

  function attachOutletText(saleCodes) {
    _.forEach(saleCodes, saleCode => {
      saleCode.outletText = (_.map(saleCode.outlets, 'code') || []).join(', ');
    });
  }

  $scope.$watch(() => vm.product, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    vm.typeGroup = 'non-food';

    if (_.get(newValue, 'category')) {
      if (ProductService.isFoodProduct(newValue)) vm.typeGroup = 'food';
    }
  });
  $scope.$watch(() => vm.product, item => {
    ProductService.getSoldPrice(item, currentOutlet).then(soldPrice => {
      item.soldPrice = soldPrice;
    });
  });

  vm.find = () => {
    const promises = SaleCodeRequests.query({
      outlet: _.get(CurrentShift.getCurrentShift(), 'outlet._id')
    }).$promise;
    promises.then(saleCodes => {
      vm.saleCodeRequests = _.reduce(saleCodes, (result, saleCode) => {
        if (saleCode.expiryDate) {
          saleCode.diffDay = Math.round(moment(saleCode.expiryDate).diff(moment()) / (1000 * 60 * 60 * 24)); // console.log(saleCode.diffDay)

          saleCode.hasExpiryDate = 1;

          if (saleCode.diffDay < 14) {
            saleCode.warning = true;
          }
        } else {
          saleCode.hasExpiryDate = 0;
        }

        if (saleCode.product) {
          const cogs = ProductService.getOutletProperty('cogs', saleCode.outlets[0], saleCode.product);
          const price = ProductService.getOutletProperty('price', saleCode.outlets[0], saleCode.product);
          const salePrice = ProductService.getOutletProperty('salePrice', saleCode.outlets[0], saleCode.product);
          const outletPrice = ProductService.getOutletProperty('salePrice', _.get(saleCode, 'outlets.0'), saleCode.product) || saleCode.price;
          saleCode.saleCodeWarning = saleCode.salePrice > outletPrice;
          saleCode.product.price = price;
          saleCode.product.cogs = cogs;
          saleCode.product.salePrice = salePrice;
        }

        result.push(saleCode);
        return result;
      }, []);
      attachOutletText(vm.saleCodeRequests);
      vm.saleCodeRequestTable.settings({
        dataset: vm.saleCodeRequests
      }).sorting({
        totalPrice: 'desc',
        hasExpiryDate: 'desc',
        diffDay: 'asc'
      });
    });
  };

  vm.create = () => {
    if (!vm.product) {
      return FhdMessenger.error('Chưa nhập sản phẩm nào');
    }

    if (!vm.quantity) {
      return FhdMessenger.error('Chưa nhập số lượng');
    }

    if (!vm.images.length) {
      return FhdMessenger.error('Chưa có ảnh sản phẩm');
    }

    if (!vm.type) {
      return FhdMessenger.error('Chưa có phân loại Sale Code');
    }

    if (!vm.outlet) {
      return FhdMessenger.error('Chưa có cơ sở áp dụng');
    }

    if (vm.typeGroup === 'food') {
      if (!vm.expiryDate) {
        return FhdMessenger.error('Chưa có date sản phẩm');
      }
    }

    if (vm.expiryDate && moment(vm.expiryDate).isBefore(moment())) {
      return FhdMessenger.error(`Ngày hết hạn phải sau ngày hôm nay. Hiện tại bạn đang nhập ngày hết hạn là ${moment(vm.expiryDate).format('YYYY/MM/DD')}`);
    }

    if (vm.type && vm.type !== 'closeToDate' && !vm.note) {
      return FhdMessenger.error('Chưa có ghi chú mô tả mặt hàng');
    }

    const saleCodeRequest = new SaleCodeRequests({
      saleCodeId: makeSaleCodeId(),
      product: vm.product._id,
      sku: vm.product.sku,
      description: vm.product.description,
      outletExclusive: vm.outletExclusive,
      outlets: [vm.outlet] || [],
      originalQuantity: vm.quantity,
      quantity: vm.quantity,
      status: 'pending',
      typeGroup: vm.typeGroup,
      salePrice: 0,
      user: vm.user,
      type: vm.type,
      images: vm.images,
      note: vm.note,
      expiryDate: vm.expiryDate
    });
    vm.waiting = true;
    saleCodeRequest.$save().then(() => {
      FhdMessenger.success('Tạo Sale Code Request thành công');
      $state.go('listSaleCodeRequests');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.update = saleCode => {
    vm.waiting = true;
    saleCode.$update().then(res => {
      FhdMessenger.success('Cập nhật thành công');
      vm.saleCodeRequestTable.reload();
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.approve = saleCode => {
    if (!saleCode.salePrice) {
      return FhdMessenger.error('Chưa có giá sale');
    }

    vm.waiting = true;
    saleCode.$approve().then(res => {
      FhdMessenger.success('Cập nhật thành công');

      _.remove(vm.saleCodeRequests, saleCodeRequest => saleCodeRequest._id === saleCode._id);

      vm.saleCodeRequestTable.settings({
        dataset: vm.saleCodeRequests
      });
      vm.saleCodeRequestTable.reload();
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.disapprove = saleCode => {
    vm.waiting = true;
    saleCode.disableReason = $window.prompt('Nhập lý do xóa sale code: ');

    if (!saleCode.disableReason) {
      return FhdMessenger.error('Chưa nhập lý do xóa sale code');
    }

    saleCode.$disapprove().then(res => {
      FhdMessenger.success('Cập nhật thành công');

      _.remove(vm.saleCodeRequests, saleCodeRequest => saleCodeRequest._id === saleCode._id);

      vm.saleCodeRequestTable.settings({
        dataset: vm.saleCodeRequests
      });
      vm.saleCodeRequestTable.reload();
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.changeSalePercent = saleCode => {
    if (saleCode.salePercent) {
      saleCode.salePrice = saleCode.product.price * (100 - saleCode.salePercent) / 100;
    } else {
      saleCode.salePrice = 0;
    }
  };

  vm.changeSalePrice = saleCode => {
    if (saleCode.salePrice) {
      saleCode.salePercent = Math.round((saleCode.product.price - saleCode.salePrice) / saleCode.product.price * 100 * 100) / 100;
    } else {
      saleCode.salePercent = 0;
    }
  };
}]);
"use strict";

angular.module('sale-code-requests').factory('SaleCodeRequests', ['$resource', function ($resource) {
  return $resource('sale-code-requests/:saleCodeRequestId', {
    saleCodeRequestId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    approve: {
      method: 'PUT',
      url: '/sale-code-requests/:saleCodeRequestId/approve'
    },
    disapprove: {
      method: 'PUT',
      url: '/sale-code-requests/:saleCodeRequestId/disapprove'
    }
  });
}]);
"use strict";

angular.module('sale-codes').config(['$stateProvider', function ($stateProvider) {
  $stateProvider.state('listSaleCodes', {
    url: '/sale-codes',
    templateUrl: 'modules/sale-codes/views/list-sale-codes.client.view.html',
    resolve: {
      $title: _.constant('Sale Codes')
    }
  }).state('createSaleCode', {
    url: '/sale-codes/create',
    templateUrl: 'modules/sale-codes/views/create-sale-code.client.view.html',
    resolve: {
      $title: _.constant('Create Sale Codes')
    }
  }).state('editSaleCode', {
    url: '/sale-codes/:saleCodeId',
    templateUrl: 'modules/sale-codes/views/edit-sale-code.client.view.html',
    resolve: {
      $title: _.constant('Edit Sale Code')
    }
  }).state('editSaleCodeForStaff', {
    url: '/sale-codes/:saleCodeId/update-info',
    templateUrl: 'modules/sale-codes/views/update-sale-code-info.client.view.html',
    resolve: {
      $title: _.constant('Update Sale Code Info')
    }
  });
}]);
