angular.module('products').factory('SellingProfiles', ['$q', function ($q) {
  const sellingProfiles = [{
    id: 'all',
    label: 'Bán ở tất cả cơ sở'
  }, {
    id: 'north:all',
    label: 'Chỉ bán Hà Nội'
  }, {
    id: 'south:all',
    label: 'Chỉ bán HCM'
  }, {
    id: 'online',
    label: 'Chỉ bán online'
  }, {
    id: '900',
    label: '900 sku'
  }, {
    id: '1200',
    label: '1200 sku'
  }, {
    id: '1500',
    label: '1500 sku'
  }, {
    id: 'Big Store',
    label: 'Big Store'
  }];
  return {
    query() {
      return $q.when(sellingProfiles);
    },

    getStopSell(displayStockProfileId, outletCode, region, format) {
      if (displayStockProfileId === 'online') return true;

      if (displayStockProfileId === 'south:all') {
        return region !== 'SOUTH';
      }

      if (displayStockProfileId === 'Big Store') {
        return !['Big Store'].includes(format);
      }

      if (displayStockProfileId === '1500') {
        return !['1500', 'Big Store'].includes(format);
      }

      if (displayStockProfileId === '1200') {
        return !['1200', '1500', 'Big Store'].includes(format);
      }

      if (displayStockProfileId === '900') {
        return !['900', '1200', '1500', 'Big Store'].includes(format);
      }

      if (displayStockProfileId === 'central:all') {
        return region !== 'CENTRAL';
      }

      if (displayStockProfileId === 'north:all') {
        return region !== 'NORTH';
      }

      if (displayStockProfileId === 'all') {
        return !outletCode.match(/^[ME]\d+/);
      }

      return null;
    }

  };
}]);
"use strict";

