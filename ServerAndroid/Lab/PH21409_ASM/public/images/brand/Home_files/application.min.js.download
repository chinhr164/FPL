angular.module('stock-entries').controller('StockEntriesController', ['$state', '$scope', '$stateParams', '$location', 'Authentication', 'ComplaintService', 'StockEntries', 'ObjectId', 'OnlineOrderService', 'FhdMessenger', 'StockEntryService', 'NgTableParams', 'hotkeys', '$localStorage', 'ConfirmModal', 'CurrentShift', '$http', '$timeout', '$window', 'JsPrintService', 'OutletService', 'RestockReports', 'PreventUnsave', 'UserPhotoService', 'LogisticsRequests', 'UserNoteService', 'ProductService', function ($state, $scope, $stateParams, $location, Authentication, ComplaintService, StockEntries, ObjectId, OnlineOrderService, FhdMessenger, StockEntryService, NgTableParams, hotkeys, $localStorage, ConfirmModal, CurrentShift, $http, $timeout, $window, JsPrintService, OutletService, RestockReports, PreventUnsave, UserPhotoService, LogisticsRequests, UserNoteService, ProductService) {
  const vm = $scope;
  vm.user = Authentication.user;
  vm.isKho = vm.user.roles.includes('kho');
  vm.openCreateComplaintModal = ComplaintService.openCreateComplaintModal;
  vm.images = [];

  vm.enoughItems = function (stockEntry) {
    stockEntry.$enoughItems().then(result => {
      FhdMessenger.success('Đã chuyển thành đủ hàng');
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.openDoneReturnStockEntry = function (stockEntry) {
    StockEntryService.openDoneReturnStockEntry(stockEntry).result.then(result => {
      vm.stockEntry = result;
    });
  };

  vm.tableUserNotes = new NgTableParams({
    count: 10
  });

  vm.openAddUserNoteModal = userNote => {
    UserNoteService.openAddUserNoteModal(userNote).then(userNotes => {
      vm.tableUserNotes.data.unshift(...userNotes);
    });
  };

  vm.init = function () {
    vm.statusMap = {
      delivered: true,
      received: false,
      deleted: false
    };
    vm.endDate = moment().add(1, 'days').format('YYYY-MM-DD');
    vm.startDate = moment(vm.endDate).subtract(3, 'week').format('YYYY-MM-DD');
  };

  vm.currentShift = CurrentShift.getCurrentShift();
  vm.needOutlets = !_.intersection(vm.user.roles, ['admin', 'tro-ly-kho']).length;
  vm.data = {
    outlet: null,
    destination: null,
    staff: vm.user,
    disableInputDestination: false
  };
  vm.data.statuses = StockEntryService.getStatuses();
  vm.data.allStatuses = StockEntryService.getAllStatuses();
  vm.currentStatus = _.head(vm.data.statuses).status;
  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus;
  vm.date = moment().startOf('day').format('YYYY-MM-DD');
  vm.items = [];

  vm.openAddBillNumberModal = stockEntry => {
    StockEntryService.openAddBillNumberModal(stockEntry).result.then(stockEntry => {
      vm.stockEntry = stockEntry;
    });
  };

  vm.loadPackingOutlet = async function () {
    const {
      PACKING_OUTLET_CODES
    } = await OutletService.getOutletCodes();
    vm.packingOutletCodes = _.reject(PACKING_OUTLET_CODES, 'G4');
  };

  vm.loadLocalStorage = function () {
    const items = $localStorage.getObject('stockEntryItems');

    if (_.get(items, 'length')) {
      ConfirmModal.showModal({}, {
        closeButtonText: 'Hủy',
        actionButtonText: 'Xác nhận',
        headerText: 'Xác nhận tự động nhập danh sách sản phẩm',
        bodyText: `Có ${items.length} sản phẩm được lưu trong bộ nhớ trình duyệt. Bạn có muốn nhập các sản phẩm vào trong Logistic Entry`
      }).then(() => {
        vm.items = items;
        updateForStockEntry(items);
      });
    } else {
      updateForStockEntry([]);
    }
  };

  function updateForStockEntry(stockEntryItems) {
    const restockReport = $localStorage.getObject('restockReport');

    const restockReportId = _.get(restockReport, 'restockReportId');

    const restockList = $localStorage.getObject('restockList');

    const restockListId = _.get(restockList, '_id');

    const logisticsRequest = $localStorage.getObject('logisticsRequest');

    if (logisticsRequest && logisticsRequest._id) {
      const logisticsRequestId = ObjectId.getObjectId(logisticsRequest);
      vm.logisticsRequest = LogisticsRequests.get({
        logisticsRequestId: logisticsRequestId
      });
      vm.logisticsRequest.$promise.then(() => {
        const {
          destination,
          outlet
        } = vm.logisticsRequest;
        let changedObject = {
          destination,
          outlet
        };
        vm.setValue(changedObject);
        $localStorage.set('logisticsRequest', null);
      }).catch(() => {
        FhdMessenger.error(`Không load được dữ liệu Logistics Request`);
        $localStorage.set('logisticsRequest', null);
      });
    } else if (restockReportId) {
      vm.restockReport = RestockReports.get({
        restockReportId: _.get(restockReport, '_id')
      });
      vm.restockReport.$promise.then(() => {
        const {
          outlet,
          warehouseRestock,
          assignedStaff
        } = vm.restockReport;
        vm.setValue({
          outlet: warehouseRestock,
          staff: assignedStaff,
          destination: outlet,
          items: stockEntryItems
        });
        $localStorage.set('restockReport', null);
      });
    } else if (restockListId) {
      let {
        items,
        outlet
      } = restockList;

      const warehouseRestock = _objectSpread({}, items[0].warehouseRestock);

      if (warehouseRestock.code === 'B3') {
        items = _.map(items, item => {
          return _objectSpread({}, item, {
            warehouseRestock: item.product.warehouseRestock,
            quantity: item.restockQuantity
          });
        });
      } else {
        items = [];
      }

      vm.restockList = restockList;

      if (restockList.wholesaleOrder) {
        vm.wholesaleOrder = restockList.wholesaleOrder;
        vm.businessCustomer = restockList.wholesaleOrder.businessCustomer;
      }

      vm.setValue({
        outlet: warehouseRestock,
        destination: outlet,
        staff: vm.user,
        items: _.get(stockEntryItems, 'length') ? stockEntryItems : items
      });
      $localStorage.set('restockList', null);
    } else {
      if (vm.currentShift.outlet) {
        vm.data.disableInputOutlet = true;

        if (_.get(vm.currentShift, 'outlet.code') === 'D6') {
          OutletService.findOutletFromCode('M6').then(destination => {
            vm.data.outlet = destination;
          });
        } else if (['B2', 'B5', 'B6'].includes(_.get(vm.currentShift, 'outlet.code'))) {
          OutletService.findOutletFromCode('B1').then(destination => {
            vm.data.outlet = destination;
          });
        } else {
          vm.data.outlet = vm.currentShift.outlet;
        }
      }
    }
  }

  vm.setValue = function ({
    items = [],
    staff,
    outlet,
    destination,
    isDisableInputDestination = true,
    isDisableInputOutlet = true
  }) {
    vm.items = items;
    vm.data.outlet = outlet;
    vm.data.destination = destination;
    vm.data.disableInputDestination = isDisableInputDestination;
    vm.data.disableInputOutlet = isDisableInputOutlet;
    vm.data.staff = staff;
  };

  vm.getStateParams = function () {
    if ($stateParams.period === 'month') {
      vm.startDate = moment().subtract(30, 'day').format('YYYY-MM-DD');
      vm.endDate = moment().format('YYYY-MM-DD');
    }
  };

  vm.done = function (stockEntry) {
    vm.waiting = true;
    stockEntry.$done().then(result => {
      stockEntry.done = result.done;
      FhdMessenger.success(`Đã xử lí đơn thu hồi`);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.addStatus = function (stockEntry, newStatus) {
    const currentShift = CurrentShift.getCurrentShift();
    const outlet = currentShift.outlet ? currentShift.outlet._id : null;
    const shift = currentShift.shift || undefined;
    const status = {
      status: newStatus,
      time: new Date(),
      staff: vm.user._id,
      outlet,
      shift
    };
    $http.post(`stock-entries/${stockEntry._id}/statuses`, status).success(function (response) {
      stockEntry.history.push(status);
      stockEntry.currentStatus = response.currentStatus;
      FhdMessenger.info('Cập nhật thành công');
    }).error(function (err) {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.updateFeedback = function (stockEntry, newStatus) {
    const modal = StockEntryService.openUpdateFeedback(stockEntry, newStatus);
    modal.result.then().then(() => {
      FhdMessenger.info('Cập nhật thành công');
    });
  };

  vm.confirmReceived = function () {
    vm.updateFeedback(vm.stockEntry, 'received');
  };

  vm.changeToLostStatus = () => {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Thoát',
      actionButtonText: 'Confirm hàng chưa về',
      headerText: 'Hàng chưa về?',
      bodyText: `Đơn hàng ${vm.stockEntry.stockEntryId} đã quá ngày dự kiến hàng về nhưng bạn vẫn chưa nhận được hàng?`
    }).then(() => {
      vm.addStatus(vm.stockEntry, 'lost');
    });
  };

  vm.getItemsError = items => {
    const tooLargeQuantityItem = _.find(items, item => {
      return item.quantity > 100000 && item.sku.match(/^B\d+/);
    });

    if (tooLargeQuantityItem) {
      return `${tooLargeQuantityItem.sku} ${tooLargeQuantityItem.description} có số lượng chuyển quá lớn!`;
    }

    return null;
  }; // Create new Logistics Entry


  vm.create = function () {
    const outletCode = _.get(vm.data, 'outlet.code');

    const outletRegion = _.get(vm.data, 'outlet.region');

    const destinationCode = _.get(vm.data, 'destination.code');

    if (outletCode === destinationCode) {
      return FhdMessenger.error('Cơ sở gửi không được giống cơ sở nhận.');
    } // Nhân viên bán hàng sẽ không có quyền tạo LE


    if (_.includes(vm.user.roles, 'sale') && !_.intersection(vm.user.roles, ['admin', 'tro-ly', 'kho', 'kitchen', 'admin-merchandise', 'stock-entry:create'].length) && !outletCode.match(/^[SK]\d/) && // Với các cơ sở miền Trung, Nam thì nhân viên bán hàng có thể tạo LE do trợ lý không ở cơ sở để xử lý
    !['CENTRAL', 'SOUTH'].includes(outletRegion) && destinationCode !== 'TRASH') {
      return FhdMessenger.error('Người dùng không có quyền tạo Logistic Entry với cơ sở đã chọn');
    }

    if (!_.get(vm.currentShift, '_id') && vm.user.roles.includes('tro-ly') && !_.intersection(vm.user.roles, ['admin', 'kho', 'admin-merchandise', 'stock-entry:create']).length) {
      if (!(_.some(vm.user.managingOutlets, managingOutlet => managingOutlet.code === outletCode) || outletCode === _.get(vm.user, 'outlet.code'))) {
        return FhdMessenger.error('Bạn chỉ được tạo Logistic Entry từ cơ sở mà mình đang quản lý!');
      }
    }

    if (!vm.data.staff) {
      return FhdMessenger.error('Chưa chọn nhân viên gửi.');
    }

    if (!vm.items.length) {
      return FhdMessenger.error('Chưa có danh sách hàng trong LE');
    }

    if (_.some(vm.items, item => {
      return item.showInputManufacturingDate && !item.manufacturingDate;
    })) {
      return FhdMessenger.error('Có sản phẩm chưa nhập ngày SX');
    }

    if (_.some(vm.items, item => {
      return item.quantity <= 0;
    })) {
      return FhdMessenger.error('Sản phẩm phải có số lượng lớn hơn 0');
    }

    const missingNote = _.some(vm.items, item => {
      return !item.note;
    });

    if (destinationCode === 'TRASH') {
      if (!vm.images || !vm.images.length) {
        return FhdMessenger.error('Hàng tiêu hủy cần có ảnh');
      }

      if (missingNote) {
        return FhdMessenger.error('Có sản phẩm chưa có lý do tiêu hủy');
      }

      const missingSaleCodeItems = _.filter(vm.items, item => {
        const note = _.get(item, 'note', '').replace(/[()]/gim, '');

        return note.match(/Quá date.*S\d{8}$/gim) && !item.saleCode;
      });

      if (missingSaleCodeItems.length) {
        return FhdMessenger.errorStick('Các sản phẩm sau phải nhập sản phẩm tiêu hủy bằng cách nhập mã sale code vào phần tìm kiểm: ' + _.map(missingSaleCodeItems, item => `${item.sku} - ${item.description}`).join(', '));
      }
    }

    if (destinationCode === 'R&D' && missingNote) {
      return FhdMessenger.error('Có sản phẩm chưa có lý do chuyển R&D');
    }

    if (destinationCode.match(/D\d+/) && outletCode === 'VENDOR' && !_.get(vm.images, 'length')) {
      return FhdMessenger.error('LE từ vendor về kho phải có ');
    }

    if (destinationCode.match(/S\d+/) && outletCode.match(/B\d+/)) {
      const skus = ['V1948', 'V1943'];

      const filterItems = _.filter(vm.items, item => {
        return skus.includes(item.sku);
      });

      if (filterItems.length === 1) {
        return FhdMessenger.error('Các mã ' + skus.join(' ') + ' phải được chuyển cùng nhau');
      }
    }

    if (_.some(vm.items, item => {
      return item.note && item.note.match(/(Cuối ca|Quá 3 tiếng)/i) && !['V0686', 'V0636', 'V0628'].includes(item.sku);
    })) {
      return FhdMessenger.error('Chỉ các mã V0686 - Nước cốt lục trà (ml); V0636 - Nước cốt hồng trà (g); V0628 - Trân châu đường đen (g) mới được tiêu hủy với lý do cuối ca ');
    }

    if (_.includes(vm.packingOutletCodes, destinationCode)) {
      const missingRawProductItems = _.filter(vm.items, item => {
        return !_.get(item.rawProducts, 'length') && item.privateLabel;
      });

      if (missingRawProductItems.length) {
        return FhdMessenger.error(`Các sản phẩm (${_.map(missingRawProductItems, 'sku').join(', ')}) là hàng PL và không có hàng RAW tương ứng nên không được chuyển đến DG, vui lòng kiểm tra lại hoặc báo Buying/BS để được xử lý`);
      }
    }

    if (vm.needOutlets) {
      if (!_.get(vm.data, 'outlet._id')) {
        return FhdMessenger.error('Cần phải có cơ sở gửi hàng');
      }

      if (!_.get(vm.data, 'destination.code')) {
        return FhdMessenger.error('Cần phải có cơ sở nhận hàng');
      }
    }

    if (['B1', 'B2'].includes(outletCode) && destinationCode.match(/S\d+/)) {
      if (outletCode === 'B2' && _.some(vm.items, item => {
        return _.get(item, 'category.cat.name') === 'Bánh sinh nhật' && item.sku.match(/V\d+/);
      }) && !_.some(vm.items, {
        sku: 'Z0070'
      })) {
        return FhdMessenger.error(`Bạn phải điền số lượng thùng nhựa sử dụng khi chuyển bánh sinh nhật cho cơ sở`);
      }

      const boxItems = _.filter(vm.items, item => {
        return ['V0200', 'V0201'].includes(item.sku);
      });

      if (_.get(boxItems, 'length') < 2) {
        const confirm = $window.confirm('Bạn có chắc chắn muốn tạo LE không bao gồm nắp và hộp');
        if (!confirm) return;
      }
    }

    const itemError = vm.getItemsError(vm.items);

    if (itemError) {
      FhdMessenger.error(itemError);
      return;
    }

    if (outletCode.match(/[D]\d+/) && destinationCode.match(/[ME]\d+/) && !['cypress', 'test'].includes($scope.environment)) {
      vm.waiting = true;
      return ProductService.getStopSellProduct(vm.items, destinationCode).then(stopSellItems => {
        vm.waiting = false;

        if (!stopSellItems.length) {
          return createLogisticsEntry();
        }

        const notifyContent = _.reduce(stopSellItems, (result, stopSellItem) => {
          result += `• ${stopSellItem.sku} - ${stopSellItem.description}\n`;
          return result;
        }, '');

        ConfirmModal.showModal({}, {
          actionButtonText: `Xác nhận`,
          bodyText: `Có ${stopSellItems.length} sản phẩm đã ngừng bán ở ${vm.data.destination.code}\n${notifyContent}`
        }).then(() => {
          createLogisticsEntry();
        });
      });
    }

    return createLogisticsEntry(); // Create new Logistics Entry object

    function createLogisticsEntry() {
      let stockEntry = {
        stockEntryId: vm.stockEntryId,
        stockEntryNumber: vm.stockEntryNumber,
        restockReport: _.get(vm.restockReport, '_id', null),
        restockList: _.get(vm.restockList, '_id', null),
        wholesaleOrder: vm.wholesaleOrder,
        businessCustomer: vm.businessCustomer,
        staff: vm.data.staff,
        outlet: vm.data.outlet,
        destination: vm.data.destination,
        receiver: vm.receiver,
        note: vm.data.note,
        items: _.orderBy(vm.items, 'sku'),
        date: vm.date,
        currentStatus: vm.currentStatus,
        numberOfPackages: vm.numberOfPackages,
        images: vm.images,
        shipping: {
          isAdhoc: vm.isAdhoc,
          pay: vm.pay,
          billNumber: vm.billNumber
        }
      };

      if (vm.logisticsRequest) {
        stockEntry.logisticsRequest = vm.logisticsRequest;
      }

      stockEntry.history = [{
        status: vm.currentStatus,
        outlet: ObjectId.getObjectId(vm.data.outlet),
        staff: vm.data.staff
      }];
      stockEntry.staffHistory = [{
        status: String,
        targetStaff: ObjectId.getObjectId(vm.targetStaff) || vm.user._id,
        staff: vm.data.staff
      }];
      stockEntry = ObjectId.getNewObjectWithObjectIds(['outlet', 'staff', 'destination', 'receiver'], stockEntry);
      vm.waiting = true;
      stockEntry = new StockEntries(stockEntry); // Redirect after save

      stockEntry.$save().then(response => {
        PreventUnsave.setPreventUnsave(false);
        vm.items = [];
        FhdMessenger.success('Tạo Logistic Entry ');
        $localStorage.setObject('stockEntryItems', []);
        $localStorage.setObject('stockEntryMeta', {});
        $localStorage.setObject('restockReport', {});
        $localStorage.setObject('logisticsEntry', {});
        $location.path(`stock-entries/${response._id}`);

        if (_.get(stockEntry, 'outlet.code') !== 'D1' && _.get(stockEntry, 'destination.code') !== 'TRASH') {
          $localStorage.set('toPrint', true);
        }
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    }
  };

  vm.remove = StockEntryService.openDeleteStockEntryModal; // Update existing Logistics Entry

  vm.update = function ($event) {
    $event.preventDefault();
    $event.stopPropagation();
    if (!$event.screenX) return;
    const stockEntry = vm.stockEntry;

    if (!stockEntry.reasonForEditing) {
      return FhdMessenger.error('Chưa có lý do sửa !');
    }

    vm.waiting = true;
    stockEntry.$update().then(stockEntry => {
      $location.path(`stock-entries/${stockEntry._id}`);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.stockEntriesTable = new NgTableParams({
    count: 50
  }); // Find a list of Logistics Entries

  vm.find = function () {
    const searchText = vm.searchText;

    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const currentShift = CurrentShift.getCurrentShift();

    const outletCode = _.get(currentShift, 'outlet.code');

    const startDate = vm.startDate ? moment(vm.startDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    const endDate = vm.endDate ? moment(vm.endDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    vm.stockEntries = StockEntries.query({
      destination: ObjectId.getObjectId(vm.destination),
      outlet: ObjectId.getObjectId(vm.outlet),
      searchText,
      statuses,
      startDate,
      endDate,
      currentOutletCode: outletCode
    }, function (stockEntries) {
      if (stockEntries && stockEntries.length === 500) {
        FhdMessenger.info('Chỉ hiện 500 kết quả gần đây nhất. Hãy thu hẹp khoảng thời gian hoặc lọc theo cơ sở để tải đầy đủ kết quả.');
      }

      vm.stockEntriesTable.settings({
        dataset: stockEntries
      });
      vm.stockEntriesTable.sorting({
        delivered: 'desc'
      });
    });
    FhdMessenger.notifyLoading('Đang tải Logistics Entries...', vm.stockEntries.$promise, () => {
      FhdMessenger.success('Đã tải xong!');
    });
  };

  vm.stockEntryTable = new NgTableParams({
    count: 3000
  }, {
    counts: []
  });
  vm.barcodeItemsTable = new NgTableParams({
    count: 3000
  }, {
    counts: []
  });
  vm.frozenItemsTable = new NgTableParams({
    count: 3000
  }, {
    counts: []
  });
  vm.coolItemsTable = new NgTableParams({
    count: 3000
  }, {
    counts: []
  });
  vm.newItemsTable = new NgTableParams({
    count: 100
  }, {
    counts: []
  });
  vm.rawItemsTable = new NgTableParams({
    count: 100
  }, {
    counts: []
  }); // Find existing Logistics Entry

  vm.findOne = function () {
    vm.waiting = true;
    vm.stockEntry = StockEntries.get({
      stockEntryId: $stateParams.stockEntryId
    }, function (stockEntry) {
      const coolItems = [];
      const frozenItems = [];
      const barcodeItems = [];
      const otherItems = [];
      UserNoteService.getUserNotesByStockEntry(stockEntry._id).then(userNotes => {
        vm.tableUserNotes.settings({
          dataset: userNotes
        });
      });
      vm.canRemove = !stockEntry.note.match(/Quy đổi từ mã/) && stockEntry.currentStatus !== 'deleted';

      _.forEach(stockEntry.items, item => {
        if (item.hidden) return;

        if (_.get(item, 'product.warehouseGroup.name') === 'Tủ mát') {
          coolItems.push(item);
        } else if (_.get(item, 'product.warehouseGroup.name') === 'Tủ đông') {
          frozenItems.push(item);
        } else if (_.get(item, 'product.barcode')) {
          barcodeItems.push(item);
        } else {
          otherItems.push(item);
        }
      });

      vm.totalWeight = _.sumBy(vm.stockEntry.items, item => {
        return _.get(item, 'product.netWeight', 0) * item.quantity;
      });
      vm.stockEntryTable.settings({
        dataset: otherItems
      });
      vm.stockEntryTable.sorting({
        sku: 'asc'
      });
      vm.barcodeItemsTable.settings({
        dataset: barcodeItems
      });
      vm.barcodeItemsTable.sorting({
        description: 'asc'
      });
      vm.frozenItemsTable.settings({
        dataset: frozenItems
      });
      vm.frozenItemsTable.sorting({
        description: 'asc'
      });
      vm.coolItemsTable.settings({
        dataset: coolItems
      });
      vm.coolItemsTable.sorting({
        description: 'asc'
      });
      vm.newItemsTable.settings({
        dataset: stockEntry.newItems
      });
      vm.newItemsTable.sorting({
        description: 'asc'
      });
      vm.rawItemsTable.settings({
        dataset: stockEntry.rawItems
      });
      vm.rawItemsTable.sorting({
        description: 'asc'
      });
      vm.hasCoolItems = _.get(coolItems, 'length') > 0;
      vm.hasFrozenItems = _.get(frozenItems, 'length') > 0;
      vm.hasBarcodeItems = _.get(barcodeItems, 'length') > 0;
      vm.hasOtherItems = _.get(otherItems, 'length') > 0;
      vm.waiting = false;
      const toPrint = $localStorage.get('toPrint');

      if ((toPrint === 'true' || toPrint === true) && !$window.Cypress) {
        $timeout(function () {
          $localStorage.set('toPrint', false);
          vm.printStockEntry();
        }, 10);
      }
    });
  };

  vm.choosePhotos = function () {
    UserPhotoService.view().then(photos => {
      photos.forEach(photo => vm.images.push({
        link: photo.link
      }));
    });
  };

  vm.clearItems = function () {
    const modal = ConfirmModal.show({}, {
      bodyText: 'Bạn có chắc muốn xóa toàn bộ các sản phẩm đang có trong danh sách?'
    });
    modal.then(function () {
      vm.items = [];
      $localStorage.set('stockEntryItems', []);
      $localStorage.set('stockEntryMeta', {});
      $localStorage.set('restockReport', {});
    });
  };

  vm.printStockEntry = function () {
    let toPrint = true;
    if (_.includes(vm.user.roles, 'kho')) toPrint = false;
    JsPrintService.printElementById('stock-entry-print', toPrint);
    vm.warehouseGroupName = '';

    if (_.get(vm.stockEntry, 'outlet.code', '').match(/D\d+/) && _.get(vm.stockEntry, 'destination.code', '').match(/[ME]\d+/)) {
      vm.warehouseGroupName = _.get(_.head(vm.stockEntry.items), 'warehouseGroup.name', '');
    }

    $timeout(() => {
      JsPrintService.printElementById('stock-entry-tag', toPrint);
    }, 500);
  };

  hotkeys.bindTo(vm).add({
    combo: 'ctrl+p',
    description: 'Print',
    callback: vm.printStockEntry
  });
  vm.countProducts = [];

  vm.loadCountProducts = () => {
    const localCountProducts = $localStorage.getObject('stockEntryCountProducts');

    if (localCountProducts && localCountProducts.length) {
      vm.countProducts.push(...localCountProducts);
    }
  };

  vm.saveCountProducts = () => {
    $localStorage.setObject('stockEntryCountProducts', vm.countProducts);
  };

  vm.currentImage = null;

  vm.addProduct = product => {
    vm.currentImage = _.get(product, 'imageLink') || _.get(product, 'wooProperties.images[0].src');

    const matchProductIndex = _.findIndex(vm.countProducts, {
      _id: product._id
    });

    if (matchProductIndex === -1) {
      vm.countProducts.unshift(product);
    } else {
      vm.countProducts[matchProductIndex].quantity += 1;

      const oldItem = _.head(vm.countProducts.splice(matchProductIndex, 1));

      vm.countProducts.unshift(oldItem);
    }

    vm.saveCountProducts();
  };

  vm.getTypes = () => [{
    title: 'Restock',
    id: 'restock'
  }, {
    title: 'Nhập kho',
    id: 'buy'
  }, {
    title: 'Đóng gói',
    id: 'pl'
  }, {
    title: 'Tái chế',
    id: 'recycle'
  }, {
    title: 'CS chuyển',
    id: 'transfer'
  }, {
    title: 'Thu hồi',
    id: 'return'
  }, {
    title: 'Thanh lý',
    id: 'sell'
  }, {
    title: 'Tiêu hủy',
    id: 'trash'
  }];

  vm.openViewModalStockEntry = StockEntryService.openViewModalStockEntry;

  vm.chooseStaff = function () {
    StockEntryService.chooseStaffModal().then(user => {
      vm.data.staff = user;
    });
  };

  vm.checkUserPermission = () => {
    const needLoggedIn = user => {
      return _.intersection(_.get(user, 'roles', []), ['kho', 'sale', 'ship']).length > 0 && !(_.intersection(_.get(user, 'roles', []), ['admin', 'tro-ly', 'tro-ly-kho', 'tro-ly-sx', 'flexi-time', 'stock-entry:create']).length > 0);
    };

    if (needLoggedIn(vm.user)) {
      const currentShift = CurrentShift.getCurrentShift();

      if (!_.get(currentShift, '_id')) {
        FhdMessenger.error('Cần đăng nhập vào ca trực để tạo phiếu chuyển hàng');
        $location.path('/');
      }
    }
  };

  vm.selectAllStatus = function () {
    let changeValue = true;
    if (_.every(vm.statusMap)) changeValue = false;

    _.forEach(vm.statusMap, (value, key) => {
      vm.statusMap[key] = changeValue;
    });
  };

  function checkWrongRestock(items = []) {
    _.forEach(items, item => {
      if (_.get(item.warehouseRestock, 'code') !== _.get(vm.data, 'outlet.code')) {
        return FhdMessenger.error(`Sản phẩm ${item.sku} - ${item.description} chỉ có thể gửi từ kho ${_.get(item.warehouseRestock, 'code')}`);
      }
    });
  }

  $scope.$watch(() => _.get(vm.items, 'length', 0), () => {
    if (vm.isKho && _.get(vm.data, 'outlet.code', '').match(/D\d+/)) {
      checkWrongRestock(vm.items);
    }
  });
  vm.barcodeOptions = {
    format: 'CODE128',
    lineColor: '#000000',
    background: 'rgba(255, 0, 0, 0)',
    width: 2,
    height: 40,
    displayValue: true,
    fontOptions: '',
    font: 'LatoWeb',
    textAlign: 'center',
    textPosition: 'bottom',
    textMargin: 2,
    fontSize: 12,
    margin: 0,
    marginTop: 0,
    marginBottom: 0,
    marginLeft: 0,
    marginRight: 0
  };
}]);
'use strict';

