angular.module('money-entries').factory('MoneyEntryService', ['$http', '$q', '$modal', 'OutletService', 'Authentication', function ($http, $q, $modal, OutletService, Authentication) {
  function openViewMoneyEntryModal(moneyEntryId) {
    return $modal.open({
      templateUrl: '/modules/money-entries/views/modal-view-money-entry.client.view.html',
      controller: 'ModalViewMoneyEntryController',
      controllerAs: 'vm',
      resolve: {
        moneyEntryId: () => moneyEntryId
      }
    });
  }

  function getRevenueReports({
    startDate,
    endDate
  }) {
    return $http.get('/money-entries/revenue-reports', {
      params: {
        startDate,
        endDate
      }
    }).then(res => {
      return res.data;
    });
  }

  function openModalVerboseSaleReports(outlet, saleReports, dates) {
    return $modal.open({
      templateUrl: '/modules/money-entries/views/modal-verbose-sale-reports.view.html',
      controller: 'ModalVerboseSaleReportsController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        outlet: () => outlet,
        saleReports: () => saleReports,
        dates: () => dates
      }
    });
  }

  return {
    openViewMoneyEntryModal,
    getRevenueReports,
    openModalVerboseSaleReports,

    getShifts() {
      return [{
        name: 'Sáng',
        _id: 'S'
      }, {
        name: 'Chiều',
        _id: 'C'
      }, {
        name: 'Tối',
        _id: 'T'
      }, {
        name: 'Tối 21h - 24h',
        _id: 'T_1'
      }];
    }

  };
}]);
