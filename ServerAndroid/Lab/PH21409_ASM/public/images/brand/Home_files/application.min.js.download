    if (!vm.outlet.rentPaymentCycleByMonth) return FhdMessenger.error('Chưa chọn chu kỳ đóng tiền nhà');
    const times = Math.floor(12 / vm.outlet.rentPaymentCycleByMonth);
    let temp = moment(vm.date);

    _.forEach(new Array(times), () => {
      temp = temp.add(vm.outlet.rentPaymentCycleByMonth, 'M');
      const date = moment(temp).date();
      const month = moment(temp).month();
      const year = moment(temp).year();

      if (moment(vm.date).year() === year) {
        vm.outlet.rentPaymentDates.push({
          date: moment().year(year).month(month).date(date).startOf('day')
        });
