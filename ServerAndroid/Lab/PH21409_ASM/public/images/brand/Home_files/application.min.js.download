      // whether to load user's outlet
      isStorage: '=?',
      isPos: '=?',
      isManufacturing: '=?',
      isWarehouse: '=?',
      isKitchen: '=?',
      isSavorKitchen: '=?',
      showExtendOutlet: '=?',
      noDefault: '=?',
      emptyOption: '=?',
      // has option none to select
      defaultOutletCode: '@',
      disableExceptAdmin: '=?',
      hasStaff: '=?',
      outlet: '=',
      labelColumn: '@',
      noLabel: '=?',
