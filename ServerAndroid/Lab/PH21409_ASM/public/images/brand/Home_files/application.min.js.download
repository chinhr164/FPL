      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close(plTask);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ModalEditRawProductForPlTaskController', ['helper', 'Authentication', '$stateParams', 'plTask', 'PlTasks', 'FhdMessenger', 'ObjectId', '$modalInstance', function (helper, Authentication, $stateParams, plTask, PlTasks, FhdMessenger, ObjectId, $modalInstance) {
  const vm = this;
  const plTaskId = $stateParams.plTaskId;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.removeValueFromArray = helper.removeValueFromArray;
  PlTasks.get({
    plTaskId
  }).$promise.then(plTask => {
    vm.plTask = plTask;

    if (!_.get(vm.plTask, 'rawProducts.length')) {
      vm.plTask.rawProducts = vm.plTask.product.rawProducts;
    }
  });

  vm.insertRawProduct = rawProduct => {
    vm.plTask.rawProducts = vm.plTask.rawProducts || [];
    vm.plTask.rawProducts.push({
      product: rawProduct._id,
      sku: rawProduct.sku,
      description: rawProduct.description,
      quantity: 1
    });
  };

  vm.dismiss = $modalInstance.dismiss;

  vm.update = function () {
    vm.waiting = true;
    vm.plTask.$updateRawProduct().then(plTask => {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close(plTask);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ModalPrintPlTaskController', ['plTask', 'JsPrintService', '$timeout', '$modalInstance', 'FhdMessenger', '$scope', '$http', 'printType', function (plTask, JsPrintService, $timeout, $modalInstance, FhdMessenger, $scope, $http, printType) {
  const vm = this;
  vm.plTask = plTask;
  vm.printType = printType;
  vm.defaultLink = './modules/pl-tasks/templates/print-label-templates';

  vm.init = () => {
    const labelAttributes = _.get(vm.plTask, 'labelAttributes');

    vm.plTask.description = _.get(labelAttributes, 'description', vm.plTask.description);
    vm.plTask.ingredients = _.get(labelAttributes, 'ingredients', vm.plTask.ingredients);
    vm.plTask.origin = _.get(labelAttributes, 'origin', vm.plTask.origin);
    vm.plTask.condition = _.get(labelAttributes, 'condition', vm.plTask.condition);
    vm.plTask.usage = _.get(labelAttributes, 'usage', vm.plTask.usage);
  };

  if (vm.plTask.manufactureDate) {
    vm.plTask.manufactureDate = moment(vm.plTask.manufactureDate).format('YYYY-MM-DD');
  }

  if (vm.plTask.expiryDate) {
    vm.plTask.expiryDate = moment(vm.plTask.expiryDate).format('YYYY-MM-DD');
  } // let changedDate = false


  vm.barcodeContent = vm.plTask.sku + 'L' + vm.plTask.plTaskId;
  vm.barcodeOptions = {
    format: 'CODE128',
    lineColor: '#000000',
    background: 'rgba(255, 0, 0, 0)',
    width: 1,
    height: 25,
    displayValue: true,
    fontOptions: '',
    font: 'LatoWeb',
    textAlign: 'center',
    textMargin: 2,
    fontSize: 8,
    margin: 0
  };
  vm.dismiss = $modalInstance.dismiss; // $scope.$watchGroup(
  //   ['vm.plTask.manufactureDate', 'vm.plTask.expiryDate'],
  //   (newValue, oldValue) => {
  //     if (newValue === oldValue) return
  //     changedDate = true
  //   }
  // )

  vm.print = () => {
    if (vm.plTask.productGroup === 'FOOD') {
      if (!vm.plTask.manufactureDate) return FhdMessenger.error('Chưa điền ngày sản xuất');
      if (!vm.plTask.expiryDate) return FhdMessenger.error('Chưa điền hạn sử dụng');
      const diff = moment(vm.plTask.expiryDate).diff(moment(vm.plTask.manufactureDate), 'days');

      if (diff < 30) {
        return FhdMessenger.error('NSX -> HSD phải hơn 30 ngày');
      }
    } // if (changedDate) {
    //   $http
    //     .post(`/pl-tasks/${vm.plTask._id}/update-expire-date`, {
    //       manufactureDate: vm.plTask.manufactureDate,
    //       expiryDate: vm.plTask.expiryDate,
    //     })
    //     .then(() => {
    //       FhdMessenger.success('Cập nhật NSX, HSD thành công')
    //     })
    //     .catch((err) => FhdMessenger.errorFromServer(err))
    // }


    $timeout(() => {
      JsPrintService.printElementById(printType, true);
    }, 100);
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ModalViewPlTaskPointsController', ['Authentication', 'plTask', 'PlTasks', 'FhdMessenger', 'ObjectId', function (Authentication, plTask, PlTasks, FhdMessenger, ObjectId) {
  const vm = this;
