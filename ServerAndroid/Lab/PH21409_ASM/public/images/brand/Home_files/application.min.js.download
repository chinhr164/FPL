function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('bundle-rules').controller('BundleRulesController', ['$stateParams', '$location', 'FhdMessenger', 'BundleRules', 'NgTableParams', 'BundleRuleService', function ($stateParams, $location, FhdMessenger, BundleRules, NgTableParams, BundleRuleService) {
  const vm = this;

  vm.init = () => {
    vm.bundleRule = {};
    vm.products = vm.products || [];
    vm.subRules = vm.subRules || [];
    vm.bundlePrices = vm.bundlePrices || [];
    vm.subRuleProducts = vm.subRuleProducts || [];
    vm.hasSubRules = false;
  };

  vm.bundleRulesTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    BundleRules.query().$promise.then(bundleRules => {
      vm.bundleRulesTable.settings({
        dataset: bundleRules
      });
    });
  };

  vm.productSearchSelected = function (product) {
    if (_.get(vm.bundleRule, 'skus', false)) {
      const productIndex = _.findIndex(vm.bundleRule.skus, item => {
        return item === product.sku;
      });

      if (productIndex > -1) {
        return FhdMessenger.error('Đã thêm sản phẩm này!');
      } else {
        vm.bundleRule.skus.push(vm.product.sku);
      }
    } else {
      const productIndex = _.findIndex(vm.products, item => {
        return item.sku === product.sku;
      });

      if (productIndex > -1) {
        return FhdMessenger.error('Đã thêm sản phẩm này!');
      } else {
        vm.products.push(vm.product);
      }
    }
  };

  vm.remove = function () {
    vm.bundleRule.$remove(function () {
      $location.path('bundle-rules');
      FhdMessenger.success('Đã xóa');
    });
  };

  vm.addItem = function () {
    if (!vm.price || !vm.quantity) return FhdMessenger.error('Vui lòng bổ sung giá hoặc số lượng trước khi thêm');

    if (_.get(vm.bundleRule, 'bundlePrices', false)) {
      vm.bundleRule.bundlePrices.push({
        price: vm.price,
        quantity: vm.quantity
      });
    } else {
      vm.bundlePrices.push({
        price: vm.price,
        quantity: vm.quantity
      });
    }
  };

  vm.update = function () {
    const bundleRule = new BundleRules(_objectSpread({}, vm.bundleRule, {
      bundlePrices: vm.bundlePrices
    }));
    bundleRule.$update(function () {
      $location.path('bundle-rules');
      FhdMessenger.success('Cập nhật thành công!');
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  };

  vm.findOne = function () {
    vm.subRules = vm.subRules || [];
    BundleRules.get({
      bundleRuleId: $stateParams.bundleRuleId
    }).$promise.then(bundleRule => {
      vm.bundleRule = bundleRule;
      vm.products = vm.bundleRule.skus;
      vm.bundlePrices = vm.bundleRule.bundlePrices;
      vm.hasSubRules = false;
    });
  };

  vm.showAddSubRule = index => {
    BundleRuleService.openAddSubRuleModal().result.then(subRules => {
      _.set(vm.bundlePrices[index], 'subRules', subRules);
    });
  };

  vm.removeItem = function (type, index) {
    if (type === 'subRule') {
      vm.subRules.splice(index, 1);
    }

    if (type === 'bundlePrice') {
      vm.bundlePrices.splice(index, 1);
    }

    if (type === 'products') {
      vm.products.splice(index, 1);
    }

    if (type === 'skus') {
      vm.bundleRule.skus.splice(index, 1);
    }
  };

  vm.create = function () {
    if (!vm.bundleRule.description) {
      return FhdMessenger.error('Chưa có miêu tả');
    }

    if (!vm.products.length) {
      return FhdMessenger.error('Thiếu sản phẩm');
    }

    vm.waiting = true;
    const bundleRule = new BundleRules(_objectSpread({}, vm.bundleRule, {
      bundlePrices: vm.bundlePrices,
      skus: _.map(vm.products, 'sku')
    }));
    bundleRule.$save(function (response) {
      vm.waiting = false;
      $location.path('bundle-rules');
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  };
}]);
"use strict";

angular.module('bundle-rules').controller('ModalAddSubRuleController', ['$modalInstance', 'FhdMessenger', function ($modalInstance, FhdMessenger) {
  const vm = this;
  vm.subRules = [];

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.addItem = function () {
    vm.subRules.push({
      skus: [...vm.subRuleProducts],
      price: vm.subRulePrice
    });
  };

  vm.refreshsubRuleProducts = function () {
    vm.subRuleProducts = [];
  };

  vm.removeItem = function (type, index) {
    vm.subRules.splice(index, 1);
  };

  vm.add = function () {
    $modalInstance.close(vm.subRules);
  };

  vm.subRuleProductSearchSelected = function (product) {
    vm.subRuleProducts = vm.subRuleProducts || [];

    const productIndex = _.findIndex(vm.subRuleProducts, item => {
      return item === product.sku;
    });

    if (productIndex > -1) {
      return FhdMessenger.error('Đã thêm sản phẩm này!');
    } else {
      vm.subRuleProducts.push(vm.subRuleProduct.sku);
    }
  };
}]);
