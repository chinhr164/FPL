"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('product-changes').controller('ProductChangesController', ['helper', 'FhdMessenger', 'NgTableParams', 'OutletService', 'ProductChanges', '$stateParams', 'Authentication', 'ObjectId', function (helper, FhdMessenger, NgTableParams, OutletService, ProductChanges, $stateParams, Authentication, ObjectId) {
  const vm = this;
  vm.user = Authentication.user;
  vm.productChangesTable = new NgTableParams({
    count: 50
  });
  const titleMap = {
    warehouseRestock: 'Kho restock',
    warehouseOutlets: 'Các kho restock backup',
    price: 'Giá',
    salePrice: 'Giá Sale',
    fullDescription: 'Tên đầy đủ',
    shopeePrice: 'Giá Shoppe',
    onlinePriceNote: 'Ghi chú cho giá online',
    saleNotifyContent: 'Ghi chú cho nhân viên bán hàng',
    shopeeSalePrice: 'Giá sale shopee',
    wholesalePricingNote: 'Ghi chú cho giá bán sỉ',
    classificationStrategy: 'Phân loại bán sỉ',
    // buying tab
    description: 'Tên sản phẩm',
    vendorDescription: 'Tên sản phẩm ứng với nhà cung cấp',
    buyingCode: 'Mã đặt hàng',
    netWeight: 'Khối lượng tịnh(kg)',
    leadTime: 'Lead Time',
    shelfLife: 'Shelf Life',
    packageQuantity: 'Quantity for 1 package',
    buyingLeadTime: 'Buying Lead Time',
    minimumBuyingQuantity: 'Minimum Buying Quantity',
    buyingProfile: 'Buying Location',
    targetStock: 'Stock target',
    backupStock: 'Stock backup',
    notBuying: 'Không nhập nữa',
    delayBuying: 'Tạm ngừng nhập',
    markDelayBuyingTime: 'Thời gian tạm ngừng nhập',
    expectedBuyingDate: 'Ngày dự kiến nhập lại',
    convertProducts: 'Hàng chuyển đổi',
    // Status
    isModifier: 'Là sản phẩm addon (Savor)',
    isRaw: 'Hàng Raw',
    isTool: 'Hàng vận hành',
    privateLabel: 'Private label',
    privateLabelAtStore: 'Quy đổi tại cửa hàng',
    toSell: 'Bán',
    toUse: 'Dùng tại cơ sở',
    // supplyLeadTimes.productionLeadTime (0 => 3)
    isMenuItem: 'Để hiện lên menu (Savor)',
    productType: 'Phân loại sử dụng trong Pl',
    stockControl: 'Có quản lý hàng tồn',
    alwaysShowWhenRestock: 'Luôn hiện trong Restock Entry',
    publishWeb: 'Đăng web',
    onOrder: 'Là hàng order (Cho phép order trước trên Abby.vn)',
    autoRestock: 'Tự động báo Restock',
    notifySaleEntry: 'Thông báo mỗi khi bán được hàng',
    needQuantity: 'Thu ngân tự nhập số lượng',
    disableInputQuantity: 'Không cho phép nhập số lượng sản phẩm',
    noLoyalty: 'Không tích điểm thẻ KH',
    forceScanBarcode: 'Bắt buộc dùng Barcode',
    needPrintedBarcode: 'Khó quét mã vạch',
    allowSearching: 'Có thể tìm theo tên',
    isCombo: 'Là Combo',
    autoCogsByBuying: 'Tự động',
    deleted: 'Đã xóa'
  };
  OutletService.allAsync().then(outlets => {
    vm.outletMap = helper.makeMap(outlets, '_id');
  });

  function getFieldTitle(field) {
    return _.get(titleMap, field, field);
  }

  function getValueDetail(value) {
    return _.get(vm.outletMap, `${value}.code`, value);
  }

  vm.init = function () {
    vm.startDate = moment().subtract(7, 'day').format('YYYY-MM-DD');
    vm.endDate = moment().format('YYYY-MM-DD');
  };

  vm.rejectFields = '__v updatedAt createdAt created updated updatedBy unixUpdated _bsontype id _id'.split(' ');

  function checkField(field) {
    return _.includes(vm.rejectFields, field) || field.match(/(.*?)(_id)/);
  }

  function getSummary(changes, type) {
    switch (type) {
      case 'outlet':
        const changesGroupByOutlet = _.groupBy(changes, 'outletCode');

        return _.reduce(changesGroupByOutlet, (result, changes, outlet) => {
          const convertText = _.reduce(changes, (_result, change) => {
            if (checkField(change.field)) {
              return _result;
            }

            _result.push(`<i>${getFieldTitle(change.field)}</i> (${getValueDetail(change.before || 'null')} => ${getValueDetail(change.after || 'null')})`);

            return _result;
          }, []).join('<br />');

          result.push(`<u stype="font-size: 16px">${outlet}</u><br /> ${convertText}`);
          return result;
        }, []).join('<br />');

      case 'region':
        const changesGroupByRegion = _.groupBy(changes, 'region');

        return _.reduce(changesGroupByRegion, (result, changes, region) => {
          const convertText = _.reduce(changes, (_result, change) => {
            if (checkField(change.field)) {
              return _result;
            }

            _result.push(`<i>${getFieldTitle(change.field)}</i> (${getValueDetail(change.before || 'null')} => ${getValueDetail(change.after || 'null')})`);

            return _result;
          }, []).join('<br />');

          result.push(`<u stype="font-size: 16px">${region}</u><br /> ${convertText}`);
          return result;
        }, []).join('<br />');

      default:
        return _.reduce(changes, (result, change) => {
          if (checkField(change.field)) {
            return result;
          }

          result.push(`<i>${getFieldTitle(change.field)}</i> (${getValueDetail(change.before || 'null')} => ${getValueDetail(change.after || 'null')})`);
          return result;
        }, []).join('<br />');
    }
  }

  vm.find = function () {
    if (!vm.endDate || !vm.startDate) {
      return FhdMessenger.error('Vui lòng điền đủ thông tin ngày bát đầu và ngày kết thúc');
    }

    if (!vm.products.length) {
      return FhdMessenger.error('Vui lòng chọn sản phẩm cần tìm');
    }

    let query = {
      endDate: moment(vm.endDate).toDate(),
      startDate: moment(vm.startDate).toDate(),
      products: _.map(vm.products, '_id')
    };

    if (vm.staff) {
      query = _objectSpread({}, query, {
        user: ObjectId.getObjectId(vm.staff)
      });
    }

    vm.waiting = true;
    const promise = ProductChanges.query(query).$promise.then(productChanges => {
      vm.productChanges = productChanges;

      _.map(vm.productChanges, productChange => {
        if (productChange.changes.length) {
          productChange.summaryChanges = getSummary(productChange.changes);
        }

        if (productChange.outletAttributeChanges.length) {
          productChange.summaryOutletChanges = getSummary(productChange.outletAttributeChanges, 'outlet');
        }

        if (productChange.regionAttributeChanges.length) {
          productChange.summaryRegionChanges = getSummary(productChange.regionAttributeChanges, 'region');
        }

        if (productChange.bundlePriceChanges.length) {
          productChange.summaryBundlePriceChanges = getSummary(productChange.bundlePriceChanges);
        }

        if (productChange.convertProductChanges.length) {
          productChange.summaryConvertProductChanges = getSummary(productChange.convertProductChanges);
        }

        productChange.summaryAll = `${productChange.summaryChanges}${productChange.summaryOutletChanges}${productChange.summaryRegionChanges}${productChange.summaryBundlePriceChanges}${productChange.summaryConvertProductChanges}`;
        return productChange;
      });

      vm.productChangesTable.settings({
        dataset: productChanges
      });

      if (vm.productChanges.length === 500) {
        FhdMessenger.notifySticky('Chỉ hiện 500 kết quả gần đây nhất. Hãy thu hẹp khoảng thời gian hoặc lọc theo nhân viên để tải đầy đủ kết quả.');
      }
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Đã tải xong');
    });
  };

  vm.findOne = function () {
    const promise = ProductChanges.get({
      productChangeId: $stateParams.productChangeId
    }).$promise.then(productChange => {
      vm.productChange = productChange;
      const {
        changes,
        outletAttributeChanges,
        regionAttributeChanges,
        bundlePriceChanges,
        convertProductChanges
      } = productChange;
      vm.productChangeMap = {
        changes: {
          value: rejectUselessField(changes),
          detail: 'Thông tin sản phẩm'
        },
        bundlePriceChanges: {
          value: bundlePriceChanges,
          detail: 'Bundle prices'
        },
        convertProductChanges: {
          value: convertProductChanges,
          detail: 'Convert Product'
        },
        outletAttributeChanges: {
          value: rejectUselessField(outletAttributeChanges),
          detail: 'Outlet attributes'
        },
        regionAttributeChanges: {
          value: rejectUselessField(regionAttributeChanges),
          detail: 'Region attributes'
        }
      };
    }).catch(err => {
      return FhdMessenger.error(err.message);
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Đã tải xong');
    });
  };

  vm.selectLabel = function (type) {
    let className = 'label ';

    switch (type) {
      case 'created':
        className += 'label-primary';
        break;

      case 'deleted':
        className += 'label-default';
        break;

      case 'updated':
        className += 'label-info';
        break;

      default:
        className += 'label-success';
    }

    return className;
  };

  const rejectUselessField = function (fieldChanges) {
    return _.reject(fieldChanges, field => {
      return _.intersection(vm.rejectFields, [field.field]).length;
    });
  };

  vm.products = [];

  vm.productSearchSelected = item => {
    const productIndex = _.findIndex(vm.products, existProduct => {
      return existProduct.sku === item.sku;
    });

    if (productIndex > -1) {
      return FhdMessenger.error('Đã có sản phẩm này trong danh sách report!');
    } else {
      vm.products.push(vm.product);
    }
  };

  vm.removeItem = index => {
    vm.products.splice(index, 1);
  };
}]);
'use strict';

