angular.module('user-tag-groups').controller('ModalViewUserTagGroupController', ['FhdMessenger', 'NgTableParams', 'userTagGroup', 'UserTagEntriesService', '$modalInstance', function (FhdMessenger, NgTableParams, userTagGroup, UserTagEntriesService, $modalInstance) {
  const vm = this;
  vm.convertTaggedUsersToText = UserTagEntriesService.convertTaggedUsersToText;
  vm.close = $modalInstance.dismiss;
  vm.userTagGroup = userTagGroup;
}]);
'use strict'; // Vendors controller

angular.module('user-tag-groups').controller('UserTagGroupsController', ['$stateParams', '$location', '$scope', 'Authentication', 'UserTagGroups', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'ConfirmModal', 'UserTagGroupsService', 'UserTagEntriesService', function ($stateParams, $location, $scope, Authentication, UserTagGroups, FhdMessenger, NgTableParams, ObjectId, ConfirmModal, UserTagGroupsService, UserTagEntriesService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.userTagGroup = {};
  vm.userTagGroup.user = Authentication.user;
  vm.data = {};
  vm.selectedOutlets = [];
  vm.userTagGroup.specialOutlets = [];

  vm.changeDefaultTaggedUser = function (user) {
    vm.defaultStaff = null;
    vm.defaultTaggedUsers = changeTaggedUser(user, vm.defaultTaggedUsers);
    vm.userTagGroup.taggedUsers = vm.defaultTaggedUsers;
  };

  vm.changeSpecialTaggedUser = function (user) {
    vm.specialStaff = null;
    vm.specialTaggedUsers = changeTaggedUser(user, vm.specialTaggedUsers);
  };

  vm.changeOutlet = function (outlet) {
    if (!_.get(outlet, 'code', '')) {
      return;
    }

    if (isDuplicateOutlet(outlet, vm.selectedOutlets)) {
      return FhdMessenger.error('Outlet đã tồn tại');
    }

    vm.selectedOutlets.push({
      outlet
    });
  };

  function isDuplicateOutlet(currentOutlet, outlets) {
    return _.some(outlets, _outlet => {
      return _.isEqual(ObjectId.getObjectId(_outlet.outlet), ObjectId.getObjectId(currentOutlet));
    });
  }

  const changeTaggedUser = function (user, taggedUsers) {
    taggedUsers = taggedUsers || [];

    if (!_.some(taggedUsers, taggedUser => {
      return _.isEqual(ObjectId.getObjectId(taggedUser.user), ObjectId.getObjectId(user));
    })) {
      taggedUsers.push({
        user
      });
    }

    return taggedUsers;
  };

  vm.removeTaggedUser = (taggedUsers, index) => {
    taggedUsers.splice(index, 1);
  };

  vm.add = function () {
    if (!vm.selectedOutlets.length) {
      return FhdMessenger.error('Chưa thêm outlet chỉ định');
    }

    if (!vm.specialTaggedUsers.length) {
      return FhdMessenger.error('Cần ít nhất một nhân viên được tag tại outlet này');
    }

    vm.userTagGroup.specialOutlets = _.reduce(vm.selectedOutlets, (result, _outlet) => {
      const {
        outlet
      } = _outlet;
      result.push({
        outlet,
        taggedUsers: vm.specialTaggedUsers
      });
      return result;
    }, vm.userTagGroup.specialOutlets || []);
    vm.selectedOutlets = [];
    vm.outlet = '';
    vm.specialTaggedUsers = null;
  };

  vm.init = function () {
    vm.userTagGroup.isTagAssistant = false;
    vm.userTagGroup.isTagOutlet = false;
  };

  vm.create = function () {
    if (!vm.userTagGroup.groupId) {
      return FhdMessenger.error('Bạn chưa nhập group id');
    }

    if (!vm.userTagGroup.description) {
      return FhdMessenger.error('Bạn chưa nhập mô tả ');
    }

    const userTagGroup = new UserTagGroups(vm.userTagGroup);
    vm.waiting = true; // Redirect after save

    userTagGroup.$save().then(() => {
      FhdMessenger.success('Tạp user tag group thành công');
      $location.path(`user-tag-groups`);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.userTagGroupsTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    UserTagGroups.query().$promise.then(userTagGroups => {
      vm.userTagGroups = userTagGroups;
      vm.userTagGroupsTable.settings({
        dataset: vm.userTagGroups
      });
    });
  };

  vm.convertTaggedUsersToText = UserTagEntriesService.convertTaggedUsersToText;

  vm.removeOutlet = function (outlets, index) {
    outlets.splice(index, 1);
  };

  vm.findOne = async () => {
    vm.userTagGroup = UserTagGroups.get({
      userTagGroupId: $stateParams.userTagGroupId
    }).$promise.then(userTagGroup => {
      vm.userTagGroup = userTagGroup;
      vm.defaultTaggedUsers = vm.userTagGroup.taggedUsers;
    });
  };

  vm.update = () => {
    if (!vm.userTagGroup.description) {
      return FhdMessenger.error('Chưa có miêu tả');
    }

    vm.waiting = true;
    vm.userTagGroup.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path(`user-tag-groups`);
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.openModalViewUserTagGroup = UserTagGroupsService.openModalViewUserTagGroup;

  vm.remove = (userTagGroup, index) => {
    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc là muốn xóa User Tag Group: ${userTagGroup.groupId}\nDescription: ${userTagGroup.description}`,
      actionButtonText: 'Accept',
      closeButtonText: 'close'
    }).then(() => {
      vm.waiting = true;
      userTagGroup.$remove().then(() => {
        FhdMessenger.success('Xóa thành công');
        vm.userTagGroups.splice(index, 1);
        vm.userTagGroupsTable.reload();
      }).catch(err => {
        FhdMessenger.error(err.message);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
