angular.module('sale-campaigns').filter('saleCampaignCondition', [function () {
  return input => {
    if (input === 'MINIMUM_SALE_TOTAL') return 'Giá trị đơn hàng tối thiểu';
  };
}]);
"use strict";

angular.module('sale-campaigns').factory('SaleCampaignService', ['$modal', 'FhdMessenger', function ($modal, FhdMessenger) {
  const conditionType = [{
    conditionName: 'MINIMUM_SALE_TOTAL',
    displayName: 'Giá trị đơn hàng tối thiểu'
  }];

  const checkValidCondition = (items, condition) => {
    switch (condition.conditionType) {
      case 'MINIMUM_SALE_TOTAL':
        const saleTotal = _.reduce(items, (result, item) => {
          return result + item.quantity * item.soldPrice;
        }, 0);

        if (saleTotal >= condition.conditionValue) {
          return true;
        } else {
          return false;
        }

      default:
        return false;
    }
  };

  const checkSaleCampaignConditions = (items, conditions) => {
    if (!_.get(conditions, 'length', 0)) return true;
    return _.every(conditions, condition => checkValidCondition(items, condition));
  };

  const processSaleCampaigns = (items, saleCampaigns) => {
    _.forEach(saleCampaigns, saleCampaign => {
      if (!checkSaleCampaignConditions(items, saleCampaign.conditions)) {
        return;
      }

      _.forEach(saleCampaign.products, product => {
        const matchItem = _.find(items, {
          product: product.product
        });

        if (matchItem && matchItem.soldPrice > product.price) {
          if (product.maxQuantity && product.maxQuantity < matchItem.quantity) {
            return FhdMessenger.error('Sản phẩm này có số lượng khuyến mại tối đa là ' + product.maxQuantity);
          }

          matchItem.soldPrice = product.price;
          matchItem.noLoyalty = product.noLoyalty;
          matchItem.isWholesale = product.isWholesale;
        }
      });
    });
  };

  return {
    processSaleCampaigns,
    getConditionType: () => conditionType
  };
}]);
"use strict";

