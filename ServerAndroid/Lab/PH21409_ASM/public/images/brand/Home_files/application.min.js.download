  Menus.addSubMenuItem('topbar', 'stocks', 'Import Order Entries', 'order-entries/import', null, null, ['admin', 'purchaser', 'probation-purchaser', 'kitchen', 'tro-ly-sx', 'tro-ly-kho', 'flexi-time'], 17);
  Menus.addSubMenuItem('topbar', 'stocks', 'List Order Entries', 'order-entries', null, null, ['purchaser', 'probation-purchaser', 'admin', 'kitchen', 'tro-ly-sx', 'tro-ly-kho', 'flexi-time'], 18);
  Menus.addSubMenuItem('topbar', 'stocks', 'Picking Order Entries', 'order-entries/picking', null, null, ['purchaser', 'probation-purchaser', 'admin', 'kitchen', 'kho', 'tro-ly-kho', 'tro-ly-kho', 'flexi-time'], 19);
  Menus.addSubMenuItem('topbar', 'stocks', 'Deliver', '/divider/', null, null, ['sale', 'kho', 'tro-ly', 'tro-ly-kho', 'admin', 'accountant', 'kitchen'], 20);
  Menus.addSubMenuItem('topbar', 'stocks', 'Create Deliver Entry', 'deliver-entries/create', null, null, ['kho', 'tro-ly', 'admin', 'kitchen'], 21);
  Menus.addSubMenuItem('topbar', 'stocks', 'List Deliver Entries', 'deliver-entries', null, null, ['sale', 'kho', 'tro-ly', 'tro-ly-kho', 'admin', 'accountant', 'kitchen'], 22);
