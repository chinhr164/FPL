angular.module('sale-entries').controller('ModalReturnItemsController', ['$modalInstance', '$window', 'SaleEntries', 'SaleEntryService', 'FhdMessenger', 'ProductService', function ($modalInstance, $window, SaleEntries, SaleEntryService, FhdMessenger, ProductService) {
  const vm = this;
  vm.reasons = ['Hàng có complaint', 'Khác'];
  vm.dismiss = $modalInstance.dismiss;
  vm.items = [];

  vm.searchSaleEntry = saleEntryId => {
    SaleEntries.searchSaleEntry({
      saleEntryId
    }).$promise.then(saleEntry => {
      if (saleEntry.refundSaleEntry) {
        return FhdMessenger.error(`Đơn hàng này đã được hoàn trả rồi nên không thể hoàn trả tiếp`);
      }

      if (!saleEntry.saleEntryId) {
        return FhdMessenger.error(`Không tìm thấy đơn hàng tương ứng. Có vẻ bạn nhập sai mã đơn hàng rồi`);
      } // if (!saleEntry.customer) {
      //   return FhdMessenger.error(
      //     `Đơn hàng không đủ điều kiện hoàn trả do không có thông tin khách hàng`
      //   )
      // }


      if (moment(saleEntry.created).isBefore(moment().subtract(3, 'day').startOf('day')) && !_.some(saleEntry.order.items, {
        canReturn: true
      })) {
        return FhdMessenger.error(`Đơn hàng không đủ điều kiện hoàn trả do đã quá thời gian hoàn trả`);
      }

      vm.saleEntry = saleEntry;
    });
  };

  vm.viewSaleEntry = SaleEntryService.viewSaleEntry;

  vm.addProduct = product => {
    const matchItem = _.find(vm.items, {
      product: product._id
    });

    if (matchItem) {
      matchItem.quantity += 1;
    } else {
      const matchSaleEntryItem = _.find(vm.saleEntry.order.items, {
        product: product._id
      });

      if (!matchSaleEntryItem) {
        FhdMessenger.error(`Đơn hàng hoàn trả không có sản phẩm ${product.sku} ${product.description}`);
        return;
      }

      if (!matchSaleEntryItem.canReturn && !product.privateLabel && !product.isOEM && _.get(product, 'vendor.code', '') !== 'HN494' && ProductService.isFoodProduct(product)) {
        return FhdMessenger.error('Không thể đổi trả các mặt hàng nguyên liệu của nhà sản xuất!');
      }

      const matchItems = _.filter(vm.saleEntry.order.items, {
        sku: product.sku
      });

      const soldQuantity = _.sumBy(matchItems, item => {
        return Math.max(0, item.quantity);
      });

      const lineTotal = _.sumBy(matchItems, 'lineTotal');

      vm.items.push(_objectSpread({}, matchSaleEntryItem, {
        product: product._id,
        sku: product.sku,
        description: product.description,
        returnQuantity: 1,
        soldCogs: matchSaleEntryItem.cogs,
        discount: matchSaleEntryItem.discount,
        soldQuantity,
        soldPrice: matchSaleEntryItem.soldPrice,
        lineTotal
      }));
    }

    vm.calculateTotalRefund();
  };

  vm.calculateTotalRefund = () => {
    _.forEach(vm.items, item => {
      if (item.returnQuantity > item.soldQuantity) {
        FhdMessenger.error(`${item.sku} ${item.description} trả lại vượt quá số lượng.`);
        item.returnQuantity = item.soldQuantity;
      }

      item.lineTotal = item.soldPrice * item.returnQuantity - item.discount / item.soldQuantity * item.returnQuantity;
    });

    vm.totalRefund = _.reduce(vm.items, (result, item) => {
      return result + item.lineTotal;
    }, 0);
  };

  function getNoReasonItem(items) {
    return _.find(items, item => {
      return !_.isString(item.returnReason);
    });
  }

  vm.submit = () => {
    const noReasonItem = getNoReasonItem(vm.items);

    if (noReasonItem) {
      FhdMessenger.error(`${noReasonItem.sku} ${noReasonItem.description} chưa có đủ lý do.`);
      return;
    }

    FhdMessenger.success('Ok');
    $modalInstance.close({
      returnItems: vm.items,
      returnSaleEntry: vm.saleEntry
    });
  };

  vm.takeNote = function (reason, item) {
    if (reason !== 'Khác') {
      item.returnReason = reason;
    } else {
      item.otherReason = true;
      item.returnReason = $window.prompt('Nhập lý do');
    }
  };
}]);
'use strict';

angular.module('sale-entries').controller('ModalUpdatePermissionReturnItemsController', ['CurrentShift', 'saleEntry', '$modalInstance', 'FhdMessenger', 'SaleEntries', 'SaleEntryService', 'Authentication', function (CurrentShift, saleEntry, $modalInstance, FhdMessenger, SaleEntries, SaleEntryService, Authentication) {
  const vm = this;
  vm.user = Authentication.user;
  const currentShift = CurrentShift.getCurrentShift();
  vm.getContentButtonUpdateReturnItem = SaleEntryService.getContentButtonUpdateReturnItem;
  vm.availableUpdateItems = _.reject(saleEntry.order.items, item => {
    return item.canReturn || item.hidden;
  });
  vm.saleEntry = SaleEntries.get({
    saleEntryId: saleEntry._id
  });

  function getNoReasonItem(items) {
    return _.filter(items, item => {
      return item.canReturn && !item.requestReturnReason;
    });
  }

  function getMissTickItem(items) {
    return _.filter(items, item => {
      return _.isString(item.requestReturnReason) && !item.canReturn;
    });
  }

  function validateReturnItems(returnItems) {
    if (!returnItems.length) {
      return 'Chưa chọn sản phẩm';
    }

    if (SaleEntryService.canUpdateReturnItems(vm.user)) {
      return;
    }

    const noReasonItems = getNoReasonItem(returnItems);

    if (noReasonItems.length) {
      return `${_.map(noReasonItems, item => {
        return `${item.sku} - ${item.description}`;
      }).join(', ')} chưa có đủ lý do.`;
    }

    const missTickItems = getMissTickItem(vm.availableUpdateItems);

    if (missTickItems.length) {
      return `${_.map(missTickItems, item => {
        return `${item.sku} - ${item.description}`;
      }).join(', ')} có lý do nhưng chưa chọn.`;
    }
  }

  vm.updatePermissionReturnItems = function () {
    const error = validateReturnItems(vm.availableUpdateItems);

    if (error) {
      return FhdMessenger.error(error);
    }

    vm.saleEntry.returnItems = _.map(_.filter(vm.availableUpdateItems, {
      canReturn: true
    }), item => {
      return _.pick(item, ['_id', 'product', 'sku', 'description', 'plTaskId', 'refId', 'canReturn', 'requestReturnReason']);
    });
    vm.saleEntry.currentOutlet = _.get(currentShift, 'outlet._id');
    vm.waiting = true;
    const promise = vm.saleEntry.$updatePermissionReturnItems().then(saleEntry => {
      FhdMessenger.success('Thêm thành công');
      $modalInstance.close(saleEntry);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang xử lý...', promise);
  };
}]);
