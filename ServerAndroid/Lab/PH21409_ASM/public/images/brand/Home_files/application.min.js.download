angular.module('work-tasks').controller('WorkTasksController', ['$http', '$stateParams', '$state', '$scope', '$window', 'helper', 'Authentication', 'FacilityService', 'NgTableParams', 'ObjectId', 'ProductService', 'PortraitService', 'WorkTasks', 'UserService', 'FhdMessenger', 'ConfirmModal', 'WorkTaskService', 'WorkTaskCategories', 'CurrentShift', 'PaymentRequestsService', 'ExpenseEntryService', 'SticketService', 'WooProductCategoryService', 'Sockets', function ($http, $stateParams, $state, $scope, $window, helper, Authentication, FacilityService, NgTableParams, ObjectId, ProductService, PortraitService, WorkTasks, UserService, FhdMessenger, ConfirmModal, WorkTaskService, WorkTaskCategories, CurrentShift, PaymentRequestsService, ExpenseEntryService, SticketService, WooProductCategoryService, Sockets) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.removeValueFromArray = helper.removeValueFromArray;
  vm.data = {};
  vm.workTask = {};
  vm.workTaskCategoriesMap = {};
  vm.openModalViewPaymentRequest = PaymentRequestsService.openModalViewPaymentRequest;
  vm.openViewExpenseEntry = ExpenseEntryService.openViewExpenseEntry;
  vm.isQcOrAdmin = _.intersection(vm.user.roles, ['admin', 'QC']).length || !_.get(vm.user, 'outlet.code', '').match(/[MESBDG]\d+/);
  vm.groups = WorkTaskService.getGroups();
  vm.hcGroups = FacilityService.getGroups();
  vm.attributes = ProductService.getProductAttributes();
  vm.workTask.detail = '';
  vm.newNote = '';
  const undefinedStaff = {
    code: 'none',
    displayName: 'Chưa có'
  };

  vm.getTaskTypes = () => {
    return [{
      id: 'photo',
      title: 'Ảnh'
    }, {
      id: 'description',
      title: 'Mô tả'
    }];
  };

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.workTask.outlets = _.map(selectedOutlets, '_id');
  };

  vm.initBuyingTask = () => {
    vm.groups = ['Expand hàng mới', 'Khiếu nại hàng lỗi', 'Phát triển hệ thống', 'Tìm nguồn nhập mới', 'Tính số ôm hàng', 'Review sản phẩm'].map(group => {
      return {
        id: group,
        title: group
      };
    });
    vm.workTask.deadline = moment().add(2, 'day').endOf('day').format('YYYY-MM-DD');
  };

  vm.changeWorkDepartment = function (workDepartment) {
    WorkTaskService.changeWorkDepartment(vm.workTask, workDepartment);
  };

  vm.doneWorkDepartment = workDepartment => {
    vm.workTask.workDepartment = workDepartment;
    WorkTaskService.openModalDoneWorkDepartmentForWorkTask(vm.workTask);
  };

  vm.taskTypes = ['HC', 'QC', 'VM', 'photo', 'description', 'TECH', 'buying', 'debt'];
  vm.statuses = ['created', 'processing', 'done', 'deleted'];
  vm.groups.sort((a, b) => {
    return a.title.localeCompare(b.detail);
  });

  vm.openModalCreatePaymentRequest = () => {
    PaymentRequestsService.openModalCreatePaymentRequest({
      buyingEntries: [],
      workTask: vm.workTask,
      complaint: null
    });
  };

  vm.openCreateExpenseEntryModal = () => {
    ExpenseEntryService.createExpenseEntry([], [], vm.workTask);
  };

  vm.addNote = function (object) {
    vm.content = $window.prompt('Nhập số lượng');
    object.notes = object.notes || [];
    object.notes.push({
      content: vm.content,
      user: vm.user
    });
  };

  vm.sendTicket = function (user, workTask) {
    SticketService.openCreateTicket({
      user,
      workTask
    }).then(sticket => {
      vm.workTask.notes = vm.workTask.notes || [];
      vm.workTask.notes.push({
        content: `Đã gửi ticket cho ${user.code} - ${user.displayName}. Nội dung: ${sticket.content}`,
        user: Authentication.user,
        time: new Date()
      });
      workTask = vm.workTask;
      const workTaskId = workTask._id;
      workTask.$update(function () {
        vm.workTask = WorkTasks.get({
          workTaskId
        });
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
      });
    });
  };

  vm.init = taskType => {
    vm.statusMap = {
      created: true,
      processing: true,
      pending: true,
      done: false,
      deleted: false
    };
    vm.statuses = _.keys(vm.statusMap);
    vm.statusLabel = {
      created: 'default',
      processing: 'info',
      pending: 'primary',
      done: 'success',
      deleted: 'warning'
    };

    if (taskType === 'TECH') {
      vm.searchByTime = false;
    } else {
      vm.searchByTime = true;
    }

    vm.startDate = moment().subtract(2, 'month').format('YYYY-MM-DD');
    vm.endDate = moment().add(1, 'week').format('YYYY-MM-DD');
    vm.workTask = vm.workTask || {};

    if (!vm.workTask.taskType) {
      vm.workTask.taskType = 'HC';
    }

    if (taskType === 'HC') {
      vm.groups = FacilityService.getGroups();
    }

    vm.data.piorities = WorkTaskService.getPiorities();

    vm.hasTechAuthorization = function () {
      return vm.user.roles.includes('bom') || vm.user.outlet.code === 'TECH';
    };

    vm.data.workTaskCategoriesFilter = WorkTaskCategories.query().$promise.then(workTaskCategories => {
      vm.data.workTaskCategories = workTaskCategories;

      _.forEach(vm.data.workTaskCategories, workTaskCategory => {
        vm.workTaskCategoriesMap[workTaskCategory.name] = false;
      });

      return _.map(workTaskCategories, workTaskCategory => {
        return {
          id: workTaskCategory.name,
          title: workTaskCategory.name
        };
      });
    });
  };

  vm.getActiveTECHStaffs = () => {
    return UserService.getActiveStaffsByOutlet('TECH').then(staffs => {
      vm.data.techStaffs = staffs;
      vm.data.reviewers = _.filter(staffs, staff => _.includes(['E09', 'D708', 'F432'], staff.code));
      return _.reduce(staffs, (result, staff) => {
        return _.concat(result, [{
          id: staff.code,
          title: staff.displayName
        }]);
      }, [{
        id: 'none',
        title: 'Chưa có'
      }]);
    });
  };

  vm.viewQcWorkTask = WorkTaskService.openViewQcWorkTaskModal;

  vm.initQcTask = function () {
    if (!vm.isQcOrAdmin) {
      vm.setDefaultDeadline();
      vm.workTask.group = 'goods';
      vm.workTask.outlets = [];
      const currentShift = CurrentShift.getCurrentShift();

      const outlet = _.get(currentShift, 'outlet', vm.user.outlet);

      vm.workTask.outlets.push(outlet);
    }

    UserService.allStaffs(function (err, staffs) {
      vm.workTask.staff = _.find(staffs, {
        code: 'D2825'
      });
      if (err) FhdMessenger.errorFromServer(err);
    });
  };

  vm.initVmTask = function () {
    vm.workTask.deadline = moment().add(5, 'days').format('YYYY-MM-DD');
    vm.groups = [{
      id: 'layout',
      title: 'Layout'
    }, {
      id: 'goods-display',
      title: 'Trưng bày hàng hóa'
    }, {
      id: 'poster',
      title: 'Poster'
    }, {
      id: 'outlet-setup',
      title: 'Setup cơ sở mới'
    }, {
      id: 'outlet-convert',
      title: 'Convert cơ sở'
    }, {
      id: 'other',
      title: 'Khác'
    }];
  };

  vm.setDefaultDeadline = function () {
    if (vm.workTask.group === 'goods') {
      vm.workTask.deadline = moment().add(7, 'days').toDate();
    }
  };

  vm.tasksTable = new NgTableParams({
    count: 10
  });

  vm.findWorkTasksByOutlet = function (outlet, taskTypes) {
    if (!outlet.code) {
      return;
    }

    if (!taskTypes) {
      return;
    }

    vm.waiting = true;
    WorkTasks.query({
      statuses: ['created', 'processing'],
      taskTypes,
      outletId: ObjectId.getObjectId(outlet)
    }).$promise.then(tasks => {
      vm.tasks = tasks;
      vm.tasksTable.settings({
        dataset: vm.tasks
      });

      if (taskTypes === 'HC') {
        FhdMessenger.success('Tải xong danh sách HC Task');
      }

      if (taskTypes === 'TECH') {
        FhdMessenger.success('Tải xong danh sách TECH Task');
      }
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.isSupervisor = () => {
    return vm.user.roles.includes('tro-ly') || vm.user.roles.includes('admin');
  };

  vm.canUpdateSalary = () => {
    if (!vm.user || !vm.workTask) {
      return false;
    }

    if (vm.workTask.salaryDate) {
      return false;
    }

    return vm.workTask.status === 'done' && vm.isSupervisor();
  };

  vm.workTasksTable = new NgTableParams({
    count: 1000
  });
  vm.summarizeQcTaskTable = new NgTableParams({
    count: 50
  });
  vm.summaryTechTaskTable = new NgTableParams({
    count: 10
  });

  vm.find = taskTypes => {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const startDate = moment(vm.startDate).isValid() ? moment(vm.startDate).format('YYYY-MM-DD') : null;
    const endDate = moment(vm.endDate).isValid() ? moment(vm.endDate).format('YYYY-MM-DD') : null;
    vm.query = {
      statuses,
      searchDone: vm.searchDone,
      searchByTime: vm.searchByTime,
      taskTypes: taskTypes || ['photo', 'description'],
      endDate,
      startDate,
      outletIdsForWorkTask: _.get(vm.workTask, 'outlets')
    };

    if (taskTypes.includes('QC') && !vm.isQcOrAdmin) {
      const currentShift = CurrentShift.getCurrentShift();
      vm.query.outletIdsForWorkTask = _.concat([_.get(currentShift, 'outlet._id', _.get(vm.user, 'outlet._id'))], _.map(vm.user.managingOutlets, ObjectId.getObjectId));
    }

    vm.waiting = true;
    vm.workTasks = WorkTasks.query(vm.query);
    vm.workTasks.$promise.then(() => {
      _.forEach(vm.workTasks, workTask => {
        if (_.get(workTask, 'stages.done.time')) {
          workTask.doneDays = Math.ceil(moment(workTask.stages.done.time).diff(moment(workTask.created), 'days', true));
        }
      });

      if (taskTypes.includes('QC')) {
        vm.goodsQcTask = _.filter(vm.workTasks, {
          group: 'goods'
        });
        const getAllProductFromQcTask = vm.goodsQcTask.map(workTask => {
          if (workTask.products.length) {
            return workTask.products.map(qcTaskProduct => _objectSpread({
              sku: qcTaskProduct.product.sku,
              description: qcTaskProduct.product.description,
              badQuantity: qcTaskProduct.badQuantity
            }, workTask));
          }

          return [];
        }).flat();

        const summaryGoodsQcTask = _.reduce(_.groupBy(getAllProductFromQcTask, 'sku'), (result, workTasks, sku) => {
          result = result || [];

          const overdueDeadlineTask = _.filter(workTasks, workTask => {
            return moment().isAfter(moment(workTask.deadline));
          }).length;

          const createdTaskAmount = _.get(workTasks, 'length');

          result.push({
            sku: sku,
            description: workTasks[0].description,
            badQuantity: _.sumBy(workTasks, 'badQuantity'),
            createdTaskAmount,
            overdueDeadlineTask,
            rate: overdueDeadlineTask / createdTaskAmount * 100
          });
          return result;
        }, []);

        vm.sum = {
          createdTaskAmount: _.sumBy(summaryGoodsQcTask, 'createdTaskAmount'),
          overdueDeadlineTask: _.sumBy(summaryGoodsQcTask, 'overdueDeadlineTask')
        };

        if (!_.intersection(vm.user.roles, ['admin', 'QC', 'qc-task:view-all']).length) {
          vm.workTasks = vm.goodsQcTask;
        }

        vm.summarizeQcTaskTable.settings({
          dataset: summaryGoodsQcTask
        });
      }

      if (taskTypes.includes('TECH')) {
        const techTasks = _.map(vm.workTasks, workTask => {
          if (!workTask.staff) {
            workTask.staff = undefinedStaff;
          }

          if (workTask.pullRequestLink) {
            workTask.pullRequestId = _.last(_.split(workTask.pullRequestLink, '/'));
          }

          workTask.categoriesFilter = _.join(_.map(workTask.workTaskCategories, 'name'), ' ');
          workTask.notesFilter = _.join(_.map(workTask.notes, 'content'), ' ');
          return _objectSpread({}, workTask, {
            staffName: _.get(workTask, 'staff.displayName', 'Chưa có'),
            piority: workTask.piority
          });
        });

        const summaryTechTask = _.reduce(_.groupBy(techTasks, 'staffName'), (result, techTasks, staffName) => {
          result.push({
            staffName,
            total: _.get(techTasks, 'length'),
            highCount: _.filter(techTasks, {
              piority: 'high'
            }).length,
            mediumCount: _.filter(techTasks, {
              piority: 'medium'
            }).length,
            lowCount: _.filter(techTasks, {
              piority: 'low'
            }).length,
            yetPiorityCount: _.filter(techTasks, {
              piority: 'none'
            }).length
          });
          return result;
        }, []);

        vm.summaryTechTaskTable.settings({
          dataset: summaryTechTask
        }).sorting({
          total: 'desc'
        });
      }

      vm.workTasksTable.settings({
        dataset: vm.workTasks
      });
      vm.quantityWorkTasksGroupByGroup = _.countBy(vm.workTasks, 'group');
      vm.quantityWorkTasksGroupByStatus = _.countBy(vm.workTasks, 'status');
      FhdMessenger.success('Tải xong');
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tìm...', vm.workTasks.$promise);
  };

  $scope.$watch(() => vm.summaryTechTaskTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.highCount = _.sumBy(newValue, obj => {
      return _.get(obj, 'highCount', 0);
    });
    vm.mediumCount = _.sumBy(newValue, obj => {
      return _.get(obj, 'mediumCount', 0);
    });
    vm.lowCount = _.sumBy(newValue, obj => {
      return _.get(obj, 'lowCount', 0);
    });
    vm.yetPiorityCount = _.sumBy(newValue, obj => {
      return _.get(obj, 'yetPiorityCount', 0);
    });
    vm.techTaskTotal = _.sumBy(newValue, obj => {
      return _.get(obj, 'total', 0);
    });
  });

  vm.findOne = () => {
    vm.workTask = WorkTasks.get({
      workTaskId: $stateParams.workTaskId
    });
    vm.workTask.$promise.then(() => {
      if (vm.workTask.deadline) {
        vm.workTask.deadline = getDeadlineText(vm.workTask);
      }

      if (['photo', 'description'].includes(vm.workTask.taskType)) {
        WooProductCategoryService.withoutChildrenAsync().then(function (categories) {
          vm.wooProductCategories = _.map(categories, WooProductCategoryService.getCategoryWithDescription);
        });
        vm.workTask.wooProperties.categories = _.map(vm.workTask.wooProperties.categories, WooProductCategoryService.getCategoryWithDescription);
      }

      if (['TECH'].includes(vm.workTask.taskType)) {
        _.forEach(vm.workTask.workTaskCategories, workTaskCategory => {
          vm.workTaskCategoriesMap[workTaskCategory.name] = true;
        });
      }
    });
  };

  function getDeadlineText(workTask) {
    if (workTask.taskType === 'QC') {
      return new Date(vm.workTask.deadline);
    }

    return moment(vm.workTask.deadline).format('YYYY-MM-DD');
  }

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;

          if (_.every(_.map(vm.statusMap))) {
            changeValue = false;
          }

          _.forEach(vm.statusMap, (status, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }
    }
  };

  vm.changeTechTaskStatusAtListPage = function (workTask) {
    if (workTask.status === 'created') {
      vm.waiting = true;
      return workTask.$processing().then(() => {
        FhdMessenger.success('Đã chuyển sang trạng thái đang xử lý!');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
        vm.find('TECH');
        vm.getActiveTECHStaffs();
      });
    }

    if (workTask.status === 'processing') {
      return workTask.$pending().then(() => {
        FhdMessenger.success('Đã chuyển sang trạng thái chờ duyệt!');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
        vm.find('TECH');
        vm.getActiveTECHStaffs();
      });
    }

    if (workTask.status === 'pending') {
      if (!_.intersection(vm.user.roles, ['admin', 'work-task:done']).length) {
        return FhdMessenger.error('Bạn không có quyền chuyển trạng thái done');
      }

      return workTask.$done().then(() => {
        FhdMessenger.success('Đã chuyển sang trạng thái hoàn thành!');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
        vm.find('TECH');
        vm.getActiveTECHStaffs();
      });
    }
  };

  vm.changeStatus = function () {
    if (vm.workTask.status === 'created') {
      return vm.processing();
    }

    if (vm.workTask.status === 'processing') {
      if (['photo', 'description', 'TECH'].includes(vm.workTask.taskType)) {
        if (!ObjectId.equals(vm.workTask.staff, vm.user) && vm.workTask.taskType !== 'TECH') {
          return FhdMessenger.error('Người hoàn thành task phải là người được giao xử lý task');
        }

        if (vm.workTask.taskType !== 'TECH') {
          return vm.pending();
        }

        return WorkTaskService.openModalSubmitTECHTask(vm.workTask).then(({
          pullRequestLink,
          reviewer
        }) => {
          vm.workTask.pullRequestLink = pullRequestLink;
          vm.workTask.reviewer = reviewer;
          vm.pending();
        });
      }

      if (['VM'].includes(vm.workTask.taskType) && !vm.workTask.images.length) {
        return FhdMessenger.error('Cần cập nhật ảnh trước khi có thể chuyển sang trạng thái Done');
      }

      return vm.done();
    }

    if (vm.workTask.status === 'pending') {
      if (!_.intersection(vm.user.roles, ['admin', 'work-task:done']).length) {
        return FhdMessenger.error('Bạn không có quyền chuyển trạng thái done');
      }

      if (vm.workTask.taskType === 'description') {
        return WorkTaskService.selectSalaryForWorkTask(vm.workTask).then(salaryType => {
          vm.workTask.salaryType = salaryType;
          vm.done();
        });
      }

      return vm.done();
    }
  };

  vm.create = taskType => {
    if (taskType) {
      vm.workTask.taskType = taskType;
    }

    if (vm.workTask.taskType === 'HC') {
      if (!_.get(vm.workTask, 'outlet._id')) {
        return FhdMessenger.error('Chưa chọn cơ sở');
      }

      if (!_.get(vm.workTask, 'group')) {
        return FhdMessenger.error('Chưa chọn nhóm vấn đề');
      }

      if (!_.get(vm.workTask, 'facility')) {
        return FhdMessenger.error('Chưa chọn cơ sở vật chất tương ứng');
      }

      if (!_.get(vm.workTask, 'name')) {
        return FhdMessenger.error('Chưa điền tên vấn đề');
      }
    }

    if (vm.workTask.taskType === 'TECH') {
      if (!_.get(vm.workTask, 'name')) {
        return FhdMessenger.error('Chưa điền tên vấn đề');
      }
    }

    if (vm.workTask.taskType === 'description') {
      if (!_.get(vm.workTask, 'product')) {
        return FhdMessenger.error('Chưa chọn sản phẩm cần viết mô tả');
      }
    }

    if (vm.workTask.taskType === 'QC') {
      if (!_.get(vm.workTask, 'group')) {
        return FhdMessenger.error('Chưa điền loại QC task');
      }

      if (!_.get(vm.workTask, 'detail')) {
        return FhdMessenger.error('Chưa điền mô tả');
      }

      if (!_.get(vm.workTask, 'name')) {
        return FhdMessenger.error('Chưa điền tên task');
      }

      if (!_.get(vm.workTask, 'staff') && vm.isQcOrAdmin) {
        return FhdMessenger.error('Chưa điền nhân viên xử lý');
      }

      if (!_.get(vm.workTask, 'outlets.length')) {
        return FhdMessenger.error('Chưa chọn cơ sở');
      }

      if (vm.workTask.group === 'goods') {
        if (!_.get(vm.workTask, 'products.length')) {
          return FhdMessenger.error('Chưa thêm sản phẩm');
        }

        if (_.get(vm.workTask, 'products.length')) {
          const products = _.get(vm.workTask, 'products');

          const isNotHaveBadQuantity = _.some(products, qcTaskProduct => {
            return qcTaskProduct.badQuantity < 0 || !qcTaskProduct.badQuantity;
          });

          if (isNotHaveBadQuantity) {
            return FhdMessenger.error('Chưa điền đủ số lượng lỗi cho từng sản phẩm');
          }
        }

        if (!_.get(vm.workTask, 'images.length')) {
          return FhdMessenger.error('Chưa chọn ảnh');
        }
      }
    }

    if (vm.workTask.taskType === 'VM') {
      if (!_.get(vm.workTask, 'name')) {
        return FhdMessenger.error('Chưa điền tiêu đề');
      }

      if (!_.get(vm.workTask, 'detail')) {
        return FhdMessenger.error('Chưa điền mô tả');
      }

      if (!_.get(vm.workTask, 'outlets.length')) {
        return FhdMessenger.error('Chưa chọn cơ sở');
      }
    }

    if (vm.workTask.taskType === 'buying') {
      if (!_.get(vm.workTask, 'name')) {
        return FhdMessenger.error('Chưa điền tiêu đề');
      }

      if (!_.get(vm.workTask, 'detail')) {
        return FhdMessenger.error('Chưa điền mô tả');
      }

      if (!_.get(vm.workTask, 'staff')) {
        return FhdMessenger.error('Chưa chọn nhân viên xử lý');
      }
    }

    vm.workTask.workTaskCategories = _.filter(vm.data.workTaskCategories, workTaskCategory => vm.workTaskCategoriesMap[workTaskCategory.name]);
    const workTask = new WorkTasks(vm.workTask);
    vm.waiting = true;
    workTask.$save().then(_workTask => {
      if (_workTask.taskType === 'HC') {
        $state.go('listHCWorkTasks');
      }

      if (_workTask.taskType === 'TECH') {
        $state.go('listTechWorkTasks');
      }

      if (_workTask.taskType === 'QC') {
        $state.go('listQCWorkTasks');
      }

      if (_workTask.taskType === 'VM') {
        $state.go('listVMWorkTasks');
      }

      if (_workTask.taskType === 'description') {
        $state.go('listWorkTasks');
      }

      if (_workTask.taskType === 'buying') {
        $state.go('listBuyingWorkTasks');
      }
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateNote = () => {
    vm.waiting = true;

    if (vm.newNote) {
      vm.workTask.note = vm.newNote;
    }

    const workTask = vm.workTask;
    workTask.$updateNote().then(WorkTasks.get({
      workTaskId: $stateParams.workTaskId
    })).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
      vm.newNote = '';
    });
  };

  vm.openModalAddNote = WorkTaskService.addNote;
  vm.requestChangeDeadlineQCTask = WorkTaskService.requestChangeDeadlineQCTask;

  vm.productSearchSelected = product => {
    vm.workTask.products = vm.workTask.products || [];

    const matchProduct = _.find(vm.workTask.products, {
      sku: product.sku
    });

    if (matchProduct) {
      return FhdMessenger.error(`Đã có sản phẩm ${product.sku} - ${product.description} trong danh sách`);
    }

    if (vm.workTask.products.length > 1) {
      return FhdMessenger.error(`Chỉ được có 1 sản phẩm trong danh sách`);
    }

    vm.workTask.products.push({
      product: product._id,
      sku: product.sku,
      description: product.description,
      privateLabel: product.privateLabel
    });
  };

  vm.selectProblem = function (item) {
    WorkTaskService.openModalSelectProblem(item).then(result => {
      if (!result) {
        return;
      }

      Object.assign(item, result);
    });
  };

  vm.listFibonacci = helper.createListFibonacci(10);

  vm.updatePoint = function (workTask) {
    if (!vm.hasTechAuthorization()) {
      return FhdMessenger.error('Bạn không có quyền sửa');
    }

    const currentPoint = workTask.point;
    const newPoint = Number($window.prompt('Nhập/sửa điểm', currentPoint));

    if (!vm.listFibonacci.includes(newPoint)) {
      return FhdMessenger.error('Vui lòng nhập số Fibonacci');
    }

    if (currentPoint && !newPoint) {
      return FhdMessenger.error('Vui lòng nhập số');
    }

    workTask.point = newPoint;
    vm.waiting = true;
    workTask.$updatePoint().then(() => {
      FhdMessenger.success('Cập nhật điểm task thành công!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.update = (workTask, attribute, data) => {
    if (vm.workTask.taskType === 'VM') {
      vm.workTask.images = vm.workTask.images || [];
      vm.workTask.images = vm.workTask.images.concat(vm.vmTaskImages);
    }

    if (!workTask) {
      workTask = vm.workTask;
    }

    if (workTask.taskType === 'TECH' && _.get(workTask, 'staff.code', 'none') === 'none') {
      workTask = _.omit(workTask, 'staff');
    }

    if (attribute) {
      if (!vm.hasTechAuthorization()) {
        return FhdMessenger.error('Bạn không có quyền sửa thuộc tính này');
      }

      workTask[attribute] = data;
    }

    if (workTask.taskType === 'TECH') {
      workTask.workTaskCategories = _.filter(vm.data.workTaskCategories, workTaskCategory => vm.workTaskCategoriesMap[workTaskCategory.name]);
    }

    vm.waiting = true;
    WorkTasks.update(workTask).$promise.then(() => {
      FhdMessenger.success('Đã cập nhật Work Task!');
      vm.vmTaskImages = [];
    }).catch(error => FhdMessenger.errorFromServer(error)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.createWorkTaskWriteDescription = function () {
    vm.waiting = true;
    const product = vm.workTask.product;
    ProductService.requestWorkTask(product, {
      taskType: 'description'
    }).then(response => {
      FhdMessenger.success('Đã tạo task viết mô tả');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.processing = function () {
    vm.waiting = true;
    vm.workTask.$processing().then(() => {
      FhdMessenger.success('Đã chuyển sang trạng thái đang xử lý!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.pending = () => {
    vm.waiting = true;
    vm.workTask.$pending().then(() => {
      FhdMessenger.success('Đã chuyển sang trạng thái chờ duyệt!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.done = () => {
    if (vm.workTask.taskType === 'QC' && vm.workTask.group === 'internal-task' && !vm.newNote) {
      return FhdMessenger.error('Chưa có ghi chú cho khi done QC Task');
    }

    vm.workTask.newNote = vm.newNote;
    vm.waiting = true;
    vm.workTask.$done().then(() => {
      FhdMessenger.success('Đã chuyển sang trạng thái hoàn thành!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.returnStatus = status => {
    vm.waiting = true;

    if (vm.workTask.status === 'done') {
      vm.workTask.wasDone = true;
    }

    vm.workTask.status = status;
    vm.workTask.$returnStatus().then(() => {
      FhdMessenger.success(`Đã chuyển về trạng thái ${status}`);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.delete = () => {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xóa`,
      headerText: `Bạn có muốn xóa Work Task này?`,
      bodyText: `Bạn chắc chắn muốn xóa work task này?`
    }).then(() => {
      vm.waiting = true;
      vm.workTask.$deleted().then(() => {
        FhdMessenger.success('Đã xóa Work Task này!');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(vm.waiting = false);
    });
  }; // For Photo Work Task


  vm.addImage = newImage => {
    vm.rawImages = vm.rawImages || [];

    if (newImage) {
      vm.rawImages.push({
        data: newImage
      });
    }

    if (vm.srcImg && vm.srcImg.match(/(https?:\/\/.*\.(?:png|jpg))/i)) {
      vm.rawImages.push({
        inputLink: vm.srcImg
      });
    }
  };

  vm.updateImages = () => {
    const workTask = vm.workTask;
    workTask.rawImages = vm.rawImages;
    vm.waiting = true;
    workTask.$uploadLinkImages().then(() => {
      FhdMessenger.success('Cập nhật ảnh thành công!');
      vm.rawImages = [];
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.imagesChanged = function () {
    vm.workTask.wooProperties = vm.workTask.wooProperties || {};
    vm.workTask.wooProperties.images = vm.workTask.wooProperties.images || [];

    const numberOfBlankImages = _.filter(vm.workTask.wooProperties.images, isSrcBlank).length;

    if (numberOfBlankImages >= 2) {
      const matchIndex = _.findIndex(vm.product.wooProperties.images, isSrcBlank);

      vm.workTask.wooProperties.images.splice(matchIndex, 1);
    }

    if (numberOfBlankImages < 1) {
      vm.workTask.wooProperties.images.push({
        src: ''
      });
    }
  };

  vm.openModalUpdateWorkDepartment = () => {
    PortraitService.openChooseProcessWorkDepartmentModal(vm.workTask).then(() => {
      vm.workTask.$updateWorkDepartment().then(res => {
        vm.portrait = res;
      }).catch(err => {
        FhdMessenger.error(err.message);
      });
    });
  };

  function isSrcBlank(image) {
    return !image.src;
  }

  vm.exportTable = () => {
    vm.waiting = true;

    if (vm.linkGoogleSheet) {
      const confirm = $window.confirm('Bạn đã tạo link google sheet, bạn muốn tạo mới chứ?');

      if (!confirm) {
        return;
      }
    }

    FhdMessenger.info('Đang tạo');
    let sheetCols = ['Người xử lý', 'Cơ sở', 'Nhóm', 'Tên', 'CSVC', 'Trạng thái', 'Tạo', 'Số ngày để done', 'Cần di chuyển'];
    const sheetData = [];

    _.forEach(vm.workTasksTable.data, workTask => {
      const group = _.get(_.find(vm.groups, {
        group: workTask.group
      }), 'name', workTask.group);

      let diffDay;

      if (_.get(workTask.stages, 'done.time')) {
        diffDay = Math.ceil(moment(workTask.stages.done.time).diff(moment(workTask.created), 'days', true));
      }

      const data = [workTask.staff.displayName, workTask.outlet.code, group, workTask.name, _.get(workTask, 'facility.name', ''), workTask.status, moment(workTask.created).format('YYYY/MM/DD HH:mm'), diffDay, workTask.needToMove];
      sheetData.push(data);
    });

    $http.post('/sheet', {
      sheetData: sheetData,
      sheetTitle: `Danh sách HC  Task từ ngày ${moment(vm.startDate).format('DD/MM')} đến ngày ${moment(vm.endDate).format('DD/MM')}`,
      sheetCols
    }).then(res => {
      vm.linkGoogleSheet = `https://docs.google.com/spreadsheets/d/${res.data.data.spreadsheetId}`;
      $window.open(vm.linkGoogleSheet);
      FhdMessenger.success('Đã tạo thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  function listenUpdateWorktask(updatedWorkTask) {
    const {
      workTaskId
    } = $stateParams;

    if (workTaskId === updatedWorkTask._id) {
      vm.workTask = updatedWorkTask;
      FhdMessenger.info(`Work Task vừa mới được cập nhật`);
      return $state.reload();
    }

    const index = _.findIndex(vm.workTasks, {
      _id: updatedWorkTask._id
    });

    if (index < 0) {
      return;
    }

    if (!updatedWorkTask.staff) {
      updatedWorkTask.staff = undefinedStaff;
    }

    vm.workTasks.splice(index, 1, updatedWorkTask);
    vm.workTasksTable.settings({
      dataset: vm.workTasks
    });
    vm.workTasksTable.reload();
  }

  Sockets.on('updateWorkTask', listenUpdateWorktask);
  $scope.$on('$destroy', function () {
    Sockets.removeListener('updateWorkTask', listenUpdateWorktask);
  });
}]);
'use strict';

angular.module('work-tasks').directive('fhdWorkTaskStatus', [function () {
  return {
    templateUrl: 'modules/work-tasks/templates/fhd-work-task-status.client.template.html',
    restrict: 'E',
    scope: {
      workTask: '='
    }
  };
}]);
"use strict";

angular.module('work-tasks').filter('workTaskGroup', [function () {
  return function (group) {
    switch (group) {
      case 'partnership-app':
        return 'App đối tác';

      case 'computer':
        return 'Máy tính/Mạng/Camera';

      case 'waterAndElectricEquipment':
        return 'Thiết bị điện/Cấp thoát nước';

      case 'infrastructure':
        return 'Cơ sở hạ tầng';

      case 'other':
        return 'Khác';

      case 'goods':
        return 'Hàng hóa';

      case 'internal-task':
        return 'Nội bộ';

      case 'layout':
        return 'Layout';

      case 'goods-display':
        return 'Trưng bày hàng hóa';

      case 'poster':
        return 'Poster';

      case 'outlet-setup':
        return 'Setup cơ sở mới';

      case 'outlet-convert':
        return 'Convert cơ sở';

      default:
        return group;
    }
  };
}]);
"use strict";

angular.module('work-tasks').filter('workTaskType', [function () {
  return function (taskType) {
    switch (taskType) {
      case 'photo':
        return 'Chụp ảnh sản phẩm';

      case 'description':
        return 'Viết mô tả sản phẩm';

      case 'QC':
        return 'QC';

      case 'VM':
        return 'VM';

      case 'HC':
        return 'HC';

      case 'buying':
        return 'Buying';

      default:
        return 'Khác';
    }
  };
}]);
'use strict';

angular.module('work-tasks').factory('WorkTaskService', ['$modal', '$http', 'ObjectId', function ($modal, $http, ObjectId) {
  const groups = [{
    id: 'goods',
    title: 'Hàng hóa'
  }, {
    id: 'internal-task',
    title: 'Nội bộ'
  }];
  const problems = [{
    code: 'label-item',
    title: 'Lỗi bao bì, nhãn'
  }, {
    code: 'quality-item',
    title: 'Lỗi chất lượng sản phẩm'
  }, {
    code: 'parcel-item',
    title: 'Lỗi theo lô'
  }, {
    code: 'strange-item',
    title: 'Lỗi dị vật'
  }, {
    code: 'props-label-item',
    title: 'Lỗi nhãn (sai thông tin nhãn)'
  }, {
    code: 'vacuum-item',
    title: 'Lỗi dập nhiệt, hút chân không'
  }];
  const piorities = [{
    id: 'high',
    title: 'High',
    class: 'primary'
  }, {
    id: 'medium',
    title: 'Medium',
    class: 'danger'
  }, {
    id: 'low',
    title: 'Low',
    class: 'info'
  }, {
    id: 'none',
    title: 'None',
    class: 'default'
  }];

  function getProblems(workTask) {
    if (!workTask) return problems;
    return _.map(problems, problem => {
      problem.selected = _.includes(workTask.problems, problem.code);
      return problem;
    });
  }

  function getSelectedProblemCodes(problems) {
    return _.map(_.filter(problems, 'selected'), 'code');
  }

  function getSelectedProblemTitles(problems) {
    return _.map(_.filter(problems, 'selected'), 'title');
  }

  return {
    getPiorities() {
      return piorities;
    },

    getProblems,
    getSelectedProblemCodes,
    getSelectedProblemTitles,
    addNote: function addNote(workTask) {
      return $modal.open({
        templateUrl: '/modules/work-tasks/templates/modal-add-note-work-task.client.template.html',
        controller: 'ModalAddNoteWorkTaskController',
        controllerAs: 'vm',
        size: 'md',
        resolve: {
          workTask: () => workTask
        }
      }).result;
    },
    requestChangeDeadlineQCTask: function requestChangeDeadlineQCTask(workTask) {
      return $modal.open({
        templateUrl: '/modules/work-tasks/templates/modal-request-change-deadline-qc-task.client.template.html',
        controller: 'ModalRequestChangeDeadlineQCWorkTaskController',
        controllerAs: 'vm',
        size: 'md',
        resolve: {
          workTask: () => workTask
        }
      }).result;
    },
    selectSalaryForWorkTask: function selectSalaryForWorkTask(workTask) {
      return $modal.open({
        templateUrl: '/modules/work-tasks/templates/modal-select-salary-for-work-task.client.template.html',
        controller: 'ModalSelectSalaryForWorkTaskController',
        controllerAs: 'vm',
        size: 'md',
        resolve: {
          workTask: () => workTask
        }
      }).result;
    },

    openModalSelectProblem(item) {
      return $modal.open({
        animation: true,
        controller: 'ModalSelectQCTaskProblemController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: 'modules/work-tasks/templates/modal-select-problem-item-in-qc-task.client.view.html',
        resolve: {
          item: () => item
        }
      }).result;
    },

    openModalDoneWorkDepartmentForWorkTask(workTask) {
      return $modal.open({
        animation: true,
        controller: 'ModalDoneWorkDepartmentForWorkTaskController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: 'modules/work-tasks/templates/modal-done-work-department-for-work-task.client.view.html',
        resolve: {
          workTask: () => workTask
        }
      }).result;
    },

    openViewQcWorkTaskModal(workTask) {
      return $modal.open({
        animation: true,
        controller: 'ModalViewQcWorkTaskController',
        controllerAs: 'vm',
        size: 'lg',
        templateUrl: 'modules/work-tasks/templates/modal-view-qc-work-task.client.view.html',
        resolve: {
          workTask: () => workTask
        }
      }).result;
    },

    openModalCreateQCWorkTask(data) {
      return $modal.open({
        animation: true,
        controller: 'ModalCreateQCWorkTaskController',
        controllerAs: 'vm',
        size: 'lg',
        templateUrl: 'modules/work-tasks/templates/modal-create-qc-work-task.client.view.html',
        resolve: {
          data: () => data
        }
      }).result;
    },

    openModalSubmitTECHTask(workTask) {
      return $modal.open({
        animation: true,
        controller: 'ModalSubmitTECHTaskController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: 'modules/work-tasks/templates/modal-submit-tech-task.client.view.html',
        resolve: {
          workTask: () => workTask
        }
      }).result;
    },

    changeWorkDepartment(workTask, choosenWorkDepartment) {
      workTask.workDepartments = workTask.workDepartments || [];

      if (!_.some(workTask.workDepartments, workDepartment => ObjectId.equals(workDepartment.workDepartment, choosenWorkDepartment))) {
        workTask.workDepartments.push({
          workDepartment: choosenWorkDepartment
        });
      }
    },

    getGroups() {
      return groups;
    }

  };
}]);
'use strict'; // Complaints service used to communicate Complaints REST endpoints

angular.module('work-tasks').factory('WorkTasks', ['$resource', function ($resource) {
  return $resource('work-tasks/:workTaskId', {
    workTaskId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    updateNote: {
      method: 'PUT',
      url: 'work-tasks/:workTaskId/updateNote'
    },
