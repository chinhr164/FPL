      if (vm.lastWeek) date.date(date.date() - 6);else if (vm.firstDay) date.date(1);
      vm.date = date.format('YYYY-MM-DD');
    }

    if (vm.labelColumn) {
      var labelElm = element.find('label');
      var inputElm = element.find('fhd-controls');
      labelElm.addClass('col-sm-' + vm.labelColumn);
      inputElm.addClass('col-sm-' + (12 - vm.labelColumn));
