angular.module('woo-product-categories').factory('WooProductCategoryService', ['WooProductCategories', function (WooProductCategories) {
  var wooProductCategories = WooProductCategories.query();
  return {
    allAsync: function () {
      return wooProductCategories.$promise;
    },
    getCategoryWithDescription: function (category) {
      const parentText = category.parent ? `${category.parent.name} -> ` : '';
      return _.assign(category, {
        description: `${parentText}${category.name}`
      });
    },
    withoutChildrenAsync: function () {
      return wooProductCategories.$promise.then(function (categories) {
        var filtered = _.reject(categories, function (category) {
          return _.some(categories, {
            parent: category._id
          });
        });

        return filtered;
      });
    },
    getFromId: function (id) {
      return _.find(wooProductCategories, {
        _id: id
      });
    }
  };
}]);
'use strict'; // Setting up route

