}]);
"use strict";

angular.module('buying-entries').controller('ViewBuyingEntryController', ['$http', 'BuyingEntries', 'BuyingService', 'CartonEntryService', '$stateParams', 'BuyingEntryService', 'ComplaintService', 'FhdMessenger', '$state', 'NgTableParams', 'ObjectId', '$localStorage', '$window', '$location', 'Authentication', 'ProductService', 'StockMap', 'ExpenseEntryService', 'SticketService', '$scope', 'PaymentRequestsService', 'UserNoteService', '$q', '$document', 'AnchorSmoothScroll', '$modal', function ($http, BuyingEntries, BuyingService, CartonEntryService, $stateParams, BuyingEntryService, ComplaintService, FhdMessenger, $state, NgTableParams, ObjectId, $localStorage, $window, $location, Authentication, ProductService, StockMap, ExpenseEntryService, SticketService, $scope, PaymentRequestsService, UserNoteService, $q, $document, AnchorSmoothScroll, $modal) {
  const vm = this; // const getCurrentStatus = BuyingEntryService.getCurrentStatus

  vm.user = Authentication.user;
  vm.now = moment();
  vm.canEditBuyingVendor = /admin|buying-entry:edit-vendor/.test(vm.user.roles);
  vm.newItem = {};
  vm.openCreateComplaintModal = ComplaintService.openCreateComplaintModal;
  vm.openModalViewPaymentRequest = PaymentRequestsService.openModalViewPaymentRequest;
  vm.openDetailCartonEntryModal = CartonEntryService.openDetailCartonEntryModal;
  vm.openlDayLeftDetailModal = BuyingEntryService.openlDayLeftDetailModal;
  vm.hideCogs = vm.user.roles.includes('tro-ly-kho') || vm.user.roles.includes('admin-stock');
  vm.isPurchaser = _.intersection(vm.user.roles, ['admin', 'purchaser', 'probation-purchaser']).length;
  vm.isViewCogs = vm.isPurchaser || _.intersection(vm.user.roles, ['accountant']).length;

  vm.openCreateBuyingEntryComplaintModal = buyingEntry => {
    if (buyingEntry && buyingEntry.items) {
      buyingEntry.complaintItems = _.reduce(vm.buyingEntry.items, (result, item) => {
        if (item.checked) {
          result.push({
            product: item.product,
            sku: item.sku,
            description: item.description,
            cogs: item.cogs
          });
        }

        return result;
      }, []);
    }

    BuyingEntryService.openCreateBuyingEntryComplaintModal(buyingEntry).result.then(buyingEntry => {
      vm.buyingEntry = buyingEntry;
    });
  };

  vm.updateDate = function (item, prop) {
    const dateText = $window.prompt('Nhập ngày với định dạng DD/MM/YYYY');
    const date = moment(dateText, 'DD/MM/YYYY').toDate();

    if (!moment(date).isValid()) {
      return FhdMessenger.error('Ngày tháng bạn nhập không đúng, vui lòng nhập lại');
    } else {
      item[prop] = date;
    }
  };

  vm.changeBuyingVendor = () => {
    return $modal.open({
      templateUrl: 'modules/buying-entries/templates/modal-change-buying-vendor.client.view.html',
      controller: 'ModalChangeBuyingVendorController',
      controllerAs: 'vm',
      size: 'md',
      resolve: {
        vendor: () => vm.buyingEntry.vendor,
        buyingEntry: () => vm.buyingEntry
      }
    });
  };

  vm.createPlEntry = buyingEntry => {
    if (buyingEntry && buyingEntry.items) {
      const plEntryItems = _.reduce(vm.buyingEntry.items, (result, item) => {
        if (item.checked && item.product.privateLabel) {
          result.push({
            product: ObjectId.getObjectId(item.product),
            sku: item.sku,
            description: item.description,
            quantity: item.arrivedQuantity,
            waitingQuantity: item.waitingQuantity,
            plTaskQuantity: item.plTaskQuantity,
            manufacturingDate: item.manufacturingDate,
            expirationDate: item.expirationDate,
            buyingCogs: item.cogs
          });
        }

        return result;
      }, []);

      $localStorage.setObject('buyingEntry', buyingEntry);

      if (!_.get(plEntryItems, 'length')) {
        return FhdMessenger.error(`Bạn chưa chọn sản phẩm PL nào`);
      }

      if (plEntryItems.length && !$window.Cypress) {
        $localStorage.setObject('plEntryItems', plEntryItems);
        $window.open(`${$location.protocol()}://${$location.host()}${$location.port() !== 80 ? `:${$location.port()}` : ''}/#!/pl-entries/create`, '_blank');
      }
    }
  };

  function checkWrongWareHouseRestock(items = []) {
    const listItems = items.length ? items : _.get(vm.buyingEntry, 'items', []);

    if (vm.buyingEntry.destination && vm.buyingEntry.destination.code.match(/^D\d+/)) {
      const wrongRestockItems = _.filter(listItems, item => {
        return _.get(item.product.warehouseRestock, '_id') !== vm.buyingEntry.destination._id;
      });

      if (wrongRestockItems.length) {
        _.forEach(wrongRestockItems, item => {
          FhdMessenger.error(`${item.sku} ${item.description} restock từ ${item.product.warehouseRestock.code} không thể chọn cơ sở nhận là ${vm.buyingEntry.destination.code}`);
        });
      }
    }
  }

  vm.isCaculatingDayLeft = true;

  vm.openDoneBuyingEntryComplaintModal = (buyingEntry, index) => {
    BuyingEntryService.openDoneBuyingEntryComplaintModal(buyingEntry, index).result.then(buyingEntry => {
      vm.buyingEntry = buyingEntry;
    });
  };

  vm.init = function () {
    if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('purchaser') && !vm.user.roles.includes('probation-purchaser') && !vm.user.roles.includes('accountant') && !vm.user.roles.includes('admin-stock') && !vm.user.roles.includes('tro-ly-kho')) {
      $state.go('home');
    }

    vm.VIPLv = BuyingService.getVIPLv();
  };

  vm.summary = {
    discount: 0,
    expense: 0
  };

  vm.editStockEntry = function (stockEntry) {
    stockEntry.editing = true;
  };

  vm.updateStockEntry = function (stockEntry) {
    vm.waiting = true;
    $http.put(`stock-entries/${stockEntry._id}`, stockEntry).then(response => {
      FhdMessenger.success(`Cập nhật Stock Entry ${stockEntry.stockEntryId} thành công`);
      vm.stockEntries = BuyingEntries.stockEntries({
        buyingEntryId: $stateParams.buyingEntryId
      });
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.checkAll = function () {
    _.forEach(vm.buyingEntry.items, item => {
      item.checked = vm.toCheck;
    });
  };

  vm.openModalViewExpenseEntry = ExpenseEntryService.openViewExpenseEntry;

  vm.openCreatePaymentRequestModal = () => {
    PaymentRequestsService.openModalCreatePaymentRequest({
      buyingEntries: [vm.buyingEntry],
      workTask: null,
      complaint: null
    });
  };

  vm.openCreateExpenseEntryModal = () => {
    ExpenseEntryService.createExpenseEntry([vm.buyingEntry]);
  };

  vm.inputQuantity = function (item) {
    item.buyingQuantity = $window.prompt('Nhập số lượng');
    vm.calculateBuyingItems(vm.buyingEntry);
  };

  vm.inputReceivedOrderItemQuantity = function (item) {
    item.quantity = $window.prompt('Nhập số lượng');
  };

  vm.calculateStockEntryTotalValue = function (stockEntry) {
    stockEntry.totalValue = _.reduce(stockEntry.items, (result, item) => {
      result += _.get(item, 'quantity', 0) * _.get(item, 'buyingCogs', 0);
      return result;
    }, 0);
  };

  vm.calculateValueInStockEntries = function (stockEntries) {
    vm.totalValueInStockEntries = 0;

    _.forEach(stockEntries, stockEntry => {
      stockEntry.totalValue = _.reduce(stockEntry.items, (result, item) => {
        result += _.get(item, 'quantity', 0) * _.get(item, 'buyingCogs', 0);
        return result;
      }, 0);
      stockEntry.totalValueByCurrentCogs = _.reduce(stockEntry.items, (result, item) => {
        item.currentCogs = ProductService.getOutletProperty('cogs', stockEntry.destination, item.product);
        result += _.get(item, 'quantity', 0) * item.currentCogs;
        return result;
      }, 0);
      stockEntry.totalValueByCogs = _.reduce(stockEntry.items, (result, item) => {
        result += _.get(item, 'quantity', 0) * item.cogs;
        return result;
      }, 0);
      vm.totalValueInStockEntries += stockEntry.totalValue;
    });
  };

  vm.findOne = () => {
    const _id = $stateParams.buyingEntryId;
    UserNoteService.getUserNotesByBuyingEntry(_id).then(userNotes => {
      vm.userNotes = userNotes;
    });
    vm.stockEntries = BuyingEntries.stockEntries({
      buyingEntryId: _id
    });
    vm.stockEntries.$promise.then(stockEntries => {
      vm.calculateValueInStockEntries(stockEntries);
    });
    BuyingEntries.expenseEntries({
      buyingEntryId: _id
    }).$promise.then(expenseEntries => {
      vm.expenseEntries = expenseEntries;
    });
    BuyingEntries.plTasks({
      buyingEntryId: _id
    }).$promise.then(plTasks => {
      vm.plTasks = plTasks;
    });
    vm.buyingEntry = BuyingEntries.get({
      buyingEntryId: _id
    });
    vm.buyingEntry.$promise.then(async buyingEntry => {
      buyingEntry.items = _.orderBy(buyingEntry.items, ['product.privateLabel', 'description'], ['desc', 'asc']);
      buyingEntry.items = await BuyingEntryService.calculateDayLeftForBuyingEntry(buyingEntry);
      vm.getTotalLeadTime(buyingEntry);
      vm.calculateBuyingItems(buyingEntry);
      vm.buyingEntry.counters = vm.buyingEntry.counters || [];

      _.forEach(vm.buyingEntry.items, item => {
        let skus;

        if (_.get(item, 'product.vendorProducts.length')) {
          skus = _.map(item.product.vendorProducts, 'sku');
        } else {
          skus = [item.sku];
        }

        const matchItem = findItemInReceivedStage(skus);

        if (matchItem) {
          item.manufacturingDate = matchItem.manufacturingDate;
          item.expirationDate = matchItem.expirationDate;
        }

        item.price = ProductService.getOutletProperty('price', buyingEntry.destination, item.product);
        item.profit = (1 - item.cogs / item.price) * 100;
      });

      vm.fetchTable(); // vm.buyingEntry.status = getCurrentStatus(buyingEntry)

      vm.buyingEntry.itemsTable.sorting({
        description: 'asc'
      });
      vm.showCreatePl = _.some(vm.buyingEntry.items, item => {
        return item.product.privateLabel && (item.arrivedQuantity > 0 || item.waitingQuantity > 0);
      }) && _.intersection(vm.user.roles, ['admin', 'purchaser', 'probation-purchaser']).length;
    });
  };

  vm.getTotalLeadTime = buyingEntry => {
    vm.totalProductionTime = _.sumBy(buyingEntry.items, item => {
      if (!_.get(item, 'product.privateLabel')) return 0;
      return item.buyingQuantity * item.product.productionTime;
    });
  }; // Tìm sản phẩm hàng vendor đã nhận tương ứng với sản phẩm hàng pl của BE


  function findItemInReceivedStage(skus) {
    // Tìm lần nhận hàng cuối cùng có sản phẩm hàng hàng vendor tương ứng với sản phẩm hàng pl
    const matchReceivedStage = _.findLast(vm.buyingEntry.receivedStages, receivedStage => {
      return _.intersection(skus, _.map(receivedStage.items, 'sku')).length > 0;
    });

    if (matchReceivedStage) {
      // Tìm sản phẩm tưng ứng trong lần nhận hàng đó
      const matchItem = _.findLast(matchReceivedStage.items, _item => {
        return skus.includes(_item.sku);
      });

      return matchItem;
    }

    return null;
  }

  $scope.$watch(() => _.get(vm.buyingEntry, 'destination.code'), () => checkWrongWareHouseRestock());

  vm.removePlVendorProducts = function (index, item) {
    item.vendorProducts.splice(index, 1);
    item.vendorProductCogs = _.reduce(item.vendorProducts, (result, vendorProduct) => {
      result += _.get(vendorProduct, 'cogs', 0) * _.get(vendorProduct, 'quantity', 0);
      return result;
    }, item.cogs);
    vm.calculatePlCogs();
  };

  vm.calculatePlCogs = function () {
    vm.totalVendorProductCogs = 0;

    _.forEach(vm.plItemsCogs, item => {
      item.totalCogs = item.packingCogs + item.vendorProductCogs + item.labelCogs + item.wrapperCogs;
      item.totalValue = item.totalCogs * item.quantity;
      vm.totalVendorProductCogs += item.vendorProductCogs * item.quantity;
    }); // console.log()

  };

  vm.calculateBuyingItems = BuyingEntryService.calculateBuyingItems;
  vm.calculateOrderItems = BuyingEntryService.calculateOrderItems;

  vm.addSuggestToOrderItems = buyingEntry => {
    buyingEntry.orderItems = buyingEntry.suggestOrderItems;
    vm.calculateOrderItems(buyingEntry);
  };

  vm.orderRequested = function (buyingEntry) {
    buyingEntry.orderRequested = Date.now();
    buyingEntry.$update().then(FhdMessenger.success('Đã gửi đơn hàng')).catch(FhdMessenger.errorFromServer);
  };

  vm.order = function (buyingEntry) {
    vm.updatingOrdered = true;
    buyingEntry.$order().then(() => {
      FhdMessenger.success('Ok!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.updatingOrdered = false;
    });
  };

  vm.update = function (buyingEntry) {
    let itemCountBySku = _.countBy(buyingEntry.items, 'sku');

    let duplicatedSkus = _.reduce(itemCountBySku, (result, num, sku) => {
      if (num > 1) {
        result.push(sku);
      }

      return result;
    }, []);

    if (duplicatedSkus.length) {
      return FhdMessenger.errorStick(`Mã ${duplicatedSkus.join(' ,')} bị trùng trong danh sách`);
    }

    _.forEach(buyingEntry.items, item => {
      const hasPrivateLabel = _.get(item, 'product.privateLabel', false);

      if (hasPrivateLabel) {
        item.privateLabel = true;
      } else {
        item.privateLabel = false;
      }
    });

    vm.updating = true;
    return buyingEntry.$update().then(() => {
      FhdMessenger.success('Cập nhật thành công!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.updating = false;
    });
  };

  vm.openUpdateDueDateBuyingEntriesModal = function name() {
    const buyingEntries = [vm.buyingEntry];
    BuyingEntryService.openUpdateDueDateBuyingEntriesModal(buyingEntries).result.then(() => {
      vm.find();
    });
  };

  vm.cancel = function (buyingEntry) {
    buyingEntry.cancelNote = $window.prompt('Nhập lý do hủy');

    if (!buyingEntry.cancelNote) {
      return FhdMessenger.error('Chưa điền lý do hủy');
    }

    vm.updating = true;
    buyingEntry.$cancel().then(() => {
      FhdMessenger.success('Đơn đã hủy không đặt hàng!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.updating = false;
    });
  };

  vm.terminate = function (buyingEntry) {
    vm.updating = true;
    buyingEntry.$terminate().then(() => {
      FhdMessenger.success('Đã đánh dấu không đặt được hàng!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.updating = false;
    });
  };

  function checkNeedUpdateBuyingCogs(buyingEntry, stockEntries) {
    // Bánh mì to và bánh mì sandwich lát
    const rejectSkus = ['V0102', 'V0865'];

    if (buyingEntry.country === 'Trung Quốc') {
      return false;
    }

    return !_.some(stockEntries, stockEntry => {
      return _.some(stockEntry.items, item => {
        return rejectSkus.includes(item.sku);
      });
    });
  }

  vm.arrive = function (buyingEntry, stockEntries) {
    if (checkNeedUpdateBuyingCogs(buyingEntry, stockEntries)) {
      const emptyBuyingCogsItems = _.reduce(stockEntries, (result, stockEntry) => {
        let stockEntryItems = stockEntry.items;

        if (!stockEntryItems.length) {
          return result;
        }

        _.forEach(stockEntryItems, item => {
          if (stockEntry.editing || !item.buyingCogs) {
            result.push({
              sku: item.sku,
              description: item.description
            });
          }
        });

        return result;
      }, []);

      if (emptyBuyingCogsItems.length > 0) {
        const text = _.reduce(emptyBuyingCogsItems, (result, item) => {
          return `${result} ${item.sku} - ${item.description}`;
        }, 'Vui lòng nhập giá vốn cho sản phẩm');

        return FhdMessenger.error(text);
      }
    }

    BuyingEntryService.confirmArrivedAll(buyingEntry).then(() => {
      vm.updating = true;
      buyingEntry.$arrive().then(() => {
        FhdMessenger.success('Ok!');
        $state.reload();
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.updating = false;
      });
    });
  };

  vm.restore = function (buyingEntry) {
    vm.updating = true;
    buyingEntry.$restore().then(() => {
      FhdMessenger.success('Khôi phục thành công!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.updating = false;
    });
  };

  vm.fetchTable = () => {
    vm.buyingEntry.itemsTable = new NgTableParams({
      count: 2000
    }, {
      dataset: vm.buyingEntry.items
    });
  };

  vm.addArrivingItem = (product, array) => {
    array = array || [];

    if (product) {
      array.push({
        product: product._id,
        sku: product.sku,
        description: product.description
      });
    } else {
      _.forEach(vm.buyingEntry.items, item => {
        if (item.checked) {
          array.push({
            product: item.product,
            sku: item.sku,
            description: item.description,
            quantity: item.arrivingQuantity
          });
        }
      });
    }
  };

  vm.addBuyingItem = product => {
    vm.buyingEntry.items = vm.buyingEntry.items || [];
    const newItem = {
      product: {
        _id: product._id,
        warehouseRestock: product.warehouseRestock,
        privateLabel: product.privateLabel
      },
      sku: product.sku,
      description: product.description,
      cogs: product.cogs,
      buyingQuantity: 1,
      buyingValue: product.cogs,
      arrivedQuantity: 0,
      arrivingQuantity: 1
    };
    vm.buyingEntry.items.push(newItem);
    vm.buyingEntry.items = _.orderBy(vm.buyingEntry.items, ['product.privateLabel', 'description'], ['desc', 'asc']);
    checkWrongWareHouseRestock([newItem]);
    vm.calculateBuyingItems(vm.buyingEntry);
    vm.fetchTable();

    if (vm.suggestVendor) {
      const matchVendor = _.find(vm.data.vendors, vendor => {
        return ObjectId.equals(vendor, product.vendor);
      });

      if (matchVendor) {
        vm.buyingEntry.vendor = ObjectId.getObjectId(matchVendor);
      }
    }
  };

  vm.removeItem = function (index, items) {
    items.splice(index, 1);
    vm.calculateBuyingItems(vm.buyingEntry);
    vm.calculateOrderItems(vm.buyingEntry);
  };

  vm.createStockEntry = function () {
    vm.waiting = true;
    BuyingEntries.receive({
      _id: _.get(vm.buyingEntry, '_id'),
      receivedItems: vm.receiveItems
    }).$promise.then(({
      plStockEntry
    }) => {
      $state.reload();

      if (plStockEntry && !$window.Cypress) {
        if (plStockEntry) {
          $localStorage.setObject('plEntryItems', plStockEntry.items);
        }

        $window.open(`${$location.protocol()}://${$location.host()}${$location.port() !== 80 ? `:${$location.port()}` : ''}/#!/pl-entries/create`, '_blank');
      }
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.hasStatus = function (buyingEntry, text) {
    if (!buyingEntry) return false;
    let statuses = [];

    if (angular.isString(text)) {
      statuses = text.replace(/\W+/g, ' ').split(' ');
    }

    return _.includes(statuses, buyingEntry.status);
  };

  vm.quickEditProduct = ProductService.quickEditProduct;

  vm.redirectViewBuyingEntry = function () {
    const buyingEntryId = $stateParams.buyingEntryId;
    $state.go('viewBuyingEntry', {
      buyingEntryId
    });
  };

  vm.notePrinted = function () {
    BuyingEntries.printed({
      _id: $stateParams.buyingEntryId
    });
  };

  vm.doneBuyingEntryComplaint = function () {
    vm.buyingEntry.$doneComplaint().then(buyingEntry => {
      vm.buyingEntry = buyingEntry;
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.addOrderId = function (orderId) {
    if (!orderId) {
      return FhdMessenger.error('Chưa có mã orderId');
    }

    vm.buyingEntry.orders = vm.buyingEntry.orders || [];
    vm.buyingEntry.orders.push({
      id: orderId
    });
    vm.orderId = '';
    vm.update(vm.buyingEntry);
  };

  vm.removeOrderId = function (index) {
    vm.buyingEntry.orders.splice(index, 1);
  };

  vm.markComplainted = function (index) {
    vm.buyingEntry.complaintIndex = index;
    vm.buyingEntry.$markComplainted().then(buyingEntry => {
      vm.buyingEntry = buyingEntry;
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.sendTicket = user => {
    SticketService.openCreateTicket({
      user
    });
  };

  vm.sendUserNote = userNote => {
    UserNoteService.openAddUserNoteModal(userNote).then(userNotes => {
      vm.userNotes = [...userNotes, ...vm.userNotes];
    });
  };

  vm.setCalculateCogsForReceiveItems = (item, calculatedCogs) => {
    _.forEach(vm.receiveItems, receiveItem => {
      if (receiveItem.sku === item.sku) {
        receiveItem.buyingCogs = Math.ceil(calculatedCogs.cogs * 1000) / 1000;
        receiveItem.quantity = calculatedCogs.quantity;
      }
    });

    _.forEach(vm.stockEntries, stockEntry => {
      if (!stockEntry.editing) {
        return;
      }

      _.forEach(stockEntry.items, stockEntryItem => {
        if (stockEntryItem.sku === item.sku) {
          stockEntryItem.buyingCogs = Math.ceil(calculatedCogs.cogs * 1000) / 1000;
        }
      });

      vm.calculateStockEntryTotalValue(stockEntry);
    });
  }; // calculate newCogs


  vm.inputValue = function (item, prop) {
    let text = 'Nhập số lượng';

    if (prop === 'unitPrice') {
      text = 'Nhập đơn giá sản phẩm';
    }

    item[prop] = $window.prompt(text);
    vm.calculateItemPrice(vm.buyingEntry.orderItems);
  };

  vm.calculateItemPrice = function () {
    const item = vm.buyingEntry.orderItems;
    BuyingEntryService.calculateItemPrice(item);
    vm.calculateTotalDiscountAndRate();
  };

  vm.calculateTotalDiscountAndRate = () => {
    vm.buyingEntry.totalPrice = _.sumBy(vm.buyingEntry.orderItems, 'itemPrice');
    vm.buyingEntry.totalAmount = vm.buyingEntry.totalPrice - _.get(vm.buyingEntry, 'discount', 0) + _.get(vm.buyingEntry, 'expense', 0);
    vm.buyingEntry.rate = vm.buyingEntry.totalAmount / vm.buyingEntry.totalPrice;

    _.forEach(vm.buyingEntry.orderItems, item => {
      item.newCogs = item.itemPrice * vm.buyingEntry.rate / item.arrivedQuantity;
    });
  };

  vm.changeCogs = async () => {
    const orderItemsMap = _.reduce(vm.buyingEntry.orderItems, (result, item) => {
      result[item.sku] = result[item.sku] || [];
      result[item.sku] = item;
      return result;
    }, {});

    _.forEach(vm.stockEntries, stockEntry => {
      if (!stockEntry.editing) {
        stockEntry.editing = true;
      }

      _.forEach(stockEntry.items, item => {
        if (item.sku === orderItemsMap[item.sku].sku) {
          item.buyingCogs = orderItemsMap[item.sku].newCogs;
          item.highlightEdited = true;
        }
      });
    });

    const stockEntries = vm.stockEntries;
    vm.calculateValueInStockEntries(stockEntries);
    AnchorSmoothScroll.scrollTo('buyingCogs', 25);
  };
}]);
'use strict'; // Buying entries service used to communicate Buying entries REST endpoints

angular.module('buying-entries').factory('BuyingEntries', ['$resource', function ($resource) {
  return $resource('buying-entries/:buyingEntryId', {
    buyingEntryId: '@_id'
  }, {
    listDirectBuyingEntries: {
      method: 'GET',
      url: 'buying-entries/direct',
      isArray: true
    },
    getComplaintBuyingEntries: {
      method: 'GET',
      url: 'buying-entries/complaint',
      isArray: true
    },
    noticeProductNoBuyingEntry: {
      method: 'POST',
      url: 'buying-entries/notice-product-no-be'
    },
    getUnconfirmDirectBuyingEntries: {
      method: 'GET',
      url: '/buying-entries/get-unconfirm-direct-buying-entries',
      isArray: true
    },
    doneBadItem: {
      method: 'PUT',
      url: 'buying-entries/done-bad-item'
    },
    confirmBadItem: {
      method: 'PUT',
      url: 'buying-entries/confirm-bad-item'
    },
    update: {
      method: 'PUT'
    },
    star: {
      method: 'PUT',
      url: 'buying-entries/:buyingEntryId/star'
    },
    mergeBuyingEntries: {
      method: 'PUT',
      url: 'buying-entries/merge'
    },
    order: {
      method: 'PUT',
      url: 'buying-entries/:buyingEntryId/order'
    },
    cancel: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/cancel'
    },
    terminate: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/terminate'
    },
    stockEntries: {
      method: 'GET',
      url: 'buying-entries/:buyingEntryId/stock-entries',
      isArray: true
    },
    expenseEntries: {
      method: 'GET',
      url: 'buying-entries/:buyingEntryId/expense-entries',
      isArray: true
    },
    plTasks: {
      method: 'GET',
      url: 'buying-entries/:buyingEntryId/pl-tasks',
      isArray: true
    },
    receive: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/receive'
    },
    receiveOrderItems: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/receive-order-items'
    },
    confirmChinaBuying: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/confirm-china-buying'
    },
    confirmAnhPhucBuying: {
      method: 'POST',
      url: 'buying-entries/confirm-anh-phuc'
    },
    arrive: {
      method: 'PUT',
      url: 'buying-entries/:buyingEntryId/arrive'
    },
    pass: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/pass'
    },
    restore: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/restore'
    },
    printed: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/printed'
    },
    needComplaint: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/need-complaint'
    },
    doneComplaint: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/done-complaint'
    },
    markComplainted: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/mark-complainted'
    },
    addBuyingNote: {
      method: 'POST',
      url: 'buying-entries/:buyingEntryId/add-buying-note'
    },
    changeVendor: {
      method: 'PUT',
      url: 'buying-entries/:buyingEntryId/change-vendor'
    }
  });
}]);
'use strict';

angular.module('buying-entries').factory('BuyingEntryService', ['$http', 'ConfirmModal', 'FhdMessenger', '$state', '$modal', 'ProductWeight', 'ObjectId', function ($http, ConfirmModal, FhdMessenger, $state, $modal, ProductWeight, ObjectId) {
  const statuses = [{
    id: 'pending',
    title: 'Chờ duyệt',
    idName: 'showPending',
    class: 'primary'
  }, {
    id: 'created',
    title: 'Đã tạo',
    idName: 'showCreated',
    class: 'warning'
  }, {
    id: 'ordered',
    title: 'Đã đặt',
    idName: 'showOrdered',
    class: 'info'
  }, {
    id: 'received',
    title: 'Đã nhận',
    idName: 'showReceived',
    class: 'ready'
  }, {
    id: 'terminated',
    title: 'Bị hủy',
    idName: 'showTerminated',
    class: 'danger'
  }, {
    id: 'arrived',
    title: 'Đã về',
    idName: 'showArrived',
    class: 'success'
  }, {
    id: 'cancelled',
    title: 'Đã xóa',
    idName: 'showCancelled',
    class: 'default'
  }];
  const paymentStatuses = [{
    id: 'unpaid',
    title: 'Chưa thanh toán',
    idName: 'showUnpaid',
    class: 'primary'
  }, {
    id: 'paid',
    title: 'Đã thanh toán',
    idName: 'showPaid',
    class: 'success'
  }, {
    id: 'unknown',
    title: 'Không xác định',
    idName: 'showUnknown',
    class: 'default'
  }];

  function getCurrentStatus(buyingEntry) {
    if (buyingEntry.cancelled) return 'cancelled';
    if (buyingEntry.arrived) return 'arrived';
    if (buyingEntry.received) return 'received';
    if (buyingEntry.terminated) return 'terminated';
    if (buyingEntry.ordered) return 'ordered';
    return 'created';
  }

  function updatePaymentDeadline(buyingEntryIds, paymentDeadline) {
    return $http.post('/buying-entries/update-payment-deadline', {
      buyingEntryIds,
      paymentDeadline
    }).then(response => response.data);
  }

  function updatePaymentStatus(buyingEntryIds, paymentStatus) {
    return $http.post('/buying-entries/update-payment-status', {
      buyingEntryIds,
      paymentStatus
    }).then(response => response.data);
  }

  function calculateSuggestOrderItems(items, destination) {
    return $http.post('/buying-entries/suggest-order-items', {
      items,
      destinationCode: destination.code
    }).then(response => response.data);
  }

  function calculateImportItems(items) {
    return $http.post('/buying-entries/calculate-import-items', items).then(response => response.data);
  }

  function createBuyingEntries(buyingEntries) {
    return $http.post('/buying-entries/create-buying-entries', buyingEntries).then(response => response.data);
  }

  function calculateOrderItems(buyingEntry) {
    _.forEach(buyingEntry.orderItems, item => {
      item.buyingValue = item.buyingQuantity * item.cogs;
      item.arrivedQuantity = item.arrivedQuantity || 0;
      item.arrivingQuantity = (item.buyingQuantity || 0) - (item.arrivedQuantity || 0);
      if (item.arrivingQuantity < 0) item.arrivingQuantity = 0;
    });

    buyingEntry.totalOrderValue = _.sumBy(buyingEntry.orderItems, 'buyingValue');
  }

  function calculateItemPrice(items) {
    _.forEach(items, item => {
      item.itemPrice = item.unitPrice * item.calculateCogQuantity * (100 - _.get(item, 'discountPercent', 0)) / 100;
    });
  }

  function findDuplicateBuyingEntry(buyingEntry) {
    return $http.post('/buying-entries/find-duplicate-buying-entry', buyingEntry).then(response => response.data);
  }

  return {
    findDuplicateBuyingEntry,
    calculateItemPrice,

    calculateBuyingItems(buyingEntry) {
      _.forEach(buyingEntry.items, item => {
        item.buyingValue = item.buyingQuantity * item.cogs;
        item.arrivedQuantity = item.arrivedQuantity || 0;
        item.arrivingQuantity = (item.buyingQuantity || 0) - (item.arrivedQuantity || 0);
        if (item.arrivingQuantity < 0) item.arrivingQuantity = 0;
        item.unitWeight = ProductWeight.getWeight(item.description) || 0;
        item.buyingWeight = item.unitWeight * item.buyingQuantity;
      });

      buyingEntry.biggestLeadTime = _.max(_.map(buyingEntry.items, item => {
        return _.get(item, 'product.leadTime', item.leadTime);
      }));
      if (!buyingEntry.ordered) buyingEntry.expectedArrivalDate = moment().add(buyingEntry.biggestLeadTime, 'days').format('YYYY-MM-DD');
      buyingEntry.totalBuyingValue = _.sumBy(buyingEntry.items, 'buyingValue');
      buyingEntry.totalBuyingWeight = _.sumBy(buyingEntry.items, 'buyingWeight');
      calculateSuggestOrderItems(buyingEntry.items, buyingEntry.destination).then(result => {
        buyingEntry.suggestOrderItems = result;

        _.forEach(buyingEntry.suggestOrderItems, item => {
          item.buyingValue = item.buyingQuantity * item.cogs;
        });
      });
    },

    mergeBuyingEntries(buyingEntryIds) {
      return $http.put('/buying-entries/merge', buyingEntryIds).then(response => response.data);
    },

    calculateOrderItemsForBuyingEntries(buyingEntryIds) {
      return $http.post('/buying-entries/caculate-order-items-for-buying-entries', buyingEntryIds).then(response => response.data);
    },

    calculateOrderItems,

    calculateReceiveItems(items) {
      _.forEach(items, item => {
        item.buyingValue = item.quantity * item.buyingCogs;
        item.unitWeight = ProductWeight.getWeight(item.description);
        item.buyingWeight = item.quantity * item.unitWeight;
      });
    },

    confirmArrivedAll(buyingEntry) {
      const notArrivedItems = _.filter(buyingEntry.items, item => {
        return item.arrivingQuantity > 0;
      });

      if (!notArrivedItems.length) return Promise.resolve(true);

      const itemParagraph = _.map(notArrivedItems, item => {
        return `${item.sku} ${item.description} còn ${item.arrivingQuantity}`;
      }).join('\n');

      return ConfirmModal.showModal({}, {
        closeButtonText: 'Không',
        actionButtonText: 'Đánh dấu đơn hoàn tất',
        headerText: 'Đơn chưa về đủ',
        bodyText: `Buying Entry này còn còn các mặt hàng sau chưa chưa nhập kho:
${itemParagraph}

Bạn vẫn muốn đánh dấu đơn này đã hoàn tất?`
      });
    },

    getStatuses() {
      return statuses;
    },

    getPaymentStatuses() {
      return paymentStatuses;
    },

    getArrivingItems() {
      return $http.get('/buying-entries/arriving-items').then(response => response.data);
    },

    findByBlockId(dataId) {
      return $http.post('/buying-entries/find-china-buying', {
        dataId
      }).then(response => response.data);
    },

    findByBuyingEntryId(buyingEntryId) {
      return $http.post('/buying-entries/find-by-buying-entry-id', {
        buyingEntryId
      }).then(response => response.data).catch(error => {
        FhdMessenger.error(error.data.message);
      });
    },

    findBuyingEntriesByBuyingEntryIds(buyingEntryIds) {
      return $http.post('/buying-entries/find-by-multi-buying-entry-ids', {
        buyingEntryIds
      }).then(response => response.data).catch(error => {
        FhdMessenger.errorFromServer(error);
      });
    },

    updateDueDateBuyingEntries(buyingEntries) {
      return $http.put('/buying-entries/update-due-date', {
        buyingEntries
      }).then(response => response.data).catch(error => {
        FhdMessenger.error(error.data.message);
      });
    },

    approveBuyingEntries(buyingEntries) {
      return $http.put('/buying-entries/approve', {
        buyingEntries
      }).then(response => response.data).catch(error => {
        FhdMessenger.error(error.data.message);
      });
    },

    orderBuyingEntries(buyingEntries) {
      return $http.put('/buying-entries/order', {
        buyingEntries
      }).then(response => response.data).catch(error => {
        FhdMessenger.error(error.data.message);
      });
    },

    cancelBuyingEntries(buyingEntries) {
      return $http.put('/buying-entries/cancel', {
        buyingEntries
      }).then(response => response.data).catch(error => {
        FhdMessenger.error(error.data.message);
      });
    },

    calculateDayLeftForBuyingEntry(buyingEntry) {
      return $http.put('/stock/get-day-left-by-products', {
        items: _.map(buyingEntry.items, item => {
          return {
            sku: item.sku,
            buyingQuantity: buyingEntry.status ? 0 : item.buyingQuantity
          };
        }),
        destinationId: ObjectId.getObjectId(_.get(buyingEntry, 'destination'))
      }).then(res => {
        const {
          itemMap
        } = res.data;

        const items = _.reduce(buyingEntry.items, (result, item) => {
          const matchItem = itemMap[item.sku];
          result.push(_.assignIn(item, matchItem));
          return result;
        }, []);

        return items;
      });
    },

    calculateSuggestOrderItems,
    calculateImportItems,
    createBuyingEntries,
    getCurrentStatus,
    updatePaymentDeadline,
    updatePaymentStatus,

    openConfirmBuyingEntryModal(buyingEntry) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-confirm-direct-buying-entry.client.template.html',
        controller: 'ModalConfirmDirectBuyingEntryController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          buyingEntry: () => buyingEntry
        }
      });
    },

    openFindMultiBuyingEntriesModal() {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-find-multi-buying-entries.client.view.html',
        controller: 'ModalFindMultiBuyingEntriesController',
        controllerAs: 'vm'
      });
    },

    openUpdateDueDateBuyingEntriesModal(buyingEntries) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/views/modal-update-due-date-buying-entries.client.view.html',
        controller: 'ModalUpdateDueDateBuyingEntriesController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          buyingEntries: () => buyingEntries
        }
      });
    },

    openCreateBuyingEntryComplaintModal(buyingEntry) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-create-buying-entry-complaint.client.view.html',
        controller: 'ModalCreateBuyingEntryComplaintController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          buyingEntry: () => buyingEntry
        }
      });
    },

    openlDayLeftDetailModal(item) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-day-left-detail.client.view.html',
        controller: 'ModalDayLeftDetailController',
        controllerAs: 'vm',
        size: 'sm',
        resolve: {
          item: () => item
        }
      });
    },

    openViewBuyingNoteForBuyingEntryModal(buyingEntry) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-view-buying-note-for-buying-entry.client.view.html',
        controller: 'ModalViewBuyingNoteForBuyingEntryController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          buyingEntry: () => buyingEntry
        }
      });
    },

    openDoneBuyingEntryComplaintModal(buyingEntry, index) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-done-buying-entry-complaint.client.view.html',
        controller: 'ModalDoneBuyingEntryComplaintController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          buyingEntry: () => buyingEntry,
          index: () => index
        }
      });
    },

    openConfirmBadItemModal(data) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-confirm-bad-item.client.view.html',
        controller: 'ModalConfirmBadItemController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          data: () => data
        }
      });
    },

    openViewBadItemModal(buyingEntry) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-view-bad-item.client.view.html',
        controller: 'ModalViewBadItemController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          buyingEntry: () => buyingEntry
        }
      });
    },

    openCreateRemainModal(user, buyingEntryId) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-create-remain.client.view.html',
        controller: 'ModalCreateRemainController',
        controllerAs: 'vm',
        size: 'md',
        resolve: {
          user: () => user,
          buyingEntryId: () => buyingEntryId
        }
      });
    },

    openNotiProductsNoBeModal() {
      return $modal.open({
        templateUrl: 'modules/buying-entries/views/modal-noti-products-no-be.client.view.html',
        controller: 'ModalNotiProductsNoBeController',
        controllerAs: 'vm',
        size: 'lg'
      });
    },

    openUpdatePaymentDeadlineModal(buyingEntries) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-update-payment-deadline.client.view.html',
        controller: 'ModalUpdatePaymentDeadlineController',
        controllerAs: 'vm',
        resolve: {
          buyingEntries: () => buyingEntries
        }
      });
    },

    openUpdatePaymentStatusModal(buyingEntries) {
      return $modal.open({
        templateUrl: 'modules/buying-entries/templates/modal-update-payment-status.client.view.html',
        controller: 'ModalUpdatePaymentStatusController',
        controllerAs: 'vm',
        resolve: {
          buyingEntries: () => buyingEntries
        }
      });
    }

  };
}]);
'use strict'; // Setting up route

angular.module('calendar-entries').config(['$stateProvider', function ($stateProvider) {
  // Calendar entries state routing
  $stateProvider.state('tqt-calendar-view', {
    url: '/tqt-calendar-view',
    templateUrl: 'modules/calendar-entries/views/tqt-calendar-view.client.view.html',
    resolve: {
      $title: _.constant('Tqt Calendar View')
    }
  }).state('listCalendarEntries', {
    url: '/calendar-entries',
    templateUrl: 'modules/calendar-entries/views/list-calendar-entries.client.view.html',
    resolve: {
      $title: _.constant('Work Calendar')
    }
  }).state('createCalendarEntry', {
    url: '/calendar-entries/create',
    templateUrl: 'modules/calendar-entries/views/create-calendar-entry.client.view.html',
    resolve: {
      $title: _.constant('Create Calendar Entry')
    }
  }).state('approveCalendarEntry', {
    url: '/requested-calendar-entries',
    templateUrl: 'modules/calendar-entries/views/list-requested-calendar-entries.client.view.html',
    resolve: {
      $title: _.constant('Requested Calendar Entries')
    }
  }).state('viewCalendarEntry', {
    url: '/calendar-entries/:calendarEntryId',
    templateUrl: 'modules/calendar-entries/views/view-calendar-entry.client.view.html',
    resolve: {
      $title: _.constant('View Calendar Entry')
    }
  }).state('editCalendarEntry', {
    url: '/calendar-entries/:calendarEntryId/edit',
    templateUrl: 'modules/calendar-entries/views/edit-calendar-entry.client.view.html',
    resolve: {
      $title: _.constant('Edit Calendar Entry')
    }
  });
}]);
'use strict'; // Calendar entries controller

angular.module('calendar-entries').controller('CalendarEntriesController', ['$scope', '$stateParams', '$location', '$window', 'Authentication', 'CalendarEntries', 'CalendarEntryService', 'ObjectId', 'uiCalendarConfig', '$compile', '$filter', 'NgTableParams', 'FhdMessenger', function ($scope, $stateParams, $location, $window, Authentication, CalendarEntries, CalendarEntryService, ObjectId, uiCalendarConfig, $compile, $filter, NgTableParams, FhdMessenger) {
  const vm = this;
  vm.createdCalendarEntries = [];
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.tasks = CalendarEntryService.getTasks(vm.user);
  vm.report = CalendarEntryService.openReportCalendarEntryModal;
  vm.task = _.find(vm.tasks, {
    _id: 'watch'
  });

  vm.initialValues = () => {
    vm.timeStart = moment().hour(8).minute(0).second(0).millisecond(0).toDate();
    vm.timeEnd = moment().hour(17).minute(0).second(0).millisecond(0).toDate();

    const outletCode = _.get(vm.authentication, 'user.outlet.code');

    if (outletCode) {
      vm.title = `${vm.task.name} ${outletCode}`;
    }
  };

  const getStaff = (user, staff) => {
    if (!user || !user.roles || !user.roles.length) return null;
    if (_.intersection(user.roles, ['admin', 'tro-ly-lich-truc', 'calender-entry:edit', 'calendar-entries:view'])) return staff || user;
    return user;
  };

  const mergeDateTime = (date, time) => {
    if (!moment(date).isValid()) return null;
    if (!moment(time).isValid()) return null;
    const momentTime = moment(time);
    return moment(date).hour(momentTime.hour()).minute(momentTime.minute()).startOf('minute');
  };

  vm.updateTitle = function (outlet) {
    if (vm.calendarEntry) {
      vm.calendarEntry.title = `${vm.task.name} ${vm.calendarEntry.outlet.code}`;
    } else {
      if (outlet) {
        vm.title = `${vm.task.name} ${_.get(outlet, 'code')}`;
      } else {
        vm.title = '';
      }
    }

    if (!vm.user.roles.includes('admin') && vm.user.roles.includes('full-time')) {
      vm.calendarSlots = CalendarEntryService.getFulltimeCalendar(outlet.code);
    } else {
      vm.calendarSlots = [];
    }
  };

  vm.updateTime = function () {
    if (!_.get(vm, 'calendarSlot.startHour')) {
      return;
    }

    vm.timeStart = moment().hour(vm.calendarSlot.startHour).startOf('hour').toDate();
    vm.timeEnd = moment().hour(vm.calendarSlot.endHour).startOf('hour').toDate();
  }; // Create new Calendar entry


  vm.create = function () {
    // Create new Calendar entry object
    const staff = getStaff(vm.authentication.user, vm.staff);

    if (!staff) {
      return FhdMessenger.error('Chưa nhập nhân viên');
    }

    const startDate = mergeDateTime(vm.date, vm.timeStart);
    const endDate = mergeDateTime(vm.date, vm.timeEnd);

    if (moment(endDate).diff(moment(startDate)) <= 0) {
      return FhdMessenger.error('Thời gian kết thúc phải ở sau thời gian bắt đầu');
    }

    const calendarEntry = new CalendarEntries({
      title: vm.title,
      outlet: vm.outlet,
      task: vm.task._id,
      staff: ObjectId.getObjectId(staff),
      start: startDate,
      end: endDate,
      allDay: vm.allDay,
      url: vm.url
    });
    vm.waiting = true; // Redirect after save

    calendarEntry.$save(function (calendarEntry) {
      vm.createdCalendarEntries.push(calendarEntry);
      FhdMessenger.success('Tạo thành công!');
      vm.waiting = false;
    }, function (errorResponse) {
      vm.waiting = false;
      FhdMessenger.errorFromServer(errorResponse);
    });
  }; // Remove existing Calendar entry


  vm.remove = function () {
    if (!vm.reason) {
      return FhdMessenger.error('Phải điền lý do xóa lịch trực');
    }

    vm.waiting = true;
    vm.calendarEntry.$remove({
      query: vm.reason
    }).then(calendarEntry => {
      if (calendarEntry.requestRemove) {
        FhdMessenger.info(`Đã yêu cầu xóa lịch trực`);
      } else {
        FhdMessenger.success(`Đã xóa lịch trực thành công`);
        $location.path('calendar-entries');
      }
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  }; // Update existing Calendar entry


  vm.update = function () {
    if (!vm.reason) {
      return FhdMessenger.error('Phải điền lý do sửa lịch trực');
    }

    const calendarEntry = vm.calendarEntry;
    const startDate = mergeDateTime(new Date(vm.calendarEntry.date), new Date(vm.calendarEntry.start));
    const endDate = mergeDateTime(new Date(vm.calendarEntry.date), new Date(vm.calendarEntry.end));

    if (moment(endDate).diff(moment(startDate)) <= 0) {
      return FhdMessenger.error('Thời gian kết thúc phải ở sau thời gian bắt đầu');
    }

    _.assign(vm.calendarEntry, {
      start: startDate,
      end: endDate
    });

    calendarEntry.task = vm.task._id;
    calendarEntry.reason = vm.reason;
    calendarEntry.$update().then(calendarEntry => {
      if (calendarEntry.requestUpdate) {
        FhdMessenger.info(`Đã yêu cầu cập nhật`);
      } else {
        FhdMessenger.success(`Đã cập nhật thành công`);
      }

      $location.path('calendar-entries');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      vm.findOne();
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Find a list of Calendar entries


  vm.find = function () {
    CalendarEntries.query(function (calendarEntries) {
      vm.calendarEntries = calendarEntries;
    });
  };

  vm.calendarSources = [{
    url: '/calendar-entries/calendar',
    data: {
      staff: () => ObjectId.getObjectId(vm.staff)
    },
    color: 'white',
    textColor: '#191919',
    borderColor: '#ABABAC',
    cache: true
  }];

  vm.watchStaff = () => $scope.$watch(() => vm.staff, function (newValue, oldValue) {
    if (newValue === oldValue) return;
    const calendar = uiCalendarConfig.calendars.staffCalendar;
    calendar.fullCalendar('refetchEvents');
  });

  const momentDateFilter = $filter('momentDate');

  vm.eventRender = function (event, element) {
    element.find('.fc-time').css({
      display: 'none'
    });

    if (!event.title) {
      const titleElm = element.find('.fc-title');
      titleElm.css({
        display: 'none'
      });
    }

    const contentElm = element.find('.fc-content');
    contentElm.prepend(`<div class=".fc-time"><strong>${momentDateFilter(event.start, 'LT')} - ${momentDateFilter(event.end, 'LT')}</strong></div>`);

    if (event.staff && event.staff.displayName) {
      contentElm.append(`<div class=".fc-staff">${event.staff.displayName}</div>`);
    }

    if (event.missions && event.missions.length) {
      const elementStyle = element.find('.fc-content');
      elementStyle.css({
        backgroundColor: 'gray'
      });
    }

    if (event.end) {
      contentElm.append('<div class=".fc-end"></div>');
    }

    $compile(element)($scope);
  };

  vm.eventClick = calendarEntry => {
    $window.open(`#!/calendar-entries/${calendarEntry._id}/edit`);
  };

  vm.staffHoursTable = new NgTableParams({
    count: 50
  });
  vm.calendarConfig = {
    height: 800,
    editable: true,
    header: {
      left: 'title',
      center: '',
      right: 'today month basicWeek prev,next'
    },
    firstDay: 1,
    eventClick: vm.eventClick,
    weekNumbers: 4,
    defaultView: 'basicWeek',
    timezone: 'Asia/Ho_Chi_Minh',
    weekNumberCalculation: 'ISO',
    eventRender: vm.eventRender,
    lang: 'vi',
    eventOrder: ['start'],
    loading: function (isLoading, view) {
      if (isLoading) return;
      const start = moment(view.start).startOf('day').format('YYYY-MM-DD');
      const end = moment(view.end).startOf('day').format('YYYY-MM-DD');
      const staff = ObjectId.getObjectId(vm.staff);
      CalendarEntryService.summarize({
        staff,
        start,
        end
      }).then(calendarHours => {
        vm.staffHoursTable.settings({
          dataset: _.sortBy(calendarHours, 'code')
        });
        vm.staffHoursTable.reload();
      });
    } // Find existing Calendar entry

  };

  vm.findOne = function () {
    CalendarEntries.get({
      calendarEntryId: $stateParams.calendarEntryId
    }).$promise.then(calendarEntry => _.assign(calendarEntry, {
      start: new Date(calendarEntry.start),
      end: new Date(calendarEntry.end),
      created: new Date(calendarEntry.created)
    })).then(calendarEntry => {
      vm.task = _.find(vm.tasks, {
        _id: calendarEntry.task
      });
      vm.calendarEntry = calendarEntry;
      vm.calendarEntry.date = moment(calendarEntry.start).format('YYYY-MM-DD');
    });
  };
}]);
'use strict'; // Calendar entries controller

angular.module('calendar-entries').controller('ModalReportCalendarEntryController', ['$modalInstance', 'Authentication', 'calendarEntry', 'CalendarEntries', 'CalendarEntryService', 'FhdMessenger', 'ObjectId', function ($modalInstance, Authentication, calendarEntry, CalendarEntries, CalendarEntryService, FhdMessenger, ObjectId) {
  const vm = this;
  vm.user = Authentication.user;
  vm.missions = _.map(CalendarEntryService.getMissions(), mission => {
    return {
      name: mission,
      done: false
    };
  });
  vm.calendarEntry = CalendarEntries.get({
    calendarEntryId: calendarEntry._id
  });

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.report = function () {
    if (!ObjectId.equals(vm.user, vm.calendarEntry.staff)) {
      return FhdMessenger.error('Đây không phải ca trực của bạn');
    }

    vm.calendarEntry.missions = vm.missions;
    vm.calendarEntry.note = vm.note;
    vm.waiting = true;
    vm.calendarEntry.$report().then(calendarEntry => {
      $modalInstance.close(calendarEntry);
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = true;
    });
  };
}]);
'use strict'; // Calendar entries controller

angular.module('calendar-entries').controller('RequestedCalendarEntriesController', ['Authentication', 'CalendarEntries', 'NgTableParams', 'FhdMessenger', '$http', function (Authentication, CalendarEntries, NgTableParams, FhdMessenger, $http) {
  const vm = this;
  vm.start = moment().subtract(1, 'month').format('YYYY-MM-DD');
  vm.end = moment().add(1, 'week').format('YYYY-MM-DD');
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.calendarEntriesTable = new NgTableParams({
    count: 50
  });

  vm.getType = () => [{
    title: 'Cập nhật',
    id: 'update'
  }, {
    title: 'Xóa',
    id: 'remove'
  }];

  vm.find = () => {
    vm.calendarEntries = CalendarEntries.query({
      requested: true,
      start: vm.start,
      end: vm.end
    }).$promise.then(response => {
      vm.calendarEntries = response;
      vm.calendarEntries = _.map(vm.calendarEntries, calendarEntry => {
        if (calendarEntry.requestUpdate) {
          calendarEntry.requestType = 'update';
        } else calendarEntry.requestType = 'remove';

        return calendarEntry;
      });
      vm.calendarEntriesTable.settings({
        dataset: vm.calendarEntries
      });
      FhdMessenger.success('Lấy dữ liệu thành công');
    }).catch(err => {
      FhdMessenger.error(err.message);
    });
  };

  vm.approve = _.debounce((calendarEntry, index) => {
    const type = calendarEntry.requestType === 'update' ? 'Cập nhật' : 'Xóa';
    calendarEntry.$approve().then(response => {
      FhdMessenger.success(`${type} lịch trực thành công`);
    }).catch(err => {
      FhdMessenger.error(err.message);
    });
  }, 200);
  vm.deny = _.debounce((calendarEntry, index) => {
    calendarEntry.$deny().then(response => {
      FhdMessenger.success(`OK`);
    }).catch(err => {
      FhdMessenger.error(err.message);
    });
  }, 200);
}]);
"use strict";

