angular.module('questions').controller('QuestionsController', ['$scope', '$stateParams', '$location', 'Authentication', 'FhdMessenger', 'Questions', 'toaster', '$http', '$state', 'BusinessService', 'NgTableParams', 'QuestionService', function ($scope, $stateParams, $location, Authentication, FhdMessenger, Questions, toaster, $http, $state, BusinessService, NgTableParams, QuestionService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.sku = '';
  vm.user = Authentication.user;
  const user = Authentication.user;
  const roleCanAccess = ['admin', 'tro-ly', 'tro-ly-ns', 'tro-ly-dt', 'ship'];

  if (!_.intersection(user.roles, roleCanAccess).length) {
    $location.path('/');
  }

  vm.question = {};
  vm.data = {};
  BusinessService.allAsync().then(businesses => {
    vm.data.businesses = businesses;
  });

  vm.getType = () => [{
    title: 'Tự luận',
    id: 'ESSAY'
  }, {
    title: 'Điền ô trống',
    id: 'FILLBLANK'
  }, {
    title: 'Trắc nghiệm',
    id: 'MULTIPLE'
  }, {
    title: 'Nối bảng',
    id: 'JOINTABLE'
  }, {
    title: 'Sắp xếp',
    id: 'SORT'
  }];

  vm.data.questionTypes = [{
    name: 'Trắc nghiệm',
