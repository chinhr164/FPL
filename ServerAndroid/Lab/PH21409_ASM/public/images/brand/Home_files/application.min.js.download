angular.module('rank-a-points').controller('ModalAddRankAPointController', ['Authentication', '$modalInstance', 'userId', '$location', '$state', 'RankAPoints', 'Users', 'FhdMessenger', function (Authentication, $modalInstance, userId, $location, $state, RankAPoints, Users, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication;

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.init = function () {
    vm.rankAPoint = {};
    vm.rankAPoint.isMinus = false;

    if (userId) {
      vm.staff = Users.get({
        userId: userId
      });
      vm.rankAPoint.staffs = [];
      vm.rankAPoint.staffs.push(vm.staff);
    }
  }; // Create new Rank a point


  vm.create = function () {
    if (vm.rankAPoint.points < 0) {
      vm.rankAPoint.isMinus = true;
    }

    if (!vm.rankAPoint.staffs) {
      FhdMessenger.errorFromServer('Chưa có nhân viên');
      return;
    }

    if (!vm.rankAPoint.message) {
      FhdMessenger.errorFromServer('Chưa có lý do cộng điểm');
      return;
    }

    if (!vm.rankAPoint.points) {
      FhdMessenger.errorFromServer('Chưa có điểm cộng thêm');
      return;
    } // Create new Rank a point object


    const rankAPoint = new RankAPoints(vm.rankAPoint);
    vm.waiting = true; // Redirect after save

    rankAPoint.$save(function (response) {
      FhdMessenger.success('Tạo thành công');
      $modalInstance.close();
      $state.reload();
    }, function (errorResponse) {
      FhdMessenger.errorFromServer('Có lỗi xảy ra');
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.removeStaff = function (index, array) {
    array.splice(index, 1);
  };

  vm.staffSearchSelected = function (staff) {
    if (!staff) return;

    const checkDuplicate = _.find(vm.staffs, {
      _id: staff._id
    });

    if (!checkDuplicate) {
      vm.staffs.push(_.cloneDeep(staff));
    }
  };
}]);
'use strict';

angular.module('rank-a-points').controller('ModalResetRankAPointController', ['Authentication', '$modalInstance', 'userId', '$location', '$state', 'RankAPoints', 'Users', 'ObjectId', '$http', 'FhdMessenger', function (Authentication, $modalInstance, userId, $location, $state, RankAPoints, Users, ObjectId, $http, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication;
  vm.points = 0;

  vm.init = function () {
    if (userId) {
      vm.staff = Users.get({
        userId: userId
      });
      vm.staffs = [];
      vm.staffs.push(vm.staff);
    }

    vm.ranks = [{
      point: 0,
      rank: 'A1',
      salaryPercentage: 8
    }, {
      point: 100,
      rank: 'A2',
      salaryPercentage: 9
    }, {
      point: 400,
      rank: 'A3',
      salaryPercentage: 10
    }, {
      point: 1000,
      rank: 'A4',
      salaryPercentage: 11
    }, {
      point: 2000,
      rank: 'A5',
      salaryPercentage: 12
    }, {
      point: 3500,
      rank: 'A6',
      salaryPercentage: 13
    }, {
      point: 8000,
      rank: 'A7'
    }, {
      point: 15000,
      rank: 'A8'
    }];
    $http.get(`/users/${userId}/summary-rank-a-points`).then(function (response) {
      var data = response.data;
      vm.totalPoints = data.totalPoints || 0;
    }, function (response) {
      var data = response.data;
      FhdMessenger.errorFromServer(data);
    });
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.reset = function () {
    let rank = _.findLast(vm.ranks, rank => {
      return vm.totalPoints > rank.point;
    });

    vm.minusPoints = vm.totalPoints - rank.point;

    if (!vm.staffs) {
      FhdMessenger.errorFromServer('Chưa có nhân viên');
      return;
    }

    if (!vm.message) {
      FhdMessenger.errorFromServer('Chưa có lý do reset');
      return;
    } // Create new Rank a point object


    const rankAPoint = new RankAPoints({
      message: vm.message,
      staffs: vm.staffs,
      points: -vm.minusPoints,
      isMinus: true
    });
    vm.waiting = true; // Redirect after save

    rankAPoint.$save(function (response) {
      FhdMessenger.success('Reset thành công');
      $modalInstance.close();
      $state.reload();
    }, function (errorResponse) {
      FhdMessenger.errorFromServer('Có lỗi xảy ra');
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict'; // Rank a points controller

angular.module('rank-a-points').controller('ModalViewRankAPointController', ['$modalInstance', '$location', '$http', '$state', 'rankAPointId', 'Authentication', 'RankAPoints', 'FhdMessenger', function ($modalInstance, $location, $http, $state, rankAPointId, Authentication, RankAPoints, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication; // Find existing Rank a point

  vm.findOne = function () {
    vm.rankAPoint = RankAPoints.get({
      rankAPointId: rankAPointId
    });
  }; // Remove existing Rank a point


  vm.remove = function (rankAPoint) {
    if (rankAPoint) {
      rankAPoint.$remove();

      for (var i in vm.rankAPoints) {
        if (vm.rankAPoints[i] === rankAPoint) {
          vm.rankAPoints.splice(i, 1);
        }
      }
    } else {
      vm.rankAPoint.$remove(function () {
        FhdMessenger.success('Xóa thành công');
        $modalInstance.close();
        $state.reload();
      });
    }
  };
}]);
