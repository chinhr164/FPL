angular.module('businesses').factory('BusinessService', ['Businesses', function (Businesses) {
  var businesses;
  var avaiableBusinesses;
  var businessesWithAllAsync;

  var all = function (callback) {
    if (!businesses) businesses = Businesses.query();
    businesses.$promise.then(function (businesses) {
      callback(null, businesses);
    }, function (err) {
      businesses = Businesses.query();
      callback(err);
    });
  };

  var loadAvaible = function () {
    avaiableBusinesses = Businesses.query({
      deleted: false
    });
    avaiableBusinesses = avaiableBusinesses.$promise;
  };

  function attachAllOption(businesses) {
    var _businesses = _.cloneDeep(businesses);

    _businesses.push({
      code: null,
      name: 'Tất cả'
    });

    return _businesses;
  }

  function allAsync() {
    if (!avaiableBusinesses) {
      loadAvaible();
    }

    return avaiableBusinesses;
  }

  return {
    all: all,
    withAllOption: function (callback) {
      all(function (err, businesses) {
        if (err) return callback(err);
        callback(null, attachAllOption(businesses));
      });
    },
    allAsync,

    withAllOptionAsync() {
      if (!avaiableBusinesses) {
        loadAvaible();
      }

      if (!businessesWithAllAsync) {
        businessesWithAllAsync = avaiableBusinesses.then(attachAllOption);
      }

      return businessesWithAllAsync;
    },

    getFromId: function (id) {
      return _.find(businesses, {
        _id: id
      });
    }
  };
}]);
'use strict'; // Businesses service used to communicate Businesses REST endpoints

angular.module('businesses').factory('Businesses', ['$resource', function ($resource) {
  return $resource('businesses/:businessId', {
    businessId: '@_id'
  }, {
    update: {
      method: 'PUT'
    }
  });
}]);
