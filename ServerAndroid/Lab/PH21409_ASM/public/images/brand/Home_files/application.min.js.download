angular.module('rank-a-points').controller('RankAPointsController', ['$stateParams', '$location', '$http', 'Authentication', 'RankAPoints', 'FhdMessenger', function ($stateParams, $location, $http, Authentication, RankAPoints, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication; // Create new Rank a point

  vm.create = function () {
    // Create new Rank a point object
    const rankAPoint = new RankAPoints({
