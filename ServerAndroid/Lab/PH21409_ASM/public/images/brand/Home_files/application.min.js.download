angular.module('photo-reports').controller('CreatePhotoReportController', ['FhdMessenger', 'PhotoReports', 'PhotoReportService', '$state', '$scope', function (FhdMessenger, PhotoReports, PhotoReportService, $state, $scope) {
  const vm = this;
  vm.type = 'outletSpace';
  vm.private = false;
  vm.photoReportTypes = PhotoReportService.getPhotoReportType();
  vm.imageContent = '';
  vm.images = [];
  vm.amount = null;
  vm.product = null;

  vm.create = () => {
    if (!vm.type) {
      return FhdMessenger.error('Chưa phân loại Photo Report');
    }

    if (!_.get(vm.outlet, '_id')) {
      return FhdMessenger.error('Chưa chọn cơ sở cho Photo Report');
    }

    if (vm.images.length > 30) {
      return FhdMessenger.error('Bạn đã đạt giới hạn 30 ảnh mỗi lần tải lên, vui lòng xóa bớt ảnh và đăng vào lần sau');
    }

    if (vm.title.match(/(K|k)hông gian/) || vm.type === 'outletSpace' || vm.outlet.code.match(/[MES]\d+/)) {
      vm.private = false;
    }

    if (vm.type === 'rawProductFeedback') {
      vm.private = true;

      if (!vm.product) {
        return FhdMessenger.error('Bạn chưa điền tên sản phẩm');
      }

      if (!vm.amount) {
        return FhdMessenger.error('Bạn chưa điền số lượng sản phẩm');
      }
    }

    const photoReport = new PhotoReports({
      title: vm.title,
      images: vm.images,
      outlet: vm.outlet,
      photoReportType: vm.type,
      private: vm.private,
      product: vm.product,
      amount: vm.amount,
      sku: _.get(vm.product, 'sku'),
      description: _.get(vm.product, 'description')
    });
    vm.waiting = true;
    photoReport.$save().then(photoReport => {
      $state.go('viewPhotoReport', {
        photoReportId: photoReport._id
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.createPhotoReportTitle = function () {
    if (vm.type === 'outletSpace') {
      let shift = 'T';

      if (moment().hour() < 12) {
        shift = 'S';
      } else if (moment().hour() < 17) {
        shift = 'C';
      }

      vm.title = `Không gian cửa hàng ${vm.outlet.code} - ${shift} - ${moment().format('DD/MM')}`;
    } else {
      vm.title = '';
    }

    if (vm.outlet.code) {
      PhotoReportService.getPhotoReportImagesContent(vm.outlet.code).then(imageContent => {
        vm.imageContent = imageContent;
      });
    }
  };

  $scope.$watch(() => vm.outlet, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    vm.createPhotoReportTitle();
  });
  $scope.$watch(() => vm.type, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    vm.createPhotoReportTitle();
  });
}]);
"use strict";

angular.module('photo-reports').controller('ListPhotoReportsController', ['$scope', 'Authentication', 'FhdMessenger', 'PhotoReports', 'PhotoReportService', 'NgTableParams', function ($scope, Authentication, FhdMessenger, PhotoReports, PhotoReportService, NgTableParams) {
  const vm = this;
  vm.user = Authentication.user;
  vm.photoReportsTable = new NgTableParams();
  vm.data = {};
  vm.data.endDate = moment().format('YYYY-MM-DD');
  vm.data.startDate = moment(vm.data.endDate).subtract(1, 'day').format('YYYY-MM-DD');
  vm.data.outletIds = [];

  vm.find = () => {
    vm.photoReports = PhotoReports.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      outlets: vm.data.outletIds
    });
    vm.photoReports.$promise.then(() => {
      vm.photoReportsTable.settings({
        dataset: vm.photoReports
      });
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải...', vm.photoReports.$promise);
  };

  vm.getTypes = () => {
    return PhotoReportService.getPhotoReportType().map(it => {
      return {
        id: it._id,
        title: it.name
      };
    });
  };

  vm.onSelectOutlet = selectedOutlets => {
    vm.data.outletIds = _.map(selectedOutlets, '_id');
  };

  $scope.$watch(() => vm.photoReportsTable.data, (newPhotoReports, oldPhotoReports) => {
    if (newPhotoReports === oldPhotoReports) return;
    vm.totalPoint = _.reduce(newPhotoReports, (result, photoReport) => result + _.get(photoReport, 'points', 0), 0);
  });
}]);
"use strict";

angular.module('photo-reports').controller('ModalMarkCheckedController', ['$modalInstance', 'photoReport', 'FhdMessenger', function ($modalInstance, photoReport, FhdMessenger) {
  const vm = this;
  vm.photoReport = photoReport;
  vm.data = {};

  vm.init = () => {
    let types = [];

    if (vm.photoReport.outlet.isStore) {
      types = ['Sai điều kiện bảo quản', 'Nhà vệ sinh bẩn'];
      vm.isStore = true;

      if (vm.photoReport.outlet.code.match(/^S\d+/)) {
        types = types.concat(['Không gian chung lộn xộn, nhiều hàng vận hành', 'Không đậy mica giờ vắng khách', 'Lò vi sóng cáu bẩn', 'Lò nướng cáu bẩn', 'Sai layout', 'Vệ sinh kém', 'Tủ lạnh bẩn, không đảm bảo nhiệt độ', 'Bồn rửa: vệ sinh, sắp xếp, hộp nhựa', 'Sàn: có rác, bụi bẩn, đọng nhiều nước.', 'Nhà vệ sinh: không sạch', 'Bảo quản sai điều kiện, thực phẩm để trên sàn.', 'Khu làm bánh mì: lỗi vệ sinh, setup dụng cụ', 'Khu làm bánh ngọt: lộn xộn, bẩn', 'Khu pha chế: dụng cụ ca cốc đong, nồi nấu trân châu bám bẩn..', 'Thiếu ảnh/ gửi ảnh cũ', 'Bàn thu ngân: bụi bẩn']);
      } else {
        types = types.concat(['Bàn thu ngân bẩn', 'Giá kệ bụi bẩn', 'Kệ hàng trống', 'Không gian chung bụi bẩn', 'Sắp xếp hàng hóa lộn xộn', 'Kho bẩn, sắp xếp lộn xộn', 'Sai tag giá', 'Thiếu tag giá', 'Thiếu ảnh/ gửi ảnh cũ']);
      }
    }

    vm.photoReport.checkedTypes = _.sortBy(_.map(types, type => {
      return {
        name: type,
        checked: false
      };
    }), 'name');
  };

  vm.markChecked = () => {
    if (!vm.photoReport.comment) {
      return FhdMessenger.error('Bạn chưa điền nội dung');
    }

    vm.photoReport.checkedTypes = _.map(_.filter(vm.photoReport.checkedTypes, {
      checked: true
    }), checkedTypes => {
      return {
        name: checkedTypes.name
      };
    });
    vm.updating = true;
    vm.photoReport.$markChecked().then(() => {
      FhdMessenger.success('Đã kiểm tra');
      $modalInstance.close();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.updating = false;
    });
  };
}]);
"use strict";

angular.module('photo-reports').controller('ViewPhotoReportController', ['Authentication', 'ComplaintService', 'FhdMessenger', '$stateParams', '$state', 'PhotoReports', 'PhotoReportService', 'ConfirmModal', 'SticketService', '$modal', '$http', 'UserNoteService', function (Authentication, ComplaintService, FhdMessenger, $stateParams, $state, PhotoReports, PhotoReportService, ConfirmModal, SticketService, $modal, $http, UserNoteService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.points = [1, 2, 3];

  vm.findOne = () => {
    vm.checkedTypes = false;
    PhotoReports.get({
      photoReportId: $stateParams.photoReportId
    }).$promise.then(photoReport => {
      vm.photoReport = photoReport;

      if (vm.photoReport.checkedTypes.length) {
        vm.checkedTypes = true;
      }

      PhotoReportService.getPhotoReportImagesContent(photoReport.outlet.code).then(imageContent => {
        vm.imageContent = imageContent;
        const src = imageContent.match(/src="(.*?)"/g);
        vm.link = src[0].replace(/src|"|=/g, '');
      });
    });
  };

  vm.sendTicket = (user, photoReport) => {
    SticketService.openCreateTicket({
      user,
      photoReport
    });
  };

  vm.openCreateComplaintModal = ComplaintService.openCreateComplaintModal;
  vm.openModalMarkChecked = PhotoReportService.openModalMarkChecked;

  vm.delete = () => {
    ConfirmModal.show({}, {
      headerText: `Xóa Photo Report ${vm.photoReport.title}?`,
      bodyText: `Bạn có chắc chắn xóa PR${vm.photoReport.photoReportId} ${vm.photoReport.title}?`
    }).then(function () {
      vm.waiting = true;
      vm.photoReport.$delete().then(() => {
        FhdMessenger.success('Đã xóa photo report');
        $state.go('listPhotoReports');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.update = () => {
    if (vm.newNote) {
      vm.photoReport.newNote = vm.newNote;
    }

    if (!_.get(vm.photoReport.outlet, '_id')) {
      return FhdMessenger.error('Chưa chọn cơ sở cho Photo Report');
    }

    vm.waiting = true;
    vm.photoReport.images = _.map(vm.photoReport.images, image => ({
      dataBuffer: _.get(image, 'dataBuffer', null),
      imageType: _.get(image, 'imageType', null),
      link: _.get(image, 'link', null),
      comment: _.get(image, 'comment', null)
    }));
    vm.photoReport.$update().then(() => {
      FhdMessenger.success('Ok');
      vm.newNote = '';
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.thumbUp = () => {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Thôi',
      actionButtonText: 'Thưởng Thumb Up',
      headerText: 'Thưởng Thumb Up?',
      bodyText: `Bạn đã chắc chắn muốn thưởng Thumb Up cho PR${vm.photoReport.photoReportId} ${vm.photoReport.title}? Người gửi là ${vm.photoReport.user.displayName} sẽ được nhận 20k thưởng.`
    }).then(() => {
      vm.updating = true;
      return vm.photoReport.$awardThumbUp().then(() => {
        FhdMessenger.success('Đã tặng Thumb Up');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.updating = false;
      });
    });
  };

  vm.sendUserNote = () => {
    UserNoteService.openAddUserNoteModal({
      staff: vm.photoReport.user,
      photoReport: vm.photoReport
    }).then(userNotes => {
      let photoReport = vm.photoReport;
      photoReport.userNote = _.first(userNotes);
      photoReport.$update().catch(err => {
        FhdMessenger.error(err.data.message);
      });
    });
  };

  vm.addComment = () => {
    if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('admin-merchandise') && !vm.user.roles.includes('tro-ly-kgch')) {
      return FhdMessenger.error('Bạn không có quyền comment photo report này');
    }

    vm.updating = true;
    $http.put(`/photo-reports/${vm.photoReport._id}/comment`, {
      images: vm.photoReport.images
    }).then(response => {
      _.assign(vm.photoReport, response.data);

      FhdMessenger.success('Hoàn thành');
    }).catch(err => FhdMessenger.error(err.message)).finally(() => {
      vm.updating = false;
    });
  };
}]);
'use strict';

angular.module('photo-reports').filter('photoReportTypes', [function () {
  return function (input) {
    switch (input) {
      case 'display':
        return 'Trưng bày';

      case 'customerFeedback':
        return 'Feedback của khách';

      case 'errorVendor':
        return 'Hàng lỗi (NSX)';

      case 'errorDG':
        return 'Hàng lỗi (ĐG)';

      case 'errorBarcode':
        return 'Hàng lỗi (Mã vạch)';

      case 'trash':
        return 'Tiêu hủy';

      case 'checklist':
        return 'Checklist';

      case 'receipt':
        return 'Phiếu nhập kho';

      case 'webWorkError':
        return 'Lỗi Web Work';

      case 'webAbbyError':
        return 'Lỗi Web Abby.vn';

      case 'fanpageError':
        return 'Lỗi Fanpage';

      case 'outletSpace':
        return 'Không gian cửa hàng';

      case 'checkCamera':
        return 'Check Camera';

      case 'rawProductFeedback':
        return 'Feedback hàng RAW DG';

      case 'warehouseError':
        return 'Lỗi từ kho';

      default:
        return 'Unknown';
    }
  };
}]);
"use strict";

angular.module('photo-reports').factory('PhotoReports', ['$resource', function ($resource) {
  return $resource('photo-reports/:photoReportId', {
    photoReportId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    delete: {
      method: 'DELETE'
    },
    awardThumbUp: {
      method: 'POST',
      url: 'photo-reports/:photoReportId/award-thumb-up'
    },
    markChecked: {
      method: 'POST',
      url: 'photo-reports/:photoReportId/mark-checked'
    }
  });
}]);
"use strict";

angular.module('photo-reports').factory('PhotoReportService', ['$modal', 'OutletService', function ($modal, OutletService) {
  const photoReportTypes = [{
    _id: 'errorVendor',
    name: 'Hàng lỗi (NSX)'
  }, {
    _id: 'errorDG',
    name: 'Hàng lỗi (ĐG)'
  }, {
    _id: 'errorBarcode',
    name: 'Hàng lỗi (Mã vạch)'
  }, {
    _id: 'trash',
    name: 'Tiêu hủy'
  }, {
    _id: 'checklist',
    name: 'Checklist'
  }, {
    _id: 'display',
    name: 'Trưng bày'
  }, {
    _id: 'outletSpace',
    name: 'Không gian cửa hàng'
  }, {
    _id: 'checkCamera',
    name: 'Check Camera'
  }, {
    _id: 'receipt',
    name: 'Phiếu nhập kho'
  }, {
    _id: 'customerFeedback',
    name: 'Feedback của khách'
  }, {
    _id: 'webWorkError',
    name: 'Lỗi Web Work'
  }, {
    _id: 'webAbbyError',
    name: 'Lỗi Web Abby.vn'
  }, {
    _id: 'warehouseError',
    name: 'Lỗi từ kho'
  }, {
    _id: 'fanpageError',
    name: 'Lỗi Fanpage'
  }, {
    _id: 'rawProductFeedback',
    name: 'Feedback hàng RAW DG'
  }];
  return {
    getPhotoReportType() {
      return photoReportTypes;
    },

    openCreateComplaintModal: photoReport => $modal.open({
      animation: true,
      templateUrl: '/modules/photo-reports/views/modal-create-complaint.client.view.html',
      controller: 'CreateComplaintController',
      controllerAs: 'vm',
      resolve: {
        photoReport: () => photoReport
      }
    }).result,
    openModalMarkChecked: photoReport => $modal.open({
      animation: true,
      templateUrl: '/modules/photo-reports/views/modal-mark-checked.client.view.html',
      controller: 'ModalMarkCheckedController',
      controllerAs: 'vm',
      resolve: {
        photoReport: () => photoReport
      }
    }),

    getPhotoReportImagesContent(outletCode) {
      return OutletService.findOutletFromCode(outletCode).then(outlet => _.get(outlet, 'imageReportContent', ''));
    }

  };
}]);
'use strict'; // Setting up route

angular.module('pl-entries').config(['$stateProvider', function ($stateProvider) {
  // PlEntries state routing
  $stateProvider.state('listPlEntries', {
    url: '/pl-entries',
    templateUrl: 'modules/pl-entries/views/list-pl-entries.client.view.html',
