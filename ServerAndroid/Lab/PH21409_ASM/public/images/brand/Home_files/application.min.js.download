angular.module('meeting-rooms').controller('MeetingRoomsController', ['$stateParams', '$location', 'MeetingRooms', 'MeetingRoomsService', 'FhdMessenger', 'uiCalendarConfig', '$window', '$compile', '$scope', 'ConfirmModal', function ($stateParams, $location, MeetingRooms, MeetingRoomsService, FhdMessenger, uiCalendarConfig, $window, $compile, $scope, ConfirmModal) {
  const vm = this;
  vm.places = MeetingRoomsService.getPlaces();
  vm.meetingRooms = [];
  vm.events = [];

  const mergeDateTime = (date, time) => {
    if (!moment(date).isValid()) return null;
    if (!moment(time).isValid()) return null;
    const momentTime = moment(time);
    return moment(date).hour(momentTime.hour()).minute(momentTime.minute()).startOf('minute');
  };

  vm.create = () => {
    if (!vm.meetingRoom.timeStart) {
      return FhdMessenger.error('Bạn chưa chọn giờ bắt đầu');
    }

    if (!vm.meetingRoom.timeEnd) {
      return FhdMessenger.error('Bạn chưa chọn giờ kết thúc');
    }

    if (!vm.meetingRoom.place) {
      return FhdMessenger.error('Bạn chưa chọn phòng họp');
    }

    if (!_.get(vm, 'meetingRoom.outlet.code')) {
      return FhdMessenger.error('Bạn chưa chọn bộ phận');
    }

    vm.meetingRoom.startTime = mergeDateTime(vm.meetingRoom.date, vm.meetingRoom.timeStart);
    vm.meetingRoom.endTime = mergeDateTime(vm.meetingRoom.date, vm.meetingRoom.timeEnd); // if (
    //   ['Room_4'].includes(vm.meetingRoom.place) &&
    //   moment(vm.meetingRoom.startTime).diff(moment(), 'hours', true) <= 24
    // ) {
    //   return FhdMessenger.error('Thời gian bắt đầu phải cách hiện tại ít nhất 24h')
    // }

    if (moment(vm.meetingRoom.startTime).diff(moment(), 'day', true) > 15) {
      return FhdMessenger.error('Không được đặt lịch trước hiện tại quá 7 ngày');
    }

    if (moment(vm.meetingRoom.endTime).diff(moment(vm.meetingRoom.startTime)) <= 0) {
      return FhdMessenger.error('Thời gian kết thúc phải ở sau thời gian bắt đầu');
    }

    vm.meetingRoom.outletCode = vm.meetingRoom.outlet.code;
    const meetingRoom = new MeetingRooms(vm.meetingRoom);
    vm.waiting = true;
    meetingRoom.$save(function (_meetingRoom) {
      vm.meetingRooms.push(_meetingRoom);
      FhdMessenger.success('Tạo thành công');
      vm.waiting = false; // vm.meetingRoom = {}
    }, function (err) {
      vm.waiting = false;
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.find = function () {
    vm.createdMeetingRooms = MeetingRooms.query({
      startDate: moment(vm.meetingRoom.date).format('YYYY-MM-DD'),
      endDate: moment(vm.meetingRoom.date).format('YYYY-MM-DD')
    });
  };

  vm.eventRender = (event, element) => {
    let {
      meetingRoom
    } = event;
    const header = `<strong>${meetingRoom.title}</strong>
      </br>
      <span>${moment(meetingRoom.startTime).format('LT')} - ${moment(meetingRoom.endTime).format('LT')}</span>
      </br>
      <span>Bộ phận: ${meetingRoom.outletCode}</span>
      </br>
      <span>Bởi: ${meetingRoom.user.displayName}</span>`;
    const contentElm = element.find('.fc-content');
    contentElm.prepend(`<div class=".fc-time">${header}</div>`);
    $compile(element)($scope);
  };

  vm.eventClick = function (event) {
    const meetingRoomId = event.meetingRoom.meetingRoomId;

    if (meetingRoomId) {
      $window.open(`#!/meeting-rooms/${meetingRoomId}/edit`);
    }
  };

  vm.uiConfig = {
    meetingRoomsCalendar: {
      height: 800,
      editable: true,
      header: {
        left: 'title',
        center: '',
        right: 'today month basicWeek prev,next'
      },
      firstDay: 1,
      weekNumbers: 4,
      defaultView: 'basicWeek',
      businessHours: {
        start: '08:00',
        end: '22:00'
      },
      eventClick: vm.eventClick,
      timezone: 'Asia/Ho_Chi_Minh',
      displayEventTime: false,
      eventOrder: ['start'],
      weekNumberCalculation: 'ISO',
      eventRender: vm.eventRender,
      lang: 'vi'
    } // vm.init = function () {
    //   vm.places = []
    // }

  };

  vm.getCalendar = ({
    startTime = moment().startOf('week').toDate(),
    endTime = moment().endOf('week').toDate()
  }) => {
    const calendar = uiCalendarConfig.calendars.meetingRoomCalendar;

    if (calendar) {
      const view = calendar.fullCalendar('getView');
      const {
        start,
        end
      } = view;
      startTime = moment(start).toDate();
      endTime = moment(end).toDate();
    }

    vm.startTime = startTime;
    vm.endTime = endTime;
    vm.waiting = true;
    const promise = MeetingRooms.calendar({
      startTime: startTime,
      endTime: endTime,
      place: vm.place
    }).$promise.then(meetingRooms => {
      _.remove(vm.events);

      _.forEach(meetingRooms, meetingRoom => {
        vm.events.push({
          meetingRoom,
          start: moment(meetingRoom.startTime),
          backgroundColor: '#FFF',
          textColor: 'black'
        });
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải danh sách phòng họp...', promise, () => {
      FhdMessenger.success('Đã tải xong');
    });
  };

  vm.findOne = function () {
    MeetingRooms.get({
      meetingRoomId: $stateParams.meetingRoomId
    }).$promise.then(meetingRoom => {
      vm.place = _.find(vm.places, {
        _id: meetingRoom.place
      });
      vm.meetingRoom = meetingRoom;
      vm.meetingRoom.date = moment(meetingRoom.date).format('YYYY-MM-DD');
    });
  };

  vm.update = function () {
    const meetingRoom = vm.meetingRoom;
    meetingRoom.startTime = mergeDateTime(meetingRoom.date, meetingRoom.startTime);
    meetingRoom.endTime = mergeDateTime(meetingRoom.date, meetingRoom.endTime);

    if (moment(meetingRoom.endTime).diff(moment(meetingRoom.startTime)) <= 0) {
      return FhdMessenger.error('Thời gian kết thúc phải ở sau thời gian bắt đầu');
    }

    if (!vm.meetingRoom.place) {
      return FhdMessenger.error('Bạn chưa chọn phòng họp');
    }

    meetingRoom.outletCode = meetingRoom.outlet.code;
    vm.waiting = true;
    meetingRoom.$update().then(() => {
      FhdMessenger.success('Sửa đổi thành công');
    }).catch(err => {
      vm.waiting = false;
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.remove = function () {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Huỷ',
      actionButtonText: 'Xóa',
      headerText: 'Xóa lịch đặt ?',
      bodyText: `Bạn có chắc là bạn muốn xóa lịch đặt không ? `
    }).then(() => {
      vm.waiting = true;
      vm.meetingRoom.$remove().then(() => {
        FhdMessenger.success('Đã xóa lịch trực thành công');
        $location.path('meeting-rooms');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.handleChangePosition = () => {
    vm.getCalendar({});
  };

  vm.eventSources = [vm.events, vm.getCalendar];
}]);
'use strict';

