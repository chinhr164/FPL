angular.module('stock-entries').controller('ModalSelectProblemController', ['$modalInstance', 'FhdMessenger', 'item', function ($modalInstance, FhdMessenger, item) {
  const vm = this;
  vm.item = _objectSpread({}, item);
  vm.problems = [{
    code: 'due-date',
    title: 'Cận date'
  }, {
    code: 'delivery',
    title: 'Lỗi vận chuyển'
  }, {
    code: 'label-item',
    title: 'Lỗi bao bì, nhãn'
  }, {
    code: 'quality-item',
    title: 'Lỗi chất lượng sản phẩm'
  }, {
    code: 'wrong-item',
    title: 'Lỗi giao sai số lượng, nhầm hàng'
  }];
  const requiredNoteProblems = ['delivery', 'label-item', 'quality-item', 'wrong-item'];
  const requiredPlTaskProblems = ['label-item', 'quality-item'];
  const requiredDueDate = ['due-date'];

  vm.shouldRequireNote = problem => {
    return _.includes(requiredNoteProblems, problem);
  };

  vm.shouldRequirePlTask = problem => {
    return _.includes(requiredPlTaskProblems, problem) && vm.item.privateLabel && vm.item.sku.match(/B\d+/);
  };

  vm.shouldRequireDueDate = problem => {
    return _.includes(requiredDueDate, problem);
  };

  vm.select = () => {
    const problemType = vm.problem.code;

    if (vm.shouldRequireDueDate(problemType) && !vm.expirationDate) {
      return FhdMessenger.error('Lỗi cận date bắt buộc điền hạn sử dụng');
    }

    if (vm.shouldRequirePlTask(problemType) && !vm.missingPlTask && !vm.plTask) {
      return FhdMessenger.error('Bạn chưa nhập số lô');
    }

    if (vm.shouldRequirePlTask(problemType) && !vm.missingPlTask && vm.item.sku !== vm.plTask.sku) {
      return FhdMessenger.error('Sản phẩm của Pl Task phải trùng với sản phẩm gặp vấn đề');
    }

    if (vm.shouldRequireNote(problemType) && !vm.note) {
      return FhdMessenger.error('Bạn chưa nhập lý do');
    }

    const note = getNote(vm.problem);
    vm.close({
      problemType,
      note,
      plTask: vm.plTask,
      expirationDate: vm.expirationDate
    });
  };

  function getNote(problem) {
    const {
      code
    } = problem;
    let note = ``;

    if (vm.expirationDate) {
      note += `${moment(vm.expirationDate).format('DD/MM/YYYY')} `;
    }

    if (vm.plTask) {
      note += `PlTask: ${vm.plTask.plTaskId} `;
    }

    if (vm.shouldRequireNote(code)) {
      note += `${vm.note}`;
    }

    return note;
  }

  vm.dismiss = function () {
    $modalInstance.dismiss();
  };

  vm.close = function (data) {
    $modalInstance.close(data);
  };

  vm.changeProblem = () => {
    vm.note = null;
    vm.plTask = null;
    vm.expirationDate = null;
  };
}]);
"use strict";

