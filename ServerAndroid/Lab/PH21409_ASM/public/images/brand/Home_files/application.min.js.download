angular.module('reports').directive('fhdPieChart', [function () {
  return {
    template: '<canvas class="chart chart-pie" data="dataset" labels="labels" options="options" legend="true"></canvas>',
    restrict: 'AE',
    scope: {
      data: '=chartData',
      labelName: '@',
      valueName: '@',
      percentage: '@'
    },
    controller: 'FhdPieChartController'
  };
}]).controller('FhdPieChartController', ['$scope', function ($scope) {
  $scope.$watch(function () {
    return $scope.data;
  }, function (newValue, oldValue) {
    if (newValue !== oldValue) {
      $scope.dataset = _.map($scope.data, $scope.valueName || 'value');

      if ($scope.labelName && $scope.labelName.includes('.')) {
        var keys = $scope.labelName.split('.');
        $scope.labels = _.map($scope.data, function (item) {
          var subItem = item[keys[0]];
          if (_.isArray(subItem)) return _.reduce(subItem, function (result, subSubItem) {
            return result ? result + ' | ' + subSubItem[keys[1]] : result + subSubItem[keys[1]];
          }, '');
          return subItem ? subItem[keys[1]] : subItem;
        });
      } else $scope.labels = _.map($scope.data, $scope.labelName || 'label');

      if ($scope.percentage) {
        var sum = _.reduce($scope.dataset, function (total, item) {
          return total + item;
        });

        $scope.dataset = _.map($scope.dataset, function (item) {
          return item / sum * 100;
        });
      }
    }
  });
  $scope.options = {
    animation: false
  };
  if ($scope.percentage) $scope.options.tooltipTemplate = function (label) {
    return label.label + ': ' + Math.round(label.value).toString() + '%';
  };
}]);
'use strict';

