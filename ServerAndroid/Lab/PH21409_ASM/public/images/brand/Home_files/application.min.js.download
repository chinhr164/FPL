angular.module('stop-selling-reports').controller('StopSellingReportsController', ['$stateParams', '$location', 'Authentication', 'StopSellingReports', 'FhdMessenger', 'NgTableParams', function ($stateParams, $location, Authentication, StopSellingReports, FhdMessenger, NgTableParams) {
  const vm = this;
  vm.authentication = Authentication; // Create new StopSellingReport

  vm.create = function () {
    // Create new StopSellingReport object
    const stopSellingReport = new StopSellingReports(vm.stopSellingReport); // Redirect after save

    stopSellingReport.$save().then(function (response) {
      $location.path(`stopSellingReports/${response._id}`); // Clear form fields

      vm.name = '';
    }, FhdMessenger.errorFromServer);
  }; // Remove existing StopSellingReport


  vm.remove = function (stopSellingReport) {
    if (stopSellingReport) {
      stopSellingReport.$remove();

      const index = _.findIndex(vm.stopSellingReports, stopSellingReport);

      if (index > -1) vm.stopSellingReports.splice(index, 1);
    } else {
      vm.stopSellingReport.$remove(function () {
        $location.path('stop-selling-reports');
      });
    }
  }; // Update existing StopSellingReport


  vm.update = function () {
    const stopSellingReport = vm.stopSellingReport;
    stopSellingReport.$update(function () {
      $location.path('stop-selling-reports');
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of StopSellingReports


  vm.find = function () {
    vm.stopSellingReports = StopSellingReports.query();
  };

  vm.stopSellingProductsTable = new NgTableParams({
    count: 1000
  }); // Find existing StopSellingReport

  vm.findOne = function () {
    vm.stopSellingReport = StopSellingReports.get({
      stopSellingReportId: $stateParams.stopSellingReportId
    });
    vm.stopSellingReport.$promise.then(stopSellingReport => {
      vm.stopSellingProductsTable.settings({
        dataset: stopSellingReport.items
      });
    });
  };
}]);
'use strict'; // StopSellingReports service used to communicate StopSellingReports REST endpoints

