angular.module('sale-entries').component('fhdFindSaleEntry', {
  templateUrl: 'modules/sale-entries/directives/fhd-find-sale-entry.client.template.html',
  controller: 'FhdFindSaleEntryController',
  controllerAs: 'vm',
  bindings: {
    partnershipOrderId: '=?',
    saleEntryId: '=?',
    saleEntry: '=?',
    onChange: '=?',
    label: '@',
    labelColumn: '@'
  },
  bindToController: true
}).controller('FhdFindSaleEntryController', ['$scope', 'FhdMessenger', 'SaleEntries', 'CurrentShift', function ($scope, FhdMessenger, SaleEntries, CurrentShift) {
  const vm = this;
  vm.labelColumn = Number(vm.labelColumn) || 3;
  vm.inputColumn = Number(vm.inputColumn) || 12 - vm.labelColumn;

  vm.find = () => {
    if (!vm.saleEntryCode) {
      return FhdMessenger.error('Bạn chưa nhập mã đơn');
    }

    SaleEntries.searchSaleEntry({
      saleEntryId: vm.saleEntryCode.trim()
    }).$promise.then(saleEntry => {
      if (!saleEntry._id) {
        return FhdMessenger.error('Không tìm thấy Sale Entry');
      }

      if (vm.onChange) {
        vm.onChange(saleEntry);
      }

      vm.partnershipOrderId = _.get(saleEntry, 'orderCode', null);
      vm.saleEntryId = _.get(saleEntry, 'saleEntryId', null);
      vm.saleEntry = _.get(saleEntry, '_id', null);
      vm.saleEntryCode = null;
    });
  };
}]);
'use strict';

