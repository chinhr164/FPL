angular.module('mkt-posts').factory('MktPostService', ['$modal', function ($modal) {
  const types = [{
    id: 'PHOTO',
    title: 'Ảnh'
  }, {
    id: 'VIDEO',
    title: 'Video'
  }, {
    id: 'LINKWEB',
    title: 'Link Web Abby'
  }, {
