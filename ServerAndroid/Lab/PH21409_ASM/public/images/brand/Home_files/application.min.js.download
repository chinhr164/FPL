angular.module('pop-quizzes').controller('PopQuizzesAnswerController', ['Authentication', '$modalInstance', '$window', '$interval', 'PopQuizzes', '$http', '$document', '$modal', 'FhdMessenger', 'PopQuizzesService', function (Authentication, $modalInstance, $window, $interval, PopQuizzes, $http, $document, $modal, FhdMessenger, PopQuizzesService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.questionIndex = 0;
  vm.time = 60;
  vm.question = {};
  vm.answer = [];
  vm.answerMap = {};
  vm.questionIndexs = [0, 1, 2, 3, 4]; // eslint-disable-next-line angular/document-service

  vm.init = async () => {
    const res = await $http.get('/pop-quizzes/get-one');
    vm.popQuiz = res.data;

    _.forEach(vm.popQuiz.questions, question => {
      if (question.question.questionType === 'ESSAY') {
        question.contentSplit = question.question.content.split('/');
        question.answer = [];
        question.answerMap = {};
      } else {
        _.forEach(question.answers, answer => {
          answer.color = '#fafafa';
        });
      }
    });

    vm.runTime();
  };

  vm.runTime = () => {
    let interval = $interval(() => {
      vm.time = vm.time - 1;

      if (vm.time === 0) {
        $interval.cancel(interval);
        sendAnswer();
      }
    }, 1000);
  };

  vm.selectQuestion = function (index) {
    vm.questionIndex = index;
  };

  vm.dismiss = $modalInstance.dismiss;

  vm.selectAnswer = (questionIndex, index) => {
    vm.popQuiz.questions[questionIndex].answerMap[index] = {
      selected: true,
      originIndex: index
    };
    vm.popQuiz.questions[questionIndex].answer.push({
      content: vm.popQuiz.questions[questionIndex].contentSplit[index],
      originIndex: index
    });
  };

  vm.removeAnswer = (questionIndex, originIndex, index) => {
    vm.popQuiz.questions[questionIndex].answerMap[originIndex] = {
      selected: false
    };
    vm.popQuiz.questions[questionIndex].answer.splice(index, 1);
  };

  vm.increaseIndex = () => {
    vm.questionIndex += 1;
  };

  vm.submitAnswer = async function () {
    // eslint-disable-next-line angular/window-service
    const confirm = $window.confirm('Bạn có chắc chắn muốn trả lời không?');
    if (!confirm) return;
    await sendAnswer();
  };

  vm.setAnswer = function (question, answer) {
    question.answerString = answer.content;
  };

  vm.getStyle = function (question, answer) {
    return `position: absolute;
      top: 55%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 25px;
      font-weight: 900;
      width: 100%;
      word-break: break-all;
      text-align: center;
      vertical-align: middle;
      display: flex;
      align-items: center;
      padding: 20px;
      height: 100%;
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;`;
  };

  async function sendAnswer() {
    _.forEach(vm.popQuiz.questions, question => {
      if (question.questionType === 'ESSAY') {
        question.answerString = _.map(question.answer, 'content').join('');
      }
    });

    FhdMessenger.info('Đang gửi câu trả lởi');
    vm.waiting = true;
    vm.time = 0;
    await $http.put(`/pop-quizzes/${vm.popQuiz._id}/answer`, {
      questions: vm.popQuiz.questions
    }).then(res => {
      vm.hideSubmitButton = true;
      return PopQuizzesService.openModalResult({
        correct: res.data.popQuiz.status
      });
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
      vm.closeTime = 3;
      let interval = $interval(() => {
        vm.closeTime = vm.closeTime - 1;

        if (vm.closeTime === 0) {
          $interval.cancel(interval);
          $modalInstance.close();
        }
      }, 1000);
    });
  }
}]);
"use strict";

angular.module('pop-quizzes').controller('PopQuizzesResultController', ['Authentication', '$modalInstance', '$interval', 'result', function (Authentication, $modalInstance, $interval, result) {
