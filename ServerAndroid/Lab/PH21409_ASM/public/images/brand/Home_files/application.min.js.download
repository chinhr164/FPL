angular.module('inventory').controller('OnHandInventoryByOutletsController', ['NgTableParams', 'InventoryService', 'OutletService', 'FhdMessenger', '$filter', '$interpolate', '$scope', '$sce', function (NgTableParams, InventoryService, OutletService, FhdMessenger, $filter, $interpolate, $scope, $sce) {
  const vm = this;

  function htmlValue($scope, product, column) {
    return column.valueTemplate;
  }

  vm.productsTable = new NgTableParams({
    sorting: {
      sku: 'asc'
    }
  });
  vm.columns = [{
    field: '$index',
    title: 'STT',
    show: true,
    getValue: (scope, product, column, index) => {
      return `<span>${index + 1}</span>`;
    }
  }, {
    field: 'sku',
    title: 'SKU',
    show: true,
    sortable: 'sku',
    filter: {
      sku: 'text'
    },
    getValue: htmlValue
  }, {
    field: 'description',
    title: 'Description',
    filter: {
      description: 'text'
    },
    sortable: 'description',
    show: true,
    valueTemplate: '<span>{{product.description}}</span>',
    getValue: htmlValue
  }, {
    field: 'price',
    title: 'Price',
    sortable: 'price',
    show: true,
    valueTemplate: '<span>{{product.price | number:0}}</span>',
    getValue: htmlValue
  }, {
    field: 'cogs',
    title: 'COGS',
    sortable: 'cogs',
    show: true,
    valueTemplate: '<span>{{product.cogs | number:0}}</span>',
    getValue: htmlValue
  }];
  OutletService.allAsync().then(outlets => {
    const storageOutlets = _.orderBy(_.filter(outlets, outlet => {
      return outlet.isStorage && outlet.hasStaff || outlet.code === 'SHIP';
    }), ['order'], ['asc']);

    const outletColumns = _.map(storageOutlets, outlet => {
      return {
        field: `outletMap.${outlet._id}.currentStock`,
        title: outlet.code,
        show: true,
        sortable: `outletMap['${outlet._id}']['currentStock']`,
        valueTemplate: `<span>{{product.outletMap['${outlet._id}'].currentStock}}</span>`,
        getValue: htmlValue,
        getColumnClass: (column, product) => {
          const classNames = [];
          if (_.get(product, column.field) <= 0) classNames.push('text-blue');
          if (column.title().match(/^M/i)) classNames.push('column-highlight-green');
          if (column.title() === 'D1') classNames.push('column-highlight');
          return classNames;
        }
      };
    });

    vm.columns.push(...outletColumns);
    vm.columns.push({
      field: 'total',
      title: 'Total',
      sortable: 'total',
      show: true,
      valueTemplate: '<span>{{product.total | number:0}}</span>',
      getValue: htmlValue
    });
  });

  vm.fetch = () => {
    const startWaiting = moment();
    let promise = InventoryService.getInventoryByOutlets().then(products => {
      vm.productsTable.settings({
        dataset: products
      });
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success(`Tải xong trong ${moment().diff(startWaiting, 'seconds', true)} giây`);
    });
  };
}]);
