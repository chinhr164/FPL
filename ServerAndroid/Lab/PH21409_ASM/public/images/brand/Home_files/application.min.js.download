'use strict'; // Announcements controller

angular.module('announcements').controller('AnnouncementsController', ['$sce', '$scope', '$stateParams', '$location', 'helper', 'Authentication', 'Announcements', '$localStorage', 'Outlets', '$http', 'FhdMessenger', 'UserService', 'ObjectId', 'OutletReportService', 'BusinessService', '$q', function ($sce, $scope, $stateParams, $location, helper, Authentication, Announcements, $localStorage, Outlets, $http, FhdMessenger, UserService, ObjectId, OutletReportService, BusinessService, $q) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = vm.authentication.user;
  vm.data = {
    outlets: [],
    notChangeContent: false
  };
  vm.startDate = moment().subtract(2, 'week').format('YYYY-MM-DD');
  vm.endDate = moment().format('YYYY-MM-DD');
  UserService.getRolesInTypes().then(roleTypes => {
    vm.data.roleTypes = roleTypes;
  });
  vm.removeValueFromArray = helper.removeValueFromArray;

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.announcement.outlets = _.map(selectedOutlets, '_id');
  };

  vm.simditorConfig = {
    allowedAttributes: {
      p: ['font-family', 'color'],
      span: ['font-family', 'color'],
      b: ['font-family', 'color'],
      i: ['font-family', 'color'],
      strong: ['font-family', 'color'],
      strike: ['font-family', 'color'],
      u: ['font-family', 'color'],
      h1: ['font-family', 'color'],
      h2: ['font-family', 'color'],
      h3: ['font-family', 'color'],
      h4: ['font-family', 'color'],
      h5: ['font-family', 'color']
    },
    allowedStyles: {
      span: ['font-family', 'color'],
      b: ['font-family', 'color'],
      i: ['font-family', 'color'],
      strong: ['font-family', 'color'],
      strike: ['font-family', 'color'],
      u: ['font-family', 'color'],
      p: ['font-family', 'color'],
      h1: ['font-family', 'color'],
      h2: ['font-family', 'color'],
      h3: ['font-family', 'color'],
      h4: ['font-family', 'color'],
      h5: ['font-family', 'color']
    }
  };
  vm.openCreateOutletReportModal = OutletReportService.openCreateOutletReportModal;

  if (vm.user && vm.user.roles && vm.user.roles.includes('admin')) {
    vm.businessPromise = BusinessService.allAsync().then(businesses => {
      vm.data.businesses = businesses;
      vm.businessMap = _.reduce(vm.data.businesses, (result, business) => {
        result[business._id] = true;
        return result;
      }, {});
    });
  }

  vm.outletPromise = Outlets.query({
    deleted: false,
    hasStaff: true
  }).$promise.then(outlets => {
    vm.data.outlets = _.map(outlets, outlet => ({
      _id: outlet._id,
      code: outlet.code,
      business: outlet.business,
      value: true
    }));
    vm.loaded = true;
  }).catch(FhdMessenger.errorFromServer);
  var announcement = $localStorage.getObject('announcement');

  if (announcement && (announcement.content || announcement.title)) {
    vm.announcement = {
      title: announcement.title,
      content: announcement.content
    };
  } else {
    vm.announcement = {
      title: '',
      content: ''
    };
  }

  vm.searchText = '';
  vm.sortOptions = ['Mới nhất', 'Cũ nhất'];
  vm.sortOption = 'Mới nhất';

  vm.selectAll = function (field) {
    const map = vm[`${field}Map`];
    let newValue = true;
    if (_.every(map)) newValue = false;

    _.forEach(map, (value, key) => {
      map[key] = newValue;
    });
  }; // Create new Announcement


  vm.create = function () {
    // Create new Announcement object
    var announcement = new Announcements(vm.announcement);
    announcement.roles = _.map(_.filter(_.flatten(_.map(vm.data.roleTypes, 'roles')), 'value'), 'id');

    if (!_.get(announcement, 'outlets.length') && !_.get(announcement, 'roles.length') && !_.get(announcement, 'staffs.length')) {
      return FhdMessenger.error('Chưa chọn nơi/người nhận thông báo!');
    }

    if (announcement.content.length >= 500000) {
      return FhdMessenger.error(`Bạn đã nhập quá số kí tự là: ${announcement.content.length - 500000}`);
    } // Redirect after save


    announcement.$save(function (response) {
      $localStorage.setObject('announcement', {});
      $location.path('memos/' + response._id); // Clear form fields

      vm.name = '';
    }, FhdMessenger.errorFromServer);
  }; // Remove existing Announcement


  vm.remove = function (announcement) {
    if (announcement) {
      announcement.$remove();

      for (var i in vm.announcements) {
        if (vm.announcements[i] === announcement) {
          vm.announcements.splice(i, 1);
        }
      }
    } else {
      vm.announcement.$remove(function () {
        $location.path('memos');
      });
    }
  }; // Update existing Announcement


  vm.update = function () {
    var announcement = vm.announcement;

    if (announcement.exclusive) {
      announcement.roles = _.map(_.filter(_.flatten(_.map(vm.data.roleTypes, 'roles')), 'value'), 'id');
    }

    if (!_.get(announcement, 'outlets.length') && !_.get(announcement, 'roles.length') && !_.get(announcement, 'staffs.length')) {
      return FhdMessenger.error('Chưa chọn nơi nhận thông báo!');
    }

    if (announcement.content.length >= 500000) {
      return FhdMessenger.error(`Bạn đã nhập quá số kí tự là: ${announcement.content.length - 500000}`);
    }

    vm.waiting = true;
    announcement.$update().then(res => {
      $location.path('memos/' + announcement._id);
      FhdMessenger.success('Cập nhật thành công!');
    }).catch(errorResponse => vm.error = errorResponse.data.message).finally(() => {
      vm.waiting = false;
    });
  }; // Find a list of Announcements
  // vm.find = function() {
  //   vm.announcements = Announcements.query({ sort: vm.sortOption }, function(
  //     announcements
  //   ) {
  //     vm.announcements = _.map(announcements, announcement =>
  //       _.assign(announcement, {
  //         snippet: _.trunc(announcement.content, 200),
  //       })
  //     )
  //   })
  // }


  vm.addComment = _.debounce(announcement => {
    if (!vm.data.mapComment[announcement._id]) {
      return FhdMessenger.error('Chưa nhập nội dung');
    }

    announcement.$addComment({
      content: vm.data.mapComment[announcement._id]
    }).then(response => {
      FhdMessenger.success('OK');
      announcement = response;
      processComment(announcement);
      announcement.comments = [{
        user: vm.user,
        content: vm.data.mapComment[announcement._id]
      }, ...announcement.comments];
      vm.data.mapComment[announcement._id] = '';
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  }, 500);

  vm.keyup = ($event, announcement) => {
    if ($event.keyCode !== 13) return;
    vm.addComment(announcement);
  };

  function processComment(announcement) {
    announcement.comments = _.sortBy(announcement.comments, function (comment) {
      return -comment.time.valueOf();
    });
    return announcement;
  }

  vm.search = function () {
    vm.skip = 20;

    const businesses = _.reduce(vm.businessMap, (result, value, business) => {
      if (value) result.push(business);
      return result;
    }, []);

    let promise = Announcements.query({
      business: businesses,
      searchText: vm.searchText,
      sort: vm.sortOption,
      staff: ObjectId.getObjectId(vm.staff),
      startDate: moment(vm.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.endDate).format('YYYY-MM-DD')
    }).$promise.then(announcements => {
      vm.announcements = _.map(announcements, announcement => {
        processComment(announcement);
        return announcement;
      });
      vm.data.mapComment = _.reduce(vm.announcements, (result, announcement) => {
        result[announcement._id] = '';
        return result;
      }, {});
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải danh sách memos...', promise, () => {
      FhdMessenger.success('Đã tải xong');
    });
  };

  vm.trustContent = content => {
    return $sce.trustAsHtml(content);
  };

  vm.staffSearchSelected = function (staff) {
    if (!staff) return;
    vm.search();
  }; // Find existing Announcement


  vm.findOne = function () {
    $q.all([vm.businessPromise, vm.outletPromise]).then(() => {
      vm.watchContent();
      Announcements.get({
        announcementId: $stateParams.announcementId
      }).$promise.then(announcement => {
        vm.announcement = announcement;

        _.forEach(vm.data.outlets, outlet => {
          outlet.value = false;

          if (_.some(announcement.outlets, {
            code: outlet.code
          })) {
            outlet.value = true;
          }
        });

        _.forEach(vm.data.roleTypes, roleType => {
          _.forEach(roleType.roles, role => {
            role.value = false;

            if (_.includes(announcement.roles, role.id)) {
              role.value = true;
            }
          });
        });
      });
    });
  };

  vm.viewOne = function () {
    vm.data.notChangeContent = true;
    Announcements.get({
      announcementId: $stateParams.announcementId
    }).$promise.then(announcement => {
      vm.announcement = announcement;
    });
  };

  $scope.$watch(() => vm.announcement.content, (newValue, oldValue) => {
    if (!newValue) return;
    vm.contentChanged();
  });

  vm.contentChanged = function () {
    if (vm.data.notChangeContent === true) return;
    $localStorage.setObject('announcement', vm.announcement);
  };

  vm.skip = 20;

  vm.loadMore = function () {
    const businesses = _.reduce(vm.businessMap, (result, value, business) => {
      if (value) result.push(business);
      return result;
    }, []);

    Announcements.query({
      skip: vm.skip,
      sort: vm.sortOption,
      startDate: moment(vm.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.endDate).format('YYYY-MM-DD'),
      business: businesses,
      searchText: vm.searchText,
      staff: ObjectId.getObjectId(vm.staff)
    }).$promise.then(announcements => {
      const _announcements = _.map(announcements, announcement => {
        return announcement;
      });

      vm.announcements.push(..._announcements);
      vm.skip += 20;
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.findByDate = () => {
    const startDate = moment(vm.startDate);
    const endDate = moment(vm.endDate);
    let announcementQuery = [];
    let promise = Announcements.query({
      startDate: startDate.format('YYYY-MM-DDTHH:mm:ss.SSSZ'),
      endDate: endDate.format('YYYY-MM-DDTHH:mm:ss.SSSZ'),
      sort: vm.sortOption,
      staff: ObjectId.getObjectId(vm.staff)
    }).$promise.then(announcement => {
      announcementQuery = [...announcement];
      vm.announcements = announcementQuery;

      if (announcementQuery.length === 0) {
        FhdMessenger.error(`Không có memos nào từ ngày ${startDate.format('YYYY-MM-DD')} đến ngày ${endDate.format('YYYY-MM-DD')}`);
      }
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải danh sách memos...', promise, () => {
      FhdMessenger.success('Đã tải xong');
    });
  };

  vm.selectAllOutlets = () => {
    let value = false;

    if (_.some(vm.data.outlets, {
      value: false
    })) {
      value = true;
    }

    _.forEach(vm.data.outlets, outlet => {
      outlet.value = value;
    });
  };

  vm.modifyVideoUrl = linkYoutube => {
    if (linkYoutube && _.isString(linkYoutube)) {
      if (linkYoutube.includes('https://www.youtube.com/watch') === true) {
        const url = linkYoutube.replace('watch?v=', 'embed/');
        return $sce.trustAsResourceUrl(url);
      }
    }
  };

  vm.includesYoutubeLink = linkYoutube => {
    return linkYoutube && linkYoutube.includes('https://www.youtube.com/watch');
  };

  vm.watchContent = $scope.$watch(() => vm.announcement.content, (newValue, oldValue) => {
    if (!newValue) return;
    vm.contentChanged();
  }); // copy paste from https://stackoverflow.com/a/58744668/3447052

  function highlightInHtml(html, textToHighlight) {
    const t = textToHighlight;
    const tagsRe = new RegExp('(<.+?>|&\\w+;)');
    const htmlParts = html.split(tagsRe).filter(Boolean);
    const r = htmlParts.map(item => tagsRe.test(item) ? item : item.replace(new RegExp(`(${t})`, 'ig'), `<span class="highlightedText">$1</span>`)).join('');
    return r;
  }

  vm.highlight = function (text, search) {
    if (!search) {
      return text;
    }

    return highlightInHtml(text, search);
  };
}]);
"use strict";

angular.module('announcements').controller('TrainingAnnouncementsController', ['Authentication', 'Announcements', 'NgTableParams', 'helper', '$window', '$http', 'FhdMessenger', '$state', function (Authentication, Announcements, NgTableParams, helper, $window, $http, FhdMessenger, $state) {
  const vm = this;
  vm.user = Authentication.user;
  vm.startDate = moment().subtract(1, 'week').startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().endOf('day').format('YYYY-MM-DD');
  vm.trainingMemosTable = new NgTableParams({
    count: 50
  });

  function convertFieldText(memo) {
    memo.userText = helper.convertObjectToText(memo.user, ['code', 'displayName'], ' - ');
    memo.documentTrainingByText = memo.documentTrainingBy ? helper.convertObjectToText(memo.documentTrainingBy, ['code', 'displayName'], ' - ') : null;
  }

  vm.find = () => {
    vm.waiting = true;
    Announcements.getTrainingMemos({
      startDate: vm.startDate,
      endDate: vm.endDate
    }).$promise.then(memos => {
      _.forEach(memos, memo => {
        convertFieldText(memo);
      });

      vm.trainingMemosTable.settings({
        dataset: memos
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.update = (e, memo) => {
    e.preventDefault();
    const link = $window.prompt('Nhập link tài liệu liên quan');
    if (!link) return;
    $http.put(`/announcements/training-memos`, {
      memoId: memo._id,
      link
    }).then(res => {
      memo.documentTrainingAt = moment();
      memo.linkInvolveDocument = link;
      memo.documentTrainingBy = vm.user;
      convertFieldText(memo);
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };
}]);
'use strict';

angular.module('announcements').factory('Announcements', ['$resource', function ($resource) {
  return $resource('announcements/:announcementId', {
    announcementId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    addComment: {
      method: 'PUT',
      url: 'announcements/:announcementId/add-comment'
    },
    getTrainingMemos: {
      method: 'GET',
      url: 'announcements/training-memos',
      isArray: true
    }
  });
}]);
