angular.module('core').factory('StyleService', ['OutletStockService', function (OutletStockService) {
  async function getOutletStyle() {
    const packingOutletCodes = OutletStockService.packingOutletCodes;
    const depotOutletCodes = OutletStockService.depotOutletCodes;
    const savorOutletCodes = OutletStockService.savorOutletCodes;
    const southOutletCodes = OutletStockService.southOutletCodes;
    const centralOutletCodes = OutletStockService.centralOutletCodes;
    return function (outletCode) {
      if (['E63', 'E64', 'E66'].includes(outletCode)) {
        return {
          'background-color': '#7effe7'
        };
      }

      if (southOutletCodes.includes(outletCode)) {
        return {
          'background-color': '#dbfa87'
        };
      }

      if (centralOutletCodes.includes(outletCode)) {
        return {
          'background-color': '#ffef2f'
        };
      }

      if (depotOutletCodes.includes(outletCode)) {
        return {
          'background-color': '#f4ece8'
        };
      }

      if (savorOutletCodes.includes(outletCode)) {
        return {
          'background-color': '#7effe7'
        };
      }

      if (packingOutletCodes.includes(outletCode)) {
        return {
          'background-color': '#f4ece8'
        };
      }

      return {};
    };
  }

  return {
    getOutletStyle
  };
}]);
'use strict';

angular.module('core').factory('TextService', [function () {
  // Copy paste from http://stackoverflow.com/questions/17289448/angularjs-to-output-plain-text-instead-of-html
  var stripHtml = function (text) {
    return text ? String(text).replace(/<[^>]+>/gm, '') : '';
  }; // Copy paste from http://stackoverflow.com/questions/765419/javascript-word-count-for-any-given-dom-element


  var countWord = function (s) {
    return !s ? 0 : s.split(/^\s+$/).length === 2 ? 0 : 2 + s.split(/\s+/).length - s.split(/^\s+/).length - s.split(/\s+$/).length;
  };

  return {
    stripHtml: stripHtml,
    countWord: countWord,
    countHtmlText: function (text) {
      return countWord(stripHtml(text));
    }
  };
}]);
'use strict';

angular.module('core').factory('TsvToJson', [function () {
  function convert(tsvText, allString) {
    const lines = tsvText.split('\n');

    const headers = _.head(lines).split('\t');

    const data = _.tail(lines).map(function (line) {
      return line.split('\t').reduce(function (obj, value, keyIndex) {
        if (!isNaN(value)) {
          obj[headers[keyIndex]] = allString ? value.trim() : parseFloat(value);
        } else {
          obj[headers[keyIndex]] = value.trim();
        }

        return obj;
      }, {});
    });

    return data;
  }

  return {
    convert
  };
}]);
"use strict";

