angular.module('sale-codes').controller('ModalDisableSaleCodeController', ['$modalInstance', 'Authentication', 'FhdMessenger', 'saleCode', 'index', function ($modalInstance, Authentication, FhdMessenger, saleCode, index) {
  const vm = this;
  vm.authentication = Authentication;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.sendingRequest = false;
  vm.disableReason = '';

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.confirm = () => {
    if (!vm.disableReason) {
      return FhdMessenger.error('Chưa giải thích lý do vô hiệu hóa sale code.');
    }

    saleCode.disableReason = vm.disableReason;
    saleCode.$disable().then(res => {
      FhdMessenger.success('Disable thành công');
      $modalInstance.close(index);
    }).catch(err => FhdMessenger.error(err));
  };
}]);
"use strict";

angular.module('sale-codes').controller('ModalOutletReportForSaleCodeController', ['saleCode', '$modalInstance', 'Authentication', 'ConfirmModal', 'FhdMessenger', 'SaleCodes', 'SaleCodeService', '$modal', function (saleCode, $modalInstance, Authentication, ConfirmModal, FhdMessenger, SaleCodes, SaleCodeService, $modal) {
  const vm = this;
  vm.user = Authentication.user;
  SaleCodes.get({
    saleCodeId: saleCode._id
  }).$promise.then(_saleCode => {
    vm.saleCode = _saleCode;

    _.forEach(vm.saleCode.outletReports, outletReport => {
      outletReport.quantity = _.get(_.head(outletReport.products), 'quantity');
    });
  });
  vm.cancel = $modalInstance.dismiss;

  vm.requestUpdateStock = () => {
    vm.waiting = true;
    vm.saleCode.$requestUpdateStock().then(res => {
      FhdMessenger.success('Đã gửi yêu cầu cập nhật số tồn');
      $modalInstance.close();
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.removeOutletReport = outletReport => {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Huỷ',
      actionButtonText: 'Xóa',
      headerText: 'Xóa Outlet Report?',
      bodyText: `Bạn có chắc là bạn muốn xóa Outlet Report: ${outletReport.title}?`
    }).then(() => {
      vm.waiting = true;
      vm.saleCode.removedOutletReport = outletReport;
      vm.saleCode.$removeOutletReport().then(() => {
        _.forEach(vm.saleCode.outletReports, outletReport => {
          outletReport.quantity = _.get(_.head(outletReport.products), 'quantity');
        });

        FhdMessenger.success(`Đã xoá outlet report!`);
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.requestTransfer = SaleCodeService.openRequestTransferForSaleCode;
  vm.updateSalePrice = SaleCodeService.openUpdateSalePriceForSaleCode;
}]);
"use strict";

angular.module('sale-codes').controller('ModalRequestTransferController', ['saleCode', '$modalInstance', 'Authentication', '$modal', 'FhdMessenger', '$http', '$window', 'ObjectId', function (saleCode, $modalInstance, Authentication, $modal, FhdMessenger, $http, $window, ObjectId) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {};
  vm.data.destinations = [];
  vm.saleCode = saleCode;
  vm.cancel = $modalInstance.dismiss;

  vm.insertDestination = _destination => {
    if (ObjectId.equals(vm.outlet, _destination)) {
      return FhdMessenger.error('Nơi nhận phải khác nơi gửi');
    }

    vm.data = vm.data || [];

    if (_.some(vm.data.destinations, destination => {
      return ObjectId.equals(destination.outlet, vm.outlet) && ObjectId.equals(destination.destination, _destination);
    })) {
      return FhdMessenger.error('Đã có cơ sở gửi và cơ sở nhận này trong danh sách');
    }

    vm.data.destinations.push({
      destination: _destination,
      outlet: vm.outlet,
      quantity: 0
    });
  };

  vm.requestTransfer = () => {
    if (_.some(vm.data.destinations, destination => {
      return !_.isNumber(destination.quantity);
    })) {
      return FhdMessenger.error('Bạn điền thiếu số lượng');
    }

    vm.saleCode.destinations = vm.data.destinations;
    vm.waiting = true;
    vm.saleCode.$requestTransfer().then(res => {
      FhdMessenger.success('Cập nhật luân chuyển thành công');
      $modalInstance.close();
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('sale-codes').controller('ModalSaleCodeDetailsController', ['saleCode', '$modalInstance', 'Authentication', 'FhdMessenger', 'SaleCodes', '$modal', function (saleCode, $modalInstance, Authentication, FhdMessenger, SaleCodes, $modal) {
  const vm = this;
  vm.user = Authentication.user;
  vm.saleCode = SaleCodes.get({
    saleCodeId: saleCode._id
  });
  vm.cancel = $modalInstance.dismiss;
}]);
"use strict";

angular.module('sale-codes').controller('SaleCodesController', ['$location', '$stateParams', '$scope', '$timeout', '$window', 'JsPrintService', 'SaleCodes', 'SaleCodeService', 'NgTableParams', 'CurrentShift', 'FhdMessenger', 'OutletService', 'ProductService', 'ObjectId', 'Authentication', function ($location, $stateParams, $scope, $timeout, $window, JsPrintService, SaleCodes, SaleCodeService, NgTableParams, CurrentShift, FhdMessenger, OutletService, ProductService, ObjectId, Authentication) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.showOutletMap = {};
  vm.data = {
    regions: ['NORTH', 'SOUTH']
  };
  vm.data.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().add(3, 'months').endOf('month').format('YYYY-MM-DD');
  vm.updateSalePrice = SaleCodeService.openUpdateSalePriceForSaleCode;
  vm.data.filterDateBy = 'expiryDate';
  vm.statuses = ['actived', 'disabled'];
  vm.dateTypes = [{
    id: 'all',
    name: 'Không lọc theo ngày'
  }, {
    id: 'expiryDate',
    name: 'Ngày hết hạn'
  }, {
    id: 'createdDate',
    name: 'Ngày tạo'
  }];
  vm.data.status = 'actived';
  const seeAllRoles = ['admin', 'tro-ly-ns', 'sale-code:create', 'sale-code:view'];

  const currentOutlet = _.get(CurrentShift.getCurrentShift(), 'outlet', vm.user.outlet);

  if (_.get(currentOutlet, 'code', '').match(/[ME]\d+/)) {
    vm.data.filterDateBy = 'all';
  }

  vm.checkCreatedLabel = saleCode => {
    const errorLabel = 'text-danger';

    const shelfLife = _.get(saleCode, 'product.shelfLife', 0);

    if (!shelfLife) {
      return 'text-default';
    }

    const region = _.get(_.head(saleCode.outlets), 'region');

    const diffDay = moment(saleCode.expiryDate).diff(moment(saleCode.created), 'day');

    if (region === 'NORTH') {
      if (shelfLife <= 30 && diffDay < 7 || shelfLife > 30 && diffDay < 14) {
        return errorLabel;
      }
    }

    if (['SOUTH', 'CENTRAL'].includes(region)) {
      if (shelfLife <= 15 && diffDay < 7) {
        return errorLabel;
      }

      if (shelfLife <= 30 && diffDay < 14) {
        return errorLabel;
      }

      if (shelfLife > 30 && diffDay < 21) {
        return errorLabel;
      }
    }

    return 'text-default';
  };

  vm.getTypeGroups = () => [{
    id: 'non-food',
    title: 'Non Food'
  }, {
    id: 'food',
    title: 'Food'
  }];

  vm.getInfoImages = () => [{
    id: false,
    title: 'Không'
  }, {
    id: true,
    title: 'Có'
  }];

  vm.barcodeOptions = {
    format: 'CODE128',
    lineColor: '#000000',
    background: 'rgba(255, 0, 0, 0)',
    width: 1,
    height: 30,
    displayValue: true,
    fontOptions: '',
    font: 'LatoWeb',
    textAlign: 'center',
    textPosition: 'bottom',
    textMargin: 2,
    fontSize: 8,
    margin: 0,
    marginTop: 0,
    marginBottom: 0,
    marginLeft: 0,
    marginRight: 0
  };

  vm.checkAll = function () {
    _.forEach(vm.saleCodeTable.data, saleCode => {
      saleCode.checked = vm.checked;
    });

    vm.changePrintSaleCode();
  };

  vm.printingSaleCodes = [];

  vm.changePrintSaleCode = function () {
    vm.printingSaleCodes = _.filter(vm.saleCodeTable.data, {
      checked: true
    });
  };

  vm.print = function (saleCodes) {
    vm.printingSaleCodes = _.isArray(saleCodes) ? saleCodes : [saleCodes];
    vm.printSaleCodes();
  };

  vm.printSaleCodes = function () {
    $timeout(() => {
      JsPrintService.printElementById('print-sale-codes-client', true);
    }, 100).finally(() => {
      vm.changePrintSaleCode();
    });
  };

  vm.saleCodeTable = new NgTableParams();

  function attachOutletText(saleCodes) {
    const newSaleCodes = _.map(saleCodes, saleCode => {
      saleCode.outletText = (_.map(saleCode.outlets, 'code') || []).join(', ');
      return saleCode;
    });

    return newSaleCodes;
  }

  vm.find = () => {
    let currentShiftOutlet = _.get(CurrentShift.getCurrentShift(), 'outlet');

    let currentShiftOutletId;

    if (_.get(currentShiftOutlet, 'code', '').match(/[ME]\d+/)) {
      currentShiftOutletId = currentShiftOutlet._id;
    }

    const regions = _.reduce(vm.regionMap, (result, toShow, region) => {
      if (toShow) result.push(region);
      return result;
    }, []);

    vm.waiting = true;
    const promise = SaleCodes.query({
      startDate: vm.data.filterDateBy === 'all' ? '' : vm.data.startDate,
      endDate: vm.data.filterDateBy === 'all' ? '' : vm.data.endDate,
      outlet: _.get(vm, 'outlet._id'),
      regions,
      currentShiftOutletId: currentShiftOutletId,
      status: vm.data.status,
      filterDateBy: vm.data.filterDateBy
    }).$promise;
    FhdMessenger.notifyLoading('Đang tải danh sách sale codes', promise);
    promise.then(saleCodes => {
      vm.saleCodes = checkPriceAndExpiryDateOfSaleCode(saleCodes);
      vm.saleCodes = attachUndoneOutletReportForSaleCode(saleCodes);
      vm.saleCodes = attachOutletText(vm.saleCodes);
      vm.saleCodes = addCreatedLabel(vm.saleCodes);

      _.forEach(vm.saleCodes, saleCode => {
        saleCode.hasInfoImage = false;

        if (_.get(saleCode, 'infoImages.length')) {
          saleCode.hasInfoImage = true;
        }
      });

      vm.saleCodeTable.settings({
        dataset: vm.saleCodes
      }).sorting({
        hasExpiryDate: 'desc',
        expiryDate: 'asc',
        description: 'asc'
      });
      FhdMessenger.success('Tải danh sách thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  function addCreatedLabel(saleCodes) {
    const _saleCodes = _.map(saleCodes, saleCode => {
      saleCode.createdLabel = vm.checkCreatedLabel(saleCode);
      return saleCode;
    });

    return _saleCodes;
  }

  function checkPriceAndExpiryDateOfSaleCode(saleCodes) {
    const newSaleCodes = _.reduce(saleCodes, (result, saleCode) => {
      if (saleCode.expiryDate) {
        saleCode.diffDay = Math.round(moment(saleCode.expiryDate).diff(moment()) / (1000 * 60 * 60 * 24));
        saleCode.hasExpiryDate = 1;

        if (saleCode.diffDay < 14) {
          saleCode.warning = true;
        }
      } else {
        saleCode.hasExpiryDate = 0;
      }

      saleCode.price = ProductService.getSoldPrice(saleCode.product, _.get(saleCode, 'outlets.0'));
      saleCode.saleCodeWarning = saleCode.salePrice >= saleCode.price;
      saleCode.totalPrice = saleCode.quantity * saleCode.salePrice;
      result.push(saleCode);
      return result;
    }, []);

    return newSaleCodes;
  }

  function attachUndoneOutletReportForSaleCode(saleCodes) {
    return _.map(saleCodes, saleCode => {
      const undoneOutletReports = _.filter(saleCode.outletReports, {
        status: 'created'
      });

      saleCode.numUndoneOutletReport = undoneOutletReports.length;
      return saleCode;
    });
  }

  $scope.$watch(() => vm.saleCodeTable.data, function (tableRows, oldValue) {
    if (tableRows === oldValue) return;
    vm.summaryQuantity = 0;
    vm.summaryOriginalQuantity = 0;
    vm.summaryTotalPrice = 0;

    _.forEach(tableRows, saleCode => {
      const saleCodeQuantity = _.get(saleCode, 'quantity', 0);

      const saleCodeOriginalQuantity = _.get(saleCode, 'originalQuantity', 0);

      const saleCodeTotalPrice = _.get(saleCode, 'totalPrice', 0);

      vm.summaryQuantity += saleCodeQuantity;
      vm.summaryOriginalQuantity += saleCodeOriginalQuantity;
      vm.summaryTotalPrice += saleCodeTotalPrice;
    });
  });
  $scope.$watch(() => vm.product, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    ProductService.getSoldPrice(newValue, currentOutlet).then(soldPrice => {
      vm.product.soldPrice = soldPrice;
    });
  });

  vm.filterSalePriceHigherSoldPrice = saleCodes => {
    if (vm.filteredSalePriceHigherSoldPrice) {
      return vm.saleCodeTable.settings({
        dataset: _.filter(saleCodes, 'saleCodeWarning')
      });
    }

    return vm.saleCodeTable.settings({
      dataset: saleCodes
    });
  };

  function loadOutlet() {
    OutletService.allAsync().then(result => {
      vm.outlets = result;
      vm.outlets = _.filter(vm.outlets, outlet => {
        if (outlet.isPos && outlet.hasStaff && _.get(outlet, 'business.code', 'ABBY') === 'ABBY') {
          return true;
        }
      });
      vm.showOutletMap = _.reduce(vm.outlets, (result, outlet) => {
        if (_.intersection(vm.user.roles, seeAllRoles).length > 0 || ObjectId.equals(outlet, vm.user.outlet)) {
          if (vm.showOutletMap[outlet._id]) {
            result[outlet._id] = true;
          } else {
            result[outlet._id] = false;
          }
        }

        return result;
      }, {});
      vm.enableOutletMap = _.clone(vm.showOutletMap);
    });
  }

  vm.init = () => {
    loadOutlet();
    vm.outletExclusive = true;
  };

  vm.findOne = () => {
    loadOutlet();
    vm.saleCode = SaleCodes.get({
      saleCodeId: $stateParams.saleCodeId
    });
    vm.saleCode.$promise.then(saleCode => {
      if (vm.saleCode.salePrice && !vm.saleCode.salePercent) {
        vm.saleCode.salePercent = Math.round((vm.saleCode.product.cogs - vm.saleCode.salePrice) / vm.saleCode.product.cogs * 100 * 100) / 100;
      }

      _.forEach(saleCode.outlets, outlet => {
        vm.showOutletMap[outlet._id] = true;
      });

      if (saleCode.product) {
        const cogs = ProductService.getOutletProperty('cogs', saleCode.outlets[0], saleCode.product);
        const price = ProductService.getOutletProperty('price', saleCode.outlets[0], saleCode.product);
        const salePrice = ProductService.getOutletProperty('salePrice', saleCode.outlets[0], saleCode.product);
        vm.priceDisplay = price;
        vm.cogsDisplay = cogs;
        vm.salePriceDisplay = salePrice;
      }
    });
  };

  $scope.$watch(() => vm.product, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    vm.typeGroup = 'non-food';

    if (_.get(newValue, 'category')) {
      if (ProductService.isFoodProduct(newValue)) vm.typeGroup = 'food';
    }
  });

  vm.showOutlet = () => {
    vm.saleCode.$promise.then(saleCode => {
      _.forEach(saleCode.outlets, outlet => {
        vm.showOutletMap[outlet] = true;
      });
    });
  };

  function makeSaleCodeId() {
    var text = 'S';
    var possible = '0123456789';

    for (var i = 0; i < 8; i++) text += possible.charAt(Math.floor(Math.random() * possible.length));

    return text;
  }

  vm.create = () => {
    if (!vm.product) {
      FhdMessenger.error('Bạn chưa chọn sản phẩm cần giảm giá!');
      return;
    }

    if (!vm.salePrice) {
      vm.salePrice = vm.product.price / 2;
    }

    if (!vm.quantity) {
      FhdMessenger.error('Bạn chưa điền số lượng!');
      return;
    }

    const outlets = _.reduce(vm.showOutletMap, (outlets, toShow, outlet) => {
      if (toShow) outlets.push(outlet);
      return outlets;
    }, []);

    if (vm.typeGroup === 'food' && !vm.expiryDate) {
      return FhdMessenger.error('Đối với thực phẩm phải có hạn sử dụng!');
    }

    vm.waiting = true;
    const saleCode = new SaleCodes({
      saleCodeId: makeSaleCodeId(),
      product: vm.product._id,
      sku: vm.product.sku,
      typeGroup: vm.typeGroup,
      description: vm.product.description,
      salePrice: vm.salePrice,
      outletExclusive: vm.outletExclusive,
      outlets: outlets || [],
      originalQuantity: vm.quantity,
      quantity: vm.quantity,
      isLate: vm.isLate,
      user: vm.user,
      note: vm.note,
      expiryDate: vm.expiryDate
    });
    saleCode.$save().then(() => {
      FhdMessenger.success('Tạo sale code thành công.');
      $location.path('sale-codes');
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.update = () => {
    const outlets = _.reduce(vm.showOutletMap, (outlets, toShow, outlet) => {
      if (toShow) outlets.push(outlet);
      return outlets;
    }, []);

    if (outlets.length) {
      vm.saleCode.outlets = outlets || [];
    }

    if (!_.get(vm.saleCode, 'salePrice', 0)) {
      return FhdMessenger.error('Chưa có giá sale');
    }

    const saleCode = vm.saleCode;
    saleCode.$update().then(res => {
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.disable = (saleCode, index) => {
    saleCode.disableReason = $window.prompt('Nhập lý do xóa sale code: ');

    if (!saleCode.disableReason) {
      return FhdMessenger.error('Chưa nhập lý do xóa sale code');
    }

    vm.waiting = true;
    saleCode.$disable().then(res => {
      if (index) {
        vm.saleCodes.splice(index, 1);
        vm.saleCodeTable.settings({
          dataset: vm.saleCodes
        });
        vm.saleCodeTable.reload();
        FhdMessenger.success('Gửi yêu cầu thành công');
      }
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.openModalSaleCodeDetail = SaleCodeService.openModalSaleCodeDetail;
  vm.openViewOutletReportForSaleCode = SaleCodeService.openViewOutletReportForSaleCode;

  vm.changeSalePercent = saleCode => {
    if (saleCode.salePercent) {
      saleCode.salePrice = saleCode.product.price * (100 - saleCode.salePercent) / 100;
    } else {
      saleCode.salePrice = 0;
    }
  };

  vm.changeSalePrice = saleCode => {
    if (saleCode.salePrice) {
      saleCode.salePercent = Math.round((saleCode.product.price - saleCode.salePrice) / saleCode.product.price * 100 * 100) / 100;
    } else {
      saleCode.salePercent = 0;
    }
  };

  vm.active = function (saleCode) {
    vm.waiting = true;
    saleCode.$active().then(res => {
      FhdMessenger.success('Đã thay đổi trạng thái thành actived');
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('sale-codes').controller('UpdateSaleCodeInfoController', ['SaleCodes', '$stateParams', 'FhdMessenger', '$state', 'Authentication', function (SaleCodes, $stateParams, FhdMessenger, $state, Authentication) {
  const vm = this;
  vm.user = Authentication.user;
  vm.images = [];
  vm.waiting = false;

  vm.findOne = () => {
    vm.saleCode = SaleCodes.get({
      saleCodeId: $stateParams.saleCodeId
    });
  };

  vm.updateInfo = () => {
    vm.saleCode.newInfoImages = vm.images;

    if (!vm.saleCode.newInfoImages.length) {
      FhdMessenger.error('Chưa có ảnh để add thêm.');
      return;
    }

    vm.waiting = true;
    vm.saleCode.$updateInfo().then(() => {
      vm.images = [];
      FhdMessenger.success('Cập nhật thành công!');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('sale-codes').factory('SaleCodes', ['$resource', function ($resource) {
