  vm.addPartnerAccount = function () {
    vm.outlet.partnerAccounts = vm.outlet.partnerAccounts || [];
    vm.outlet.partnerAccounts.push({
      partnerName: vm.partnerName,
      username: vm.username,
      password: vm.password,
      domain: vm.domain,
      guideline: vm.guideline
    });
  };

  vm.removePartnerAccount = partnerAccount => {
    _.remove(vm.outlet.partnerAccounts, partnerAccount);
