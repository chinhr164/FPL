angular.module('products').controller('ImportDelayBuyingProductsController', ['Authentication', 'Products', 'FhdMessenger', 'ConfirmModal', function (Authentication, Products, FhdMessenger, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.regions = ['SOUTH', 'NORTH', 'CENTRAL', 'ALL'];

  function validateItems() {
    let errors = [];

    if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('product:edit')) {
      errors.push(`Bạn không có quyền import update delayBuying`);
      return errors;
    }

    if (_.some(vm.rawItems, item => {
      return !_.get(item, 'sku');
    })) {
      errors.push(`Bạn chưa điền đủ sku`);
    }

    if (_.some(vm.rawItems, item => {
      return !['TRUE', 'FALSE'].includes(_.get(item, 'delayBuying', ''));
    })) {
      errors.push(`Giá trị của delayBuying  phải là TRUE hoặc FASLE`);
    }

    if (_.some(vm.rawItems, item => {
      return !vm.regions.includes(_.get(item, 'region', ''));
    })) {
      errors.push(`Giá trị của region có thể sử dụng là: ${vm.regions.join('/ ')}`);
    }

    if (_.some(vm.rawItems, item => {
      return _.get(item, 'delayBuying', '').toUpperCase() === 'TRUE' && !_.get(item, 'expectedBuyingDate');
    })) {
      errors.push(`Cần điền thêm expectedBuyingDate với các sản phẩm delayBuying là TRUE`);
    }

    if (_.some(vm.rawItems, item => {
      if (item.expectedBuyingDate) {
        return moment(item.expectedBuyingDate).isBefore(moment());
      }

      return false;
    })) {
      errors.push(`expectedBuyingDate phải sau ngày hôm nay`);
    }

    return errors;
  }

  vm.import = () => {
    if (!vm.rawItems) {
      return;
    }

    const err = validateItems();

    if (err.length) {
      _.forEach(err, err => {
        return FhdMessenger.error(err);
      });

      return;
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ Update delayBuying cho ${vm.rawItems.length} products?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      Products.importDelayBuying({
        rawItems: vm.rawItems
      }).$promise.then(({
        errorSkus
      }) => {
        FhdMessenger.success(`Update delayBuying cho ${vm.rawItems.length - errorSkus.length} sản phẩm thành công`);
        vm.errorSkus = errorSkus.join(', ');
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
'use strict';

angular.module('products').controller('ImportProductsController', ['Authentication', 'Products', 'FhdMessenger', '$http', '$location', '$state', 'ProductService', 'ConfirmModal', function (Authentication, Products, FhdMessenger, $http, $location, $state, ProductService, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.requireFields = 'business productType description cogs warehouseRestock tetCategory group netWeight privateLabel'.split(' '); // vm.importType == fasle là import create | true là import update

  function isAllValidField(field) {
    return _.some(vm.rawItems, item => {
      return !_.get(item, field) && _.get(item, field) !== 0;
    });
  }

  function validateItems(isUpdate) {
    if (!isUpdate) {
      let errors = [];

      if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('product:create')) {
        errors.push(`Bạn không có quyền import product`);
        return errors;
      }

      if (_.some(vm.rawItems, item => {
        return item.sku;
      })) {
        errors.push(`Hình như bạn bị nhầm chức năng rồi, kiểm tra lại dữ liệu nhé!`);
        return errors;
      }

      _.forEach(vm.requireFields, requireField => {
        if (isAllValidField(requireField)) {
          errors.push(`Bạn chưa điền đủ ${requireField}`);
        }
      });

      if (_.some(vm.rawItems, item => {
        return !_.get(item, 'warehouseGroup') && _.get(item, 'business') === 'ABBY' && _.get(item, 'productType') === 'sell';
      })) {
        errors.push('Bạn chưa điền đủ warehouseGroup cho các sản phẩm ABBY productType là sell');
      }

      return errors;
    } else {
      if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('product:edit')) {
        return 'Bạn không có quyền import';
      }

      if (_.some(vm.rawItems, item => {
        return item.business;
      })) {
        return 'Hình như bạn bị nhầm chức năng rồi, kiểm tra lại dữ liệu nhé!';
      }

      if (isAllValidField('sku')) {
        return 'Bạn chưa điền đủ sku';
      }
    }
  }

  vm.import = () => {
    if (!vm.rawItems) {
      return;
    }

    if (!vm.importType) {
      const errCreate = validateItems(vm.importType);

      if (errCreate.length) {
        _.forEach(errCreate, err => {
          return FhdMessenger.error(err);
        });

        return;
      }

      ConfirmModal.showModal({}, {
        bodyText: `Hành động này sẽ import create ${vm.rawItems.length} products?`,
        actionButtonText: 'Đồng ý',
        closeButtonText: 'Kiểm tra lại'
      }).then(() => {
        vm.waiting = true;
        Products.importProducts({
          rawItems: vm.rawItems
        }).$promise.then(({
          productsList,
          errorProducts
        }) => {
          vm.products = productsList;
          vm.errorProducts = errorProducts;

          if (vm.products.length) {
            FhdMessenger.success(`Import ${productsList.length} sản phẩm thành công`);
          }

          if (_.get(errorProducts, 'length')) {
            FhdMessenger.error(`Có ${errorProducts.length} sản phẩm import không thành công, kiểm tra các sản phẩm lỗi trong danh sách nhé`);
          }
        }).catch(err => {
          return FhdMessenger.errorFromServer(err);
        }).finally(() => {
          vm.waiting = false;
        });
      });
    } else {
      const errUpdate = validateItems(vm.importType);

      if (errUpdate) {
        return FhdMessenger.error(errUpdate);
      }

      ConfirmModal.showModal({}, {
        bodyText: `Hành động này sẽ import update ${vm.rawItems.length} products?`,
        actionButtonText: 'Đồng ý',
        closeButtonText: 'Kiểm tra lại'
      }).then(() => {
        vm.waiting = true;
        Products.importUpdateProducts({
          rawItems: vm.rawItems
        }).$promise.then(products => {
          vm.updatedProducts = products;
          return FhdMessenger.success(`Update ${products.length} Products thành công`);
        }).catch(err => {
          return FhdMessenger.errorFromServer(err);
        }).finally(() => {
          vm.waiting = false;
        });
      });
    }
  };
}]);
'use strict';

angular.module('products').controller('ListConvertProductsController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'Products', 'ProductService', function (Authentication, FhdMessenger, NgTableParams, Products, ProductService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.quickEditProduct = ProductService.quickEditProduct;
  vm.listConvertSKUTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    ProductService.listConvertProducts().then(products => {
      vm.listConvertSKUTable.settings({
        dataset: products
      });
    });
  };
}]);
'use strict';

angular.module('products').controller('ListPlProductsController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'Products', 'ProductService', 'PlProductService', function (Authentication, FhdMessenger, NgTableParams, Products, ProductService, PlProductService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.openEditPlDescriptionForProduct = ProductService.openEditPlDescriptionForProduct;
  vm.quickEditProduct = ProductService.quickEditProduct;
  vm.listPlSKUTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    Products.findPrivateLabelProduct().$promise.then(products => {
      vm.products = _.filter(products, product => {
        if (!product.privateLabel) {
          return false;
        }

        if (_.get(vm.user, 'outlet.code').match(/G\d+/)) {
          return product.sku.match(/^B\d+/);
        }

        if (_.get(vm.user, 'outlet.code').match(/B\d+/)) {
          return product.sku.match(/^V\d+/);
        }

        return true;
      });

      _.forEach(vm.products, product => {
        product.labelsText = PlProductService.convertProductsToText(product.labels);
        product.wrappersText = PlProductService.convertProductsToText(product.wrappers);
        product.rawProductsText = PlProductService.convertProductsToText(product.rawProducts);

        if (_.get(product, 'labels.length')) {
          product.hasLabel = true;
        } else {
          product.hasLabel = false;
        }

        if (_.get(product, 'wrappers.length')) {
          product.hasWrapper = true;
        } else {
          product.hasWrapper = false;
        }

        if (_.get(product, 'rawProducts.length')) {
          product.hasRawProduct = true;
        } else {
          product.hasRawProduct = false;
        }
      });

      vm.listPlSKUTable.settings({
        dataset: vm.products
      });
    });
  };

  vm.data = {
    notBuyingType: [{
      title: 'false',
      id: 'false'
    }, {
      title: 'true',
      id: 'true'
    }]
  };

  vm.getPlTypes = () => [{
    title: 'Bao tải',
    id: 'sack'
  }, {
    title: 'Phi thực phẩm',
    id: 'non-food'
  }, {
    title: 'Hàng hút chân không',
    id: 'vacuum'
  }, {
    title: 'Khác',
    id: 'other'
  }];
}]);
'use strict'; // List Price Products Controller

angular.module('products').controller('ListPriceProductsController', ['$filter', '$state', 'Products', 'NgTableParams', 'ProductService', 'Authentication', 'FhdMessenger', function ($filter, $state, Products, NgTableParams, ProductService, Authentication, FhdMessenger) {
  const vm = this;
  const user = Authentication.user;

  if (_.intersection(user.roles, ['admin', 'product:view-cogs']).length === 0) {
    return $state.go('home');
  }

  vm.productsData = new NgTableParams({
    count: 50
  });
  const regions = ['NORTH', 'CENTRAL', 'SOUTH'];
  vm.regions = regions;
  vm.regionMap = {
    NORTH: {
      value: true
    },
    CENTRAL: {
      value: false
    },
    SOUTH: {
      value: false
    }
  };

  function indexCol($scope, row, rowIndex) {
    return `<span>${rowIndex + 1}</span>`;
  }

  function normalValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${_.get(row, vm.field) || ''}</span>`;
  }

  function numberValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field, '');

    if (!value) {
      return '';
    }

    return `<span>${$filter('number')(value, 0)}</span>`;
  }

  const props = ['cogs', 'price', 'salePrice'];
  vm.infoCols = [{
    title: 'STT',
    show: true,
    getValue: indexCol
  }, {
    field: 'sku',
    title: 'SKU',
    sortable: 'sku',
    filter: {
      sku: 'text'
    },
    show: true,
    getValue: normalValue
  }, {
    field: 'description',
    title: 'Description',
    sortable: 'description',
    filter: {
      description: 'text'
    },
    show: true,
    getValue: normalValue
  }];

  _.forEach(regions, region => {
    const lowerRegion = region.toLowerCase();

    _.forEach(props, prop => {
      const productProp = _.camelCase(lowerRegion + ' ' + prop); // console.log(productProp)


      const colObject = {
        field: productProp,
        title: region + ' ' + prop.toUpperCase(),
        sortable: productProp,
        show: () => {
          return vm.regionMap[region].value;
        },
        getValue: numberValue
      };
      colObject.filter = {};
      colObject.filter[productProp] = 'number';
      vm.infoCols.push(colObject);
    });
  });

  vm.exportFile = function (regionMap) {
    if (!user.roles.includes('product:export') && !user.roles.includes('admin')) {
      return FhdMessenger.error('Bạn không có quyền dùng chức năng này');
    }

    let products = _.filter(vm.products, product => {
      return _.get(product, 'sku', '').match(/B\d+/);
    });

    const listPriceProducts = _.map(products, function (product) {
      const row = {
        sku: product.sku,
        description: product.description
      };

      if (regionMap.NORTH.value) {
        row.northCOGs = product.northCogs;
        row.northPrice = product.northPrice;
        row.northSalePrice = product.northSalePrice;
      }

      if (regionMap.CENTRAL.value) {
        row.centralCOGS = product.centralCogs;
        row.centralPrice = product.centralPrice;
        row.centralSalePrice = product.centralSalePrice;
      }

      if (regionMap.SOUTH.value) {
        row.southCOGS = product.southCogs;
        row.southPrice = product.southPrice;
        row.southSalePrice = product.southSalePrice;
      }

      return row;
    });

    const now = moment().startOf('day').format('YYYY-MM-DD');
    alasql(`SELECT * INTO XLSX("stocks-${now}.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [listPriceProducts]);
  };

  vm.getProducts = () => {
    vm.products = Products.query({
      select: 'sku description cogs price salePrice regionAttributes'
    });
    vm.products.$promise.then(data => {
      // filter product has region = SOUTH
      data.forEach(product => {
        _.forEach(regions, region => {
          const lowerRegion = region.toLowerCase();

          _.forEach(props, prop => {
            const productProp = _.camelCase(lowerRegion + ' ' + prop);

            const outlet = {
              region
            };
            product[productProp] = ProductService.getOutletProperty(prop, outlet, product); // if (prop === 'cogs') {
            //   console.log(product[productProp], productProp)
            // }
          });
        });
      });
      vm.productsData.settings({
        dataset: data
      });
    });
  };
}]);
"use strict";

angular.module('products').controller('ListProductsWithInventoryLocationsController', ['FhdMessenger', 'Products', 'NgTableParams', 'InventoryLocations', 'Authentication', 'ProductService', 'StockMap', '$scope', '$timeout', '$http', function (FhdMessenger, Products, NgTableParams, InventoryLocations, Authentication, ProductService, StockMap, $scope, $timeout, $http) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {};
  vm.data.inventoryLocations = InventoryLocations.query();
  vm.sheetLinks = [];
  vm.productsTable = new NgTableParams({
    count: 5
  });

  vm.find = () => {
    vm.products = Products.producstWithLocation();
    vm.products.$promise.then(() => {
      vm.productsTable.settings({
        dataset: vm.products
      });
    });
  };

  function exportFile() {
    const depot1AndDepot2Products = _.filter(vm.products, product => {
      if (!product.lastInventoryLocation) return false;
      return ['Depot 5', 'Depot 2', 'Depot 4'].includes(product.lastInventoryLocation.warehouse) && product.stockKho > 0;
    });

    const groupByDepot = _.groupBy(depot1AndDepot2Products, 'lastInventoryLocation.warehouse');

    const dataTest = {};

    _.forEach(groupByDepot, (depot, depotName) => {
      const groupByArea = _.groupBy(depot, 'lastInventoryLocation.area');

      _.forEach(groupByArea, (area, areaName) => {
        dataTest[depotName + '_' + areaName] = dataTest[depotName + '_' + areaName] || {};
        dataTest[depotName + '_' + areaName] = area;
      });
    });

    const depotRandomProducts = {};
    const randomProductQuantity = 50;

    _.forEach(dataTest, (products, destination) => {
      depotRandomProducts[destination] = _.take(_.shuffle(products), randomProductQuantity);
    });

    let exportRawData = {};
    exportRawData['Depot 5'] = [];
    exportRawData['Depot 2'] = [];
    exportRawData['Depot 4'] = [];

    _.forEach(depotRandomProducts, (productByDestination, destination) => {
      if (_.startsWith(destination, 'Depot 5')) {
        exportRawData['Depot 5'] = [...exportRawData['Depot 5'], ...productByDestination];
      }

      if (_.startsWith(destination, 'Depot 2')) {
        exportRawData['Depot 2'] = [...exportRawData['Depot 2'], ...productByDestination];
      }

      if (_.startsWith(destination, 'Depot 4')) {
        exportRawData['Depot 4'] = [...exportRawData['Depot 4'], ...productByDestination];
      }
    });

    const exportData = [{
      depotName: 'Depot 5',
      depotCode: 'D5',
      data: []
    }, {
      depotName: 'Depot 2',
      depotCode: 'D2',
      data: []
    }, {
      depotName: 'Depot 4',
      depotCode: 'D4',
      data: []
    }];
    let row = [];

    _.forEach(exportRawData, (depot, depotName) => {
      const exportDepotData = _.find(exportData, {
        depotName: depotName
      });

      _.forEach(depot, (product, index) => {
        const sku = _.get(product, 'sku');

        const description = _.get(product, 'description');

        const warehouse = _.get(product, 'lastInventoryLocation.warehouse');

        const area = _.get(product, 'lastInventoryLocation.area');

        const section = _.get(product, 'lastInventoryLocation.section');

        const level = _.get(product, 'lastInventoryLocation.level');

        const code = _.get(product, 'lastInventoryLocation.code');

        const stockKho = _.get(product, 'stockKho');

        row.push(index + 1);
        row.push(sku);
        row.push(description);
        row.push(warehouse);
        row.push(area);
        row.push(section);
        row.push(level);
        row.push(code);
        row.push(stockKho);
        exportDepotData.data.push(row);
        row = [];
      });
    });

    const sheetCols = ['STT', 'SKU', 'Description', 'Kho', 'Khu vực', 'Giá', 'Tầng', 'Code', 'Stock Kho'];
    Promise.each(exportData, async depot => {
      const promise = await $http.post('/sheet', {
        sheetTitle: 'Random 50 sản phẩm mỗi tầng ở kho ' + depot.depotCode,
        sheetCols: sheetCols,
        sheetData: depot.data
      });
      const sheetLink = 'https://docs.google.com/spreadsheets/d/' + promise.data.data.spreadsheetId;
      vm.sheetLinks.push(sheetLink);
    });
  }

  vm.exportFile = () => {
    const hasStockKho = _.some(vm.products, 'stockKho');

    if (hasStockKho) {
      exportFile();
    } else {
      vm.waiting = true;
      let promise = getStock().then(res => {
        exportFile();
      }).finally(() => {
        vm.waiting = false;
      });
      FhdMessenger.notifyLoading('Đang tải...', promise, () => {
        FhdMessenger.success('Đã tải xong');
      });
    }
  };

  function getStock() {
    return StockMap.getStockMapCache().then(data => {
      const stockMap = data;

      _.forEach(vm.products, product => {
        const matchProduct = _.get(stockMap, product._id);

        product.stockKho = _.get(matchProduct, 'D5', 0) + _.get(matchProduct, 'D2', 0) + _.get(matchProduct, 'D3', 0) + _.get(matchProduct, 'D4', 0) + _.get(matchProduct, 'D7', 0);
      });
    });
  }

  vm.findCurrentStock = () => {
    vm.waiting = true;
    let promise = getStock().finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải Stock của sản phẩm...', promise, () => {
      FhdMessenger.success('Đã tải xong Stock.');
    });
  };

  vm.startChangeLocation = product => {
    product.changingLocation = !product.changingLocation;
  };

  vm.selectLocation = (product, inventoryLocation) => {
    product.newLocation = inventoryLocation;
    product.$addLocation().then(products => {
      $timeout(() => {
        angular.element('#productSearch').focus();
      }, 500);
      FhdMessenger.success('Ok');
    }).catch(FhdMessenger.errorFromServer);
    product.changingLocation = false;
  };

  vm.openInventoryLocationHistory = ProductService.openInventoryLocationHistory;

  vm.productSelected = product => {
    const matchProduct = _.find(vm.products, {
      sku: product.sku
    });

    if (matchProduct) {
      matchProduct.changingLocation = true;
      vm.productsTable.reload();
      vm.productsTable.filter()['sku'] = matchProduct.sku;
      $timeout(() => {
        angular.element(`#change-location-${matchProduct.sku}`).focus();
      }, 500);
    }
  };

  vm.toggleEditMode = () => {
    const action = vm.allowEditLocation ? 'tắt' : 'bật';
    FhdMessenger.success(`Đã ${action}`);
  };
}]);
'use strict';

angular.module('products').controller('ListSavorFoodProductsController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'Products', 'ProductService', function (Authentication, FhdMessenger, NgTableParams, Products, ProductService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.products = [];
  vm.listSavorFoodProductTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    let promise = Products.listSavorProducts({
      businessCode: 'SAVOR',
      getSavorFood: true,
      select: '_id sku description bundledProducts defaultModifiers'
    }).$promise.then(products => {
      _.forEach(products, product => {
        _.forEach(product.defaultModifiers, defaultModifier => {
          let quantity = 1;

          if (product.description && product.description.match(/Bánh mì.*(to)/)) {
            quantity = defaultModifier.normalQuantity;
          }

          if (product.description && product.description.match(/Bánh mì.*(nhỏ)/)) {
            quantity = defaultModifier.miniQuantity;
          }

          defaultModifier.quantity = quantity;
        });
      });

      vm.products = products;
      vm.listSavorFoodProductTable.settings({
        dataset: vm.products
      });
    });
    FhdMessenger.notifyLoading('Đang tải danh sách...', promise, () => {
      FhdMessenger.success('Đã tải xong.');
    });
  };
}]);
'use strict';

