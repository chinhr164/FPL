angular.module('shift-records').factory('CurrentShift', ['$http', 'toaster', '$q', '$modal', '$state', 'UserService', 'OutletService', '$localStorage', '$window', 'geolocationSvc', function ($http, toaster, $q, $modal, $state, UserService, OutletService, $localStorage, $window, geolocationSvc) {
  var currentShift = {};
  var localCurrentShift = $localStorage.getObject('currentShift');

  if (localCurrentShift && localCurrentShift.shiftRecordId) {
    currentShift = localCurrentShift;
  } else {
    currentShift = {
      shiftRecordId: 'Choose Current Shift',
      _id: null
    };
  }

  function setCurrentShift(shiftRecord) {
    currentShift = shiftRecord;
    currentShift.staffs = UserService.addFullDescription(currentShift.staffs);
    $state.reload();
  }

  function processNewShiftRecord(shiftRecord) {
    _.assign(shiftRecord, {
      staffs: UserService.generateStaffsFromIds(shiftRecord.staffs),
      outlet: OutletService.getFromId(shiftRecord.outlet)
    });
  } // Public API


  return {
    createShiftRecord: function (shiftRecord) {
      return $q(function (resolve, reject) {
        geolocationSvc.getCurrentPosition().then(function (position) {
          _.forEach(shiftRecord.employees, employee => {
            employee.lat = _.get(position, 'coords.latitude');
            employee.lng = _.get(position, 'coords.longitude');
          });

          $http.post('/shift-records', shiftRecord).success(function (response) {
            processNewShiftRecord(response);
            setCurrentShift(response);
            resolve(response);
          }).error(function (error) {
            reject(error);
          });
        });
      });
    },
    loginCalendar: function (data) {
      return $q(function (resolve, reject) {
        toaster.info('Đang đăng nhập trên website');
        geolocationSvc.getCurrentPosition().then(function (position) {
          data.lat = _.get(position, 'coords.latitude');
          data.lng = _.get(position, 'coords.longitude');
          $http.put('/calendar-entries/login-calendar', data).success(function (response) {
            resolve(response);
            toaster.success('Ok!');
          }).error(function (error) {
            reject(error);
          });
        });
      });
    },
    checkShiftRecord: function (shiftInfo) {
      if (!shiftInfo.outlet || !shiftInfo.shift || !shiftInfo.date) return toaster.error('Thiếu thông tin về ca trực');
      return $q(function (resolve, reject) {
        geolocationSvc.getCurrentPosition().then(function (position) {
          const params = _objectSpread({}, shiftInfo, {
            lat: _.get(position, 'coords.latitude'),
            lng: _.get(position, 'coords.longitude')
          });

          toaster.info('Đang kiểm tra lịch trực trên website...');
          $http({
            url: '/shift-records/check',
            method: 'GET',
            params
          }).success(function (response) {
            if (response.exists === true) {
              toaster.success('Ok!');
              setCurrentShift(response.shiftRecord);
            } else {
              toaster.info('Hãy điền đầy đủ thông tin về ca trực này.');
            }

            resolve(response);
          }).error(function (error) {
            reject(error);
          });
        });
      });
    },
    currentShiftModal: function () {
      var currentShiftModal = $modal.open({
        animation: true,
        templateUrl: 'modules/shift-records/views/modal-current-shift.client.view.html',
        controller: 'ModalCurrentShiftController',
        controllerAs: 'vm'
      });
      return currentShiftModal;
    },
    openConfirmRemoveShiftRecordModal: function () {
      return $modal.open({
        animation: true,
        templateUrl: 'modules/shift-records/views/modal-confirm-remove-shift-record.client.view.html',
        controller: 'ModalConfirmRemoveShiftRecordController',
        controllerAs: 'vm' // resolve: {
        //   currentShift: () => currentShift,
        // },

      }).result;
    },
    setCurrentShift: setCurrentShift,
    newShiftRecord: function (shiftRecord) {
      return {
        outlet: shiftRecord.outlet._id || shiftRecord.outlet,
        date: shiftRecord.date,
        shift: shiftRecord.shift.code || shiftRecord.shift,
        staffs: shiftRecord.staffs ? _.map(shiftRecord.staffs, function (staff) {
          return staff._id || staff;
        }) : undefined,
        employees: shiftRecord.staffs ? _.reduce(shiftRecord.staffs, (result, staff) => {
          if (staff.came) {
            result.push({
              staff: staff._id || staff,
              came: new Date()
            });
          }

          return result;
        }, []) : undefined,
        initialPettyCash: shiftRecord.initialPettyCash
      };
    },
    getCurrentShift: function () {
      return currentShift;
    },
    resetCurrentShift: function () {
      $localStorage.setObject('currentShift', {});
      $window.location.reload();
    }
  };
}]);
'use strict'; // Shift records service used to communicate Shift records REST endpoints

angular.module('shift-records').factory('ShiftRecords', ['$resource', function ($resource) {
