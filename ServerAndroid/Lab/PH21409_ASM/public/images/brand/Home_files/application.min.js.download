angular.module('warehouse-groups').controller('WarehouseGroupsController', ['$scope', '$stateParams', '$location', 'Authentication', 'WarehouseGroups', 'FhdMessenger', 'NgTableParams', 'Products', function ($scope, $stateParams, $location, Authentication, WarehouseGroups, FhdMessenger, NgTableParams, Products) {
  const vm = this;
  vm.authentication = Authentication;
  vm.isAdmin = _.includes(_.get(Authentication, 'user.roles'), 'admin'); // Create new Warehouse group

  vm.create = function () {
    // Create new Warehouse group object
    const warehouseGroup = new WarehouseGroups({
      name: vm.name,
      order: vm.order
    }); // Redirect after save

    warehouseGroup.$save().then(response => {
      $location.path(`warehouse-groups/${response._id}`); // Clear form fields

      vm.name = '';
    }).catch(FhdMessenger.errorFromServer);
  }; // Remove existing Warehouse group


  vm.remove = function (warehouseGroup) {
    if (warehouseGroup) {
      warehouseGroup.$remove();

      const warehouseGroupIndex = _.findIndex(vm.warehouseGroups, {
        _id: warehouseGroup._id
      });

      vm.warehouseGroups.splice(warehouseGroupIndex, 1);
    } else {
      vm.warehouseGroup.$remove(function () {
        $location.path('warehouse-groups');
      });
    }
  }; // Update existing Warehouse group


  vm.update = function () {
    const warehouseGroup = vm.warehouseGroup;
    warehouseGroup.$update(function () {
      $location.path(`warehouse-groups/${warehouseGroup._id}`);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.warehouseGroupsTable = new NgTableParams({
    count: 1000
  }); // Find a list of Warehouse groups

  vm.find = function () {
    vm.warehouseGroups = WarehouseGroups.query();
    vm.warehouseGroups.$promise.then(warehouseGroups => {
      vm.warehouseGroupsTable.settings({
        dataset: warehouseGroups
      });
      vm.warehouseGroupsTable.sorting({
        order: 'asc'
      });
    });
  }; // Find existing Warehouse group


  vm.findOne = function () {
    vm.warehouseGroup = WarehouseGroups.get({
      warehouseGroupId: $stateParams.warehouseGroupId
    });
  };

  vm.productsTable = new NgTableParams({
    count: 50
  });

  vm.getProducts = function () {
    vm.products = Products.query({
      warehouseGroup: $stateParams.warehouseGroupId
    });
    vm.products.$promise.then(products => {
      vm.productsTable.settings({
        dataset: products
      });
    });
  };
}]);
"use strict";

