function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('licenses').controller('CreateLicenseController', ['Licenses', 'Authentication', 'ConfirmModal', 'FhdMessenger', 'ProductService', '$location', 'LicensesService', 'helper', function (Licenses, Authentication, ConfirmModal, FhdMessenger, ProductService, $location, LicensesService, helper) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.license = {};
  vm.license.outlet = null;
  vm.cleanTarget = LicensesService.cleanTarget;
  vm.removeValueFromArray = helper.removeValueFromArray;

  vm.init = () => {
    vm.license.source = 'Chưa chọn';
    LicensesService.getTypes().then(data => {
      vm.data.licenseTypes = data;
    });
    ProductService.getProductWithSpecialSku().then(products => {
      vm.data.amisProducts = _.reduce(_.groupBy(_.filter(products, 'amisSku'), 'amisSku'), (result, _products) => {
        const firstProduct = _.head(_products);

        result.push({
          sku: firstProduct.amisSku,
          description: firstProduct.amisDescription,
          products: _products
        });
        return result;
      }, []);
    });
    vm.data.licenseTargets = LicensesService.getTargets();
  };

  function between(x, min, max) {
    return x >= min && x <= max;
  }

  vm.searchBySpecialSku = product => {
    const products = product.products;

    if (!products.length) {
      return FhdMessenger.error('Không tìm thấy sản phẩm nào với mã ' + product.sku);
    }

    _.forEach(products, product => {
      vm.productSearchSelected(product);
    });
  };

  vm.productSearchSelected = product => {
    vm.license.products = vm.license.products || [];

    const matchProduct = _.find(vm.license.products, {
      sku: product.sku
    });

    if (matchProduct) {
      return FhdMessenger.error(`Đã có sản phẩm ${product.sku} - ${product.description} trong danh sách`);
    }

    vm.license.products.push({
      product: product._id,
      sku: product.sku,
      description: product.description
    });
  };

  vm.createLicenseCode = () => {
    if (_.isUndefined(vm.bookId) || _.isUndefined(vm.pageId)) {
      return;
    }

    if (!between(vm.bookId, 1, 99)) {
      vm.license.code = null;
      return FhdMessenger.error('Mã số quyển phải trong khoảng 1 đến 99');
    }

    if (!between(vm.pageId, 1, 99)) {
      vm.license.code = null;
      return FhdMessenger.error('Mã số trang phải trong khoảng 1 đến 99');
    }

    vm.license.code = `L${helper.addLeadZero(vm.bookId, 2)}${helper.addLeadZero(vm.pageId, 2)}`;
  };

  vm.create = async function () {
    vm.license.tags = _.uniq(vm.license.tags);
    const error = LicensesService.validate(vm.license);

    if (error) {
      return FhdMessenger.error(error);
    }

    if (vm.license.hasNoEndDate) {
      delete vm.license.endDate;
    }

    vm.license.status = _.get(vm.license, 'keeperStaff.code', '') !== 'D703' ? 'on-loan' : 'free';
    const license = new Licenses(_objectSpread({}, vm.license));

    if (_.get(license, 'products.length')) {
      vm.waiting = true;

      const skus = _.map(license.products, 'sku');

      const duplicateLicenses = await Licenses.checkDuplicateByProduct({
        skus
      }).$promise.then(licenses => {
        return licenses;
      });
      vm.waiting = false;

      if (duplicateLicenses.length) {
        ConfirmModal.showModal({}, {
          bodyText: `Giấy tờ bạn vừa tạo có sản phẩm trùng với giấy tờ ${_.map(duplicateLicenses, 'code').join(' - ')}?`,
          actionButtonText: 'Đồng ý',
          closeButtonText: 'Kiểm tra lại'
        }).then(() => {
          create(license);
        });
      } else {
        create(license);
      }
    } else {
      create(license);
    }
  };

  function create(license) {
    vm.waiting = true;
    license.$save().then(() => {
      FhdMessenger.success('Tạo License thành công');
      $location.path('licenses');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  }
}]);
"use strict";

angular.module('licenses').controller('ExchangeLicenseController', ['Licenses', '$stateParams', 'Authentication', 'NgTableParams', 'FhdMessenger', '$state', function (Licenses, $stateParams, Authentication, NgTableParams, FhdMessenger, $state) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.transaction = {
    user: vm.user
  };

  vm.findOne = async () => {
    vm.license = Licenses.get({
      licenseId: $stateParams.licenseId
    }).$promise.then(license => {
      vm.license = license;
      vm.licensesLoanHistoryTable.settings({
        dataset: license.transactionHistories
      });
      vm.transaction.type = license.status === 'free' ? 'lent' : 'returned';
    });
  };

  vm.licensesLoanHistoryTable = new NgTableParams({
    count: 50,
    sorting: {
      time: 'desc'
    }
  });

  function getIndex(scope, transaction, column, field) {
    return `<span>${field + 1}</span>`;
  }

  function normalValue(scope, transaction, column) {
    const value = _.get(transaction, column.field, '');

    return `<span>${value}</span>`;
  }

  function transactionTypeContent(scope, transaction, column) {
    const type = transaction[column.field];
    const types = {
      lent: {
        title: 'Mượn',
        label: 'label-primary'
      },
      returned: {
        title: 'Trả',
        label: 'label-success'
      }
    };
    return `<span class="label ${types[type].label}">${types[type].title}</span>`;
  }

  function staffContent(scope, transaction, column) {
    const staff = transaction[column.field];
    return `<span>${staff.code} ${staff.displayName}</span>`;
  }

  function dateContent(scope, transaction, column) {
    const date = transaction[column.field];
    return `<span>${moment(date).format(column.formatDate)}</span>`;
  }

  vm.columns = [{
    field: '$index',
    title: 'STT',
    show: true,
    getValue: getIndex
  }, {
    field: 'type',
    title: 'Kiểu',
    show: true,
    getValue: transactionTypeContent
  }, {
    field: 'reason',
    title: 'Lý do',
    filter: {
      reason: 'text'
    },
    show: true,
    getValue: normalValue
  }, {
    field: 'receiver',
    title: 'Người nhận',
    filter: {
      'receiver.displayName': 'text'
    },
    show: true,
    getValue: staffContent
  }, {
    field: 'transactionDate',
    sortable: 'transactionDate',
    title: 'Thời gian mượn/trả',
    show: true,
    formatDate: 'YYYY/MM/DD hh:mm',
    getValue: dateContent
  }, {
    field: 'time',
    sortable: 'time',
    title: 'Thời gian tạo',
    show: true,
    formatDate: 'YYYY/MM/DD',
    getValue: dateContent
  }];

  vm.lent = () => {
    if (!vm.transaction.transactionDate) {
      return FhdMessenger.error('Chưa có thời gian mượn');
    }

    if (!vm.transaction.receiver) {
      return FhdMessenger.error('Chưa có nhân nhân viên nhận tài liệu');
    }

    if (!_.trim(vm.transaction.reason)) {
      return FhdMessenger.error('Chưa điền lý do');
    }

    if (!vm.transaction.expectedReturnDate) {
      return FhdMessenger.error('Chưa có ngày trả dự kiến');
    }

    if (moment(vm.transaction.transactionDate).isAfter(vm.transaction.expectedReturnDate)) {
      return FhdMessenger.error('Thời gian dự kiến trả phải lớn hơn thời gian mượn');
    }

    vm.license.transaction = vm.transaction;
    vm.waiting = true;
    vm.license.$lent().then(() => {
      FhdMessenger.success('Mượn thành công');
      $state.reload();
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.returned = () => {
    if (!vm.transaction.transactionDate) {
      return FhdMessenger.error('Chưa có thời gian trả');
    }

    if (!vm.transaction.receiver) {
      return FhdMessenger.error('Chưa có nhân nhân viên nhận tài liệu');
    }

    vm.license.transaction = vm.transaction;
    vm.waiting = true;
    vm.license.$returned().then(() => {
      FhdMessenger.success('Trả thành công');
      $state.reload();
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('licenses').controller('ImportLicensesController', ['Authentication', 'FhdMessenger', '$http', '$location', '$state', 'Licenses', 'LicensesService', 'ConfirmModal', 'helper', function (Authentication, FhdMessenger, $http, $location, $state, Licenses, LicensesService, ConfirmModal, helper) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  LicensesService.getTypes().then(data => {
    vm.allTypes = data;
    vm.licenseMap = helper.makeMap(data, 'id');
  });
  vm.requireFields = 'content startDate'.split(' ');

  function isAllValidField(field) {
    return _.some(vm.rawItems, item => {
      return !_.get(item, field);
    });
  }

  function validateItems() {
    let errors = [];

    if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('licenses:create')) {
      errors.push('Bạn không có quyền import');
      return errors;
    }

    if (_.some(vm.rawItems, rawItem => {
      return _.compact([rawItem.outletCode, rawItem.vendorCode, rawItem.userCode]).length !== 1;
    })) {
      errors.push('Mỗi license cần phải có MỘT mã (outletCode / vendorCode / userCode) tương ứng');
    }

    if (_.some(vm.rawItems, item => {
      return _.isUndefined(_.find(vm.allTypes, type => {
        return type.id === item.type || type.title === item.type;
      }));
    })) {
      errors.push('Kiểm tra lại type nhé, bạn chưa điền hoặc điền chưa chính xác rồi');
      return errors;
    }

    _.forEach(vm.requireFields, requireField => {
      if (isAllValidField(requireField)) {
        errors.push(`Bạn chưa điền đủ ${requireField}`);
      }
    });

    return errors;
  }

  vm.import = () => {
    if (!vm.rawItems) {
      return;
    }

    const errors = validateItems();

    if (errors.length) {
      _.forEach(errors, err => {
        return FhdMessenger.error(err);
      });

      return;
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ import ${vm.rawItems.length} licenses?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      Licenses.import({
        rawItems: vm.rawItems,
        allTypes: vm.allTypes
      }).$promise.then(licenses => {
        vm.licenses = licenses;
        return FhdMessenger.success(`Import ${licenses.length} Licenses thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

// 'use strict'
angular.module('licenses').controller('LicensesController', ['helper', 'Authentication', 'ConfirmModal', 'Licenses', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'OutletService', 'LicensesService', '$window', '$modal', function (helper, Authentication, ConfirmModal, Licenses, FhdMessenger, NgTableParams, ObjectId, OutletService, LicensesService, $window, $modal) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.data.licenseTypes = LicensesService.getTypes();
  vm.data.statuses = LicensesService.getStatuses();
  vm.data.targets = LicensesService.getTargets();
  vm.data.expiredTypes = LicensesService.getExpiredTypes();
  vm.removeValueFromArray = helper.removeValueFromArray;

  function checkExpired(license) {
    const now = moment();
    const isExpired = !license.hasNoEndDate && moment(license.endDate).endOf('day').isBefore(now);
    return isExpired;
  }

  function processTargetValue(licenses) {
    _.forEach(licenses, license => {
      license.targetValue = LicensesService.filterTargetValue(license, license.target);
    });
  }

  function processShowButton(licenses) {
    _.forEach(licenses, license => {
      license.showEdit = vm.canEdit();
      license.showDelete = vm.canDelete(license);
      license.showLost = vm.canChangeLost(license);
      license.showArchived = vm.canChangeArchived(license);
    });
  }

  function processIsExpired(licenses) {
    _.forEach(licenses, license => {
      license.isExpired = checkExpired(license);
    });
  }

  function countLicenseByStatus(licenses, status) {
    return _.filter(licenses, license => {
      return license.status === status;
    }).length;
  }

  vm.joinOutletCodes = outletCodes => {
    if (!_.get(outletCodes, 'length')) {
      return '';
    }

    return helper.sortByProperty(outletCodes).join(', ');
  };

  function getBusinessRegistrationMap(licenses) {
    const availableLicenses = _.filter(licenses, license => {
      return _.get(license, 'outlet.code') && ['free', 'on-loan'].includes(license.status) && _.get(license, 'licenseType.name') === 'ĐKKD';
    });

    const hasLicenseOutletCodes = _.map(availableLicenses, 'outlet.code');

    if (hasLicenseOutletCodes.includes('S2')) {
      hasLicenseOutletCodes.push('E9');
    }

    if (hasLicenseOutletCodes.includes('S16')) {
      hasLicenseOutletCodes.push('E14');
    }

    if (hasLicenseOutletCodes.includes('S10')) {
      hasLicenseOutletCodes.push('E24');
    }

    return OutletService.allAsync().then(outlets => {
      vm.businessRegistrationMap = _.reduce(outlets, (result, outlet) => {
        if (!outlet.isPos || outlet.deleted) {
          return result;
        }

        if (!['SOUTH', 'NORTH'].includes(outlet.region)) {
          return result;
        }

        if (!hasLicenseOutletCodes.includes(outlet.code)) {
          result['Chưa có'].push(outlet.code);
        }

        return result;
      }, {
        'Chưa có': [],
        'Đã có': hasLicenseOutletCodes
      });
    });
  }

  vm.find = () => {
    vm.licensesTable = new NgTableParams({
      count: 50
    });
    Licenses.query().$promise.then(licenses => {
      vm.licenses = licenses;
      processIsExpired(licenses);
      processTargetValue(licenses);
      processShowButton(licenses);
      getBusinessRegistrationMap(licenses);
      vm.licensesTable.settings({
        dataset: vm.licenses
      });
      vm.licensesTable.filter()['status'] = 'free';
      vm.totalFree = countLicenseByStatus(licenses, 'free');
      vm.totalOnLoan = countLicenseByStatus(licenses, 'on-loan');
      vm.totalLost = countLicenseByStatus(licenses, 'lost');
      vm.totalArchived = countLicenseByStatus(licenses, 'archived');
      vm.totalExpired = _.filter(licenses, license => {
        return license.isExpired && license.status !== 'disabled';
      }).length;
      vm.totalUnexpired = _.filter(licenses, license => {
        return !license.isExpired && license.status !== 'disabled';
      }).length;
      vm.total = _.reject(licenses, {
        status: 'disabled'
      }).length;
    });
  };

  vm.canDelete = license => {
    return _.intersection(vm.user.roles, ['admin', 'licenses:remove']).length && license.status !== 'disabled';
  };

  vm.canEdit = () => {
    return _.intersection(vm.user.roles, ['admin', 'licenses:edit']).length;
  };

  vm.canChangeLost = license => {
    return _.intersection(vm.user.roles, ['admin', 'licenses:edit']).length && !['lost', 'disabled'].includes(license.status);
  };

  vm.canChangeArchived = () => {
    return _.intersection(vm.user.roles, ['admin', 'licenses:edit']).length;
  };

  function normalValue(scope, row) {
    const vm = this;

    let value = _.get(row, vm.field);

    if (!value) {
      value = 'Khác';
    }

    return `<span>${value}</span>`;
  }

  function statusValue(scope, license, col) {
    const statusMap = {
      free: {
        title: 'Bảo quản',
        label: 'label-primary'
      },
      'on-loan': {
        title: 'Đã được mượn',
        label: 'label-success'
      },
      disabled: {
        title: 'Đã xóa',
        label: 'label-default'
      },
      lost: {
        title: 'Thất lạc',
        label: 'label-warning'
      },
      archived: {
        title: 'Lưu trữ',
        label: 'label-info'
      }
    };

    const status = _.get(statusMap, _.get(license, col.field));

    return `<span class="label ${status.label}">${status.title}</span>`;
  }

  function dateValue(scope, row) {
    const vm = this;

    let value = _.get(row, vm.field);

    if (!value) {
      return `<span>Infinite</span>`;
    }

    return `<span>${moment(value).format('DD/MM/YYYY')}</span>`;
  }

  function staffValue(scope, row) {
    const vm = this;

    let value = _.get(row, vm.field);

    if (!value) {
      value = 'Khác';
    }

    return `<span>${value.code}</span>`;
  }

  function codeValue(scope, row) {
    const vm = this;

    let value = _.get(row, vm.field);

    if (!value) {
      value = 'Khác';
    }

    const {
      files,
      images
    } = row;
    let content = `<a target="_blank" ui-sref="viewLicense({licenseId: '${row._id}'})">${value}</a>`;

    if (files.length || images.length) {
      content += `&nbsp<span
        class="glyphicon glyphicon-check text-success"
      ></span>`;
    }

    return `<span style="display: flex">${content}</span>`;
  }

  function typeValue(scope, row) {
    const vm = this;

    const licenseType = _.get(row, vm.field);

    return `<span>${_.get(licenseType, 'name')}</span>`;
  }

  function targetValue(scope, row) {
    const vm = this;

    const targetValue = _.get(row, vm.field);

    return `<span>${targetValue}</span>`;
  }

  function expiredValue(scope, row) {
    const expiredMap = {
      true: {
        title: 'Hết hạn',
        label: 'label-primary'
      },
      false: {
        title: 'Còn hạn',
        label: 'label-success'
      }
    };
    const vm = this;

    const isExpired = _.get(expiredMap, _.get(row, vm.field));

    return `<span class="label ${isExpired.label}">${isExpired.title}</span>`;
  }

  function actionValue(scope, license) {
    let text = `<div class="text-center">`;

    if (license.showEdit) {
      text += `<a ng-click="vm.openUpdateLicense(row)">Sửa</a>|`;
    }

    if (license.showDelete) {
      text += `<a ng-click="vm.delete(row)" >Xóa</a>|`;
    }

    if (license.showLost) {
      text += `<a ng-click="vm.lost(row)">Thất lạc</a>|`;
    }

    if (license.showArchived) {
      text += `<a ng-click="vm.archived(row)">Lưu trữ</a>`;
    }

    text += `</div>`;
    return text;
  }

  vm.columns = [{
    field: '$index',
    title: 'STT',
    show: true,
    getValue: (scope, license, column, index) => {
      return `<span>${index + 1}</span>`;
    }
  }, {
    field: 'code',
    title: 'Code',
    sortable: 'code',
    filter: {
      code: 'text'
    },
    show: true,
    getValue: codeValue
  }, {
    field: 'status',
    title: 'Trạng thái',
    sortable: 'status',
    filter: {
      status: 'select'
    },
    filterData: vm.data.statuses,
    show: true,
    getValue: statusValue
  }, {
    field: 'licenseType',
    title: 'Thể loại',
    sortable: 'type',
    filter: {
      'licenseType.slug': 'select'
    },
    filterData: vm.data.licenseTypes,
    show: true,
    getValue: typeValue
  }, {
    field: 'isExpired',
    title: 'Hạn',
    sortable: 'isExpired',
    filter: {
      isExpired: 'select'
    },
    filterData: vm.data.expiredTypes,
    show: true,
    getValue: expiredValue
  }, {
    field: 'targetValue',
    title: 'Đối tượng',
    sortable: 'targetValue',
    filter: {
      targetValue: 'text'
    },
    show: true,
    getValue: targetValue
  }, {
    field: 'content',
    title: 'Nội dung',
    filter: {
      content: 'text'
    },
    show: true,
    getValue: normalValue
  }, {
    field: 'startDate',
    title: 'Ngày bắt đầu',
    sortable: 'startDate',
    show: true,
    getValue: dateValue
  }, {
    field: 'endDate',
    title: 'Ngày kết thúc',
    sortable: 'endDate',
    show: true,
    getValue: dateValue
  }, {
    field: 'keeperStaff',
    title: 'Nhân viên giữ',
    show: true,
    filter: {
      'keeperStaff.displayName': 'text'
    },
    getValue: staffValue
  }, {
    title: 'Action',
    show: true,
    getValue: actionValue
  }];
  vm.openUpdateLicense = LicensesService.openUpdateLicense;

  vm.lost = license => {
    if (['disabled', 'lost'].includes(license.status)) {
      return FhdMessenger.error('Không thể báo thất lạc license đã bị xóa');
    }

    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Chuyển trạng thái thất lạc cho ${license.content}`,
      bodyText: `Bạn chắc chắn muốn chuyển trạng thái thất lạc`
    }).then(() => {
      vm.waiting = true;
      license.$lost().then(() => {
        FhdMessenger.success('Chuyển trạng thái thất lạc thành công');
        vm.licensesTable.reload();
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.archived = license => {
    if (['disabled', 'lost'].includes(license.status)) {
      return FhdMessenger.error('Không thể lưu trữ license đã bị xóa');
    }

    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Chuyển trạng thái lưu trữ cho: ${license.content}`,
      bodyText: `Bạn chắc chắn muốn chuyển trạng thái lưu trữ`
    }).then(() => {
      vm.waiting = true;
      license.$archived().then(() => {
        FhdMessenger.success('Chuyển trạng thái lưu trữ thành công');
        vm.licensesTable.reload();
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.delete = license => {
    if (license.status === 'disabled') {
      return FhdMessenger.error('Không thể xóa license đã có trạng thái đã xóa');
    }

    const disabledReason = $window.prompt(`Vui lòng nhập lý do xóa: `);

    if (!_.trim(disabledReason)) {
      return FhdMessenger.error('Bạn chưa nhập lý do xóa');
    }

    license.disabledReason = disabledReason;
    vm.waiting = true;
    license.$softRemove().then(() => {
      FhdMessenger.success('Xóa thành công');
      vm.licensesTable.reload();
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('licenses').controller('ModalOpenUpdateLicenseController', ['license', 'Licenses', 'LicensesService', 'ProductService', 'FhdMessenger', '$modalInstance', 'Authentication', 'helper', function (license, Licenses, LicensesService, ProductService, FhdMessenger, $modalInstance, Authentication, helper) {
  const vm = this;
  vm.user = Authentication.user;
  vm.disableEdit = !_.intersection(['admin', 'licenses:edit'], vm.user.roles).length;
  vm.removeValueFromArray = helper.removeValueFromArray;
  vm.data = {
    licenseTargets: LicensesService.getTargets()
  };
  ProductService.getProductWithSpecialSku().then(products => {
    vm.data.amisProducts = _.reduce(_.groupBy(_.filter(products, 'amisSku'), 'amisSku'), (result, _products) => {
      const firstProduct = _.head(_products);

      result.push({
        sku: firstProduct.amisSku,
        description: firstProduct.amisDescription,
        products: _products
      });
      return result;
    }, []);
  });

  function between(x, min, max) {
    return x >= min && x <= max;
  }

  vm.searchBySpecialSku = product => {
    const products = product.products;

    if (!products.length) {
      return FhdMessenger.error('Không tìm thấy sản phẩm nào với mã ' + product.sku);
    }

    _.forEach(products, product => {
      vm.productSearchSelected(product);
    });
  };

  vm.productSearchSelected = product => {
    vm.license.products = vm.license.products || [];

    const matchProduct = _.find(vm.license.products, {
      sku: product.sku
    });

    if (matchProduct) {
      return FhdMessenger.error(`Đã có sản phẩm ${product.sku} - ${product.description} trong danh sách`);
    }

    vm.license.products.push({
      product: product._id,
      sku: product.sku,
      description: product.description
    });
  };

  vm.createLicenseCode = () => {
    if (_.isUndefined(vm.bookId) || _.isUndefined(vm.pageId)) {
      return;
    }

    if (!between(vm.bookId, 1, 99)) {
      vm.license.code = null;
      return FhdMessenger.error('Mã số quyển phải trong khoảng 1 đến 99');
    }

    if (!between(vm.pageId, 1, 99)) {
      vm.license.code = null;
      return FhdMessenger.error('Mã số trang phải trong khoảng 1 đến 99');
    }

    vm.license.code = `L${helper.addLeadZero(vm.bookId, 2)}${helper.addLeadZero(vm.pageId, 2)}`;
  };

  vm.init = () => {
    vm.bookId = vm.license.code.slice(2, 3);
    vm.pageId = vm.license.code.slice(4, 5);
  };

  vm.cleanTarget = LicensesService.cleanTarget;

  vm.findOne = () => {
    LicensesService.getTypes().then(data => {
      vm.data.licenseTypes = data;
      vm.licenseMap = helper.makeMap(data, 'id');
    });
    Licenses.get({
      licenseId: license._id
    }).$promise.then(license => {
      vm.license = license;

      if (vm.license.startDate) {
        vm.license.startDate = moment(vm.license.startDate).format('YYYY-MM-DD');
      }

      if (vm.license.endDate) {
        vm.license.endDate = moment(vm.license.endDate).format('YYYY-MM-DD');
      }

      vm.bookId = parseInt(vm.license.code.slice(1, 3));
      vm.pageId = parseInt(vm.license.code.slice(3, 5));
    });
  };

  vm.remove = (array, index) => {
    array.splice(index, 1);
  };

  vm.update = () => {
    vm.license.tags = _.uniq(vm.license.tags);
    const error = LicensesService.validate(vm.license);

    if (error) {
      return FhdMessenger.error(error);
    }

    if (vm.license.hasNoEndDate) {
      vm.license.endDate = null;
    }

    vm.waiting = true;
    vm.license.$update().then(() => {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.dismiss();
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('vendors').controller('ModalViewLicenseBackupEntryController', ['$modalInstance', 'license', function ($modalInstance, license) {
  const vm = this;
  vm.license = license;

  _.forEach(vm.license.licenseBackupEntry, licenseBackupEntry => {
    licenseBackupEntry.code = licenseBackupEntry.code.slice(0, 5);
  });

  vm.closeModal = () => $modalInstance.dismiss();
}]);
"use strict";

angular.module('licenses').controller('ViewLicenseController', ['Licenses', '$stateParams', 'Authentication', 'LicensesService', 'NgTableParams', 'FhdMessenger', '$state', '$modal', function (Licenses, $stateParams, Authentication, LicensesService, NgTableParams, FhdMessenger, $state, $modal) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.transaction = {
    user: vm.user
  };

  vm.findOne = async () => {
    vm.license = Licenses.get({
      licenseId: $stateParams.licenseId
    }).$promise.then(license => {
      vm.license = license;
      vm.licensesLoanHistoryTable.settings({
        dataset: license.transactionHistories
      });
      vm.transaction.type = license.status === 'free' ? 'lent' : 'returned';
    });
  };

  vm.licensesLoanHistoryTable = new NgTableParams({
    count: 50,
    sorting: {
      time: 'desc'
    }
  });

  function getIndex(scope, transaction, column, field) {
    return `<span>${field + 1}</span>`;
  }

  function normalValue(scope, transaction, column) {
    const value = _.get(transaction, column.field, '');

    return `<span>${value}</span>`;
  }

  function transactionTypeContent(scope, transaction, column) {
    const type = transaction[column.field];
    const types = {
      lent: {
        title: 'Mượn',
        label: 'label-primary'
      },
      returned: {
        title: 'Trả',
        label: 'label-success'
      }
    };
    return `<span class="label ${types[type].label}">${types[type].title}</span>`;
  }

  function staffContent(scope, transaction, column) {
    const staff = transaction[column.field];
    return `<span>${staff.code} ${staff.displayName}</span>`;
  }

  function dateContent(scope, transaction, column) {
    const date = transaction[column.field];
    return `<span>${moment(date).format(column.formatDate)}</span>`;
  }

  vm.columns = [{
    field: '$index',
    title: 'STT',
    show: true,
    getValue: getIndex
  }, {
    field: 'type',
    title: 'Kiểu',
    show: true,
    getValue: transactionTypeContent
  }, {
    field: 'reason',
    title: 'Lý do',
    filter: {
      reason: 'text'
    },
    show: true,
    getValue: normalValue
  }, {
    field: 'receiver',
    title: 'Người nhận',
    filter: {
      'receiver.displayName': 'text'
    },
    show: true,
    getValue: staffContent
  }, {
    field: 'transactionDate',
    sortable: 'transactionDate',
    title: 'Thời gian mượn/trả',
    show: true,
    formatDate: 'YYYY/MM/DD hh:mm',
    getValue: dateContent
  }, {
    field: 'time',
    sortable: 'time',
    title: 'Thời gian tạo',
    show: true,
    formatDate: 'YYYY/MM/DD',
    getValue: dateContent
  }];
  vm.openModalViewLicenseBackupEntries = LicensesService.openModalViewLicenseBackupEntries;
}]);
'use strict';

angular.module('licenses').filter('licenseTag', ['LicensesService', function (LicensesService) {
  return function (tag) {
    return LicensesService.filterTag(tag);
