angular.module('stories').factory('StoryService', ['Stories', function (Stories) {
  return {
    getLinkYoutube(link) {
      if (!link) return;
      const linkUtube = link.match(/youtube(.*?)watch\?v=.*/g);
      if (!linkUtube) return;
      return 'https://www.' + linkUtube[0].replace('watch?v=', 'embed/');
    }

  };
}]);
