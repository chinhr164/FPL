  vm.result = result;

  vm.close = () => {
    $modalInstance.close();
  };
}]);
"use strict";

angular.module('spins').controller('ModalTestWheelOfFortuneController', ['$modalInstance', '$timeout', 'SpinService', '$http', '$scope', function ($modalInstance, $timeout, SpinService, $http, $scope) {
  const vm = this;
  let deg = 0;
  let isAudioPause = false;
  vm.waiting = false; // eslint-disable-next-line angular/document-service

  const audio = document.createElement('audio');
  audio.setAttribute('src', 'https://abby.vn/wp-content/uploads/2022/01/abba_happy_new_year_official_video_jRr0CHMByoK-gucZxneR-mp3cut.net_.mp3');

  vm.stopSound = function () {
    isAudioPause = true;
    audio.pause();
  };

  vm.close = () => {
    $modalInstance.close();
    audio.pause();
  };

  vm.action = () => {
    if (!isAudioPause) {
      audio.play();
    }

    vm.waiting = true;
    $http.get('/spins/test') // xóa đi thì vòng quay không chạy
    .success(function (result) {
      deg = 3600 * 1 + result.actualDeg;
      vm.wheel = {
        transition: 'all 6s ease-out',
        transform: `rotate(${deg}deg)`
      };
      $timeout(() => {
        vm.wheel = {
          transform: `rotate(${result.actualDeg}deg)`
        };
        vm.resultModal(result.prize);
        vm.waiting = false;
      }, 6000);
    }).error(function (errorRespond) {
      console.error(errorRespond);
    });
  };

  vm.resultModal = function (result) {
    const modal = SpinService.openResultModal(result);
    modal.result.then().then();
  };

  $modalInstance.result.finally(function () {
    audio.pause();
  });
}]);
"use strict";

/* eslint-disable angular/document-service */
angular.module('spins').controller('SpinsController', ['$stateParams', '$location', '$scope', 'Authentication', 'FhdMessenger', 'NgTableParams', 'ObjectId', '$timeout', 'SpinService', '$http', '$document', 'Spins', function ($stateParams, $location, $scope, Authentication, FhdMessenger, NgTableParams, ObjectId, $timeout, SpinService, $http, $document, Spins) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  let deg = 0;
  let isAudioPause = false;
  vm.waiting = false;
  vm.remainingSpins = 0; // ngược kim đồng hồ

  const audio = document.createElement('audio');
  audio.setAttribute('src', 'https://abby.vn/wp-content/uploads/2023/03/La-Con-Gai-That-Tuyet-Khoi-My-Official.mp3');

  vm.init = () => {
    vm.waiting = true;
    Spins.query({}).$promise.then(spins => {
      vm.remainingSpins = _.reject(spins, {
        status: 'inactive'
      }).length;
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.stopSound = function () {
    isAudioPause = true;
    audio.pause();
  };

  vm.action = () => {
    if (vm.remainingSpins === 0) {
      return FhdMessenger.error('Bạn đã hết lượt quay');
    }

    vm.remainingSpins -= 1;
    vm.waiting = true;
    $http.get('/spins/spin') // đổi type để chuyển từ test sang thật
    .success(function (spin) {
      if (!isAudioPause) {
        audio.play();
      }

      deg = 3600 * 1 + spin.result.actualDeg;
      vm.wheel = {
        transition: 'all 6s ease-out',
        transform: `rotate(${deg}deg)`
      };
      $timeout(() => {
        vm.wheel = {
          transform: `rotate(${spin.result.actualDeg}deg)`
        };
        vm.resultModal(spin.result);
        vm.waiting = false;
        vm.init();
      }, 6000);
    }).error(function (errorRespond) {
      FhdMessenger.errorFromServer(errorRespond);
    });
  };

  vm.resultModal = function (result) {
    const modal = SpinService.openResultModal(result);
    modal.result.then().then();
  };
}]);
"use strict";

angular.module('spins').factory('SpinService', ['$http', '$modal', function ($http, $modal) {
  return {
    openResultModal(result) {
      return $modal.open({
        animation: true,
        controller: 'ModalResultController',
        controllerAs: 'vm',
        templateUrl: 'modules/spins/views/modal-result.client.view.html',
        size: 'lg',
        resolve: {
          result() {
            return result;
          }

        }
      });
    }

  };
}]);
"use strict";

