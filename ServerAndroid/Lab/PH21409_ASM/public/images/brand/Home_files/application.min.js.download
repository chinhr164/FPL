      return FhdMessenger.error(err);
    }

    vm.waiting = true;
    return outletReport.$save().then(() => {
      FhdMessenger.success(`Tạo Outlet Report thành công`); // Clear form fields

      vm.outletReport = '';
      $modalInstance.close();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
