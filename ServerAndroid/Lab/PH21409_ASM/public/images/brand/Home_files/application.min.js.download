angular.module('storing-entries').controller('ModalDonePasteCodeController', ['$modalInstance', 'FhdMessenger', 'ResourcesService', 'storingEntry', 'StoringEntries', 'toaster', function ($modalInstance, FhdMessenger, ResourcesService, storingEntry, StoringEntries, toaster) {
  const vm = this;
  vm.storingEntry = StoringEntries.get({
    storingEntryId: storingEntry._id
  });
  vm.data = {};
  async.parallel([ResourcesService.staffs(false)], function (err, results) {
    if (err) {
      toaster.error(err.message);
      return;
    }

    vm.data.staffs = results[0];
  });
  vm.storingEntry.staffPasteCodes = [];

  vm.pastedCode = () => {
    if (!vm.storingEntry.staffPasteCodes.length) {
      return FhdMessenger.error('Chưa có nhân viên dán nhãn');
    }

    $modalInstance.close(vm.storingEntry);
  };

  function clearInput() {
    vm.staffSearch = null;
  }

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.pushTypeAhead = function (item) {
    vm.storingEntry.staffPasteCodes = vm.storingEntry.staffPasteCodes || [];
    if (!item) return;

    const checkDuplicate = _.find(vm.storingEntry.staffPasteCodes, item);

    if (!checkDuplicate) {
      vm.storingEntry.staffPasteCodes.push(_.cloneDeep(item));
    }

    item = null;
    clearInput();
  };
}]);
"use strict";

angular.module('storing-entries').controller('ModalUpdateInventoryLocationController', ['$modalInstance', '$timeout', 'FhdMessenger', 'InventoryLocations', 'ResourcesService', 'storingEntry', 'StoringEntries', 'UserPhotoService', 'toaster', function ($modalInstance, $timeout, FhdMessenger, InventoryLocations, ResourcesService, storingEntry, StoringEntries, UserPhotoService, toaster) {
