angular.module('dexie').factory('Dexie', ['$window', '$localStorage', function ($window, $localStorage) {
  $localStorage.setObject('Dexie.DatabaseNames', ['4handy-work']);
  const Dexie = $window.Dexie;
  const db = new Dexie('4handy-work');
  db.version(1).stores({
    offlineSaleEntries: '++id,&offlineSaleEntryId,created,offlineOutlet,offlineShift,offlineDate,[offlineOutlet+offlineShift+offlineDate]'
  });
  db.version(2).stores({
    offlineSaleEntries: '++id,&offlineSaleEntryId,[offlineShift+offlineDate]'
  });
  const OfflineSaleEntry = db.offlineSaleEntries.defineClass({
    offlineSaleEntryId: String,
    created: Date,
    outlet: String,
    shift: String,
    date: Date
  });

  OfflineSaleEntry.prototype.save = function () {
    return db.offlineSaleEntries.put(this);
  };

  OfflineSaleEntry.prototype.delete = function () {
    return db.offlineSaleEntries.delete(this.id);
  };

  return {
    db,
    OfflineSaleEntry
  };
}]);
"use strict";

