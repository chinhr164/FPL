angular.module('users').controller('ModalUpdateBaseSalaryUserController', ['userId', '$location', 'Authentication', 'FhdMessenger', 'Users', '$modalInstance', function (userId, $location, Authentication, FhdMessenger, Users, $modalInstance) {
  const vm = this;
  vm.authentication = Authentication;
  vm.theUser = vm.authentication.user;
  vm.roles = [{
    _id: 'rank-a',
    name: 'Rank A'
  }, {
    _id: 'rank-f',
    name: 'Rank F'
  }];
  vm.ranks = ['A2', 'A3', 'A4', 'A5', 'A6'];

  vm.findOne = function () {
    vm.user = Users.get({
      userId
    });
    vm.user.$promise.then(user => {
      vm.isFulltime = _.get(vm.user, 'outlet.code', 'W').match(/(B1|^S\d+)/) && vm.user.position.match(/(full-time|fulltime)/gi);
      vm.user.rank = undefined;
      vm.lastBaseSalary = _.findLast(user.baseSalaryByMonths, 'month');
      vm.baseSalary = _.get(vm.user, 'fulltimeSalary.baseSalary', 0);
      vm.lunchSupport = _.get(_.find(_.get(vm.user.fulltimeSalary, 'supports', []), support => support.content === 'Hỗ trợ ăn trưa'), 'amount', 0);
      vm.user.role = 'rank-f';
      return user;
    });
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.removeBaseSalary = baseSalaryByMonth => {
    vm.user.baseSalaryByMonthCreated = baseSalaryByMonth.created;
    vm.user.$removeBaseSalary().then(() => {
      FhdMessenger.success('Xóa thành công');
      vm.cancel();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.suggestBaseSalary = function () {
    if (vm.lastBaseSalary) {
      vm.user.baseSalary = vm.lastBaseSalary.baseSalary;
      vm.user.numBaseShift = vm.lastBaseSalary.numBaseShift;
      vm.user.insurance = vm.lastBaseSalary.insurance;
      vm.user.listSupportSalaries = vm.lastBaseSalary.listSupportSalaries;
    }
  };

  vm.insertSupportSalary = function () {
    if (!vm.supportSalaryContent) {
      return FhdMessenger.error('Chưa có nội dung lương hỗ trợ');
    }

    if (!vm.supportSalaryAmount) {
      return FhdMessenger.error('Chưa có số tiền lương hỗ trợ');
    }

    vm.user.listSupportSalaries = vm.user.listSupportSalaries || [];
    vm.user.listSupportSalaries.push({
      content: vm.supportSalaryContent,
      amount: vm.supportSalaryAmount
    });
    vm.supportSalaryContent = undefined;
    vm.supportSalaryAmount = undefined;
  };

  vm.removeSupportSalary = function (index) {
    vm.user.listSupportSalaries.slice(index, 1);
  };

  vm.insertBaseSalary = function () {
    if (!vm.user.month) {
      return FhdMessenger.error('Bạn chưa chọn tháng');
    }

    if (vm.user.role === 'rank-f') {
      if (!vm.user.baseSalary) {
        return FhdMessenger.error('Chưa có lương cơ bản');
      }

      if (!vm.user.numBaseShift) {
        return FhdMessenger.error('Chưa có số ca trực cơ bản');
      }
    }

    if (vm.user.role === 'rank-a') {
      if (!vm.user.rank && !vm.user.listSupportSalaries.length) {
        return FhdMessenger.error('Chưa có rank hoặc lương hỗ trợ');
      }
    }

    vm.user.$insertBaseSalary(function () {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close();
    }, function (errorResponse) {
      vm.error = errorResponse;
      FhdMessenger.errorFromServer(vm.error);
    });
  };
}]);
'use strict'; // User controller

angular.module('users').controller('ModalUpdatePersonalInformationController', ['$modalInstance', 'Address', 'Authentication', 'FhdMessenger', '$state', '$http', function ($modalInstance, Address, Authentication, FhdMessenger, $state, $http) {
  const vm = this;
  vm.user = Authentication.user;
  vm.close = $modalInstance.dismiss;

  if (vm.user.informationStatus === 'done') {
    vm.waiting = true;
  }

  vm.data = {
    districts: Address.getDistricts()
  };
  Address.getWards().then(wards => {
    const district = _.get(vm.user, 'residentialAddress.district');

    if (district) {
      vm.district = _.find(vm.data.districts, {
        district
      });
    }

    vm.data.wards = wards;
  });

  function getCity(district) {
    if (district.includes('Hồ Chí Minh')) {
      return 'TP. Hồ Chí Minh';
    }

    return 'Hà Nội';
  }

  vm.getWard = () => {
    vm.user.residentialAddress = vm.user.residentialAddress || {};
    vm.user.residentialAddress.city = getCity(vm.district);
    vm.user.residentialAddress.district = _.head(vm.district.split(','));
    vm.data.currentWards = vm.data.wards[vm.user.residentialAddress.city][vm.user.residentialAddress.district];
  };

  vm.updatePersonalInformation = () => {
    if (!vm.user.gender) {
      return FhdMessenger.error('Bạn chưa điền giới tính');
    }

    if (!vm.user.address) {
      return FhdMessenger.error('Bạn chưa điền hộ khẩu thường trú');
    }

    if (!vm.user.ethnic) {
      return FhdMessenger.error('Bạn chưa điền dân tộc');
    }

    if (!vm.user.identityCardNumber) {
      return FhdMessenger.error('Bạn chưa điền số CMND/CCCD');
    }

    if (!vm.user.dateOfIdentityCard) {
      return FhdMessenger.error('Bạn chưa điền ngày cấp CMND/CCCD');
    }

    if (!vm.user.placeOfIdentityCard) {
      return FhdMessenger.error('Bạn chưa điền nơi cấp CMND/CCCD');
    }

    if (_.get(vm.user, 'identityCardImages.length', 0) < 2) {
      return FhdMessenger.error('Vui lòng điền tối thiểu 2 mặt của CMND/CCCD');
    }

    vm.user.residentialAddress.address = `${vm.user.residentialAddress.city}, ${vm.user.residentialAddress.district}, ${vm.user.residentialAddress.ward}, ${vm.user.residentialAddress.street}`;
    vm.waiting = true;
    $http.put(`/users/${vm.user._id}/update-personal-information`, {
      gender: _.get(vm.user, 'gender'),
      address: _.get(vm.user, 'address'),
      residentialAddress: _.get(vm.user, 'residentialAddress'),
      ethnic: _.get(vm.user, 'ethnic'),
      identityCardNumber: _.get(vm.user, 'identityCardNumber'),
      dateOfIdentityCard: _.get(vm.user, 'dateOfIdentityCard'),
      placeOfIdentityCard: _.get(vm.user, 'placeOfIdentityCard'),
      identityCardImages: _.get(vm.user, 'identityCardImages'),
      studentIdentityCardImages: _.get(vm.user, 'studentIdentityCardImages')
    }).then(response => {
      FhdMessenger.success('Cập nhật thành công');
      vm.close();
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('users').controller('ModalViewAssessUserController', ['assess', function (assess) {
  const vm = this;
  vm.assess = assess;
}]);
'use strict'; // User controller

angular.module('users').controller('ModalViewUserController', ['userId', '$location', '$window', 'Authentication', 'FhdMessenger', 'Users', 'UserService', '$modalInstance', 'UserNotes', '$q', '$http', function (userId, $location, $window, Authentication, FhdMessenger, Users, UserService, $modalInstance, UserNotes, $q, $http) {
  const vm = this;
  vm.authentication = Authentication;
  vm.isStaffAdmin = _.intersection(vm.authentication.user.roles, ['admin', 'tro-ly-ns']).length;

  vm.findOne = function () {
    $q.all([Users.get({
      userId
    }).$promise, UserNotes.query({
      staff: userId
    }), Users.getProcessingApplicationForms({
      userId
    })]).then(([user, userNotes, applicationForms]) => {
      vm.user = user;
      vm.applicationForms = applicationForms;
      vm.userNotes = userNotes;
      vm.showDonePersonalInformation = ['waiting', 'unconfirmed'].includes(vm.user.informationStatus) && _.intersection(vm.authentication.user.roles, ['user:edit', 'tro-ly-ns', 'accountant', 'admin']).length;
    });
  };

  vm.openUpdateBaseSalaryUserModal = UserService.openUpdateBaseSalaryUserModal;
  vm.cancel = $modalInstance.dismiss;

  vm.donePersonalInformation = () => {
    $http.put(`/users/${vm.user._id}/done-personal-information`).then(response => {
      FhdMessenger.success('Đã chuyển trạng thái đã xác thực');
      vm.cancel();
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateNotes = () => {
    vm.user.blacklistNote = $window.prompt('Nhập lý do');

    if (!vm.user.blacklistNote) {
      FhdMessenger.error('Chưa điền nội dung ghi chú');
    }

    vm.waiting = true;
    vm.user.$updateNotes().then(() => {
      FhdMessenger.success('Cập nhật thành công');
      vm.cancel();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.openUniformReceivedModal = UserService.openUniformReceivedModal;
}]);
'use strict';

angular.module('users').controller('PasswordController', ['$stateParams', '$http', '$location', 'Authentication', 'FhdMessenger', function ($stateParams, $http, $location, Authentication, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication; // If user is signed in then redirect back home

  if (vm.authentication.user) $location.path('/'); // Submit forgotten password account id

  vm.askForPasswordReset = function () {
    FhdMessenger.info('Đang gửi yêu cầu');
    vm.waiting = true;
    vm.success = vm.error = null;
    $http.post('/auth/forgot', vm.credentials).success(function (response) {
      // Show user success message and clear form
      vm.credentials = null;
      vm.success = response.message;
      vm.waiting = false;
    }).error(function (response) {
      // Show user error message and clear form
      vm.credentials = null;
      vm.error = response.message;
      vm.waiting = false;
    });
  }; // Change user password


  vm.resetUserPassword = function () {
    vm.success = vm.error = null;
    $http.post(`/auth/reset/${$stateParams.token}`, vm.passwordDetails).success(function (response) {
      // If successful show success message and clear form
      vm.passwordDetails = null; // Attach user profile

      Authentication.user = response; // And redirect to the index page

      $location.path('/password/reset/success');
    }).error(function (response) {
      vm.error = response.message;
    });
  };
}]);
'use strict'; // Rank a points controller

angular.module('users').controller('RetireRequestsController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'Users', 'UserService', function (Authentication, FhdMessenger, NgTableParams, Users, UserService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.retireRequestTable = new NgTableParams({
    count: 100
  });
  vm.data = {};
  vm.data.startDate = moment().subtract(2, 'month').startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD');

  vm.find = function () {
    vm.waiting = true;
    Users.retireRequests({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate
    }).$promise.then(retireRequests => {
      vm.retireRequests = _.map(retireRequests, retireRequest => {
        if (!retireRequest.retireType) {
          retireRequest.retireType = 'completely';
        }

        return retireRequest;
      });
      vm.retireRequestTable.settings({
        dataset: vm.retireRequests
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.hasSalary = function (_id, retireRequestId, user) {
    Users.hasSalary({
      _id,
      retireRequestId
    }).$promise.then(_user => {
      user.retireRequest.salaryStatus = 'yes';
      FhdMessenger.success('Đã chuyển thành có tính lương');
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.openSovleRequest = user => {
    if (!vm.user.roles.includes('admin') && !vm.user.code === 'M30') {
      return FhdMessenger.error('Bạn không có quyền xử lý');
    }

    return UserService.openSolveRetireRequest(user);
  };

  vm.noSalary = function (_id, retireRequestId, user) {
    Users.noSalary({
      _id,
      retireRequestId
    }).$promise.then(_user => {
      user.retireRequest.salaryStatus = 'no';
      FhdMessenger.success('Đã chuyển thành không tính lương');
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.disableRetireRequest = function (_id, retireRequestId, user) {
    Users.disableRetireRequest({
      _id,
      retireRequestId
    }).$promise.then(_user => {
      user.retireRequest.action = 'disabled';
      FhdMessenger.success('Xóa thành công');
    }).catch(FhdMessenger.errorFromServer);
  };
}]);
'use strict';

angular.module('users').controller('SalaryController', ['Authentication', 'SalariesService', '$location', '$modal', '$state', 'helper', 'ConfirmModal', 'FhdMessenger', 'NgTableParams', 'ObjectId', '$timeout', '$http', 'StaffSalaryMonthlyReports', '$window', 'Users', function (Authentication, SalariesService, $location, $modal, $state, helper, ConfirmModal, FhdMessenger, NgTableParams, ObjectId, $timeout, $http, StaffSalaryMonthlyReports, $window, Users) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {};
  vm.data.positions = SalariesService.getPositions();
  vm.statuses = [{
    id: 'low',
    title: 'Thấp'
  }, {
    id: 'normal',
    title: 'Bình thường'
  }, {
    id: 'high',
    title: 'Cao'
  }];
  vm.actualSalaryStatuses = [{
    id: 'true',
    title: 'Chuẩn'
  }, {
    id: 'false',
    title: 'Lệch'
  }];
  vm.month = moment().dates() < 20 ? moment().subtract(1, 'month').startOf('month').format('YYYY-MM-DD') : moment().startOf('month').format('YYYY-MM-DD');

  function roundNumber(num) {
    if (!num) return 0;
    return Math.round(num * 100) / 100;
  }

  if (moment().dates() < 25) {
    vm.data.endDate = moment().subtract(1, 'month').date(25).format('YYYY-MM-DD');
  } else {
    vm.data.endDate = moment().date(25).format('YYYY-MM-DD');
  }

  vm.data.startDate = moment(vm.data.endDate).subtract(1, 'month').date(26).format('YYYY-MM-DD');
  vm.data.position = 'sale'; // Redirect user to home page if user is not an admin

  if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('accountant') && !vm.user.roles.includes('tro-ly-ns') && !vm.user.roles.includes('salary:calculate')) {
    $location.path('/');
  }

  vm.usersTable = new NgTableParams({
    count: 100
  });
  vm.summaryTable = new NgTableParams({
    count: 100
  });

  vm.calculateSalary = staff => {
    staff.finalSalary = staff.shiftSalary + staff.kpiSalary + staff.prizeMoney + staff.overTimeSalary + staff.bonus - staff.fineMoney;
    staff.actualSalary = staff.finalSalary;
  };

  vm.load = function () {
    FhdMessenger.info('Đang tính lương...');
    vm.waiting = true;
    vm.summaryTable.settings({
      dataset: []
    });
    $http.get('/users/salary', {
      params: {
        startDate: vm.data.startDate,
        endDate: vm.data.endDate,
        seperateSalary: vm.data.seperateSalary || false,
        position: vm.data.position,
        shift: vm.shift ? vm.shift.code : null,
        outlet: _.get(vm.data, 'outlet._id') ? ObjectId.getObjectId(vm.data.outlet) : null,
        business: _.get(vm.data, 'business._id') ? ObjectId.getObjectId(vm.data.business) : null
      }
    }).success(function (staffs) {
      FhdMessenger.success('Đã xong :)');
      vm.staffs = staffs;

      if (vm.data.position === 'fulltime-ship') {
        vm.staffs = _.map(vm.staffs, salary => {
          const hadLunchSupport = _.find(salary.listSupportSalaries, {
            content: 'Phụ cấp ăn trưa'
          });

          salary.lunchSupport = _.get(hadLunchSupport, 'amount', 0);
          salary.supportSalary -= salary.lunchSupport;
          return salary;
        });
      }

      vm.staffs = _.map(vm.staffs, staff => {
        if (_.intersection(staff.user.roles, ['inactive', 'deleted']).length) {
          staff.actualSalaryPercent = _.get(staff.user, 'calculateSalaryPercent', 100);
          staff.disableReason = _.get(staff.user, 'disableReason', '');
        }

        return staff;
      });
      vm.usersTable.settings({
        dataset: vm.staffs
      });
      vm.finalSalary = _.sumBy(staffs, 'finalSalary');
      vm.actualSalary = _.sumBy(staffs, 'actualSalary');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateSummaryTable = function (staffs, position) {
    const backendSavorPositions = ['kitchen', 'fulltime:B1'];
    const backendAbbyPositions = ['collaborator-warehousing', 'collaborator-packing', 'packing', 'warehousing'];
    const fronEndPositions = ['sale', 'collaborator-sale', 'order'];
    const officeParttimePositions = ['office-parttime'];

    if (!_.concat(fronEndPositions, backendAbbyPositions, backendSavorPositions, officeParttimePositions).includes(position)) {
      return FhdMessenger.error('Vị trí này chưa có phần tổng hợp % lương/doanh thu. Vui lòng báo team Tech nếu muốn bổ sung nhé');
    }

    let notCalculateRevenue = false;

    if (officeParttimePositions.includes(position)) {
      notCalculateRevenue = true;
    }

    FhdMessenger.info('Đang tải tổng hợp doanh thu');
    vm.waiting = true;
    $http.get('/reports/revenue-by-outlet-with-position', {
      params: {
        startDate: vm.data.startDate,
        endDate: vm.data.endDate,
        position: vm.data.position,
        notCalculateRevenue,
        outlet: _.get(vm.data, 'outlet._id') ? ObjectId.getObjectId(vm.data.outlet) : null,
        business: _.get(vm.data, 'business._id') ? ObjectId.getObjectId(vm.data.business) : null
      }
    }).then(res => {
      FhdMessenger.success('Đã tải xong tổng hợp doanh thu :)');
      const dataMap = helper.makeMap(res.data, 'outletCode');
      let staffGroupByOutlet;

      if (['collaborator-sale', 'office-parttime'].includes(position)) {
        staffGroupByOutlet = _.groupBy(staffs, 'user.outlet.code');
      } else if (backendSavorPositions.includes(position)) {
        staffGroupByOutlet = {
          total: staffs
        };
      } else if (backendAbbyPositions.includes(position)) {
        staffGroupByOutlet = _.groupBy(staffs, 'user.outlet.region');
      } else {
        staffGroupByOutlet = _.groupBy(staffs, 'outlet.code');
      }

      const summary = _.reduce(staffGroupByOutlet, (result, _staffs, outletCode) => {
        const totalSalary = _.sumBy(_staffs, 'actualSalary');

        let totalRevenue;

        if (backendSavorPositions.includes(position)) {
          totalRevenue = _.sumBy(res.data, 'total');
        } else if (backendAbbyPositions.includes(position)) {
          totalRevenue = _.sumBy(_.filter(res.data, {
            region: outletCode
          }), 'total');
        } else {
          totalRevenue = _.get(dataMap, `${outletCode}.total`, 0);
        }

        const percent = totalSalary / totalRevenue;
        const status = getPercentStatus(percent, outletCode);
        result.push({
          outletCode,
          totalSalary,
          totalRevenue,
          status,
          percent
        });
        return result;
      }, []);

      vm.totalSalary = _.sumBy(summary, 'totalSalary');
      vm.totalRevenue = _.sumBy(summary, 'totalRevenue');
      vm.percent = vm.totalSalary / vm.totalRevenue;
      vm.status = getPercentStatus(vm.percent, _.head(summary).outletCode);
      vm.summaryTable.settings({
        dataset: summary
      });
      vm.summaryTable.sorting({
        outletCode: 'asc'
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  function getPercentStatus(percent, outletCode) {
    let statusTable = [{
      percent: 0.025,
      status: 'low'
    }, {
      percent: 0.033,
      status: 'normal'
    }];

    if (outletCode.match(/S\d+/)) {
      statusTable = [{
        percent: 0.075,
        status: 'low'
      }, {
        percent: 0.085,
        status: 'normal'
      }];
    }

    return _.get(_.find(statusTable, status => {
      return percent < status.percent;
    }), 'status', 'high');
  } // Open modal add kept salary model


  vm.openKeptSalaryModal = function () {
    const userSalaries = _.filter(vm.usersTable.data, 'checked');

    if (!userSalaries.length) {
      return FhdMessenger.error('Chưa chọn nhân viên nào');
    }

    $modal.open({
      animation: true,
      size: 'md',
      templateUrl: 'modules/users/views/account/modal-add-kept-salary.client.view.html',
      controller: 'ModalAddKeptSalaryController',
      controllerAs: 'vm',
      resolve: {
        userSalaries: () => userSalaries
      }
    }).result.then(result => {
      if (result) {
        vm.usersTable.data = _.map(vm.usersTable.data, user => {
          user.checked = false;
          return user;
        });
      }
    });
  }; // Open modal repay salary model


  vm.openRepaySalary = function () {
    const userSalaries = _.filter(vm.usersTable.data, 'checked');

    if (!userSalaries.length) {
      return FhdMessenger.error('Chưa chọn nhân viên nào');
    }

    $modal.open({
      animation: true,
      size: 'lg',
      templateUrl: 'modules/users/views/account/modal-repay-salary.client.view.html',
      controller: 'ModalRepaySalaryController',
      controllerAs: 'vm',
      resolve: {
        userSalaries: () => userSalaries
      }
    }).result.then(result => {
      if (result) {
        vm.usersTable.data = _.map(vm.usersTable.data, user => {
          user.checked = false;
          return user;
        });
      }
    });
  }; // Check first salary table


  vm.checkFirstSalaries = function () {
    if (!vm.usersTable.data.length) {
      return FhdMessenger.error('Tính lương nhân viên trước khi kiểm tra nhé');
    }

    vm.checking = true;

    const users = _.map(vm.usersTable.data, 'user');

    $http.get('/staff-salary-monthly-reports/check-first-salary', {
      params: {
        users: _.map(users, '_id')
      }
    }).then(response => {
      const matchedUsers = response.data;
      vm.usersTable.data = _.map(vm.usersTable.data, table => {
        if (matchedUsers.includes(table.user._id)) {
          table.firstSalary = true;
        }

        return table;
      });
      FhdMessenger.success(`Kiểm tra thành công. Có ${matchedUsers.length} nhân viên chưa có bảng lương nào`);
    }).catch(err => FhdMessenger.error(err.message)).finally(() => vm.checking = false);
  }; // Open a staff salary


  vm.openStaff = function (staff) {
    $modal.open({
      animation: true,
      size: 'lg',
      windowClass: 'modal-online-order',
      templateUrl: 'modules/users/views/account/modal-view-salary.client.view.html',
      controller: 'ModalSalaryController',
