angular.module('storing-entries').controller('StoringEntriesController', ['$timeout', 'Authentication', 'ComplaintService', 'CurrentShift', 'FhdMessenger', 'InventoryLocations', 'NgTableParams', 'Outlets', 'StockEntries', 'StockEntryService', 'StoringEntries', 'StoringEntryService', 'TemperatureRecords', 'TemperatureRecordService', function ($timeout, Authentication, ComplaintService, CurrentShift, FhdMessenger, InventoryLocations, NgTableParams, Outlets, StockEntries, StockEntryService, StoringEntries, StoringEntryService, TemperatureRecords, TemperatureRecordService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.storingEntriesTable = new NgTableParams({
    count: 50
  });
  vm.rotationStockEntriesTable = new NgTableParams({
    count: 50
  });
  vm.statusMap = {
    created: true,
    done: false
  };
  vm.shiftMap = {
    S: true,
    C: true,
    T: true
  };
  vm.currentShift = CurrentShift.getCurrentShift();
  vm.outlet = vm.currentShift.outlet;
  vm.openCreateComplaintModal = ComplaintService.openCreateComplaintModal;

  if (!vm.currentShift.created && !vm.user.roles.includes('admin') && !vm.user.roles.includes('flexi-time') && !vm.user.roles.includes('tro-ly-kho')) {
    return FhdMessenger.error('Chưa đăng nhập ca trực');
  }

  vm.data = {
    statuses: StoringEntryService.getStatuses(),
    shifts: StoringEntryService.getShifts()
  };
  Outlets.query({
    deleted: false,
    isWarehouse: true
  }).$promise.then(outlets => {
    vm.data.outlets = _.filter(outlets, outlet => {
      return outlet.code.match(/D\d/);
    });
    vm.showOutletMap = _.reduce(vm.data.outlets, (result, outlet) => {
      result[outlet._id] = true;
      return result;
    }, {});
  });
  vm.data.processStatus = [{
    title: 'Process',
    value: 'process'
  }, {
    title: 'Confirm',
    value: 'confirm'
  }];
  vm.data.stockEntriesTable = [];

  _.forEach(vm.data.processStatus, status => {
    vm.data.stockEntriesTable[status.value] = new NgTableParams({
      count: 50
    });
  });

  vm.data.inventoryLocations = InventoryLocations.query();
  vm.openViewModalStockEntry = StockEntryService.openViewModalStockEntry;

  vm.openDoneReturnStockEntry = function (stockEntry) {
    StockEntryService.openDoneReturnStockEntry(stockEntry).result.then(result => {
      stockEntry = result;
      vm.fetchTable();
    });
  };

  vm.startDate = moment().subtract(1, 'day').format('YYYY-MM-DD');
  vm.endDate = moment(vm.startDate).add(5, 'day').format('YYYY-MM-DD');

  vm.initRecord = function () {
    vm.temperatureRecord = {};
    vm.temperatureRecord.outlet = vm.currentShift.outlet;
    vm.temperatureRecord.date = moment().startOf('day').format('DD/MM/YYYY');
    const now = moment();

    if (moment(now).hour() > 8 && moment(now).hour() < 12) {
      vm.temperatureRecord.shift = 'S';
    }

    if (moment(now).hour() >= 12 && moment(now).hour() < 17) {
      vm.temperatureRecord.shift = 'C';
    }

    if (moment(now).hour() >= 17 && moment(now).hour() < 22) {
      vm.temperatureRecord.shift = 'T';
    }

    TemperatureRecordService.getRecordByShift({
      shift: vm.temperatureRecord.shift,
      outlet: vm.outlet ? vm.outlet._id : null
    }).then(temperatureRecord => {
      if (temperatureRecord) {
        vm.temperatureRecord = temperatureRecord;
      }
    });
  };

  vm.find = () => {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const shifts = _.reduce(vm.shiftMap, (shifts, toShow, shift) => {
      if (toShow) shifts.push(shift);
      return shifts;
    }, []);

    const outlets = _.reduce(vm.showOutletMap, (outlets, toShow, outlet) => {
      if (toShow) outlets.push(outlet);
      return outlets;
    }, []);

    const startDate = vm.startDate ? moment(vm.startDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    const endDate = vm.endDate ? moment(vm.endDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    vm.storingEntries = StoringEntries.query({
      startDate,
      statuses,
      shifts,
      endDate,
      outlets
    }, function (storingEntries) {
      FhdMessenger.success('Đã tải xong danh sách Storing Entries!');
      vm.storingEntries = storingEntries;
      vm.fetchStoringEntriesTable();
    });
  };

  vm.searchReturnStockEntries = function () {
    vm.stockEntries = StockEntries.query({
      processStatuses: ['process', 'confirm'],
      currentStatus: ['delivered', 'received'],
      types: ['return'],
      destination: _.get(vm.currentShift, 'outlet._id'),
      startDate: moment().subtract(2, 'month').format('YYYY-MM-DD'),
      endDate: moment().add(1, 'week').format('YYYY-MM-DD')
    }, function (stockEntries) {
      FhdMessenger.success('Đã tải xong Logistic Entries thu hồi!');
      vm.stockEntries = stockEntries;
      vm.fetchStockEntriesTable();
    });

    if (!_.get(vm.currentShift, 'outlet._id') && !vm.user.roles.includes('admin') && !vm.user.roles.includes('tro-ly') && !vm.user.roles.includes('tro-ly-kho')) {
      return FhdMessenger.error('Cần đăng nhập ca trực để xem danh sách LE chuyển giữa các kho');
    }

    vm.rotationStockEntries = StockEntries.getRotationStockEntries({
      destination: _.get(vm.currentShift, 'outlet._id')
    }, function (stockEntries) {
      FhdMessenger.success('Đã tải xong Logistic Entries chuyển giữa các kho!');
      vm.rotationStockEntries = stockEntries;
      vm.fetchRotationStockEntriesTable();
    });
  };

  vm.fetchStoringEntriesTable = () => {
    vm.storingEntriesTable.settings({
      dataset: vm.storingEntries
    });
  };

  vm.fetchStockEntriesTable = () => {
    _.forEach(vm.data.processStatus, status => {
      const filterStockEntries = _.filter(vm.stockEntries, {
        processStatus: status.value
      });

      vm.data.stockEntriesTable[status.value].settings({
        dataset: filterStockEntries
      });
      vm.data.stockEntriesTable[status.value].sorting({
        delivered: 'desc'
      });
    });
  };

  vm.fetchRotationStockEntriesTable = () => {
    vm.rotationStockEntriesTable.settings({
      dataset: vm.rotationStockEntries
    });
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      case 'shift':
        {
          let changeValue = true;
          if (_.every(vm.shiftMap)) changeValue = false;

          _.forEach(vm.shiftMap, (value, key) => {
            vm.shiftMap[key] = changeValue;
          });

          break;
        }

      case 'outlet':
        {
          let changeValue = true;
          if (_.every(vm.showOutletMap)) changeValue = false;

          _.forEach(vm.showOutletMap, (value, key) => {
            vm.showOutletMap[key] = changeValue;
          });

          break;
        }
    }
  };

  vm.openDonePasteCodeModal = storingEntry => {
    StoringEntryService.openDonePasteCodeModal(storingEntry).result.then(result => {
      storingEntry = result;
      storingEntry.$pastedAbbyCode().then(result => {
        vm.find();
        vm.storingEntriesTable.reload();
      }).catch(FhdMessenger.errorFromServer);
    });
  };

  vm.openUpdateInventoryLocationModal = storingEntry => {
    StoringEntryService.openUpdateInventoryLocationModal(storingEntry).result.then(result => {
      storingEntry = result;
      storingEntry.$addLocation().then(_storingEntr => {
        vm.find();
        vm.storingEntriesTable.reload();
      }).catch(FhdMessenger.errorFromServer);
      storingEntry.changingLocation = false;
    });
  };

  vm.selectLocation = (storingEntry, inventoryLocation) => {
    if (!inventoryLocation._id) {
      return FhdMessenger.error('Trong hệ thống không thấy vị trí bạn đã chọn. Hãy kiểm tra lại nhé');
    }

    storingEntry.location = inventoryLocation;
    storingEntry.$addLocation().then(_storingEntry => {
      $timeout(() => {
        angular.element('#storingEntrySearch').focus();
      }, 500);
      FhdMessenger.success('Ok');
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.done = function (stockEntry) {
    vm.waiting = true;
    stockEntry.$done().then(result => {
      stockEntry.done = result.done;
      FhdMessenger.success(`Đã xử lí đơn thu hồi`);
      vm.fetchStockEntriesTable();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.createTemperatureRecord = function () {
    if (!vm.temperatureRecord.temperature) {
      return FhdMessenger.error('Chưa có nhiệt độ đã ghi');
    }

    if (!vm.temperatureRecord.shift) {
      return FhdMessenger.error('Chưa có ca cập nhật nhiệt độ');
    } // Create new Sticket object


    const temperatureRecord = new TemperatureRecords(vm.temperatureRecord);
    vm.waiting = true; // Redirect after save

    temperatureRecord.$save(function (response) {
      vm.temperatureRecord = response;
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
      FhdMessenger.error(vm.error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateFeedback = function (stockEntry, newStatus) {
    const modal = StockEntryService.openUpdateFeedback(stockEntry, newStatus);
    modal.result.then().then(() => {
      FhdMessenger.info('Cập nhật thành công');
      vm.fetchStockEntriesTable();
    });
  };

  vm.confirmReceived = function (stockEntry) {
    vm.updateFeedback(stockEntry, 'received');
  };
}]);
"use strict";

