angular.module('deliver-entries').controller('StockEntriesNotInDeliverEntriesController', ['OutletService', 'StockEntryService', function (OutletService, StockEntryService) {
  const vm = this;
  vm.data = {
    showOutletMap: {}
  };
  vm.openViewModalStockEntry = StockEntryService.openViewModalStockEntry;
  vm.startDate = moment().startOf('day').subtract(7, 'day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').subtract(1, 'day').format('YYYY-MM-DD');

  vm.init = function () {
    vm.loadOutletsPromise = OutletService.allAsync().then(outlets => {
      vm.data.outlets = _.filter(outlets, outlet => {
        if (outlet.isPos && outlet.code !== 'SHIP' && outlet.code !== 'BSG' && outlet.code !== 'BHN' && outlet.code !== 'M1') {
          return true;
        }
      });
      vm.showOutletMap = _.reduce(vm.data.outlets, (result, outlet) => {
        result[outlet._id] = true;
        return result;
      }, {});
    }).then(() => {
      vm.find();
    });
  };

  vm.find = function () {
    // Filter assigned outlets
    const destinations = _.reduce(vm.showOutletMap, (assignedOutlets, toShow, outlet) => {
      if (toShow) assignedOutlets.push(outlet);
      return assignedOutlets;
    }, []);

    StockEntryService.listStockEntriesNotInDeliverEntries({
      startDate: vm.startDate,
      endDate: vm.endDate,
      destinations
    }).then(data => {
      vm.results = data.result;
    });
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'outlet':
        {
          let changeValue = true;
          if (_.every(vm.showOutletMap)) changeValue = false;

          _.forEach(vm.showOutletMap, (value, key) => {
            vm.showOutletMap[key] = changeValue;
          });

          break;
        }

      default:
    }
  };
}]);
'use strict';

angular.module('deliver-entries').controller('TableDeliverEntriesController', ['$scope', '$state', 'Authentication', 'CurrentShift', 'DeliverEntries', 'DeliverEntryService', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'StockEntries', function ($scope, $state, Authentication, CurrentShift, DeliverEntries, DeliverEntryService, FhdMessenger, NgTableParams, ObjectId, StockEntries) {
  const vm = this;
  vm.user = Authentication.user;

  vm.initFind = function () {
    vm.statusMap = {
      delivered: true,
      received: false
    };
    vm.endDate = moment().format('YYYY-MM-DD');
    vm.startDate = moment(vm.endDate).subtract(3, 'week').format('YYYY-MM-DD');
  };

  vm.deliverEntriesTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    const searchText = vm.searchText;

    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const startDate = vm.startDate ? moment(vm.startDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    const endDate = vm.endDate ? moment(vm.endDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    vm.deliverEntries = DeliverEntries.query({
      searchText,
      statuses,
      startDate,
      endDate
    }, function () {
      vm.deliverEntriesTable.settings({
        dataset: vm.deliverEntries
      });
    });
  };

  vm.selectAllStatus = function () {
    let changeValue = true;
    if (_.every(vm.statusMap)) changeValue = false;

    _.forEach(vm.statusMap, (value, key) => {
      vm.statusMap[key] = changeValue;
    });
  };

  $scope.$watch(() => vm.deliverEntriesTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.totalDeliverFee = _.sumBy(newValue, 'deliverFee');
  });
}]);
'use strict';

angular.module('users').filter('TransporterServiceFilters', ['DeliverEntryService', function (DeliverEntryService) {
