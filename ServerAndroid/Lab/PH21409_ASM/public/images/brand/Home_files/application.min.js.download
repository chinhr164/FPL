angular.module('restock-events').controller('RestockEventsController', ['$scope', '$stateParams', '$location', '$window', 'Authentication', 'RestockEvents', 'ObjectId', 'uiCalendarConfig', '$compile', '$filter', 'FhdMessenger', function ($scope, $stateParams, $location, $window, Authentication, RestockEvents, ObjectId, uiCalendarConfig, $compile, $filter, FhdMessenger) {
  const vm = this;
  vm.user = Authentication.user;

  vm.initialValues = () => {
    vm.startDate = moment().startOf('date').format('YYYY-MM-DD');
    vm.time = moment().startOf('hour').add(1, 'hour').toDate();
    vm.mooncake = true;
  };

  vm.data = {
    events: []
  };

  const mergeDateTime = (date, time) => {
    if (!moment(date).isValid()) return null;
    if (!moment(time).isValid()) return null;
    const momentTime = moment(time);
    return moment(date).hour(momentTime.hour()).minute(momentTime.minute()).second(0).millisecond(0);
  };

  $scope.$watch(() => [vm.outlet, vm.mooncake], () => {
    vm.defaultTitle = `Restock ${_.get(vm.outlet, 'code')} ${vm.mooncake ? ' - TT' : ''}`;
  }, true); // Create new Calendar entry

  vm.create = function () {
    // Create new Calendar entry object
    const startDate = mergeDateTime(vm.date, vm.time);
    const restockEvent = new RestockEvents({
      title: vm.title || vm.defaultTitle,
      outlet: vm.outlet,
      start: startDate,
      note: vm.note,
      mooncake: vm.mooncake
    }); // Redirect after save

    restockEvent.$save(() => {
      $location.path('restock-events'); // Clear form fields

      vm.name = '';
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  }; // Remove existing Calendar entry


  vm.remove = function (restockEvent) {
    if (restockEvent) {
      restockEvent.$remove();

      const index = _.findIndex(vm.restockEvents, ev => ev === restockEvent);

      vm.restockEvents.splice(index, 1);
    } else {
      vm.restockEvent.$remove(function () {
        $location.path('restock-events');
      }, FhdMessenger.errorFromServer);
    }
  }; // Update existing Calendar entry


  vm.update = function () {
    const restockEvent = vm.restockEvent;
    restockEvent.$update().then(() => $location.path('restock-events')).catch(FhdMessenger.errorFromServer);
  };

  vm.calendarSources = [{
    url: '/restock-events/calendar',

    data() {
      return {
        business: ObjectId.getObjectId(vm.business)
      };
    },

    color: 'white',
    textColor: '#191919',
    borderColor: '#ABABAC',
    cache: true
  }];

  vm.summarize = function () {
    const outletMap = _.reduce(vm.data.events, (result, restockEvent) => {
      const outletCode = _.get(restockEvent, 'outlet.code') || null;
      result[outletCode] = result[outletCode] || 0;
      result[outletCode] += 1;
      return result;
    }, {});

    const outlets = _.sortBy(_.map(outletMap, (times, outletCode) => {
      return {
        outletCode,
        times
      };
    }), 'outletCode');

    let outletRestockByDay = _.groupBy(vm.data.events, event => {
      return moment(event.start).startOf('day').format('DD-MM-YYYY');
    });

    outletRestockByDay = _.reduce(outletRestockByDay, (result, events, date) => {
      result[date] = {
        date,
        numOutlet: _.size(events)
      };
      return result;
    }, {});

    const summaryOutletRestockByDay = _.sortBy(_.values(outletRestockByDay), 'date');

    vm.summaryOutletRestockByDay = summaryOutletRestockByDay;
    vm.outlets = outlets;
    vm.data.events = [];
  };

  vm.eventRender = function (event, element) {
    vm.data.events.push(event);
    element.find('.fc-time').css({
      display: 'none'
    });

    if (!event.title) {
      const titleElm = element.find('.fc-title');
      titleElm.css({
        display: 'none'
      });
    }

    if (event.mooncake) {
      element.css({
        'background-color': '#ff9191'
      });
    }

    const contentElm = element.find('.fc-content');

    if (event.staff && event.staff.displayName) {
      contentElm.append(`<div class=".fc-staff">${event.staff.displayName}</div>`);
    }

    if (event.end) {
      contentElm.append('<div class=".fc-end"></div>');
    }

    $compile(element)($scope);
  };

  vm.eventClick = restockEvent => {
    if (!_.intersection(vm.user.roles, ['admin', 'restock-time:edit']).length) {
      return FhdMessenger.error('Bạn không có quyền chỉnh sửa ');
    }

    $window.open(`#!/restock-events/${restockEvent._id}/edit`);
  };

  vm.calendarConfig = {
    height: 450,
    editable: true,
    header: {
      left: 'title',
      center: '',
      right: 'today month basicWeek prev,next'
    },
    firstDay: 1,
    weekNumbers: 4,
    defaultView: 'basicWeek',
    timezone: 'Asia/Ho_Chi_Minh',
    weekNumberCalculation: 'ISO',
    eventClick: vm.eventClick,
    eventRender: vm.eventRender,
    eventAfterAllRender: vm.summarize,
    lang: 'vi',
    eventOrder: ['start']
  };

  vm.find = function () {
    const calendar = uiCalendarConfig.calendars.restockCalendar;
    calendar.fullCalendar('refetchEvents');
  }; // Find existing Calendar entry


  vm.findOne = function () {
    RestockEvents.get({
      restockEventId: $stateParams.restockEventId
    }).$promise.then(restockEvent => _.assign(restockEvent, {
      start: new Date(restockEvent.start),
      end: new Date(restockEvent.end),
      created: new Date(restockEvent.created)
    })).then(restockEvent => {
      vm.restockEvent = restockEvent;
      vm.restockEvent.start = moment(vm.restockEvent.start).toDate().format('YYYY-MM-DD');
    });
  };
}]);
'use strict'; // Calendar entries service used to communicate Calendar entries REST endpoints

