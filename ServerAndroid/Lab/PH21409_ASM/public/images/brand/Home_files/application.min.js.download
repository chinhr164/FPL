angular.module('shipping-entries').controller('ShippingEntryController', ['Authentication', 'NgTableParams', 'FhdMessenger', '$modal', 'ShippingEntries', 'ShippingEntriesService', function (Authentication, NgTableParams, FhdMessenger, $modal, ShippingEntries, ShippingEntriesService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.shippingEntriesTable = new NgTableParams({
    count: 50
  });

  vm.onChangeSelectedOutlet = outlets => {
    vm.outletCodes = _.map(outlets, 'code');
  };

  vm.statuses = [{
    id: 'pending',
    title: 'Chờ giải trình',
    idName: 'showPending',
    class: 'primary'
  }, {
    id: 'incomplete',
    title: 'Hủy',
    idName: 'showIncomplete',
    class: 'default'
  }, {
    id: 'done',
    title: 'Hoàn thành',
    idName: 'showDone',
    class: 'success'
  }];
  vm.statusMap = {
    pending: false,
    done: false
  };

  vm.find = () => {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    vm.waiting = true;
    vm.shippingEntries = ShippingEntries.query({
      statuses,
      outletCodes: vm.outletCodes,
      startDate: vm.startDate,
      endDate: vm.endDate
    }).$promise.then(shippingEntries => {
      vm.shippingEntriesTable.settings({
        dataset: shippingEntries
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.createShippingEntryNote = shippingEntry => {
    $modal.open({
      templateUrl: '/modules/shipping-entries/views/modal-input-shipping-entry-note.client.view.html',
      controller: 'ModalInputShippingEntryNoteController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        shippingEntry: () => shippingEntry
      }
    });
  };

  vm.addCompensationValue = shippingEntry => {
    ShippingEntriesService.addCompensationValue(shippingEntry);
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      case 'outlet':
        {
          let changeValue = true;
          if (_.every(vm.showOutletMap)) changeValue = false;

          _.forEach(vm.showOutletMap, (value, key) => {
            vm.showOutletMap[key] = changeValue;
          });

          break;
        }
    }
  };
}]);
'use strict';

angular.module('shipping-entries').factory('ShippingEntriesService', ['$modal', '$http', function ($modal, $http) {
  return {
