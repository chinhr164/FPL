'use strict';

angular.module('sale-reports').filter('paymentTypes', [function () {
  return function (input) {
    switch (input) {
      case 'card':
        return 'Thẻ ATM';

      case 'ononpay':
        return 'Ononpay';

      case 'vnpay':
        return 'VNPAY';

      case 'momo':
        return 'MOMO';

      case 'cash':
        return 'Tiền mặt';

      case 'transfer':
        return 'Chuyển khoản';

      case 'airpay':
        return 'AIRPAY';

      case 'AIRPAY':
        return 'AIRPAY';

      case 'VNPAY':
        return 'VNPAY';

      default:
        return input;
    }
  };
}]);
'use strict';

angular.module('sale-entries').filter('printBillDescription', [function () {
  return function (input) {
    if (input.length > 70) {
      const words = _.words(input);

      const resultWords = [..._.take(words, 5), '...', ..._.takeRight(words, Math.min(5, words.length - 5))];
      return resultWords.join(' ');
    }

    return input;
  };
}]);
'use strict';

angular.module('sale-entries').factory('BundlePricesService', ['SaleEntryService', function (SaleEntryService) {
  return {
    processBundlePrices({
      item,
      bundlePrices,
      totalQuantity,
      totalJarItemValue,
      jarSkus
    }) {
      if (!_.get(bundlePrices, 'length')) {
        return item;
      }

      const matchBundlePrices = _.filter(bundlePrices, bundlePrice => {
        if (jarSkus && jarSkus.includes(item.sku)) {
          return totalJarItemValue >= bundlePrice.value;
        }

        return totalQuantity >= bundlePrice.quantity;
      });

      let soldPrice = item.soldPrice;
      let noLoyalty = item.noLoyalty || false;
      let isWholesale = false;
      let lineTotal = item.soldPrice * item.quantity - item.discount;

      if (_.get(matchBundlePrices, 'length')) {
        const matchBundlePrice = _.minBy(matchBundlePrices, 'price');

        if (item.soldPrice > matchBundlePrice.price) {
          soldPrice = matchBundlePrice.price;
          noLoyalty = true;
          isWholesale = SaleEntryService.getIsWholesale(item, true);
        }

        lineTotal = soldPrice * item.quantity - item.discount;
      } // console.log(soldPrice)


      return _.assign(item, {
        soldPrice,
        noLoyalty,
        isWholesale,
        lineTotal
      });
    },

    processNoLoyaltyByBundlePrices({
      item,
      bundlePrices
    }) {
      if (!_.get(bundlePrices, 'length')) {
        return item;
      }

      const highestBundlePrice = _.maxBy(bundlePrices, 'price');

      if (item.soldPrice < highestBundlePrice.price) {
        return _.assign(item, {
          noLoyalty: true
        });
      }

      return item;
    },

    getNearestBundlePrices({
      item,
      bundlePrices,
      totalQuantity
    }) {
      const bundlePrice = _.reduce(bundlePrices, (result, bundlePrice) => {
        if (!result && bundlePrice.quantity > totalQuantity) return bundlePrice;

        if (result && bundlePrice.quantity > totalQuantity && bundlePrice.quantity < result.quantity) {
          return bundlePrice;
        }

        return result;
      }, null);

      if (!bundlePrice) return;

      if (bundlePrice && totalQuantity / bundlePrice.quantity >= 2 / 3) {
        item.nearestBundlePrice = bundlePrice;
      }

      return bundlePrice;
    },

    getBundlePrices(item, region, outlet, source) {
      if (['tiktok', 'shopee'].includes(source)) {
        return [];
      }

      if (!_.get(item, 'regionAttributes.length') && !_.get(item, 'bundlePrices.length')) {
        return [];
      }

      if (_.some(item.regionAttributes, regionAttribute => {
        return _.get(regionAttribute, 'region', '') === region && regionAttribute.noBundlePrices;
      })) {
        return [];
      }

      const matchRegionAttribute = _.findLast(item.regionAttributes, {
        region: region,
        noBundlePrices: false
      });

      if (_.get(matchRegionAttribute, 'bundlePrices.length')) {
        return matchRegionAttribute.bundlePrices;
      }

      return _.get(item, 'bundlePrices', []);
    }

  };
}]);
'use strict';

angular.module('sale-entries').factory('PromotionService', ['helper', 'FhdMessenger', 'NumberService', 'ObjectId', '$modal', function (helper, FhdMessenger, NumberService, ObjectId, $modal) {
  const jarSkus = ['V2128', 'V2129', 'V2130', 'V2131', 'V2136', 'V2137', 'V2138', 'V2139', 'V2140', 'V2141', 'V2142', 'V2143', 'V2144', 'V2145', 'V2146', 'V2147', 'V2148', 'V2149', 'V2150', 'V2151', 'V2152', 'V2153', 'V2224'];
  const miniTulipSkus = ['V2250', 'V2251', 'V2252'];
  const normalTulipSkus = ['V2253', 'V2254', 'V2255'];
  const specialCakeSkus = [...miniTulipSkus, ...normalTulipSkus, 'V2262', // red tim mới
  'V2263', 'V1608', // loang dau
  'V1609', 'V1610'];

  function calculateShockSaleItemPrice(items, numShockPriceItems, SHOCK_PRICE_ITEMS) {
    const result = _.reduce(items, (result, item, index) => {
      if (item.toLock) {
        return result;
      }

      const matchShockPriceItem = _.find(SHOCK_PRICE_ITEMS, {
        sku: item.sku
      });

      if (!matchShockPriceItem) {
        return result;
      }

      if (result.count > 0) {
        item.discount = 0;
        item.onSale = true;
        let discountOnUnit = 0;

        if (_.isNumber(matchShockPriceItem.salePrice)) {
          discountOnUnit = item.soldPrice - matchShockPriceItem.salePrice;
        } else if (matchShockPriceItem.percentage) {
          discountOnUnit = item.soldPrice - item.price * matchShockPriceItem.percentage / 100;
        }

        const ratio = _.get(matchShockPriceItem, 'ratio', 1);

        const toDiscountQuantity = Math.min(Math.floor(item.quantity / ratio), result.count);
        const discount = toDiscountQuantity * discountOnUnit * ratio;
        item.lineTotal -= discount;
        item.discount = discount;
        result.count -= toDiscountQuantity;
        result.items[index] = item;
      }

      return result;
    }, {
      count: numShockPriceItems + _.sumBy(SHOCK_PRICE_ITEMS, item => {
        if (item.ratio) {
          return 1;
        }

        return 0;
      }),
      items: _.clone(items)
    });

    return result;
  }

  function discountPrice(price, percentage) {
    return Math.round(price * (100 - percentage) / 100 / 100) * 100;
  }

  function resetVoucher(saleEntry, items) {
    _.forEach(items, function (item) {
      if (item.toLock) return;
      item.soldPrice = item.salePrice || item.originalPrice;
      item.onSale = item.soldPrice < item.originalPrice;
      item.lineTotal = item.soldPrice * item.quantity - item.discount;
    });

    saleEntry.order.discount = 0;
    saleEntry.order.discounts = [];
  }

  function canGetOpeningGift(saleEntry) {
    if (_.get(saleEntry, 'saleEntryType', '') !== 'SHOP') {
      return false;
    }

    const outletCode = _.get(saleEntry, 'outlet.code');

    if (_.get(saleEntry, 'customer.searchCustomerType') !== 'app') {
      return false;
    }

    if (moment().isBetween('2023-03-17', '2023-04-08', 'day', '[]') && ['E24'].includes(outletCode) && _.get(saleEntry, 'order.saleTotal') >= 625000) {
      return true;
    }

    return false;
  }

  return {
    resetVoucher,

    processVoucher(voucher, saleEntry, items) {
      if (_.get(voucher, 'outlets.length')) {
        if (!saleEntry.outlet) {
          return;
        }

        if (!_.some(voucher.outlets, _outlet => {
          return ObjectId.equals(_outlet, saleEntry.outlet);
        })) {
          return;
        }
      }

      let count = 0;
      let totalDiscountValue = 0; // If voucher deduce the amount for a particular category

      if (voucher.voucherType === 'AMOUNT') {
        saleEntry.order.discount = voucher.quantity;
      } // If voucher deduce by percentage


      if (voucher.voucherType === 'PERCENTAGE') {
        // for any kind of products
        if (voucher.target === 'ANY') {
          _.forEach(items, function (item) {
            if (item.addGiftItem) return;
            item.soldPrice = discountPrice(item.originalPrice, voucher.quantity);
            item.onSale = true;
            count += item.quantity;
            totalDiscountValue += item.quantity * (item.originalPrice - item.soldPrice);
          });
        } // for only one specific product


        if (voucher.target === 'PRODUCT') {
          _.forEach(items, function (item) {
            if (item.addGiftItem) return;

            if (_.some(voucher.products, product => {
              return ObjectId.equals(product, item.product);
            })) {
              item.soldPrice = discountPrice(item.originalPrice, voucher.quantity);
              item.onSale = true;
              count += item.quantity;
            }
          });
        }

        if (voucher.target === 'ORDER') {
          const saleTotal = _.reduce(items, (result, item) => {
            return result + item.quantity * item.soldPrice;
          }, 0);

          const discount = saleTotal * voucher.quantity / 100;
          totalDiscountValue += discount;
          saleEntry.order.discount = discount;
        }
      } // If voucher set specific price for product or products


      if (voucher.voucherType === 'PRICE') {
        // Other than exists more than one product
        if (voucher.target !== 'PRODUCTS') {
          _.forEach(items, function (item) {
            if (item.addGiftItem) return;

            if (_.includes(voucher.products, item.product)) {
              item.soldPrice = voucher.quantity;
              item.onSale = true;
              count += item.quantity;
            }
          });
        } // If there are many products in the voucher


        if (voucher.target === 'PRODUCTS') {
          _.forEach(items, function (item) {
            if (item.addGiftItem) return; // Find the match product in voucher for each item

            const matchSaleItem = _.find(voucher.saleProducts, {
              product: item.product
            });

            if (!matchSaleItem) return;
            item.onSale = true;
            item.soldPrice = matchSaleItem.salePrice;
            item.salaryPercentage = matchSaleItem.salaryPercentage;
            count += item.quantity;
          });
        }
      } // Check if there is upper limit over total quantity per sale entry


      if (voucher.maxQuantityPerOrder && count > voucher.maxQuantityPerOrder) {
        FhdMessenger.error(`Voucher này chỉ áp dụng với ${voucher.maxQuantityPerOrder} sản phẩm.`);
        resetVoucher(saleEntry, items);
      }

      if (voucher.maxValuePerOrder && totalDiscountValue > voucher.maxValuePerOrder) {
        FhdMessenger.error(`Voucher này chỉ giảm tối đa ${voucher.maxValuePerOrder}`);
        resetVoucher(saleEntry, items);
      }
    },

    openComboModal(item) {
      return $modal.open({
        templateUrl: '/modules/sale-entries/views/modal-combo-input.client.view.html',
        controller: 'ModalComboInputController',
        controllerAs: 'vm',
        resolve: {
          comboProduct: () => item
        }
      });
    },

    getAvailableGifts({
      items,
      saleEntry,
      isFirstSaleEntry
    }) {
      let options = []; // Quà tặng mở cơ sở mới

      if (canGetOpeningGift(saleEntry)) {
        options.push({
          sku: 'B5391',
          description: 'Sổ tay Abby',
          quantity: 1
        });
      } // Quà tặng vẹm xanh


      const outletCode = _.get(saleEntry, 'outlet.code');

      if (moment().isBetween('2023-03-17', '2023-04-01', 'day', '[]') && ['E63', 'M1', 'M2', 'E18', 'E1'].includes(outletCode) && _.get(saleEntry, 'order.saleTotal') >= 399000) {
        options.push({
          sku: 'B8005',
          description: 'Vẹm xanh nhập khẩu Westpac 1kg',
          quantity: 1
        });
      }

      if (options.length) {
        options.unshift({
          sku: null,
          description: 'Không lấy quà'
        });
      }

      return options;
    },

    getSpecialDayPromotion(items, deadline) {
      if (!moment(deadline).isBetween('2023-02-23', '2023-03-09', undefined, '[]')) {
        return items;
      }

      let SHOCK_PRICE_ITEMS = []; // if (moment(deadline).isBefore(moment('2023-03-07'))) {
      // const miniNumDiscountItem = _.sumBy(items, (item) => {
      //   if (miniTulipSkus.includes(item.sku)) {
      //     return item.quantity
      //   }
      //   return 0
      // })
      // const normalNumDiscountItem = _.sumBy(items, (item) => {
      //   if (normalTulipSkus.includes(item.sku)) {
      //     return item.quantity
      //   }
      //   return 0
      // })
      // if (miniNumDiscountItem) {
      //   SHOCK_PRICE_ITEMS.push({ sku: 'V1953', quantity: miniNumDiscountItem, salePrice: 0 })
      // }
      // if (normalNumDiscountItem) {
      //   SHOCK_PRICE_ITEMS.push({ sku: 'V1954', quantity: normalNumDiscountItem, salePrice: 0 })
      // }
      // }

      if (moment(deadline).isBetween('2023-03-07', '2023-03-08', undefined, '[]')) {
        const numDiscountItem = _.sumBy(items, item => {
          if (specialCakeSkus.includes(item.sku)) {
            return item.quantity;
          }

          return 0;
        });

        if (!numDiscountItem) {
          return items;
        }

        SHOCK_PRICE_ITEMS.push({
          sku: 'V2245',
          quantity: numDiscountItem,
          salePrice: 0
        });
      }

      _.forEach(SHOCK_PRICE_ITEMS, item => {
        let numShockPriceItem = item.quantity;
        const result = calculateShockSaleItemPrice(items, numShockPriceItem, [item]);
        items = result.items;
      });

      return items;
    },

    getDiscountAlmostExpiredCake({
      items,
      deadline,
      deliverStartTime
    }) {
      if (!deadline || !deliverStartTime) {
        return items;
      }

      const deliverTime = helper.combineTimeAndDate(deadline, deliverStartTime);

      _.forEach(items, item => {
        if (!item.manufacturingDate) {
          return true;
        }

        let date = 2;

        if (['V1398', 'V1397', 'V1462'].includes(item.sku)) {
          date = 1;
        }

        if (moment(deliverTime).isAfter(moment(item.manufacturingDate).add(date, 'day').hours(19).startOf('hours').subtract(1, 'second'))) {
          item.discount = item.soldPrice - item.originalPrice / 2;
        }
      });

      return items;
    },

    processAbbyGiftForStaff(items, remainItemMap, region) {
      const cloneRemainItemMap = _.cloneDeep(remainItemMap);

      let noodleSkus = [];
      let sausageSkus = [];
      let milkSkus = [];
      let waterSkus = [];

      if (region === 'SOUTH') {
        noodleSkus = ['B6450', 'B6469', 'B6470', 'B6994', 'B6876', 'B6590', 'B6990', 'B7038', 'B6462', 'B6897', 'B7058', 'B6808', 'B6806', 'B7062', 'B7141', 'B6461', 'B6991'];
        sausageSkus = ['B6693', 'B6695'];
        milkSkus = ['B6623'];
      }

      if (region === 'NORTH') {
        waterSkus = ['B7247', 'B6682', 'B6787'];
      }

      const result = _.reduce(items, (result, item, index) => {
        if (noodleSkus.includes(item.sku) && result.cloneRemainItemMap.numNoodle > 0) {
          const quantity = Math.min(result.cloneRemainItemMap.numNoodle, item.quantity);
          item.discount = quantity * item.soldPrice;
          result.items[index] = item;
          return result;
        }

        if (sausageSkus.includes(item.sku) && result.cloneRemainItemMap.numSausage > 0) {
          const quantity = Math.min(result.cloneRemainItemMap.numSausage, item.quantity);
          item.discount = quantity * item.soldPrice * 0.5;
          result.items[index] = item;
          return result;
        }

        if (milkSkus.includes(item.sku) && result.cloneRemainItemMap.numMilk > 0) {
          const quantity = Math.min(result.cloneRemainItemMap.numMilk, item.quantity);
          item.discount = quantity * item.soldPrice * 0.5;
          result.items[index] = item;
          return result;
        }

        if (waterSkus.includes(item.sku) && result.cloneRemainItemMap.numWater > 0) {
          const quantity = Math.min(result.cloneRemainItemMap.numWater, item.quantity);
          item.discount = quantity * (item.soldPrice - 3000);
          result.items[index] = item;
          return result;
        }

        return result;
      }, {
        cloneRemainItemMap,
        items: _.cloneDeep(items)
      });

      return _.get(result, 'items', []);
    },

    processShockSalePrice(items, outlet) {
      let SHOCK_PRICE_ITEMS = [{
        sku: 'B7439',
        description: 'Nước quét bóng Singapore 100g',
        salePrice: 10000
      }];

      if (!['NORTH', 'SOUTH'].includes(_.get(outlet, 'region')) || moment().isAfter('2023-09-20')) {
        return {
          numShockPriceItems: 0,
          shockPriceMessage: '',
          shockPriceItems: items
        };
      }

      if (!SHOCK_PRICE_ITEMS.length) {
        return {
          numShockPriceItems: 0,
          shockPriceMessage: '',
          shockPriceItems: items
        };
      }

      const numMatchSku = _.reduce(items, (result, item) => {
        if (item.sku === 'B2115') {
          result += item.quantity;
        }

        return result;
      }, 0);

      let numShockPriceItems = Math.floor(numMatchSku / 1);

      if (!numShockPriceItems) {
        return {
          numShockPriceItems: 0,
          shockPriceMessage: '',
          shockPriceItems: items
        };
      }

      const result = calculateShockSaleItemPrice(items, numShockPriceItems, SHOCK_PRICE_ITEMS);
      let newItems = result.items;
      const message = numShockPriceItems ? `Đơn hàng được mua tối đa ${numShockPriceItems} sản phẩm` + _.map(SHOCK_PRICE_ITEMS, item => {
        return `
              <br>
            <strong>${item.sku} - ${item.description}</strong> với giá <strong>${NumberService.numberWithCommas(item.salePrice)}đ</strong>
            <br>`;
      }) : '';
      return {
        numShockPriceItems,
        shockPriceMessage: message,
        shockPriceItems: newItems
      };
    },

    processMoonCakeDiscount(items, isStaff) {
      const mooncakeSkus = ['V1692', 'V1691', 'V1690', 'V1689', 'V1688', 'V1687', 'V1686', 'V1685', 'V1684', 'V1683', 'V1764', 'V1773', 'V1774', 'V1740', 'V1716'];

      const totalQuantity = _.sumBy(items, item => {
        if (mooncakeSkus.includes(item.sku)) {
          return item.quantity;
        }

        return 0;
      });

      let totalDiscount = Math.floor(totalQuantity / 2);

      _.forEach(items, item => {
        if (!mooncakeSkus.includes(item.sku)) {
          return;
        }

        const numDiscount = Math.min(totalDiscount, item.quantity);
        let soldPrice = item.soldPrice;
        item.discount = soldPrice * numDiscount;
        totalDiscount -= numDiscount;
      });

      return items;
    },

    processMonthlyShockSalePrice(items, outlet) {
      let products = [{
        sku: 'B8877',
        description: 'Socola tươi (hộp 140g)',
        ratio: 0.5,
        gifts: [{
          sku: 'B8877',
          description: 'Socola tươi (hộp 140g)',
          salePrice: 0
        }]
      }, {
        sku: 'B6496',
        description: 'Set 5 màu gốc dầu làm socola bonbon',
        ratio: 1,
        gifts: [{
          sku: 'B9085',
          description: 'Bơ cacao Puratos 40g',
          salePrice: 0
        }, {
          sku: 'B9086',
          description: 'Bơ cacao Đăk Lăk 40g',
          salePrice: 0
        }]
      }];

      if (_.get(outlet, 'region') === 'NORTH') {
        products.push({
          sku: 'B0894',
          description: 'Tinh dầu hoa bưởi 100ml',
          ratio: 0.5,
          gifts: [{
            sku: 'B0894',
            description: 'Tinh dầu hoa bưởi 100ml',
            salePrice: 0
          }]
        });
      }

      let SHOCK_PRICE_ITEMS = [];

      if (moment().isBetween('2022-08-26', '2023-09-21', undefined, '()')) {
        SHOCK_PRICE_ITEMS = _.filter(products.map(product => {
          const quantity = _.reduce(items, (result, item) => {
            if (product.sku === item.sku) {
              result += item.quantity;
            }

            return result;
          }, 0);

          return {
            gifts: product.gifts,
            quantity: Math.floor(quantity * product.ratio)
          };
        }), product => {
          return product.quantity > 0;
        });
      }

      if (!SHOCK_PRICE_ITEMS.length) {
        return {
          monthlyShockPriceMessage: '',
          monthlyShockPriceItems: items
        };
      }

      let newItems = items;

      _.forEach(SHOCK_PRICE_ITEMS, item => {
        let numShockPriceItems = item.quantity;
        const result = calculateShockSaleItemPrice(newItems, numShockPriceItems, item.gifts);
        newItems = result.items;
      });

      const message = `Đơn hàng được tặng các sản phẩm sau ` + _.map(SHOCK_PRICE_ITEMS, item => {
        return `
              <br>
            <strong>${_.map(item.gifts, gift => {
          return `${gift.sku} - ${gift.description}`;
        }).join(' hoặc ')} số lượng ${item.quantity}</strong> 
             `;
      });

      return {
        monthlyShockPriceMessage: message,
        monthlyShockPriceItems: newItems
      };
    },

    processComboGift(items, region, outlet) {
      let products = [{
        sku: 'B5655',
        description: 'Yến mạch cán vỡ 500g',
        ratio: 0.5,
        giftSku: 'B5655',
        giftDescription: 'Yến mạch cán vỡ 500g'
      }];
      let SHOCK_PRICE_ITEMS = [];

      if (['E9', 'E11', 'E13', 'E14', 'E17', 'E19', 'E20', 'E22', 'E24', 'E26'].includes(_.get(outlet, 'code'))) {
        return {
          creamCheeseMessage: '',
          items: items
        };
      }

      if (!moment().isBetween('2023-01-01', '2023-02-21', undefined, '()')) {
        return {
          creamCheeseMessage: '',
          items: items
        };
      }

      SHOCK_PRICE_ITEMS = _.filter(products.map(product => {
        const quantity = _.reduce(items, (result, item) => {
          if (product.sku === item.sku) {
            result += item.quantity;
          }

          return result;
        }, 0);

        return {
          sku: product.giftSku,
          description: product.giftDescription,
          salePrice: 0,
          quantity: Math.floor(quantity * product.ratio)
        };
      }), product => {
        return product.quantity > 0;
      });

      if (!SHOCK_PRICE_ITEMS.length) {
        return {
          creamCheeseMessage: '',
          items: items
        };
      }

      let newItems = items;

      _.forEach(SHOCK_PRICE_ITEMS, item => {
        let numShockPriceItems = item.quantity;
        const result = calculateShockSaleItemPrice(newItems, numShockPriceItems, [item]);
        newItems = result.items;
      });

      const message = `Đơn hàng được tặng các sản phẩm sau ` + _.map(SHOCK_PRICE_ITEMS, item => {
        return `
              <br>
            <strong>${item.sku} - ${item.description} số lượng ${item.quantity}</strong> 
             `;
      });

      return {
        creamCheeseMessage: message,
        items: newItems
      };
    },

    processPromotionCustomerUseApp(items, availableMap) {
      if (!availableMap) {
        return items;
      }

      const itemMap = {
        B8910: 99000,
        B6766: 99000,
        B8195: 99000,
        B0047: 79000,
        B6350: 79000,
        B4920: 79000,
        B5908: 69000,
        B8340: 69000,
        B5965: 59000,
        B7500: 59000,
        B0467: 59000,
        B0030: 49000,
        B0263: 49000,
        B8697: 39000,
        B6475: 39000,
        B8888: 35000,
        B4744: 35000,
        B6825: 29000,
        B1136: 29000,
        B4919: 19000,
        B9110: 19000,
        B1978: 15000,
        B5256: 15000,
        B1914: 12000,
        B0419: 10000
      };
      return _.map(items, item => {
        if (_.get(availableMap, item.sku) && item.soldPrice > itemMap[item.sku]) {
          item.discount = item.soldPrice - itemMap[item.sku];
          item.saleProgram = 'Khuyến mãi cho khách hàng tích điểm bằng app';
          availableMap[item.sku] = 0;
        }

        return item;
      });
    },

    processPromotionLunarNewYear(items) {
      const jarSkus = ['V2136', 'V2137', 'V2138', 'V2139', 'V2140', 'V2141', 'V2142', 'V2143', 'V2144', 'V2145', 'V2146', 'V2147', 'V2148', 'V2149', 'V2150', 'V2151', 'V2152', 'V2153'];

      const numItem = _.sumBy(items, item => {
        if (jarSkus.includes(item.sku)) {
          return item.quantity;
        }

        return 0;
      });

      const numDiscountItem = Math.floor(numItem / 6);
      return _.map(items, item => {
        if (['B6052', 'V2177'].includes(item.sku)) {
          item.discount = Math.min(item.quantity, numDiscountItem) * item.soldPrice;
        }

        return item;
      });
    },

    getJarSkus() {
      return jarSkus;
    },

    getSpecialCakeSkus() {
      return specialCakeSkus;
    }

  };
}]);
'use strict';

angular.module('sale-entries').factory('SaleEntriesService', ['$resource', '$modal', '$http', function ($resource, $modal, $http) {
