angular.module('stock-entries').controller('ListBadItemsController', ['$scope', 'Authentication', 'NgTableParams', '$http', 'FhdMessenger', function ($scope, Authentication, NgTableParams, $http, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication;
  const user = Authentication.user;
  vm.startDate = moment().subtract(1, 'week').format('YYYY-MM-DD');
  vm.endDate = moment().format('YYYY-MM-DD');
  vm.user = user;

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.destinations = _.map(selectedOutlets, '_id');
  };

  vm.waiting = false;
  vm.badItemsTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    vm.waiting = true;
    let promise = $http.get('/stock-entries/get-bad-items', {
      params: {
        startDate: vm.startDate || moment().format('YYYY-MM-DD'),
        endDate: vm.endDate || moment().format('YYYY-MM-DD'),
        destinations: vm.destinations
      }
