angular.module('valentine-categories').factory('ValentineCategoriesService', ['ValentineCategories', function (ValentineCategories) {
  let valentineCategories;
  return {
    getTags() {
      return ValentineCategories.query().$promise.then(valentineCategories => _.map(valentineCategories.sort((a, b) => {
        return a.name.localeCompare(b.name);
      }), valentineCategory => ({
        id: valentineCategory.name,
        title: valentineCategory.name
      })));
    },

    getValentineCategories() {
      if (!valentineCategories) valentineCategories = ValentineCategories.query();
      return valentineCategories;
    }

  };
}]);
