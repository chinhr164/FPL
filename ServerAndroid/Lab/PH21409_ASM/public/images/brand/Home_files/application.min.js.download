"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('inventory-counts').component('filterOutlets', {
  bindings: {
    onChange: '=',
    label: '@',
    user: '=?',
    // For load outlet default by user
    summary: '=?',
    defaultOutlets: '=?',
    getAllOutlet: '=?',
    isStorage: '=?',
    isAbby: '=?',
    isStore: '=?',
    hasStaff: '=?',
    waiting: '=?',
    defaultValue: '=?',
    labelCol: '<?'
  },
  templateUrl: 'modules/inventory-counts/templates/filter-outlets.client.template.html',
  controller: ['$scope', 'OutletService', 'ObjectId', function ($scope, OutletService, ObjectId) {
    const vm = this;
    vm.outlets = [];
    vm.waiting = true;
    vm.contentCol = 12;
    let defaultValue = true;

    if (vm.defaultValue === 'false' || vm.defaultValue === false) {
      defaultValue = false;
    }

    vm.labelCol = vm.labelCol || 0;
    vm.contentCol = 12 - vm.labelCol;

    vm.init = () => {
      OutletService.allAsync().then(outlets => {
        let _outlets = _.reject(outlets, outlet => {
          return ['ABBY', 'SAVOR'].includes(_.get(outlet, 'code', ''));
        });

        vm.outlets = _.reduce(_outlets, (result, outlet) => {
          if (vm.isStorage && !outlet.isStorage) {
            return result;
          }

          if (vm.hasStaff && !outlet.hasStaff) {
            return result;
          }

          if (vm.isStore && !outlet.isStore) {
            return result;
          }

          if (vm.isAbby && _.get(outlet, 'business.code') !== 'ABBY') {
            return result;
          }

          if (vm.defaultOutlets) {
            if (_.some(vm.defaultOutlets, defaultOutlet => ObjectId.equals(defaultOutlet, outlet))) {
              result.push(_objectSpread({}, outlet, {
                value: true
              }));
            } else {
              result.push(_objectSpread({}, outlet, {
                value: false
              }));
            }

            return result;
          }

          if (vm.user) {
            const isSameOutlet = vm.user.outlet.code === outlet.code;
            result.push(_objectSpread({}, outlet, {
              value: isSameOutlet
            }));
          } else {
            result.push(_objectSpread({}, outlet, {
              value: defaultValue
            }));
          }

          return result;
        }, []);
      }).finally(() => {
        vm.waiting = false;
      });
    };

    const updateSelectedOutlets = () => {
      const outlets = _.filter(vm.outlets, outlet => outlet.value);

      vm.onChange(outlets);
    };

    if (vm.onChange) {
      $scope.$watch('vm.outlets', (newValue, oldValue) => {
        if (newValue !== oldValue && newValue) {
          updateSelectedOutlets();
        }
      });
    }

    $scope.$watch('vm.defaultOutlets', (newValue, oldValue) => {
      if (newValue !== oldValue && newValue && !oldValue) {
        vm.init();
      }
    });

    vm.selectOne = function () {
      updateSelectedOutlets();
    };

    vm.selectAll = function () {
      const map = _.map(vm.outlets, outlet => outlet.value);

      let newValue = true;
      if (_.every(map)) newValue = false;
      vm.outlets = _.map(vm.outlets, outlet => _objectSpread({}, outlet, {
        value: newValue
      }));
    };

    vm.selectOutletByBusiness = function (businessCode) {
      const values = _.reduce(vm.outlets, (result, outlet) => {
        if (_.get(outlet.business, 'code', 'ABBY') === businessCode) {
          result.push(outlet.value);
        }

        return result;
      }, []);

      let newValue = true;
      if (_.every(values)) newValue = false;
      vm.outlets = _.map(vm.outlets, outlet => _.get(outlet.business, 'code', 'ABBY') === businessCode ? _objectSpread({}, outlet, {
        value: newValue
      }) : outlet);
    };

    vm.selectOutletByRegion = region => {
      const values = _.reduce(vm.outlets, (result, outlet) => {
        if (_.get(outlet, 'region', 'NORTH') === region) {
          result.push(outlet.value);
        }

        return result;
      }, []);

      let newValue = true;
      if (_.every(values)) newValue = false;
      vm.outlets = _.map(vm.outlets, outlet => _.get(outlet, 'region', 'NORTH') === region ? _objectSpread({}, outlet, {
        value: newValue
      }) : outlet);
    };

    vm.selectOutletBySide = side => {
      const values = _.reduce(vm.outlets, (result, outlet) => {
        if (side === 'FRONT_END' && outlet.isPos) {
          result[outlet.code] = outlet.value;
          return result;
        }

        if (side === 'BACK_END' && (outlet.isWarehouse || outlet.isKitchen || outlet.isManufacturing || ['VANTAI'].includes(outlet.code)) && !['M6'].includes(outlet.code)) {
          result[outlet.code] = outlet.value;
          return result;
        }

        if (side === 'OFFICE' && !outlet.isPos && !outlet.isWarehouse && !outlet.isKitchen && !outlet.isManufacturing && !['VANTAI'].includes(outlet.code)) {
          result[outlet.code] = outlet.value;
          return result;
        }

        return result;
      }, {});

      let newValue = true;
      if (_.every(_.values(values))) newValue = false;
      vm.outlets = _.map(vm.outlets, outlet => _.isBoolean(values[outlet.code]) ? _objectSpread({}, outlet, {
        value: newValue
      }) : outlet);
    };
  }],
  controllerAs: 'vm'
});
