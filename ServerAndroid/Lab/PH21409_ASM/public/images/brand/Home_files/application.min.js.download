angular.module('license-types').controller('LicenseTypesController', ['$stateParams', '$location', '$scope', 'Authentication', 'LicenseTypes', 'FhdMessenger', 'NgTableParams', '$window', '$http', function ($stateParams, $location, $scope, Authentication, LicenseTypes, FhdMessenger, NgTableParams, $window, $http) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;

  vm.create = function () {
    const licenseType = new LicenseTypes(vm.licenseType);
    licenseType.$save().then(() => {
      FhdMessenger.success('Tạo License Type thành công');
      $location.path('license-types');
    }).catch(err => {
      return FhdMessenger.error(err.message);
    });
  };

  vm.licenseTypesTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    LicenseTypes.query().$promise.then(licenseTypes => {
      vm.licenseTypes = licenseTypes;
      vm.licenseTypesTable.settings({
        dataset: vm.licenseTypes
      });
    });
  };

  vm.findOne = async () => {
    vm.licenseType = LicenseTypes.get({
      licenseTypeId: $stateParams.licenseTypeId
    }).$promise.then(licenseType => {
      vm.licenseType = licenseType;
    });
  };

  vm.update = () => {
    vm.waiting = true;
    vm.licenseType.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('license-types');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.delete = (licenseType, index) => {
    const confirm = $window.confirm(`Bạn chắc chắn muốn xoá ${licenseType.name}?`);

    if (!confirm) {
      return;
    }

    $http.delete(`/license-types/${licenseType._id}`).then(response => {
      FhdMessenger.success(`Xoá thể loại ${licenseType.name} thành công!`);
      vm.licenseTypes.splice(index, 1);
      vm.licenseTypesTable.reload();
    }).catch(err => FhdMessenger.error(err.data.message));
  };
}]);
"use strict";

