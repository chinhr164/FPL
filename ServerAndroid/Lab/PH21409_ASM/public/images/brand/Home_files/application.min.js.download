angular.module('reports').controller('CustomerAnalyticsController', ['$scope', '$stateParams', '$http', 'FhdMessenger', 'AnalyticMaps', '$state', function ($scope, $stateParams, $http, FhdMessenger, AnalyticMaps, $state) {
  $scope.params = $stateParams;
  $scope.params.metric = $scope.params.metric || 'quantity';
  $scope.params.dimension = $scope.params.dimension || 'district';
  $scope.params.mode = $scope.params.mode || 'day';
  $scope.params.startDate = $scope.params.startDate || moment().date(1).format('YYYY-MM-DD');
  $scope.params.endDate = $scope.params.endDate || moment().format('YYYY-MM-DD');
  $scope.userParams = {};
  $scope.data = {};
  $scope.current = {};
  $scope.data.map = AnalyticMaps.get({
    mapName: 'customers'
  }, function () {
    $scope.current = {
      dimension: _.find($scope.data.map.dimensions, {
        name: $scope.params.dimension
      }) || {},
      metric: _.find($scope.data.map.metrics, {
        name: $scope.params.metric
      }) || {}
    };
  });
  $http({
    url: '/stats/customer',
    method: 'GET',
    params: $scope.params
  }).success(function (response) {
    $scope.saleData = response;
  }).error(function (error) {
    FhdMessenger.errorFromServer(error);
  });
  var startDate = $scope.params.startDate;
  var endDate = $scope.params.endDate;
  var previousDuration = moment.duration(moment(endDate).endOf('day').diff(moment(startDate)));
  var previousStartDate = moment(startDate).subtract(previousDuration).format('YYYY-MM-DD');
  var previousEndDate = moment(endDate).subtract(previousDuration).format('YYYY-MM-DD');
  $scope.previousStartDate = previousStartDate;
  $scope.previousEndDate = previousEndDate;
  $http({
    url: '/stats/customer',
    method: 'GET',
    params: _.assign({}, $scope.params, {
      startDate: previousStartDate,
      endDate: previousEndDate
    })
  }).success(function (response) {
    console.log('response', response);
    $scope.previousSaleData = response;
  }).error(function (error) {
    FhdMessenger.errorFromServer(error);
  });

  $scope.getLabel = function () {
    var match = _.find($scope.data.map.dimensions, {
      name: $scope.params.dimension
    });

    if (match) return match.labelPath;else return 'N/A';
  };

  $scope.removeParam = function (param) {
    $scope.params[param] = undefined;
  };

  $scope.getDimensionMap = function () {
    var match = _.find($scope.data.map.dimensions, {
      name: $scope.params.dimension
    });

    if (match) return match;else return null;
  };

  $scope.reload = function () {
    function loadCode(key) {
      var param = $scope.params[key];

      if (param) {
        param = param._id || param.code || param;
        if (!param || param === 'null') $scope.params[key] = null;else $scope.params[key] = param;
      }
    }

    loadCode('outlet');
    $scope.params.startDate = moment($scope.params.startDate).format('YYYY-MM-DD');
    $scope.params.endDate = moment($scope.params.endDate).format('YYYY-MM-DD');
    $state.go('customer-analytics', $scope.params);
  };

  $scope.$watch(function () {
    return $scope.params;
  }, function (newValue, oldValue) {
    if (newValue === oldValue) return;
    $scope.reload();
  }, true);
}]);
'use strict';

angular.module('reports').controller('CustomersReportController', ['$scope', 'Customers', function ($scope, Customers) {
  function createData(customers, customersWithAggregation) {}

  $scope.find = function () {
    $scope.customers = Customers.query(function (customers) {
      $scope.totalCustomers = customers.length;
      $scope.totalSignedUp = _.reduce(customers, function (total, customer) {
        if (customer.signedUp) return total + 1;
        return total;
      }, 0);
      $scope.totalFilledIn = _.reduce(customers, function (total, customer) {
        if (customer.filledIn) return total + 1;
        return total;
      }, 0);
    });
  };
}]);
'use strict';

angular.module('reports').controller('DashboardController', ['$scope', '$timeout', 'FhdSearchEvent', 'OutletService', 'ShiftService', function ($scope, $timeout, FhdSearchEvent, OutletService, ShiftService) {
  $scope.data = '4handy rocks!';
  $scope.startDate = new Date();
  $scope.endDate = new Date();

  $scope.search = function () {
    FhdSearchEvent.broadcast();
  };

  function compareInputs(newValue, oldValue) {
    if (oldValue.startDate && oldValue.endDate && oldValue.outlet && oldValue.shift) return false;
    if (newValue.startDate && newValue.endDate && newValue.outlet && newValue.shift) return true;
    return false;
  }

  $scope.$watch(function () {
    return {
      startDate: $scope.startDate,
      endDate: $scope.endDate,
      outlet: $scope.outlet,
      shift: $scope.shift
    };
  }, function (newValue, oldValue) {
    if (compareInputs(newValue, oldValue)) {
      $scope.search();
    }
  }, true);
}]);
"use strict";

angular.module('reports').controller('ExportDataController', ['ProductService', '$http', 'Businesses', 'FhdMessenger', 'NgTableParams', 'Outlets', 'InventoryCounts', function (ProductService, $http, Businesses, FhdMessenger, NgTableParams, Outlets, InventoryCounts) {
  const vm = this;
  vm.waiting = false;
  vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').format('YYYY-MM-DD');
  const link = 'https://work.4-handy.com/#!/stock-entries/';

  function getTimeContent(item, prop, format = 'YYYY-MM-DD') {
    const value = _.get(item, prop);

    if (value) {
      return moment(value).format(format);
    }

    return '';
  }

  vm.types = [{
    name: 'Dữ liệu hàng tiêu hủy',
    route: '/reports/trash-items',
    getRow: function () {
      return _.map(vm.items, function (item) {
        const row = {
          Outlet: _.get(item, 'outlet.code'),
          'Ngày tạo tiêu hủy': getTimeContent(item, 'created', 'YYYY/MM/DD HH:mm'),
          sku: item.sku,
          description: item.description,
          quantity: item.quantity,
          'Link LE': `=HYPERLINK("${link}${item._id.stockEntry}","${item.stockEntryId}")`,
          note: item.note,
          cogs: item.cogs,
          price: item.price,
          saleCodeId: item.saleCodeId,
          'Ngày Request SC': getTimeContent(item, 'createdSaleCode', 'YYYY/MM/DD HH:mm'),
          'Ngày duyệt SC': getTimeContent(item, 'approvedSaleCode', 'YYYY/MM/DD HH:mm'),
          HSD: getTimeContent(item, 'expriedSaleCode', 'YYYY/MM/DD HH:mm'),
          'Số ngày báo trước hết hạn': item.diff
        };
        return row;
      });
    }
  }, {
    name: 'Dữ liệu hàng chuyển cơ sở',
    route: '/reports/items-in-stock-entries',
    getRow: function () {
      return _.map(vm.items, function (item) {
        const row = {
          stockEntryId: item.stockEntryId,
          'Ngày nhận': getTimeContent(item, 'received', 'YYYY/MM/DD HH:mm'),
          outlet: _.get(item, 'outlet.code'),
          destination: _.get(item, 'destination.code'),
          receiver: _.get(item, 'receiver.displayName'),
          'Trạng thái': _.get(item, 'currentStatus'),
          sku: item.sku,
          description: item.description,
          quantity: item.quantity,
          cogs: item.cogs,
          totalCogs: item.totalCogs
        };
        return row;
      });
    }
  }];
  vm.itemsTable = new NgTableParams({
    count: 100
  });

  vm.exportFile = type => {
    const startDate = moment(vm.startDate).startOf('day').format('YYYY-MM-DD');
    const endDate = moment(vm.endDate).endOf('day').format('YYYY-MM-DD');
    const data = {
      startDate,
      endDate
    };
    data.destination = _.get(vm.destination, '_id');

    if (!data.destination) {
      return FhdMessenger.error('Chưa chọn nơi nhận hàng');
    }

    vm.waiting = true;
    let promise = $http.post(type.route, data).then(response => response.data).then(items => {
      vm.items = items;
      const newItems = type.getRow();
      alasql(`SELECT * INTO XLSX("${type.name}_${vm.destination.code}_${startDate}_${endDate}.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [newItems]);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
  };
}]);
'use strict';

angular.module('reports').controller('FhdDateInputController', ['$scope', function ($scope) {
  const vm = this;
  vm.opened = false;

  vm.open = function ($event) {
    $event.preventDefault();
    $event.stopPropagation();
    vm.opened = !vm.opened;
  };

  vm.dateChanged = function () {
    if (!vm.format) return;
    vm.date = moment(vm.date).isValid() ? moment(new Date(vm.date)) : moment();
    vm.date = vm.date.format(vm.format);
  };

  vm.dateOptions = {
    startingDay: 1
  };

  if (vm.onChange) {
    $scope.$watch('vm.date', (newValue, oldValue) => {
      if (newValue !== oldValue && newValue) vm.onChange(vm.date);
    });
  }
}]);
'use strict';

