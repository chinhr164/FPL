angular.module('user-photos').directive('fhdUserPhotoSelect', [function () {
  return {
    restrict: 'EA',
    scope: {
      onSelect: '='
    },
    controllerAs: 'vm',
    controller: ['$scope', 'UserPhotos', function ($scope, UserPhotos) {
      const vm = this;
      vm.userPhotos = UserPhotos.query({
        limit: 20,
        sort: '-created'
      });

      vm.onClick = (userPhoto, event) => {
        $scope.onSelect(userPhoto);
        event.currentTarget.children[0].classList.toggle('selected-image');
      };
    }],
    templateUrl: 'modules/user-photos/templates/fhd-user-photo-select.client.template.html'
  };
}]);
