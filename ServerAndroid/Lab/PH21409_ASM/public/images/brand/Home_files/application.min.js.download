angular.module('shipping-entries').controller('ModalCreateShippingEntryController', ['data', '$modalInstance', 'Authentication', '$modal', 'FhdMessenger', 'ShippingEntries', '$http', '$window', function (data, $modalInstance, Authentication, $modal, FhdMessenger, ShippingEntries, $http, $window) {
  const vm = this;
  vm.shippingEntry = {};

  if (data.onlineOrder) {
    const onlineOrder = data.onlineOrder;
    vm.shippingEntry.outlet = onlineOrder.assignedOutlet;
    vm.shippingEntry.provider = 'Ship nội bộ';
    vm.shippingEntry.paymentType = 'postpaid';
    vm.shippingEntry.destinations = [{
      cellphone: onlineOrder.receiverCustomer.cellphone,
      name: onlineOrder.receiverCustomer.name,
      address: onlineOrder.receiverCustomer.address,
      onlineOrder: onlineOrder._id
    }];
  }

  vm.user = Authentication.user;

  vm.create = () => {
    if (!vm.shippingEntry.staff) {
      return FhdMessenger.error('Bạn phải chọn nhân viên ship hàng');
    }

    const shippingEntry = new ShippingEntries(vm.shippingEntry);
    return shippingEntry.$save().then(shippingEntry => {
      FhdMessenger.success('Tạo đơn ship thành công!');
      return shippingEntry;
    }).then(shippingEntry => $modalInstance.close(shippingEntry)).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = $modalInstance.dismiss;

  vm.close = function () {
    $modalInstance.dismiss();
  };
}]);
"use strict";

