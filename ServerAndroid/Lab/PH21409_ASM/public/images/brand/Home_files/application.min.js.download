angular.module('price-tags').config(['$stateProvider', function ($stateProvider) {
  $stateProvider.state('printPriceTags', {
    url: '/price-tags/print',
    templateUrl: 'modules/price-tags/views/print-price-tags.client.view.html',
    resolve: {
      $title: _.constant('Print Price Tags')
    }
  });
}]);
"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('price-tags').controller('PrintPriceTagsController', ['FhdMessenger', 'ProductService', 'PromotionService', 'CurrentShift', '$window', 'ConfirmModal', function (FhdMessenger, ProductService, PromotionService, CurrentShift, $window, ConfirmModal) {
  const vm = this;
  vm.size = 'small';
  vm.data = {};

  vm.checkCurrentShift = () => {
    if (!_.get(CurrentShift.getCurrentShift(), 'outlet')) {
      FhdMessenger.info('Bạn chưa đăng nhập ca trực. Giá sản phẩm có thể sẽ không chính xác!');
    }
  };

  vm.items = [];

  vm.addToList = item => {
    const matchItem = _.find(vm.items, {
      _id: item._id
    });

    if (matchItem) {
      FhdMessenger.info(`${item.sku} ${item.description} đã có trong danh sách`);
      return;
    }

    const newItem = _.clone(item);

    if (newItem.description.length >= 45) newItem.smallTitle = true;
    const price = ProductService.getOutletProperty('price', _.get(CurrentShift.getCurrentShift(), 'outlet'), item);
    let salePrice = ProductService.getOutletProperty('salePrice', _.get(CurrentShift.getCurrentShift(), 'outlet'), item);

    if (salePrice >= price) {
      salePrice = null;
    }

    vm.items.unshift(_objectSpread({}, newItem, {
      price,
      salePrice
    }));
  };

  vm.removeItem = (index, items) => {
    items.splice(index, 1);
  };

  vm.barcodeOptions = {
    format: 'CODE128',
    lineColor: '#000000',
    background: 'rgba(255, 0, 0, 0)',
    width: 1.4,
    height: 40,
    displayValue: true,
    fontOptions: 'bold',
    font: 'Arial',
    textAlign: 'center',
    textPosition: 'bottom',
    textMargin: 2,
    fontSize: 12,
    margin: 0,
    marginTop: 0,
    marginBottom: 0,
    marginLeft: 0,
    marginRight: 0
  };

  vm.loadProducts = function () {
    ProductService.getAllSellingProductsFromServer().then(products => {
      vm.data.products = products;
    });
  };

  vm.now = function () {
    return moment().toDate();
  };

  vm.import = function () {
    vm.skus = vm.importContent.split(/[\n\t ,]/);

    _.forEach(vm.skus, sku => {
      const matchProduct = _.find(vm.data.products, {
        sku: sku
      });

      if (!matchProduct) return FhdMessenger.error(`Không thấy mã ${sku}`);
      return vm.addToList(matchProduct);
    });
  };

  vm.clearPriceTags = () => {
    ConfirmModal.show({}, {
      closeButtonText: 'Không',
      actionButtonText: 'Xóa hết danh sách',
      headerText: 'Bạn chắc chưa?',
      bodyText: 'Bạn có chắc là muốn xóa toàn bộ danh sách in tag giá?'
    }).then(() => {
      vm.items = [];
    });
  };

  vm.printPriceTags = function () {
    const printContents = $window.document.getElementById('print-content').innerHTML;
    let frame1 = $window.document.createElement('iframe');
    frame1.name = 'frame1';
    frame1.style.position = 'absolute';
    frame1.style.top = '-1000000px';
    $window.document.body.appendChild(frame1);
    let frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
    frameDoc.document.open();
    frameDoc.document.write(`
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="Content-type" content="text/html;charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <link rel="stylesheet" type="text/css" href="${$window.document.location.origin}/css/bootstrap-theme.css"/>
    <link rel="stylesheet" type="text/css" href="${$window.document.location.origin}/modules/core/css/core.css"/>
    <link rel="stylesheet" type="text/css" href="${$window.document.location.origin}/modules/price-tags/css/price-tags.css"/>
  </head>
  <body>
    <script type="text/javascript" src="${$window.document.location.origin}/lib/jquery/dist/jquery.min.js"></script>
    <div class="print-content-container">
    ${printContents}
    </div>
    <script>
      $(function(){
        setTimeout(function(){
          window.print()
        }, 1000)
      })
    </script>
  </body>
</html>
        `);
    frameDoc.document.close();
    return false;
  };
}]);
"use strict";

