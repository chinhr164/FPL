angular.module('stocks').directive('fhdStickyColumns', [() => {
  return {
    element: 'A',
    link: (scope, element) => {
      const numCols = parseInt(element.attr('fhd-sticky-columns'));
      scope.$watch(() => {
        return element[0].children.length;
      }, () => {
        const cols = angular.element(element).find('td');

        if (cols.length > numCols) {
          let currentWidth = 0;

          _.range(numCols).forEach(colIndex => {
            const elm = cols[colIndex];
            elm.style.position = 'sticky';
            elm.style.left = `${currentWidth}px`;
            elm.style.backgroundColor = '#fff';
            elm.style.zIndex = 10;
            currentWidth += elm.offsetWidth;
          });
        }
      });
    }
  };
}]);
