angular.module('evaluation-entries').controller('AssessEvaluationEntryController', ['Authentication', 'FhdMessenger', 'ConfirmModal', 'helper', 'EvaluationEntries', '$stateParams', '$state', '$localStorage', function (Authentication, FhdMessenger, ConfirmModal, helper, EvaluationEntries, $stateParams, $state, $localStorage) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;

  vm.findOne = () => {
    vm.waiting = true;
    vm.evaluationEntry = EvaluationEntries.get({
      evaluationEntryId: $stateParams.evaluationEntryId
    }).$promise.then(evaluationEntry => {
      vm.evaluationEntry = evaluationEntry;
      const formFields = $localStorage.getObject(`${evaluationEntry._id}evaluationEntryForms`);

      if (_.get(formFields, 'length', 0) && !vm.evaluationEntry.notUpdateFromLocal) {
        vm.evaluationEntry.formFields = formFields;
      }
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.saveIntoLocalStorage = () => {
    $localStorage.setObject(`${vm.evaluationEntry._id}evaluationEntryForms`, _.clone(vm.evaluationEntry.formFields));
  };

  vm.assess = () => {
    if (_.some(vm.evaluationEntry.formFields, formField => {
      return !formField.answer;
    })) {
      return FhdMessenger.error('Bạn cần điền đủ câu trả lời cho tất cả các mục');
    }

    ConfirmModal.showModal({}, {
      bodyText: 'Bạn muốn gửi đi nội dung tự đánh giá của mình? Bạn sẽ chỉ được gửi nội dung đánh giá 1 lần'
    }).then(() => {
      vm.waiting = true;
      vm.evaluationEntry.$assess().then(() => {
        $localStorage.setObject(`${vm.evaluationEntry._id}evaluationEntryForms`, []);
        FhdMessenger.success('Đánh giá KQCV thành công');
        $state.go('viewEvaluationEntry', {
          evaluationEntryId: vm.evaluationEntry._id
        });
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('evaluation-entries').controller('EvaluationEntriesController', ['$stateParams', '$location', '$scope', 'Authentication', 'EvaluationEntries', 'FhdMessenger', 'NgTableParams', 'ObjectId', '$window', '$http', 'helper', 'ConfirmModal', function ($stateParams, $location, $scope, Authentication, EvaluationEntries, FhdMessenger, NgTableParams, ObjectId, $window, $http, helper, ConfirmModal) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.evaluationEntriesTable = new NgTableParams({
    count: 50
  });

  vm.init = () => {
    vm.startDate = moment().subtract(1, 'month').startOf('month').format('YYYY-MM-DD');
    vm.endDate = moment(vm.startDate).endOf('month').format('YYYY-MM-DD');
    vm.summaryTable = new NgTableParams({
      count: 100
    });
    vm.fineMoney = 0;
    vm.fineMoney = 0;
  };

  vm.removeItems = (evaluationEntry, index, type) => {
    switch (type) {
      case 'REVIEW':
        evaluationEntry.formFields.reviews.splice(index, 1);
        break;

      case 'BONUS':
        evaluationEntry.formFields.bonuses.splice(index, 1);
        break;

      case 'FINE':
        evaluationEntry.formFields.fines.splice(index, 1);
        break;

      default:
    }
  };

  vm.cancelAction = evaluationEntry => {
    evaluationEntry.editing = false;
  };

  vm.handleUpdateFormField = evaluationEntry => {
    if (!evaluationEntry.formField.review) {
      return FhdMessenger.error('Bạn chưa nhập nội dung đánh giá');
    }

    vm.waiting = true;
    $http.put(`/evaluation-entries/${evaluationEntry._id}/review`, {
      formField: evaluationEntry.formField
    }).then(() => {
      return FhdMessenger.success('Cập nhật thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      evaluationEntry.editing = false;
      vm.waiting = false;
    });
  };

  vm.find = () => {
    vm.waiting = true;
    EvaluationEntries.query({
      startDate: vm.startDate,
      endDate: vm.endDate,
      outlet: ObjectId.getObjectId(vm.outlet),
      lineManager: ObjectId.getObjectId(vm.lineManager)
    }).$promise.then(async evaluationEntries => {
      vm.evaluationEntriesTable.settings({
        dataset: evaluationEntries
      });
      summary(evaluationEntries);
      FhdMessenger.success('Tìm xong!');
    }).finally(() => {
      vm.waiting = false;
    });
  };

  async function summary(evaluationEntries) {
    const evaluationFormByStaff = _.groupBy(evaluationEntries, 'staff.code');

    const summary = _.reduce(evaluationFormByStaff, (result, evaluationEntries) => {
      const staff = _.head(evaluationEntries).staff;

      const fineMoney = _.sumBy(evaluationEntries, evaluationEntry => _.get(evaluationEntry, 'formField.fineMoney', 0));

      const prizeMoney = _.sumBy(evaluationEntries, evaluationEntry => _.get(evaluationEntry, 'formField.prizeMoney', 0));

      result.push({
        _id: staff._id,
        code: staff.code,
        displayName: staff.displayName,
        position: _.get(staff, 'position'),
        outletCode: _.get(evaluationEntries, '0.outlet.code'),
        staffType: _.get(evaluationEntries, '0.staffType'),
        prizeMoney,
        fineMoney
      });
      return result;
    }, []);

    const userIds = _.uniq(_.map(evaluationEntries, 'staff._id'));

    const sticketAndThumbups = await getSticketsAndThumbUps(userIds);
    const totalWorkDay = await getTotalWorkDay(userIds);
    const userMap = helper.makeMap(sticketAndThumbups, '_id');
    const workDayMap = helper.makeMap(totalWorkDay, '_id');

    _.forEach(summary, staff => {
      const matchUser = userMap[staff._id];
      staff.workDays = _.get(workDayMap[staff._id], 'workDays', 0);
      staff.totalTicketValue = matchUser.fineMoney || 0;
      staff.totalThumbUpsValue = matchUser.prizeMoney || 0;
      staff.totalValue = staff.prizeMoney - staff.fineMoney + staff.totalThumbUpsValue - staff.totalTicketValue;
    });

    vm.summaryFineMoney = _.sumBy(summary, staff => _.get(staff, 'fineMoney', 0));
    vm.summaryPrizeMoney = _.sumBy(summary, staff => _.get(staff, 'prizeMoney', 0));
    vm.summaryTicketValue = _.sumBy(summary, staff => _.get(staff, 'totalTicketValue', 0));
    vm.summaryThumbUpValue = _.sumBy(summary, staff => _.get(staff, 'totalThumbUpsValue', 0));
    vm.summaryTotalValue = vm.summaryThumbUpValue + vm.summaryPrizeMoney - vm.summaryFineMoney - vm.summaryTicketValue;
    vm.summaryTable.settings({
      dataset: summary
    });
  }

  function getSticketsAndThumbUps(userIds) {
    if (!_.get(userIds, 'length')) {
      return [];
    }

    return EvaluationEntries.getSticketsAndThumbUps({
      userIds,
      startDate: vm.startDate,
      endDate: vm.endDate
    }).$promise.then(res => {
      return res;
    });
  }

  function getTotalWorkDay(userIds) {
    if (!_.get(userIds, 'length')) {
      return [];
    }

    return EvaluationEntries.getTotalWorkDay({
      userIds,
      startDate: vm.startDate,
      endDate: vm.endDate
    }).$promise.then(res => {
      return res;
    });
  }

  $scope.$watch(() => vm.evaluationEntriesTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.fineMoney = _.sumBy(newValue, obj => {
      return _.get(obj, 'formField.fineMoney', 0);
    });
    vm.prizeMoney = _.sumBy(newValue, obj => {
      return _.get(obj, 'formField.prizeMoney', 0);
    });
  });

  vm.findOne = () => {
    vm.evaluationEntry = EvaluationEntries.get({
      evaluationEntryId: $stateParams.evaluationEntryId
    }).$promise.then(evaluationEntry => {
      vm.evaluationEntry = evaluationEntry;
      vm.showReview = moment().isAfter(moment(evaluationEntry.month).add(1, 'month').date(9).endOf('day'));
    });
  };

  vm.update = () => {
    vm.waiting = true;
    vm.evaluationEntry.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('evaluation-entries');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

