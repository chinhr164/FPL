angular.module('core').factory('Sockets', ['$window', function ($window) {
  let transports = ['websocket'];

  if ($window.Cypress) {
    transports = ['polling', 'websocket'];
  }

  if ($window.io) {
    const socket = $window.io({
      timeout: 10000,
      transports
    });
    return socket;
  }

  return {
    // For safety reason
    on: _.noop,
    noSocket: true,
    removeListener: _.noop
  };
}]);
