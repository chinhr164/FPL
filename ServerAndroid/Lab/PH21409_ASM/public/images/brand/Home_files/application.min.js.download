angular.module('sale-codes').factory('SaleCodeService', ['$modal', function ($modal) {
  function openViewOutletReportForSaleCode(saleCode) {
    return $modal.open({
      animation: true,
      controller: 'ModalOutletReportForSaleCodeController',
      controllerAs: 'vm',
      size: 'lg',
      templateUrl: '/modules/sale-codes/views/modal-outlet-reports-for-sale-code.client.view.html',
      resolve: {
        saleCode: function () {
          return saleCode;
        }
      }
    }).result;
  }

  function openUpdateSalePriceForSaleCode(saleCode) {
    return $modal.open({
      animation: true,
      controller: 'ModalSalePriceController',
      controllerAs: 'vm',
      size: 'lg',
      templateUrl: '/modules/sale-codes/views/modal-change-sale-price.client.view.html',
      resolve: {
        saleCode: function () {
          return saleCode;
        }
      }
    }).result;
  }

  function openModalSaleCodeDetail(saleCode) {
    return $modal.open({
      animation: true,
      controller: 'ModalSaleCodeDetailsController',
      controllerAs: 'vm',
      size: 'lg',
      templateUrl: '/modules/sale-codes/views/modal-sale-code-details.client.view.html',
      resolve: {
        saleCode: function () {
          return saleCode;
        }
      }
    }).result;
  }

  function openRequestTransferForSaleCode(saleCode) {
    return $modal.open({
      animation: true,
      controller: 'ModalRequestTransferController',
      controllerAs: 'vm',
      size: 'lg',
      templateUrl: '/modules/sale-codes/views/modal-request-transfer-for-sale-code.client.view.html',
      resolve: {
        saleCode: function () {
          return saleCode;
        }
      }
    }).result;
  }

  return {
    openViewOutletReportForSaleCode,
    openUpdateSalePriceForSaleCode,
    openRequestTransferForSaleCode,
    openModalSaleCodeDetail
  };
}]);
