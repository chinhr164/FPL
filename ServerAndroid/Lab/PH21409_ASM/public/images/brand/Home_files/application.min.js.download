angular.module('products').factory('ProductStringTagsService', ['$http', function ($http) {
  let getProductStringTagsPromise = null;
  return {
    getProductStringTags() {
      if (!getProductStringTagsPromise) {
        getProductStringTagsPromise = $http.get('/products/string-tags').then(response => response.data);
      }

      return getProductStringTagsPromise;
    }

  };
}]);
"use strict";

angular.module('products').factory('ProductWeight', [function () {
  function getWeight(description, netWeight) {
    if (netWeight > 0) {
      return netWeight;
    }

    if (description.match(/đơn vị 100g, gói khoảng/)) {
      return 0.1;
    }

    if (description.match(/\(g\)/)) {
      return 0.01;
    }

    if (description.match(/\(kg\)/)) {
      return 1;
    }

    const matchMiliLitter = description.match(/\d*[.,]?\d+ml/gi);

    if (matchMiliLitter) {
      const match = _.last(matchMiliLitter).replace(/ml/i, '').replace(',', '.');

      const weight = parseFloat(match);
      return (weight || 0) / 1000;
    }

    const matchKilogram = description.match(/\d*[.,]?\d+kg/gi);

    if (matchKilogram) {
      const match = _.last(matchKilogram).replace(/kg/i, '').replace(',', '.');

      const weight = parseFloat(match);
      return weight || 0;
    }

    const matchGram = description.match(/\d*[.,]?\d+g/gi);

    if (matchGram) {
      const match = _.last(matchGram).replace(/g/i, '').replace(',', '.');

      const weight = parseFloat(match);
      return (weight || 0) / 1000;
    }

    const matchLitter = description.match(/\d*[.,]?\d+l/gi);

    if (matchLitter) {
      const match = _.last(matchLitter).replace(/l/i, '').replace(',', '.');

      const weight = parseFloat(match);
      return weight || 0;
    }

    if (description.match(/đế pizza/i)) {
      if (description.match(/24cm/)) {
        return 0.8;
      }

      return 0.6;
    }

    return 0;
  }

  return {
    getWeight
  };
}]);
