angular.module('reports').controller('FhdShiftInputController', ['$scope', 'FhdMessenger', 'ShiftService', 'ObjectId', function ($scope, FhdMessenger, ShiftService, ObjectId) {
  const vm = $scope;
  const extendShifts = ShiftService.getExtendShifts();
  vm.data = {};

  _.defaults(vm, {
    loadDefault: true,
    loadNext: false
  });

  vm.emptyOption = _.isUndefined(vm.emptyOption) ? false : vm.emptyOption;
  vm.showExtendShift = _.isUndefined(vm.showExtendShift) ? false : vm.showExtendShift;
  vm.loadDefault = vm.loadDefault === 'false' || vm.loadDefault === false ? false : vm.loadDefault;

  if (vm.emptyOption === true || vm.emptyOption === 'true') {
    ShiftService.all(function (err, shifts) {
      vm.data.allShifts = shifts;

      if (err) {
        FhdMessenger.error(err);
      }
    });
  } else {
    ShiftService.withAllOption(function (err, shifts) {
      vm.data.allShifts = shifts;

      if (err) {
        FhdMessenger.error(err);
      }
    });
  }

  if (vm.showExtendShift === true || vm.showExtendShift === 'true') {
    vm.data.allShifts = [...vm.data.allShifts, ...extendShifts];
  }

  vm.data.shifts = _.sortBy(vm.data.allShifts, 'name');

  vm.getDefaultShift = () => {
    if (vm.shift) {
      vm.shift = _.find(vm.data.shifts, {
        code: ObjectId.getObjectId(vm.shift)
      });
    }

    if (vm.loadDefault) {
      const currentShift = ShiftService.currentShift();
      vm.shift = _.find(vm.data.shifts, {
        code: currentShift.code
      });
    }

    if (vm.loadNext) {
      const nextShift = ShiftService.getNextShift();
      vm.shift = _.find(vm.data.shifts, {
        code: nextShift.code
      });
    }
  };

  $scope.$watch('shift', (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;

    const shift = _.find(vm.data.shifts, shift => {
      const shiftCode = _.get(newValue, 'code', newValue);

      return shift.code === shiftCode;
    });

    vm.shift = shift;
    if (!_.isUndefined(oldValue) && !_.isUndefined(newValue)) return;
    vm.getDefaultShift();
  });
  $scope.$watch('outlet', (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    vm.data.shifts = _.sortBy(_.filter(vm.data.allShifts, shift => {
      return _.some(newValue.shifts, {
        shift: shift.code
      });
    }), 'name');
  });
}]);
"use strict";

angular.module('reports').controller('FindCustomersController', ['ProductGroups', 'ProductDepartments', 'ProductCats', 'ProductSubCats', 'ProductService', '$http', 'FhdMessenger', 'NgTableParams', 'Outlets', 'CustomerService', 'Authentication', 'Businesses', function (ProductGroups, ProductDepartments, ProductCats, ProductSubCats, ProductService, $http, FhdMessenger, NgTableParams, Outlets, CustomerService, Authentication, Businesses) {
  const vm = this;
  vm.startDate = moment().subtract(30, 'day').startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').format('YYYY-MM-DD');
  const user = Authentication.user;
  vm.isAdmin = _.includes(user.roles, 'admin');
  vm.data = {
    productGroups: ProductGroups.query(),
    productDepartments: ProductDepartments.query(),
    productCats: ProductCats.query(),
    productSubCats: ProductSubCats.query(),
    outlets: Outlets.query(),
    businesses: Businesses.query()
  };
  ProductService.fullDescriptionAsync().then(products => {
    vm.data.products = products;
  });
  vm.customersTable = new NgTableParams({
    count: 100
  });

  vm.filterCustomers = () => {
    const startDate = moment(vm.startDate).format('YYYY-MM-DD');
    const endDate = moment(vm.endDate).format('YYYY-MM-DD');
    const data = {
      startDate,
      endDate,
      outlet: _.get(vm.outlet, '_id') || undefined
    };
    if (vm.businesses) data.businesses = _.map(vm.businesses, '_id');
    if (vm.productGroups) data.productGroups = _.map(vm.productGroups, '_id');
    if (vm.productDepartments) data.productDepartments = _.map(vm.productDepartments, '_id');
    if (vm.productCats) data.productCats = _.map(vm.productCats, '_id');
    if (vm.productSubCats) data.productSubCats = _.map(vm.productSubCats, '_id');
    if (vm.products) data.products = _.map(vm.products, '_id');
    if (vm.customers) data.customers = _.map(vm.customers, '_id');
    if (vm.outlets) data.outlets = _.map(vm.outlets, '_id');
    let promise = $http.post('/reports/customers', data).then(response => response.data).then(customers => {
      if (customers.length === 500) {
        FhdMessenger.info('Chỉ tải về 500 kết quả đầu tiên. Hãy thử thêm tiêu chí lọc để tải đầy đủ dữ liệu.');
      }

      vm.dataset = customers;
      vm.customersTable.settings({
        dataset: customers
      });
      vm.customersTable.sorting({
        revenue: 'desc'
      });
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
  };

  vm.openSaleEntriesModal = CustomerService.openSaleEntriesModal;

  vm.searchCustomers = searchText => {
    return CustomerService.searchCustomers(searchText).then(customers => {
      vm.searchingCustomers = customers || [];
      return customers || [];
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      vm.searchingCustomers = [];
      return [];
    }).finally(() => {
      vm.searchingCustomer = false;
    });
  };

  vm.export = () => {
    if (!_.get(vm.dataset, 'length')) {
      return FhdMessenger.error('Chưa có dữ liệu để xuất.');
    }

    const dataset = _.map(vm.dataset, (customer, index) => ({
      id: index,
      customerId: _.get(customer, 'customer.customerId'),
      fullName: _.get(customer, 'customer.fullName'),
      cellphone: _.get(customer, 'customer.fullName'),
      age: _.get(customer, 'age'),
      outletCode: _.get(customer, 'outlet.code'),
      revenue: _.get(customer, 'revenue'),
      profit: _.get(customer, 'profit'),
      discount: _.get(customer, 'discount'),
      noOrder: _.get(customer, 'noOrder')
    }));

    const now = moment().format('YYYY-MM-DD');
    return alasql('SELECT * INTO XLS("export-customers-' + now + '.xls",{headers:true}) FROM ?', [dataset]);
  };
}]);
'use strict';

angular.module('reports').controller('FindItemsController', ['$state', 'ProductGroups', 'ProductDepartments', 'ProductCats', 'ProductSubCats', 'ProductService', '$http', 'FhdMessenger', 'NgTableParams', 'Outlets', 'CustomerService', 'Authentication', function ($state, ProductGroups, ProductDepartments, ProductCats, ProductSubCats, ProductService, $http, FhdMessenger, NgTableParams, Outlets, CustomerService, Authentication) {
  const vm = this;
  vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.noLoyalty = null;
  vm.isBundle = null;
  vm.products = [];
  const user = Authentication.user;

  if (_.get(user, 'outlet.code', '').match(/S\d+/)) {
    FhdMessenger.error('Bạn không được dùng chức năng này');
    return $state.go('home');
  }

  vm.isAdmin = _.includes(user.roles, 'admin');
  vm.data = {
    productGroups: ProductGroups.query(),
    productDepartments: ProductDepartments.query(),
    productCats: ProductCats.query(),
    productSubCats: ProductSubCats.query(),
    outlets: Outlets.query({
      isPos: true,
      deleted: false
    })
  };
  ProductService.fullDescriptionAsync().then(products => {
    vm.data.products = products;
  });
  vm.operators = ['>=', '>', '=', '<', '<='];
  vm.compareProfit = {
    operator: null,
    value: null
  };
  vm.compareRevenue = {
    operator: null,
    value: null
  };
  vm.itemsTable = new NgTableParams({
    count: 100
  });
  vm.options = [{
    label: 'None',
    value: null
  }, {
    label: 'True',
    value: true
  }, {
    label: 'False',
    value: false
  }];

  vm.filterItems = () => {
    const startDate = moment(vm.startDate).format('YYYY-MM-DD');
    const endDate = moment(vm.endDate).format('YYYY-MM-DD');
    const data = {
      startDate,
      endDate,
      noLoyalty: vm.noLoyalty,
      isBundle: vm.isBundle
    };
    if (vm.productGroups) data.productGroups = _.map(vm.productGroups, '_id');
    if (vm.productDepartments) data.productDepartments = _.map(vm.productDepartments, '_id');
    if (vm.productCats) data.productCats = _.map(vm.productCats, '_id');
    if (vm.productSubCats) data.productSubCats = _.map(vm.productSubCats, '_id');
    if (vm.products) data.products = _.map(vm.products, '_id') || [];
    if (vm.customers) data.customers = _.map(vm.customers, '_id');
    if (vm.outlets) data.outlets = _.map(vm.outlets, '_id');
    data.tagProducts = [];

    if (vm.tags) {
      const addProducts = _.reduce(vm.tags, (products, tag) => {
        const addingProducts = _.filter(vm.data.products, {
          tag
        }) || [];
        return products.concat(addingProducts);
      }, []);

      data.tagProducts = _.map(_.uniqBy(addProducts, '_id'), '_id');
    }

    data.products = _.uniq(data.products.concat(data.tagProducts));
    if (_.get(vm.compareProfit, 'operator')) data.compareProfit = vm.compareProfit;
    if (_.get(vm.compareRevenue, 'operator')) data.compareRevenue = vm.compareRevenue;
    let promise = $http.post('/reports/items', data).then(response => response.data).then(items => {
      if (items.length === 1000) {
        FhdMessenger.info('Chỉ tải về 1000 kết quả đầu tiên. Hãy thử thêm tiêu chí lọc để tải đầy đủ dữ liệu.');
      }

      const totalRevenue = _.sumBy(items, 'revenue');

      const totalProfit = _.sumBy(items, 'profit');

      const totalQuantity = _.sumBy(items, 'quantity');

      const grossMargin = totalProfit / totalRevenue;
      vm.summary = {
        totalRevenue,
        totalProfit,
        totalQuantity,
        grossMargin
      };
      vm.itemsTable.settings({
        dataset: items
      });
      vm.itemsTable.sorting({
        revenue: 'desc'
      });
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
  };

  vm.openSaleEntriesModal = CustomerService.openSaleEntriesModal;

  vm.searchCustomers = searchText => {
    return CustomerService.searchCustomers(searchText).then(customers => {
      vm.searchingCustomers = customers || [];
      return customers || [];
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      vm.searchingCustomers = [];
      return [];
    }).finally(() => {
      vm.searchingCustomer = false;
    });
  };
}]);
"use strict";

/* global alasql */
angular.module('reports').controller('FindSaleEntriesController', ['ProductGroups', 'ProductDepartments', 'ProductCats', 'ProductSubCats', 'ProductService', '$http', 'FhdMessenger', 'NgTableParams', 'Outlets', 'CustomerService', 'SaleEntryService', 'Authentication', function (ProductGroups, ProductDepartments, ProductCats, ProductSubCats, ProductService, $http, FhdMessenger, NgTableParams, Outlets, CustomerService, SaleEntryService, Authentication) {
  const vm = this;
  vm.waiting = false;
  vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').format('YYYY-MM-DD');
  const user = Authentication.user;
  vm.isAdmin = _.includes(user.roles, 'admin');
  vm.isAdminStock = _.includes(user.roles, 'admin-stock');
  vm.isStockEntriesFind = _.includes(user.roles, 'sale-entry:find');
  vm.data = {
    productGroups: ProductGroups.query(),
    productDepartments: ProductDepartments.query(),
    productCats: ProductCats.query(),
    productSubCats: ProductSubCats.query(),
    outlets: Outlets.query({
      deleted: false,
      isPos: true
    })
  };
  ProductService.fullDescriptionAsync().then(products => {
    vm.data.products = products;
  });
  vm.saleEntriesTable = new NgTableParams({
    count: 100
  });
  vm.operators = ['>=', '>', '=', '<', '<='];
  vm.compareSaleTotal = {
    operator: null,
    value: null
  };
  vm.compareProfit = {
    operator: null,
    value: null
  };
  vm.compareRevenue = {
    operator: null,
    value: null
  };
  vm.options = [{
    label: 'None',
    value: null
  }, {
    label: 'True',
    value: true
  }, {
    label: 'False',
    value: false
  }];

  vm.filterSaleEntries = () => {
    const startDate = moment(vm.startDate).startOf('day').format('YYYY-MM-DD HH:mm:ss');
    const endDate = moment(vm.endDate).endOf('day').format('YYYY-MM-DD HH:mm:ss');
    const data = {
      startDate,
      endDate
    };
    if (vm.productGroups) data.productGroups = _.map(vm.productGroups, '_id');
    if (vm.productDepartments) data.productDepartments = _.map(vm.productDepartments, '_id');
    if (vm.productCats) data.productCats = _.map(vm.productCats, '_id');
    if (vm.productSubCats) data.productSubCats = _.map(vm.productSubCats, '_id');
    if (vm.products) data.products = _.map(vm.products, '_id');
    if (vm.outlets) data.outlets = _.map(vm.outlets, '_id');
    if (_.get(vm.compareSaleTotal, 'operator')) data.compareSaleTotal = vm.compareSaleTotal;
    if (_.get(vm.compareProfit, 'operator')) data.compareProfit = vm.compareProfit;
    if (_.get(vm.compareRevenue, 'operator')) data.compareRevenue = vm.compareRevenue;
    vm.waiting = true;
    let promise = $http.post('/reports/sale-entries', data).then(response => response.data).then(saleEntries => {
      if (saleEntries.length === 1000) {
        FhdMessenger.info('Chỉ tải về 1000 kết quả đầu tiên. Hãy thử thêm tiêu chí lọc để tải đầy đủ dữ liệu.');
      }

      vm.saleEntriesTable.settings({
        dataset: saleEntries
      });
      vm.saleEntriesTable.sorting({
        revenue: 'desc'
      });
      vm.saleEnries = saleEntries;
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
  };

  vm.exportFile = function () {
    const user = Authentication.user;
    if (!_.includes(user.roles, 'admin')) return;

    const saleEntries = _.map(_.filter(vm.saleEnries, saleEntry => saleEntry.cellphone), function (saleEntry) {
      return {
        saleEntryId: _.get(saleEntry, 'saleEntryId') || '',
        customerId: _.get(saleEntry, 'customer.customerId') || '',
        fn: _.get(saleEntry, 'firstName') || '',
        ln: _.get(saleEntry, 'lastName') || '',
        phone: _.get(saleEntry, 'cellphone') || '',
        gen: _.get(saleEntry, 'gender') || '',
        age: _.get(saleEntry, 'age') || '',
        doby: _.get(saleEntry, 'birthyear') || '',
        ct: _.get(saleEntry, 'city') || '',
        country: 'VN',
        value: _.get(saleEntry, 'saleTotal') || 0,
        event_name: 'Purchase',
        currency: 'VND',
        event_time: moment(saleEntry.created).toISOString()
      };
    });

    const now = moment().startOf('day').format('YYYY-MM-DD');
    alasql.promise(`SELECT * INTO XLSX("offline-conversion-${now}.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [saleEntries]).then(() => {
      FhdMessenger.success('Ok');
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.openSaleEntriesModal = CustomerService.openSaleEntriesModal;
  vm.viewSaleEntry = SaleEntryService.viewSaleEntry;

  vm.hasCellphone = saleEntry => saleEntry.cellphone;
}]);
"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('reports').controller('FindSaleStockEntriesBySkuController', ['Authentication', 'FhdMessenger', '$http', 'NgTableParams', 'SaleEntryService', '$q', function (Authentication, FhdMessenger, $http, NgTableParams, SaleEntryService, $q) {
  const vm = this;
  vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').format('YYYY-MM-DD');
  const user = Authentication.user;
  vm.isAdmin = _.includes(user.roles, 'admin');
  vm.isAdminStock = _.includes(user.roles, 'admin-stock');
  vm.waiting = false;
  vm.quantitySaleEntriesTotal = 0;
  vm.quantityExportTotal = 0;
  vm.quantityImportTotal = 0;

  vm.addProduct = function (product) {
    vm.product = product;
  };

  vm.viewSaleEntry = SaleEntryService.viewSaleEntry;
  vm.dataEntries = new NgTableParams({
    count: 20
  });

  vm.filter = async function () {
    if (!vm.product) return FhdMessenger.error('Chưa chọn sản phẩm');
    const startDate = moment(vm.startDate).startOf('day').format('YYYY-MM-DD HH:mm:ss');
    const endDate = moment(vm.endDate).endOf('day').format('YYYY-MM-DD HH:mm:ss');
    const data = {
      products: [],
      outlets: [],
      startDate,
      endDate
    };
    if (vm.product) data.products.push(_.get(vm.product, '_id'));
    if (vm.outlet) data.outlets.push(_.get(vm.outlet, '_id'));
    vm.waiting = true;
    vm.dataEntries.settings({
      dataset: []
    });
    vm.quantitySaleEntriesTotal = 0;
    vm.quantityExportTotal = 0;
    vm.quantityImportTotal = 0;
    const saleEntries = $http.post('/reports/sale-entries', data).then(response => response.data);
    const stockEntries = $http.post('/reports/stock-entries', {
      products: data.products,
      outlets: [...data.outlets],
      destinations: [...data.outlets],
      startDate: data.startDate,
      endDate: data.endDate,
      byDelivered: true,
      byReceived: true
    }).then(response => response.data);
    let promise = $q.all([saleEntries, stockEntries]).then(function ([saleEntries, stockEntries]) {
      if (!saleEntries.length && !stockEntries.length) {
        return FhdMessenger.info('Không có kết quả nào.');
      }

      let data = _.reduce(saleEntries, (result, saleEntry) => {
        result.push(_objectSpread({}, saleEntry, {
          time: saleEntry.created,
          saleQuantity: saleEntry.quantity
        }));
        return result;
      }, []);

      data = _.reduce(stockEntries, (result, stockEntry) => {
        if (stockEntry.outlet !== null && _.get(stockEntry, 'outlet.code', '') === _.get(vm, 'outlet.code') || !vm.outlet) {
          result.push(_objectSpread({}, stockEntry, {
            time: stockEntry.delivered,
            exportQuantity: stockEntry.quantity
          }));
        }

        if (stockEntry.received && _.get(stockEntry, 'destination.code', '') === _.get(vm, 'outlet.code', '') || !vm.outlet) {
          result.push(_objectSpread({}, stockEntry, {
            time: stockEntry.received,
            importQuantity: stockEntry.quantity
          }));
        }

        return result;
      }, data);
      vm.dataEntries.settings({
        dataset: _.orderBy(data, 'time', 'desc')
      });
      vm.quantitySaleEntriesTotal = sum(data, 'saleQuantity');
      vm.quantityExportTotal = sum(data, 'exportQuantity');
      vm.quantityImportTotal = sum(data, 'importQuantity');
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
  };

  function sum(data, field) {
    return _.sumBy(data, field);
  }
}]);
'use strict';

angular.module('reports').controller('FindStockEntriesController', ['ProductService', '$http', 'Businesses', 'FhdMessenger', 'NgTableParams', 'Outlets', 'InventoryCounts', 'StockEntryService', function (ProductService, $http, Businesses, FhdMessenger, NgTableParams, Outlets, InventoryCounts, StockEntryService) {
  const vm = this;
  vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.products = [];

  vm.addProduct = product => {
    vm.products = vm.products || [];

    const matchProduct = _.find(vm.products, {
      _id: product._id
    });

    if (!matchProduct) {
      vm.products.push({
        _id: product._id,
        sku: product.sku,
        description: product.description
      });
    }
  };

  vm.removeItem = index => {
    vm.products.splice(index, 1);
  };

  vm.data = {
    outlets: Outlets.query({
      deleted: false
    }),
    businesses: Businesses.query({
      deleted: false
    })
  };
  vm.stockEntriesTable = new NgTableParams({
    count: 100
  });
  vm.getCurrentStatuses = StockEntryService.getAllStatuses;

  vm.filterStockEntries = () => {
    const startDate = moment(vm.startDate).format('YYYY-MM-DD');
    const endDate = moment(vm.endDate).format('YYYY-MM-DD');
    const data = {
      startDate,
      endDate,
      toIncludeNotReceived: true
    };
    if (_.get(vm, 'products.length')) data.products = _.map(vm.products, '_id');
    if (_.get(vm, 'outlets.length')) data.outlets = _.map(vm.outlets, '_id');
    if (_.get(vm, 'destinations.length')) data.destinations = _.map(vm.destinations, '_id');
    if (_.get(vm, 'businesses.length')) data.businesses = _.map(vm.businesses, '_id');
    let promise = $http.post('/reports/stock-entries', data).then(response => response.data).then(stockEntries => {
      if (stockEntries.length === 1000) {
        FhdMessenger.info('Chỉ tải về 1000 kết quả đầu tiên. Hãy thử thêm tiêu chí lọc để tải đầy đủ dữ liệu.');
      }

      _.forEach(stockEntries, stockEntry => {
        stockEntry.name = stockEntry.stockEntryId + _.get(stockEntry, 'inventoryCount.name', '');
      });

      vm.stockEntriesTable.settings({
        dataset: stockEntries
      });
      vm.stockEntriesTable.sorting({
        delivered: 'desc'
      });
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
  };
}]);
"use strict";

angular.module('reports').controller('OpenCommentController', ['$window', function ($window) {
  const vm = this;

  vm.open = () => {
    if (!vm.link) return; // https://business.facebook.com/abbyvietnam/photos/a.1621842588141775.1073741828.1616903755302325/1817811095211589/?type=3&comment_id=774451849372760&force_theater=true&ref=notif&notif_t=photo_comment&notif_id=1491055494027168&business_id=286294235044140

    const newLink = vm.link.replace('force_theater=true', 'force_theater=false');
    vm.link = '';
    $window.open(newLink);
  };
}]);
