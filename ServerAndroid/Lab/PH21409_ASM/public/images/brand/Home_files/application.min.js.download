angular.module('income-statement').controller('IncomeStatementController', ['BusinessService', '$http', 'FhdMessenger', 'ObjectId', 'IncomeStatementService', 'Authentication', function (BusinessService, $http, FhdMessenger, ObjectId, IncomeStatementService, Authentication) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {
    business: null,
    endDate: moment().format('YYYY-MM-DD'),
    startDate: moment().startOf('month').format('YYYY-MM-DD')
  };

  vm.init = () => {
    vm.initPromise = BusinessService.withAllOptionAsync().then(businesses => {
      vm.data.business = _.find(businesses, {
        code: 'ABBY'
      });
      vm.load();
    });
  };

  vm.exceptCentralOutlets = (outletCode, text) => {
    if (text === 'Chi phí vận hành' || text === 'Phí nhượng quyền cơ sở') {
      return false;
    }

    if (_.includes(vm.centralOutletCodes, outletCode)) {
      return true;
    }

    return false;
  };

  vm.reset = () => {
    vm.data.sections = [];
    vm.data.outletCodes = [];
  };

  vm.load = () => {
    vm.reset();
    vm.initPromise.then(() => {
      if (!vm.data.endDate) {
        return FhdMessenger.error('Hãy chọn một ngày kết thúc trong tháng cần tính BCTC!');
      }

      if (!vm.data.startDate) {
        return FhdMessenger.error('Hãy chọn một ngày bắt đầu trong tháng cần tính BCTC!');
      }

      if (!ObjectId.getObjectId(vm.data.business)) {
        return FhdMessenger.error('Hãy chọn 1 business!');
      }

      vm.waiting = true;
      let promise = $http.get('/income-statement', {
        params: {
          business: ObjectId.getObjectId(vm.data.business),
          startDate: moment(vm.data.startDate).format('YYYY-MM-DD'),
          endDate: moment(vm.data.endDate).format('YYYY-MM-DD')
        }
      }).then(response => {
        const data = response.data;
        vm.data.sections = data.sections;
        vm.data.outletCodes = data.outletCodes;
        vm.centralOutletCodes = data.centralOutletCodes;
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
      FhdMessenger.notifyLoading('Đang tải...', promise, promise => {
        vm.entries = promise;
        FhdMessenger.success('Tải xong');
      });
    });
  };

  vm.openAddPassCostModal = () => {
    IncomeStatementService.openAddPassCoseModal();
  };
}]);
"use strict";

angular.module('income-statement').controller('ModalAddPassCostController', ['$http', 'FhdMessenger', 'ObjectId', 'OutletService', '$scope', 'AccountingRows', '$modalInstance', function ($http, FhdMessenger, ObjectId, OutletService, $scope, AccountingRows, $modalInstance) {
  const vm = this;
  vm.accountingRow = {};
  vm.accountingRow.date = moment().subtract(1, 'month').startOf('month').format('YYYY-MM-DD');
  vm.costCategories = ['Chi phí ship hàng restock', 'Chiết khấu đối tác', 'Chi phí ship hàng online', 'Lương nhân viên', 'Chi phí Overhead', 'Khấu hao tài sản cố định', 'Điện, nước, mạng, vệ sinh cơ sở', 'Chi phí duy trì hoạt động cơ sở', 'Thuê sửa chữa', 'Lương quản lý', 'Thuê cửa hàng', 'Chi phí vận hành', 'Phí nhượng quyền cơ sở'];

  vm.close = () => {
    $modalInstance.close();
  };

  vm.init = () => {
    vm.outletMap = OutletService.allAsync().then(outlets => {
      vm.outletMap = _.sortBy(outlets, 'code');
    });
  };

  vm.update = () => {
    if (!vm.accountingRow.text) {
      return FhdMessenger.error('Chưa chọn loại chi phí');
    }

    if (!vm.accountingRow.business) {
      return FhdMessenger.error('Chưa có business');
    }

    if (!_.some(vm.accountingRow.outlets, 'amount')) {
      return FhdMessenger.error('Chưa có cơ sở nào có chi phí');
    }

    $http.put(`/accounting-rows/${vm.accountingRow._id}`, vm.accountingRow).then(response => {
      FhdMessenger.success('Cập nhật thành công');
      vm.close();
    }).catch(err => FhdMessenger.error(err.data.message));
  };

  vm.create = () => {
    if (!vm.accountingRow.text) {
      return FhdMessenger.error('Chưa chọn loại chi phí');
    }

    if (!vm.accountingRow.business) {
      return FhdMessenger.error('Chưa có business');
    }

    if (!vm.accountingRow.date) {
      return FhdMessenger.error('Chưa chọn thời gian');
    }

    if (vm.accountingRow.text !== 'Thuê cửa hàng' && !_.some(vm.accountingRow.outlets, 'amount')) {
      return FhdMessenger.error('Chưa có cơ sở nào có chi phí');
    }

    const accountingRow = new AccountingRows(vm.accountingRow);
    accountingRow.$save().then(() => {
      FhdMessenger.success('Thêm chi phí thành công');
      vm.close();
    }).catch(err => FhdMessenger.error(err.data.message));
  };

  function getOutletByBusiness() {
    const businessCode = _.get(vm.accountingRow.business, 'code', null);

    const outlets = _.filter(vm.outletMap, outlet => {
      if (businessCode === 'ABBY') {
        return outlet.code.match(/^[ME]\d+/);
      }

      if (businessCode === 'SAVOR') {
        return outlet.code.match(/^[SK]\d+/);
      }

      return false;
    });

    vm.accountingRow.outlets = _.map(outlets, outlet => ({
      outlet: outlet._id,
      code: outlet.code,
      amount: 0
    }));
  }

  vm.findAccountingRow = () => {
    if (!vm.accountingRow.text) {
      return FhdMessenger.error('Chưa chọn loại chi phí');
    }

    if (!vm.accountingRow.business) {
      return FhdMessenger.error('Chưa có business');
    }

    if (!vm.accountingRow.date) {
      return FhdMessenger.error('Chưa có ngày');
    }

    vm.waiting = true;
    $http.get('/accounting-rows/findAccountingRow', {
      params: {
        business: vm.accountingRow.business._id,
        date: vm.accountingRow.date,
        text: vm.accountingRow.text
      }
    }).then(response => {
      if (response.data._id) {
        FhdMessenger.success('Tìm thấy rồi');
        vm.accountingRow = response.data;
      }
    }).catch(() => {
      FhdMessenger.error('Không tìm thấy!');
    }).finally(() => {
      vm.waiting = false;
    });
  };

  $scope.$watch(() => vm.accountingRow.business, () => {
    if (vm.accountingRow.business && !vm.accountingRow.user) getOutletByBusiness();
  });
  $scope.$watch(() => vm.accountingRow.date, () => {
    vm.accountingRow.date = moment(vm.accountingRow.date).format('YYYY-MM');
  });
}]);
"use strict";

