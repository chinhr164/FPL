function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('staff-salary-monthly-reports').factory('SalaryTable', ['$modal', function ($modal) {
  const svc = {};

  const makeModal = (templateUrl, doc, size = 'md') => {
    $modal.open({
      templateUrl,
      controller: ['doc', '$modalInstance', function (doc, $modalInstance) {
        const vm = this;
        vm.doc = doc;

        vm.close = () => $modalInstance.dismiss();
      }],
      size: size,
      resolve: {
        doc: () => doc
      },
      controllerAs: 'vm'
    });
  };

  svc.viewTickets = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-tickets.template.html', doc);
  };

  svc.viewThumbUps = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-thumb-ups.template.html', doc);
  };

  svc.viewBonuses = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-bonus.client.template.html', doc);
  };

  svc.viewShifts = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-shifts.client.template.html', doc);
  };

  svc.viewKitchenShifts = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-kitchen-shift-reports.client.template.html', doc);
  };

  svc.viewSaleEntries = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-sale-entries.client.template.html', doc, 'lg');
  };

  svc.viewShiftReports = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-shift-reports.client.template.html', doc);
  };

  svc.viewPackingShiftReports = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-packing-shift-reports.client.template.html', doc);
  };

  svc.viewPlTasks = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-pl-tasks.client.template.html', doc);
  };

  svc.viewShiftEntries = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-shift-entries.client.template.html', doc, 'lg');
  };

  svc.viewCalendarEntries = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-calendar-entries.client.template.html', doc, 'lg');
  };

  svc.viewKpiSalaries = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-kpi-salaries.client.template.html', doc, 'lg');
  };

  svc.viewApplicationForms = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-application-forms.client.template.html', doc, 'lg');
  };

  svc.viewWorkTasks = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-work-tasks.client.template.html', doc, 'lg');
  };

  svc.viewMktPosts = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-mkt-posts.client.template.html', doc, 'lg');
  };

  svc.viewFTShiftSavor = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-ft-savor-shift-table.client.template.html', doc, 'md');
  };

  svc.viewAddSalary = doc => {
    makeModal('/modules/staff-salary-monthly-reports/templates/modal-view-add-salary.client.template.html', doc, 'lg');
  };

  svc.viewShipEntries = doc => {
    $modal.open({
      templateUrl: '/modules/staff-salary-monthly-reports/templates/modal-view-ship-entries.client.template.html',
      controller: ['doc', '$modalInstance', function (doc, $modalInstance) {
        const vm = this;
        vm.doc = doc;
        vm.shipSaleEntryMap = _.reduce(vm.doc.shipEntries, (result, shipEntry) => {
          result[shipEntry.saleEntryId] = result[shipEntry.saleEntryId] || {
            saleEntryId: shipEntry.saleEntryId,
            created: '',
            confirm: '',
            done: ''
          };

          _.set(result, `${shipEntry.saleEntryId}.${shipEntry.role}`, shipEntry.shipSalary);

          return result;
        }, {});
        vm.shipSaleEntries = _.orderBy(_.values(vm.shipSaleEntryMap), ['saleEntrId'], ['asc']);
        vm.shipSaleEntries = _.map(vm.shipSaleEntries, shipEntry => {
          const total = (shipEntry.created || 0) + (shipEntry.confirm || 0) + (shipEntry.done || 0);
          return _objectSpread({}, shipEntry, {
            total
          });
        });

        vm.close = () => $modalInstance.dismiss();
      }],
      resolve: {
        doc: () => doc
      },
      controllerAs: 'vm'
    });
  };

  return svc;
}]);
'use strict'; // Staff salary monthly reports service used to communicate Staff salary monthly reports REST endpoints

angular.module('staff-salary-monthly-reports').factory('StaffSalaryMonthlyReports', ['$resource', function ($resource) {
  return $resource('staff-salary-monthly-reports/:staffSalaryMonthlyReportId', {
    staffSalaryMonthlyReportId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    complaint: {
      method: 'PUT',
      url: 'staff-salary-monthly-reports/:staffSalaryMonthlyReportId/complaint'
    },
    doneComplaint: {
      method: 'PUT',
      url: 'staff-salary-monthly-reports/:staffSalaryMonthlyReportId/done-complaint'
    },
    findComplaint: {
      method: 'GET',
      url: 'staff-salary-monthly-reports/find-complaint',
      isArray: true
    }
  });
}]);
'use strict'; // Setting up route

angular.module('stickets').config(['$stateProvider', function ($stateProvider) {
  // Stickets state routing
  $stateProvider.state('listStickets', {
    url: '/stickets',
    templateUrl: 'modules/stickets/views/list-stickets.client.view.html',
    resolve: {
      $title: _.constant('Tickets')
    }
  }).state('importStickets', {
    url: '/stickets/import',
    templateUrl: 'modules/stickets/views/import-stickets.client.view.html',
    resolve: {
      $title: _.constant('Import Tickets')
    }
  }).state('createSticket', {
    url: '/stickets/create',
    templateUrl: 'modules/stickets/views/create-sticket.client.view.html',
    resolve: {
      $title: _.constant('Create Ticket')
    }
  }).state('viewSticket', {
    url: '/stickets/:sticketId',
    templateUrl: 'modules/stickets/views/view-sticket.client.view.html',
    resolve: {
      $title: _.constant('View Ticket')
    }
  }).state('editSticket', {
    url: '/stickets/:sticketId/edit',
    templateUrl: 'modules/stickets/views/edit-sticket.client.view.html',
    resolve: {
      $title: _.constant('Edit Ticket')
    }
  });
}]);
'use strict';

angular.module('stickets').controller('ImportSticketsController', ['Authentication', 'Stickets', 'FhdMessenger', '$http', '$location', '$state', 'ConfirmModal', function (Authentication, Stickets, FhdMessenger, $http, $location, $state, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.requireFields = 'code content amount type'.split(' ');

  function isAllValidField(field) {
    return _.some(vm.rawItems, item => {
      return !_.get(item, field) && _.get(item, field) !== 0;
    });
  }

  function validateItems() {
    let errors = [];

    if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('sticket:create')) {
      errors.push(`Bạn không có quyền import ticket`);
      return errors;
    }

    _.forEach(vm.requireFields, requireField => {
      if (isAllValidField(requireField)) {
        errors.push(`Bạn chưa điền đủ ${requireField}`);
      }
    });

    return errors;
  }

  vm.import = () => {
    if (!vm.rawItems) {
      return;
    }

    const errCreate = validateItems();

    if (errCreate.length) {
      _.forEach(errCreate, err => {
        return FhdMessenger.error(err);
      });

      return;
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ import ${vm.rawItems.length} tickets?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      Stickets.importStickets({
        rawItems: vm.rawItems
      }).$promise.then(stickets => {
        vm.stickets = stickets;

        _.forEach(vm.stickets, sticket => {
          sticket.salaryDate = moment(sticket.salaryDate).format('L');
        });

        return FhdMessenger.success(`Import ${stickets.length} ticket thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('stickets').controller('ModalComplaintSticketsController', ['$modalInstance', 'Users', 'Complaints', 'SticketService', 'Stickets', 'FhdMessenger', '$state', function ($modalInstance, Users, Complaints, SticketService, Stickets, FhdMessenger, $state) {
  const vm = this;
  vm.close = $modalInstance.dismiss();

  vm.sendComplaint = function () {
    if (!vm.complaintContent) {
      return FhdMessenger.error('Chưa có nội dung khiếu nại');
    }

    $modalInstance.close(vm.complaintContent);
  };
}]);
'use strict';

angular.module('stickets').controller('ModalCreateSticketsController', ['$modalInstance', 'Users', 'Complaints', 'SticketService', 'Stickets', 'FhdMessenger', 'source', function ($modalInstance, Users, Complaints, SticketService, Stickets, FhdMessenger, source) {
  const vm = this;
  vm.close = $modalInstance.dismiss;
  vm.sticketTypeMap = SticketService.getSticketType();
  vm.sticketType = 'gray';
  vm.hadReason = false;
  vm.images = [];
  vm.hadFineMoney = false;

  vm.findOne = function () {
    if (source.user) {
      vm.user = source.user;
    }

    if (source.portrait) {
      vm.portrait = source.portrait;
    }

    if (source.reason) {
      vm.reason = source.reason;
      vm.hadReason = true;
    }

    if (source.fineMoney) {
      vm.fineMoney = source.fineMoney;
      vm.hadFineMoney = true;
    }

    if (source.complaint) {
      vm.reason = `Liên quan đến complaint ${source.complaint.complaintId}`;
      vm.complaint = source.complaint;
    }

    if (source.photoReport) {
      vm.photoReport = source.photoReport;
    }

    if (source.shiftReport) {
      vm.shiftReport = source.shiftReport;
    }

    if (source.checkListEntry) {
      vm.checkListEntry = source.checkListEntry;
    }
  };

  vm.create = function () {
    if (!_.isNumber(vm.fineMoney)) {
      return FhdMessenger.error('Chưa có số tiền phạt');
    }

    if (!vm.reason) {
      return FhdMessenger.error('Chưa có lý do gửi ticket');
    }

    const sticket = new Stickets({
      type: vm.sticketType,
      fineMoney: vm.fineMoney,
      content: vm.reason,
      staff: vm.user,
      images: vm.images,
      salaryDate: vm.salaryDate,
      complaint: vm.complaint ? vm.complaint : undefined,
      photoReport: vm.photoReport ? vm.photoReport : undefined,
      shiftReport: vm.shiftReport ? vm.shiftReport : undefined,
      portrait: vm.portrait ? vm.portrait : undefined,
      checkListEntry: vm.checkListEntry ? vm.checkListEntry : undefined
    });
    vm.waiting = true; // Redirect after save

    sticket.$save(function () {
      FhdMessenger.success(`Đã gửi ticket cho nhân viên ${vm.user.code} - ${vm.user.displayName}`);
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).then(sticket => {
      $modalInstance.close(sticket);
    });
  };
}]);
"use strict";

angular.module('stickets').controller('ModalDoneComplaintSticketsController', ['$modalInstance', 'FhdMessenger', function ($modalInstance, FhdMessenger) {
  const vm = this;
  vm.close = $modalInstance.dismiss();

  vm.sendDoneComplaint = function () {
    if (!vm.doneComplaintContent) {
      return FhdMessenger.error('Chưa có nội dung phải hồi khiếu nại');
    }

    $modalInstance.close(vm.doneComplaintContent);
  };
}]);
'use strict'; // Stickets controller

angular.module('stickets').controller('SticketsController', ['$stateParams', '$location', 'Authentication', 'Stickets', 'SticketService', 'ObjectId', 'NgTableParams', 'FhdMessenger', '$state', '$scope', 'ShiftEntries', '$window', function ($stateParams, $location, Authentication, Stickets, SticketService, ObjectId, NgTableParams, FhdMessenger, $state, $scope, ShiftEntries, $window) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.sticket = {
    sticketType: 'gray'
  };
  vm.data = {
    staffTypes: ['Thử việc', 'Chính thức'].map(it => {
      return {
        id: it,
        title: it
      };
    })
  };
  vm.time = new Date();
  vm.comment = '';
  vm.sticketTypeMap = SticketService.getSticketType();
  vm.staffs = [];
  vm.startDate = moment().subtract(1, 'month') // .startOf('month')
  .format('YYYY-MM-DD');
  vm.endDate = moment().endOf('month').format('YYYY-MM-DD');
  $scope.$watch(() => vm.staff, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    const staffId = ObjectId.getObjectId(vm.staff);
    vm.staff = null;

    const mapStaffId = _.map(vm.staffs, '_id');

    if (mapStaffId.includes(staffId) === false) {
      vm.staffs.push(newValue);
    }
  });

  vm.getStaff = function (array) {
    const staffCodes = _.compact(vm.inputStaffs.split('\n'));

    const combinedCodes = _.map(staffCodes, code => code.trim().toLowerCase().replace(/(^|\s)\S/g, l => l.toUpperCase()));

    const sticketGetStaff = ShiftEntries.checkAndGetStaffs({
      query: combinedCodes
    });
    sticketGetStaff.$promise.then(staffs => {
      const mapCodeStaffs = _.map(staffs, 'code');

      const diffStaffs = _.difference(combinedCodes, mapCodeStaffs);

      if (diffStaffs.length > 0) {
        return FhdMessenger.error(`Nhân viên: ${diffStaffs.join(' ')} bị sai`);
      }

      _.forEach(staffs, staff => {
        if (!staff) return;

        const checkDuplicate = _.find(array, element => element.code === staff.code);

        if (!checkDuplicate) {
          array.push(_.cloneDeep(staff));
        }
      });

      vm.clearInput();
    });
  };

  vm.clearInput = function () {
    vm.inputStaffs = null;
  };

  vm.removeStaff = index => {
    vm.staffs.splice(index, 1);
  }; // Create new Sticket


  vm.create = function () {
    if (!_.isNumber(vm.sticket.fineMoney)) {
      return FhdMessenger.error('Chưa có số tiền phạt');
    }

    if (!vm.staffs.length) {
      return FhdMessenger.error('Chưa có nhân viên nào');
    }

    const inactiveStaffs = _.filter(vm.staffs, staff => staff.roles.includes('inactive'));

    if (inactiveStaffs.length) {
      const invalidSticketsStaffs = _.reduce(inactiveStaffs, (result, staff) => {
        if (moment(vm.sticket.salaryDate).isAfter(staff.disabled)) {
          result.push(`${staff.code} - ${staff.displayName}`);
        }

        return result;
      }, []);

      if (invalidSticketsStaffs.length) {
        return FhdMessenger.error(`Lỗi khi tạo ticket cho ${invalidSticketsStaffs.join(', ')}: ngày tính lương phải trước thời gian khóa tài khoản`);
      }
    }

    const mapStaffId = _.map(vm.staffs, '_id');

    _.forEach(mapStaffId, (staffId, index) => {
      // Create new Sticket object
      const sticket = new Stickets(_.cloneDeep(vm.sticket));
      sticket.staff = staffId;
      vm.waiting = true; // Redirect after save

      sticket.$save(function (response) {
        vm.inputStaffs = null;

        const successStaff = _.find(vm.staffs, staff => staff._id === staffId);

        vm.staffs = _.reject(vm.staffs, staff => staff._id === staffId);
        FhdMessenger.success(`Gửi ticket thành công cho nhân viên ${successStaff.code}-${successStaff.displayName}`);
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
        FhdMessenger.error(vm.error);
      }).finally(() => {
        if (index === mapStaffId.length - 1) vm.waiting = false;
      });
    });
  }; // Remove existing Sticket


  vm.remove = function (sticket) {
    sticket.deletedNote = $window.prompt('Nhập lý do xóa ticket');

    if (!sticket.deletedNote) {
      return FhdMessenger.error('Chưa có lý do xóa ticket');
    }

    sticket.$remove(function () {
      FhdMessenger.success('Xóa thành công');
    }).catch(FhdMessenger.errorFromServer);
  }; // Remove existing Sticket


  vm.done = function (sticket) {
    sticket.$done().then(() => {
      FhdMessenger.success('Đã chuyển ticket sang trạng thái done');
      sticket.status = 'done';
    }).catch(error => {
      FhdMessenger.error(error);
    });
  };

  vm.complaint = function () {
    SticketService.openComplaintTicket().then(complaintContent => {
      const sticket = vm.sticket;
      sticket.complaintContent = complaintContent;
      sticket.$complaint(function () {
        $location.path(`stickets/${sticket._id}`);
      }, function (errorResponse) {
        FhdMessenger.errorFromServer(errorResponse);
      });
    });
  };

  vm.doneComplaint = function () {
    const sticket = vm.sticket;
    sticket.$doneComplaint(function () {
      $location.path(`stickets/${sticket._id}`);
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }); // })
  };

  vm.addComment = function () {
    const sticket = vm.sticket;
    if (!vm.comment) return FhdMessenger.error('Nội dung không được để trống');
    sticket.comment = vm.comment;
    sticket.$comment().then(() => {
      vm.comment = '';
    }).catch(errorResponse => FhdMessenger.errorFromServer(errorResponse));
  };

  vm.sendDoneComplaint = function () {
    const sticket = vm.sticket;
    sticket.$doneComplaint().then(() => {
      vm.doneComplaintContent = '';
    }).catch(errorResponse => FhdMessenger.errorFromServer(errorResponse));
  }; // Update existing Sticket


  vm.update = function () {
    const sticket = vm.sticket;
    vm.waiting = true;
    sticket.$update(function () {
      $location.path(`stickets/${sticket._id}`);
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Find a list of Stickets


  vm.sticketsTable = new NgTableParams({
    count: 100
  });

  vm.find = function () {
    vm.waiting = true;
    vm.stickets = Stickets.query({
      startDate: vm.startDate,
      endDate: vm.endDate
    });
    vm.stickets.$promise.then(() => {
      _.forEach(vm.stickets, ticket => {
        if (ticket.status === 'pending') {
          ticket.canDone = _.some(ticket.processor, processor => {
            return ObjectId.equals(processor, vm.user);
          }) || vm.user.roles.includes('admin') || vm.user.roles.includes('sticket:done');
        }
      });

      vm.sticketsTable.settings({
        dataset: vm.stickets
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.canRemoveSticket = function (sticket) {
    if (!sticket) {
      return false;
    }

    if (sticket.status === 'deleted') {
      return false;
    }

    if (_.intersection(vm.user.roles, ['admin', 'sticket:edit']).length) {
      return true;
    }

    if (_.some(sticket.processor, processor => {
      return ObjectId.equals(vm.user, processor);
    }) || ObjectId.equals(vm.user, sticket.user)) {
      return true;
    }

    return false;
  }; // Find existing Sticket


  vm.findOne = function () {
    vm.sticket = Stickets.get({
      sticketId: $stateParams.sticketId
    });
  };
}]);
'use strict';

angular.module('stickets').factory('SticketService', ['$modal', function ($modal) {
  const sticketType = [{
    id: 'gray',
    name: 'Xám'
  }, {
    id: 'black',
    name: 'Đen'
  }];
  return {
    getSticketType: () => sticketType,

    openCreateTicket(source) {
      return $modal.open({
        templateUrl: 'modules/stickets/views/modal-create-sticket.client.view.html',
        controller: 'ModalCreateSticketsController',
        controllerAs: 'vm',
        resolve: {
          source: () => source
        }
      }).result;
    },

    openComplaintTicket(ticket) {
      return $modal.open({
        templateUrl: 'modules/stickets/views/modal-complaint-sticket.client.view.html',
        controller: 'ModalComplaintSticketsController',
        controllerAs: 'vm',
        resolve: {
          source: () => ticket
        }
      }).result;
    },

    openDoneComplaintTicket(source) {
      return $modal.open({
        templateUrl: 'modules/stickets/views/modal-done-complaint-sticket.client.view.html',
        controller: 'ModalDoneComplaintSticketsController',
        controllerAs: 'vm',
        resolve: {
          source: () => source
        }
      }).result;
    }

  };
}]);
'use strict'; // Stickets service used to communicate Stickets REST endpoints

angular.module('stickets').factory('Stickets', ['$resource', function ($resource) {
  return $resource('stickets/:sticketId', {
    sticketId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    done: {
      method: 'PUT',
      url: 'stickets/:sticketId/done'
    },
    comment: {
      method: 'PUT',
      url: 'stickets/:sticketId/comment'
    },
    doneComplaint: {
      method: 'PUT',
      url: 'stickets/:sticketId/done-complaint'
    },
    remove: {
      method: 'PUT',
      url: '/stickets/:sticketId/delete'
    },
    importStickets: {
      method: 'POST',
      url: '/stickets/import',
      isArray: true
    }
  });
}]);
