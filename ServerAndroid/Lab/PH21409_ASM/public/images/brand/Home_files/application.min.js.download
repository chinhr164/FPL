'use strict';

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('application-forms').controller('ModalSelectProbationShiftsController', ['applicationForm', 'Authentication', '$modalInstance', 'FhdMessenger', 'ProbationShiftEntries', 'NgTableParams', '$http', function (applicationForm, Authentication, $modalInstance, FhdMessenger, ProbationShiftEntries, NgTableParams, $http) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.probationShiftEntriesTable = new NgTableParams({
    count: 50
  });
  ProbationShiftEntries.query({
    workPosition: applicationForm.workPosition,
    startDate: moment().subtract(1, 'day').startOf('day').toDate(),
    endDate: moment().add(2, 'month').toDate(),
    statuses: ['active']
  }).$promise.then(probationShiftEntries => {
    const existsProbationShiftEntryIds = _.map(applicationForm.probationShiftEntries, 'probationShiftEntry');

    const filteredProbationShiftEntries = _.filter(probationShiftEntries, probationShiftEntry => {
      return !existsProbationShiftEntryIds.includes(probationShiftEntry._id);
    });

    vm.probationShiftEntriesTable.settings({
      dataset: filteredProbationShiftEntries
    });
  });

  vm.update = () => {
    let probationShiftEntries = _.filter(vm.probationShiftEntriesTable.data, {
      selected: true
    });

    if (!probationShiftEntries.length) {
      return FhdMessenger.error('Bạn chưa chọn ca thử việc nào');
    }

    probationShiftEntries = _.reduce(probationShiftEntries, (result, probationShiftEntry) => {
      result = result || [];
      result.push(_objectSpread({}, probationShiftEntry, {
        date: probationShiftEntry.date,
        outletCode: probationShiftEntry.outlet.code,
        probationShiftEntry: probationShiftEntry._id
      }));
      return result;
    }, []);
    vm.waiting = true;
    $http.put(`/application-forms/${applicationForm._id}/add-probation-shift`, {
      probationShiftEntries
    }).then(res => {
      FhdMessenger.success('Cập nhật thành công !');
      $modalInstance.close(res.data);
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.dismiss = () => {
    $modalInstance.close(true);
  };
}]);
"use strict";

angular.module('application-forms').controller('ModalSendEmailForApplicationFormController', ['$modalInstance', 'applicationForm', 'emailType', 'Authentication', '$http', 'FhdMessenger', '$state', function ($modalInstance, applicationForm, emailType, Authentication, $http, FhdMessenger, $state) {
  const vm = this;
  vm.user = Authentication.user;
  vm.modal = $modalInstance;
  vm.applicationForm = applicationForm;
  vm.applicationForm.emailType = emailType;

  vm.dismiss = () => $modalInstance.dismiss();

  vm.sendEmail = () => {
    vm.waiting = true;
    const applicationForm = vm.applicationForm;
    applicationForm.$sendEmail().then(applicationForm => {
      vm.applicationForm = applicationForm;
      FhdMessenger.success('Đã gửi thành công');
      vm.dismiss();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = true;
    });
  };

  const hotlineText = '<a href="tel:0974932066">0974932066</a>';
  const positionText = `<strong>${applicationForm.position}</strong>`;
  const interviewTimeText = `<strong>${moment(applicationForm.interviewTime).format('HH:mm')} ngày ${moment(applicationForm.interviewDate).format('DD/MM/YYYY')}</strong>`;

  const matchProbationShift = _.findLast(applicationForm.probationShiftEntries, probationShiftEntry => {
    return moment(probationShiftEntry.startTime).isAfter(moment());
  });

  if (['NVBH ABBY', 'NVBH SAVOR', 'VỊ TRÍ KHÁC'].includes(emailType) && !matchProbationShift) {
    return FhdMessenger.error('Không có ca học việc ở tương lai để gửi email hẹn học việc vị trí này. Vui lòng thêm ca học việc để có thể gửi email tự động');
  }

  vm.applicationForm.title = `Thư mời phỏng vấn vị trí`;
  vm.applicationForm.content = `
Chào bạn,
<br/>
Lời đầu tiên, thay mặt Công ty cảm ơn bạn đã dành thời gian quan tâm và ứng tuyển vào vị trí ${positionText}
<br/>
Sau khi xem xét và cân nhắc kỹ lưỡng hồ sơ của bạn, chúng tôi thông báo bạn đã vượt qua vòng hồ sơ. Vì vậy, phòng Tuyển dụng hẹn bạn lịch phỏng vấn để trao đổi chi tiết hơn về công việc, cụ thể như sau:
<br/>
- Thời gian: ${interviewTimeText}
<br/>
- Hình thức: Buổi phỏng vấn sẽ diễn ra online thông qua ứng dụng GOOGLE MEET
<br/>    
- Link phòng phỏng vấn: <a href="${applicationForm.linkGoogleMeet}">${applicationForm.linkGoogleMeet}</a>
<br/>
Bạn vui lòng ấn vào dòng chữ <strong>“Yêu cầu đăng nhập”</strong> để tham gia phỏng vấn.
<br/>    
Để buổi phỏng vấn diễn ra tốt đẹp, bạn vui lòng kiểm tra đường truyền internet, back-up các gói 3G/4G`;

  if (_.get(vm.applicationForm, 'hrTask.documentLink')) {
    vm.applicationForm.content += ` và tìm hiểu về công việc tại đây: <a href="${vm.applicationForm.hrTask.documentLink}">JD Công việc</a>.`;
  }

  vm.applicationForm.content += `
<br/>
Rất mong sẽ nhận được phản hồi sớm từ bạn.
<br/>
Trân trọng. `;

  if (emailType === 'pass phỏng vấn') {
    vm.applicationForm.title = `Thông báo kết quả phỏng vấn vị trí`;
    vm.applicationForm.content = `
  Chào bạn,
  <br/>
  Trước tiên, chúng tôi cảm ơn bạn đã dành thời gian quan tâm và ứng tuyển vị trí  ${positionText}
  <br/>
  Sau quá trình trao đổi, chúng tôi trân trọng thông báo <strong>bạn đã vượt qua vòng phỏng vấn và được nhận vào vòng học việc</strong>
  <br/>
  Cụ thể thông tin buổi học việc chúng tôi sẽ liên hệ lại với bạn qua số điện thoại trong hồ sơ đăng ký. Bạn vui lòng chú ý điện thoại để phòng Tuyển dụng có thể tiện liên lạc.
  <br>
  Sau buổi học việc, chúng tôi sẽ xem xét và chọn ra những bạn phù hợp nhất với công việc để bước vào vòng thử việc.
  <br>
  Rất mong sẽ nhận được phản hồi sớm từ bạn.
  <br>
  Trân trọng.
