    }).then(() => {
      vm.waiting = true;
      $http.put(`/sale-entries/${vm.saleEntry._id}/close`).then(() => {
        FhdMessenger.success(`Đã cập nhập thành công`);
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.editPaymentMethod = () => {
    vm.saleEntry.partnership = {};
    SaleEntryService.openAddPaymentSaleEntryModal(vm.saleEntry, undefined, true).then(saleEntry => {
      saleEntry.$update(function () {
        FhdMessenger.success('Sửa hình thức thanh toán thành công');
      }, function (errorResponse) {
        FhdMessenger.error(errorResponse.data.message);
      });
    });
  };

  vm.saleEntriesTable = new NgTableParams({
    count: 200
  }); // Find a list of Sale entries

  vm.find = function () {
    vm.waiting = true;
    vm.saleEntries = SaleEntries.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      outlet: vm.outlet ? vm.outlet._id : null,
      shift: _.get(vm.shift, 'code', vm.shift)
    }, function () {
      vm.saleEntriesTable.settings({
        dataset: vm.saleEntries
      });

      if (vm.saleEntries.length === 500) {
        FhdMessenger.notifySticky('Chỉ hiển thị 500 kết quả đầu tiên');
      }
    });
    FhdMessenger.notifyLoading('Đang tải...', vm.saleEntries.$promise, () => {
      vm.waiting = false;
      FhdMessenger.success('Tải xong!');
    });
  }; // Find existing Sale entry


  vm.findOne = function () {
    vm.editing = true;
    vm.saleEntry = SaleEntries.get({
      saleEntryId: $stateParams.saleEntryId
    }, function () {
      vm.items = vm.saleEntry.order.items;
      vm.hasNoLoyaltyItem = _.some(vm.saleEntry.order.items, {
        noLoyalty: true
      });
    });
  };

  vm.itemClicked = function (item) {
    if (_.includes(vm.user.roles, 'price:editor')) {
      item.changedSoldPrice = true;
    }
  };

  vm.viewProductAttributes = ProductService.viewProductAttributes;
  vm.openSaleEntry = SaleEntryService.viewSaleEntry; // Open list sale entries of Customer

  vm.viewSaleEntries = CustomerService.openSaleEntriesModal;
  vm.viewListVouchers = SaleEntryService.viewListVouchers;

  vm.openInputMooncakeGiftModal = function (avaiableMooncakeGifts) {
    SaleEntryService.openChooseMooncakeGiftModal(avaiableMooncakeGifts).result.then(items => {
      _.forEach(items, item => {
        vm.items.push(item);
      });

      vm.calculate();
    });
  };

  vm.showPopover = function (imageLink) {
    vm.imageLink = imageLink;
  };

  vm.hidePopover = function () {
    vm.imageLink = null;
  };

  vm.discountStaffLimit = 1000000;
  $scope.$watch(() => vm.offlineModeData.offlineMode, (newValue, oldValue) => {
    if ($state.current.name && $state.current.name !== 'createSaleEntry') return;
    if (newValue === oldValue) return;
    vm.updateOrderNumber();
  });
  $scope.$watch(() => vm.saleEntriesTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.totalRevenue = _.reduce(vm.saleEntriesTable.data, function (total, saleEntry) {
      return total + saleEntry.order.saleTotal;
    }, 0);
  });

  vm.clearCustomer = function () {
    vm.customer = null;
    vm.saleEntry.customer = {};
    vm.saleEntry.voucher = undefined;
    vm.saleEntry.order.discountStaff = undefined;
    vm.customerRegistered = true;
    vm.hasCustomerCard = false;
    vm.calculate();
  };

  vm.customerSearchChanged = customerSearch => {
    if (!customerSearch) {
      vm.clearCustomer();
    }
  };

  vm.sendEmailToListSubscribed = function (email) {
    CustomerService.sendEmailToListSubscribed(email).then(function () {
      FhdMessenger.success('Bạn đã đăng ký thành công');
      vm.email = '';
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.dayToActive = function (day) {
    const dayVoucher = moment(day).add(1, 'day');
    return dayVoucher;
  };

  vm.createCustomerRequest = CustomerRequestService.createCustomerRequest;

  vm.openReturnItemsModal = () => {
    SaleEntryService.openReturnItemsModal().then(({
      returnItems,
      returnSaleEntry
    }) => {
      vm.returnItems = returnItems;
      vm.saleEntry.returnSaleEntry = returnSaleEntry;
      vm.calculate();
    });
  };

  vm.removeStaffDiscount = () => {
    delete vm.saleEntry.order.discountStaff;
    vm.calculate();
  }; // handel shortCut with keyCode F2


  function handleF2(event) {
    if (event.key === 'F2') {
      var productSearchInput = $document[0].querySelector('#productSearch');
      productSearchInput.focus();
      productSearchInput.select();
    }

    vm.$apply();
  }

  $document.on('keydown', handleF2);
  vm.$on('$destroy', function () {
    $document.unbind('keydown', handleF2);
  }); // handel shortCut with keyCode F4

  function handleF4(event) {
    if (event.key === 'F4') {
      var customerSearchInput = $document[0].querySelector('#customerSearch');
      customerSearchInput.focus();
      customerSearchInput.select();
    }

    vm.$apply();
  }

  $document.on('keydown', handleF4);
  vm.$on('$destroy', function () {
    $document.unbind('keydown', handleF4);
  });
