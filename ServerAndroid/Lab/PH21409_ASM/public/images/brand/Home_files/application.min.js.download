angular.module('product-sub-cats').controller('ModalCreateProductSubCatController', ['$scope', '$modalInstance', 'cat', 'ProductSubCats', 'FhdMessenger', function ($scope, $modalInstance, cat, ProductSubCats, FhdMessenger) {
  $scope.cat = cat;

  $scope.create = function () {
    var productSubCat = new ProductSubCats({
      name: $scope.name,
      productCat: $scope.cat._id,
      productDepartment: $scope.cat.productDepartment,
      productGroup: $scope.cat.productGroup
    });
    console.log('productSubCat', productSubCat);
    productSubCat.$save(function (productSubCat) {
      FhdMessenger.success('Tạo thành công.');
      $modalInstance.close(productSubCat);
    }, function (error) {
      FhdMessenger.errorFromServer(error);
    });
  };
}]);
