  vm.isAllValidField = helper.isAllValidField;

  vm.import = () => {
    if (!vm.items) {
      return;
    }

    if (vm.isAllValidField(vm.items, 'code')) {
      return FhdMessenger.error('Bạn chưa điền đủ userCode');
    }

    if (vm.isAllValidField(vm.items, 'amount')) {
      return FhdMessenger.error('Bạn chưa điền đủ số tiền');
    }

    if (vm.isAllValidField(vm.items, 'content')) {
      return FhdMessenger.error('Bạn chưa điền đủ nội dung');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Bạn chắc chắc muốn import chứ?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      Users.importBonusSalaries({
        items: vm.items,
        month: vm.month
      }).$promise.then(kpiSalaries => {
        FhdMessenger.success(`Import ${vm.items.length} Bonus Salaries thành công`);
        return $state.reload();
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.checkAll = function () {
