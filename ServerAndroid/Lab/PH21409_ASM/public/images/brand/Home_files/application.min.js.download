angular.module('surveys').controller('SurveyDistanceModalController', ['$modalInstance', '$http', 'saleEntry', 'FhdMessenger', 'Surveys', 'ObjectId', function SurveyDistanceController($modalInstance, $http, saleEntry, FhdMessenger, Surveys, ObjectId) {
  const vm = this;
  vm.selectOptions = [{
    value: '1km',
    title: '≤1km'
  }, {
    value: '1-2km',
    title: '1-2km'
  }, {
    value: '2-4km',
    title: '2-4km'
  }, {
    value: '4km',
    title: '≥4km'
  }, {
    value: 'N/A',
    title: 'Không trả lời/Không chắc chắn/Đã trả lời rồi'
  }];

  vm.submit = () => {
    if (!vm.selectedAnswer) {
      FhdMessenger.error('Chưa chọn câu trả lời');
      return;
    }

    vm.waiting = true;
    const survey = new Surveys({
      answers: [{
        questionId: 1,
        question: 'Khoảng cách từ nhà/cơ quan đến cơ sở',
        answer: vm.selectedAnswer
      }],
      customer: _.get(saleEntry, 'customer._id', null),
      outlet: _.get(saleEntry, 'outlet._id', null)
    });
    return survey.$save().then(survey => {
      FhdMessenger.success('Gửi câu trả lời thành công.');
      $modalInstance.close(survey);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      $modalInstance.close();
    });
  };
}]);
'use strict'; // Surveys controller

angular.module('surveys').controller('SurveysController', ['Surveys', 'NgTableParams', 'CustomerService', 'SaleEntryService', function (Surveys, NgTableParams, CustomerService, SaleEntryService) {
  const vm = this;
  vm.surveysTable = new NgTableParams();
  vm.openSaleEntry = SaleEntryService.viewSaleEntry;
  vm.viewSaleEntries = CustomerService.openSaleEntriesModal;
  vm.data = {};
  vm.data.outletIds = [];

  vm.init = () => {
    vm.startDate = moment().format('YYYY-MM-DD');
    vm.endDate = moment().format('YYYY-MM-DD');
  };

  vm.find = () => {
    vm.surveys = Surveys.query({
      startDate: moment(vm.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.endDate).format('YYYY-MM-DD'),
      outlets: vm.outlets
    });
    vm.surveys.$promise.then(() => {
      // console.log(vm.surveys)
      vm.surveysTable.settings({
        dataset: vm.surveys
      });
    });
  };

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.outlets = _.map(selectedOutlets, '_id'); // [1, 2345678, 65]
  };
}]);
"use strict";

angular.module('surveys').directive('fhdSurveyCompare', [function () {
  return {
    restrict: 'E',
    scope: {
      data: '=',
      surveyId: '@',
      surveyGroup: '@',
      saleEntry: '=?',
      outlet: '=?',
      customer: '=?',
      onSubmittedSurvey: '=?'
    },
    template: `
      <div data-cy="fhd-survey-compare">
        <div class="row" data-cy="compare-row" ng-repeat="group in vm.groups">
          <div class="col-sm-12">
            <h3>Cặp {{$index + 1}}</h3>
            <div class="row vertical-align">
              <div class="col col-sm-4 survey-compare-item" ng-class="{checked: item.checked}"
              ng-repeat-start="(index, item) in group.items" data-cy="compare-item">
                <a class="thumbnail" ng-click="vm.select(item, group)">
                  <img  ng-src="{{item.imageLink}}"/>
                  <div ng-if="item.checked" class="overlay-text">
                    ✓
                  </div>
                </a>
              </div>
              <div class="col col-sm-2 or-divident" ng-if="index === 0" ng-repeat-end>Hoặc</div>
            </div>
            <hr>
          </div>
        </div>
        <div class="row" style="margin-top: 20px">
          <div class="col-sm-12 text-center">
            <button class="btn btn-primary" ng-click="vm.submit()" data-cy="submit-survey-button" ng-disabled="vm.updating">
              Gửi
            </button>
          </div>
        </div>
      </div>`,
    controllerAs: 'vm',
    controller: ['$scope', 'FhdMessenger', 'ObjectId', 'Surveys', 'TextService', function ($scope, FhdMessenger, ObjectId, Surveys, TextService) {
      const vm = this;
      vm.groups = _.cloneDeep($scope.data);
      const surveyGroup = $scope.surveyGroup;
      const surveyId = $scope.surveyId;
      const saleEntry = $scope.saleEntry;
      const outlet = $scope.outlet;
      const customer = $scope.customer;
      const onSubmittedSurvey = $scope.onSubmittedSurvey;

      vm.select = function (item, group) {
        _.forEach(group.items, item => {
          item.checked = false;
        });

        item.checked = true;
      };

      function surveyFactory({
        surveyId = '',
        surveyGroup = '',
        customer = null,
        saleEntry = null,
        outlet = null,
        groups = [],
        note = ''
      }) {
        return {
          surveyId,
          surveyGroup,
          customer: ObjectId.getObjectId(customer),
          saleEntry: ObjectId.getObjectId(saleEntry),
          outlet: ObjectId.getObjectId(outlet),
          answers: _.map(groups, group => {
            const questionId = group.id;
            const question = group.name;

            const answer = _.get(_.find(group.items, 'checked'), 'id');

            return {
              question,
              questionId,
              answer
            };
          }),
          note
        };
      }

      vm.submit = () => {
        let survey = surveyFactory({
          surveyId,
          surveyGroup,
          groups: vm.groups,
          customer,
          saleEntry,
          outlet,
          note: vm.note
        });
        survey = new Surveys(survey);
        vm.updating = true;
        survey.$save().then(result => {
          if (onSubmittedSurvey) onSubmittedSurvey(result);
        }).catch(FhdMessenger.errorFromServer).finally(() => {
          vm.updating = false;
        });
      };
    }]
  };
}]);
"use strict";

angular.module('surveys').directive('fhdSurveyOptions', [function () {
  return {
    restrict: 'E',
    scope: {
      options: '=',
      limit: '=?',
      showTitle: '=?',
      surveyId: '@',
      surveyGroup: '@',
      saleEntry: '=?',
      outlet: '=?',
      customer: '=?',
      onSubmittedSurvey: '=?'
    },
    template: `
      <div data-cy="fhd-survey-options">
        <div class="row">
          <div class="col-sm-3 survey-option" ng-repeat-start="(index, option) in vm.options" ng-class="{
            selected: vm.isSelected(option, vm.selectedOptions)
          }">
            <a class="thumbnail" ng-click="vm.selectOption(option)" data-cy="survey-option">
              <img alt="{{option.id}}" ng-src="{{option.imageLink}}"/>
              <div class="caption" ng-if="vm.showTitle">
                <p>{{option.title}}</p>
              </div>
              <div class="overlay-text" ng-if="vm.isSelected(option, vm.selectedOptions)">
                {{vm.getOrderNumber(option, vm.selectedOptions)}}
              </div>
            </a>
          </div>
          <div ng-repeat-end ng-if="index % 4 === 3" class="clearfix"></div>
        </div>
        <div class="row">
          <div class="col-sm-12">
            <label class="control-label">Nhận xét khác</label>
            <textarea class="form-control" rows="5" ng-model="vm.note" data-cy="note-input"></textarea>
          </div>
        </div>
        <div class="row" style="margin-top: 20px">
          <div class="col-sm-12 text-center">
            <button class="btn btn-primary" ng-click="vm.submit()" data-cy="submit-button" ng-disabled="vm.updating">
              Gửi
            </button>
          </div>
        </div>
      </div>`,
    controllerAs: 'vm',
    controller: ['$scope', 'FhdMessenger', 'ObjectId', 'Surveys', 'TextService', function ($scope, FhdMessenger, ObjectId, Surveys, TextService) {
      const vm = this;
      vm.limit = isFinite($scope.limit) ? $scope.limit : 3;
      vm.options = $scope.options;
      vm.selectedOptions = [];
      vm.showTitle = $scope.showTitle;
      vm.updating = false;
      vm.note = '';
      const surveyGroup = $scope.surveyGroup;
      const surveyId = $scope.surveyId;
      const saleEntry = $scope.saleEntry;
      const outlet = $scope.outlet;
      const customer = $scope.customer;
      const onSubmittedSurvey = $scope.onSubmittedSurvey;

      vm.isSelected = (option, selectedOptions) => {
        return _.some(selectedOptions, {
          id: option.id
        });
      };

      vm.getOrderNumber = (option, selectedOptions) => {
        return _.find(selectedOptions, {
          id: option.id
        }).order + 1;
      };

      vm.selectOption = option => {
        const matchOptionIndex = _.findIndex(vm.selectedOptions, {
          id: option.id
        });

        if (matchOptionIndex > -1) {
          vm.selectedOptions.splice(matchOptionIndex, 1);
        } else {
          if (vm.selectedOptions.length >= vm.limit) return FhdMessenger.error('Không thể chọn quá 3 lựa chọn.');

          const orders = _.range(vm.limit);

          const minOrder = _.min(_.reject(orders, order => _.includes(_.map(vm.selectedOptions, 'order'), order)));

          vm.selectedOptions.push(_.assign({}, option, {
            order: minOrder
          }));
        }
      };

      const surveyFactory = ({
        surveyId = '',
        surveyGroup = '',
        selectedOptions = [],
        options = [],
        customer = null,
        saleEntry = null,
        outlet = null,
        note = ''
      }) => {
        const notSelectedOptions = _.reject(options, option => {
          return _.some(selectedOptions, {
            id: option.id
          });
        });

        return {
          surveyId,
          surveyGroup,
          customer: ObjectId.getObjectId(customer),
          saleEntry: ObjectId.getObjectId(saleEntry),
          outlet: ObjectId.getObjectId(outlet),
          answers: _.map(selectedOptions, selectedOption => {
            const humanOrder = selectedOption.order + 1;
            return {
              questionId: humanOrder,
              question: `Lựa chọn ${humanOrder}`,
              answer: selectedOption.id
            };
          }).concat(notSelectedOptions.map((option, index) => {
            return {
              questionId: Math.random() * 1000,
              question: 'Không chọn',
              answer: option.id
            };
          })),
          note
        };
      };

      vm.submit = () => {
        const wordCount = TextService.countWord(vm.note);

        if (wordCount > 200) {
          FhdMessenger.error('Nhận xét vượt quá 200 từ.');
          return;
        }

        let survey = surveyFactory({
          surveyId,
          surveyGroup,
          saleEntry,
          outlet,
          customer,
          selectedOptions: vm.selectedOptions,
          options: vm.options,
          note: vm.note
        });
        survey = new Surveys(survey);
        vm.updating = true;
        survey.$save().then(survey => {
          FhdMessenger.success('Ok');

          if (onSubmittedSurvey) {
            onSubmittedSurvey(survey);
          }
        }).catch(FhdMessenger.errorFromServer).finally(() => {
          vm.updating = false;
        });
      };
    }]
  };
}]);
'use strict';

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('surveys').factory('SurveyService', ['$modal', function ($modal) {
  // const PLACEHOLDER_LINK = '/modules/surveys/assets/200x200.png'
  const MOONCAKE_BOX_OPTIONS = ['01_nvvn_trang-ram', '02_nvvn_hoa-mi', '03_nvvn_vuon-hong', '05_nvvn_bon-mua', '06_nvvn_nang-sen', '11_abby_sen-2019', '12_abby_hac-do-2018', '13_abby_cuc-vang-2018', '14_abby_le-hoi', '16_abby_sen-xanh', '17_hbttvn_hac-cam', '18_hbttvn_do-den-hoa-tiet', '19_hbttvn_hac-do', '21-hbttvn-xanh-pastel', '22_tbmp_hoa-tiet-den-do', '25_tronvo_craft-hoa-vai', '27_tronvo_hoa-moc-lan', '28_tronvo_mau-don', '30_tronvo-tho-ngoc', '32_tronvo_xanh-hong-pastel', '36_abby_chep-cam-2019-ver2', '38_abby_hoa-van-tro-3'].map(d => ({
    id: d
  })).map(generateOptionWithImageLink);

  function generateOptionWithImageLink(option) {
    return _objectSpread({}, option, {
      imageLink: `/modules/surveys/assets/mooncake-boxes-2019/${option.id}.jpg`
    });
  }

  const COMPARE_GROUPS = [{
    id: 1,
    name: '1-hac-bay',
    items: [{
      id: '63-hac-bay-v2-abby'
    }, {
      id: '01-hac-bay-do-ttvn'
    }]
  }, {
    id: 2,
    name: '2-cua-so',
    items: [{
      id: '62-cua-so-v2-abby'
    }, {
      id: '37-sen-xanh-thanh-an-trung-muoi'
    }]
  }, {
    id: 3,
    name: '3-hoa-dao',
    items: [{
      id: '64-hoa-dao-v2-abby'
    }, {
      id: '57-hoa-dao-tbmp'
    }]
  }];
  const SURVEY_ID = 'mooncake-box-1';
  const SURVEY_GROUP = 'mooncake-box-2019';
  const OPENING_SURVEY = false;
  const IMAGES_PER_SURVEY = 12;
  let openingSurvey = OPENING_SURVEY;
  return {
    isOpeningSurvey: () => openingSurvey,
    setOpeningSurvey: _openingSurvey => {
      openingSurvey = _openingSurvey;
    },

    openSurveyDistanceModal(saleEntry) {
      return $modal.open({
        animation: true,
        templateUrl: 'modules/surveys/templates/survey-distance-modal.client.template.html',
        controller: 'SurveyDistanceModalController',
        controllerAs: 'vm',
        backdrop: 'static',
        keyboard: false,
        resolve: {
          saleEntry: () => saleEntry
        }
      }).result;
    },

    openCompareMooncakeBoxSurvey({
      saleEntry,
      customer,
      outlet
    }) {
      return $modal.open({
        animation: true,
        size: 'lg',
        templateUrl: 'modules/surveys/templates/modal-compare-mooncake-box.client.template.html',
        windowClass: 'modal-online-order',
        controller: ['saleEntry', 'customer', 'outlet', '$modalInstance', 'surveyId', 'surveyGroup', function (saleEntry, customer, outlet, $modalInstance, surveyId, surveyGroup) {
          const vm = this;
          vm.saleEntry = saleEntry;
          vm.customer = customer;
          vm.outlet = outlet;
          vm.options = _.shuffle(MOONCAKE_BOX_OPTIONS);
          vm.surveyId = surveyId;
          vm.surveyGroup = surveyGroup;
          vm.groups = _.shuffle(COMPARE_GROUPS).map(group => {
            const items = _.shuffle(_.map(group.items, generateOptionWithImageLink));

            return _objectSpread({}, group, {
              items
            });
          });

          vm.closeModal = () => $modalInstance.close();
        }],
        controllerAs: 'vm',
        resolve: {
          saleEntry: _.constant(saleEntry),
          customer: _.constant(customer),
          outlet: _.constant(outlet),
          surveyId: _.constant(SURVEY_ID),
          surveyGroup: _.constant(SURVEY_GROUP)
        }
      }).result;
    },

    openMooncakeBoxSurvey({
      saleEntry,
      customer,
      outlet
    }) {
      return $modal.open({
        animation: true,
        size: 'lg',
        templateUrl: 'modules/surveys/templates/modal-survey-mooncake-box.client.template.html',
        windowClass: 'modal-online-order',
        controller: ['saleEntry', 'customer', 'outlet', '$modalInstance', 'surveyId', 'surveyGroup', function (saleEntry, customer, outlet, $modalInstance, surveyId, surveyGroup) {
          const vm = this;
          vm.saleEntry = saleEntry;
          vm.customer = customer;
          vm.outlet = outlet;
          vm.options = _.shuffle(MOONCAKE_BOX_OPTIONS);

          if (IMAGES_PER_SURVEY) {
            vm.options = _.take(vm.options, IMAGES_PER_SURVEY);
          }

          vm.surveyId = surveyId;
          vm.surveyGroup = surveyGroup;

          vm.closeModal = () => $modalInstance.close();
        }],
        controllerAs: 'vm',
        resolve: {
          saleEntry: _.constant(saleEntry),
          customer: _.constant(customer),
          outlet: _.constant(outlet),
          surveyId: _.constant(SURVEY_ID),
          surveyGroup: _.constant(SURVEY_GROUP)
        }
      }).result;
    }

  };
}]);
