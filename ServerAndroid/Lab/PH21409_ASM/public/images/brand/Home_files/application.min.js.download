angular.module('shift-records').controller('ShiftRecordsController', ['$scope', '$stateParams', '$location', 'Authentication', 'ShiftRecords', 'NgTableParams', 'ObjectId', 'CurrentShift', 'FhdMessenger', function ($scope, $stateParams, $location, Authentication, ShiftRecords, NgTableParams, ObjectId, CurrentShift, FhdMessenger) {
  const vm = this;
  vm.data = {};
  vm.data.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.user = Authentication.user;
  vm.shiftRecordsTable = new NgTableParams();

  vm.redirect = function (e) {
    if (vm.isProcessing) {
      e.preventDefault();
    }
  }; // Remove existing Shift record


  vm.remove = function (shiftRecord, isRedirect = false) {
    vm.isProcessing = true;
    CurrentShift.openConfirmRemoveShiftRecordModal().then(function () {
      shiftRecord.$remove().then(() => {
        if (isRedirect) {
          $location.path('/shift-records');
        } else {
          const index = vm.shiftRecords.findIndex(element => element._id === shiftRecord._id);

          if (index >= 0) {
            vm.shiftRecords.splice(index, 1);
          }

          vm.shiftRecordsTable.reload();
        }

        vm.isProcessing = false;
      });
    }).catch(() => {
      vm.isProcessing = false;
    });
  }; // Remove staff


  vm.removeStaff = index => {
    if (!_.isArray(vm.shiftRecord.staffs)) return;
    vm.shiftRecord.staffs.splice(index, 1);
  }; // Update existing Shift record


  vm.update = function () {
    var shiftRecord = vm.shiftRecord;

    if (!shiftRecord.initialPettyCash) {
      return FhdMessenger.error('Bạn chưa nhập tiền lẻ đầu ca');
    }

    vm.waiting = true;
    shiftRecord.$update(function () {
      $location.path('shift-records/' + shiftRecord._id);
    }, function (errorResponse) {
      vm.waiting = false;
      vm.error = errorResponse.data.message;
      FhdMessenger.errorFromServer(errorResponse);
    });
  };

  vm.find = function () {
    vm.waiting = true;
    ShiftRecords.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      outlet: ObjectId.getObjectId(vm.data.outlet),
      shift: _.get(vm.data, 'shift.code')
    }).$promise.then(shiftRecords => {
      vm.shiftRecords = shiftRecords;
      vm.shiftRecordsTable.settings({
        dataset: vm.shiftRecords
      });
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Find existing Shift record


  vm.findOne = function () {
    vm.shiftRecord = ShiftRecords.get({
      shiftRecordId: $stateParams.shiftRecordId
    });
  };
}]);
