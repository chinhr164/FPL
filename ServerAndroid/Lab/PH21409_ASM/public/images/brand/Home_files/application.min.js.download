    saleEntry.total = saleEntry.order.saleTotal + _.get(saleEntry, 'shipping.collect', 0) + _.get(saleEntry, 'payment.collect', 0) + (parseInt(vm.totalFee) || 0);
    vm.waiting = true;
    saleEntry.$update(function () {
      $location.path(`sale-entries/${saleEntry._id}`);
