    vm.waiting = true;
    vm.shippingEntry.$addCompensationValue().then(() => {
      $modalInstance.close();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.close = function () {
    $modalInstance.dismiss();
  };
}]);
