angular.module('settings').controller('UpdateNewApplicationVersionController', ['$http', 'FhdMessenger', function ($http, FhdMessenger) {
  const vm = this;

  vm.init = () => {
    vm.now = moment().format('YYYY-MM-DD HH:mm');
    $http.get('/settings/update-application-version').then(response => {
      if (response.data) {
        vm.time = moment(response.data).format('YYYY-MM-DD HH:mm');
      }
    });
  };

  vm.update = () => {
    vm.waiting = true;
    $http.put('/settings/update-application-version').then(response => {
      FhdMessenger.success('Ok');
      vm.time = moment().format('YYYY-MM-DD HH:mm');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('settings').controller('ViewNowAccessTokenController', ['$http', 'FhdMessenger', function ($http, FhdMessenger) {
  const vm = this;
  vm.nowAccessToken = '';

  vm.getNowAccessToken = () => {
    $http.get('/settings/4handy-work/now-access-token').then(response => {
      vm.nowAccessToken = response.data.nowAccessToken;
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.update = () => {
    if (!vm.nowAccessToken) {
      FhdMessenger.error('Chưa có access token');
      return;
    }

    $http.put('/settings/4handy-work/now-access-token', {
      nowAccessToken: vm.nowAccessToken
    }).then(response => {
      FhdMessenger.success('Ok');
    }).catch(FhdMessenger.errorFromServer);
  };
}]);
"use strict";

