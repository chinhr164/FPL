angular.module('switch-account-function-website').directive('switchAccount', [function () {
  return {
    templateUrl: '/modules/switch-account-function-website/templates/switch-account-function-website.component.view.html',
    restrict: 'E',
    scope: {
      staff: '=?',
      staffs: '=?',
      labelColumn: '@',
      label: '@',
      hasRemoveButton: '=?',
      loadDefaultUser: '=?',
      onChange: '=?'
    },
    controller: 'SwitchAccountComponentController',

    compile(tElm, tAttrs) {
      const fhdTypeaheadElm = tElm.find('fhd-typeahead');
      if (!tAttrs.staff) fhdTypeaheadElm.removeAttr('fhd-item');
      return {
        post(scope, element) {
          if (scope.labelColumn) {
            const labelElm = element.find('label');
            const inputElm = element.find('fhd-controls');
            labelElm.addClass(`col-sm-${scope.labelColumn}`);
            inputElm.addClass(`col-sm-${12 - scope.labelColumn}`);
          }
        }

      };
    },

    replace: true
  };
}]).controller('SwitchAccountComponentController', ['$scope', 'UserAccounts', 'UserService', function ($scope, UserAccounts, UserService) {
  $scope.data = {};
  UserAccounts.all.query(staffs => {
    $scope.data.staffs = UserService.addFullDescription(staffs);
  });

  $scope.remove = function () {
    $scope.staff = null;
  };

  $scope.$watch('staff', (newValue, oldValue) => {
    if (newValue && newValue !== oldValue && $scope.onChange) {
      $scope.onChange(newValue);
    }
  });
}]);
