    vm.outlet.$promise.then(() => {
      if (!_.get(vm.outlet.positions, 'length')) {
        vm.outlet.positions = _.map(vm.positions, position => ({
          name: position,
          difficultPoint: 1
        }));
      }

      vm.outlet.restockTime = moment(vm.outlet.restockTime).isValid() ? moment(vm.outlet.restockTime) : null;
      vm.outlet.shifts.forEach(shift => {
        shift.startTime = moment(shift.startTime).startOf('minute');
        shift.endTime = moment(shift.startTime).hours(moment(shift.endTime).hours()).minute(moment(shift.endTime).minute());
        shift.hours = moment(shift.endTime).diff(shift.startTime, 'hours', true);
      });
      vm.outlet.restockDays.forEach(day => {
        vm.restockDayMap[day] = true;
      });
      vm.outlet.moneyTranferDays.forEach(day => {
