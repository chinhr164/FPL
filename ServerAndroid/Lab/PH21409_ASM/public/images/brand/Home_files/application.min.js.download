      vm.infoTag.contentHtml = $sce.trustAsHtml(vm.infoTag.content);
    });
  };

  $scope.$watch(() => _.get(vm.infoTag, 'content'), (newValue, oldValue) => {
    if (newValue !== oldValue && newValue) vm.infoTag.contentHtml = $sce.trustAsHtml(_.get(vm.infoTag, 'content'));
  });
}]);
