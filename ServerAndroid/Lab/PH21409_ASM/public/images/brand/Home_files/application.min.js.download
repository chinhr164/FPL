angular.module('product-departments').controller('ProductDepartmentsController', ['$scope', '$stateParams', '$location', 'Authentication', 'ProductDepartments', function ($scope, $stateParams, $location, Authentication, ProductDepartments) {
  $scope.authentication = Authentication; // Create new Product department

  $scope.create = function () {
    // Create new Product department object
    var productDepartment = new ProductDepartments({
      name: this.name
    }); // Redirect after save

    productDepartment.$save(function (response) {
      $location.path('product-departments/' + response._id); // Clear form fields

      $scope.name = '';
    }, function (errorResponse) {
      $scope.error = errorResponse.data.message;
    });
  }; // Remove existing Product department


  $scope.remove = function (productDepartment) {
    if (productDepartment) {
      productDepartment.$remove();

      for (var i in $scope.productDepartments) {
        if ($scope.productDepartments[i] === productDepartment) {
          $scope.productDepartments.splice(i, 1);
        }
      }
    } else {
      $scope.productDepartment.$remove(function () {
        $location.path('product-departments');
      });
    }
  }; // Update existing Product department


  $scope.update = function () {
    var productDepartment = $scope.productDepartment;
    productDepartment.$update(function () {
      $location.path('product-departments/' + productDepartment._id);
    }, function (errorResponse) {
      $scope.error = errorResponse.data.message;
    });
  }; // Find a list of Product departments


  $scope.find = function () {
    $scope.productDepartments = ProductDepartments.query();
  }; // Find existing Product department


  $scope.findOne = function () {
    $scope.productDepartment = ProductDepartments.get({
      productDepartmentId: $stateParams.productDepartmentId
    });
  };
}]);
