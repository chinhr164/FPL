  }, {
    name: 'Chú Đăng',
    value: 'chuDang'
  }, {
    name: 'Xe Tải',
    value: 'truck'
  }, {
    name: 'Xe ba gác',
    value: 'tricycle'
  }, {
    name: 'Ahamove',
    value: 'ahamove'
  }, {
    name: 'Lalamove',
    value: 'Lalamove'
  }, {
    name: 'Nhân viên',
    value: 'khoStaff'
  }];
  const shippingTools = [{
    sku: 'Z0070',
    description: 'Thùng nhựa xanh 15L'
  }, {
    sku: 'Z0071',
    description: 'Nắp thùng nhựa xanh 15L'
  }];
  return {
    openConfirmDeliverEntryModal,
    openEditDeliverEntryModal,

    getTransporterService() {
      return listTransporterServices;
    },

    getShippingTools() {
      return shippingTools;
    },

    findByDeliverEntryId(deliverEntryId) {
      return $http.post('/deliver-entries/find-by-deliver-id', {
        deliverEntryId
      }).then(response => response.data);
    },

    openAddBillNumberModal(deliverEntry) {
      return $modal.open({
        templateUrl: 'modules/deliver-entries/views/modal-add-bill-number-for-deliver-entry.client.view.html',
        controller: 'ModalAddBillNumberForDeliverEntryController',
        controllerAs: 'vm',
        resolve: {
          deliverEntry: () => deliverEntry
        }
      });
    }

  };
}]);
