    resolve: {
      $title: _.constant('Create PL Entry')
    }
  }).state('viewPlEntry', {
    url: '/pl-entries/:plEntryId',
    templateUrl: 'modules/pl-entries/views/view-pl-entry.client.view.html',
    resolve: {
      $title: _.constant('View PL Entry')
    }
  }).state('editPlEntry', {
    url: '/pl-entries/:plEntryId/edit',
    templateUrl: 'modules/pl-entries/views/edit-pl-entry.client.view.html',
    resolve: {
      $title: _.constant('Edit PL Entry')
    }
  });
}]);
'use strict'; // PlEntries controller

angular.module('pl-entries').controller('PlEntriesController', ['$http', '$scope', '$stateParams', '$location', 'Authentication', 'BuyingEntryService', 'PlEntries', 'FhdMessenger', 'NgTableParams', 'NumberService', 'ConfirmModal', '$localStorage', 'OutletService', 'Products', 'ProductService', '$window', function ($http, $scope, $stateParams, $location, Authentication, BuyingEntryService, PlEntries, FhdMessenger, NgTableParams, NumberService, ConfirmModal, $localStorage, OutletService, Products, ProductService, $window) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.quickEditProduct = ProductService.quickEditProduct;

  vm.init = function () {
    vm.plEntryType = 'new';
    const buyingEntry = $localStorage.getObject('buyingEntry');

    if (_.get(buyingEntry, 'buyingEntryId')) {
      vm.buyingEntry = buyingEntry;
      vm.destination = vm.buyingEntry.destination;
      vm.setOutletAndDestinationForPlEntry();
      $localStorage.setObject('buyingEntry', undefined);
    }

    const plEntryItems = $localStorage.getObject('plEntryItems');

    if (_.isArray(plEntryItems)) {
      $localStorage.setObject('plEntryItems', null);
      ProductService.getAllProductsFromServer().then(products => {
        _.forEach(plEntryItems, item => {
          const matchProduct = _.find(products, {
            _id: item.product
          });

          if (matchProduct) {
            const packageQuantity = _.reduce(matchProduct.vendorProducts, (result, vendorProduct) => {
              // Tính số sản phẩm có thể làm được đối với 1 đơn vị hàng RAW
              const vendorProductPackageQuantity = Math.floor(1 / vendorProduct.quantity); // Tìm ước chung lớn nhất của số lượng sản phẩm có thể làm được đối với 1 đơn vị hàng RAW và kết quả của phép tính trước

              const leastCommonDivisor = NumberService.findLeastCommonDivisor(result, vendorProductPackageQuantity); // Bội chung nhỏ nhất của 2 số là số lượng hàng cần làm tối thiếu trong 1 Pl Task

              result = result * vendorProductPackageQuantity / leastCommonDivisor;
              return result;
            }, 1);

            const quantity = Math.round(item.waitingQuantity - item.plTaskQuantity); // 1 PL Task không dài quá 7 giờ tương đương 420 phút. Số lượng sản phẩm trong 1 Pl Task là bội của

            const chunkQuantity = Math.min(Math.floor(420 / (matchProduct.productionTime * packageQuantity)) * packageQuantity, quantity);
            vm.addItem(_.assign({}, matchProduct, {
              quantity,
              chunkQuantity,
              manufacturingDate: item.manufacturingDate,
              expirationDate: item.expirationDate
            }));
          } else {
            FhdMessenger.error(`Không tìm thấy mã ${item.sku} ${item.description}`);
          }
        });
      });
    }
  };

  vm.setOutletAndDestinationForPlEntry = function () {
    let destinationCode = '';
    let outletCode = '';

    if (['G1', 'D2'].includes(vm.buyingEntry.destination.code)) {
      outletCode = 'G1';
      destinationCode = 'D2';
    } else if (['G4', 'M6'].includes(vm.buyingEntry.destination.code)) {
      outletCode = 'G4';
      destinationCode = 'M6';
    } else if (['G2', 'D3'].includes(vm.buyingEntry.destination.code)) {
      outletCode = 'G2';
      destinationCode = 'D3';
    } else if (['G3', 'D4'].includes(vm.buyingEntry.destination.code)) {
      outletCode = 'G3';
      destinationCode = 'D4';
    } else if (vm.buyingEntry.destination.code.match(/[GD][6789]/)) {
      const outletNum = parseInt(vm.buyingEntry.destination.code.replace(/[DG]+/g, '')) || 0;
      outletCode = `G${outletNum}`;
      destinationCode = `D${outletNum}`;
    }

    if (outletCode) {
      OutletService.findOutletFromCode(outletCode).then(outlet => {
        vm.outlet = outlet;
      });
    }

    if (destinationCode) {
      OutletService.findOutletFromCode(destinationCode).then(outlet => {
        vm.destination = outlet;
      });
    }
  };

  vm.findBuyingEntry = function (buyingEntryId) {
    if (!buyingEntryId) {
      return FhdMessenger.error('Chưa nhập mã Buying Entry để tìm');
    }

    BuyingEntryService.findByBuyingEntryId(buyingEntryId).then(buyingEntry => {
      vm.buyingEntry = buyingEntry;
      vm.setOutletAndDestinationForPlEntry();
      vm.buyingEntryId = null;
    });
  };

  vm.suggestCogs = function () {
    let items = [];
    items = _.reduce(vm.items, (result, item) => {
      result.push({
        sku: item.sku,
        description: item.description,
        quantity: item.quantity,
        cogs: 0
      });
      return result;
    }, []);

    if (items.length) {
      $http.post('/suggest-cogs', {
        items: items,
        destination: _.get(vm.destination, '_id', vm.destination)
      }).then(response => {
        vm.plItemsCogs = response.data;
        vm.itemCogsTable = new NgTableParams({
          count: 500
        }, {
          dataset: vm.plItemsCogs
        });
        vm.calculatePlCogs();
      });
    }
  };

  vm.removePlVendorProducts = function (index, item) {
    item.vendorProducts.splice(index, 1);
    item.vendorProductCogs = _.reduce(item.vendorProducts, (result, vendorProduct) => {
      result += _.get(vendorProduct, 'cogs', 0) * _.get(vendorProduct, 'quantity', 0);
      return result;
    }, item.cogs);
    vm.calculatePlCogs();
  };

  vm.calculatePlCogs = function () {
    vm.totalVendorProductCogs = 0;

    _.forEach(vm.plItemsCogs, (item, index) => {
      item.totalCogs = item.packingCogs + item.vendorProductCogs + item.labelCogs + item.wrapperCogs;
      item.totalValue = item.totalCogs * item.quantity;
      vm.totalVendorProductCogs += item.vendorProductCogs * item.quantity;

      if (item.currentCogs !== item.totalCogs) {
        item.buyingCogs = Math.ceil(item.currentCogs);
      }
    });
  };

  $scope.$watch(() => vm.outlet, (newValue, oldValue) => {
    if (newValue === oldValue || !newValue) return;

    if (newValue.code === 'DG') {
      OutletService.findOutletFromCode('D2').then(outlet => {
        vm.destination = outlet;
      });
    }
  }); // $scope.$watch(
  //   () => vm.importProducts,
  //   (newImportItems, oldImportItems) => {
  //     if (newImportItems === oldImportItems) return
  //     if (!newImportItems.length) return
  //     if (
  //       _.some(newImportItems, (item) => {
  //         return !item.sku
  //       })
  //     ) {
  //       return FhdMessenger.error('Có sản phẩm chưa có mã')
  //     }
  //     if (
  //       _.some(newImportItems, (item) => {
  //         return !item.quantity
  //       })
  //     ) {
  //       return FhdMessenger.error('Có sản phẩm chưa có số lượng')
  //     }
  //     vm.items = []
  //     _.forEach(newImportItems, (item) => {
  //       vm.addItem(item)
  //     })
  //   }
  // )
  // Create new PlEntry

  vm.create = function () {
    if (!vm.buyingEntry) {
      if (!vm.noBuyingEntryReason) {
        return FhdMessenger.error('Cần có Buying Entry hoặc lý do không có Buying Entry');
      }

      if (_.get(vm, 'destination.code', '').match(/D\d+/)) {
        const firstItem = vm.items[0];
        const warehouseRestockCode = firstItem.warehouseRestockCode;

        if (warehouseRestockCode !== vm.destination.code) {
          const confirm = $window.confirm(`Kho restock của sản phẩm ${firstItem.sku} - ${firstItem.description} là ${warehouseRestockCode} khác với cơ sở nhận hàng DG(${vm.destination.code}). Bạn có muốn tiếp tục?`);
          if (!confirm) return;
        }
      }
    }

    if (!_.get(vm, 'outlet._id')) {
      return FhdMessenger.error('Chưa chọn cơ sở DG');
    }

    if (!_.get(vm, 'destination._id')) {
      return FhdMessenger.error('Chưa chọn cơ sở nhận hàng từ DG');
    } // Create new PlEntry object


    const plEntry = new PlEntries({
      outlet: vm.outlet,
      destination: vm.destination,
      plEntryType: vm.plEntryType,
      buyingEntry: vm.buyingEntry ? vm.buyingEntry._id : undefined,
      items: _.map(vm.items, item => ({
        product: item.product,
        sku: item.sku,
        description: item.description,
        orderQuantity: item.quantity,
        quantity: item.quantity,
        manufactureDate: item.manufactureDate,
        expiryDate: item.expiryDate,
        quantityPerPack: item.quantityPerPack,
        buyingCogs: item.buyingCogs,
        chunkQuantity: item.chunkQuantity
      })),
      noBuyingEntryReason: vm.noBuyingEntryReason
    });
    vm.waiting = true; // Redirect after save

    plEntry.$save().then(() => $location.path('pl-entries')).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  const fetchDataToTable = () => {
    vm.plEntriesTable.settings({
      dataset: vm.plEntries
    });
  }; // Remove existing PlEntry


  vm.remove = function (plEntry) {
    ConfirmModal.showModal({}, {
      headerText: 'Xóa PL Entry?',
      bodyText: 'Bạn có chắc là bạn muốn xóa PL Entry này?'
    }).then(() => {
      if (plEntry) {
        plEntry.$remove().then(() => {
          const matchPlEntryIndex = _.findIndex(vm.plEntries, {
            _id: plEntry._id
          });

          if (matchPlEntryIndex) vm.plEntries.splice(matchPlEntryIndex, 1);
          FhdMessenger.success('Đã xóa');
          fetchDataToTable();
        }).catch(FhdMessenger.errorFromServer);
      } else {
        vm.plEntry.$remove().then(() => $location.path('pl-entries'));
      }
    });
  };

  vm.removeItem = function (index, items) {
    items.splice(index, 1);
  }; // Update existing PlEntry


  vm.update = function () {
    const plEntry = vm.plEntry;
    plEntry.$update().then(() => $location.path('pl-entries')).catch(FhdMessenger.errorFromServer);
  };

  vm.plEntriesTable = new NgTableParams(); // Find a list of PlEntries

  vm.find = function () {
    vm.plEntries = PlEntries.query();
    vm.plEntries.$promise.then(() => {
      fetchDataToTable();
    });
  }; // Find existing PlEntry


  vm.findOne = function () {
    vm.plEntry = PlEntries.get({
      plEntryId: $stateParams.plEntryId
    });
  };

  vm.addItem = function (product) {
    vm.currentImage = _.get(product, 'imageLink') || _.get(product, 'wooProperties.images[0].src');
    vm.items = vm.items || [];

    const outletCode = _.get(vm.outlet, 'code', '');

    if (!_.get(product, 'rawProducts.length') && outletCode !== 'G4') {
      return FhdMessenger.error('Sản phẩm phải có Raw Products mới được tạo PL Task. Vui lòng thông báo cho Buying/BS để xử lý.');
    }

    if (!_.get(vm.buyingEntry, 'destination.code', '') && !vm.items.length && _.get(product, 'warehouseRestock.code', '')) {
      vm.destination = product.warehouseRestock;
    }

    const matchProductIndex = _.findIndex(vm.items, {
      sku: product.sku
    });

    if (matchProductIndex === -1) {
      vm.items.unshift({
        product: product._id,
        warehouseRestockCode: _.get(product, 'warehouseRestock.code', ''),
        sku: product.sku,
        description: product.description,
        productionTime: product.productionTime,
        quantity: product.quantity || 1,
        chunkQuantity: product.chunkQuantity || product.quantityPerPlTask,
        manufactureDate: product.manufacturingDate ? moment(product.manufacturingDate).format('YYYY-MM-DD') : undefined,
        expiryDate: product.expirationDate ? moment(product.expirationDate).format('YYYY-MM-DD') : undefined
      });
    } else {
      vm.items[matchProductIndex].quantity += 1;

      const oldItem = _.head(vm.items.splice(matchProductIndex, 1));

      vm.items.unshift(oldItem);
    }

    vm.suggestCogs();
  };

  vm.removeItem = function (index) {
    vm.items.splice(index, 1);
  };

  vm.caculateTotalTimeProduct = function (orderQuantity, productionTime) {
    if (orderQuantity && productionTime) {
      const totalTimeProduct = orderQuantity * productionTime * 60 * 1000;
      const duration = moment.duration(totalTimeProduct);
      const hours = duration.hours();
      const hoursDisplay = hours ? `${hours}h` : '';
      const minutes = duration.minutes();
      const minutesDisplay = minutes ? `${minutes}'` : '';
      return `${hoursDisplay}${minutesDisplay}`;
    } else {
      return 0;
    }
  };

  vm.setNewCogs = item => {
    _.forEach(vm.items, _item => {
      if (_item.sku === item.sku) {
        _item.buyingCogs = Math.ceil(item.totalCogs * 1000) / 1000;
      }
    });
  };

  vm.showSetNewCogs = item => {
    const diffCogs = Math.abs(item.totalCogs - item.currentCogs);
    return diffCogs > 1 && (vm.user.roles.includes('admin') || vm.user.roles.includes('purchaser') || vm.user.roles.includes('probation-purchaser'));
  };
}]);
'use strict'; // PlEntries service used to communicate PlEntries REST endpoints

angular.module('pl-entries').factory('PlEntries', ['$resource', function ($resource) {
  return $resource('pl-entries/:plEntryId', {
    plEntryId: '@_id'
  }, {
    update: {
      method: 'PUT'
    }
  });
}]);
