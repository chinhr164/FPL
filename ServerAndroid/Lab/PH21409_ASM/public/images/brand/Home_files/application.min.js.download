      FhdMessenger.success('Thay đổi vendor thành công.');
      $modalInstance.close();
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    });
  };

  vm.cancel = () => {
    $modalInstance.close();
  };
}]);
"use strict";

angular.module('buying-entries').controller('ModalConfirmBadItemController', ['data', '$modalInstance', 'BuyingEntries', 'NgTableParams', 'FhdMessenger', function (data, $modalInstance, BuyingEntries, NgTableParams, FhdMessenger) {
  const vm = this;
  const {
    _id,
    orderId,
    sku,
    description
  } = data;
  vm._id = _id;
  vm.orderId = orderId;
  vm.sku = sku;
  vm.description = description;

  vm.close = function () {
    $modalInstance.close();
  };

  vm.confirm = function () {
    if (!vm.note) {
      return FhdMessenger.error('Chưa có nội dung confirm');
    }

    BuyingEntries.confirmBadItem({
      id: _id,
      orderId,
      sku,
      note: vm.note
    }).$promise.then(buyingEntry => {
      vm.close();
    });
  };
}]);
"use strict";

angular.module('buying-entries').controller('ModalConfirmDirectBuyingEntryController', ['$http', '$location', '$localStorage', '$modalInstance', '$window', 'Authentication', 'buyingEntry', 'BuyingEntries', 'BuyingEntryService', 'FhdMessenger', 'NgTableParams', '$state', 'UserPhotoService', function ($http, $location, $localStorage, $modalInstance, $window, Authentication, buyingEntry, BuyingEntries, BuyingEntryService, FhdMessenger, NgTableParams, $state, UserPhotoService) {
  const vm = this;
  const getCurrentStatus = BuyingEntryService.getCurrentStatus;

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.close = $modalInstance.dismiss;
  vm.receiveItems = [];
  vm.images = [];
  vm.needInputExpirationDate = false;

  vm.init = function () {
    vm.buyingEntry = buyingEntry;
    vm.stockEntries = BuyingEntries.stockEntries({
      buyingEntryId: vm.buyingEntry._id
    });

    if (_.get(buyingEntry, 'destination.code') === 'M6') {
      vm.updating = true;
      return FhdMessenger.error('Hàng về M6 hãy dùng trang List Arriving Buying Entries để confirm nhé');
    }

    if (_.get(buyingEntry, 'destination.code') === 'B1') {
      vm.receiveItems = _.filter(vm.buyingEntry.items, item => {
        return item.arrivingQuantity > 0;
      });

      _.forEach(vm.receiveItems, item => {
        item.quantity = undefined;
      });

      if (_.some(vm.buyingEntry.items, {
        sku: 'V0627'
      })) {
        vm.needInputExpirationDate = true;
      } else {
        vm.needInputExpirationDate = false;
      }
    } else {
      vm.needInputExpirationDate = true;
    }

    vm.fetchTable();
    vm.buyingEntry.status = getCurrentStatus(buyingEntry);
    vm.buyingEntry.itemsTable.sorting({
      description: 'asc'
    });
  };

  vm.changeReceiveDay = function () {
    vm.buyingEntry.$pass().then(function () {
      FhdMessenger.success('Chuyển thành công');
      $modalInstance.close();
    }).catch(function (response) {
      const data = response.data;
      FhdMessenger.errorFromServer(data);
    });
  };

  vm.choosePhotos = function () {
    UserPhotoService.view().then(photos => {
      photos.forEach(photo => vm.images.push({
        link: photo.link
      }));
    });
  };

  vm.addImage = newImage => {
    vm.images = vm.images || [];

    if (newImage) {
      vm.images.push({
        data: newImage
      });
    }
  };

  vm.removeImage = index => {
    vm.images.splice(index, 1);
  };

  vm.productSearchSelected = function (product) {
    const productIndex = _.findIndex(vm.receiveItems, item => {
      return item.sku === product.sku;
    });

    if (productIndex > -1) {
      vm.receiveItems[productIndex].quantity += 1;
    } else {
      const matchItem = _.find(vm.buyingEntry.items, {
        sku: product.sku
      });

      vm.receiveItems.push({
        product: product._id,
        sku: product.sku,
        description: product.description,
        savorCategory: product.savorCategory,
        manufacturingDate: product.manufacturingDate,
        expirationDate: product.expirationDate,
        shelfLife: product.shelfLife,
        lowShelfLife: matchItem.lowShelfLife
      });
    }

    vm.fetchTable();
    vm.receiveItemsTable.reload();
  };

  const receiveBuyingEntry = _.throttle(() => {
    vm.updating = true;
    BuyingEntries.receive({
      _id: _.get(vm.buyingEntry, '_id'),
      receivedItems: vm.receiveItems,
      actualPayment: vm.actualPayment,
      noTotal: vm.noTotal,
      images: vm.images,
      billCode: vm.billCode
    }).$promise.then(({
      stockEntry
    }) => {
      FhdMessenger.success('Confirm thành công');
      $modalInstance.close();

      if (stockEntry) {
        $state.go('viewStockEntry', {
          stockEntryId: stockEntry._id
        });
      }
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.updating = false;
    });
  }, 2000);

  vm.inputQuantity = function (product) {
    product.quantity = $window.prompt('Nhập số lượng');
  };

  vm.createStockEntry = async function () {
    if (_.get(vm.buyingEntry, 'vendor.requireBillCode') && !vm.billCode) {
      return FhdMessenger.error('Chưa nhập mã hóa đơn');
    }

    if (!_.get(vm.images, 'length')) {
      return FhdMessenger.error('Chưa có ảnh hóa đơn hoặc sản phẩm thay thế');
    }

    if (_.get(vm.buyingEntry, 'destination.code', '').match(/(^B\d+|SS)/) && vm.images.length < 2) {
      return FhdMessenger.error('Tối thiểu 2 ảnh sản phẩm, 1 ảnh tổng quan hàng hóa nhận, 1 ảnh chụp rõ sản phẩm sau khi rạch thùng');
    }

    if (vm.needInputExpirationDate) {
      if (_.some(vm.receiveItems, item => {
        return !item.noDate && (!item.manufacturingDate || !item.expirationDate);
      })) {
        return FhdMessenger.error('Bạn cần nhập đẩy đủ NSX và HSD');
      }

      if (_.some(vm.receiveItems, item => {
        return moment().endOf('day').isBefore(item.manufacturingDate);
      })) {
        return FhdMessenger.error('NSX của các sản phẩm không được lớn hơn hôm nay');
      }

      if (_.some(vm.receiveItems, item => {
        return moment(item.manufacturingDate).isAfter(moment(item.expirationDate));
      })) {
        return FhdMessenger.error('HSD phải lớn hơn NSX. Vui lòng kiểm tra lại');
      }

      if (vm.needInputExpirationDate && _.some(vm.receiveItems, item => {
        return moment(item.expirationDate).isBefore(moment());
      })) {
        return FhdMessenger.error('HSD phải lớn hơn ngày hôm nay. Vui lòng kiểm tra lại');
      }
    }

    const totalArriving = vm.buyingEntry.items.reduce((totalArriving, item) => totalArriving + item.arrivingQuantity, 0);
    const totalReceive = vm.receiveItems.reduce((totalReceive, item) => totalReceive + item.quantity, 0);

    if (totalArriving <= totalReceive) {
      if (!vm.noTotal && !vm.actualPayment) {
        return FhdMessenger.errorFromServer('Lượng hàng nhập đã đủ theo số lượng đặt. Vui lòng nhập tổng tiền trên các hóa đơn vào "Tổng trên hóa đơn"');
      }
    }

    _.forEach(vm.receiveItems, item => {
      if (item.badQuantity) {
        item.note = `Có ${item.badQuantity} sản phẩm lỗi`;
      }
    });

    const mapReceiveItems = _.map(vm.receiveItemsTable.data, 'sku');

    const mapBuyingItems = _.map(vm.buyingEntry.items, 'sku');

    const diffSkus = _.difference(mapReceiveItems, mapBuyingItems);

    if (diffSkus.length) {
      const errorContent = _.reduce(diffSkus, (result, sku) => {
        const item = _.find(vm.receiveItemsTable.data, item => item.sku === sku);

        result += `${item.sku}-${item.description}\t`;
        return result;
      }, `Không thể thêm sản phẩm không có trong BE: `);

      return FhdMessenger.error(errorContent);
    }

    vm.updating = true;

    const items = _.map(vm.receiveItems, item => {
      return {
        sku: item.sku,
        quantity: item.quantity
      };
    });

    const duplicateStockEntries = (await $http.post('/stock-entries/check-duplicate-from-buying-entry', {
      items,
      buyingEntry: vm.buyingEntry._id
    })).data;

    if (duplicateStockEntries.length) {
      const stockEntryIds = _.map(duplicateStockEntries, 'stockEntryId').join(' ');

      const confirm = $window.confirm(`Có thể bị trùng với ${stockEntryIds}. Bạn muốn confirm tiếp chứ chứ?`);

      if (!confirm) {
        vm.updating = false;
        return;
      }
    }

    receiveBuyingEntry();
  };

  vm.needCogs = function (product) {
    if (['V0043', 'V0044', 'V0045', 'V0046', 'V0276', 'V0275', 'V0393'].includes(product.sku)) {
      return true;
    }

    return false;
  };

  vm.noDateChange = index => {
    if (vm.receiveItems[index].noDate) {
      vm.receiveItems[index].manufacturingDate = undefined;
      vm.receiveItems[index].expirationDate = undefined;
    }
  };

  vm.removeItem = function (index, items) {
    items.splice(index, 1);
    vm.receiveItemsTable.reload();
  };

  vm.fetchTable = () => {
    vm.buyingEntry.itemsTable = new NgTableParams({
      count: 50
    }, {
      dataset: vm.buyingEntry.items
    });
    vm.receiveItemsTable = new NgTableParams({
      count: 50
    }, {
      dataset: vm.receiveItems,
      counts: []
    });
  };
}]);
"use strict";

angular.module('buying-entries').controller('ModalCreateBuyingEntryComplaintController', ['$scope', 'buyingEntry', 'BuyingEntries', '$modalInstance', 'FhdMessenger', function ($scope, buyingEntry, BuyingEntries, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.complaintItems = buyingEntry.complaintItems || [];
  vm.buyingEntry = BuyingEntries.get({
    buyingEntryId: buyingEntry._id
  });

  vm.createComplaint = function () {
    if (!vm.complaintContent || _.some(vm.complaintItems, item => {
      return !item.complaintContent;
    })) {
      return FhdMessenger.error('Chưa có nội dung khiếu nại');
    }

    vm.buyingEntry.complaintContent = vm.complaintContent;
    vm.buyingEntry.complaintItems = vm.complaintItems;
    vm.buyingEntry.$needComplaint().then(buyingEntry => {
      $modalInstance.close(buyingEntry);
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.calculateTotal = function () {
    vm.total = _.reduce(vm.complaintItems, (result, item) => {
      result += _.get(item, 'quantity', 0) * _.get(item, 'cogs', 0);
      return result;
    }, 0);
  };
}]);
'use strict';

angular.module('stickets').controller('ModalCreateRemainController', ['$modalInstance', 'FhdMessenger', 'user', 'buyingEntryId', '$http', '$state', function ($modalInstance, FhdMessenger, user, buyingEntryId, $http, $state) {
  const vm = this;
  vm.close = $modalInstance.dismiss;
  vm.user = user;
  vm.images = [];

  vm.create = function () {
    if (!vm.note) {
      return FhdMessenger.error('Chưa có nội dung nhắc nhở');
    }

    $http.post(`/users/${vm.user._id}/reminds`, {
      note: vm.note,
      buyingEntryId: buyingEntryId,
      images: vm.images
    }).then(response => {
      FhdMessenger.success('Gửi nhắc nhở thành công');
      $state.reload();
      vm.close();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };
}]);
"use strict";

