angular.module('user-notes').controller('ModalCreateUserNoteController', ['$modalInstance', 'Users', 'FhdMessenger', 'userNote', 'UserNotes', 'Authentication', '$q', function ($modalInstance, Users, FhdMessenger, userNote, UserNotes, Authentication, $q) {
  const vm = this;
  vm.userNote = {};
  vm.userNote.staffs = userNote.staff ? [userNote.staff] : [];
  vm.buyingEntry = userNote.buyingEntry;
  vm.stockEntry = userNote.stockEntry;
  vm.checklistEntry = userNote.checklistEntry;
  vm.photoReport = userNote.photoReport;
  vm.user = Authentication.user;
  vm.content = '';
  vm.close = $modalInstance.close;
  vm.waiting = false;

  vm.create = function () {
    if (!vm.userNote.staffs.length) {
      return FhdMessenger.error('Bạn chưa nhập nhân viên');
    }

    if (!vm.date) {
      return FhdMessenger.error('Bạn chưa nhập ngày ghi chú');
    }

    if (!vm.content) {
      return FhdMessenger.error('Bạn chưa nhập ghi chú');
    }

    vm.waiting = true;
    $q.all(_.map(vm.userNote.staffs, staff => {
      const userNote = new UserNotes({
        staff,
        user: vm.user,
        content: vm.content,
        date: vm.date,
        buyingEntry: vm.buyingEntry || null,
        stockEntry: vm.stockEntry || null,
        checkListEntry: vm.checklistEntry || null,
        photoReport: vm.photoReport || null
      });
      return userNote.$save();
    })).then(userNotes => {
      FhdMessenger.success('Tạo thành công');
      $modalInstance.close(userNotes);
    }).catch(err => {
      FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.removeStaff = index => {
    vm.userNote.staffs.splice(index, 1);
  };

  vm.staffSelected = function (staffSelected) {
    vm.staff = null;
    if (_.some(vm.userNote.staffs, staff => _.isEqual(staff._id, staffSelected._id))) return;
    vm.userNote.staffs.push(staffSelected);
  };
}]);
'use strict'; // Vendors controller

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('user-notes').controller('UserNotesController', ['$stateParams', '$location', '$scope', 'Authentication', 'UserNotes', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'UserService', '$q', function ($stateParams, $location, $scope, Authentication, UserNotes, FhdMessenger, NgTableParams, ObjectId, UserService, $q) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.userNote = {};
  vm.userNote.staffs = [];
  vm.waiting = false;
  vm.userNotes = [];
  vm.userNote.content = '';

  vm.canRemoveUserNote = userNote => {
    if (userNote.status === 'deleted') {
      return false;
    }

    if (_.intersection(vm.user.roles, ['admin', 'user-note:delete']).length) {
      return true;
    }

    if (ObjectId.equals(vm.user, userNote.user)) {
      return true;
    }

    return false;
  };

  vm.init = () => {
    vm.endDate = moment().format('YYYY-MM-DD');
    vm.startDate = moment(vm.endDate).subtract(30, 'day').format('YYYY-MM-DD');
  };

  vm.canViewModal = () => {
    return _.some(['admin', 'tro-ly', 'tro-ly-ns', 'tro-ly-dt', 'tro-ly-kho', 'tro-ly-sx', 'tro-ly-kgch', 'tro-ly-lich-truc'], role => {
      return _.includes(vm.user.roles, role);
    });
  };

  vm.create = function () {
    if (vm.userNote.staffs.length <= 0) {
      return FhdMessenger.error('Chưa nhập nhân viên');
    }

    if (!vm.userNote.content) {
      return FhdMessenger.error('Chưa nhập ghi chú');
    }

    if (!vm.userNote.date) {
      return FhdMessenger.error('Chưa nhập ngày ghi chú');
    }

    vm.waiting = true;
    $q.all(_.map(vm.userNote.staffs, staffId => {
      const userNote = new UserNotes(_objectSpread({}, vm.userNote, {
        staff: staffId,
        user: vm.user
      }));
      userNote.$save();
    })).then(() => $location.path('user-notes')).catch(err => FhdMessenger.err(err.message)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.staffSelected = function (staffSelected) {
    vm.staff = null;
    if (_.some(vm.userNote.staffs, staff => _.isEqual(staff._id, staffSelected._id))) return;
    vm.userNote.staffs.push(staffSelected);
  };

  vm.removeStaff = index => {
    vm.userNote.staffs.splice(index, 1);
  };

  vm.userNotesTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    const startDate = vm.startDate ? moment(vm.startDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    const endDate = vm.endDate ? moment(vm.endDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    let promise = UserNotes.query({
      startDate,
      endDate
    }).$promise.then(userNotes => {
      vm.userNotes = userNotes;
      vm.userNotesTable.settings({
        dataset: userNotes
      });
      vm.userNotesTable.reload();
    }).catch(err => {
      return FhdMessenger.error(err.message);
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
  };

  vm.deleteUserNote = userNote => {
    const index = _.findIndex(vm.userNotes, {
      _id: userNote._id
    });

    userNote.$deleteUserNote().then(() => {
      vm.userNotes.splice(index, 1);
      vm.userNotesTable.reload();
    });
  };

  vm.viewUser = UserService.openViewUserModal;
}]);
"use strict";

angular.module('user-notes').controller('ViewUserNoteController', ['Authentication', 'UserNotes', '$stateParams', 'FhdMessenger', '$location', function (Authentication, UserNotes, $stateParams, FhdMessenger, $location) {
  const vm = this;
  vm.user = Authentication.user;

  vm.findOne = () => {
    vm.userNote = UserNotes.get({
      userNoteId: $stateParams.userNoteId
    });
  };

  vm.addComplaint = function () {
    const userNote = vm.userNote;
    if (!vm.complaint) return FhdMessenger.error('Nội dung không được để trống');
    userNote.newComplaintContent = vm.complaint;
    vm.waiting = true;
    userNote.$addComplaint().then(() => {
      vm.complaint = '';
    }).catch(errorResponse => FhdMessenger.errorFromServer(errorResponse)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.doneComplaint = () => {
    vm.waiting = true;
    vm.userNote.$doneComplaint().then(() => {
      FhdMessenger.success('Đã hoàn thành xử lý khiếu nại');
    }).catch(errorResponse => FhdMessenger.errorFromServer(errorResponse)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.deleteUserNote = () => {
    const userNote = vm.userNote;
    vm.waiting = true;
    userNote.$deleteUserNote().then(() => {
      FhdMessenger.success('Xoá thành công');
      $location.path('/user-notes');
    }).catch(err => {
      FhdMessenger.error(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

