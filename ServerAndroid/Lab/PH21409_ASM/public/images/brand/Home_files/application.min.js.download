angular.module('objectives').controller('ObjectivesController', ['$stateParams', 'Authentication', 'Objectives', 'FhdMessenger', 'WorkDepartmentService', 'UserService', '$state', '$q', 'ObjectId', 'ConfirmModal', '$timeout', function ($stateParams, Authentication, Objectives, FhdMessenger, WorkDepartmentService, UserService, $state, $q, ObjectId, ConfirmModal, $timeout) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {
    startDate: moment($stateParams.startDate || moment().subtract(3, 'month')).format('YYYY-MM-DD')
  };
  vm.data.endDate = moment($stateParams.endDate || Date.now()).format('YYYY-MM-DD');
  vm.workDepartments = [];
  vm.objective = null;
  vm.filterOwners = [];
  vm.filterWorkDepartmentMap = {};
  vm.newKeyResultDescription = '';
  vm.newObjective = {
    description: '',
    owners: [],
    workDepartment: null,
    keyResults: [{
      description: ''
    }]
  };
  vm.objectives = [];

  vm.removeOwner = (owners, owner) => {
    _.remove(owners, {
      _id: owner._id
    });
  };

  vm.onChangeOwner = owner => {
    if (!_.some(vm.newObjective.owners, objectiveOwner => {
      return objectiveOwner._id === owner._id;
    })) {
      vm.newObjective.owners.push(owner);
    }
  };

  vm.addKeyResult = (keyResults, description) => {
    if (!_.some(keyResults, {
      description
    })) {
      keyResults.push({
        description
      });
      vm.newKeyResultDescription = '';
    }
  };

  vm.removeKeyResult = (keyResults, keyResultIndex) => {
    keyResults.splice(keyResultIndex, 1);
  };

  vm.removeFilterOwner = owner => {
    _.remove(vm.filterOwners, {
      _id: owner._id
    });
  };

  vm.selectAllWorkDepartments = () => {
    const hasValue = _.some(vm.filterWorkDepartmentMap, value => {
      return value;
    });

    vm.workDepartments.forEach(workDepartment => {
      vm.filterWorkDepartmentMap[workDepartment.code] = !hasValue;
    });
  };

  vm.getDefaultValue = () => {
    $timeout(() => {
      WorkDepartmentService.allAsync().then(workDepartments => {
        vm.workDepartments = workDepartments.sort((a, b) => {
          return a.name.localeCompare(b.name);
        });

        if ($stateParams.workDepartment) {
          vm.newObjective.workDepartment = _.find(workDepartments, {
            _id: $stateParams.workDepartment
          });
        }
      });
      UserService.allStaffsAsync().then(users => {
        if ($stateParams.owners && _.isString($stateParams.owners)) {
          $stateParams.owners = [$stateParams.owners];
        }

        if ($stateParams.owners && $stateParams.owners.length) {
          $stateParams.owners.forEach(userId => {
            vm.newObjective.owners.push(Object.assign({}, _.find(users, {
              _id: userId
            })));
          });
        }
      });
    }, 200);
  };

  vm.create = function () {
    const objective = new Objectives(vm.newObjective);
    objective.$save().then(() => {
      FhdMessenger.success('Tạo Objective thành công');

      const owners = _.map(vm.newObjective.owners, ObjectId.getObjectId);

      const workDepartment = ObjectId.getObjectId(vm.newObjective.workDepartment);

      _.assignIn(vm.newObjective, {
        description: '',
        keyResults: []
      });

      $state.go('createObjective', {
        owners,
        workDepartment
      });
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    });
  };

  vm.updateState = () => {
    const filterOwners = _.map(vm.filterOwners, 'code');

    const filterWorkDepartmentCodes = _.reduce(vm.filterWorkDepartmentMap, (result, value, workDepartmentCode) => {
      if (value) result.push(workDepartmentCode);
      return result;
    }, []); // Nếu đã filter toàn bộ work departments thì khôgn cần lọc theo work departments nữa!


    if (filterWorkDepartmentCodes.length === vm.workDepartments.length) {
      FhdMessenger.info('Khi bạn tick chọn tất cả các team thì hệ thống không cần lọc theo team nữa.');
      vm.filterWorkDepartmentMap = {};
      filterWorkDepartmentCodes.length = 0;
    }

    $state.go('listObjectives', {
      owners: filterOwners,
      workDepartments: filterWorkDepartmentCodes,
      startDate: moment(vm.data.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.data.endDate).format('YYYY-MM-DD')
    });
  };

  vm.find = () => {
    vm.waiting = true;
    $q.all([WorkDepartmentService.allAsync().then(workDepartments => {
      vm.workDepartments = workDepartments.sort((a, b) => {
        return a.name.localeCompare(b.name);
      }).filter(workDepartment => {
        return workDepartment.hasOkrs;
      });

      if ($stateParams.workDepartments && _.isString($stateParams.workDepartments)) {
        $stateParams.workDepartments = [$stateParams.workDepartments];
      }

      if ($stateParams.workDepartments && $stateParams.workDepartments.length) {
        $stateParams.workDepartments.forEach(workDepartmentCode => {
          vm.filterWorkDepartmentMap[workDepartmentCode] = true;
        });
      }
    }), UserService.allStaffsAsync().then(users => {
      if ($stateParams.owners && _.isString($stateParams.owners)) {
        $stateParams.owners = [$stateParams.owners];
      }

      if ($stateParams.owners && $stateParams.owners.length) {
        $stateParams.owners.forEach(userCode => {
          vm.filterOwners.push(Object.assign({}, _.find(users, {
            code: userCode
          })));
        });
      }
    })]).then(() => {
      const filterOwners = _.map(vm.filterOwners, '_id');

      const filterWorkDepartmentCodes = _.reduce(vm.filterWorkDepartmentMap, (result, value, workDepartmentCode) => {
        const matchWorkDepartment = _.find(vm.workDepartments, {
          code: workDepartmentCode
        });

        if (value) result.push(matchWorkDepartment._id);
        return result;
      }, []);

      Objectives.query({
        'owners[]': filterOwners,
        'workDepartments[]': filterWorkDepartmentCodes,
        startDate: $stateParams.startDate || vm.data.startDate,
        endDate: $stateParams.endDate || vm.data.endDate
      }).$promise.then(objectives => {
        vm.objectives = objectives;
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.findOne = async () => {
    $q.all([WorkDepartmentService.allAsync(), UserService.allStaffsAsync(), Objectives.get({
      objectiveId: $stateParams.objectiveId
    }).$promise]).then(([workDepartments, users, objective]) => {
      const matchWorkDepartment = _.find(workDepartments, {
        _id: ObjectId.getObjectId(objective.workDepartment)
      });

      const owners = _.filter(users, user => {
        return _.some(objective.owners, {
          _id: user._id
        });
      });

      vm.objective = objective;
      vm.objective.workDepartment = matchWorkDepartment;
      vm.objective.owners = owners;
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.update = () => {
    vm.waiting = true;
    vm.objective.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $state.go('listObjectives');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.remove = () => {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xóa OKR`,
      headerText: `Bạn muốn XÓA OKR này?`,
      bodyText: `Một khi đã xóa sẽ không thể khôi phục được nữa!`
    }).then(() => {
      vm.waiting = true;
      vm.objective.$remove().then(() => {
        FhdMessenger.success('Xóa OKR thành công');
        $state.go('listObjectives');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('objectives').factory('Objectives', ['$resource', function ($resource) {
  return $resource('objectives/:objectiveId', {
    objectiveId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    done: {
      method: 'PUT',
      url: 'objectives/:objectiveId/done'
    }
  });
}]);
'use strict';

