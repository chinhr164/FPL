angular.module('user-photos').component('fhdUploadPhoto', {
  templateUrl: 'modules/user-photos/templates/fhd-upload-photos.client.template.html',
  controller: 'FhdUploadPhotosController',
  transclude: true,
  controllerAs: 'vm',
  bindings: {
    images: '=',
    myPhotoOption: '@',
    hidePasteImage: '@',
    label: '@',
    width: '@',
    viewMode: '@',
    divideCol: '@',
    limit: '@',
    photoReport: '@',
    comments: '@'
  }
}).controller('FhdUploadPhotosController', ['UserPhotoService', 'FhdMessenger', 'UserPhotos', 'Authentication', '$window', function (UserPhotoService, FhdMessenger, UserPhotos, Authentication, $window) {
  const vm = this;
  vm.user = Authentication.user;

  vm.init = function () {
    vm.images = vm.images || [];
    vm.myPhotoOption = vm.myPhotoOption === 'true';
    vm.hidePasteImage = vm.hidePasteImage === 'true';
    vm.viewMode = vm.viewMode === 'true';
    vm.limit = Number(vm.limit) || 100;
    vm.col = Number(vm.divideCol);
    vm.width = Number(vm.width);

    if (vm.col) {
      vm.diviceClass = `col-sm-${vm.col}`;
      vm.myPhotoClass = `col-sm-${12 - vm.col}`;
    }
  };

  vm.getImagesFromClipboard = function (e) {
    const files = e.originalEvent.clipboardData.files;

    if (files.length > 0 && files[0].type.startsWith('image/')) {
      const fileReader = new $window.FileReader();
      fileReader.readAsDataURL(files[0]);

      fileReader.onload = () => {
        vm.addImage(fileReader.result);
      };

      return FhdMessenger.success('Thêm ảnh thành công');
    } else {
      return FhdMessenger.error('Dữ liệu paste không phải là ảnh');
    }
  };

  vm.choosePhotos = function () {
    UserPhotoService.view().then(photos => {
      photos.forEach(photo => {
        if (vm.images.length === Number(vm.limit)) {
          return FhdMessenger.error(`Chỉ được upload tối đa ${vm.limit} ảnh`);
        }

        vm.images.push({
          link: photo.link
        });
      });
    });
  };

  vm.addImage = newImage => {
    vm.images = vm.images || [];

    if (vm.images.length === Number(vm.limit)) {
      return FhdMessenger.error(`Chỉ được upload tối đa ${vm.limit} ảnh`);
    }

    if (UserPhotoService.getImageSize(newImage) > 2048) {
      FhdMessenger.info('Hình ảnh có kích thước lớn, chờ xử lý');
    }

    const resizePhoto = new UserPhotos({
      data: newImage,
      user: vm.user.username
    });
    resizePhoto.$resizeAndUpload().then(res => {
      const {
        link
      } = _.head(res.uploadedImage);

      if (newImage) {
        vm.images.push({
          link
        });
      }
    }).catch(error => {
      return FhdMessenger.errorFromServer(error);
    });
  };

  vm.removeImage = index => {
    vm.waiting = true;
    UserPhotoService.removeS3(vm.images[index]).then(res => {
      vm.images.splice(index, 1);
      return FhdMessenger.success('Xóa ảnh thành công');
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict'; // Setting up route

angular.module('user-photos').config(['$stateProvider', function ($stateProvider) {
  // User photo state routing
  $stateProvider.state('user-photos', {
    url: '/user-photos/upload',
