angular.module('shipping-entries').controller('ImportShippingEntryController', ['Authentication', 'FhdMessenger', 'ShippingEntries', 'ConfirmModal', function (Authentication, FhdMessenger, ShippingEntries, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;

  vm.import = () => {
    if (!vm.googleSheetLink) {
      return FhdMessenger.error('Bạn chưa điền link google sheet');
    }

    if (!_.includes(vm.googleSheetLink, 'https://docs.google.com/spreadsheets/d/')) {
      return FhdMessenger.error('Link google sheet không đúng định dạng');
    }

    ConfirmModal.showModal({}, {
      headerText: `Hành động này sẽ import shipping entry từ link gg sheet?`,
      bodyText: `<strong>Lưu ý</strong>: <p>Link google sheet <a href="${vm.googleSheetLink}">này</a> cần được cấp quyền xem cho tài khoản chuthang205@gmail.com</p>`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      ShippingEntries.import({
        googleSheetLink: vm.googleSheetLink
      }).$promise.then(shippingEntries => {
        return FhdMessenger.success(`Import ${shippingEntries.length} Shipping Entries thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('shipping-entries').controller('ModalAddCompensationValueShippingEntryController', ['shippingEntry', '$modalInstance', 'Authentication', '$modal', 'FhdMessenger', '$http', '$window', function (shippingEntry, $modalInstance, Authentication, $modal, FhdMessenger, $http, $window) {
  const vm = this;
  vm.user = Authentication.user;
  vm.shippingEntry = shippingEntry;
  vm.cancel = $modalInstance.dismiss;

  vm.update = () => {
