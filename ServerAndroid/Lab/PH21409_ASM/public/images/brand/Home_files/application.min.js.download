  vm.openEditB1ShiftReport = function (staff) {
    $modal.open({
      animation: true,
      size: 'md',
      templateUrl: 'modules/users/templates/modal-edit-b1-shift-reports.client.template.html',
      controller: ['doc', '$modalInstance', function (doc, $modalInstance) {
        const vm = this;
        vm.doc = doc;

        function caculateSalary() {
          const numShiftReportByFactor = _.reduce(vm.doc.shiftReports, (result, shiftReport) => {
            let factor = 1;

            if (shiftReport.salaryPosition === 'PROBATION') {
              //
              factor = 0.8;
            }

            result += factor;
            return result;
          }, 0);

          vm.doc.finalSalary = numShiftReportByFactor / vm.doc.numBaseShift * (_.get(vm.doc, 'baseSalary', 0) + _.get(vm.doc, 'lunchSupport', 0)) + vm.doc.supportSalary + vm.doc.prizeMoney - vm.doc.fineMoney;
          vm.doc.actualSalary = vm.doc.finalSalary * vm.doc.actualSalaryPercent / 100;

          if (vm.doc.actualSalaryPercent < 100) {
            vm.doc.keptSalary = vm.doc.finalSalary - vm.doc.actualSalary;
          }
        }

        vm.changePosition = shiftReport => {
          if (shiftReport.salaryPosition === 'KITCHENHAND') {
            shiftReport.salaryPosition = 'PROBATION'; //
          } else if (shiftReport.salaryPosition === 'PROBATION') {
            //
            shiftReport.salaryPosition = 'KITCHENHAND';
          }

          caculateSalary();
        };

        vm.close = () => $modalInstance.dismiss();
      }],
      controllerAs: 'vm',
      resolve: {
        doc: () => staff
      }
    });
  };

  vm.openEditPositionInShift = function (staff) {
    $modal.open({
      animation: true,
      size: 'md',
      templateUrl: 'modules/users/templates/modal-edit-position-in-shifts.client.template.html',
      controller: ['doc', '$modalInstance', function (doc, $modalInstance) {
        const vm = this;
        vm.doc = doc;

        function caculateSalary() {
          const numShiftByFactor = _.reduce(vm.doc.shifts, (result, shift) => {
            let factor = 2;

            if (shift.salaryPosition === 'PROBATION') {
              //
              factor = 1.6;
            }

            result += factor;
            return result;
          }, 0);

          vm.doc.finalSalary = numShiftByFactor / vm.doc.numBaseShift * _.get(vm.doc, 'baseSalary', 0) + vm.doc.supportSalary + vm.doc.prizeMoney - vm.doc.fineMoney;
          vm.doc.actualSalary = vm.doc.finalSalary * vm.doc.actualSalaryPercent / 100;

          if (vm.doc.actualSalaryPercent < 100) {
            vm.doc.keptSalary = vm.doc.finalSalary - vm.doc.actualSalary;
          }
        }

        vm.changePosition = shift => {
          if (shift.salaryPosition === 'OFFICIAL') {
            //
            shift.salaryPosition = 'PROBATION';
          } else if (shift.salaryPosition === 'PROBATION') {
            //
            shift.salaryPosition = 'OFFICIAL';
          }

          caculateSalary();
        };

        vm.close = () => $modalInstance.dismiss();
      }],
      controllerAs: 'vm',
      resolve: {
        doc: () => staff
      }
    });
  };

  vm.createMultipleStaffSalaryMonthlyReports = function () {
    const userSalaries = _.filter(vm.usersTable.data, 'checked');

    if (!userSalaries.length) {
      return FhdMessenger.error('Chưa chọn nhân viên nào');
    }

    _.forEach(userSalaries, userSalary => {
      userSalary.name = `Lương Tháng ${moment(new Date(vm.data.endDate)).format('MM/YYYY')} của ${userSalary.user.displayName}`;
      userSalary.staff = userSalary.user._id;
      userSalary.endDate = vm.data.endDate;
      userSalary.startDate = vm.data.startDate;
    });

    vm.waiting = true;
    $http.post('/staff-salary-monthly-reports/create-multiple', {
      staffSalaryMonthlyReports: userSalaries
    }).then(() => {
      _.forEach(vm.usersTable.data, salary => {
        salary.checked = false;
      });

      FhdMessenger.success(`Gửi ${userSalaries.length} bảng lương thành công`);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.createStaffSalaryMonthlyReport = function (staff, index) {
    vm.sending = vm.sending || [];
    vm.sent = vm.sent || [];
    vm.sending[index] = true;
    var staffSalaryMonthlyReport = new StaffSalaryMonthlyReports(_.assign({}, staff, {
      name: 'Lương Tháng ' + moment(new Date(vm.data.endDate)).format('MM/YYYY') + ' của ' + staff.user.displayName,
      staff: staff.user._id
    }));
    staffSalaryMonthlyReport.endDate = vm.data.endDate;
    staffSalaryMonthlyReport.startDate = vm.data.startDate;
    staffSalaryMonthlyReport.$save(function (status) {
      staff.sending = false;
      staff.sent = true;
      FhdMessenger.success('Ok!');
    }, function (err) {
      staff.sending = false;
      FhdMessenger.errorFromServer(err);
    });
  }; // Date stuff //


  vm.open = function ($event) {
    $event.preventDefault();
    $event.stopPropagation();
    vm.opened = true;
