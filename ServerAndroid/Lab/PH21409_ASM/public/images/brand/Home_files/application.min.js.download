angular.module('reports').directive('fhdDimensionsTable', [function () {
  return {
    templateUrl: 'modules/reports/directives/fhd-dimensions-table.client.template.html',
    restrict: 'E',
    scope: {
      tableData: '=',
      previousTableData: '=?',
      labelPath: '=',
      labelPaths: '=',
      idPath: '=',
      dimensionName: '=',
      valuePath: '@',
      filterParam: '='
    },
    controller: 'FhdDimensionsTableController'
  };
}]).controller('FhdDimensionsTableController', ['$scope', 'NgTableParams', function ($scope, NgTableParams) {
  $scope.tableParams = new NgTableParams({
    count: 50
  });

  function getDimension(currentDimension) {
    if (currentDimension === 'product-group') return 'product-deparment';
    if (currentDimension === 'product-deparment') return 'product-cat';
    if (currentDimension === 'product-cat') return 'product';
    if (currentDimension === 'dayOfMonth') return 'outlet';
    if (currentDimension === 'outlet') return 'hour';
    if (currentDimension === 'referrer') return 'hour';
    return currentDimension;
  }

  $scope.$watch(function () {
    return {
      tableData: $scope.tableData,
      previousTableData: $scope.previousTableData
    };
  }, function (newValue, oldValue) {
    if (newValue !== oldValue) {
      const sum = _.reduce($scope.tableData, function (total, item) {
        return total + _.get(item, $scope.valuePath || 'value');
      }, 0);

      let previousSum = 0;

      if ($scope.previousTableData) {
        previousSum = _.reduce($scope.previousTableData, function (total, item) {
          return total + _.get(item, $scope.valuePath || 'value');
        }, 0);
      }

      $scope.sum = sum;
      $scope.previousSum = previousSum;

      const previousTableMap = _.reduce($scope.previousTableData, (result, item) => {
        const id = _.get(item, $scope.idPath || '_id');

        result[id && id.toUpperCase ? id.toUpperCase() : id] = item;
        return result;
      }, {});

      const tableDataMap = _.reduce($scope.tableData, (result, item) => {
        const id = _.get(item, $scope.idPath || '_id');

        result[id && id.toUpperCase ? id.toUpperCase() : id] = item;
        return result;
      }, {});

      const allIds = _.compact(_.uniq(_.map($scope.tableData, $scope.idPath || '_id').concat(_.map($scope.previousTableData, $scope.idPath || '_id')).map(d => d && d.toUpperCase ? d.toUpperCase() : d)));

      $scope.dimensions = _.map(allIds, function (id) {
        const item = _.get(tableDataMap, id || 'N/A');

        const matchItem = _.get(previousTableMap, id || 'N/A');

        const idValue = _.get(item, $scope.idPath || '_id') || 'N/A';
        let label = _.get(item, $scope.labelPath || 'label') || _.get(matchItem, $scope.labelPath || 'label') || 'N/A';

        if (_.get($scope, 'labelPaths.length')) {
          label = _.map($scope.labelPaths, labelPath => {
            return _.get(item, labelPath || 'label') || _.get(matchItem, labelPath || 'label') || 'N/A';
          }).join(' - ');
        }

        const highlight = ['SOUTH', 'CENTRAL'].includes(_.get(item, '_id.region'));

        const value = _.get(item, $scope.valuePath || 'value', 0);

        const previousValue = _.get(matchItem, $scope.valuePath || 'value', 0);

        const previousPercentage = previousValue / previousSum * 100;
        const percentage = value / sum * 100;
        const difference = value - previousValue;
        const differencePercentage = (value - previousValue) / previousValue * 100;

        const params = _.assign({}, $scope.filterParam, {
          [$scope.dimensionName]: idValue,
          dimension: getDimension($scope.filterParam.dimension)
        });

        return {
          label,
          highlight,
          value,
          idValue,
          previousValue,
          previousPercentage,
          difference,
          differencePercentage,
          params,
          percentage
        };
      });
      $scope.tableParams.settings({
        dataset: $scope.dimensions
      });
    }
  }, true);

  $scope.changeFilterParam = function (dimension) {
    if (!$scope.dimensionName) return;
    $scope.filterParam[$scope.dimensionName] = dimension.idValue;
  };
}]);
'use strict';

