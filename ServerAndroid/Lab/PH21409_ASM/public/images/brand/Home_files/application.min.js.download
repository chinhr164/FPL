angular.module('evaluation-rank-entries').controller('EvaluationRankEntriesController', ['$stateParams', 'Authentication', 'ConfirmModal', 'EvaluationRankEntriesService', 'EvaluationRankEntries', 'FhdMessenger', 'NgTableParams', function ($stateParams, Authentication, ConfirmModal, EvaluationRankEntriesService, EvaluationRankEntries, FhdMessenger, NgTableParams) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.openModalViewEvaluationRankEntry = EvaluationRankEntriesService.openModalViewEvaluationRankEntry;
  vm.evaluationRankEntriesTable = new NgTableParams({
    count: 1000
  });

  function getGroup(evaluationRankEntry) {
    const outletCode = _.get(evaluationRankEntry, 'outlet.code', '');

    if (outletCode.match(/[ME]\d+/)) {
      return 'Abby';
    }

    if (outletCode.match(/[S]\d+/)) {
      return 'Savor';
    }

    return 'Backend';
  }

  function getResult(evaluationRankEntry) {
    if (evaluationRankEntry.numTestSticket) {
      return 'Trượt';
    }

    if (evaluationRankEntry.numZeroFineMoneySticket > 5) {
      return 'Trượt';
    }

    const outletCode = _.get(evaluationRankEntry, 'outlet.code', '');

    if (outletCode.match(/[ME]\d+/) && evaluationRankEntry.evaluationPoint < 6) {
      return 'Trượt';
    }

    if (outletCode.match(/[S]\d+/) && evaluationRankEntry.evaluationPoint < 4) {
      return 'Trượt';
    }

    return 'Đạt';
  }

  vm.find = () => {
    vm.waiting = true;
    EvaluationRankEntries.query({
      month: vm.month,
      filterByMonth: vm.filterByMonth
    }).$promise.then(evaluationRankEntries => {
      _.forEach(evaluationRankEntries, evaluationRankEntry => {
        evaluationRankEntry.group = getGroup(evaluationRankEntry);
        evaluationRankEntry.result = getResult(evaluationRankEntry);
      });

      vm.evaluationRankEntriesTable.settings({
        dataset: evaluationRankEntries
      });
      vm.evaluationRankEntries = evaluationRankEntries;
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = async () => {
    vm.evaluationRankEntry = EvaluationRankEntries.get({
      evaluationRankEntryId: $stateParams.evaluationRankEntryId
    }).$promise.then(evaluationRankEntry => {
      vm.evaluationRankEntry = evaluationRankEntry;
    });
  };

  vm.openModalVote = (evaluationRankEntry, outletCode) => {
    EvaluationRankEntriesService.openModalVote(evaluationRankEntry, outletCode).then(({
      allowed,
      comment
    }) => {
      evaluationRankEntry.allowed = allowed;
      evaluationRankEntry.comment = comment;
      evaluationRankEntry.outletCode = outletCode;
      evaluationRankEntry.$vote();
    });
  };

  vm.openModalSelectResult = evaluationRankEntry => {
    EvaluationRankEntriesService.openModalVote(evaluationRankEntry, 'HR').then(({
      allowed,
      comment
    }) => {
      evaluationRankEntry.approved = allowed;
      evaluationRankEntry.comment = comment;
      evaluationRankEntry.$selectResult();
    });
  };

  vm.exportForm = () => {
    const evaluationRankEntries = vm.evaluationRankEntries.map(evaluationRankEntry => {
      return {
        'Mã nhân viên': evaluationRankEntry.staff.code,
        'Họ và tên': evaluationRankEntry.staff.displayName,
        'Cơ Sở': evaluationRankEntry.outlet.code,
        Nhóm: getGroup(evaluationRankEntry),
        'Rank cũ': evaluationRankEntry.oldRank,
        'Ngày đủ điểm lên Rank': moment(evaluationRankEntry.dateUpRank).format('DD/MM/YYYY'),
        'Rank mới': evaluationRankEntry.newRank,
        'Chốt rank': evaluationRankEntry.result
      };
    });
    alasql(`SELECT * INTO XLSX("export-valuation-rank-entries.xlsx",{headers:true, utf8Bom: true,}) FROM ? ORDER BY "Ngày đủ điểm lên Rank" DESC   `, //
    [evaluationRankEntries]);
  };

  vm.import = () => {
    if (!vm.googleSheetLink) {
      return FhdMessenger.error('Bạn chưa điền link google sheet');
    }

    if (!_.includes(vm.googleSheetLink, 'https://docs.google.com/spreadsheets/d/')) {
      return FhdMessenger.error('Link google sheet không đúng định dạng');
    }

    ConfirmModal.showModal({}, {
      headerText: `Hành động này sẽ import điểm từ từ link gg sheet?`,
      bodyText: `<strong>Lưu ý</strong>: <p>Link google sheet <a href="${vm.googleSheetLink}">này</a> cần được cấp quyền xem cho tài khoản chuthang205@gmail.com</p>`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      EvaluationRankEntries.import({
        googleSheetLink: vm.googleSheetLink
      }).$promise.then(evaluationRankEntries => {
        return FhdMessenger.success(`Import ${evaluationRankEntries.length} điểm DVKH thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('evaluation-rank-entries').controller('ModalViewEvaluationRankEntryController', ['FhdMessenger', 'evaluationRankEntry', '$modalInstance', function (FhdMessenger, evaluationRankEntry, $modalInstance) {
