angular.module('shipping-areas').controller('ModalCreateAreaController', ['$modalInstance', '$scope', 'FhdMessenger', 'ShippingAreas', function ($modalInstance, $scope, FhdMessenger, ShippingAreas) {
  const vm = this;

  vm.create = async () => {
    const shippingArea = new ShippingAreas(vm.shippingArea);
    shippingArea.$save().then(shippingArea => {
      FhdMessenger.success('Tạo xong!');
      return shippingArea;
    }).then(shippingArea => $modalInstance.close(shippingArea)).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = () => {
    $modalInstance.close(true);
  };

  $scope.$watch(() => vm.items, (newImportItems, oldImportItems) => {
    if (newImportItems === oldImportItems) return;
    vm.shippingArea.items = newImportItems;
  });
}]);
'use strict';

angular.module('shipping-areas').controller('ModalUpdateAreaController', ['$modalInstance', '$scope', 'FhdMessenger', 'shippingAreaId', 'ShippingAreas', function ($modalInstance, $scope, FhdMessenger, shippingAreaId, ShippingAreas) {
  const vm = this;
  ShippingAreas.get({
    shippingAreaId: shippingAreaId
  }).$promise.then(shippingArea => {
    vm.shippingArea = shippingArea;
  });

  vm.update = () => {
    vm.waiting = true;
    vm.shippingArea.$update().then(shippingArea => {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close(shippingArea);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.cancel = $modalInstance.dismiss;
  $scope.$watch(() => vm.items, (newImportItems, oldImportItems) => {
    if (newImportItems === oldImportItems) return;
    vm.shippingArea.items = newImportItems;
  });
}]);
'use strict';

