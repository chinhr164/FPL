    });
  }; // Remove existing Rank a point


  vm.remove = function (rankAPoint) {
    if (rankAPoint) {
      rankAPoint.$remove();

      for (var i in vm.rankAPoints) {
        if (vm.rankAPoints[i] === rankAPoint) {
          vm.rankAPoints.splice(i, 1);
        }
      }
    } else {
      vm.rankAPoint.$remove();
    }
  }; // Update existing Rank a point


  vm.update = function () {
    var rankAPoint = vm.rankAPoint;
    rankAPoint.$update(function () {
      $location.path('rank-a-points/' + rankAPoint._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of Rank a points


  vm.find = function () {
    vm.rankAPoints = RankAPoints.query();
  }; // Find existing Rank a point


  vm.findOne = function () {
    vm.rankAPoint = RankAPoints.get({
      rankAPointId: $stateParams.rankAPointId
    });
  };
}]);
