angular.module('evaluation-forms').controller('EvaluationFormsController', ['$stateParams', '$location', '$scope', 'Authentication', 'EvaluationForms', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'helper', 'ConfirmModal', function ($stateParams, $location, $scope, Authentication, EvaluationForms, FhdMessenger, NgTableParams, ObjectId, helper, ConfirmModal) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;

  vm.addFormFields = () => {
    vm.evaluationForm.formFields = vm.evaluationForm.formFields || [];
    vm.evaluationForm.formFields.push({});
  };

  vm.removeValueFromArray = helper.removeValueFromArray;
  vm.startDate = moment().subtract(1, 'week').startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.evaluationFormsTable = new NgTableParams({
    count: 50
  });

  vm.lineManagersContent = workContent => {
    return helper.joinArrayWithProperties(workContent.lineManager, ['code', 'displayName'], ' - ');
  };

  vm.find = () => {
    vm.waiting = true;
    EvaluationForms.query({}).$promise.then(data => {
      vm.evaluationFormsTable.settings({
        dataset: data
      });
      vm.evaluationFormsTable.sorting({
        createdAt: 'desc'
      });
      FhdMessenger.success('Tải xong!');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = async () => {
    vm.evaluationForm = EvaluationForms.get({
      evaluationFormId: $stateParams.evaluationFormId
    }).$promise.then(evaluationForm => {
      vm.evaluationForm = evaluationForm;
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    });
  };

  vm.update = () => {
    vm.waiting = true;
    vm.evaluationForm.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('evaluation-forms');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.deactivate = (evaluationForm, index) => {
    ConfirmModal.showModal({}, {
      bodyText: `Bạn muốn xoá evaluation forms của ${evaluationForm.staff.code} - ${evaluationForm.staff.displayName}?`,
      actionButtonText: 'OK',
      closeButtonText: 'Cancel'
    }).then(() => {
      vm.waiting = true;
      evaluationForm.$remove().then(() => {
        vm.evaluationFormsTable.data.splice(index, 1);
        return FhdMessenger.success('Xoá thành công');
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('evaluation-forms').controller('ImportEvaluationFormsController', ['Authentication', 'EvaluationForms', 'FhdMessenger', 'ConfirmModal', function (Authentication, EvaluationForms, FhdMessenger, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;

  vm.import = () => {
    if (!vm.googleSheetLink) {
      return FhdMessenger.error('Bạn chưa điền link google sheet');
    }

    if (!_.includes(vm.googleSheetLink, 'https://docs.google.com/spreadsheets/d/')) {
      return FhdMessenger.error('Link google sheet không đúng định dạng');
    }

    ConfirmModal.showModal({}, {
      headerText: `Hành động này sẽ import Evaluation Forms từ link gg sheet?`,
      bodyText: `<strong>Lưu ý</strong>: <p>Link google sheet <a href="${vm.googleSheetLink}">này</a> cần được cấp quyền xem cho tài khoản chuthang205@gmail.com</p>`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      EvaluationForms.import({
        googleSheetLink: vm.googleSheetLink
      }).$promise.then(EvaluationForms => {
        return FhdMessenger.success(`Import thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
