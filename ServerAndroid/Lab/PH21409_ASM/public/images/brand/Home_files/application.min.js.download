angular.module('complaints').controller('ComplaintsController', ['$stateParams', '$location', 'helper', 'Authentication', 'NgTableParams', 'Complaints', 'OutletService', 'ObjectId', 'ComplaintService', 'FhdMessenger', 'SticketService', '$window', '$scope', function ($stateParams, $location, helper, Authentication, NgTableParams, Complaints, OutletService, ObjectId, ComplaintService, FhdMessenger, SticketService, $window, $scope) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.endDate = moment().format('YYYY-MM-DD');
  vm.startDate = moment().subtract(1, 'month').format('YYYY-MM-DD');
  vm.data.categories = ComplaintService.getCategories();
  vm.data.subCategories = ComplaintService.getSubCategories();
  vm.complaint = {
    content: '',
    relatedPlTasks: [],
    complaintCustomer: {},
    deadline: moment().add(4, 'day').format('YYYY-MM-DD')
  };

  if ($window.Cypress) {
    vm.startDate = moment('2018-08-18').format('YYYY-MM-DD');
  }

  vm.removeValueFromArray = helper.removeValueFromArray;

  function loadStatus() {
    vm.statusMap = {
      created: true,
      processing: true,
      done: false,
      inactive: false
    };
  }

  vm.init = () => {
    loadStatus();
  }; // Create new complaint


  vm.create = function () {
    if (!vm.complaint.processStaff) {
      return FhdMessenger.error('Chưa chọn nhân viên xử lý');
    }

    if (!_.get(vm.complaint, 'complaintCustomer.cellphone')) {
      return FhdMessenger.error('Bạn chưa điền SĐT khách hàng. Nếu muốn tạo complaint cho Logistic Entry/Deliver Entry/Photo Report vui lòng vào trang xem Logistic Entry/Deliver Entry/Photo Report rồi ấn nút tạo complaint nhé');
    }

    if (!vm.complaint.deadline) {
      return FhdMessenger.error('Chưa có hạn xử lý');
    }

    if (!_.intersection(vm.complaint.processStaff.roles, ['admin']).length && !ObjectId.equals(vm.complaint.processStaff.outlet, vm.complaint.outlet) && !_.some(vm.complaint.processStaff.managingOutlets, outlet => {
      return ObjectId.equals(outlet, vm.complaint.outlet);
    })) {
      return FhdMessenger.error('Cơ sở được chọn không nằm trong danh sách quản lý của người xử lý');
    }

    if (vm.complaint.content.length >= 500000) {
      return FhdMessenger.error(`Bạn đã nhập quá số kí tự là: ${vm.complaint.content.length - 500000}`);
    }

    vm.complaint.categories = ComplaintService.getSelectedCategories(vm.data.categories);
    vm.complaint.subCategories = ComplaintService.getSelectedSubCategories(vm.data.subCategories); // Create complaint object

    const complaint = new Complaints(vm.complaint);
    vm.waiting = true; // Redirect after save

    let promise = complaint.$save().then(function () {
      $location.path('customer-complaint'); // Clear form fields

      vm.complaint.name = '';
    }, function (errorResponse) {
      FhdMessenger.error(errorResponse.data.message);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tạo complaint...', promise, () => {
      FhdMessenger.success('Đã tạo xong');
    });
  };

  $scope.$watch(() => vm.relatedPlTask, () => {
    if (!vm.relatedPlTask) return;
    vm.complaint.relatedPlTasks = vm.complaint.relatedPlTasks || [];

    if (_.some(vm.complaint.relatedPlTasks, plTask => ObjectId.equals(plTask.plTask, vm.relatedPlTask))) {
      return FhdMessenger.error('Đã có PL Task này trong danh sách');
    }

    vm.complaint.relatedPlTasks.push({
      plTask: ObjectId.getObjectId(vm.relatedPlTask),
      plTaskId: vm.relatedPlTask.plTaskId,
      confirmedStaff: ObjectId.getObjectId(vm.relatedPlTask.confirmedStaff),
      confirmedStaffName: vm.relatedPlTask.confirmedStaff.displayName,
      confirmedStaffCode: vm.relatedPlTask.confirmedStaff.code,
      user: vm.user,
      date: moment().toDate()
    });
  }); // Find a list of Complaints

  vm.complaintsTable = new NgTableParams({
    count: 50
  });

  vm.onSelectOutlet = selectedOutlets => {
    vm.data.outlets = _.map(selectedOutlets, '_id');
  };

  vm.find = function (type) {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    vm.waiting = true;
    vm.complaints = Complaints.query({
      statuses,
      outlets: vm.data.outlets,
      types: [type],
      startDate: vm.startDate,
      endDate: vm.endDate,
      searchQuery: vm.omnisearch || null
    });
    vm.complaints.$promise.then(() => {
      _.forEach(vm.complaints, complaint => {
        complaint.categoryContent = _.map(complaint.categories, category => {
          const matchCategory = _.find(vm.data.categories, {
            id: category
          });

          return _.get(matchCategory, 'title', category);
        }).join(', ');
        complaint.productContent = _.map(complaint.products, product => {
          return `${product.sku} - ${product.description} * ${product.quantity}`;
        }).join('<br>');
      });

      vm.complaintsTable.settings({
        dataset: vm.complaints
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.searchKeyUp = function ($event) {
    if ($event.keyCode === 13) vm.find();
  }; // Type of complaint


  vm.typeMap = {
    internal: true,
    external: true
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      case 'outlet':
        {
          let changeValue = true;
          if (_.every(vm.showOutletMap)) changeValue = false;

          _.forEach(vm.showOutletMap, (value, key) => {
            vm.showOutletMap[key] = vm.enableOutletMap[key] && changeValue;
          });

          break;
        }

      case 'type':
        {
          let changeValue = true;
          if (_.every(vm.typeMap)) changeValue = false;

          _.forEach(vm.typeMap, (value, key) => {
            vm.typeMap[key] = changeValue;
          });

          break;
        }

      default:
    }
  };

  vm.getStatus = () => [{
    title: 'Created',
    id: 'created'
  }, {
    title: 'Processing',
    id: 'processing'
  }, {
    title: 'Done',
    id: 'done'
  }];

  vm.viewComplaint = ComplaintService.openViewComplaintModal;
  vm.createComplaint = ComplaintService.openCreateComplaintModal;
}]);
'use strict'; // Complaints controller

angular.module('complaints').controller('ModalCreateComplaintController', ['source', '$location', 'Authentication', 'Complaints', 'ObjectId', 'ComplaintService', 'OnlineOrders', 'FhdMessenger', '$modalInstance', function (source, $location, Authentication, Complaints, ObjectId, ComplaintService, OnlineOrders, FhdMessenger, $modalInstance) {
  const vm = this;
  vm.user = Authentication.user;
  vm.categories = ComplaintService.getCategories();
  vm.subCategories = ComplaintService.getSubCategories();
  vm.close = $modalInstance.dismiss;

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.content = '';

  vm.init = function () {
    if (source.onlineOrder) {
      vm.onlineOrder = source.onlineOrder;
      vm.outlet = vm.onlineOrder.assignedOutlet;
    } else if (source.storingEntry) {
      vm.storingEntry = source.storingEntry;
      vm.outlet = vm.storingEntry.outlet;
    } else if (source.buyingEntry) {
      vm.buyingEntry = source.buyingEntry;
      vm.outlet = vm.buyingEntry.destination;
    } else if (source.plTask) {
      vm.plTask = source.plTask;
      vm.outlet = vm.plTask.outlet;
    } else if (source.saleEntry) {
      vm.saleEntry = source.saleEntry;
      vm.outlet = vm.saleEntry.outlet;
    } else if (source.stockEntry) {
      vm.stockEntry = source.stockEntry;
      vm.outlet = vm.stockEntry.outlet || vm.stockEntry.destination;
    } else if (source.deliverEntry) {
      vm.deliverEntry = source.deliverEntry;
      vm.outlet = vm.deliverEntry.outlet;
    } else if (source.photoReport) {
      vm.photoReport = source.photoReport;
      vm.outlet = source.photoReport.outlet;
    }

    vm.deadline = moment().add(4, 'day').format('YYYY-MM-DD');
  }; // Create new complaint


  vm.create = function () {
    if (!vm.processStaff) {
      return FhdMessenger.error('Chưa chọn nhân viên xử lý');
    }

    if (vm.onlineOrder) {
      vm.customer = {
        cellphone: vm.onlineOrder.orderCustomer.cellphone,
        name: vm.onlineOrder.orderCustomer.name
      };
    }

    if (_.get(vm, 'saleEntry._id') && !_.get(vm, 'customer.cellphone') && _.get(vm.saleEntry, 'customer.cellphone')) {
      vm.customer = {
        cellphone: _.get(vm.saleEntry, 'customer.cellphone'),
        name: _.get(vm.saleEntry, 'customer.fullName')
      };
    }

    if (_.get(vm, 'saleEntry._id') && !_.get(vm.customer, 'cellphone')) {
      return FhdMessenger.error(`Bạn chưa nhập SĐT khách hàng`);
    }

    if (vm.content.length >= 500000) {
      return FhdMessenger.error(`Bạn đã nhập quá số kí tự là: ${vm.content.length - 500000}`);
    } // Create complaint object


    const complaint = new Complaints({
      complaintCustomer: vm.customer,
      onlineOrder: _.get(vm, 'onlineOrder._id'),
      buyingEntry: _.get(vm, 'buyingEntry._id'),
      relatedPlTasks: vm.plTask ? [{
        plTask: vm.plTask._id,
        plTaskId: vm.plTask.plTaskId,
        confirmedStaff: vm.plTask.confirmedStaff,
        confirmedStaffName: _.get(vm.plTask, 'confirmedStaff.displayName'),
        confirmedStaffCode: _.get(vm.plTask, 'confirmedStaff.code'),
        user: vm.user,
        time: new Date()
      }] : [],
      saleEntry: _.get(vm, 'saleEntry._id'),
      stockEntry: _.get(vm, 'stockEntry._id'),
      storingEntry: _.get(vm, 'storingEntry._id'),
      photoReport: _.get(vm, 'photoReport._id'),
      outlet: vm.outlet,
      processStaff: vm.processStaff,
      deadline: vm.deadline,
      title: vm.title,
      content: vm.content,
      categories: ComplaintService.getSelectedCategories(vm.categories),
      subCategories: ComplaintService.getSelectedSubCategories(vm.subCategories)
    });
    vm.waiting = true; // Redirect after save

    complaint.$save().then(function () {
      $location.path('customer-complaint');
      $modalInstance.close(); // Clear form fields

      vm.name = '';
    }, function (errorResponse) {
      FhdMessenger.errorFromServer('Có lỗi xảy ra');
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict'; // Complaints controller

angular.module('complaints').controller('ModalCreateVoucherController', ['Authentication', 'CustomerService', 'FhdMessenger', 'Vouchers', '$modalInstance', 'complaintId', 'customer', 'isRefund', function (Authentication, CustomerService, FhdMessenger, Vouchers, $modalInstance, complaintId, customer, isRefund) {
  const vm = this;
  vm.user = Authentication.user;
  vm.loading = false;
  vm.searchingResult = [];
  vm.voucher = new Vouchers();
  vm.voucher.voucherType = 'AMOUNT';
  vm.voucher.withoutCard = true;
  vm.voucher.target = 'ANY';

  if (isRefund) {
    vm.voucher.name = 'Voucher hoàn tiền ';
  }

  vm.voucher.expiryDate = moment().add(3, 'month').startOf('day').format('YYYY-MM-DD');

  vm.close = () => $modalInstance.dismiss();

  vm.init = function () {
    CustomerService.searchCustomers(customer.cellphone).then(customers => {
      const customer = customers[0];

      if (customer) {
        vm.voucher.targetCustomers = customers;
        vm.searchText = customer.customerId + ' ' + customer.fullName;
      }
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    });
  }; // Create Voucher


  vm.create = () => {
    if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('marketing')) {
      return FhdMessenger.errorFromServer('Bạn không có quyền tạo Voucher');
    }

    if (!vm.voucher.name) {
      return FhdMessenger.errorFromServer('Vui lòng nhập tên Voucher');
    }

    if (!vm.voucher.quantity) {
      return FhdMessenger.errorFromServer('Vui lòng nhập giá trị của Voucher');
    }

    if (vm.voucher.targetCustomers == null) {
      return FhdMessenger.errorFromServer('Vui lòng chọn khách hàng');
    }

    vm.voucher.complaint = complaintId;
    vm.voucher.isRefund = isRefund;
    vm.loading = true;
    vm.voucher.$save().then(() => {
      FhdMessenger.success('Tạo voucher thành công');
      $modalInstance.close(true);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.loading = false;
    });
  }; // Search for target customer


  vm.searchCustomers = searchText => {
    if (!searchText) {
      return null;
    }

    return CustomerService.searchCustomers(searchText).then(customers => {
      vm.searchingResult = customers;
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      return [];
    });
  }; // Set customer using voucher


  vm.customerSearchSelected = customer => {
    vm.voucher.targetCustomers = customer;
  };
}]);
"use strict";

angular.module('complaints').controller('ModalRemoveComplaintController', ['Complaints', '$modalInstance', 'complaintId', 'Authentication', 'FhdMessenger', '$location', '$state', function (Complaints, $modalInstance, complaintId, Authentication, FhdMessenger, $location, $state) {
  const vm = this;
  vm.user = Authentication.user;
  vm.modal = $modalInstance;

  vm.dismiss = () => $modalInstance.dismiss();

  vm.close = () => $modalInstance.close();

  vm.complaint = Complaints.get({
    complaintId
  });

  vm.remove = () => {
    if (!vm.deleteNote) {
      return FhdMessenger.error('Bạn chưa điền lý do xóa complaint này!');
    }

    vm.complaint.deleteNote = vm.deleteNote;
    vm.complaint.$softRemove().then(() => {
      FhdMessenger.success('Đã xóa');
      $modalInstance.close(true);
      $state.go('customerComplaint');
    }).catch(FhdMessenger.errorFromServer);
  };
}]);
"use strict";

angular.module('complaints').controller('ModalDoneComplaintController', ['Complaints', '$modalInstance', 'complaintId', 'Authentication', 'FhdMessenger', function (Complaints, $modalInstance, complaintId, Authentication, FhdMessenger) {
  const vm = this;
  vm.user = Authentication.user;
  vm.modal = $modalInstance;

  vm.dismiss = () => $modalInstance.dismiss();

  vm.close = () => $modalInstance.close();

  vm.complaint = Complaints.get({
    complaintId
  });

  vm.done = () => {
    if (!vm.complaint.newNote) {
      return FhdMessenger.error('Bạn chưa điền nội dung hoàn thành');
    }

    const complaint = vm.complaint;
    complaint.$done(function () {
      FhdMessenger.success('Đã hoàn thành complaint');
      $modalInstance.close(true);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };
}]);
'use strict'; // Complaints controller

angular.module('complaints').controller('ModalViewComplaintsController', ['$window', 'complaintId', '$location', '$modalInstance', 'Authentication', 'Complaints', 'SticketService', 'PlTaskService', 'ComplaintService', 'FhdMessenger', 'ObjectId', '$scope', function ($window, complaintId, $location, $modalInstance, Authentication, Complaints, SticketService, PlTaskService, ComplaintService, FhdMessenger, ObjectId, $scope) {
  const vm = this;
  vm.close = $modalInstance.dismiss;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.openModalViewPLTask = PlTaskService.openModalViewPLTask;
  vm.newNote = '';

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.data = {}; // Find existing Complaint

  vm.findOne = function () {
    Complaints.get({
      complaintId
    }).$promise.then(complaint => {
      vm.complaint = complaint;
      vm.categories = ComplaintService.getCategories(complaint);
      vm.subCategories = ComplaintService.getSubCategories(complaint);

      if (_.some(vm.data.categories, category => {
        return category.id === 'quality-goods' && category.selected;
      }) && !_.intersection(vm.user.roles, ['office:full-time', 'admin', 'complaints:view-all']).length) {
        vm.cancel();
      }
    });
  };

  vm.addProduct = product => {
    vm.complaint.products = vm.complaint.products || [];

    const index = _.findIndex(vm.complaint.products, {
      sku: product.sku
    });

    if (index < 0) {
      vm.complaint.products.push({
        product: product._id,
        sku: product.sku,
        description: product.description,
        quantity: 1
      });
    }
  };

  vm.inputQuantity = function (product) {
    product.quantity = $window.prompt('Nhập số lượng');
  };

  vm.removeProduct = sku => {
    vm.complaint.products = vm.complaint.products || [];

    _.remove(vm.complaint.products, {
      sku: sku
    });
  };

  vm.changeInputTransferedProduct = ComplaintService.changeInputTransferedProduct;
  vm.changeInputCalledCustomer = ComplaintService.changeInputCalledCustomer;
  vm.changeInputCustomerDone = ComplaintService.changeInputCustomerDone;
  vm.changeInputStaffDone = ComplaintService.changeInputStaffDone;
  vm.changeInputProductDone = ComplaintService.changeInputProductDone; // Done complaint

  vm.done = function () {
    if (vm.complaint.type === 'external') {
      if (!['QC', 'QC_HCM'].includes(vm.user.outlet.code) && !_.includes(vm.user.roles, 'admin')) {
        return FhdMessenger.error('Chỉ có QC mới có thể hoàn thành complaint này');
      }
    }

    if (!_.get(vm.complaint.categories, 'length')) {
      return FhdMessenger.error('Bạn cần phân loại complaint trước khi thực hiện thao tác này');
    }

    if (_.includes(vm.complaint.categories, 'quality-good') && !vm.complaint.products) {
      return FhdMessenger.error('Bạn cần chọn sản phẩm liên quan và ấn Lưu trước khi done complaint');
    }

    vm.complaint.status = 'done';
    vm.complaint.newNote = vm.newNote;
    ComplaintService.openDoneComplaintModal(vm.complaint._id).then(() => {
      $modalInstance.close(true);
    });
  };

  vm.remove = ComplaintService.openRemoveComplaintModal; // Update complaint

  vm.update = function () {
    if (vm.newNote) {
      vm.complaint.status = 'processing';
      vm.complaint.notes = vm.complaint.notes || [];
      vm.complaint.notes.push({
        content: vm.newNote,
        user: vm.user,
        time: new Date()
      });
    }

    vm.complaint.categories = ComplaintService.getSelectedCategories(vm.categories);
    vm.complaint.subCategories = ComplaintService.getSelectedSubCategories(vm.subCategories);
    const complaint = vm.complaint;
    vm.waiting = true;
    complaint.$update().then(() => {
      vm.complaint = Complaints.get({
        complaintId
      });
      FhdMessenger.success('Cập nhật thành công');
    }).catch(errorResponse => {
      vm.error = errorResponse.data.message;
      FhdMessenger.error(vm.error);
    }).finally(() => {
      vm.waiting = false;
      vm.newNote = '';
    });
  };

  $scope.$watch(() => vm.data.relatedPlTask, () => {
    if (!vm.data.relatedPlTask) return;
    vm.complaint.relatedPlTasks = vm.complaint.relatedPlTasks || [];

    if (!_.some(vm.complaint.relatedPlTasks, plTask => _.isEqual(ObjectId.getObjectId(plTask.plTask), ObjectId.getObjectId(vm.data.relatedPlTask)))) {
      vm.complaint.relatedPlTasks.push({
        plTask: ObjectId.getObjectId(vm.data.relatedPlTask),
        plTaskId: vm.data.relatedPlTask.plTaskId,
        confirmedStaff: ObjectId.getObjectId(vm.data.relatedPlTask.confirmedStaff),
        confirmedStaffName: vm.data.relatedPlTask.confirmedStaff.displayName,
        confirmedStaffCode: vm.data.relatedPlTask.confirmedStaff.code,
        user: vm.user,
        date: moment().toDate()
      });
    }
  });

  vm.removeRelatedPlTask = function (index) {
    vm.complaint.relatedPlTasks.splice(index, 1);
  };

  vm.changeStatus = function () {
    if (vm.complaint.status === 'created') vm.complaint.status = 'processing';else if (vm.complaint.status === 'processing') vm.complaint.status = 'done';else if (vm.complaint.status === 'done') vm.complaint.status = 'processing';
  };

  vm.removeStaff = function (index) {
    if (!_.isArray(vm.complaint.staffs)) return;
    vm.complaint.staffs.splice(index, 1);
  };

  vm.staffSearchSelected = function (staff) {
    if (!staff) return;

    const checkDuplicate = _.find(vm.complaint.staffs, {
      _id: staff._id
    });

    if (!checkDuplicate) {
      vm.complaint.staffs.push(_.cloneDeep(staff));
    }
  };

  vm.sendTicket = function (user, complaint) {
    SticketService.openCreateTicket({
      user,
      complaint
    }).then(sticket => {
      vm.complaint.notes = vm.complaint.notes || [];
      vm.complaint.notes.push({
        content: `Đã gửi ticket cho ${user.code} - ${user.displayName}. Nội dung: ${sticket.content}`,
        user: Authentication.user,
        time: new Date()
      });
      complaint = vm.complaint;
      complaint.$update(function () {
        vm.complaint = Complaints.get({
          complaintId
        });
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
      });
    });
  };
}]);
'use strict';

angular.module('complaints').controller('ViewComplaintController', ['$stateParams', '$state', '$location', '$window', 'Authentication', 'Complaints', 'ObjectId', 'ComplaintService', 'FhdMessenger', 'PlTaskService', 'SticketService', 'VoucherService', 'WorkTaskService', '$scope', 'PaymentRequestsService', function ($stateParams, $state, $location, $window, Authentication, Complaints, ObjectId, ComplaintService, FhdMessenger, PlTaskService, SticketService, VoucherService, WorkTaskService, $scope, PaymentRequestsService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.openModalViewPLTask = PlTaskService.openModalViewPLTask;
  vm.data = {};
  vm.newNote = '';
  vm.sendSlackNoti = true;
  $scope.$watch(() => vm.data.relatedPlTask, () => {
    if (!vm.data.relatedPlTask) return;
    vm.complaint.relatedPlTasks = vm.complaint.relatedPlTasks || [];

    if (!_.some(vm.complaint.relatedPlTasks, plTask => _.isEqual(ObjectId.getObjectId(plTask.plTask), ObjectId.getObjectId(vm.data.relatedPlTask)))) {
      vm.complaint.relatedPlTasks.push({
        plTask: ObjectId.getObjectId(vm.data.relatedPlTask),
        plTaskId: vm.data.relatedPlTask.plTaskId,
        confirmedStaff: ObjectId.getObjectId(vm.data.relatedPlTask.confirmedStaff),
        confirmedStaffName: vm.data.relatedPlTask.confirmedStaff.displayName,
        confirmedStaffCode: vm.data.relatedPlTask.confirmedStaff.code,
        user: vm.user,
        date: moment().toDate()
      });
    }
  });

  vm.removeRelatedPlTask = function (index) {
    vm.complaint.relatedPlTasks.splice(index, 1);
  };

  vm.openCreatePaymentRequestModal = complaint => {
    PaymentRequestsService.openModalCreatePaymentRequest({
      buyingEntries: [],
      workTask: null,
      complaint
    });
  }; // Find existing Complaint


  vm.findOne = function () {
    Complaints.get({
      complaintId: $stateParams.complaintId
    }).$promise.then(complaint => {
      vm.complaint = complaint;
      vm.data.categories = ComplaintService.getCategories(complaint);
      vm.data.subCategories = ComplaintService.getSubCategories(complaint);

      if (_.some(vm.data.categories, category => {
        return category.id === 'quality-goods' && category.selected;
      }) && !_.intersection(vm.user.roles, ['office:full-time', 'admin', 'complaints:view-all']).length) {
        $state.go('home');
      }
    });
  };

  vm.changeInputTransferedProduct = ComplaintService.changeInputTransferedProduct;
  vm.changeInputCalledCustomer = ComplaintService.changeInputCalledCustomer;
  vm.changeInputCustomerDone = ComplaintService.changeInputCustomerDone;
  vm.changeInputStaffDone = ComplaintService.changeInputStaffDone;
  vm.changeInputProductDone = ComplaintService.changeInputProductDone;
  vm.openModalViewPaymentRequest = PaymentRequestsService.openModalViewPaymentRequest; // Done complaint

  vm.done = function () {
    if (vm.complaint.type === 'external') {
      if (!['QC', 'QC_HCM'].includes(vm.user.outlet.code) && !_.includes(vm.user.roles, 'admin')) {
        return FhdMessenger.error('Chỉ có QC mới có thể hoàn thành complaint này');
      }
    }

    if (!_.get(vm.complaint.categories, 'length')) {
      return FhdMessenger.error('Bạn cần phân loại complaint trước khi thực hiện thao tác này');
    }

    if (_.includes(vm.complaint.categories, 'quality-good') && !vm.complaint.products) {
      return FhdMessenger.error('Bạn cần chọn sản phẩm liên quan và ấn Lưu trước khi done complaint');
    }

    ComplaintService.openDoneComplaintModal(vm.complaint._id);
  }; // Update Complaint


  vm.update = function () {
    vm.complaint.status = 'processing';

    if (vm.newNote && vm.newNote.length) {
      vm.complaint.notes = vm.complaint.notes || [];
      vm.complaint.notes.push({
        sendSlackNoti: vm.sendSlackNoti,
        content: vm.newNote,
        user: Authentication.user,
        time: new Date()
      });
    }

    vm.complaint.categories = ComplaintService.getSelectedCategories(vm.data.categories);
    vm.complaint.subCategories = ComplaintService.getSelectedSubCategories(vm.data.subCategories);
    const complaint = vm.complaint;
    vm.waiting = true;
    complaint.$update().then(() => {
      FhdMessenger.success('Đã cập nhật xong complaint');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
      vm.newNote = '';
    });
  };

  vm.changeStatus = function () {
    if (vm.complaint.status === 'created') vm.complaint.status = 'processing';else if (vm.complaint.status === 'processing') vm.complaint.status = 'done';else if (vm.complaint.status === 'done') vm.complaint.status = 'created';
  };

  vm.removeStaff = function (index) {
    if (!_.isArray(vm.complaint.staffs)) return;
    vm.complaint.staffs.splice(index, 1);
  };

  vm.inputQuantity = function (product) {
    product.quantity = $window.prompt('Nhập số lượng');
  };

  vm.addProduct = product => {
    vm.complaint.products = vm.complaint.products || [];

    const index = _.findIndex(vm.complaint.products, {
      sku: product.sku
    });

    if (index < 0) {
      vm.complaint.products.push({
        product: product._id,
        sku: product.sku,
        description: product.description,
        quantity: 1
      });
    }
  };

  vm.removeProduct = sku => {
    vm.complaint.products = vm.complaint.products || [];

    _.remove(vm.complaint.products, {
      sku: sku
    });
  };

  vm.staffSearchSelected = function (staff) {
    if (!staff) return;

    const checkDuplicate = _.find(vm.complaint.staff, {
      _id: staff._id
    });

    if (!checkDuplicate) {
      vm.complaint.staff.push(_.cloneDeep(staff));
    }
  };

  vm.openModalCreateQCWorkTask = WorkTaskService.openModalCreateQCWorkTask;

  vm.createVoucher = (complaintId, complaintCustomer, isRefund) => {
    ComplaintService.openCreateVoucherModal(complaintId, complaintCustomer, isRefund).then(() => {
      $state.reload();
    });
  };

  vm.editVoucher = voucher => {
    VoucherService.openEditVoucherModal(voucher._id);
  };

  vm.remove = ComplaintService.openRemoveComplaintModal;

  vm.sendTicket = function (user, complaint) {
    SticketService.openCreateTicket({
      user,
      complaint
    }).then(sticket => {
      vm.complaint.notes = vm.complaint.notes || [];
      vm.complaint.notes.push({
        content: `Đã gửi ticket cho ${user.code} - ${user.displayName}. Nội dung: ${sticket.content}`,
        user: Authentication.user,
        time: new Date()
      });
      complaint = vm.complaint;
      const complaintId = complaint._id;
      complaint.$update(function () {
        vm.complaint = Complaints.get({
          complaintId
        });
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
      });
    });
  };
}]);
'use strict';

angular.module('complaints').factory('ComplaintService', ['$modal', 'Authentication', function ($modal, Authentication) {
  const user = Authentication.user;
  const categories = [{
    id: 'staff-process',
    title: 'Quy trình nhân viên'
  }, {
    id: 'quality-goods',
    title: 'Chất lượng hàng hóa'
  }, {
    id: 'birthday-cake',
    title: 'Bánh sinh nhật'
  }, {
    id: 'other',
    title: 'Khác'
  }];
  const subCategories = ['Sai thời gian', 'Sai phụ kiện', 'Sai chữ viết', 'Sai mẫu bánh', 'Sai hình thức thanh toán', 'Ship muộn', 'Xô lệch', 'Lỗi khác'].map(a => {
    return {
      id: a,
      title: a
    };
  });

  function getCategories(complaint) {
    if (!complaint) return categories;
    return _.map(categories, category => {
      category.selected = _.includes(complaint.categories, category.id);
      return category;
    });
  }

  function getSubCategories(complaint) {
    if (!complaint) return subCategories;
    return _.map(subCategories, subCategory => {
      subCategory.selected = _.includes(complaint.subCategories, subCategory.id);
      return subCategory;
    });
  }

  function getSelectedCategories(categories) {
    return _.map(_.filter(categories, 'selected'), 'id');
  }

  function getSelectedSubCategories(subCategories) {
    return _.map(_.filter(subCategories, 'selected'), 'id');
  }

  function openViewComplaintModal(complaintId) {
    return $modal.open({
      templateUrl: '/modules/complaints/views/modal-view-complaint.client.view.html',
      controller: 'ModalViewComplaintsController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        complaintId: () => complaintId
      }
    });
  }

  function openCreateComplaintModal(source) {
    return $modal.open({
      templateUrl: '/modules/complaints/views/modal-create-complaint.client.view.html',
      controller: 'ModalCreateComplaintController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        source: () => source
      }
    });
  }

  function openCreateVoucherModal(complaintId, customer, isRefund) {
    return $modal.open({
      templateUrl: '/modules/complaints/views/modal-create-voucher.client.view.html',
      controller: 'ModalCreateVoucherController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        complaintId: () => complaintId,
        customer: () => customer,
        isRefund: () => isRefund
      }
    }).result;
  }

  function openRemoveComplaintModal(complaintId) {
    return $modal.open({
      templateUrl: '/modules/complaints/views/modal-delete-complaint.client.view.html',
      controller: 'ModalRemoveComplaintController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        complaintId: () => complaintId
      }
    }).result;
  }

  function openDoneComplaintModal(complaintId) {
    return $modal.open({
      templateUrl: '/modules/complaints/views/modal-done-complaint.client.view.html',
      controller: 'ModalDoneComplaintController',
      controllerAs: 'vm',
      size: 'md',
      resolve: {
        complaintId: () => complaintId
      }
    }).result;
  }

  function changeInputTransferedProduct(complaint) {
    if (complaint.transferedProduct) {
      complaint.notes.push({
        content: 'Đã chuyển sản phẩm cho R&D',
        user,
        time: new Date()
      });
    } else {
      const index = complaint.notes.findIndex(note => note.content === 'Đã chuyển sản phẩm cho R&D');
      complaint.notes.splice(index, 1);
    }
  }

  function changeInputCalledCustomer(complaint) {
    if (complaint.calledCustomer) {
      complaint.notes.push({
        content: 'Đã gọi điện khách hàng',
        user: Authentication.user,
        time: new Date()
      });
    } else {
      const index = complaint.notes.findIndex(note => note.content === 'Đã gọi điện khách hàng');
      complaint.notes.splice(index, 1);
    }
  }

  function changeInputCustomerDone(complaint) {
    if (complaint.doneCustomer) {
      complaint.notes.push({
        content: 'Đã xử lý khách hàng',
        user,
        time: new Date()
      });
    } else {
      const index = complaint.notes.findIndex(note => note.content === 'Đã xử lý khách hàng');
      complaint.notes.splice(index, 1);
    }
  }

  function changeInputStaffDone(complaint) {
    if (complaint.doneStaff) {
      complaint.notes.push({
        content: 'Đã xử lý nhân viên',
        user,
        time: new Date()
      });
    } else {
      const index = complaint.notes.findIndex(note => note.content === 'Đã xử lý nhân viên');
      complaint.notes.splice(index, 1);
    }
  }

  function changeInputProductDone(complaint) {
    if (complaint.doneProduct) {
      complaint.notes.push({
        content: 'Đã xử lý sản phẩm',
        user,
        time: new Date()
      });
    } else {
      const index = complaint.notes.findIndex(note => note.content === 'Đã xử lý sản phẩm');
      complaint.notes.splice(index, 1);
    }
  }

  return {
    openViewComplaintModal,
    openCreateComplaintModal,
    openCreateVoucherModal,
    openRemoveComplaintModal,
    openDoneComplaintModal,
    getCategories,
    getSelectedCategories,
    getSubCategories,
    getSelectedSubCategories,
    changeInputTransferedProduct,
    changeInputCalledCustomer,
    changeInputCustomerDone,
    changeInputStaffDone,
    changeInputProductDone
  };
}]);
'use strict'; // Complaints service used to communicate Complaints REST endpoints

angular.module('complaints').factory('Complaints', ['$resource', function ($resource) {
  return $resource('complaints/:complaintId', {
    complaintId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    done: {
      method: 'PUT',
      url: 'complaints/:complaintId/done'
    },
    softRemove: {
      method: 'PUT',
      url: 'complaints/:complaintId/soft-remove'
    }
  });
}]);
