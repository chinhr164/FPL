    errorStock.$noteReasonProductErrorStock({
      itemIndex: itemIndex,
      note: vm.note
    }).then(errorStock => {
      $modalInstance.close(errorStock);
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = () => {
    $modalInstance.close();
  };
}]);
