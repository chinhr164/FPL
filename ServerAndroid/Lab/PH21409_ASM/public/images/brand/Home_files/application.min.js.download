angular.module('product-sub-cats').controller('ProductSubCatsController', ['$stateParams', '$location', 'Authentication', 'ObjectId', 'ProductSubCats', 'ProductGroups', 'ProductDepartments', 'ProductCats', '$q', '$modal', function ($stateParams, $location, Authentication, ObjectId, ProductSubCats, ProductGroups, ProductDepartments, ProductCats, $q, $modal) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;

  vm.addDepartment = function (group) {
    var addDepartmentModal = $modal.open({
      templateUrl: '/modules/product-departments/views/modal-create-product-department.client.view.html',
      controller: 'ModalCreateProductDepartmentController',
      resolve: {
        group: function () {
          return group;
        }
      }
    });
    addDepartmentModal.result.then(function (department) {
      vm.productDepartments.push(department);
    });
  };

  vm.addCat = function (department) {
    var addCatModal = $modal.open({
      templateUrl: '/modules/product-cats/views/modal-create-product-cat.client.view.html',
      controller: 'ModalCreateProductCatController',
      resolve: {
        department: function () {
          return department;
        }
      }
    });
    addCatModal.result.then(function (cat) {
      vm.productCats.push(cat);
    });
  };

  vm.addSubCat = function (cat) {
    var addSubCatModal = $modal.open({
      templateUrl: '/modules/product-sub-cats/views/modal-create-product-sub-cat.client.view.html',
      controller: 'ModalCreateProductSubCatController',
      resolve: {
        cat: function () {
          return cat;
        }
      }
    });
    addSubCatModal.result.then(function (subCat) {
      vm.productSubCats.push(subCat);
    });
  };

  vm.findAllLevels = function () {
    vm.productGroups = ProductGroups.query();
    ProductDepartments.query().$promise.then(productDepartments => {
      _.forEach(productDepartments, productDepartment => {
        productDepartment.productGroup = ObjectId.getObjectId(productDepartment.productGroup);
      });

      vm.productDepartments = productDepartments;
    });
    ProductCats.query().$promise.then(productCats => {
      _.forEach(productCats, productCat => {
        productCat.productDepartment = ObjectId.getObjectId(productCat.productDepartment);
      });

      vm.productCats = productCats;
    });
    ProductSubCats.query().$promise.then(productSubCats => {
      _.forEach(productSubCats, productCat => {
        productCat.productCat = ObjectId.getObjectId(productCat.productCat);
      });

      vm.productSubCats = productSubCats;
    });
  }; // Create new Product sub cat


  vm.create = function () {
    // Create new Product sub cat object
    var productSubCat = new ProductSubCats({
      name: vm.name
    }); // Redirect after save

    productSubCat.$save(function (response) {
      $location.path('product-sub-cats/' + response._id); // Clear form fields

      vm.name = '';
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Remove existing Product sub cat


  vm.remove = function (productSubCat) {
    if (productSubCat) {
      productSubCat.$remove();

      for (var i in vm.productSubCats) {
        if (vm.productSubCats[i] === productSubCat) {
          vm.productSubCats.splice(i, 1);
        }
      }
    } else {
      vm.productSubCat.$remove(function () {
        $location.path('product-sub-cats');
      });
    }
  }; // Update existing Product sub cat


  vm.update = function () {
    var productSubCat = vm.productSubCat;
    productSubCat.$update(function () {
      $location.path('product-sub-cats/' + productSubCat._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of Product sub cats


  vm.find = function () {
    vm.productSubCats = ProductSubCats.query();
  }; // Find existing Product sub cat


  vm.findOne = function () {
    vm.productSubCat = ProductSubCats.get({
      productSubCatId: $stateParams.productSubCatId
    });
  };
}]);
"use strict";

angular.module('product-sub-categories').factory('ProductSubCatsService', ['ProductSubCats', function (ProductSubCats) {
  let productSubCats;
  return {
    getProductSubCats(callback) {
      if (!productSubCats) {
        productSubCats = ProductSubCats.query();
      }

      productSubCats.$promise.then(productGroups => {
        if (callback) callback(productGroups);
      });
      return productSubCats.$promise;
    }

  };
}]);
