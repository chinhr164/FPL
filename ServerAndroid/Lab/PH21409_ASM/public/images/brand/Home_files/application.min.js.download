angular.module('banking-transactions').controller('BankingTransactionController', ['$scope', '$stateParams', '$state', '$location', 'Authentication', 'BankingTransactions', 'BankingTransactionService', 'FhdMessenger', 'NgTableParams', 'ConfirmModal', function ($scope, $stateParams, $state, $location, Authentication, BankingTransactions, BankingTransactionService, FhdMessenger, NgTableParams, ConfirmModal) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.bankingTransactionTable = new NgTableParams({
    count: 50
  });
  vm.types = BankingTransactionService.getTypes();
  vm.timeTypes = [{
    _id: 'time',
    name: 'Thời gian giao dịch'
  }, {
    _id: 'created',
    name: 'Thời gian tạo'
  }];
  vm.data = {};
  vm.data.timeType = 'time';
  vm.data.startDate = moment().subtract(1, 'day').startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD'); // Create new Business

  vm.create = function () {
    // Create new Business object
    const bankingTransaction = new BankingTransactions(vm.bankingTransaction); // Redirect after save

    bankingTransaction.$save(function (response) {
      $location.path('banking-transactions/' + response._id); // Clear form fields

      vm.name = '';
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.importBankingTransactions = function () {
    _.forEach(vm.bankingTransactions, bankingTransaction => {
      bankingTransaction.time = moment(bankingTransaction.time, 'DD/MM/YYYY HH:mm:ss').format('DD/MM/YYYY HH:mm:ss');

      if (!bankingTransaction.amount) {
        bankingTransaction.amount = (parseInt(_.get(bankingTransaction, 'increase', '').replace(/,/gi, '')) || 0) - (parseInt(_.get(bankingTransaction, 'decrease', '').replace(/,/gi, '')) || 0);
      }
    });

    if (_.some(vm.bankingTransactions, bankingTransaction => {
      return !bankingTransaction.time;
    })) {
      return FhdMessenger.error('Có giao dịch chưa có thời gian');
    }

    if (_.some(vm.bankingTransactions, bankingTransaction => {
      return !bankingTransaction.transferCode;
    })) {
      return FhdMessenger.error('Có giao dịch chưa có mã giao dịch');
    }

    if (_.some(vm.bankingTransactions, bankingTransaction => {
      return !bankingTransaction.amount;
    })) {
      return FhdMessenger.error('Có giao dịch chưa có số tiền');
    }

    if (_.some(vm.bankingTransactions, bankingTransaction => {
      return !bankingTransaction.content;
    })) {
      return FhdMessenger.error('Có giao dịch chưa có nội dung chuyển khoản');
    }

    vm.waiting = true;
    BankingTransactionService.importBankingTransactions(vm.bankingTransactions).then(bankingTransactions => {
      FhdMessenger.notifySticky('Import thành công');
      $state.go('listBankingTransactions');
    }).catch(error => {
      FhdMessenger.error(error.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.exportForm = function () {
    // console.log(true)
    const bankingTransactions = [{
      time: '24/10/2019 13:51:23',
      content: 'CT CP GIAI PHAP TTOAN VN TC.K840021 431. SAL241019K840002 VNPAY TTTH AB BY qua QR ngay 23.10.19',
      transferCode: 'FT19297C00006924\\BNK',
      decrease: '---',
      increase: '16,432,433 ₫',
      type: 'Partner proceeds'
    }, {
      time: '24/10/2019 13:41:23',
      content: '/19127948851165 CONG TY TNHH GRAB . 23.10.19 GF THANH TOAN CHO SAVOR BA NH MI XOI NUOC EP CAFE DOI C',
      transferCode: 'FT19297B00000825\\BNK',
      decrease: '---',
      increase: '1,249,500 ₫',
      type: 'Partner proceeds'
    }, {
      time: '24/10/2019 13:41:23',
      content: '/19127948851165 CONG TY TNHH GRAB . 23.10.19 GF THANH TOAN CHO SAVOR BA NH MI XOI NUOC EP CAFE KHAM',
      transferCode: 'FT19297B00000823\\BNK',
      decrease: '---',
      increase: '1,541,050 ₫',
      type: 'Partner proceeds'
    }, {
      time: '24/10/2019 12:24:23',
      content: 'E7 DT W43 21 22',
      transferCode: 'FT19297902107064\\TMO',
      decrease: '---',
      increase: '13,699,760 ₫',
      type: 'Revenue transfer'
    }, {
      time: '24/10/2019 12:27:23',
      content: 'Quỹ chuyển tiền cho kế toán',
      transferCode: 'FT19297902107045\\TMO',
      decrease: '20,699,760 ₫',
      type: 'Internal transfer'
    }, {
      time: '24/10/2019 12:27:23',
      content: 'Đền bù hàng hỏng E1',
      transferCode: 'FT19297002107045\\TMO',
      increase: '20,699,760 ₫',
      type: 'Internal proceeds'
    }];
    alasql(`SELECT * INTO XLSX("form-import-banking-transactions.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [bankingTransactions]);
  }; // Remove existing Business


  vm.disabled = function (bankingTransaction, index) {
    ConfirmModal.showModal({}, {
      bodyText: 'Bạn có chắc chắn không?'
    }).then(() => {
      bankingTransaction.$disabled().then(() => {
        FhdMessenger.success('OK');
      });
    });
  };

  vm.updateBankingTransactionType = bankingTransaction => {
    bankingTransaction.$updateType().then(() => {
      FhdMessenger.success('Đã cập nhật');
    });
  }; // Update existing Business


  vm.update = function () {
    var bankingTransaction = vm.bankingTransaction;
    bankingTransaction.$update(function () {
      FhdMessenger.success('Đã cập nhật');
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of BankingTransactions


  vm.find = function () {
    vm.bankingTransactions = BankingTransactions.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      timeType: vm.data.timeType
    }, function () {
      FhdMessenger.success('Tải xong');
      vm.bankingTransactionTable.settings({
        dataset: vm.bankingTransactions
      });
    });
  }; // Find existing Business


  vm.findOne = function () {
    vm.bankingTransaction = BankingTransactions.get({
      bankingTransactionId: $stateParams.bankingTransactionId
    });
  };
}]);
'use strict';

angular.module('banking-transactions').filter('bankingTransactionType', [function () {
  return function (status) {
    switch (status) {
      case 'Internal transfer':
        return 'Chuyển tiền nội bộ';

      case 'Revenue transfer':
        return 'Chuyển tiền doanh thu';

      case 'Partner proceeds':
        return 'Tiền thu đối tác';

      case 'Internal proceeds':
        return 'Tiền thu nội bộ';

      default:
        return status;
    }
  };
}]);
'use strict';

angular.module('banking-transactions').factory('BankingTransactionService', ['$http', 'BankingTransactions', function ($http, BankingTransactions) {
  const types = [{
    id: 'Internal transfer',
    title: 'Chuyển tiền nội bộ'
  }, {
    id: 'Revenue transfer',
    title: 'Chuyển tiền doanh thu'
  }, {
    id: 'Partner proceeds',
    title: 'Tiền thu đối tác'
  }, {
    id: 'Internal proceeds',
    title: 'Tiền thu nội bô'
  }];

  function importBankingTransactions(bankingTransactions) {
    return $http.post('/banking-transactions/import', bankingTransactions).then(response => response.data);
  }

  return {
    getTypes() {
      return types;
    },

    importBankingTransactions
  };
}]);
'use strict';

