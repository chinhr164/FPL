angular.module('stock-entries').controller('LostStockEntryController', ['Authentication', 'ConfirmModal', 'StockEntries', 'NgTableParams', 'ExplainsService', 'FhdMessenger', '$window', '$http', 'StockEntryService', 'ProductService', function (Authentication, ConfirmModal, StockEntries, NgTableParams, ExplainsService, FhdMessenger, $window, $http, StockEntryService, ProductService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {
    statuses: ['delivered', 'received', 'lost', 'deleted']
  };
  vm.lostedReasons = _.sortBy(['Đã chuyển', 'Chưa chuyển', 'Đã nhận', 'Đã xóa', 'Đền bù', 'Đã xóa', 'Cấn trừ', 'Khác']);

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }
    }
  };

  vm.getLabelFromStatus = status => {
    const labelStatusMap = {
      deleted: 'label-default',
      delivered: 'label-info',
      lost: 'label-danger',
      received: 'label-success'
    };
    return _.get(labelStatusMap, status, 'label-default');
  };

  if (_.intersection(vm.user.roles, ['admin', 'stock-entry:can-done-lost']).length) {
    vm.canDoneLostStockEntry = true;
  }

  if (_.intersection(vm.user.roles, ['admin', 'tro-ly', 'tro-ly-kho', 'tro-ly-sx']).length) {
    vm.canExplain = true;
  }

  vm.getCurrentStatuses = StockEntryService.getAllStatuses;
  vm.listLostStockEntriesTable = new NgTableParams();

  vm.init = () => {
    vm.statusMap = {
      delivered: false,
      received: false,
      deleted: false
    };
    vm.startDate = moment().subtract(2, 'month').format('YYYY-MM-DD');
    vm.endDate = moment().format('YYYY-MM-DD');
  };

  vm.summaryLostLogisticsEntriesByOutlet = new NgTableParams({
    count: 50
  });

  function summaryLostLogisticsEntriesByOutlet(stockEntries) {
    let lostLogisticsEntriesByOutlet = _.groupBy(_.filter(stockEntries, {
      currentStatus: 'lost',
      lostedReason: 'Đền bù'
    }), stockEntry => {
      if (stockEntry.responsibleOutlet) {
        return _.get(stockEntry.responsibleOutlet, 'code', '');
      }

      return _.get(stockEntry.outlet, 'code', '');
    });

    lostLogisticsEntriesByOutlet = _.reduce(lostLogisticsEntriesByOutlet, (result, stockEntries, outletCode) => {
      result[outletCode] = {
        outletCode,
        totalCompensationValue: _.sumBy(stockEntries, 'compensationValue')
      };
      return result;
    }, {});
    lostLogisticsEntriesByOutlet['Tổng'] = {
      outletCode: 'Tổng',
      totalCompensationValue: _.sumBy(_.values(lostLogisticsEntriesByOutlet), 'totalCompensationValue')
    };
    vm.summaryLostLogisticsEntriesByOutlet.settings({
      dataset: _.values(lostLogisticsEntriesByOutlet)
    });
    vm.summaryLostLogisticsEntriesByOutlet.sorting({
      outletCode: 'asc'
    });
  }

  vm.summaryLostLogisticsEntries = new NgTableParams({
    count: 50
  });

  function summaryLostLogisticsEntries(stockEntries) {
    let lostLogisticsEntriesGroupByOutlet = _.reduce(_.groupBy(stockEntries, 'outlet.code'), (result, stockEntries, outletCode) => {
      const deletedStockEntries = _.filter(stockEntries, stockEntry => {
        return stockEntry.currentStatus === 'deleted';
      });

      const receivedStockEntries = _.filter(stockEntries, stockEntry => {
        return stockEntry.currentStatus === 'received';
      });

      const compensatedStockEntries = _.filter(stockEntries, stockEntry => {
        return stockEntry.currentStatus === 'lost';
      });

      const notGroupStockEntries = _.filter(stockEntries, stockEntry => {
        return stockEntry.currentStatus === 'lost' && !stockEntry.lostedReason;
      });

      const missingDeliverEntry = _.filter(stockEntries, stockEntry => {
        if (stockEntry.deliverEntry) {
          return false;
        }

        if (_.get(stockEntry, 'destination.code', '').match(/([BS]\d+|SS)/)) {
          return false;
        }

        if (_.get(stockEntry, 'outlet.code', '').match(/([BS]\d+|SS)/)) {
          return false;
        }

        if (_.get(stockEntry, 'destination.code', '').match(/(G\d+|VENDOR|TRAINING|OFFFICE)/)) {
          return false;
        }

        return true;
      });

      result[outletCode] = {
        outletCode,
        totalLostLogisticsEntries: _.size(stockEntries),
        totalValueLostLogisticsEntries: _.sumBy(stockEntries, 'compensationValue'),
        totalConfirmed: _.size(_.filter(stockEntries, stockEntry => {
          return stockEntry.currentStatus === 'received';
        })),
        totalDeleted: _.size(deletedStockEntries),
        totalValueDeleted: _.sumBy(deletedStockEntries, 'compensationValue'),
        totalReceived: _.size(receivedStockEntries),
        totalValueReceived: _.sumBy(receivedStockEntries, 'compensationValue'),
        totalCompensated: _.size(compensatedStockEntries),
        totalValueCompensated: _.sumBy(compensatedStockEntries, 'compensationValue'),
        totalNotGroup: _.size(notGroupStockEntries),
        totalValueNotGroup: _.sumBy(notGroupStockEntries, 'compensationValue'),
        totalMissingDeliverEntry: _.size(missingDeliverEntry),
        totalValueMissingDeliverEntry: _.size(missingDeliverEntry, 'compensationValue')
      };
      return result;
    }, {});

    const lostLogisticsEntries = _.values(lostLogisticsEntriesGroupByOutlet);

    lostLogisticsEntriesGroupByOutlet['Tổng'] = {
      outletCode: 'Tổng',
      totalLostLogisticsEntries: _.sumBy(lostLogisticsEntries, 'totalLostLogisticsEntries'),
      totalValueLostLogisticsEntries: _.sumBy(lostLogisticsEntries, 'totalValueLostLogisticsEntries'),
      totalConfirmed: _.sumBy(lostLogisticsEntries, 'totalConfirmed'),
      totalDeleted: _.sumBy(lostLogisticsEntries, 'totalDeleted'),
      totalValueDeleted: _.sumBy(lostLogisticsEntries, 'totalValueDeleted'),
      totalReceived: _.sumBy(lostLogisticsEntries, 'totalReceived'),
      totalValueReceived: _.sumBy(lostLogisticsEntries, 'totalValueReceived'),
      totalCompensated: _.sumBy(lostLogisticsEntries, 'totalCompensated'),
      totalValueCompensated: _.sumBy(lostLogisticsEntries, 'totalValueCompensated'),
      totalNotGroup: _.sumBy(lostLogisticsEntries, 'totalNotGroup'),
      totalValueNotGroup: _.sumBy(lostLogisticsEntries, 'totalValueNotGroup'),
      totalMissingDeliverEntry: _.sumBy(lostLogisticsEntries, 'totalMissingDeliverEntry'),
      totalValueMissingDeliverEntry: _.sumBy(lostLogisticsEntries, 'totalValueMissingDeliverEntry')
    };
    vm.summaryLostLogisticsEntries.settings({
      dataset: _.values(lostLogisticsEntriesGroupByOutlet)
    });
    vm.summaryLostLogisticsEntries.sorting({
      outletCode: 'asc'
    });
  }

  vm.find = () => {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    vm.waiting = true;
    StockEntries.getLosted({
      startDate: vm.startDate,
      endDate: vm.endDate,
      statuses,
      destination: _.get(vm, 'destination._id'),
      outlet: _.get(vm, 'outlet._id'),
      responsibleOutlet: _.get(vm, 'responsibleOutlet._id')
    }).$promise.then(stockEntries => {
      vm.stockEntries = stockEntries;

      _.forEach(vm.stockEntries, stockEntry => {
        stockEntry.compensationValue = vm.getCompensationValue(stockEntry);
      });

      vm.listLostStockEntriesTable.settings({
        dataset: stockEntries
      });
      summaryLostLogisticsEntriesByOutlet(vm.stockEntries);
      summaryLostLogisticsEntries(vm.stockEntries);
      FhdMessenger.success('Đã xong!');
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.getCompensationValue = function (stockEntry) {
    return _.reduce(stockEntry.items, (result, item) => {
      if (item.quantity <= 0) {
        return result;
      }

      const price = _.get(item.product, 'price') > 0 ? _.get(item.product, 'price') : _.get(item.product, 'cogs', 0);

      if (!item.sku.match(/^B\d+/)) {
        result += price * item.quantity;
        return result;
      }

      let percent = 0.6;

      if (ProductService.isFrozenProduct(item.product.warehouseGroup)) {
        percent = 0.9;
      } else if (ProductService.isFoodProduct(item.product)) {
        percent = 0.8;
      }

      result += price * item.quantity * percent;
      return result;
    }, 0);
  };

  vm.removeComment = (stockEntry, index) => {
    stockEntry.removedCommentIndex = index;
    stockEntry.$removeComment().then(_stockEntry => {
      stockEntry = _stockEntry;
      FhdMessenger.success('Xóa check giải trình thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.removeExplain = (stockEntry, index) => {
    stockEntry.removedExplainIndex = index;
    stockEntry.$removeExplain().then(_stockEntry => {
      stockEntry = _stockEntry;
      FhdMessenger.success('Xóa giải trình thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.openAddExplainModal = stockEntry => {
    StockEntryService.openAddExplainModal(stockEntry).then(_stockEntry => {
      stockEntry = _stockEntry;
    });
  };

  vm.openAddCommentModal = function (stockEntry) {
    StockEntryService.openAddCommentModal(stockEntry).then(_stockEntry => {
      stockEntry = _stockEntry;
    });
  };

  vm.updateLostedReason = stockEntry => {
    vm.waiting = true;
    stockEntry.$updateLostedReason().then(() => {
      return FhdMessenger.success('Cập nhật phân nhóm thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.changeResponsibleOutlet = (stockEntry, index) => {
    StockEntryService.openModalSelectResponsibleOutlet(stockEntry).then(responsibleOutlet => {
      stockEntry.responsibleOutlet = responsibleOutlet;
      stockEntry.$changeResponsibleOutlet().then(stockEntry => {
        FhdMessenger.success('Sửa cơ sở chịu trách nhiệm thành công');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
    });
  };

  vm.changeCompensationOutlet = (stockEntry, index) => {
    StockEntryService.openModalSelectResponsibleOutlet(stockEntry).then(responsibleOutlet => {
      stockEntry.compensationOutlet = responsibleOutlet;
      stockEntry.$changeCompensationOutlet().then(stockEntry => {
        FhdMessenger.success('Sửa cơ sở chịu trách nhiệm thành công');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
    });
  };

  vm.doneLostStockEntry = (stockEntry, index) => {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Hoàn thành xử lý LE ${stockEntry.stockEntryId}`
    }).then(() => {
      stockEntry.$doneLostStockEntry().then(stockEntry => {
        vm.stockEntries.splice(index, 1);
        FhdMessenger.success('Hoàn thành xử lý Stock Entry chưa về cơ sở');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
    });
  };
}]);
"use strict";

angular.module('stock-entries').controller('ListReturnStockEntriesController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'StockEntries', 'StockEntryService', function (Authentication, FhdMessenger, NgTableParams, StockEntries, StockEntryService) {
  const vm = this;
  vm.data = {};
  vm.data.startDate = moment().subtract(2, 'day').startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.data.processStatus = [{
    title: 'New',
    value: 'new'
  }, {
    title: 'Process',
    value: 'process'
  }, {
    title: 'Confirm',
    value: 'confirm'
  }, {
    title: 'Done',
    value: 'done'
  }];
  vm.openViewModalStockEntry = StockEntryService.openViewModalStockEntry;
  vm.user = Authentication.user;
  vm.data.stockEntriesTable = [];

  _.forEach(vm.data.processStatus, status => {
    vm.data.stockEntriesTable[status.value] = new NgTableParams({
      count: 50
    });
  });

  vm.statusMap = {
    delivered: true,
    received: true
  };

  vm.openDoneReturnStockEntry = function (stockEntry) {
    StockEntryService.openDoneReturnStockEntry(stockEntry).result.then(result => {
      stockEntry = result;
      vm.fetchTable();
    });
  };

  vm.find = () => {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    vm.stockEntries = StockEntries.query({
      statuses,
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      types: ['return']
    }, function (stockEntries) {
      vm.stockEntries = stockEntries;
      vm.fetchTable();
    });
    FhdMessenger.notifyLoading('Đang tải Logistics Entries...', vm.stockEntries.$promise, () => {
      FhdMessenger.success('Đã tải xong!');
    });
  };

  vm.fetchTable = () => {
    _.forEach(vm.data.processStatus, status => {
      const filterStockEntries = _.filter(vm.stockEntries, {
        processStatus: status.value
      });

      vm.data.stockEntriesTable[status.value].settings({
        dataset: filterStockEntries
      });
      vm.data.stockEntriesTable[status.value].sorting({
        delivered: 'desc'
      });
    });
  };

  vm.selectAllStatus = function () {
    let changeValue = true;
    if (_.every(vm.statusMap)) changeValue = false;

    _.forEach(vm.statusMap, (value, key) => {
      vm.statusMap[key] = changeValue;
    });
  };

  vm.updateFeedback = function (stockEntry, newStatus) {
    const modal = StockEntryService.openUpdateFeedback(stockEntry, newStatus);
    modal.result.then().then(() => {
      FhdMessenger.info('Cập nhật thành công');
      vm.fetchTable();
    });
  };

  vm.confirmReceived = function (stockEntry) {
    vm.updateFeedback(stockEntry, 'received');
  };
}]);
"use strict";

angular.module('stock-entries').controller('ModalAddBillNumberForStockEntryController', ['stockEntry', 'StockEntries', '$modalInstance', 'FhdMessenger', function (stockEntry, StockEntries, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.stockEntry = StockEntries.get({
