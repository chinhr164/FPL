angular.module('reports').controller('OutletSaleController', ['ProductService', 'ProductCats', '$http', 'FhdMessenger', 'BusinessService', 'NgTableParams', '$scope', 'StyleService', 'OutletService', 'ProductWeight', 'ProductCatService', 'ObjectId', '$timeout', '$window', '$stateParams', 'Authentication', 'TetCategoriesService', 'SavorTagService', '$filter', 'OutletStockService', function (ProductService, ProductCats, $http, FhdMessenger, BusinessService, NgTableParams, $scope, StyleService, OutletService, ProductWeight, ProductCatService, ObjectId, $timeout, $window, $stateParams, Authentication, TetCategoriesService, SavorTagService, $filter, OutletStockService) {
  const vm = this;
  const user = Authentication.user;
  vm.metrics = [{
    id: 'sale',
    title: 'Sale'
  }, {
    id: 'quantity',
    title: 'Quantity'
  }, {
    id: 'weight',
    title: 'Weight'
  }, {
    id: 'cogs',
    title: 'Cogs'
  }, {
    id: 'profit',
    title: 'Profit'
  }, {
    id: 'noOrder',
    title: 'No Order'
  }, {
    id: 'noCustomer',
    title: 'No Customer'
  }];
  vm.data = {
    metric: 'sale',
    cols: [],
    inputDescriptionFilter: ''
  };
  vm.specialFilter = {
    description: {
      using: false,
      data: []
    },
    catman: {
      using: false,
      data: []
    }
  };

  function intersectionBySku(arr1, arr2) {
    const skuArr1 = _.map(arr1, 'product.sku');

    const skuArr2 = _.map(arr2, 'product.sku');

    const skuIntersection = _.intersection(skuArr1, skuArr2);

    return _.filter(vm.data.allProducts, _product => {
      return _.includes(skuIntersection, _product.product.sku);
    });
  }

  function mergeFilter(defaultData, withDefaultFilter) {
    const isUsingCatman = vm.specialFilter.catman.using;
    const isUsingDescription = vm.specialFilter.description.using;

    if (withDefaultFilter) {
      if (isUsingCatman) {
        return intersectionBySku(defaultData, vm.specialFilter.catman.data);
      }

      if (isUsingDescription) {
        return intersectionBySku(defaultData, vm.specialFilter.description.data);
      }
    }

    if (!isUsingDescription || !isUsingCatman) {
      return defaultData;
    }

    return intersectionBySku(vm.specialFilter.description.data, vm.specialFilter.catman.data);
  }

  $scope.$watch(() => vm.data.inputDescriptionFilter, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const originalText = vm.data.inputDescriptionFilter;

    const hasSpecialFilter = _.includes(originalText, '*');

    if (hasSpecialFilter) {
      const splited = originalText.replace(/\s/g, '').split('*');

      const regexString = _.reduce(splited, (result, word) => {
        result += `(.*?)${word}`;
        return result;
      }, '');

      let matchDescription = _.filter(vm.data.allProducts, _product => {
        return _.get(_product, 'product.description', '').replace(/\s/g, '').match(new RegExp(regexString, 'gi'));
      });

      vm.specialFilter.description.data = matchDescription;
      vm.specialFilter.description.using = true;
      vm.productsTable.filter()['product.description'] = '';
      const mergeData = mergeFilter(matchDescription);
      feedDataToTable(mergeData);
    } else {
      vm.specialFilter.description.using = false;
      const mergeData = mergeFilter(vm.data.allProducts, true);
      feedDataToTable(mergeData);
      vm.productsTable.filter()['product.description'] = originalText;
    }
  });
  $scope.$watch(() => vm.data.categoryName, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    if (!newValue) {
      vm.specialFilter.catman.using = false;
      const mergeData = mergeFilter(vm.data.allProducts, true);
      feedDataToTable(mergeData);
    } else {
      const matchCategory = _.filter(vm.data.allProducts, _product => {
        const catName = _.get(_product, 'product.tetCategory.name', '');

        return catName.match(new RegExp(`^(${newValue})$`)) || catName === newValue;
      });

      vm.specialFilter.catman.data = matchCategory;
      vm.specialFilter.catman.using = true;
      const mergeData = mergeFilter(matchCategory);
      return feedDataToTable(mergeData);
    }
  });

  vm.hasPermission = outletCode => {
    if (_.intersection(user.roles, ['admin', 'admin-merchandise', 'accountant', 'purchaser', 'probation-purchaser', 'outlet-sale:view']).length) {
      return true;
    }

    const userOutletCodes = _.uniq(_.compact([].concat(_.get(user.outlet, 'code')).concat(_.map(user.managingOutlets, 'code'))));

    return userOutletCodes.includes(outletCode);
  };

  vm.getTotalField = idMetric => {
    return _.camelCase(`total ${idMetric}`);
  };

  vm.outletRegionMap = OutletStockService.outletRegionMap;

  function getTotalByRegion(object, region) {
    const matchOutlets = _.filter(object.outletMap, (value, outletCode) => {
      return _.get(vm.outletRegionMap, outletCode, '') === region;
    });

    return _.reduce(vm.metrics, (result, metric) => {
      const field = vm.getTotalField(metric.id);

      const allValue = _.map(matchOutlets, metric.id);

      result[field] = _.sum(allValue);
      return result;
    }, {});
  }

  function indexCol($scope, row, rowIndex) {
    return `<span>${rowIndex + 1}</span>`;
  }

  function getSkuCell($scope, row) {
    return `<a ng-click="vm.quickEditProduct(row.product)" target="_blank">${row.product.sku}</a>`;
  }

  function getDescriptionCell($scope, row) {
    return ` <a ng-click="vm.quickEditProductAttributes(row.product)"
          >${row.product.description}</a>`;
  }

  function getProfit($scope, row) {
    const profit = row.product.grossProfitPercentage * 100;
    return `<span>${$filter('number')(profit, 0)} %</span>`;
  }

  function getValueByMetric($scope, row) {
    // eslint-disable-next-line angular/controller-as-vm
    const outletCode = this.field;

    const metricMap = _.get(row.outletMap, outletCode, {});

    const metric = _.get(metricMap, vm.data.metric, 0);

    return `<span>${$filter('number')(metric, 0)}</span>`;
  }

  function getPrice($scope, row) {
    const price = row.product.price;
    return `<span>${$filter('number')(price, 0)}
              <span
              ng-click="row.showSoldPrices = !row.showSoldPrices"
              class="glyphicon glyphicon-collapse-down"
            ></span>
      </span>`;
  }

  function getFinalMetric($scope, row) {
    const vm = this; // eslint-disable-next-line angular/controller-as-vm

    let metric = _.get(row, this.field, 0);

    if (_.isFunction(vm.field)) {
      metric = _.get(row, vm.field(), 0);
    }

    return `<span>${$filter('number')(metric, 0)}</span>`;
  }

  function numberValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field, '');

    return `<span>${$filter('number')(value, 0)}</span>`;
  }

  function normalValue($scope, row) {
    const vm = this;

    let value = _.get(row, vm.field);

    if (!value) {
      value = 'Khác';
    }

    return `<span>${value}</span>`;
  }

  vm.matchFilterByRegion = outletCode => {
    const region = _.get(vm.outletRegionMap, outletCode);

    return _.get(vm.data.showOutlet, region);
  };

  vm.matchFilterDepot = outletCode => {
    return /^D\d+/.test(outletCode) && _.get(vm.data, 'showOutlet.DEPOT');
  };

  const defineOutletSaleTableCols = async () => {
    const ABBY_OUTLET_CODES = OutletStockService.abbyOutletCodes;
    const SAVOR_OUTLET_CODES = OutletStockService.savorOutletCodes;
    const DEPOT_OUTLET_CODES = OutletStockService.depotOutletCodes;
    let outlets = await OutletService.all();
    const outletStyle = await StyleService.getOutletStyle();
    const outletCodes = [...ABBY_OUTLET_CODES, ...SAVOR_OUTLET_CODES, ...DEPOT_OUTLET_CODES];
    vm.data.showOutlet = {
      NORTH: true,
      CENTRAL: true,
      SOUTH: true,
      DEPOT: true
    };

    function getSize(field) {
      switch (field) {
        case 'stt':
          return 10;

        case 'product.sku':
          return 100;

        case 'product.description':
          return 200;

        default:
          return 50;
      }
    }

    function getStyle(row) {
      const vm = this;
      const outlet = vm.field;
      const isPrimary = ['stt', 'product.sku', 'product.description'].includes(vm.field);

      if (isPrimary) {
        if (row.justEdited) {
          return {
            'background-color': '#ff0',
            'min-width': getSize(vm.field)
          };
        } else {
          return {
            'min-width': getSize(vm.field)
          };
        }
      }

      const color = outletStyle(outlet);
      return color;
    }

    vm.data.colspan = (vm.data.business === 'ABBY' ? ABBY_OUTLET_CODES.length : SAVOR_OUTLET_CODES.length - 1) + 2;
    vm.data.cols = [{
      field: 'stt',
      title: 'STT',
      show: true,
      getValue: indexCol,
      getStyle: getStyle
    }, {
      field: 'product.sku',
      title: 'SKU',
      sortable: 'product.sku',
      filter: {
        'product.sku': '/modules/stocks/template/input-sku-filter.client.template.html'
      },
      show: true,
      getValue: getSkuCell,
      getStyle: getStyle
    }, {
      field: 'product.description',
      title: 'Description',
      sortable: 'product.description',
      filter: {
        'product.description': '/modules/reports/templates/input-description-filter.client.template.html'
      },
      show: true,
      getValue: getDescriptionCell,
      getStyle: getStyle
    }, {
      field: 'product.price',
      title: 'Price',
      sortable: 'product.price',
      getValue: getPrice
    }, {
      field: 'product.cogs',
      title: 'Cogs',
      sortable: 'product.cogs',
      getValue: numberValue
    }, {
      field: 'product.grossProfitPercentage',
      title: '%Profit',
      sortable: 'product.grossProfitPercentage',
      getValue: getProfit
    }, {
      field: 'product.tag',
      title: 'Tag',
      sortable: 'product.tag',
      filter: {
        'product.tag': 'select'
      },
      filterData: ProductService.getAllProductsTagsFromServer,
      show: () => {
        return vm.data.business === 'ABBY';
      },
      getValue: normalValue
    }, {
      field: 'product.category.cat.name',
      title: 'Savor Cat',
      sortable: 'product.category.cat.name',
      filter: {
        'product.category.cat.name': 'select'
      },
      filterData: ProductCatService.getSavorCats,
      show: () => {
        return vm.data.business === 'SAVOR';
      },
      getValue: normalValue
    }, {
      field: 'product.tetCategory.name',
      title: 'Cat Man',
      sortable: 'product.tetCategory.name',
      filter: {
        'product.tetCategory.name': '/modules/reports/templates/select-categories-filter.client.template.html'
      },
      filterData: TetCategoriesService.getTags,
      show: () => {
        return vm.data.business === 'ABBY' || vm.data.business === 'All';
      },
      getValue: normalValue
    }, {
      field: 'warehouseRestock',
      title: 'Warehouse',
      sortable: 'warehouseRestock',
      filter: {
        warehouseRestock: 'select'
      },
      filterData: [{
        id: 'D1',
        title: 'D1'
      }, {
        id: 'D2',
        title: 'D2'
      }, {
        id: 'D3',
        title: 'D3'
      }, {
        id: 'D4',
        title: 'D4'
      }, {
        id: 'D5',
        title: 'D5'
      }, {
        id: 'D7',
        title: 'D7'
      }, {
        id: 'D10',
        title: 'D10'
      }, {
        id: 'B1',
        title: 'B1'
      }, {
        id: 'B2',
        title: 'B2'
      }, {
        id: 'B3',
        title: 'B3'
      }, {
        id: 'Direct',
        title: 'Direct'
      }, {
        id: '',
        title: 'Tất cả'
      }],
      show: () => {
        return vm.data.business === 'ABBY' || vm.data.business === 'All';
      },
      getValue: normalValue
    }, {
      field: 'product.savorTag',
      title: 'Savor Tag',
      sortable: 'product.savorTag',
      filter: {
        'product.savorTag': 'select'
      },
      filterData: SavorTagService.getSavorTags,
      show: () => {
        return vm.data.business === 'SAVOR' || vm.data.business === 'All';
      },
      getValue: normalValue
    }];

    _.forEach(ABBY_OUTLET_CODES, outlet => {
      const outletCol = {
        field: outlet,
        title: outlet,
        sortable: () => `outletMap.${outlet}.${vm.data.metric}`,
        show: () => {
          return (vm.data.business === 'ABBY' || vm.data.business === 'All') && vm.hasPermission(outlet) && vm.matchFilterByRegion(outlet);
        },
        getValue: getValueByMetric,
        getStyle: getStyle
      };
      vm.data.cols.push(outletCol);
    });

    _.forEach(SAVOR_OUTLET_CODES, outlet => {
      const outletCol = {
        field: outlet,
        title: outlet,
        sortable: () => `outletMap.${outlet}.${vm.data.metric}`,
        show: () => {
          return (vm.data.business === 'SAVOR' || vm.data.business === 'All') && vm.hasPermission(outlet) && vm.matchFilterByRegion(outlet);
        },
        getValue: getValueByMetric,
        getStyle: getStyle
      };
      vm.data.cols.push(outletCol);
    });

    _.forEach(DEPOT_OUTLET_CODES, outlet => {
      const outletCol = {
        field: outlet,
        title: outlet,
        sortable: () => `outletMap.${outlet}.${vm.data.metric}`,
        show: () => {
          return (vm.data.business === 'ABBY' || vm.data.business === 'All') && vm.hasPermission(outlet) && vm.matchFilterDepot(outlet);
        },
        getValue: getValueByMetric,
        getStyle: getStyle
      };
      vm.data.cols.push(outletCol);
    });

    vm.data.cols.push({
      field: () => `northTotal.${vm.getTotalField(vm.data.metric)}`,
      title: 'North Total',
      sortable: () => `northTotal.${vm.getTotalField(vm.data.metric)}`,
      show: true,
      getValue: getFinalMetric
    }, {
      field: () => `southTotal.${vm.getTotalField(vm.data.metric)}`,
      title: 'South Total',
      sortable: () => `southTotal.${vm.getTotalField(vm.data.metric)}`,
      show: true,
      getValue: getFinalMetric
    }, {
      field: () => vm.data.metric,
      title: () => vm.data.metric,
      sortable: () => vm.data.metric,
      show: true,
      getValue: getFinalMetric
    });

    const outletMap = _.reduce(outlets, (result, outlet) => {
      result[outlet.code] = outlet;
      return result;
    }, {});

    vm.footerOutlets = _.uniqBy(_.map(outletCodes, outletCode => {
      const matchOutlet = outletMap[outletCode];

      let business = _.get(matchOutlet, 'business.code', 'ABBY');

      if (['E18'].includes(outletCode) && vm.data.business === 'SAVOR') {
        business = 'SAVOR';
      }

      return {
        outletCode,
        business
      };
    }), 'outletCode');
    $scope.$apply();
  };

  defineOutletSaleTableCols();
  vm.productsTable = new NgTableParams({});

  vm.init = () => {
    vm.data = {
      allProducts: [],
      productTSV: 'Nhấn vào nút Copy bảng để lấy dữ liệu...'
    };
    vm.data.cat = 'tet';
    vm.showMenuItemOnly = false;
    $scope.$watch(() => vm.showMenuItemOnly, (newValue, oldValue) => {
      if (newValue !== oldValue) {
        feedDataToTable(vm.data.allProducts);
      }
    });
    vm.data.metric = 'sale';
    vm.data.business = $stateParams.businessCode || 'ABBY';
    vm.startDate = moment().startOf('day').subtract(14, 'day').format('YYYY-MM-DD');
    vm.endDate = moment().startOf('day').subtract(1, 'day').format('YYYY-MM-DD');
    vm.find();
  };

  function setHighlightForSkuEdited(product) {
    const item = _.find(vm.productsTable.data, _product => {
      return _product.product.sku === product.sku;
    });

    item.justEdited = true;
    item.renderAnimation = true;
  }

  vm.quickEditProduct = product => {
    ProductService.quickEditProduct(product).then(_product => {
      return setHighlightForSkuEdited(_product);
    });
  };

  vm.quickEditProductAttributes = product => {
    ProductService.quickEditProductAttributes(product).then(_product => {
      return setHighlightForSkuEdited(_product);
    });
  };

  vm.summary = {};
  vm.data = {};
  BusinessService.allAsync().then(businesses => {
    vm.data.businesses = businesses;
  });

  function getTotalForOutlet(fields, productsTable, outletCode) {
    if (!productsTable) return null;
    return _.reduce(fields, (result, field) => {
      result[field] = _.sumBy(productsTable.data, `outletMap.${outletCode}.${field}`);
      return result;
    }, {});
  }

  vm.loadOutlets = () => {
    OutletService.all().then(outlets => vm.outlets = outlets);
    OutletService.getOutletCodes().then(outletCodes => {
      vm.outletCodes = outletCodes;
    });
  };

  $scope.$watch(() => vm.productsTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    if (!vm.outletCodes) return;
    const {
      OUTLET_CODES,
      KITCHEN_OUTLET_CODES
    } = vm.outletCodes;

    const fields = _.keys(_.get(vm.productsTable, 'data.0'));

    const summary = _.reduce(_.concat(OUTLET_CODES, KITCHEN_OUTLET_CODES), (result, outletCode) => {
      result[outletCode] = getTotalForOutlet(fields, vm.productsTable, outletCode);
      return result;
    }, {});

    summary.northTotal = _.reduce(vm.metrics, (result, metric) => {
      const field = vm.getTotalField(metric.id);

      const allValue = _.map(vm.productsTable.data, `northTotal.${field}`);

      result[field] = _.sum(allValue);
      return result;
    }, {});
    summary.southTotal = _.reduce(vm.metrics, (result, metric) => {
      const field = vm.getTotalField(metric.id);

      const allValue = _.map(vm.productsTable.data, `southTotal.${field}`);

      result[field] = _.sum(allValue);
      return result;
    }, {});
    summary.total = _.reduce(fields, (result, field) => {
      result[field] = _.sumBy(vm.productsTable.data, field);
      return result;
    }, {});
    vm.summary = summary;
  });

  const feedDataToTable = data => {
    let feedingProducts = data;

    if (vm.showMenuItemOnly) {
      feedingProducts = _.filter(feedingProducts, 'product.isMenuItem');
    }

    vm.data.vendors = _.sortBy(_.compact(_.uniqBy(_.map(data, 'product.vendor'), '_id')), 'code');

    _.forEach(feedingProducts, product => {
      product.northTotal = getTotalByRegion(product, 'NORTH');
      product.southTotal = getTotalByRegion(product, 'SOUTH');

      if (_.get(product, 'warehouseGroup.name') === 'Tủ đông') {
        product.condition = 'Hàng lạnh tủ đông';
      } else if (_.get(product, 'warehouseGroup.name') === 'Tủ mát') {
        product.condition = 'Hàng lạnh tủ mát';
      } else {
        product.condition = 'Hàng khô';
      }
    });

    vm.productsTable.settings({
      dataset: feedingProducts
    });
    vm.productsTable.reload();
    return feedingProducts;
  };

  function attachWeight(products) {
    _.forEach(products, product => {
      const weight = ProductWeight.getWeight(_.get(product, 'product.description', ''));

      _.forEach(product.outletMap, outlet => {
        outlet.weight = weight * outlet.quantity;
      });

      product.weight = _.reduce(product.outletMap, (result, outlet) => {
        return result + outlet.weight || 0;
      }, 0);
    });
  }

  const getOutletSale = ({
    startDate,
    endDate,
    businessCode
  }) => {
    let promise = $http.get('/reports/outlet-sale', {
      params: {
        startDate,
        endDate,
        businessCode
      }
    }).then(response => {
      attachWeight(response.data);
      return response.data;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
    return promise;
  };

  vm.find = () => {
    vm.data.allProducts = [];
    feedDataToTable([]);
    vm.getData = getOutletSale({
      startDate: vm.startDate,
      endDate: vm.endDate,
      businessCode: vm.data.business
    }).then(products => {
      vm.data.allProducts = _.map(products, product => {
        if (product.product.isDirect) {
          product.warehouseRestock = 'Direct';
        } else {
          product.warehouseRestock = _.get(product, 'product.warehouseRestock.code', '');
        }

        return product;
      });
      vm.savorCats = _.map(_.uniq(_.map(products, product => {
        return _.get(product, 'product.category.cat.name', '');
      })), cat => {
        return {
          id: cat,
          title: cat
        };
      });
      return products;
    }).then(feedDataToTable).catch(FhdMessenger.errorFromServer);
    return vm.getData;
  };

  vm.changeBusiness = businessValue => {
    switch (businessValue) {
      case 'ABBY':
        vm.productsTable.filter()['product.business.code'] = businessValue;
        break;

      case 'SAVOR':
        vm.productsTable.filter({});
        vm.productsTable.filter()['product.business.code'] = businessValue;
        vm.data.metric = 'quantity';
        break;

      default:
        break;
    }
  };

  vm.changeVendor = vendor => {
    vm.productsTable.filter()['product.vendor.code'] = vendor.code;
    vm.data.vendor = vendor.name;
  };

  vm.clearFilterVendor = () => {
    vm.productsTable.filter()['product.vendor.code'] = '';
    vm.data.vendor = '';
  };

  vm.copyProductTSV = async () => {
    const ABBY_OUTLET_CODES = OutletStockService.abbyOutletCodes;
    const SAVOR_OUTLET_CODES = OutletStockService.savorOutletCodes;
    let outletCodes = vm.data.business === 'SAVOR' ? SAVOR_OUTLET_CODES : ABBY_OUTLET_CODES;
    outletCodes = _.filter(outletCodes, vm.hasPermission);
    const headers = ['STT', 'SKU', 'Description', 'Price', ...outletCodes, 'northTotal', 'southTotal', 'total'];
    vm.data.productTSV = 'Đang tạo dữ liệu...';

    const products = _.map(_.filter(vm.data.allProducts, product => {
      if (vm.data.business === 'SAVOR') {
        return product.product.sku.match(/^V/);
      }

      return true;
    }), (product, index) => {
      const fields = [index + 1, _.get(product, 'product.sku', ''), _.get(product, 'product.description', ''), _.get(product, 'product.price', ''), ..._.map(outletCodes, outletCode => {
        return _.get(product, `outletMap.${outletCode}.${vm.data.metric}`, 0);
      }), _.get(product, `northTotal.${vm.getTotalField(vm.data.metric)}`), _.get(product, `southTotal.${vm.getTotalField(vm.data.metric)}`), _.get(product, vm.data.metric, 0)];
      return fields.join('\t');
    });

    vm.data.productTSV = `Cập nhật lúc ${moment().format('YYYY-MM-DD HH:mm')}\n` + headers.join('\t') + '\n' + products.join('\n');
    const copyText = $window.document.getElementById('productsCSV');
    vm.copying = true;
    const copyPromise = $timeout(() => {
      /* Select the text field */
      copyText.select();
      /* Copy the text inside the text field */

      $window.document.execCommand('copy');
    }, 2000);
    FhdMessenger.notifyLoading('Đang copy bảng', copyPromise, () => {
      FhdMessenger.success('Đã copy');
    });
  };
}]);
"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('reports').controller('ReportMissingRestockController', ['$http', 'FhdMessenger', 'NgTableParams', 'OutletService', 'StyleService', 'RestockLists', '$filter', function ($http, FhdMessenger, NgTableParams, OutletService, StyleService, RestockLists, $filter) {
  const vm = this;
  vm.kpiTable = new NgTableParams({
    count: 50
  });
  vm.missingRestockByOutletsTable = new NgTableParams({
    count: 50
  });
  vm.missingRestockByStaffsTable = new NgTableParams({
    count: 50
  });
  vm.warehouseRestockCode = 'D5';

  function indexCol($scope, row, rowIndex) {
    return `<span>${rowIndex + 1}</span>`;
  }

  function normalValue($scope, row) {
    const vm = this;

    let value = _.get(row, vm.field);

    if (!value) {
      value = '';
    }

    return `<span>${value}</span>`;
  }

  function percentValue($scope, row) {
    // eslint-disable-next-line
    let value = $filter('number')(_.get(row, this.field));

    if (!value) {
      return '';
    }

    value = (value * 100).toFixed(2);
    return `<span>${value}%</span>`;
  }

  const WAREHOUSE_CODES = ['D2', 'D4', 'D5', 'M6'];
  vm.missingRestockByOutletsTableCols = [{
    field: 'outletCode',
    title: 'Outlet',
    show: true,
    getValue: normalValue
  }];

  const warehouseCols = _.map(WAREHOUSE_CODES, code => ({
    field: code,
    title: code,
    show: true,
    getValue: percentValue,
    sortable: code,
    getStyle: () => ({
      'text-align': 'center'
    })
  }));

  vm.missingRestockByOutletsTableCols.push(...warehouseCols);
  vm.missingRestockByOutletsTableCols.push({
    field: 'avgRate',
    title: 'Trung bình',
    show: true,
    sortable: 'percentValue',
    getValue: percentValue,
    getStyle: () => ({
      'text-align': 'center',
      'font-weight': 'bold'
    })
  });
  vm.missingRestockByStaffsTableCols = [{
    field: 'user.code',
    title: 'Mã NV',
    show: true,
    getValue: normalValue
  }, {
    field: 'user.displayName',
    title: 'Tên NV',
    show: true,
    getValue: normalValue
  }];
  vm.missingRestockByStaffsTableCols.push(...warehouseCols);
  vm.missingRestockByStaffsTableCols.push({
    field: 'avgRate',
    title: 'Trung bình',
    show: true,
    getValue: percentValue,
    sortable: 'percentValue',
    getStyle: () => ({
      'text-align': 'center',
      'font-weight': 'bold'
    })
  });

  const defineMissingItemTableCols = async () => {
    const {
      ABBY_OUTLET_CODES,
      CENTRAL_OUTLET_CODES,
      SOUTH_OUTLET_CODES
    } = await OutletService.getOutletCodes();
    const outletStyle = await StyleService.getOutletStyle();

    function getStyle(row) {
      const vm = this;
      const outlet = vm.field;
      return outletStyle(outlet);
    }

    const RESTOCK_FROM_M6_OUTLET_CODES = CENTRAL_OUTLET_CODES.concat(SOUTH_OUTLET_CODES);
    vm.cols = [{
      title: 'STT',
      show: true,
      getValue: indexCol
    }, {
      field: 'warehouseCode',
      title: 'Warehouse',
      sortable: 'warehouseCode',
      filter: {
        warehouseCode: 'text'
      },
      show: true,
      getValue: normalValue,
      getStyle: () => {
        return {
          'min-width': 50
        };
      }
    }, {
      field: 'sku',
      title: 'SKU',
      sortable: 'sku',
      filter: {
        sku: 'text'
      },
      show: true,
      getValue: normalValue,
      getStyle: () => {
        return {
          'min-width': 80
        };
      }
    }, {
      field: 'description',
      title: 'Description',
      sortable: 'description',
      filter: {
        description: 'text'
      },
      show: true,
      getValue: normalValue,
      getStyle: () => {
        return {
          'min-width': 200
        };
      }
    }];

    _.forEach(ABBY_OUTLET_CODES, outlet => {
      const outletCol = {
        field: outlet,
        title: outlet,
        sortable: () => `${outlet}`,
        getStyle: getStyle,
        getValue: normalValue,
        show: () => {
          return vm.warehouseRestocks !== 'M6' || vm.warehouseRestocks === 'M6' && RESTOCK_FROM_M6_OUTLET_CODES.includes(outlet);
        }
      };
      vm.cols.push(outletCol);
    });

    vm.cols.push({
      field: 'total',
      title: 'total',
      sortable: 'total',
      getStyle: getStyle,
      getValue: normalValue
    });
  };

  vm.init = async () => {
    await defineMissingItemTableCols();
  };

  const calculateAvgMissingRestockRate = missingRestockRate => {
    return missingRestockRate = _.map(missingRestockRate, missingRestock => {
      const {
        count,
        totalRate
      } = missingRestock;
      const avgRate = totalRate / count;
      return _objectSpread({}, missingRestock, {
        avgRate
      });
    });
  };

  vm.startDate = moment().subtract(7, 'day').format('YYYY-MM-DD');
  vm.endDate = moment().subtract(1, 'day').format('YYYY-MM-DD');

  vm.find = async () => {
    const startDate = moment(vm.startDate);
    const endDate = moment(vm.endDate);
    const {
      ABBY_OUTLET_CODES
    } = await OutletService.getOutletCodes();
    let promise = $http.get('/reports/missing-restock', {
      params: {
        startDate: startDate.format('YYYY-MM-DD'),
        endDate: endDate.format('YYYY-MM-DD')
      }
    }).then(response => response.data).then(data => {
      const missingRestockRateByOutlet = calculateAvgMissingRestockRate(data.missingRestockRateByOutlet);
      const missingRestockRateByStaff = calculateAvgMissingRestockRate(data.missingRestockRateByStaff);
      vm.missingRestockByOutletsTable.settings({
        dataset: missingRestockRateByOutlet
      });
      vm.missingRestockByStaffsTable.settings({
        dataset: missingRestockRateByStaff
      });
      vm.kpiTable.settings({
        dataset: data.missingRestockRatesByWarehouse
      });
      vm.warehouseRestockCodes = _.map(data.warehouseRestocks, 'code');

      _.forEach(vm.warehouseRestockCodes, warehouseRestockCode => {
        // Missing Items
        const filteredMissingItems = _.filter(data.missingItems, missingItem => {
          return warehouseRestockCode.includes(missingItem.warehouseCode);
        });

        _.forEach(filteredMissingItems, missingItem => {
          missingItem.total = _.sumBy(ABBY_OUTLET_CODES, ABBY_OUTLET_CODE => {
            return _.get(missingItem, ABBY_OUTLET_CODE, 0);
          });
        });

        vm[warehouseRestockCode] = {};
        vm[warehouseRestockCode].missingItemTable = new NgTableParams({
          count: 50
        });
        vm[warehouseRestockCode].missingItemTable.settings({
          dataset: filteredMissingItems
        }); // Restock Items

        const filteredRestockItems = _.filter(data.restockItems, item => {
          return warehouseRestockCode.includes(item.warehouseCode);
        });

        _.forEach(filteredRestockItems, item => {
          item.total = _.sumBy(ABBY_OUTLET_CODES, ABBY_OUTLET_CODE => {
            return _.get(item, ABBY_OUTLET_CODE, 0);
          });
        });

        vm[warehouseRestockCode] = {};
        vm[warehouseRestockCode].restockItemTable = new NgTableParams({
          count: 50
        });
        vm[warehouseRestockCode].restockItemTable.settings({
          dataset: filteredRestockItems
        });
      });
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Ok!');
    });
  };
}]);
"use strict";

angular.module('reports').controller('ReturnItemsAnalyticsController', ['$http', '$q', '$stateParams', 'AnalyticMaps', 'Authentication', 'FhdMessenger', 'NgTableParams', function ($http, $q, $stateParams, AnalyticMaps, Authentication, FhdMessenger, NgTableParams) {
  const vm = this;
  vm.user = Authentication.user;
  vm.params = $stateParams;
  vm.params.metric = vm.params.metric || 'quantity';
  vm.params.dimension = vm.params.dimension || 'outlet';
  vm.params.mode = vm.params.mode || 'day';
  vm.params.startDate = vm.params.startDate || moment().subtract(1, 'week').format('YYYY-MM-DD');
  vm.params.endDate = vm.params.endDate || moment().add(1, 'day').format('YYYY-MM-DD');
  vm.data = {};
  vm.data.startDate = moment().subtract(1, 'week').format('YYYY-MM-DD');
  vm.data.endDate = moment().format('YYYY-MM-DD');
  vm.productsTable = new NgTableParams({});
  vm.userParams = {};
  vm.data = {};
  vm.current = {};
  vm.data.map = AnalyticMaps.get({
    mapName: 'return-item'
  }, function () {
    vm.current = {
      dimension: _.find(vm.data.map.dimensions, {
        name: vm.params.dimension
      }) || {},
      metric: _.find(vm.data.map.metrics, {
        name: vm.params.metric
      }) || {}
    };
  });

  const noDateParams = _.assign({}, vm.params, {
    previousStartDate: undefined,
    previousEndDate: undefined
  });

  vm.find = function () {
    let promise = $http({
      url: '/stats-return-items',
      method: 'GET',
      params: _.assign({}, noDateParams, {
        startDate: vm.params.startDate,
        endDate: vm.params.endDate
      })
    }).success(function (response) {
      return response;
    }).success(feedDataToTable).error(function (error) {
      FhdMessenger.errorFromServer(error);
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong!');
    });
  };

  const feedDataToTable = data => {
    vm.productsTable.settings({
      dataset: data
    });
    return data;
  };
}]);
"use strict";

angular.module('reports').controller('SaleAnalyticsNewController', ['$stateParams', '$state', '$timeout', '$window', 'Analytics', 'FhdMessenger', 'Calendar', 'LunarService', 'toaster', '$location', function ($stateParams, $state, $timeout, $window, Analytics, FhdMessenger, Calendar, LunarService, toaster, $location) {
  const vm = this;
  vm.data = {
    tableData: []
  };

  vm.getState = function () {
    vm.startDate = $stateParams.startDate ? moment($stateParams.startDate).format('YYYY-MM-DD') : moment().subtract(7, 'day').startOf('day').format('YYYY-MM-DD');
    vm.endDate = $stateParams.endDate ? moment($stateParams.endDate).format('YYYY-MM-DD') : moment().subtract(1, 'day').startOf('day').format('YYYY-MM-DD');
    vm.metric = $stateParams.metric || 'sale';
    vm.mode = $stateParams.mode || 'day';
    vm.dimension = $stateParams.dimension || 'cat-man';
    vm.filters = $stateParams.filters ? angular.fromJson($stateParams.filters) : [{
      optionLabel: 'Business',
      optionValue: 'business',
      filterLabel: 'ABBY',
      filterValue: '5710bb19731ce0c4ebf685dd'
    }];

    if (!$stateParams.previousStartDate || !$stateParams.previousEndDate) {
      const lastLunarYear = Calendar.getLastLunarYear(vm.startDate, vm.endDate);
      vm.previousStartDate = lastLunarYear[0];
      vm.previousEndDate = lastLunarYear[1];
      FhdMessenger.info('Tự động so sánh với năm âm lịch trước.');
    } else {
      vm.previousStartDate = moment($stateParams.previousStartDate).format('YYYY-MM-DD');
      vm.previousEndDate = moment($stateParams.previousEndDate).format('YYYY-MM-DD');
    }
  };

  vm.goState = function () {
    const startDate = vm.startDate ? moment(vm.startDate).format('YYYY-MM-DD') : null;
    const endDate = vm.endDate ? moment(vm.endDate).format('YYYY-MM-DD') : null;
    const previousStartDate = vm.previousStartDate ? moment(vm.previousStartDate).format('YYYY-MM-DD') : null;
    const previousEndDate = vm.previousEndDate ? moment(vm.previousEndDate).format('YYYY-MM-DD') : null;
    const params = {
      startDate,
      endDate,
      previousStartDate,
      previousEndDate,
      metric: vm.metric,
      dimension: vm.dimension,
      mode: vm.mode,
      filters: angular.toJson(vm.filters)
    };
    $state.go('saleAnalytics2', params, {
      notify: false
    });
    $timeout(() => {
      vm.getState();
      vm.getStats();
    });
  };

  vm.getStats = function () {
    vm.data.tableData = [];
    vm.waiting = true;
    let getTableDataPromise = Analytics.getTableData({
      startDate: vm.startDate,
      endDate: vm.endDate,
      previousStartDate: vm.previousStartDate,
      previousEndDate: vm.previousEndDate,
      dimension: vm.dimension,
      filters: vm.filters
    }).then(data => {
      FhdMessenger.success('Tính xong');
      vm.data.tableData = data;
    }).catch(err => {
      toaster.pop({
        type: 'error',
        bodyOutputType: 'trustedHtml',
        timeout: 0,
        showCloseButton: false,
        body: `Có lỗi không tải được dữ liệu: ${err.data ? err.data.message : err.message || err}`
      });
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tính...', getTableDataPromise);
  };

  vm.lastPeriod = function () {
    const [previousStartDate, previousEndDate] = Calendar.getLastPeriod(vm.startDate, vm.endDate);
    vm.previousStartDate = previousStartDate;
    vm.previousEndDate = previousEndDate;
  };

  vm.lastSolarYear = function () {
    const [previousStartDate, previousEndDate] = Calendar.getLastSolarYear(vm.startDate, vm.endDate);
    vm.previousStartDate = previousStartDate;
    vm.previousEndDate = previousEndDate;
  };

  vm.lastLunarYear = function () {
    const [previousStartDate, previousEndDate] = Calendar.getLastLunarYear(vm.startDate, vm.endDate);
    vm.previousStartDate = previousStartDate;
    vm.previousEndDate = previousEndDate;
  };

  function getThatYear(date) {
    if (moment(date).year() === 2016) return 2017;
    if (moment(date).year() === 2017) return 2016;
    return 2017;
  }

  vm.chooseTetDay = () => {
    const year = moment(vm.endDate).year();
    let date = LunarService.getLunarNewYearDay(year);

    if (moment(vm.endDate).isAfter(moment(date))) {
      date = LunarService.getLunarNewYearDay(year + 1);
    }

    vm.endDate = date;
    vm.startDate = date;
  };

  vm.chooseMidAutumnDay = () => {
    const year = moment(vm.endDate).year();
    let date = LunarService.getMidAutumnDay(year);

    if (moment(vm.endDate).isAfter(moment(date))) {
      date = LunarService.getMidAutumnDay(year + 1);
    }

    vm.endDate = date;
    vm.startDate = date;
  };

  vm.chooseValentineDay = () => {
    let todayValentine = moment(vm.endDate).month(1).date(14).format('YYYY-MM-DD');

    if (moment(vm.endDate).diff(todayValentine) > 0) {
      todayValentine = todayValentine.year(todayValentine.year() + 1).format('YYYY-MM-DD');
    }

    vm.endDate = todayValentine;
    vm.startDate = todayValentine;
  };

  vm.switchMooncakeSeason = function () {
    const [startDate, endDate] = Calendar.getMooncakeSeasonPeriod(vm.startDate, vm.endDate, getThatYear(vm.startDate));
    vm.startDate = moment(startDate).format('YYYY-MM-DD');
    vm.endDate = moment(endDate).format('YYYY-MM-DD');
    const [previousStartDate, previousEndDate] = Calendar.getMooncakeSeasonPeriod(vm.previousStartDate, vm.previousEndDate, getThatYear(vm.previousStartDate));
    vm.previousStartDate = moment(previousStartDate).format('YYYY-MM-DD');
    vm.previousEndDate = moment(previousEndDate).format('YYYY-MM-DD');
  };

  vm.removeFilter = filter => {
    const matchIndex = _.findIndex(vm.filters, {
      filterValue: filter.filterValue,
      optionValue: filter.optionValue
    });

    if (matchIndex > -1) {
      vm.filters.splice(matchIndex, 1);
    }
  };

  vm.copyProductTSV = () => {
    let headers = ['STT', 'SKU', 'Description', 'Current Sale', 'Previous Sale', '%Diff Sale', 'Current Quantity', 'Previous Quantity', '%Diff Quantity', 'Current COGS', 'Previous COGS', '%Diff COGS'];

    if (_.some(vm.data.tableData, product => {
      return product.name;
    })) {
      headers = ['STT', 'Name', 'Current Sale', 'Previous Sale', '%Diff Sale', 'Current Quantity', 'Previous Quantity', '%Diff Quantity', 'Current COGS', 'Previous COGS', '%Diff COGS'];
    }

    vm.data.productTSV = 'Đang tạo dữ liệu...';

    const products = _.map(vm.data.tableData, (product, index) => {
      let fields = [index + 1, _.get(product, 'sku', ''), _.get(product, 'description', ''), _.get(product, 'current.sale', 0), _.get(product, 'previous.sale', 0), _.get(product, 'compare.sale', 0) * 100, _.get(product, 'current.quantity', 0), _.get(product, 'previous.quantity', 0), _.get(product, 'compare.quantity', 0) * 100, _.get(product, 'current.cogs', 0), _.get(product, 'previous.cogs', 0), _.get(product, 'compare.cogs', 0) * 100];

      if (_.some(vm.data.tableData, product => {
        return product.name;
      })) {
        fields = [index + 1, _.get(product, 'name', ''), _.get(product, 'current.sale', 0), _.get(product, 'previous.sale', 0), _.get(product, 'compare.sale', 0) * 100, _.get(product, 'current.quantity', 0), _.get(product, 'previous.quantity', 0), _.get(product, 'compare.quantity', 0) * 100, _.get(product, 'current.cogs', 0), _.get(product, 'previous.cogs', 0), _.get(product, 'compare.cogs', 0) * 100];
      }

      return fields.join('\t');
    });

    vm.data.productTSV = headers.join('\t') + '\n' + products.join('\n');
    const copyText = $window.document.getElementById('productsCSV');
    vm.waiting = true;
    const copyTextPromise = $timeout(() => {
      copyText.select();
      $window.document.execCommand('copy');
      vm.waiting = false;
    }, 2000);
    FhdMessenger.notifyLoading('Đang copy...', copyTextPromise, () => {
      FhdMessenger.success('Đã copy');
    });
  };

  vm.onClickDimension = dimension => {
    if (!_.some(vm.filters, {
      optionValue: dimension.dimension,
      filterValue: dimension.value
    })) {
      vm.filters.push({
        optionLabel: dimension.dimension,
        optionValue: dimension.dimension,
        filterValue: dimension.value,
        filterLabel: dimension.label
      });

      if (dimension.dimension === 'tetCategory') {
        vm.dimension = 'product';
      }

      vm.goState();
    }
  };
}]);
"use strict";

/* eslint-disable angular/controller-as */
angular.module('reports').controller('SaleAnalyticsController', ['$scope', '$stateParams', '$http', 'FhdMessenger', 'AnalyticMaps', '$state', 'Authentication', 'OutletService', '$q', 'Products', 'ObjectId', 'Calendar', 'toaster', function ($scope, $stateParams, $http, FhdMessenger, AnalyticMaps, $state, Authentication, OutletService, $q, Products, ObjectId, Calendar, toaster) {
  $scope.params = $stateParams;
  $scope.params.metric = $scope.params.metric || 'sale';
  $scope.params.dimension = $scope.params.dimension || 'business';
  $scope.params.mode = $scope.params.mode || 'day';
  $scope.params.startDate = $scope.params.startDate || moment().format('YYYY-MM-DD');
  $scope.params.endDate = $scope.params.endDate || moment().format('YYYY-MM-DD');
  $scope.outlets = OutletService.all().then(outlets => $scope.outlets = outlets);
  const startDate = $scope.params.startDate;
  const endDate = $scope.params.endDate;
  const previousDuration = moment.duration(moment(endDate).endOf('day').diff(moment(startDate)));
  const previousStartDate = moment(startDate).subtract(previousDuration).format('YYYY-MM-DD');
  const previousEndDate = moment(endDate).subtract(previousDuration).format('YYYY-MM-DD');
  $scope.params.previousStartDate = $scope.params.previousStartDate || previousStartDate;
  $scope.params.previousEndDate = $scope.params.previousEndDate || previousEndDate;
  $scope.waiting = false;

  if ($scope.params.product) {
    $scope.selectedProduct = Products.get({
      productId: $scope.params.product
    });
  }

  const user = Authentication.user;

  function restrictUser() {
    if (!_.intersection(user.roles, ['investor', 'admin', 'accountant', 'sale-analytics:view']).length) {
      $scope.params.outlet = user.outlet._id;

      if ($scope.params.metric === 'profit' || $scope.params.metric === 'cogs') {
        $scope.params.metric = 'sale';
      }

      return;
    }

    if (_.includes(user.roles, 'sale-analytics:view')) {
      // $scope.params.dimension = 'hour'
      if (!_.includes(user.roles, 'sale-analytics:all-businesses')) {
        $scope.params.business = ObjectId.getObjectId(user.business);
      }

      if (!_.includes(user.roles, 'sale-analytics:all-outlets')) {
        $scope.params.outlet = ObjectId.getObjectId(user.outlet);
      }

      if (!_.includes(user.roles, 'sale-analytics:cogs')) {
        if ($scope.params.metric === 'profit' || $scope.params.metric === 'cogs') {
          $scope.params.metric = 'sale';
        }
      }
    }
  }

  restrictUser();
  $scope.user = user;
  $scope.userParams = {};
  $scope.data = {};
  $scope.current = {};
  $scope.data.map = AnalyticMaps.get({
    mapName: 'sale-entry'
  }, function () {
    if (!_.includes(user.roles, 'admin') && !_.includes(user.roles, 'investor') && !_.includes(user.roles, 'accountant')) {
      $scope.data.map.metrics = _.reject($scope.data.map.metrics, {
        name: 'profit'
      });
      $scope.data.map.metrics = _.reject($scope.data.map.metrics, {
        name: 'cogs'
      });
    }

    $scope.current = {
      dimension: _.find($scope.data.map.dimensions, {
        name: $scope.params.dimension
      }) || {},
      metric: _.find($scope.data.map.metrics, {
        name: $scope.params.metric
      }) || {}
    };
  });

  const noDateParams = _.assign({}, $scope.params, {
    previousStartDate: undefined,
    previousEndDate: undefined,
    startDate: undefined,
    endDate: undefined
  });

  $scope.loadData = function () {
    if (hasAllInputs()) {
      restrictUser();
      $scope.waiting = true;
      let promise = $q.all([$http({
        url: '/stats',
        method: 'GET',
        params: _.assign({}, noDateParams, {
          startDate: $scope.params.startDate,
          endDate: $scope.params.endDate
        })
      }).success(function (response) {
        $scope.saleData = response;
      }).error(function (error) {
        FhdMessenger.errorFromServer(error);
      }), $http({
        url: '/stats',
        method: 'GET',
        params: _.assign({}, noDateParams, {
          startDate: $scope.params.previousStartDate,
          endDate: $scope.params.previousEndDate
        })
      }).success(function (response) {
        $scope.previousSaleData = response;
      }).error(function (error) {
        FhdMessenger.errorFromServer(error);
      })]).finally(() => {
        if (noDateParams.outlet) {
          $scope.currentOutlet = _.find($scope.outlets, {
            _id: noDateParams.outlet
          });
        } else {
          $scope.currentOutlet = null;
        }

        FhdMessenger.notifyLoading('Đang tính...', promise, () => {
          FhdMessenger.success('Tính xong');
        });
        $scope.waiting = false;
      });
    } else {
      $scope.goState();
    }
  };

  $scope.autoPrevious = function () {
    const startDate = $scope.params.startDate;
    const endDate = $scope.params.endDate;
    const previousDuration = moment.duration(moment(endDate).endOf('day').diff(moment(startDate)));
    const previousStartDate = moment(startDate).subtract(previousDuration).format('YYYY-MM-DD');
    const previousEndDate = moment(endDate).subtract(previousDuration).format('YYYY-MM-DD');
    $scope.params.previousStartDate = previousStartDate;
    $scope.params.previousEndDate = previousEndDate;
  };

  $scope.lastSolarYear = function () {
    const [previousStartDate, previousEndDate] = Calendar.getLastSolarYear($scope.params.startDate, $scope.params.endDate);
    $scope.params.previousStartDate = previousStartDate;
    $scope.params.previousEndDate = previousEndDate;
  };

  $scope.lastLunarYear = function () {
    const [previousStartDate, previousEndDate] = Calendar.getLastLunarYear($scope.params.startDate, $scope.params.endDate);
    $scope.params.previousStartDate = previousStartDate;
    $scope.params.previousEndDate = previousEndDate;
  };

  $scope.getLabel = function () {
    const match = _.find($scope.data.map.dimensions, {
      name: $scope.params.dimension
    });

    if (match) return match.labelPath;
    return 'N/A';
  };

  $scope.removeParam = function (param) {
    $scope.params[param] = undefined;
  };

  $scope.getDimensionMap = function () {
    const match = _.find($scope.data.map.dimensions, {
      name: $scope.params.dimension
    });

    if (match) return match;
    return null;
  };

  $scope.selectProduct = function (product) {
    $scope.params.product = product._id;
  };

  $scope.clearFilter = function (filter) {
    if (filter === 'product') {
      $scope.params.product = null;
    }
  }; // $scope.reload = function() {
  //   function loadCode(key) {
  //     let param = $scope.params[key]
  //     if (param) {
  //       param = param._id || param.code || param
  //       if (!param || param === 'null') $scope.params[key] = null
  //       else $scope.params[key] = param
  //     }
  //   }
  //   loadCode('outlet')
  //   loadCode('shift')
  //   loadCode('product-group')
  //   loadCode('product-department')
  //   loadCode('product-cat')
  //   loadCode('product-sub-cat')
  //   loadCode('product')
  //   loadCode('business')
  //   loadCode('referrer')
  //   loadCode('city')
  //   $scope.params.startDate = moment($scope.params.startDate).format('YYYY-MM-DD')
  //   $scope.params.endDate = moment($scope.params.endDate).format('YYYY-MM-DD')
  //   $scope.params.previousStartDate = moment($scope.params.previousStartDate).format('YYYY-MM-DD')
  //   $scope.params.previousEndDate = moment($scope.params.previousEndDate).format('YYYY-MM-DD')
  //   if ($scope.params.outlet) {
  //     $scope.currentOutlet = _.find($scope.outlets, { _id: noDateParams.outlet })
  //   } else {
  //     $scope.currentOutlet = null
  //   }
  //   $state.go('saleAnalytics', $scope.params)
  // }


  function hasAllInputs() {
    return !_.some([$scope.params.startDate, $scope.params.endDate, $scope.params.metric, $scope.params.dimension, $scope.params.previousStartDate, $scope.params.previousEndDate, $scope.params.mode], input => _.isUndefined(input));
  }

  $scope.goState = function () {
    const startDate = $scope.params.startDate ? moment($scope.params.startDate).format('YYYY-MM-DD') : null;
    const endDate = $scope.params.endDate ? moment($scope.params.endDate).format('YYYY-MM-DD') : null;
    const previousStartDate = $scope.params.previousStartDate ? moment($scope.params.previousStartDate).format('YYYY-MM-DD') : null;
    const previousEndDate = $scope.params.previousEndDate ? moment($scope.params.previousEndDate).format('YYYY-MM-DD') : null;
    const params = {
      startDate,
      endDate,
      previousStartDate,
      previousEndDate,
      metric: $scope.params.metric,
      dimension: $scope.params.dimension,
      mode: $scope.params.mode
    };
    $state.go('saleAnalytics', params);
    $scope.loadData();
  };
}]);
'use strict';

angular.module('reports').filter('filterFilter', [function () {
  var DEFAULT_PARAMS = ['dimension', 'mode', 'sort', 'metric', 'startDate', 'endDate', 'previousStartDate', 'previousEndDate'];
  return function (items) {
    var filtered = [];
    angular.forEach(items, function (item, key) {
      if (DEFAULT_PARAMS.indexOf(key) === -1 && item) filtered.push(key);
    });
    return filtered;
  };
}]);
'use strict';

angular.module('reports').directive('fhdAccountInput', [function () {
  return {
    templateUrl: '/modules/reports/views/fhd-account-input.client.view.html',
    restrict: 'AE',
    scope: {
      emptyOption: '=?',
      // has option none to select
      disableExceptAdmin: '=?',
      disableExceptAccountant: '=?',
      noDefault: '=?',
      account: '=',
      labelColumn: '@',
      noLabel: '=?',
      label: '@',
      onChange: '='
    },
    replace: true,
    controller: 'FhdAccountInputController',

    link(scope, element) {
      if (scope.labelColumn) {
        const labelElm = element.find('label');
        const inputElm = element.find('fhd-controls');
        labelElm.addClass(`col-sm-${scope.labelColumn}`);
        inputElm.addClass(`col-sm-${12 - scope.labelColumn}`);
      }
    }

  };
}]).controller('FhdAccountInputController', ['$scope', 'AccountService', 'Authentication', 'FhdMessenger', 'ObjectId', function ($scope, AccountService, Authentication, FhdMessenger, ObjectId) {
  const user = Authentication.user;
  const vm = $scope;
  vm.data = {};
  vm.loadDefault = _.isUndefined(vm.loadDefault) ? true : vm.loadDefault;
  vm.emptyOption = _.isUndefined(vm.emptyOption) ? true : vm.emptyOption;
  vm.limit = _.isUndefined(vm.limit) ? false : vm.limit;
  vm.noDefault = _.isUndefined(vm.noDefault) ? false : vm.noDefault;

  if (!_.includes(user.roles, 'admin') && !_.includes(user.roles, 'accountant') && vm.disableExceptAccountant) {
    vm.toDisable = true;
  } else {
    vm.toDisable = false;
  }

  if (!_.includes(user.roles, 'admin') && !_.includes(user.roles, 'accountant') && vm.limit) {
    vm.limit = true;
  } else {
    vm.limit = false;
  }

  function processAccount(accounts) {
    return accounts;
  }

  function getAccountsAsync() {
    if (vm.emptyOption) return AccountService.withAllOptionAsync();
    return AccountService.allAsync();
  }

  vm.getAccounts = getAccountsAsync().then(processAccount).then(accounts => {
    vm.data.accounts = accounts;

    if (vm.limit) {
      accounts = _.filter(accounts, account => {
        return account.type === 'cash' && account.staff && ObjectId.getObjectId(account.staff) === ObjectId.getObjectId(user);
      });
    }

    return accounts;
  }).catch(FhdMessenger.errorFromServer);

  vm.getDefaultAccount = () => {
    vm.getAccounts.then(function (accounts) {
      if (vm.account) {
        return _.find(accounts, {
          _id: ObjectId.getObjectId(vm.account)
        });
      }

      if (!vm.noDefault) {
        return _.find(accounts, account => {
          return account.type === 'cash' && account.staff && ObjectId.getObjectId(account.staff) === ObjectId.getObjectId(user);
        }) || _.last(accounts);
      }
    }).then(account => {
      vm.account = account;
      return account;
    });
  };

  $scope.$watch('account', function (newValue, oldValue) {
    if (newValue === oldValue || angular.isUndefined(newValue)) return;
    vm.getDefaultAccount();
  });

  if (vm.onChange) {
    $scope.$watch('account', (newValue, oldValue) => {
      if (newValue !== oldValue && newValue) vm.onChange(vm.account);
    });
  }
}]);
"use strict";

angular.module('reports').directive('fhdAssignPlKpis', [function () {
  return {
    restrict: 'E',
    templateUrl: '/modules/reports/templates/fhd-assign-pl-kpis.client.template.html',
    controller: 'fhdAssignKpisController',
    controllerAs: 'vm',
    scope: {}
  };
}]).controller('fhdAssignKpisController', ['FhdMessenger', 'NgTableParams', 'ReportStats', 'Settings', function (FhdMessenger, NgTableParams, ReportStats, Settings) {
  const vm = this;
  vm.totals = {
    totalPLTime: 0,
    totalShiftTime: 0,
    avgNewProduction: 0,
    yesterdayShiftTime: 0,
    yesterdayProductionTime: 0,
    todayProductionTime: 0
  };
  vm.packingOutletTable = new NgTableParams({});

  vm.toggleAllowReceivePlTask = (outlet, allowReceivePlTask) => {
    const outletCode = outlet.outletCode;
    vm.waiting = true;
    vm.settings.$toggleAllowReceivePlTask({
      outletCode: outletCode,
      allowReceivePlTask
    }).then(settings => {
      const action = allowReceivePlTask ? 'bật' : 'tắt';
      FhdMessenger.success(`Đã ${action} cơ sở ${outletCode}`);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  ReportStats.getAssignPlKPIs().then(data => {
    vm.packingOutletTable.settings({
      dataset: data.packingOutlets
    });
    vm.waiting = true;
    Settings.get().$promise.then(setting => {
      vm.settings = setting;
      vm.outletMap = _.reduce(setting.outlets, (result, outlet) => {
        if (outlet.code.match(/G/)) result[outlet.code] = outlet;
        return result;
      }, {});
      vm.waiting = false;
    });
    vm.noProductionTimeItems = data.noProductionTimeItems;
    vm.avgProductionConsumed = data.avgProductionConsumed;

    _.forEach(data.packingOutlets, packingOutlet => {
      const {
        totalPLTime,
        totalShiftTime,
        avgNewProduction,
        yesterdayShiftTime,
        yesterdayProductionTime,
        todayProductionTime
      } = packingOutlet;
      vm.totals.totalPLTime += totalPLTime;
      vm.totals.totalShiftTime += totalShiftTime / 7;
      vm.totals.avgNewProduction += avgNewProduction / 7;
      vm.totals.yesterdayShiftTime += yesterdayShiftTime;
      vm.totals.yesterdayProductionTime += yesterdayProductionTime;
      vm.totals.todayProductionTime += todayProductionTime;
    });
  });
}]);
'use strict';

