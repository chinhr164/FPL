angular.module('application-forms').controller('ModalViewApplicationFormController', ['applicationFormId', 'ApplicationForms', '$modalInstance', function (applicationFormId, ApplicationForms, $modalInstance) {
  const vm = this;

  vm.findOne = function () {
    vm.applicationForm = ApplicationForms.get({
      applicationFormId
    });
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
