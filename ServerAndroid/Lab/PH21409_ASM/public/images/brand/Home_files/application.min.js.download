    $q.all([vm.products.$promise, vm.stockMap]).then(([products, stockMap]) => {
      _.forEach(products, product => {
        product.currentStock = _.get(stockMap, product._id);
      });
    });
  };

  vm.getProductType = () => [{
    title: 'Nhãn',
    id: 'label'
  }, {
    title: 'Bao bì',
    id: 'wrapper'
  }, {
    title: 'Dụng cụ',
    id: 'tool'
  }, {
    title: 'Hàng Vendor',
    id: 'vendorProduct'
  }];

  vm.quickEditProduct = ProductService.quickEditProduct;
}]);
'use strict';

angular.module('products').controller('ModalBulkUploadProductsController', ['products', '$http', 'FhdMessenger', function (products, $http, FhdMessenger) {
  const vm = this;
  vm.products = products;
  vm.editImages = false;

  vm.bulkUpload = function () {
    _.forEach(products, function (product) {
      product.uploadingProgress = 'Uploading...';
    });

    vm.waiting = true;
    async.eachSeries(products, function (product, callback) {
      $http.put('/products/' + product._id + '/update-website', {
        editImages: vm.editImages
      }).then(function (response) {
        var permalink = response.data.permalink;
        product.uploadingProgress = permalink;
        product.success = true;
        product.processType = _.get(product, 'wooProperties.websiteId') > 0 ? 'Cập nhật' : 'Tạo mới';
        callback(null, {
          _id: product._id,
          success: true,
          data: permalink
        });

        _.assignIn(product, {
          wooProperties: {
            websiteId: _.get(response, 'data.permalink')
          }
        });
      }, function (err) {
        var message = err.data ? err.data.message || 'Lỗi' : 'Lỗi';
        product.uploadingProgress = message;
        product.error = true;
        callback(null, {
          _id: product._id,
          success: false,
          data: message
        });
      });
    }, function (err, results) {
      if (err) {
        FhdMessenger.errorFromServer(err);
      }

      vm.waiting = false;
    });
  };
}]);
'use strict';

angular.module('products').controller('ModalCreateProductController', ['$modalInstance', '$sce', 'FhdMessenger', 'ProductService', 'Products', function ($modalInstance, $sce, FhdMessenger, ProductService, Products) {
  const vm = this;
  vm.product = {
    isRaw: true,
    productType: 'raw'
  };
  vm.close = $modalInstance.dismiss;

  vm.newSku = function () {
    const businessCode = 'ABBY';
    const productType = 'raw';
    ProductService.newSku(productType, businessCode).then(sku => {
      vm.product.sku = sku;
    });
  };

  vm.create = function () {
    if (!vm.product.sku) {
      return FhdMessenger.error('Chưa có mã.');
    }

    if (!vm.product.description) {
      return FhdMessenger.error('Chưa có tên sản phẩm.');
    }

    const product = new Products(vm.product);
    return product.$save(function () {
      FhdMessenger.success(`Tạo SKU ${product.sku} thành công`);
      $modalInstance.close(product);
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  };
}]);
"use strict";

angular.module('products').controller('ModalEditComboElementController', ['comboElement', 'helper', '$http', '$modalInstance', function (comboElement, helper, $http, $modalInstance) {
  const vm = this;
  vm.comboElement = comboElement;
  vm.removeValueFromArray = helper.removeValueFromArray;

  vm.insertItemOption = product => {
    vm.comboElement.itemOptions = vm.comboElement.itemOptions || [];
    vm.comboElement.itemOptions.push({
      product: product._id,
      sku: product.sku,
      description: product.description,
      countAs: 1
    });
  };

  vm.close = () => {
    $modalInstance.dismiss();
  };
}]);
'use strict';

angular.module('products').controller('ModalEditProductController', ['$scope', 'Products', 'product', 'Authentication', '$modalInstance', '$state', 'Businesses', 'ProductService', 'FhdMessenger', 'Vendors', 'ProductGroups', 'ProductDepartments', 'ProductCats', 'ProductSubCats', 'role', 'WooProductCategoryService', '$q', 'Outlets', 'ReviewRanks', 'WarehouseGroups', 'VendorService', 'SellingProfiles', function ($scope, Products, product, Authentication, $modalInstance, $state, Businesses, ProductService, FhdMessenger, Vendors, ProductGroups, ProductDepartments, ProductCats, ProductSubCats, role, WooProductCategoryService, $q, Outlets, ReviewRanks, WarehouseGroups, VendorService, SellingProfiles) {
  const vm = this;
  const user = Authentication.user;

  const isSomeOne = _.curry(function (role, user) {
    return _.includes(user.roles, role);
  });

  const isAdmin = isSomeOne('admin');
  const isAdminMerchandise = isSomeOne('admin-merchandise');
  const isPurchasing = isSomeOne('purchaser');
  const isInfo = isSomeOne('info'); // Get current role view

  vm.role = role; // Determine if user can see anything at all

  vm.canView = false;

  if (vm.role === 'info') {
    if (isAdmin(user) || isAdminMerchandise(user) || isPurchasing(user) || isInfo(user)) {
      vm.canView = true;
    } else {
      $modalInstance.close('cancel');
    }
  }

  if (vm.role === 'buyer') {
    if (isAdmin(user) || isAdminMerchandise(user)) {
      vm.canView = true;
    } else {
      $modalInstance.close('cancel');
    }
  }

  if (vm.role === 'inventory') {
    if (isAdmin(user) || isAdminMerchandise(user)) {
      vm.canView = true;
    } else {
      $modalInstance.close('cancel');
    }
  } // Determine if user can change cogs


  vm.canChangeCogs = false;
  if (isAdmin(user) || isAdminMerchandise(user) || isPurchasing(user)) vm.canChangeCogs = true; // Determine if user can change salary percentage

  vm.canChangeSalary = false;
  if (isAdmin(user) || isAdminMerchandise(user) || isPurchasing(user)) vm.canChangeSalary = true; // Determine if user can change sale price

  vm.canChangeSalePrice = false;
  if (isAdmin(user)) vm.canChangeSalePrice = true; // Determine if user can change sale price

  vm.canChangePrice = false;
  if (isAdmin(user) || isAdminMerchandise(user) || isPurchasing(user)) vm.canChangePrice = true; // Determine if user can delete product

  vm.canDelete = false;

  if (isAdmin(user)) {
    vm.canDelete = true;
  } // Determine if user can change properties of product


  vm.canChangeProperties = false;

  if (isAdmin(user) || isAdminMerchandise(user) || isPurchasing(user)) {
    vm.canChangeProperties = true;
  } // Load current product


  vm.product = Products.get({
    productId: product._id
  }, function () {
    vm.product.updatedBusiness = vm.product.business ? vm.product.business._id || vm.product.business : null;
    vm.product.wooProperties = vm.product.wooProperties || {};
    vm.product.wooProperties.categories = _.map(vm.product.wooProperties.categories, getCategoryWithDescription);
    vm.product.wooProperties.images = vm.product.wooProperties.images || [{
      src: ''
    }];

    if (!vm.product.wooProperties.images.length) {
      vm.product.wooProperties.images = [{
        src: ''
      }];
    }

    vm.product.attributes = vm.product.attributes || {};
    vm.imagesChanged();
  });
  vm.data = {};
  vm.data.outlets = Outlets.query(function () {
    vm.data.outlets = _.filter(vm.data.outlets, {
      isPos: true,
      isStorage: true
    });
  });
  SellingProfiles.query().then(sellingProfiles => {
    vm.data.sellingProfiles = sellingProfiles;
  });
  $q.all([vm.product.$promise, vm.data.outlets.$promise]).then(function () {
    vm.product.outletAttributes = vm.product.outletAttributes || [];

    const notFoundOutlets = _.reject(vm.data.outlets, function (outlet) {
      return _.some(vm.product.outletAttributes, function (outletAttribute) {
        return outlet._id === outletAttribute.outlet;
      });
    });

    _.forEach(notFoundOutlets, function (outlet) {
      vm.product.outletAttributes.push({
        outlet: outlet._id,
        outletCode: outlet.code,
        minStock: 0,
        displayStock: 0,
        shelfLocations: []
      });
    });

    vm.product.outletAttributes = _.sortBy(vm.product.outletAttributes, 'outletCode');
    vm.product.rawProductCogs = _.reduce(vm.product.rawProducts, (result, rawProduct) => {
      return result + _.get(rawProduct, 'product.cogs', 0) * rawProduct.quantity;
    }, 0);
  });
  vm.data.businesses = Businesses.query();
  vm.data.vendors = Vendors.query();
  vm.data.reviewRanks = ReviewRanks.query();
  vm.category = {};
  vm.category.groups = [];
  vm.data.groups = ProductGroups.query(function (groups) {
    vm.category.groups = groups;
  });
  vm.data.warehouseGroups = WarehouseGroups.query();
  $q.all([vm.data.groups.$promise]).then(function () {
    if (vm.product.category.group) {
      vm.category.groups = _.filter(vm.data.groups, function (group) {
        return group._id === vm.product.category.group;
      });
    }
  });
  vm.attributes = ['material', 'ingredients', 'dimensionsText', 'weightText', 'packaging', 'usage', 'origin', 'condition', 'expiryInfo'];

  vm.addReorderLink = function (reorderLink) {
    vm.product.reorderLinks = vm.product.reorderLinks || [];

    if (!_.some(vm.product.reorderLinks, productReorderLink => {
      return productReorderLink === reorderLink;
    })) {
      vm.product.reorderLinks.push(reorderLink);
    }

    reorderLink = '';
  };

  vm.removeReorderLink = function (index) {
    vm.product.reorderLinks.splice(index, 1);
  };

  function getCategoryWithDescription(category) {
    const parentText = category.parent ? `${category.parent.name} -> ` : '';
    return _.assign(category, {
      description: `${parentText}${category.name}`
    });
  }

  WooProductCategoryService.withoutChildrenAsync().then(function (categories) {
    vm.wooProductCategories = _.map(categories, getCategoryWithDescription);
  });
  vm.product.category = vm.product.category || {};
  vm.images = [{
    src: ''
  }];

  function isSrcBlank(image) {
    return !image.src;
  }

  vm.imagesChanged = function () {
    vm.product.wooProperties = vm.product.wooProperties || {};
    vm.product.wooProperties.images = vm.product.wooProperties.images || [];

    const numberOfBlankImages = _.filter(vm.product.wooProperties.images, isSrcBlank).length;

    if (numberOfBlankImages >= 2) {
      const matchIndex = _.findIndex(vm.product.wooProperties.images, isSrcBlank);

      vm.product.wooProperties.images.splice(matchIndex, 1);
    }

    if (numberOfBlankImages < 1) {
      vm.product.wooProperties.images.push({
        src: ''
      });
    }
  };

  vm.update = function () {
    vm.product.business = _.find(vm.data.businesses, {
      _id: vm.product.updatedBusiness
    });
    vm.product.business = vm.product.updatedBusiness;
    vm.product.wooProperties = vm.product.wooProperties || {};
    vm.product.wooProperties.images = _.reject(vm.product.wooProperties.images, {
      src: ''
    });

    if (vm.product.images && vm.product.images.length) {
      vm.product.imageLink = _.head(vm.product.images).src;
    }

    vm.product.$update(function (product) {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close(product);
    }, function (error) {
      FhdMessenger.errorFromServer(error);
    });
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.createVendorModal = () => {
    VendorService.createVendorModal().result.then(vendor => {
      vm.data.vendors = vm.data.vendors || [];
      vm.data.vendors.push(vendor);
      vm.product.vendor = _.get(vendor, '_id');
    });
  };

  vm.setEditDisplayStockDate = outletAttribute => {
    outletAttribute.displayStockEditTime = new Date();
  };

  vm.changeSellingProfile = function (sellingProfileId) {
    _.forEach(vm.product.outletAttributes, outletAttribute => {
      const outlet = _.find(vm.data.outlets, {
        code: outletAttribute.outletCode
      });

      const region = _.get(outlet, 'region', 'NORTH');

      const format = _.get(outlet, 'format');

      const stopSell = SellingProfiles.getStopSell(sellingProfileId, outletAttribute.outletCode, region, format);
      outletAttribute.stopSell = stopSell !== null ? stopSell : outletAttribute.stopSell;
    });
  };
}]);
"use strict";

angular.module('products').controller('ModalEditRegionAttributeController', ['regionAttribute', 'helper', '$http', '$modalInstance', function (regionAttribute, helper, $http, $modalInstance) {
  const vm = this;
