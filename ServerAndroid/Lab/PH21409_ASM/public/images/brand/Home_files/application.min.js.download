angular.module('questions').controller('ImportQuestionsController', ['Authentication', 'FhdMessenger', 'Questions', 'ConfirmModal', function (Authentication, FhdMessenger, Questions, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;

  function getNameQuestionType(name) {
    switch (name) {
      case 'SORT':
        return 'Sắp xếp';

      case 'JOINTABLE':
        return 'Nối bảng';

      case 'FILLBLANK':
        return 'Điền vào chỗ trống';

      case 'MULTIPLE':
        return 'Trắc nghiệm';

      case 'ESSAY':
        return 'Tự luận';

      default:
        throw new Error('Undefined question name');
    }
  }

  vm.import = () => {
    if (!_.some(vm.sheetNames, selected => selected)) {
      return FhdMessenger.error('Bạn chưa chọn loại câu hỏi cần import');
    }

    if (!vm.googleSheetLink) {
      return FhdMessenger.error('Bạn chưa điền link google sheet');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ import question từ link gg sheet?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      Questions.importQuestions({
        googleSheetLink: vm.googleSheetLink,
        sheetNames: _.map(vm.sheetNames, (selected, sheetName) => {
          if (selected) return getNameQuestionType(sheetName);
        })
      }).$promise.then(questions => {
        return FhdMessenger.success(`Import ${questions.length} Questions thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('questions').controller('ModalDeleteQuestionsController', ['Authentication', 'questionId', 'Questions', '$modalInstance', '$http', 'FhdMessenger', '$state', function (Authentication, questionId, Questions, $modalInstance, $http, FhdMessenger, $state) {
  const vm = this;
  vm.user = Authentication.user;

  vm.findOne = () => {
    vm.question = Questions.get({
      questionId: questionId
    });
  };

  vm.close = () => {
    $modalInstance.dismiss();
  };

  vm.remove = () => {
    if (!_.intersection(vm.user.roles, ['admin', 'tro-ly-dt'])) {
      return FhdMessenger.error('Bạn không có quyền xóa câu hỏi');
    }

    vm.question.$delete().then(() => {
      FhdMessenger.success('Xóa câu hỏi thành công');
      $state.reload();
      vm.close();
    }).catch(FhdMessenger.errorFromServer);
  };
}]);
"use strict";

angular.module('questions').controller('ModalEditQuestionsController', ['Authentication', 'questionId', 'Questions', 'FhdMessenger', '$modalInstance', 'QuestionService', function (Authentication, questionId, Questions, FhdMessenger, $modalInstance, QuestionService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {};
  vm.data.questionTypes = [{
    name: 'Trắc nghiệm',
    code: 'MULTIPLE'
  }, {
    name: 'Tự luận',
    code: 'ESSAY'
  }, {
    name: 'Điền chỗ trống',
    code: 'FILLBLANK'
  }, {
    name: 'Nối bảng',
    code: 'JOINTABLE'
  }, {
    name: 'Sắp xếp',
    code: 'SORT'
  }];

  vm.init = function () {
    vm.data.sortQuestion = [];
    vm.data.sortTable = {
      groupA: [],
      groupB: []
    };
  };

  vm.find = () => {
    vm.question = Questions.get({
      questionId: questionId
    });
  };

  vm.removeItem = (index, questionType, question, group) => {
    let data = question || vm.data;

    switch (questionType) {
      case 'sort':
        return data.sortQuestion.splice(index, 1);

      case 'sortTable':
        if (group === 'A') {
          return data.sortTable.groupA.splice(index, 1);
        }

        if (group === 'B') {
          return data.sortTable.groupB.splice(index, 1);
        }

        return FhdMessenger.error('Hmmm Something was wrong!');

      default:
    }
  };

  vm.addQuestion = (questionType, question, group) => {
    let data = question || vm.data;

    switch (questionType) {
      case 'sort':
        return data.sortQuestion.push({
          serial: '',
          description: ''
        });

      case 'sortTable':
        if (group === 'A') {
          return data.sortTable.groupA.push({
            description: ''
          });
        }

        if (group === 'B') {
          return data.sortTable.groupB.push({
            description: '',
            answer: ''
          });
        }

        return FhdMessenger.error('Hmmm Something was wrong!');

      default:
    }
  };

  vm.bindBreakLine = QuestionService.bindBreakLine;

  vm.addAnswer = event => {
    event.preventDefault();

    if (!vm.newAnswer) {
      FhdMessenger.error('Ô điền thêm lưạ chọn còn trống');
      return;
    }

    if (vm.newAnswer) {
      vm.question.answers.push({
        content: _.clone(vm.newAnswer),
        isKey: false
      });
      vm.newAnswer = null;
    }
  };

  vm.removeAnswer = function (index) {
    vm.question.answers.splice(index, 1);
  };

  vm.update = () => {
    if (!vm.question.business) {
      return FhdMessenger.error('Chưa nhập business cho câu hỏi');
    }

    if (vm.question.questionType === 'MULTIPLE' && vm.question.answers.length === 0) {
      return FhdMessenger.error('Câu hỏi trắc nghiệm cần có danh sách đáp án');
    }

    if (vm.question.questionType === 'MULTIPLE' && !_.some(vm.question.answers, {
      isKey: true
    })) {
      return FhdMessenger.error('Câu hỏi trắc nghiệm cần có ít nhất 1 câu trả lời đúng');
    }

    if (vm.question.questionType === 'FILLBLANK') {
      for (let i = 0; i < vm.question.fillBlank.length; i++) {
        if (_.isNull(vm.question.fillBlank[i].key) || vm.question.fillBlank[i].answer === '') {
          return FhdMessenger.error('Câu hỏi điền vào chỗ trống cần có đáp án');
        }
      }
    }

    if (vm.question.questionType === 'FILLBLANK' && !vm.question.answer) {
      return FhdMessenger.error('Câu hỏi điền vào chỗ trống cần có đáp án');
    }

    let question = vm.question;

    if (vm.question.questionType !== 'MULTIPLE') {
      question.answers = [];
    }

    if (vm.question.questionType !== 'FILLBLANK') question.answer = null;
    question.$update().then(() => {
      $modalInstance.close(vm.question);
      FhdMessenger.success('Cập nhật thành công!');
    }).catch(err => FhdMessenger.error(err));
  };

  vm.close = () => {
    $modalInstance.dismiss();
  };
}]);
"use strict";

