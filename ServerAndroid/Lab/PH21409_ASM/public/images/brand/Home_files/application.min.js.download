angular.module('sale-entries').controller('ModalDeleteSaleEntryController', ['SaleEntries', '$modalInstance', 'saleEntryId', 'Authentication', 'FhdMessenger', '$location', function (SaleEntries, $modalInstance, saleEntryId, Authentication, FhdMessenger, $location) {
  const vm = this;
  vm.user = Authentication.user;
  vm.modal = $modalInstance;

  vm.dismiss = () => $modalInstance.dismiss();

  vm.close = () => $modalInstance.close();

  vm.saleEntry = SaleEntries.get({
    saleEntryId
  });

  vm.remove = () => {
    if (!vm.deleteNote) {
      return FhdMessenger.error('Bạn chưa điền lý do xóa Sale Entry này!');
    }

    vm.saleEntry.deleteNote = vm.deleteNote;
    vm.saleEntry.$softRemove().then(() => {
      FhdMessenger.success('Gửi yêu cầu thành công!');
      $location.path('/sale-entries');
    }).catch(FhdMessenger.errorFromServer);
    vm.saleEntry.$promise.then(() => {
      vm.close();
    });
  };
}]);
