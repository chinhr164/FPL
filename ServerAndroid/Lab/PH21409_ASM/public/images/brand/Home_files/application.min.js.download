angular.module('buying-entries').filter('buyingEntryStatus', [function () {
  return function (status) {
    switch (status) {
      case 'created':
        return 'Đã tạo';

      case 'ordered':
        return 'Đã đặt';

      case 'terminated':
        return 'Đã hủy';

      case 'arrived':
        return 'Đã về';

      case 'cancelled':
        return 'Đã xóa';

      case 'received':
        return 'Đã nhận';

      default:
        return 'Không xác định';
    }
  };
}]);
