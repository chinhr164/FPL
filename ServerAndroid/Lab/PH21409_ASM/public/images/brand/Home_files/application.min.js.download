angular.module('jsprint').factory('JsPrintService', ['$window', '$localStorage', '$location', function ($window, $localStorage, $location) {
  let jsPrintSetup = null;
  let hasJsPrint = false;

  if ($window.jsPrintSetup && $window.jsPrintSetup.getPrintersList) {
    jsPrintSetup = $window.jsPrintSetup || null;
    hasJsPrint = true;
  }

  return {
    getSystemPrinters() {
      if (!jsPrintSetup) return ['dataprint'];
      return _.filter(jsPrintSetup.getPrintersList().split(','), printer => printer.match(/data.*print|POS-80/i));
    },

    setActivePrinter(printer) {
      $localStorage.set('jsPrinter', printer);
    },

    getActivePrinter() {
      const printer = $localStorage.get('jsPrinter');
      return printer || 'dataprint';
    },

    isJsPrintActive() {
      return hasJsPrint;
    },

    printElementById(elementId, autoPrint = true, customStyle = false) {
      if ($window.Cypress) return;
      const printer = this.getActivePrinter();
      const printContents = $window.document.getElementById(elementId).innerHTML;
      const origin = `${$location.protocol()}://${$location.host()}:${$location.port()}`;
      let frame1 = $window.document.createElement('iframe');
      frame1.name = 'frame1';
      frame1.style.position = 'absolute';
      frame1.style.top = '-1000000px';
      $window.document.body.appendChild(frame1);
      let frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
      frameDoc.document.open();
      frameDoc.document.write(`<!DOCTYPE html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-type" content="text/html;charset=UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <link rel="stylesheet" type="text/css" href="${origin}/lib/bootstrap/dist/css/bootstrap.css?ver=1111"/>
  <link rel="stylesheet" type="text/css" href="${origin}/modules/core/css/core.css?ver=1111"/>
  ${autoPrint ? `<link rel="stylesheet" type="text/css" href="${origin}/css/jsprint.css?ver=1111"/>` : ''}
  ${customStyle ? `<link rel="stylesheet" type="text/css" href="${origin}/css/custom/custom-jsprint.css"/>` : ''}
</head>
<body>
  <script type="text/javascript" src="${origin}/lib/jquery/dist/jquery.min.js?ver=1111"></script>
  ${printContents}
  <script>
  $(function(){
    if (window.jsPrintSetup && ${autoPrint === true}) {
      jsPrintSetup.setPrinter('${printer}')
      jsPrintSetup.definePaperSize(45, 45, 'vnm_receipt2', 'vnm_receipt_80mm', 'Receipt layout2', 80, 297, jsPrintSetup.kPaperSizeMillimeters)
      jsPrintSetup.setOption('orientation', jsPrintSetup.kPortraitOrientation);
      jsPrintSetup.setOption('paperData', 45);
      jsPrintSetup.setPaperSizeData(45)

      // set top margins in millimeters
      jsPrintSetup.setOption('marginTop', 0);
      jsPrintSetup.setOption('marginRight', 0);
      jsPrintSetup.setOption('marginLeft', 0);
      // jsPrintSetup.setOption('headerStrRight', '&PT');
      // set empty page footer
      jsPrintSetup.setOption('footerStrLeft', '');
      jsPrintSetup.setOption('footerStrRight', '');
      jsPrintSetup.setOption('footerStrCenter', '');

      jsPrintSetup.clearSilentPrint();

      // Suppress print dialog
      jsPrintSetup.setSilentPrint(true);/** Set silent printing */
      // Do Print

      // Restore print dialog
      jsPrintSetup.print();
    } else {
      setTimeout(function(){
        window.print()
      }, 1000)
    }
  })
  </script>
</body>
</html>`);
      frameDoc.document.close();
      return false;
    }

  };
}]);
"use strict";

