angular.module('core').filter('filterWorkDepartments', [function () {
  return function (workDepartments, viewValue, workDepartmentSearch) {
    const lowerCaseViewValue = viewValue.toLowerCase();

    const matchWorkDepartment = _.find(workDepartments, workDepartment => workDepartment.code.toLowerCase() === lowerCaseViewValue);

    if (matchWorkDepartment) {
      return [matchWorkDepartment];
    }

    if (workDepartmentSearch && viewValue !== workDepartmentSearch) {
      return _.filter(workDepartments, workDepartment => {
        return workDepartment.code.toLowerCase().includes(lowerCaseViewValue) || workDepartment.name.toLowerCase().includes(lowerCaseViewValue);
      });
    }

    return workDepartments;
  };
}]).directive('fhdWorkDepartmentInput', [function () {
  return {
    templateUrl: 'modules/core/templates/fhd-work-department-input.client.template.html',
    restrict: 'AE',
    scope: {
      workDepartment: '=?',
      labelColumn: '@',
      inputColumn: '@',
      noLabel: '=?',
      label: '@',
      onChange: '=?',
      breakpoint: '@'
    },
    controller: 'fhdWorkDepartmentInputController',
    controllerAs: 'vm',
    bindToController: true,

    link(scope, element) {
      const vm = scope.vm;

      if (vm.labelColumn) {
        const labelElm = element.find('label');
        const inputElm = element.find('fhd-controls');
        labelElm.addClass(`col-sm-${vm.labelColumn}`);
        inputElm.addClass(`col-sm-${12 - vm.labelColumn}`);
      }
    }

  };
}]).controller('fhdWorkDepartmentInputController', ['$scope', 'ObjectId', 'WorkDepartmentService', function ($scope, ObjectId, WorkDepartmentService) {
  const vm = this;
  const notSelected = '';
  vm.workDepartmentSearch = notSelected;
  vm.workDepartments = [];
  vm.workDepartment = vm.workDepartment || null;
  vm.getWorkDepartments = WorkDepartmentService.allAsync().then(workDepartments => {
    return workDepartments;
  });

  vm.handleRemove = () => {
    vm.workDepartment = null;
  };

  vm.selectWorkDepartment = item => {
    vm.workDepartment = item;
  };

  vm.getDefaultWorkPosition = () => {
    vm.getWorkDepartments.then(function (workDepartments) {
      vm.workDepartments = workDepartments;

      if (vm.workDepartments) {
        const matchWorkDepartment = _.find(workDepartments, {
          _id: ObjectId.getObjectId(vm.workDepartment)
        });

        if (matchWorkDepartment) {
          return matchWorkDepartment;
        }
      }
    }).then(workDepartment => {
      vm.workDepartment = workDepartment;
      if (workDepartment) vm.workPositionSearch = `${workDepartment.code} - ${workDepartment.name}`;
    });
  };

  $scope.$watch('vm.workDepartment', (newValue, oldValue) => {
    if (newValue === oldValue) return;

    if (!vm.workDepartment) {
      vm.workDepartmentSearch = notSelected;
    }

    if (vm.workDepartment) {
      vm.workDepartmentSearch = `${vm.workDepartment.code} - ${vm.workDepartment.name}`;
    }

    if (vm.onChange && vm.workDepartment) {
      vm.onChange(newValue);
    }
  });
}]);
