angular.module('application-forms').controller('ModalEliminateApplicationFormController', ['$modalInstance', 'applicationForm', 'Authentication', 'FhdMessenger', '$location', 'ApplicationFormService', 'UserService', function ($modalInstance, applicationForm, Authentication, FhdMessenger, $location, ApplicationFormService, UserService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.modal = $modalInstance;

  vm.dismiss = () => $modalInstance.dismiss();

  vm.close = () => $modalInstance.close();

  vm.applicationForm = applicationForm;
  vm.applicationFormId = vm.applicationForm.applicationFormId;
  vm.calculateSalaryTypes = UserService.getCalculateSalaryTypes();

  vm.init = () => {
    UserService.getUserInfo(applicationForm.cellphone).then(user => {
      if (user) {
        vm.staffUser = user;
      }
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.needNote = ['Lọc hồ sơ không đạt yêu cầu', 'Không qua vòng phỏng vấn', 'Không qua vòng học việc'];

  vm.eliminated = () => {
    if (_.isEmpty(vm.calculateSalaryType)) {
      return FhdMessenger.error('Chưa chọn phần trăm tính lương');
    }

    if (!vm.eliminatedContent) {
      return FhdMessenger.error('Chưa chọn cách thức lý do nghỉ');
    }

    if (vm.needNote.includes(vm.eliminatedContent) && !vm.note) {
      return FhdMessenger.error('Bạn hãy điền chi tiết lý do loại');
    }

    vm.waiting = true;
    ApplicationFormService.openSendEmailModal().result.then(sendEmail => {
      vm.applicationForm.sendEmail = sendEmail;
      vm.applicationForm.isCalculateSalary = vm.calculateSalaryType['isCalculateSalary'];
      vm.applicationForm.calculateSalaryPercent = vm.calculateSalaryType['wage'];
      vm.applicationForm.eliminatedContent = vm.eliminatedContent;
      vm.applicationForm.eliminatedNote = vm.note; // vm.applicationForm.shouldDeleteRecord = vm.shouldDeleteRecord

      vm.applicationForm.$eliminated().then(() => {
        FhdMessenger.success('Loại hồ sơ thành công');
        vm.close();
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('application-forms').controller('ModalInfoApplicationFormController', ['$modalInstance', 'applicationForm', 'Authentication', '$http', 'FhdMessenger', '$state', function ($modalInstance, applicationForm, Authentication, $http, FhdMessenger, $state) {
  const vm = this;
  vm.user = Authentication.user;
  vm.modal = $modalInstance;

  vm.dismiss = () => $modalInstance.dismiss();

  vm.archived = () => {
    if (!vm.applicationForm.content) {
      return FhdMessenger.error('Chưa nhập thông tin');
    }

    const applicationForm = vm.applicationForm;
    applicationForm.$updateInfo().then(applicationForm => {
      vm.applicationForm = applicationForm;
      FhdMessenger.success('Đã thêm thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.dismiss();
    });
  };

  vm.applicationForm = applicationForm;
  vm.applicationFormId = vm.applicationForm.applicationFormId;
}]);
