angular.module('outlet-reports').factory('OutletReportService', ['$modal', '$http', '$window', 'FhdMessenger', function ($modal, $http, $window, FhdMessenger) {
  const types = [{
    id: 'check-label',
    title: 'Tag giá'
  }, {
    id: 'update-stock',
    title: 'Cập nhật số tồn'
  }, {
    id: 'transfer',
    title: 'Chuyển hàng'
  }, {
    id: 'check-product',
    title: 'Sản phẩm'
  }, {
    id: 'check-date',
    title: 'Kiểm tra hạn'
  }, {
    id: 'transfer-product',
    title: 'Luân chuyển hàng hóa'
  }, {
    id: 'check-store',
    title: 'Hình ảnh cửa hàng'
  }, {
    id: 'checklist-entry',
    title: 'Checklist Entry'
  }, {
    id: 'other',
    title: 'Khác'
  }];

  function isInvalidProduct(product) {
    return !_.isNumber(product.quantity) || !_.get(product, 'problem');
  }

  function exportTable(vm) {
    vm.waiting = true;
    FhdMessenger.info('Đang tạo');
    let colNames = [20];
    colNames = ['STT', 'Cơ sở', 'SKU', 'Description', 'Số lượng', 'Vấn đề', 'Số lô', 'NSX', 'HSD', 'Done', 'Nhiệt độ bảo quản'];

    const items = _.get(vm, 'veboseProductsTable.data', []);

    if (!items.length) {
      return FhdMessenger.error('Chưa có data truyền vào');
    }

    const sheetData = [];

    _.forEach(items, (item, index) => {
      const productOulet = _.get(item, 'outlet.code', '');

      const productSku = _.get(item, 'product.sku', '');

      const productDescription = _.get(item, 'product.description', '');

      const productQuantity = _.get(item, 'product.quantity', '');

      const productProblem = _.get(item, 'product.problem', '');

      const productLotNumber = _.get(item, 'product.lotNumber', '');

      const productManufactureDate = _.get(item, 'product.manufactureDate', '') ? moment(_.get(item, 'product.manufactureDate', '')).format('YYYY/MM/DD') : '';
      const productExpiredDate = _.get(item, 'product.expiredDate', '') ? moment(_.get(item, 'product.expiredDate', '')).format('YYYY/MM/DD') : '';

      const doneBy = _.get(item, 'doneBy.code', '') + ' - ' + _.get(item, 'doneBy.displayName', '');

      const productHoldingTemperature = _.get(item, 'product.holdingTemperature', '');

      const row = [index + 1, productOulet, productSku, productDescription, productQuantity, productProblem, productLotNumber, productManufactureDate, productExpiredDate, doneBy, productHoldingTemperature];
      sheetData.push(row);
    });

    $http.post('/sheet', {
      sheetData: sheetData,
      sheetTitle: `${vm.outletReport.title} - xuất dữ liệu lúc ${moment().format('DD/MM MM:hh')}`,
      sheetCols: colNames
    }).then(res => {
      vm.linkGoogleSheet = `https://docs.google.com/spreadsheets/d/${res.data.data.spreadsheetId}`;
      $window.open(vm.linkGoogleSheet);
      FhdMessenger.success('Đã tạo thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }

  function shouldInputDate(product) {
    if (product.quantity === 0) {
      return false;
    }

    const productDetail = product.product;
    return (_.get(productDetail, 'category.department.name', '') === 'Nguyên liệu làm bánh' || _.get(productDetail, 'category.group.name', '') === 'FOOD') && (!product.manufactureDate || !product.expiredDate);
  }

  function shouldInputLotNumber(product) {
    if (product.quantity === 0) {
      return false;
    }

    const productDetail = product.product;
    return _.get(productDetail, 'privateLabel') && !product.lotNumber;
  }

  function shouldInputHoldingTemperature(product) {
    if (product.quantity === 0) {
      return false;
    }

    const productDetail = product.product;

    const warehouseGroupProduct = _.get(productDetail, 'warehouseGroup', {});

    return (_.get(warehouseGroupProduct, 'name') === 'Tủ đông' || _.get(warehouseGroupProduct, 'name') === 'Tủ mát') && (_.isUndefined(product.holdingTemperature) || _.isNull(product.holdingTemperature));
  }

  return {
    validateCreateOutletReport(outletReport) {
      if (!_.get(outletReport, 'type')) {
        return 'Bạn chưa chọn kiểu outlet report';
      }

      if (!_.get(outletReport, 'title')) {
        return 'Bạn chưa nhập tiêu đề';
      }

      if (!_.get(outletReport, 'description')) {
        return 'Bạn chưa nhập mô tả';
      }

      if (!_.get(outletReport, 'deadline')) {
        return 'Bạn chưa nhập deadline';
      }

      if (!_.get(outletReport, 'outlets.length')) {
        return 'Bạn chưa chọn một cơ sở nào để gửi';
      }

      if (_.get(outletReport, 'type') === 'check-product' && !_.get(outletReport, 'products.length')) {
        return 'Bạn chưa chọn sản phẩm cơ sở cần kiểm tra';
      }
    },

    validateDoneOutletReport(outletReport) {
      const products = _.get(outletReport, 'products');

      if (_.get(outletReport, 'type') === 'check-product') {
        if (_.some(products, isInvalidProduct)) {
          return 'Cần nhập đủ thông tin vấn đề và số lượng cho mỗi sản phẩm';
        }

        if (_.some(products, shouldInputDate)) {
          return 'Bạn cần nhập NSX và HSD những hàng FOOD';
        }

        if (_.some(products, shouldInputHoldingTemperature)) {
          return 'Bạn cần nhập nhiệt độ bảo quản với những hàng lạnh';
        }

        if (_.some(products, shouldInputLotNumber)) {
          return 'Bạn cần nhập số lô với những hàng PL';
        }
      }

      if (outletReport.needImages && !_.get(outletReport, 'reportImages.length', 0)) {
        if (!_.get(products, 'length')) {
          return 'Bạn chưa điền ảnh';
        } else if (_.some(products, product => {
          return product.quantity > 0;
        })) {
          return 'Bạn chưa điền ảnh';
        }
      }

      if (outletReport.checklistEntry && !outletReport.result) {
        return 'Bạn chưa điền kết quả xử lý';
      }

      if (['update-stock', 'check-label'].includes(outletReport.type) && outletReport.saleCode && _.some(outletReport.products, product => !_.isNumber(product.quantity))) {
        return 'Bạn chưa điền số lượng tồn thực tế';
      }
    },

    getTypes() {
      return types;
    },

    openSummarizeOutletReportModal(outletReport) {
      return $modal.open({
        templateUrl: '/modules/outlet-reports/views/modal-summarize-outlet-reports.client.view.html',
        controller: 'ModalSummarizeOutletReportController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          outletReport: () => outletReport
        }
      }).result;
    },

    openCreateOutletReportModal(data) {
      return $modal.open({
        templateUrl: '/modules/outlet-reports/views/modal-create-outlet-report.client.view.html',
        controller: 'ModalCreateOutletReportController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          data: () => data
        }
      }).result;
    },

    summarize({
      startDate = moment().subtract(1, 'w').toDate(),
      endDate = moment().toDate(),
      statuses,
      outlets
    }) {
      return $http.get('/outlet-reports/summarzie', {
        params: {
          startDate,
          endDate,
          statuses,
          outlets
        }
      }).then(({
        data
      }) => data);
    },

    convertRegionToZone(codeRegion) {
      switch (codeRegion) {
        case 'NORTH':
          return 'HN';

        case 'SOUTH':
          return 'HCM';

        default:
          return 'Khác';
      }
    },

    exportTable
  };
}]);
"use strict";

angular.module('outlet-reports').factory('OutletReports', ['$resource', function ($resource) {
  return $resource('outlet-reports/:outletReportId', {
    outletReportId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    done: {
      url: 'outlet-reports/:outletReportId/done',
      method: 'PUT'
    },
    addNote: {
      url: 'outlet-reports/:outletReportId/add-note',
      method: 'PUT'
    },
    changeDeadline: {
      url: 'outlet-reports/:outletReportId/change-deadline',
      method: 'PUT'
    },
    markFailed: {
      url: 'outlet-reports/:outletReportId/mark-failed',
      method: 'PUT'
    },
    getCreated: {
      url: 'outlet-reports/created',
      method: 'GET',
      isArray: true
    },
    createForSaleCodes: {
      url: 'outlet-reports/create-for-sale-codes',
      method: 'POST',
      isArray: true
    },
    getOutletReportNotDone: {
      url: 'outlet-reports/not-done',
      method: 'GET',
      isArray: true
    }
  });
}]);
