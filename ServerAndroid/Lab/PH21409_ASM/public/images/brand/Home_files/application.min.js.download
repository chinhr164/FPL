      disabled: '=?',
      notBuying: '=?',
      disableHandmade: '=?',
      disableForceScanBarcode: '=?',
      imageDirection: '@',
      privateLabel: '=?',
      needShiftLogin: '=?',
      filterByCurrentShift: '=?',
      stockControl: '=?',
      savor: '=?',
      abby: '=?',
      allowDisabledSaleCode: '=?',
      required: '@'
    },

    link(scope, element) {
      if (scope.labelColumn) {
        const labelElm = element.find('label');
        const inputElm = element.find('fhd-controls');
        labelElm.addClass(`col-sm-${scope.labelColumn}`);
        inputElm.addClass(`col-sm-${12 - scope.labelColumn}`);
      }

      hotkeys.add({
        combo: 'f2',
        allowIn: ['INPUT'],
        description: 'Tìm đến ô nhập sản phẩm',
        callback: function () {
          var elm = _.head(element.find('input'));

          elm.focus();
          elm.select();
        }
      });
    },

    controller: 'FhdProductInputController',
    controllerAs: 'vm',
    replace: true
  };
}]).controller('FhdProductInputController', ['$scope', '$http', '$modal', 'helper', 'ProductService', 'FhdMessenger', 'SlugService', 'CurrentShift', 'Authentication', 'SaleCodes', 'NumberService', 'PlTasks', '$q', 'ObjectId', function ($scope, $http, $modal, helper, ProductService, FhdMessenger, SlugService, CurrentShift, Authentication, SaleCodes, NumberService, PlTasks, $q, ObjectId) {
  const vm = this;
  vm.data = {
    disabled: true
  };
  vm.allowImportData = $scope.allowImportData;
  vm.needShiftLogin = _.isUndefined($scope.needShiftLogin) ? false : $scope.needShiftLogin;
  vm.savor = $scope.savor === 'true' || $scope.savor === true;
  vm.abby = $scope.abby === 'true' || $scope.abby === true;
  vm.typeAheadProducts = [];
  vm.items = [];
  vm.importProducts = $scope.importProducts;
  const noteForBuying = '. Nếu load lại web vẫn không được vui lòng liên hệ team Buying để xử lý nhé';

  if ($scope.imageDirection === 'right') {
    vm.direction = 'right';
  } else {
    vm.direction = 'left';
  }

  const user = _.get(Authentication, 'user');

  const roles = _.get(user, 'roles');

  const outletCode = _.get(CurrentShift.getCurrentShift(), 'outlet.code');

  const outlet = _.get(CurrentShift.getCurrentShift(), 'outlet', _.get(user, 'outlet'));

  const loadProducts = function (err, products) {
    if (err) return FhdMessenger.errorFromServer(err);
    vm.data.products = products;

    if ($scope.privateLabel === 'true' || $scope.privateLabel === true) {
      vm.data.products = _.filter(vm.data.products, {
        privateLabel: true
      });
    } // Hide NOOS when explicitly set false


    if ($scope.noos === 'false' || $scope.noos === false) {
      vm.data.products = _.reject(vm.data.products, {
        noos: true
      });
    } // Hide autRestock when explicitly set false


    if ($scope.autoRestock === 'false' || $scope.autoRestock === false) {
      vm.data.products = _.reject(vm.data.products, {
        autoRestock: true
      });
    }

    if ($scope.isRaw === 'true' || $scope.isRaw === true) {
      vm.data.products = _.filter(vm.data.products, product => product.isRaw);
    }

    if ($scope.isTool === 'true' || $scope.isTool === true) {
      vm.data.products = _.filter(vm.data.products, product => {
        return product.productType === 'tool';
      });
    }

    if ($scope.isLabel === 'true' || $scope.isLabel === true) {
      vm.data.products = _.filter(vm.data.products, product => {
        return product.productType === 'label';
      });
    }

    if ($scope.isWrapper === 'true' || $scope.isWrapper === true) {
      vm.data.products = _.filter(vm.data.products, product => {
        return product.productType === 'wrapper';
      });
    }

    if ($scope.isVendorProduct === 'true' || $scope.isVendorProduct === true) {
      vm.data.products = _.filter(vm.data.products, product => {
        return product.productType === 'vendorProduct';
      });
    }

    if ($scope.disableHandmade === 'true' || $scope.disableHandmade === true) {
      vm.data.products = _.filter(vm.data.products, product => product.sku.match(/^([BTVLBZW]|LB)\d+/));
    }

    if ($scope.stockControl === 'true' || $scope.stockControl === true) {
      vm.data.products = _.reject(vm.data.products, product => {
        return product.stockControl === false;
      });
    }

    if (vm.savor) {
      vm.data.products = _.filter(vm.data.products, product => {
        return product.sku.match(/V\d+/);
      });
    } else if (vm.abby) {
      vm.data.products = _.filter(vm.data.products, product => {
        return product.sku.match(/B\d+/) || _.get(product, 'category.cat.name') === 'Bánh kẹo Tết';
      });
    } else if ($scope.filterByCurrentShift && outletCode) {
      if (outletCode.match(/[SK]\d+/)) {
        vm.data.products = _.filter(vm.data.products, product => {
          return product.sku.match(/[VZ]\d+/);
        });
      }

      if (outletCode.match(/[B]\d+/)) {
        vm.data.products = _.filter(vm.data.products, product => {
          return product.sku.match(/([VZ]|LB)\d+/);
        });
      }

      if (outletCode.match(/([MDE]\d+|SHIP|MKT|KHO)/) && !['E18'].includes(outletCode)) {
        vm.data.products = _.filter(vm.data.products, product => {
          return product.sku.match(/([BZW]|LB)\d+/) || _.get(product, 'category.cat.name') === 'Bánh kẹo Tết';
        });
      }

      if (outletCode.match(/([G]\d+)/)) {
        vm.data.products = _.filter(vm.data.products, product => {
          return product.sku.match(/([BZWR]|LB)\d+/);
        });
      }
    }

    vm.data.disabled = false;
    return _.map(vm.data.products, product => {
      const salePrice = ProductService.getOutletProperty('salePrice', outlet, product);
      const price = ProductService.getOutletProperty('price', outlet, product);
      product.fullDescription = `${product.sku} - ${product.description} - ${NumberService.numberWithCommas(salePrice || price || 0, 0)}đ${product.barcode ? ` - ${product.barcode}` : ''}`;
      return product;
    });
  };

  function init() {
    if ($scope.includeDeleted) {
      return ProductService.getIncludeDeletedProductsFromServer().then(products => loadProducts(null, products));
    }

    if ($scope.all) {
      return ProductService.getAllProductsFromServer().then(products => loadProducts(null, products));
    }

    return ProductService.getAllSellingProductsFromServer().then(products => {
      loadProducts(null, products);
    });
  }

  init();

  function needScanBarcode(product) {
    return product.forceScanBarcode && !$scope.disableForceScanBarcode && !_.includes(roles, 'admin');
  }

  function processSaleCode(searchString) {
    const query = SaleCodes.search({
      saleCodeId: searchString
    }).$promise;
    FhdMessenger.notifyLoading('Đang tải mã sale...', query, () => {
      FhdMessenger.success('Tải xong.');
    });
    query.then(result => {
      vm.productSearch = '';

      if (!result || !result.saleCode) {
        FhdMessenger.error(`Không tìm thấy mã sale code ${searchString}.`);
        return;
      }

      const saleCode = result.saleCode;

      if ($scope.allowDisabledSaleCode) {
        if (saleCode.status === 'disabled' && moment().diff(moment(saleCode.disabled), 'day') > 5) {
          return FhdMessenger.error(`Mã Sale Code đã bị khóa`);
        }
      } else if (saleCode.status === 'disabled') {
        return FhdMessenger.error(`Mã Sale Code đã bị khóa`);
      }

      if (saleCode.status === 'pending') {
        FhdMessenger.error(`Mã Sale Code đang chờ duyệt`);
        return;
      }

      const matchProduct = _.find(vm.data.products, {
        _id: saleCode.product
      });

      if (!matchProduct) {
        FhdMessenger.error(`Không tìm thấy sản phẩm cho sku ${saleCode.sku}`);
        return;
      }

      if (saleCode.outletExclusive) {
        const outlet = _.get(CurrentShift.getCurrentShift(), 'outlet', _.get(user, 'outlet'));

        const managingOutletIds = _.map(user.managingOutlets, ObjectId.getObjectId).concat([ObjectId.getObjectId(outlet)]);

        if (!helper.getIntersectionObjectIds(saleCode.outlets, managingOutletIds).length && _.get(outlet, 'code').match(/[ME]\d+/)) {
          return FhdMessenger.error(`Cơ sở không được bán mã giảm giá này`);
        }
      }

      if (saleCode.startDate) {
        const now = moment();
        const startDate = moment(saleCode.startDate);

        if (startDate.isAfter(now)) {
          FhdMessenger.error(`Mã Sale Code chưa đến thời hạn sử dụng`);
          return;
        }
      }

      if (saleCode.endDate) {
        const now = moment();
        const endDate = moment(saleCode.endDate);

        if (endDate.isBefore(now)) {
          FhdMessenger.error(`Mã Sale Code đã hết thời hạn sử dụng`);
          return;
        }
      }

      if (saleCode.quantity <= 0) {
        FhdMessenger.error('Mã sale này đã được sử dụng hết số lượng.');
        return;
      }

      const saleCodePrice = saleCode.salePrice;

      let price = _.get(matchProduct, 'price');

      let salePrice = _.get(matchProduct, 'salePrice');

      if (saleCodePrice > price || _.isNumber(salePrice) && saleCodePrice > salePrice) {
        return FhdMessenger.error(`Sản phẩm ${matchProduct.sku} - SC:${saleCode.saleCodeId} có giá giảm lớn hơn giá bán. Vui lòng liên hệ team Logistics để được xử lý`);
      }

      let quantity;
      let quantityFromBarcode;

      if (matchProduct.disableInputQuantity) {
        quantity = saleCode.quantity;
        quantityFromBarcode = true;
        FhdMessenger.info(`Sản phẩm ${matchProduct.sku} - SC:${saleCode.saleCodeId} là sản phẩm có số lượng được nhập tự động từ sale code. Bạn vui lòng kiểm tra lại số lượng nhé`);
      }

      const newProduct = _.assign({}, matchProduct, {
        refId: saleCode._id,
        salePrice: saleCode.salePrice,
        saleCode: saleCode._id,
        saleCodeObject: saleCode,
        expiryDate: saleCode.expiryDate,
        quantity,
        quantityFromBarcode,
        noLoyalty: true
      });

      vm.productSearchSelected(newProduct);
    });
  }

  function processPlTask(plTaskId, sku) {
    const result = {
      plTask: {
        sku,
        plTaskId
      }
    };
    addProductFromPLTask(result, plTaskId, sku); // const query = $http.get('https://work.4-handy.com/pl-tasks/search', {
    //   params: { plTaskId },
    // })
    // FhdMessenger.notifyLoading('Đang tải PL Task...', query, () => {
    //   FhdMessenger.success('Tải xong PL Task.')
    // })
    // query
    //   .then((res) => {
    //     const result = res.data
    //     addProductFromPLTask(result, plTaskId, sku)
    //   })
    //   .catch((error) => {
    //     const newQuery = PlTasks.search({ plTaskId }).$promise
    //     newQuery.then((result) => {
    //       addProductFromPLTask(result, plTaskId, sku)
    //     })
    //     return error
    //   })
  }

  function addProductFromPLTask(result, plTaskId, sku) {
    vm.productSearch = '';

    if (!_.get(result, 'plTask', '')) {
      return FhdMessenger.error(`Không tìm thấy Pl Task ${plTaskId}.`);
    }

    const plTask = result.plTask;

    if (plTask.sku !== sku) {
      return FhdMessenger.error(`Mã sản phẩm trên bao bì là ${sku} khác mã sản phẩm trong PL Task tương ứng là ${plTask.sku}`);
    }

    const matchProduct = _.find(vm.data.products, {
      sku: plTask.sku
    });

    if (!matchProduct) {
      return FhdMessenger.error(`Không tìm thấy sản phẩm cho sku ${plTask.sku}` + noteForBuying);
    }

    const newProduct = _.assign({}, matchProduct, {
      // refId: plTask._id,
      // plTask: plTask._id,
      plTaskId,
      expiryDate: plTask.confirmExpiryDate
    });

    vm.productSearchSelected(newProduct);
  }

  vm.productKeyUp = _.debounce(function ($event) {
    if ($event.keyCode !== 13) return;
    let searchString = vm.productSearch;
    const matchWithSaleCodeId = searchString.match(/^S\d{8}$/);

    if (searchString && matchWithSaleCodeId) {
      vm.typeAheadProducts = [];
      return;
    }

    const matchWithSkuAndTaskId = searchString.match(/^([A-Z]\d{1,})L(\d{1,})$/);

    if (searchString && matchWithSkuAndTaskId) {
      vm.typeAheadProducts = [];
      const sku = matchWithSkuAndTaskId[1];
      const plTaskId = parseInt(matchWithSkuAndTaskId[2]);
      processPlTask(plTaskId, sku);
      return;
    }

    if (searchString && searchString.match(/^0240\d{9}$/)) {
      const parts = searchString.match(/0240(\d{4})(\d{4})\d/);
      const sku = `B${parts[2]}`;
      const weight = parseInt(parts[1]) / 100;

      const matchProduct = _.find(vm.data.products, {
        sku
      });

      if (!matchProduct) {
        FhdMessenger.errorStick(`Không tìm thấy mã ${sku}` + noteForBuying);
        return;
      }

      const clone = _.assign({}, matchProduct, {
        quantity: weight,
        quantityFromBarcode: true
      });

      vm.productSearch = '';
      vm.productSearchSelected(clone);
      return;
    }

    if (searchString && searchString.match(/^25\d{11}$/)) {
      const parts = searchString.match(/25(\d{6})(\d{4})\d/);
      const sku = `B${parts[2]}`;
      const date = moment(parts[1], 'DDMMYY');

      const matchProduct = _.find(vm.data.products, {
        sku
      });

      if (!matchProduct) {
        FhdMessenger.errorStick(`Không tìm thấy mã ${sku}` + noteForBuying);
        return;
      }

      const clone = _.assign({}, matchProduct, {
        refId: `${sku}E${date.format('DDMMYY')}`,
        expiryDate: date.format('YYYY-MM-DD')
      });

      vm.productSearch = '';
      vm.productSearchSelected(clone);
      return;
    }

    vm.productSearch = '';
    if (!searchString) return;
    if (_.isString(searchString)) searchString = searchString.toUpperCase().trim();

    const matchProduct = _.find(vm.data.products, function (product) {
      const sku = product.sku ? product.sku.toString().toUpperCase() : null;
      const oldSku = product.oldSku ? product.oldSku.toString().toUpperCase() : null;

      if (needScanBarcode(product)) {
        if (vm.barcodesCompare(product.barcodes, searchString)) {
          return true;
        }

        if (_.some(product.barcodes)) {
          if (product.sku === searchString) {
            FhdMessenger.error(`${product.sku} ${product.description} bắt buộc nhập mã NSX hoặc mã Abby nếu không có mã NSX.`);
          }

          return false;
        } else {
          return sku === searchString;
        }
      }

      return sku === searchString || oldSku === searchString || vm.barcodesCompare(product.barcodes, searchString);
    });

    if (matchProduct) {
      vm.productSearchSelected(matchProduct);
    } else {
      FhdMessenger.errorStick(`Không vào được đơn hàng mã ${searchString}` + noteForBuying);
    }
  }, 300);
  vm.productSearchChanged = _.debounce(function () {
    if (!vm.productSearch) {
      return;
    }

    let text = vm.productSearch; // Return if user only type in 1 character or less

    if (!text || text.length <= 1) return;
    const matchWithSkuAndTaskId = text.match(/^([A-Z]\d{1,})L(\d{1,})$/);

    if (text && matchWithSkuAndTaskId) {
      vm.typeAheadProducts = [];
      return;
    }

    if (text && text.match(/^S\d{8}$/)) {
      return processSaleCode(text);
    }

    const disableSearch = _.intersection(roles, ['sale', 'kho']).length && (!outletCode || outletCode.match(/[ME]\d+/));

    if ((text || '').match(/^\s*T?B\d{4}\s*$/)) {
      vm.typeAheadProducts = _.filter(vm.data.products, product => {
        if (needScanBarcode(product)) {
          if (_.some(product.barcodes)) return vm.barcodesCompare(product.barcodes, text);
          return product.sku === text.toString().toUpperCase().trim();
        }

        return _.includes(product.sku, text);
      });
      return;
    }

    if ((text || '').match(/^\d{4}$/)) {
      const sku = `B${text}`;
      vm.typeAheadProducts = _.filter(vm.data.products, product => {
        if (needScanBarcode(product)) return false;
        return product.sku === sku;
      });
      return;
    }

    if (disableSearch && !$scope.enableSearch) {
      if (text && text.match(/^[ABJSPFCZ]\d{4}/i)) {
        if (_.isString(text)) text = text.toUpperCase().trim();

        const toString = str => {
          return str ? str.toString() : str;
        };

        const matchProduct = _.find(vm.data.products, function (product) {
          return toString(product.sku) === text || toString(product.oldSku) === text || toString(product.barcode) === text || vm.barcodesCompare(product.barcodes, text);
        });

        if (matchProduct) {
          if (needScanBarcode(matchProduct) && _.some(matchProduct.barcodes)) {
            FhdMessenger.error(`Mã ${$scope.productSearch} bắt buộc nhập mã vạch NSX hoặc mã Abby nếu không có mã NSX.`);
            vm.productSearch = '';
            return;
          }

          vm.productSearchSelected(matchProduct);
          vm.productSearch = '';
        } else if (vm.productSearch) {
          FhdMessenger.errorStick(`Không nhập được mã ${vm.productSearch}` + noteForBuying);
          vm.productSearch = '';
        }
      }
    }

    const productLatinDescription = SlugService.getSlug(vm.productSearch).trim();
    const elements = productLatinDescription.split(' ');

    let products = _(vm.data.products).map(product => {
      const sku = (product.sku || '').toString().toLowerCase();

      if (needScanBarcode(product)) {
        if (vm.barcodesCompare(product.barcodes, productLatinDescription)) {
          return _.assign({}, product, {
            score: _.get(productLatinDescription, 'length', 0) * 10
          });
        }

        if (!_.some(product.barcodes) && sku === productLatinDescription) {
          return _.assign({}, product, {
            score: _.get(productLatinDescription, 'length', 0) * 10
          });
        }

        return _.assign({}, product, {
          score: 0
        });
      }

      let score = _.sumBy(elements, elm => {
        return _.includes(product.latinDescription, elm) ? elm.length : 0;
      });

      if (_.includes(product.latinDescription, productLatinDescription)) {
        score += productLatinDescription.length;
      }

      if (_.includes(sku, productLatinDescription)) {
        score += productLatinDescription.length * 4;
      }

      _.some(product.barcodes, barcode => {
        if (_.includes(barcode, productLatinDescription)) {
          score += productLatinDescription.length * 3;
          return true;
        }
      });

      return _.assign({}, product, {
        score
      });
    }).filter(product => product.score > 0).sortBy(product => -product.score).value(); // Hide notBuying when explicitly set false


    if ($scope.notBuying === 'false' || $scope.notBuying === false) {
      products = _.reject(products, {
        notBuying: true
      });
    }

    if (disableSearch && !$scope.enableSearch) {
      products = _.filter(products, product => {
        return product.sku.match(/^[SJAPFZ]/i) || product.allowSearching;
      });
    }

    vm.typeAheadProducts = products;
  }, 300);

  vm.productSearchSelected = function (item) {
    if ((vm.needShiftLogin === true || vm.needShiftLogin === 'true') && !outletCode && !_.includes(roles, 'admin')) {
      return FhdMessenger.error('Đăng nhập để có thể quét mã nhé');
    } // Cho phép quét mã bơ peerless 100g khi có mã combo nougat B4966


    const permittedItems = _.cloneDeep($scope.permittedItems);

    if (_.get($scope, 'permittedItems.length')) {
      // Cho phép quét mã thành phần khi có mã combo
      const comboProducts = [{
        sku: 'B4966',
        description: 'Combo Nougat',
        extraProducts: [{
          sku: 'B4976',
          description: 'Bơ nhạt Peerless Úc 100g',
          factor: 1
        }]
      }, {
        sku: 'B8555',
        description: 'Combo bánh mì hoa cúc',
        extraProducts: [{
          sku: 'B4976',
          description: 'Bơ nhạt Peerless Úc 100g',
          factor: 1
        }]
      }];

      _.forEach(comboProducts, comboProduct => {
        const comboItem = _.find(permittedItems, {
          sku: comboProduct.sku
        });

        if (comboItem) {
          _.forEach(comboItem.extraProducts, extraProduct => {
            permittedItems.push({
              sku: extraProduct.sku,
              description: extraProduct.description,
              quantity: comboItem.quantity * extraProduct.fator
            });
          });
        }
      }); // Kiểm tra xem có trong online order không


      if (!_.some(permittedItems, permittedItem => {
        return item.sku === permittedItem.sku;
      })) {
        return FhdMessenger.errorStick(`${item.sku} - ${item.description} không có trong danh sách yêu cầu`);
      }
    }

    let newItem = {};
    newItem = _.assign({}, item, {
      product: item._id,
      quantity: _.isNumber(item.quantity) ? item.quantity : 1,
      originalPrice: item.price,
      salePrice: item.salePrice,
      soldPrice: item.salePrice ? item.salePrice : item.price,
      lineTotal: item.salePrice ? item.salePrice : item.price
    });
    if (!newItem.refId) newItem.refId = item.sku;
    $scope.product = newItem;
    vm.productSearch = '';
    vm.typeAheadProducts = [];
  };

  if ($scope.onChange) {
    $scope.$watch(() => $scope.product, (newValue, oldValue) => {
      if (newValue !== oldValue && newValue) {
        if ($scope.pushArray) {
          $scope.onChange($scope.product, $scope.pushArray);
        } else {
          $scope.onChange($scope.product);
        }

        vm.typeAheadProducts = [];
      }
    });
  }

  vm.barcodesCompare = function (barcodes, searchString) {
    return _.some(barcodes, barcode => {
      const code = barcode ? barcode.toString().toUpperCase().trim() : null;
      const text = searchString ? searchString.toString().toUpperCase().trim() : null;

      if (code === text) {
        return true;
      }

      return false;
    });
  };

  vm.showPopover = function (imageLink) {
    vm.imageLink = imageLink;
  };

  vm.hidePopover = function () {
    vm.imageLink = null;
  };

  vm.openModalImportCSV = () => {
    $modal.open({
      animation: true,
      controller: 'ModalImportCSVController',
      controllerAs: 'vm',
      size: 'lg',
      templateUrl: '/modules/products/views/modal-import-csv.client.view.html',
      resolve: {
        products: function () {
          return vm.products;
        }
      }
    }).result.then(function (products) {
      _.forEach(products, product => {
        $scope.onChange(product);
      });
    });
  };
}]);
"use strict";

angular.module('products').directive('fhdStockHistory', [function () {
  return {
    restrict: 'AE',
    scope: {
      sku: '=',
      outletCode: '='
    },
    templateUrl: 'modules/products/templates/fhd-stock-history.client.template.html',
    controllerAs: 'vm',
    controller: ['$scope', 'ProductStockHistoryService', function ($scope, ProductStockHistoryService) {
      const vm = this;
      vm.sku = $scope.sku;
      vm.outletCode = $scope.outletCode;
      vm.data = {
        dataPoints: []
      };
      vm.enoughInfo = vm.outletCode && vm.sku;

      vm.trackStockHistory = () => {
        ProductStockHistoryService.trackStockHistory({
          sku: vm.sku,
          outletCode: vm.outletCode
        }).then(dataPoints => {
          vm.data.dataPoints = dataPoints;
        });
      };

      if (vm.outletCode && vm.sku) {
        vm.trackStockHistory();
      }
    }]
  };
}]);
