    templateUrl: 'modules/competition-products/views/list-competition-products.client.view.html',
    resolve: {
      $title: _.constant('CompetitionProducts')
    }
  });
}]);
"use strict";

angular.module('competition-products').controller('CompetitionProductsController', ['CompetitionProducts', 'NgTableParams', 'FhdMessenger', function (CompetitionProducts, NgTableParams, FhdMessenger) {
  const vm = this;
  vm.competitionProductsTable = new NgTableParams();

  vm.find = () => {
    vm.competitionProducts = CompetitionProducts.query();
    let promise = vm.competitionProducts.$promise.then(() => {
      _.forEach(vm.competitionProducts, product => {
        if (angular.isArray(product.inStockLocations)) {
          product.locations = product.inStockLocations.join(', ');
        }
      });

      vm.competitionProductsTable.settings({
        dataset: vm.competitionProducts
      });
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong!');
    });
  };
}]);
