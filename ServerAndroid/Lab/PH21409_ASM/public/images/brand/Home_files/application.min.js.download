angular.module('thumb-up-budgets').controller('ThumbUpBudgetsController', ['$state', 'Authentication', 'ThumbUpBudgets', 'ThumbUpBudgetsService', 'NgTableParams', 'FhdMessenger', '$stateParams', '$location', '$filter', function ($state, Authentication, ThumbUpBudgets, ThumbUpBudgetsService, NgTableParams, FhdMessenger, $stateParams, $location, $filter) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.staffs = [];

  vm.init = () => {
    vm.startDate = moment().subtract(1, 'month').startOf('month').format('YYYY-MM-DD');
    vm.endDate = moment().endOf('month').format('YYYY-MM-DD');
  };

  vm.clearInput = function () {
    vm.inputStaffs = null;
  };

  vm.removeStaff = index => {
    vm.staffs.splice(index, 1);
  };

  vm.thumbUpBudgetsTable = new NgTableParams();

  function normalValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${_.get(row, vm.field) || ''}</span>`;
  }

  function normalDateValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${moment(_.get(row, vm.field)).format('YYYY-MM-DD') || ''}</span>`;
  }

  function normalAmountValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${$filter('number')(_.get(row, vm.field), 0) || ''}</span>`;
  }

  const getStaffDisplayName = ($scope, row) => `<a href="/#!/thumb-up-budgets/{{ row._id }}">${row.staff.displayName}</a>`;

  const getAction = ($scope, row) => `<a href="/#!/thumb-up-budgets/${row._id}/edit" ng-if="vm.user.roles.includes('thumb-up-budget:edit')" target="_blank"> Edit </a>`;

  defineTableCols();

  async function defineTableCols() {
    vm.cols = [{
      field: 'created',
      title: 'Ngày tạo',
      show: true,
      width: '10%',
      sortable: 'created',
      getValue: normalDateValue
    }, {
      field: 'staff.code',
      title: 'Mã NV',
      sortable: 'staff.code',
      show: true,
      width: '5%',
      filter: {
        'staff.code': 'text'
      },
      getValue: normalValue
    }, {
      field: 'staff.displayName',
      title: 'Tên NV',
      sortable: 'staff.displayName',
      show: true,
      width: '15%',
      filter: {
        'staff.displayName': 'text'
      },
      getValue: getStaffDisplayName
    }, {
      field: 'staff.outlet.code',
      title: 'Cơ sở',
      sortable: 'staff.outlet.code',
      show: true,
      width: '10%',
      filter: {
        'staff.outlet.code': 'text'
      },
      getValue: normalValue
    }, {
      field: 'startDate',
      title: 'Bắt đầu',
      sortable: 'startDate',
      show: true,
      width: '10%',
      getValue: normalDateValue
    }, {
      field: 'endDate',
      title: 'Kết thúc',
      sortable: 'endDate',
      show: true,
      width: '10%',
      getValue: normalDateValue
    }, {
      field: 'name',
      title: 'Nội dung',
      sortable: 'name',
      show: true,
      width: '25%',
      filter: {
        name: 'text'
      },
      getValue: normalValue
    }, {
      field: 'originalAmount',
      title: 'Giá trị',
      show: true,
      width: '10%',
      getValue: normalAmountValue
    }, {
      field: 'amount',
      title: 'Còn lại',
      show: true,
      width: '10%',
      getValue: normalAmountValue
    }, {
      field: 'user.displayName',
      title: 'Người gửi',
      sortable: 'user.displayName',
      show: true,
      width: '10%',
      filter: {
        'user.displayName': 'text'
      },
      getValue: normalValue
    }, {
      field: 'action',
      title: 'Action',
      show: true,
      width: '5%',
      getValue: getAction
    }];
  } // Find a list of Thumb ups


  vm.find = function () {
    vm.thumbUpBudgets = ThumbUpBudgets.query({
      startDate: vm.startDate,
      endDate: vm.endDate
    });
    vm.thumbUpBudgets.$promise.then(() => {
      vm.thumbUpBudgetsTable.settings({
        dataset: vm.thumbUpBudgets
      });
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.import = function () {
    if (_.some(vm.thumbUpBudgets, thumbUpBudget => {
      return !thumbUpBudget.staffCode;
    })) {
      return FhdMessenger.error('Có dòng điền thiếu mã nhân viên. Bạn kiểm tra lại nhé');
    }

    if (_.some(vm.thumbUpBudgets, thumbUpBudget => {
      return !thumbUpBudget.startDate || !thumbUpBudget.endDate;
    })) {
      return FhdMessenger.error('Có dòng điền ngày bắt đầu và kết thúc. Bạn kiểm tra lại nhé');
    }

    if (_.some(vm.thumbUpBudgets, thumbUpBudget => {
      return !thumbUpBudget.name;
    })) {
      return FhdMessenger.error('Có dòng điền thiếu tên. Bạn kiểm tra lại nhé');
    }

    if (_.some(vm.thumbUpBudgets, thumbUpBudget => {
      return !thumbUpBudget.amount;
    })) {
      return FhdMessenger.error('Có dòng điền thiếu giá trị Thumb Up. Bạn kiểm tra lại nhé');
    }

    vm.waiting = true;
    ThumbUpBudgetsService.import(vm.thumbUpBudgets).then(thumbUpBudgets => {
      FhdMessenger.success('Import thành công');
      $state.go('listThumbUpBudgets');
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = function () {
    vm.thumbUpBudget = ThumbUpBudgets.get({
      thumbUpBudgetId: $stateParams.thumbUpBudgetId
    });
  };

  vm.remove = function () {
    vm.thumbUpBudget.$remove(function () {
      $location.path('thumb-up-budgets');
    });
  };

  vm.update = function () {
    const thumbUpBudget = vm.thumbUpBudget;
    vm.waiting = true;
    thumbUpBudget.$update().then(res => {
      $location.path(`thumb-up-budgets/${thumbUpBudget._id}`);
    }).catch(errorResponse => {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('thumb-up-budgets').filter('filterThumbUpBudgets', [function () {
  return function (thumbUpBudgets, viewValue, thumbUpBudgetSearch) {
    const lowerCaseViewValue = viewValue.toLowerCase();

    if (thumbUpBudgetSearch && viewValue !== thumbUpBudgetSearch) {
      return _.filter(thumbUpBudgets, thumbUpBudget => {
        return thumbUpBudget.name.toLowerCase().includes(lowerCaseViewValue);
      });
    }

    return thumbUpBudgets;
  };
}]).directive('fhdThumbUpBudgetInput', [function () {
  return {
    templateUrl: 'modules/thumb-up-budgets/templates/fhd-thumb-up-budget-input.client.template.html',
    restrict: 'AE',
    scope: {
      thumbUpBudget: '=?',
      labelColumn: '@',
      inputColumn: '@',
      noLabel: '=?',
      label: '@',
      onChange: '=?',
      breakpoint: '@'
    },
    controller: 'fhdThumbUpBudgetInputController',
    controllerAs: 'vm',
    bindToController: true,

    link(scope, element) {
      const vm = scope.vm;

      if (vm.labelColumn) {
        const labelElm = element.find('label');
        const inputElm = element.find('fhd-controls');
        labelElm.addClass(`col-sm-${vm.labelColumn}`);
        inputElm.addClass(`col-sm-${12 - vm.labelColumn}`);
      }
    }

  };
}]).controller('fhdThumbUpBudgetInputController', ['$scope', 'ObjectId', 'ThumbUpBudgets', function ($scope, ObjectId, ThumbUpBudgets) {
  const vm = this;
  const notSelected = '';
  vm.thumbUpBudgetSearch = notSelected;
  vm.thumbUpBudgets = [];
  vm.thumbUpBudget = vm.thumbUpBudget || null;
  ThumbUpBudgets.my().$promise.then(thumbUpBudgets => {
    vm.thumbUpBudgets = thumbUpBudgets;
  });

  vm.handleRemove = () => {
    vm.thumbUpBudget = null;
  };

  vm.selectThumbUpBudget = item => {
    vm.thumbUpBudget = item;
  };

  $scope.$watch('vm.thumbUpBudget', (newValue, oldValue) => {
    if (newValue === oldValue) return;

    if (!vm.thumbUpBudget) {
      vm.thumbUpBudgetSearch = notSelected;
    }

    if (vm.thumbUpBudget) {
      vm.thumbUpBudgetSearch = vm.thumbUpBudget.name + ' - ' + vm.thumbUpBudget.amount;
    }

    if (vm.onChange && vm.thumbUpBudget) {
      vm.onChange(newValue);
    }
  });
}]);
