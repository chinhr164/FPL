angular.module('shift-entries').config(['$stateProvider', function ($stateProvider) {
  // Shift entries state routing
  $stateProvider.state('shift-calendar', {
    url: '/shift-calendar',
    templateUrl: 'modules/shift-entries/views/shift-calendar.client.view.html',
    resolve: {
      $title: _.constant('Shift Calendar')
    }
  }).state('createShiftEntry', {
    url: '/shift-entries/create',
    templateUrl: 'modules/shift-entries/views/create-shift-entry.client.view.html',
    resolve: {
      $title: _.constant('Create Shift Entry')
    }
  }).state('importShiftEntries', {
    url: '/shift-entries/import',
    templateUrl: 'modules/shift-entries/views/import-shift-entries.client.view.html',
    resolve: {
      $title: _.constant('Import Shift Entries')
    }
  }).state('summaryShiftEntry', {
    url: '/shift-entries/summary',
    templateUrl: 'modules/shift-entries/views/summary-calendar.client.view.html',
    resolve: {
      $title: _.constant('Summary Shift Entry')
    }
  }).state('viewShiftEntry', {
    url: '/shift-entries/:shiftEntryId',
    templateUrl: 'modules/shift-entries/views/view-shift-entry.client.view.html',
    resolve: {
      $title: _.constant('View Shift Entry')
    }
  }).state('editShiftEntry', {
    url: '/shift-entries/:shiftEntryId/edit',
    templateUrl: 'modules/shift-entries/views/edit-shift-entry.client.view.html',
    resolve: {
      $title: _.constant('Edit Shift Entry')
    }
  });
}]);
'use strict';

angular.module('shift-entries').controller('ImportShiftEntriesController', ['Authentication', 'FhdMessenger', '$http', '$location', 'ShiftPositions', function (Authentication, FhdMessenger, $http, $location, ShiftPositions) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;

  vm.import = () => {
    if (!_.intersection(['admin', 'shift-entry:import'], vm.user.roles).length) {
      return FhdMessenger.error('Bạn không có quyền import');
    }

    if (!vm.outlet.code) {
      return FhdMessenger.error('Bạn chưa điền mã cơ sở cần import');
    }

    if (_.some(vm.rawShiftEntries, item => {
      return !item.code;
    })) {
      return FhdMessenger.error('Bạn chưa điền mã nhân viên cần import');
    }

    if (_.some(vm.rawShiftEntries, item => {
      return !item.date;
    })) {
      return FhdMessenger.error('Bạn chưa điên thời gian trực');
    }

    if (_.some(vm.rawShiftEntries, item => {
      return !item.shift;
    })) {
      return FhdMessenger.error('Bạn chưa điền ca trực của nhân viên');
    }

    _.forEach(vm.rawShiftEntries, shiftEntry => {
      shiftEntry.date = moment(shiftEntry.date).startOf('day').toDate();
    });

    vm.waiting = true;
    $http.post('/shift-entries/import', {
      rawShiftEntries: vm.rawShiftEntries,
      outlet: vm.outlet
    }).then(() => {
      $location.path('shift-entry-calendar');
      return FhdMessenger.success('Import shift entries thành công');
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.exportForm = function () {
    const positions = ShiftPositions.getPostions(vm.outlet, true);
    const shiftEntries = [{
      code: 'E62',
      date: moment().format('YYYY/MM/DD'),
      shift: 'S',
      positions: _.map(positions, 'code').join(', '),
      registered: 1
    }, {
      code: 'E61',
      date: moment().format('YYYY/MM/DD'),
      shift: 'C',
      positions: _.map(positions, 'code').join(', '),
      registered: 1
    }, {
      code: 'E65',
      date: moment().format('YYYY/MM/DD'),
      shift: 'T',
      positions: _.map(positions, 'code').join(', '),
      registered: 1
    }];
    alasql(`SELECT * INTO XLSX("form-import-shift-entries.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [shiftEntries]);
  };
}]);
"use strict";

/* eslint-disable angular/controller-as */
// Shift entries controller
angular.module('shift-entries').controller('ShiftEntriesController', ['$scope', '$stateParams', '$location', 'Authentication', 'ShiftEntries', 'ShiftService', 'helper', 'ShiftPositions', 'ResourcesService', 'ObjectId', '$localStorage', 'FhdMessenger', '$state', function ($scope, $stateParams, $location, Authentication, ShiftEntries, ShiftService, helper, ShiftPositions, ResourcesService, ObjectId, $localStorage, FhdMessenger, $state) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.shiftEntry = {};
  vm.removeValueFromArray = helper.removeValueFromArray;

  vm.canEditShiftEntry = function () {
    return _.intersection(vm.user.roles, ['admin', 'tro-ly-kho', 'tro-ly', 'tro-ly-sx', 'marketing', 'shift-entry:edit', 'tro-ly-lich-truc']).length > 0;
  };

  vm.loadLocal = () => {
    const shiftEntryData = $localStorage.getObject('shiftEntryData');
    if (!_.get(shiftEntryData, 'outlet')) return;
    vm.outlet = shiftEntryData.outlet;
    vm.shiftEntry.date = shiftEntryData.date;
    vm.shiftEntry.shift = shiftEntryData.shift;
  };

  vm.dataChanged = function () {
    $localStorage.setObject('shiftEntryData', {
      outlet: vm.outlet,
      date: vm.shiftEntry.date,
      shift: vm.shiftEntry.shift
    });
  };

  vm.outletChanged = function (outlet) {
    vm.positions = vm.positions || [];
    vm.positions = ShiftPositions.getPostions(outlet);
    vm.positions = vm.positions.concat(ShiftPositions.PROBATION_POSITIONS);
    vm.positions = vm.positions.map(position => {
      return {
        code: position.code,
        label: position.name
      };
    });
  };

  $scope.$watch(() => vm.outlet, (newValue, oldValue) => {
    if (newValue === oldValue || !newValue) return;
    vm.outletChanged(newValue);
    vm.dataChanged();
  });

  vm.getNumber = function (num) {
    return new Array(num);
  };

  function loadResources(callback) {
    async.parallel([ResourcesService.staffs(false), ResourcesService.shifts(false)], function (err, results) {
      const extendShifts = ShiftService.getExtendShifts();

      if (err) {
        FhdMessenger.errorFromServer(err);
      }

      vm.data.staffs = results[0];
      vm.data.shifts = [...results[1], ...extendShifts];
      if (callback) callback();
    });
  }

  function init(scope) {
    scope.shiftEntry = {
      staffs: [],
      salemen: [],
      bakers: []
    };
  }

  vm.load = function (callback) {
    loadResources(function () {
      init(vm);
      if (callback) callback();
    });
  };

  const hasPosition = _.curry(function (positionCode, employee) {
    return employee[positionCode];
  });

  function getEmployees(staffs) {
    return _.map(staffs, function (staff) {
      const positions = _.reduce(vm.positions, function (positions, position) {
        if (staff[position.code]) positions.push(position.code);
        return positions;
      }, []);

      return {
        staff: ObjectId.getObjectId(staff),
        staffName: staff.displayName,
        cellphone: staff.cellphone,
        isManager: staff.isManager,
        positions
      };
    });
  }

  const processShiftEntry = function (shiftEntry) {
    // console.log('shiftEntry.staffs', shiftEntry.staffs)
    const cashier = _.find(shiftEntry.staffs, hasPosition('CASHIER'));

    const employees = getEmployees(shiftEntry.staffs);
    const _shiftEntry = {
      outlet: ObjectId.getObjectId(vm.outlet),
      date: shiftEntry.date,
      shift: shiftEntry.shift.code,
      staffs: _.map(shiftEntry.staffs, '_id'),
      cashier: ObjectId.getObjectId(cashier),
      employees
    };
    return _shiftEntry;
  };

  vm.getStaff = function (array) {
    const staffCodes = vm.inputStaffs.split('\n');

    const combinedCodes = _.map(staffCodes, code => code.trim().toLowerCase().replace(/(^|\s)\S/g, l => l.toUpperCase()));

    const shiftEntryGetStaff = ShiftEntries.checkAndGetStaffs({
      query: combinedCodes
    });
    shiftEntryGetStaff.$promise.then(staffs => {
      const mapStaff = _.map(staffs, staff => {
        return {
          code: staff.code,
          displayName: staff.displayName
        };
      });

      const diffStaffs = _.filter(combinedCodes, code => {
        let isMatch = true;

        _.forEach(mapStaff, staff => {
          if (code === staff.code || code === staff.displayName) isMatch = false;
        });

        return isMatch;
      });

      if (diffStaffs.length > 0) {
        return FhdMessenger.error(`Nhân viên: ${diffStaffs.join(' ')} bị sai`);
      }

      _.forEach(staffs, staff => {
        if (!staff) return;

        const checkDuplicate = _.find(array, element => element.code === staff.code);

        if (!checkDuplicate) {
          array.push(_.cloneDeep(staff));
        }
      });

      clearInput();
    });
  };

  vm.waiting = false; // Create new Shift entry

  vm.create = function () {
    if (!vm.shiftEntry.shift) return FhdMessenger.error('Chưa chọn ca trực');
    if (vm.shiftEntry.staffs.length === 0) return FhdMessenger.error('Chưa có nhân viên '); // Create new Shift entry object

    let shiftEntry = processShiftEntry(vm.shiftEntry);
    shiftEntry = new ShiftEntries(shiftEntry); // Redirect after save

    vm.waiting = true;
    shiftEntry.$save().then(function () {
      FhdMessenger.success('Ok');
      vm.shiftEntry.staffs = [];
      $state.reload();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }; // Remove existing Shift entry


  vm.remove = function (shiftEntry) {
    if (shiftEntry) {
      shiftEntry.$remove();
    } else {
      vm.shiftEntry.$remove().then(() => {
        $location.path('shift-entry-calendar');
      }).catch(FhdMessenger.errorFromServer);
    }
  }; // Update existing Shift entry


  vm.update = function () {
    vm.shiftEntry.employees = getEmployees(vm.shiftEntry.staffs);
    vm.shiftEntry.cashier = vm.shiftEntry.cashier ? vm.shiftEntry.cashier : _.find(vm.shiftEntry.staffs, hasPosition('CASHIER'));
    vm.waiting = true;
    vm.shiftEntry.$update().then(() => {
      $state.go('viewShiftEntry', {
        shiftEntryId: vm.shiftEntry._id
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }; // Find existing Shift entry


  vm.findOne = function () {
    vm.shiftEntry = ShiftEntries.get({
      shiftEntryId: $stateParams.shiftEntryId
    });
    vm.shiftEntry.$promise.then(shiftEntry => {
      const outlet = shiftEntry.outlet;
      vm.outletChanged(outlet);

      _.forEach(shiftEntry.employees, employee => {
        const matchStaff = _.find(shiftEntry.staffs, {
          _id: employee.staff._id
        });

        _.forEach(employee.positions, position => {
          matchStaff[position] = true;
        });
      });
    });
  };

  vm.pushTypeAhead = function (item, array, callback) {
    if (!item) return;

    const checkDuplicate = _.find(array, element => element.code === item.code);

    if (!checkDuplicate) {
      array.push(_.cloneDeep(item));
    }

    item = null;
    clearInput();
    if (callback) callback();
  };

  function clearInput() {
    vm.staffSearch = null;
    vm.inputStaffs = null;
  }

  vm.resetCashier = function () {
    vm.shiftEntry.cashier = null;
  };

  vm.removeStaff = function (index, array) {
    array.splice(index, 1);
  };

  vm.open = function ($event) {
    $event.preventDefault();
    $event.stopPropagation();
    vm.opened = true;
  };
}]);
'use strict';

angular.module('shift-entries').controller('ShiftEntryCalendarController', ['$state', '$stateParams', '$scope', '$window', 'ObjectId', 'uiCalendarConfig', '$compile', '$location', '$filter', 'NgTableParams', 'ShiftEntryService', '$http', 'FhdMessenger', 'OutletService', function ($state, $stateParams, $scope, $window, ObjectId, uiCalendarConfig, $compile, $location, $filter, NgTableParams, ShiftEntryService, $http, FhdMessenger, OutletService) {
  const vm = $scope; // vm.showReportTable = false

  const momentDateFilter = $filter('momentDate');

  vm.typeWorkTime = staff => {
    if (staff.roles.includes('part-time')) {
      return {
        workType: 'Part-time',
        labelClass: 'label label-warning'
      };
    }

    if (staff.roles.includes('full-time')) {
      return {
        workType: 'Full-time',
        labelClass: 'label label-success'
      };
    }

    return false;
  };

  vm.eventRender = function (event, element) {
    if (event.task && event.task === 'shift-lead') {
      element.css({
        backgroundColor: 'rgb(248, 255, 153'
      });
    }

    element.find('.fc-title').addClass('fc-shift-title');
    const content = element.find('.fc-content');

    if (event.employees && event.employees.length) {
      _.forEach(event.employees, function (employee, key) {
        let textColorClass = 'fc-staff';

        if (employee.positions.includes('ORANGE')) {
          textColorClass = 'fc-orange-staff';
        } else if (employee.positions.includes('GREEN')) {
          textColorClass = 'fc-green-staff';
        }

        let isProbationary = !!employee.isProbationary;

        const writerBadgeLevel = _.get(employee, 'staff.writerBadgeLevel', 0);

        const typeWorkTime = vm.typeWorkTime(employee.staff);

        const isHasWorkType = _.has(typeWorkTime, 'workType');

        content.append(`<div class="${textColorClass} staff-${key} ${isProbationary ? 'text-danger' : 'text-default'}">
            
            ${employee.staffName} ${event.showUserRank ? ' - ' + _.get(employee, 'staff.rank') : ''}</div> 
            
          
            <span class="fc-positions">(${employee.positions.map(ShiftEntryService.transaltePosition).join(', ')})  
              <span class="severity-point text-left" ng-if="${writerBadgeLevel} > 0">
              <img ng-if="${writerBadgeLevel} === 1" src="/modules/users/img/levels/level-1.png" width="15px" alt="level" />
              <img ng-if="${writerBadgeLevel} === 2" src="/modules/users/img/levels/level-2.png" width="15px" alt="level" />
              <img ng-if="${writerBadgeLevel} === 3" src="/modules/users/img/levels/level-3.png" width="15px" alt="level" />
              </span> 
              <label ng-show="${isHasWorkType}" class='${typeWorkTime.labelClass}'>${typeWorkTime.workType}</label></span>  
           
           
            `);
      });
    } else if (event.staffs && event.staffs.length) {
      _.forEach(event.staffs, function (staff, key) {
        content.append(`<div class="fc-staff staff-${key}">${staff.displayName} ${event.showUserRank ? ' - ' + _.get(staff, 'rank') : ''}</div>`);
      });
    } else {
      element.find('.fc-time').css({
        display: 'none'
      });
      const titleElm = element.find('.fc-title');
      titleElm.css({
        display: 'none'
      });
      const contentElm = element.find('.fc-content');
      contentElm.prepend(`<div class=".fc-time"><strong>${momentDateFilter(event.start, 'LT')} - ${momentDateFilter(event.end, 'LT')}</strong></div>`);

      if (event.staff && event.staff.displayName) {
        const shiftLeadChanger = event.outlet === '5ac8fedea4ba632eecca65e8' // ObjectId của B1
        ? `<a href="#" ng-click="changeTask('${event._id}',  '${event.task === 'shift-lead' ? 'watch' : 'shift-lead'}' )">Đổi vị trí</a> &nbsp;` : '';
        contentElm.append(`<div class=".fc-staff">${event.staff.displayName} (${$filter('calendarEntryTask')(event.task)}) <br/>
            ${shiftLeadChanger}
            <a target="_blank" ui-sref="editCalendarEntry({ calendarEntryId: '${event._id}'})" ng-click="visitCalendarEntry('${event._id}')">Xem</a>
            </div>`);
      }

      if (event.missions && event.missions.length) {
        const elementStyle = element.find('.fc-content');
        elementStyle.css({
          backgroundColor: 'gray'
        });
      }

      if (event.end) {
        contentElm.append('<div class=".fc-end"></div>');
      }
    }

    $compile(element)(vm);
  };

  vm.changeTask = (calendarEntryId, newTask) => {
    $http.put(`/calendar-entries/${calendarEntryId}/change-task`, {
      task: newTask
    }).then(response => {
      vm.find();
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.visitCalendarEntry = calendarEntryId => {
    $window.open(`#!/calendar-entries/${calendarEntryId}/edit`);
  };

  vm.eventClick = function (event) {
    const shiftEntryId = event.shiftEntryId;

    if (shiftEntryId) {
      $window.open(`#!/shift-entries/${shiftEntryId}`);
    }
  };

  vm.showStaffsTable = () => {
    vm.showReportTable = true;
  };

  vm.staffsTable = new NgTableParams({
    count: 1000
  });
  vm.uiConfig = {
    calendar: {
      height: 800,
      editable: true,
      header: {
        left: 'title',
        center: '',
        right: 'today month basicWeek prev,next'
      },
      firstDay: 1,
      weekNumbers: 4,
      defaultView: 'basicWeek',
      businessHours: {
        start: '08:00',
        end: '22:00'
      },
      timezone: 'Asia/Ho_Chi_Minh',
      displayEventTime: false,
      eventClick: vm.eventClick,
      weekNumberCalculation: 'ISO',
      eventRender: vm.eventRender,
      eventAfterAllRender: function (view) {
        const calendar = uiCalendarConfig.calendars.shiftEntryCalendar;

        if (calendar) {
          const events = calendar.fullCalendar('clientEvents');

          const dates = _.reduce(events, (result, event) => {
            const eventDate = moment(event.start).format('ddd M/D');
            result[eventDate] = result[eventDate] || 0;

            if (_.get(event, 'outletCode', '').match(/[BDG]\d+/)) {
              result[eventDate] += _.get(event, 'employees.length', 0) * _.get(event, 'hours', 0) / 4.5;
            } else {
              result[eventDate] += _.get(event, 'employees.length', 0);
            }

            return result;
          }, {});

          _.forEach(view.headContainerEl.find('.fc-day-header'), (elm, i) => {
            const innerText = elm.innerText.replace(/\s\(\d+\)/, '');
            if (dates[innerText]) elm.innerText = `${innerText} (${Math.round(dates[innerText])})`;else dates[innerText] = innerText;
          });
        }
      },
      lang: 'vi',
      eventOrder: ['priority', 'start'],
      loading: function (isLoading, view) {
        if (isLoading) return;
        const startDate = moment(view.start).startOf('day').format('YYYY-MM-DD');
        const endDate = moment(view.end).startOf('day').format('YYYY-MM-DD');
        let outlet;

        if (_.get($scope.outlet, '_id')) {
          outlet = ObjectId.getObjectId($scope.outlet);
        }

        vm.waiting = false;
        ShiftEntryService.summarize({
          startDate,
          endDate,
          outlet
        }).then(staffs => {
          vm.staffsTable.settings({
            dataset: staffs
          });
          vm.staffsTable.reload();
        });
      }
    }
  };
  $scope.$watch('staffsTable.data', (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.shiftCount = _.sumBy(newValue, obj => {
      return _.get(obj, 'shiftCount', 0);
    });
    vm.eveningCount = _.sumBy(newValue, obj => {
      return _.get(obj, 'eveningCount', 0);
    });
    vm.weekendCount = _.sumBy(newValue, obj => {
      return _.get(obj, 'weekendCount', 0);
    });
    vm.recycleCount = _.sumBy(newValue, obj => {
      return _.get(obj, 'recycleCount', 0);
    });
  });

  vm.find = function () {
    const calendar = uiCalendarConfig.calendars.shiftEntryCalendar;
    vm.waiting = true;
    calendar.fullCalendar('refetchEvents');
  };

  vm.init = () => {
    if ($stateParams.outletCode) {
      OutletService.findOutletFromCode($stateParams.outletCode).then(outlet => {
        $scope.outlet = outlet;
      });
    }
  };

  vm.eventSources = [];
  $scope.$watch('outlet', (newValue, oldValue) => {
    if (oldValue && newValue && !ObjectId.equals(oldValue, newValue)) {
      return $state.go('shift-entry-calendar', {
        outletCode: newValue.code
      }, {
        notify: false,
        reload: false
      });
    }

    if (!oldValue && newValue) {
      if (!_.get($scope, 'outlet._id')) {
        return;
      }

      vm.eventSources.splice(0, vm.eventSources.length);
      vm.eventSources.push({
        url: '/shift-entry-calendar',

        data() {
          return {
            outlet: ObjectId.getObjectId($scope.outlet),
            requireOutlet: true
          };
        },

        color: 'white',
        textColor: '#191919',
        borderColor: '#ABABAC'
      }, {
        url: '/calendar-entries/calendar',
        color: 'white',

        data() {
          return {
            outlet: ObjectId.getObjectId($scope.outlet),
            requireOutlet: true
          };
        },

        backgroundColor: '#f5d4d4',
        textColor: 'black',
        borderColor: '#ABABAC'
      });
    }
  });
}]);
"use strict";

angular.module('shift-entries').controller('SummaryShiftController', ['$http', 'FhdMessenger', 'NgTableParams', 'Authentication', function ($http, FhdMessenger, NgTableParams, Authentication) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.waiting = false;
  vm.data = {};
  vm.data.startDate = moment().subtract(2, 'week').startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.summaryShiftTable = new NgTableParams({
    count: 50
  });
  vm.outlet = vm.user.outlet;

  vm.find = () => {
    vm.waiting = true;
    let promise = $http({
      method: 'GET',
      url: '/shift-entries/summary',
      params: {
        startDate: vm.data.startDate,
        endDate: vm.data.endDate,
        outlet: _.get(vm.outlet, '_id')
      }
    }).then(respons => {
      const data = respons.data;
      vm.summaryShiftTable.settings({
        dataset: data
      });
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải dữ liệu...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
  };
}]);
'use strict'; // Shift entries service used to communicate Shift entries REST endpoints

angular.module('shift-entries').factory('ShiftEntries', ['$resource', function ($resource) {
  return $resource('shift-entries/:shiftEntryId', {
    shiftEntryId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    staffMap: {
      method: 'GET',
      url: 'shift-entries/staff-map',
      isArray: false
    },
    checkAndGetStaffs: {
      method: 'GET',
      url: 'shift-entries/check-and-get-staffs',
      isArray: true
    }
  });
}]);
'use strict';

angular.module('shift-entries').factory('ShiftEntryService', ['$http', 'ShiftPositions', function ($http, ShiftPositions) {
  function transaltePosition(positionCode) {
    const outletPostions = ShiftPositions.outletPostions;

    const matchPosition = _.find(outletPostions, {
      code: positionCode
    });

    return _.get(matchPosition, 'name', positionCode);
  }

  return {
    transaltePosition,

    summarize(params) {
      return $http.get('/shift-entries/summarize', {
        params
      }).then(response => response.data);
    },

    findShiftEntry(shiftInfo) {
      return $http({
        url: '/shift-entries/find',
        method: 'GET',
        params: shiftInfo
      }).then(response => response.data);
    }

  };
}]);
"use strict";

angular.module('shift-limits').config(['$stateProvider', function ($stateProvider) {
  $stateProvider.state('listShiftLimits', {
    url: '/shift-limits',
    templateUrl: 'modules/shift-limits/views/list-shift-limits.client.view.html',
    resolve: {
      $title: _.constant('List Shift Limits')
    }
  }).state('createShiftLimit', {
    url: '/shift-limits/create',
    templateUrl: 'modules/shift-limits/views/create-shift-limit.client.view.html',
    resolve: {
      $title: _.constant('Create Shift Limit')
    }
  }).state('importShiftLimit', {
    url: '/shift-limits/import',
    templateUrl: 'modules/shift-limits/views/import-shift-limit.client.view.html',
    resolve: {
      $title: _.constant('Import Shift Limit')
    }
  });
}]);
"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('shift-limits').controller('CreateShiftLimitController', ['ShiftLimits', 'FhdMessenger', '$location', 'Outlets', 'ShiftLimitService', '$scope', function (ShiftLimits, FhdMessenger, $location, Outlets, ShiftLimitService, $scope) {
  const vm = this;
  vm.shifts = ShiftLimitService.getShifts();

  const shiftIndex = _.map(new Array(vm.shifts.length), (value, index) => {
    return index;
  });

  _.forEach(vm.shifts, shift => {
    vm[shift] = {
      official: 0,
      probationary: 0
    };
  });

  function processTitle() {
    if (_.get(vm.outlets, 'length')) {
      vm.name = `Kế hoạch lịch trực ${_.map(vm.outlets, 'code').join(',')} từ ${moment(vm.startDate).format('DD/MM')} - ${moment(vm.endDate).format('DD/MM')}`;
    }
  }

  $scope.$watch(() => vm.outlets, () => processTitle());
  $scope.$watch(() => vm.startDate, () => processTitle());
  $scope.$watch(() => vm.endDate, () => processTitle());

  vm.preview = function () {
    if (!moment(vm.startDate).isBefore(moment(vm.endDate))) {
      return FhdMessenger.error('Ngày kết thúc phải ở sau ngày bắt đầu');
    }

    const number = moment(vm.endDate).startOf('day').diff(moment(vm.startDate).startOf('day'), 'day') + 1;
    vm.dates = _.reduce(shiftIndex, (shiftResult, index) => {
      let dateArray = _.reduce(_.fill(Array(number), {}), dateResult => {
        const shift = vm.shifts[index];
        dateResult.push(_.cloneDeep(vm[shift]));
        return dateResult;
      }, []);

      shiftResult.push(dateArray);
      return shiftResult;
    }, []);
    vm.formattedDates = _.range(number).map(offset => {
      return moment(vm.startDate).add(offset, 'day').format('D/M');
    });
  };

  vm.data = {
    outlets: Outlets.query({
      deleted: false
    })
  };

  vm.increaseRow = function (index, type) {
    if (!vm.dates || !vm.dates.length) {
      return;
    }

    const shift = vm.shifts[index];
    vm.dates[index] = _.map(vm.dates[index], _shift => {
      if (type === 'official') return _objectSpread({}, _shift, {
        official: vm[shift].official
      });
      return _objectSpread({}, _shift, {
        probationary: vm[shift].probationary
      });
    });
  };

  vm.getShift = ShiftLimitService.getShiftByIndex;

  vm.create = () => {
    let newShifts = _.cloneDeep(vm.dates); // Nếu cơ sở không phải là B1 thì chỉ lấy 3 ca đầu tiên là S C T


    if (!_.some(vm.outlets, {
      code: 'B1'
    })) {
      newShifts = _.take(newShifts, 3);
    }

    var shiftLimit = new ShiftLimits({
      name: vm.name,
      outlets: vm.outlets,
      shifts: newShifts,
      startDate: vm.startDate,
      endDate: vm.endDate,
      maxShiftPerWeek: vm.maxShiftPerWeek
    });
    shiftLimit.$save(function (res) {
      $location.path('/shift-limits');
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
      FhdMessenger.error(vm.error);
    });
  };

  vm.handleMouseDown = ($event, shiftIndex, dateIndex, type) => {
    if ($event.which === 1) {
      vm.dates[shiftIndex][dateIndex][type] += 1;
    }

    if ($event.which === 3) {
      vm.dates[shiftIndex][dateIndex][type] -= 1;
    }
  };
}]);
"use strict";

angular.module('shift-limits').controller('ImportShiftLimitController', ['$state', 'Authentication', 'FhdMessenger', 'ShiftLimits', 'ConfirmModal', function ($state, Authentication, FhdMessenger, ShiftLimits, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;

  vm.import = () => {
    if (!vm.googleSheetLink) {
      return FhdMessenger.error('Bạn chưa điền link google sheet');
    }

    if (!_.includes(vm.googleSheetLink, 'https://docs.google.com/spreadsheets/d/')) {
      return FhdMessenger.error('Link google sheet không đúng định dạng');
    }

    ConfirmModal.showModal({}, {
      headerText: `Hành động này sẽ import shift limit từ link gg sheet?`,
      bodyText: `<strong>Lưu ý</strong>: <p>Link google sheet <a href="${vm.googleSheetLink}">này</a> cần được cấp quyền xem cho tài khoản chuthang205@gmail.com</p>`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      ShiftLimits.import({
        googleSheetLink: vm.googleSheetLink
      }).$promise.then(ShiftLimits => {
        FhdMessenger.success(`Import thành công`);
        $state.go('listShiftLimits');
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('shift-limits').controller('ShiftLimitsController', ['FhdMessenger', 'ObjectId', 'ShiftLimits', 'ShiftLimitService', '$state', function (FhdMessenger, ObjectId, ShiftLimits, ShiftLimitService, $state) {
  const vm = this;
  vm.data = {};
  vm.data.startDate = moment().subtract(2, 'week').startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().endOf('week').format('YYYY-MM-DD');

  const attachFormatedDates = shiftLimit => {
    shiftLimit.maxShiftPerWeek = shiftLimit.maxShiftPerWeek || 4;
    const length = moment(shiftLimit.endDate).startOf('day').diff(moment(shiftLimit.startDate).startOf('day'), 'day') + 1;
    shiftLimit.offsetStartDate = moment(shiftLimit.startDate).diff(vm.data.startDate, 'day');
    shiftLimit.formattedDates = _.range(length).map((offset, index) => ({
      date: moment(shiftLimit.startDate).add(offset, 'day').format('D/M'),
      offset: moment(shiftLimit.startDate).add(index, 'day').diff(vm.data.startDate, 'day')
    }));
  };

  vm.find = () => {
    vm.data.rangeDate = moment(vm.data.endDate).diff(vm.data.startDate, 'day');
    vm.shiftLimits = ShiftLimits.query({
      outlet: ObjectId.getObjectId(vm.outlet),
      startDate: vm.data.startDate,
      endDate: vm.data.endDate
    });
    vm.shiftLimits.$promise.then(() => {
      _.forEach(vm.shiftLimits, attachFormatedDates);
    });
  };

  vm.getShift = ShiftLimitService.getShiftByIndex;

  vm.update = shiftLimit => {
    shiftLimit.updating = true;
    shiftLimit.$update().then(() => {
      FhdMessenger.success('Ok');
      attachFormatedDates(shiftLimit);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      shiftLimit.updating = false;
    });
  };

  vm.remove = shiftLimit => {
    shiftLimit.updating = true;
    shiftLimit.$remove().then(() => {
      FhdMessenger.success('Ok');
      $state.reload();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      shiftLimit.updating = false;
    });
  };

  vm.handleMouseDown = ($event, shiftLimit, shiftIndex, dateIndex, type) => {
    if (!type) {
      const currentLimit = _.get(shiftLimit, `dates.${shiftIndex}.${dateIndex}`);

      let newLimit = currentLimit;

      if ($event.which === 1) {
        newLimit += 1;
      }

      if ($event.which === 3) {
        newLimit -= 1;
      }

      _.set(shiftLimit, `dates.${shiftIndex}.${dateIndex}`, newLimit);
    } else {
      if (type === 'maxShift') {
        if ($event.which === 1) {
          shiftLimit.maxShiftPerWeek += 1;
        }

        if ($event.which === 3) {
          shiftLimit.maxShiftPerWeek -= 1;
        }
      } else {
        const currentLimit = _.get(shiftLimit, `shifts.${shiftIndex}.${dateIndex}.${type}`);

        let newLimit = currentLimit;

        if ($event.which === 1) {
          newLimit += 1;
        }

        if ($event.which === 3) {
          newLimit -= 1;
        }

        _.set(shiftLimit, `shifts.${shiftIndex}.${dateIndex}.${type}`, newLimit);
      }
    }
  };
}]);
