angular.module('outlets').factory('Outlets', ['$resource', function ($resource) {
  return $resource('outlets/:outletId', {
    outletId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    getUpdatedOutlets: {
      method: 'GET',
      url: 'outlets/get-updated',
      isArray: true
    },
    checkNeedStafff: {
      method: 'PUT',
      url: '/outlets/:outletId/change-need-staff'
    },
    updateRestockTime: {
      method: 'PUT',
      url: '/outlets/:outletId/update-restock-time'
    },
    updateShifts: {
      method: 'PUT',
      url: '/outlets/:outletId/update-shifts'
    },
    updateProcessors: {
      method: 'PUT',
      url: '/outlets/:outletId/update-processors'
    },
    summarizeRefrigerators: {
      method: 'GET',
      url: '/outlets/summarize-refrigerators',
      isArray: true
    }
  });
}]);
