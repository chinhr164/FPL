angular.module('documents').controller('DocumentsController', ['$stateParams', '$location', 'Authentication', 'Documents', 'FhdMessenger', function ($stateParams, $location, Authentication, Documents, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication; // Create new Document

  vm.create = function () {
    // Create new Document object
    const document = new Documents(vm.document); // Redirect after save

    document.$save() // eslint-disable-line angular/document-service
    .then(function (response) {
      $location.path(`documents/${response._id}`); // Clear form fields

      vm.name = '';
    }, FhdMessenger.errorFromServer);
  }; // Remove existing Document


  vm.remove = function (document) {
    if (document) {
      document.$remove(); // eslint-disable-line angular/document-service

      const index = _.findIndex(vm.documents, document);

      if (index > -1) vm.documents.splice(index, 1);
    } else {
      vm.document.$remove(function () {
        $location.path('documents');
      });
    }
  }; // Update existing Document


  vm.update = function () {
    const document = vm.document;
    document.$update(function () {
      // eslint-disable-line angular/document-service
      $location.path('documents');
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of Documents


  vm.find = function () {
    vm.documents = Documents.query();
  }; // Find existing Document


  vm.findOne = function () {
    vm.document = Documents.get({
      documentId: $stateParams.documentId
    });
  };
}]);
'use strict'; // Documents service used to communicate Documents REST endpoints

