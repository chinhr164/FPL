function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('special-price-entries').controller('SpecialPriceEntriesController', ['$stateParams', '$location', 'Authentication', 'NgTableParams', 'SpecialPriceEntries', 'FhdMessenger', 'ObjectId', 'BusinessCustomers', 'ConfirmModal', function ($stateParams, $location, Authentication, NgTableParams, SpecialPriceEntries, FhdMessenger, ObjectId, BusinessCustomers, ConfirmModal) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.endDate = moment().add(1, 'month').format('YYYY-MM-DD');
  vm.startDate = moment().format('YYYY-MM-DD');
  vm.specialPriceEntriesTable = new NgTableParams({
    count: 50
  });
  vm.statuses = ['active', 'pending', 'inactive'];
  vm.statusMap = {
    active: true,
    pending: true,
    inactive: false
  };

  vm.init = function () {
    vm.waiting = true;
    BusinessCustomers.query({}).$promise.then(businessCustomers => {
      vm.businessCustomers = businessCustomers;
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.find = function () {
    vm.waiting = true;

    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    SpecialPriceEntries.query({
      startDate: vm.startDate,
      endDate: vm.endDate,
      statuses
    }).$promise.then(specialPriceEntries => {
      vm.specialPriceEntriesTable.settings({
        dataset: specialPriceEntries
      });
      vm.specialPriceEntries = specialPriceEntries;
      vm.quantitySpecialPriceByStatus = _.countBy(specialPriceEntries, 'status');
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.create = function () {
    if (!vm.businessCustomer) {
      return FhdMessenger.error('Bạn chưa nhập business customer');
    }

    if (!vm.startDate || !vm.endDate) {
      return FhdMessenger.error('Bạn chưa nhập ngày bắt đâu hoặc kết thúc ');
    }

    if (!vm.items.length) {
      return FhdMessenger.error('Cần ít nhất một sản phẩm');
    }

    if (_.some(vm.items, item => {
      return _.isUndefined(item.expectPrice);
    })) {
      return FhdMessenger.error('Cần điền đầy đủ giá kì vọng cho tất cả sản phẩm');
    }

    const specialPriceEntry = new SpecialPriceEntries({
      businessCustomer: vm.businessCustomer,
      startDate: vm.startDate,
      endDate: vm.endDate,
      items: vm.items,
      user: vm.user
    }); // Redirect after save

    specialPriceEntry.$save().then(() => {
      FhdMessenger.success('Tạo special price entry thành công');
      $location.path(`special-price-entries`);
    }).catch(err => {
      return FhdMessenger.error(err.message);
    });
  };

  vm.changeBusinessCustomer = function () {
    vm.items = _.map(vm.businessCustomer.products, product => {
      return _objectSpread({}, product, {
        expectPrice: product.price
      });
    });
  };

  vm.addProduct = function (product) {
    vm.product = null;
    vm.items = vm.items || [];

    if (_.some(vm.items, item => {
      return _.isEqual(ObjectId.getObjectId(item.product), ObjectId.getObjectId(product));
    })) {
      return;
    }

    const {
      sku,
      description,
      price
    } = product;
    vm.items.push({
      product: product._id,
      sku,
      description,
      price,
      expectPrice: price
    });
  };

  vm.findOne = function () {
    SpecialPriceEntries.get({
      specialPriceEntryId: $stateParams.specialPriceEntryId
    }).$promise.then(specialPriceEntry => {
      vm.specialPriceEntry = specialPriceEntry;
      vm.items = specialPriceEntry.items;
    });
  };

  vm.update = function () {
    if (!vm.startDate || !vm.endDate) {
      return FhdMessenger.error('Bạn chưa nhập ngày bắt đâu hoặc kết thúc ');
    }

    if (!vm.items.length) {
      return FhdMessenger.error('Cần ít nhất một sản phẩm');
    }

    if (_.some(vm.items, item => {
      return _.isUndefined(item.expectPrice);
    })) {
      return FhdMessenger.error('Cần điền đầy đủ giá kì vọng cho tất cả sản phẩm');
    }

    vm.specialPriceEntry.items = vm.items;
    const specialPriceEntry = new SpecialPriceEntries(vm.specialPriceEntry); // Redirect after save

    specialPriceEntry.$update().then(() => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path(`special-price-entries`);
    }).catch(err => {
      return FhdMessenger.error(err.message);
    });
  };

  vm.approve = function (specialPriceEntry) {
    const _specialPriceEntry = new SpecialPriceEntries(specialPriceEntry);

    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc là muốn approve Special Price Entry này không ?`,
      actionButtonText: 'Accept',
      closeButtonText: 'close'
    }).then(() => {
      vm.waiting = true;

      _specialPriceEntry.$approve().then(() => {
        specialPriceEntry.status = 'active';
        return FhdMessenger.success('Approve thành công');
      }).catch(err => {
        return FhdMessenger.error(err.message);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.remove = function (specialPriceEntry) {
    const _specialPriceEntry = new SpecialPriceEntries(specialPriceEntry);

    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc là muốn disapprove Special Price Entry này không ?`,
      actionButtonText: 'Accept',
      closeButtonText: 'close'
    }).then(() => {
      vm.waiting = true;

      _specialPriceEntry.$remove().then(() => {
        specialPriceEntry.status = 'inactive';
        return FhdMessenger.success('Disapprove thành công');
      }).catch(err => {
        return FhdMessenger.error(err.message);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;

          if (_.every(_.map(vm.statusMap))) {
            changeValue = false;
          }

          _.forEach(vm.statusMap, (status, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }
    }
  };
}]);
'use strict';

