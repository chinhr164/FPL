angular.module('calendar-entries').factory('CalendarEntryService', ['$http', '$modal', function ($http, $modal) {
  const missions = ['Chất lượng thực phẩm: không có hàng hỏng kém chất lượng, đã thực hiện báo hàng tồn quá 2 ngày lên slack cơ sở và tiêu huỷ hàng kém chất lượng đúng quy trình.', 'Tắt bật món trên các app của cơ sở: đã kiểm tra thực hiện tắt bật đúng, đủ ở 3 app Now, Grab và Baemin', 'Layout cửa hàng: kiểm tra việc sắp xếp đúng layout và đủ đồ dùng dụng cụ.', 'Vệ sinh cơ sở: đã kiểm tra, nhắc nhở cơ sở xử lý dọn dẹp vệ sinh đảm bảo theo yêu cầu theo checklist QC.', 'Cơ sở vật chất: kiểm tra 2 cân điện từ, 1 cân 500g, 1 cân 5kg, lò nướng, lò vi sóng, nồi cơm điện đủ số lượng và hoạt động bình thường. Cấc thiết bị có vấn đề đã báo lên slack channel csvc', 'Tác phong của nhân viên: đã thực hiện mặc đồng phục đầy đủ, đầu tóc gọn gàng, đi làm đúng giờ.', 'Quy trình nhân viên làm món: đã thực hiện double check hoá đơn và nhãn món đầy đủ', 'Hàng vận hành của cơ sở: đã thực hiện kiểm tra và báo đặt hàng vận hành hết nếu có.', 'Tủ mát cơ sở: đã kiểm tra và đảm bảo nhiệt độ bảo quản, không bị chảy nước, đóng đá, nhiệt độ cao trên 12 độ.', 'Nhân viên thử việc: đã hướng dẫn và nhắc nhở nhân viên làm training progress.'];
  const tasks = [{
    _id: 'watch',
    name: 'Trực'
  }, {
    _id: 'wfh',
    name: 'WFH'
  }, {
    _id: 'shift-lead',
    name: 'Trưởng ca'
  }, {
    _id: 'training',
    name: 'Training'
  }, {
    _id: 'checklist',
    name: 'Checklist'
  }, {
    _id: 'interview',
    name: 'Phỏng vấn'
  }];

  const taskMap = _.reduce(tasks, (result, task) => {
    result[task._id] = task.name;
    return result;
  }, {});

  const fulltimeCalendarTable = [// { outlets: ['S2', 'S6'], times: [{ startHour: 6, endHour: 14 }] },
  {
    outlets: ['B\\d+'],
    times: [{
      startHour: 7,
      endHour: 15
    }, {
      startHour: 14,
      endHour: 22
    }, {
      startHour: 5,
      endHour: 12
    }]
  }];
  return {
    summarize(params) {
      return $http.get('/calendar-entries/summarize', {
        params
      }).then(response => response.data);
    },

    getTasks(user) {
      if (_.get(user, 'outlet.code') === 'MKT' && user.roles.includes('flexi-time')) {
        return _.filter(tasks, {
          _id: 'shift-lead'
        });
      }

      return tasks;
    },

    getTaskMap() {
      return taskMap;
    },

    getMissions() {
      return missions;
    },

    getFulltimeCalendar(outletCode) {
      if (!outletCode) {
        return [];
      }

      const matchCalendar = _.find(fulltimeCalendarTable, calendar => {
        return _.some(calendar.outlets, outlet => {
          const outletRegex = new RegExp(outlet);
          return outletCode.match(outletRegex);
        });
      });

      return _.get(matchCalendar, 'times', []);
    },

    findCalendarEntry(calendarInfo) {
      return $http({
        url: '/calendar-entries/find',
        method: 'GET',
        params: calendarInfo
      }).then(response => response.data);
    },

    openReportCalendarEntryModal(calendarEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalReportCalendarEntryController',
        controllerAs: 'vm',
        templateUrl: 'modules/calendar-entries/views/modal-report-calendar-entry.client.view.html',
        resolve: {
          calendarEntry() {
            return calendarEntry;
          }

        }
      });
    }

  };
}]);
"use strict";

/* global FileReader */
angular.module('camera').directive('fileread', ['$q', '$window', function ($q, $window) {
  return {
    scope: {
      fileread: '=',
      onEachImage: '=?',
      onChange: '=?'
    },
    link: function (scope, element, attributes) {
      // Adopt from https://developer.mozilla.org/en-US/docs/Web/API/FileReader/readAsDataURL
      function readFile(file, resolve) {
        const reader = new FileReader();

        reader.onload = function (event) {
          const result = event.target.result;
          scope.fileread.push(result);

          if (scope.onEachImage) {
            scope.onEachImage(result);
          }

          if (resolve) resolve();
        };

        reader.readAsDataURL(file);
      }

      element.bind('change', function (changeEvent) {
        scope.fileread = [];
        $q.all(_.map(changeEvent.target.files, file => {
          return $q(function (resolve) {
            readFile(file, resolve);
          });
        })).then(() => {
          if (scope.onChange) {
            scope.onChange(scope.fileread);
          }
        });
      });
    }
  };
}]);
