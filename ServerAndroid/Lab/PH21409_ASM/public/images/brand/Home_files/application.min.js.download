  vm.statusMap = {
    created: true,
    processing: true,
    done: false,
    void: false
  };

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.outletIds = _.map(selectedOutlets, '_id');
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      default:
    }
  };

  const processContent = outletReport => {
    const userContent = helper.convertObjectToText(outletReport.user, ['code', 'displayName'], ' - ');
    const processorsContent = helper.joinArrayWithProperties(outletReport.processors, ['displayName'], ' - ');
    const businessesContent = helper.joinArrayWithProperties(_.get(outletReport, 'businesses', []), ['code'], ' - ');

    const productContent = _.map(outletReport.products, product => {
      return `${product.sku} - ${product.description}`;
    }).join('\n');

    const uniqRegions = _.uniq(_.map(_.get(outletReport, 'outlets', []), 'region'));

    const zonesContent = _.map(uniqRegions, OutletReportService.convertRegionToZone).join(', ');

    return {
      userContent,
      zonesContent,
      processorsContent,
      businessesContent,
      productContent
    };
  };

  vm.find = () => {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    vm.waiting = true;
    OutletReportService.summarize({
      startDate: vm.startDate,
      endDate: vm.endDate,
      statuses,
      outlets: vm.outletIds
    }).then(outletReports => {
      const cookedData = _.map(outletReports, outletReport => {
        return _.assign(outletReport, processContent(outletReport));
      });

      vm.outletReports = cookedData;
      vm.summarizeOutletReportTable.settings({
        dataset: cookedData
      });
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = () => {
    OutletReports.get({
      outletReportId: $stateParams.outletReportId
    }).$promise.then(outletReport => {
      vm.outletReport = outletReport;
    });
    $http.get(`/outlet-reports/${$stateParams.outletReportId}/summarize-children`).then(({
      data
    }) => {
      vm.summaryProductsTable.settings({
        dataset: data.countProducts
      });
      vm.veboseProductsTable.settings({
        dataset: data.veboseProducts
      });
      vm.outletReportImages = data.outletReportImages;
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    });
  };

  vm.exportTable = OutletReportService.exportTable;

  vm.openSummarizeOutletReportModal = outletReport => {
