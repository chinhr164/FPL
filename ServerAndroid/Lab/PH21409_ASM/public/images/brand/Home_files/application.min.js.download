angular.module('woo-product-categories').controller('ImportWooProductCategoriesController', ['Authentication', 'WooProductCategories', 'FhdMessenger', 'ConfirmModal', function (Authentication, WooProductCategories, FhdMessenger, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.requireFields = 'name landingPageShow'.split(' ');

  function isAllValidField(field) {
    return _.some(vm.rawItems, item => {
      return !_.get(item, field) && _.get(item, field) !== 0;
    });
  }

  function validateItems() {
    let errors = [];

    if (!_.intersection(vm.user.roles, ['admin']).length) {
      errors.push(`Bạn không có quyền import woo product categories`);
      return errors;
    }

    _.forEach(vm.requireFields, requireField => {
      if (isAllValidField(requireField)) {
        errors.push(`Bạn chưa điền đủ ${requireField}`);
      }
    });

    return errors;
  }

  vm.import = () => {
    if (!vm.rawItems) {
      return;
    }

    const errCreate = validateItems();

    if (errCreate.length) {
      _.forEach(errCreate, err => {
        return FhdMessenger.error(err);
      });

      return;
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ import ${vm.rawItems.length} woo product categories ?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      WooProductCategories.importWooProductCategories({
        rawItems: vm.rawItems
      }).$promise.then(wooProductCategories => {
        vm.wooProductCategories = wooProductCategories;
        return FhdMessenger.success(`Import ${wooProductCategories.length} woo product categories thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

// Woo product categories controller
angular.module('woo-product-categories').controller('WooProductCategoriesController', ['$stateParams', '$location', 'Authentication', 'WooProductCategories', '$http', 'FhdMessenger', 'ObjectId', 'NgTableParams', function ($stateParams, $location, Authentication, WooProductCategories, $http, FhdMessenger, ObjectId, NgTableParams) {
  const vm = this;
  vm.authentication = Authentication;
  vm.data = {};
  vm.data.wooProductCategories = WooProductCategories.query();
  vm.code = null;

  vm.newCode = function () {
    $http.get('/woo-product-categories/new-code').then(function (response) {
      var data = response.data;
      vm.code = data.code;
    }, function (error) {
      FhdMessenger.errorFromServer(error);
    });
  };

  vm.data.wooProductCategories.$promise.then(wooProductCategories => {
    vm.wooProductCategoryOptions = wooProductCategories.map(wooProductCategory => {
      return _.assign(wooProductCategory, {
        description: `${_.get(wooProductCategory, 'parent.name', 'Không có Category Cha')} -> ${wooProductCategory.name}`
      });
    });
  }); // Create new Woo product category

  vm.create = function () {
    var selectedParent = _.find(vm.data.wooProductCategories, {
      _id: vm.parent._id
    }); // Create new Woo product category object


    var wooProductCategory = new WooProductCategories({
      code: vm.code,
      name: vm.name,
      shortlink: vm.shortlink,
      slug: vm.slug,
      description: vm.description,
      display: 'default',
      imageLink: vm.imageLink,
      parentWebsiteId: selectedParent ? selectedParent.websiteId : null,
      parentCode: selectedParent ? selectedParent.code : null,
      parent: selectedParent ? selectedParent._id : null
    }); // Redirect after save

    wooProductCategory.$save(function (response) {
      $location.path('woo-product-categories/' + response._id);
    }, FhdMessenger.errorFromServer);
  }; // Remove existing Woo product category


  vm.remove = function (wooProductCategory) {
    if (wooProductCategory) {
      wooProductCategory.$remove();

      for (var i in vm.wooProductCategories) {
        if (vm.wooProductCategories[i] === wooProductCategory) {
          vm.wooProductCategories.splice(i, 1);
        }
      }
    } else {
      vm.wooProductCategory.$remove(function () {
        $location.path('woo-product-categories');
      }, FhdMessenger.errorFromServer);
    }
  }; // Update existing Woo product category


  vm.update = function () {
    var wooProductCategory = vm.wooProductCategory;

    var selectedParent = _.find(vm.data.wooProductCategories, {
      _id: ObjectId.getObjectId(wooProductCategory.parent)
    });

    wooProductCategory.parentWebsiteId = selectedParent ? selectedParent.websiteId : null;
    wooProductCategory.parentCode = selectedParent ? selectedParent.code : null;
    wooProductCategory.parent = selectedParent ? selectedParent._id : null;
    wooProductCategory.$update(function () {
      $location.path('woo-product-categories/' + wooProductCategory._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // function isChild(parentCategories) {
  //   return function(category) {
  //     return (
  //       !category.parent ||
  //       _.some(parentCategories, function(parentCategory) {
  //         return ObjectId.getObjectId(parentCategory) === ObjectId.getObjectId(category.parent)
  //       })
  //     )
  //   }
  // }
  // function createLevels(categories, parentCategories, levels) {
  //   levels = levels || []
  //   parentCategories = parentCategories || []
  //   var childCategories = []
  //   var grandChildCategories = []
  //   childCategories = _.filter(categories, isChild(parentCategories))
  //   grandChildCategories = _.reject(categories, isChild(parentCategories))
  //   levels.push(childCategories)
  //   if (grandChildCategories.length === 0) return levels
  //   else return createLevels(grandChildCategories, childCategories, levels)
  // }
  // const depthOf = function(object) {
  //   var level = 1
  //   var key
  //   for (key in object) {
  //     if (!object.hasOwnProperty(key)) continue
  //     if (typeof object[key] === 'object') {
  //       var depth = depthOf(object[key]) + 1
  //       level = Math.max(depth, level)
  //     }
  //   }
  //   return level
  // }


  vm.categoriesTable = new NgTableParams({}, {}); // Find a list of Woo product categories

  vm.find = function () {
    vm.wooProductCategories = WooProductCategories.query(categories => {
      vm.categoriesTable.settings({
        dataset: categories
      });
      vm.categoriesTable.sorting({
        'parent.name': 'desc',
        name: 'asc'
      });
    });
  }; // Find existing Woo product category


  vm.findOne = function () {
    vm.wooProductCategory = WooProductCategories.get({
      wooProductCategoryId: $stateParams.wooProductCategoryId
    });
  };
}]);
'use strict'; // Woo product categories service used to communicate Woo product categories REST endpoints

angular.module('woo-product-categories').factory('WooProductCategories', ['$resource', function ($resource) {
