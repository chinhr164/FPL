angular.module('inventory-counts').controller('InventoryCountsController', ['$scope', '$stateParams', '$location', 'Authentication', 'InventoryCounts', 'ObjectId', 'FhdMessenger', '$http', 'NgTableParams', '$localStorage', 'ConfirmModal', '$state', 'UserService', 'InventoryCountService', function ($scope, $stateParams, $location, Authentication, InventoryCounts, ObjectId, FhdMessenger, $http, NgTableParams, $localStorage, ConfirmModal, $state, UserService, InventoryCountService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;

  vm.isAuth = inventoryCount => {
    return vm.user.roles.includes('inventory-counts:edit') || _.isEqual(ObjectId.getObjectId(vm.user), ObjectId.getObjectId(inventoryCount.user));
  };

  vm.inventoryCount = {};
  vm.data = {};
  vm.selectedOutletIds = [];
  vm.staffs = [];
  vm.types = InventoryCountService.getTypes();
  vm.typeMap = {};
  vm.inventoryCount.inventoryCountType = '';
  vm.startDate = moment().subtract(1, 'week').startOf('week').format('YYYY-MM-DD');
  vm.endDate = moment().endOf('week').format('YYYY-MM-DD');
  vm.historyCountTable = new NgTableParams({
    page: 1
  }, {
    counts: []
  });
  vm.summaryInventoryCountsTable = new NgTableParams({
    count: 100
  });
  vm.inventoryCountItemsTable = new NgTableParams({
    count: 50
  }); // Create new Inventory count

  vm.create = function () {
    // Create new Inventory count object
    const inventoryCount = new InventoryCounts(vm.inventoryCount);

    if (vm.inventoryCount.inventoryCountType === '') {
      return FhdMessenger.error('Vui lòng chọn loại inventory count');
    } // Redirect after save


    inventoryCount.$save().then(inventoryCount => {
      $state.go('viewInventoryCount', {
        inventoryCountId: inventoryCount._id
      });
    }).catch(FhdMessenger.errorFromServer);
  }; // Remove existing Inventory count


  vm.remove = function (inventoryCount) {
    if (inventoryCount) {
      inventoryCount.$remove();

      const index = _.findIndex(vm.inventoryCounts, {
        _id: inventoryCount._id
      });

      if (index > -1) {
        vm.inventoryCounts.splice(index, 1);
        vm.inventoryCountsTable.reload();
      }
    } else {
      vm.inventoryCount.$remove(function () {
        $state.go('listInventoryCounts');
      });
    }
  };

  vm.productSearchSelected = product => {
    const matchItem = _.find(vm.inventoryCount.items, {
      sku: product.sku
    });

    if (matchItem) {
      return FhdMessenger.error(`Đã có sản phẩm ${product.sku} - ${product.description} trong danh sách`);
    }

    vm.inventoryCount.items.push({
      product: product.product,
      sku: product.sku,
      description: product.description,
      times: 0,
      status: 'counting'
    });
  };

  vm.removeProduct = index => {
    if (vm.inventoryCount.items[index].status !== 'counting') {
      return FhdMessenger.error('Sản phẩm đã được kiểm nên không thể xóa khỏi buổi kiểm hàng');
    }

    vm.inventoryCount.items.splice(index, 1);
  }; // Update existing Inventory count


  vm.update = function () {
    const inventoryCount = vm.inventoryCount;
    inventoryCount.$update(function () {
      $state.go('viewInventoryCount', {
        inventoryCountId: inventoryCount._id
      });
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.inventoryCountsTable = new NgTableParams({
    count: 1000
  }, {
    counts: []
  });
  vm.statuses = [{
    id: 'counting',
    title: 'counting'
  }, {
    id: 'pending',
    title: 'pending'
  }, {
    id: 'verified',
    title: 'verified'
  }, {
    id: 'matched',
    title: 'matched'
  }];

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.selectedOutletIds = _.map(selectedOutlets, outlet => outlet._id);
  };

  vm.onSelectAllType = () => {
    let changeValue = true;
    if (_.every(vm.typeMap)) changeValue = false;

    _.forEach(vm.typeMap, (value, key) => {
      vm.typeMap[key] = changeValue;
    });
  }; // Find a list of Inventory counts


  vm.find = function () {
    const searchText = _.isString(vm.searchText) ? vm.searchText.toUpperCase() : null;
    const startDate = vm.startDate || moment().startOf('week').format('YYYY-MM-DD');
    const endDate = vm.endDate || moment().endOf('week').format('YYYY-MM-DD');

    const inventoryCountTypes = _.reduce(vm.types, (result, type) => {
      if (vm.typeMap[type.id]) result.push(type.id);
      return result;
    }, []);

    vm.waiting = true;
    vm.inventoryCountsTable.settings({
      dataset: []
    });
    vm.inventoryCounts = InventoryCounts.query({
      startDate,
      endDate,
      searchText,
      outlets: vm.selectedOutletIds,
      inventoryCountTypes
    });
    vm.inventoryCounts.$promise.then(() => {
      if (vm.inventoryCounts.length === 100) {
        FhdMessenger.notifySticky('Chỉ hiển thị 100 kết quả đầu tiên. Hãy lọc theo thời gian, cơ sở để hiển thị đầy đủ kết quả');
      }

      vm.summary = {};
      vm.summary.totalItems = _.sumBy(vm.inventoryCounts, 'numberOfItems');
      vm.summary.totalCountedItems = _.sumBy(vm.inventoryCounts, 'numberOfCountedItems');
      vm.summary.progressPercentage = vm.summary.totalCountedItems / vm.summary.totalItems * 100;
      vm.summary.totalMatchedItems = _.sumBy(vm.inventoryCounts, 'numberOfMatchedItems');
      vm.summary.matchedPercentage = vm.summary.totalMatchedItems / vm.summary.totalCountedItems * 100;
      vm.inventoryCountsTable.settings({
        dataset: vm.inventoryCounts
      });
      vm.summaryInventoryCountsByOutlet();
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.summaryInventoryCountsByOutlet = function () {
    if (!_.intersection(vm.user.roles, ['admin', 'admin-stock']).length) {
      return;
    }

    vm.waiting = true;
    vm.summaryInventoryCountsTable.settings({
      dataset: []
    });
    InventoryCounts.summaryByOutlet({
      startDate: moment(vm.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.endDate).format('YYYY-MM-DD')
    }).$promise.then(res => {
      vm.summaryInventoryCountsTable.settings({
        dataset: res
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  function getValue(item) {
    if (_.get(item, 'product.price') > 0) {
      return _.get(item, 'diff', 0) * _.get(item, 'product.price');
    }

    return _.get(item, 'diff', 0) * _.get(item, 'product.cogs', 0);
  } // Find existing Inventory count


  vm.findOne = function () {
    vm.inventoryCount = InventoryCounts.get({
      inventoryCountId: $stateParams.inventoryCountId
    }, () => {
      vm.totalValue = 0;

      _.forEach(vm.inventoryCount.items, item => {
        item.diff = _.isFinite(item.countQuantity) ? item.countQuantity - item.expectedQuantity : null;
        item.times = _.get(item, 'counts.length');

        if (item.product.price > 0 && item.expectedQuantity) {
          vm.totalValue += item.expectedQuantity * item.product.price;
        }

        item.totalPrice = getValue(item);
      });

      vm.inventoryCountItemsTable.settings({
        dataset: vm.inventoryCount.items
      });

      if (vm.inventoryCount.startTime) {
        vm.inventoryCount.startTime = moment(vm.inventoryCount.startTime).toDate();
      }

      if (vm.inventoryCount.endTime) {
        vm.inventoryCount.endTime = moment(vm.inventoryCount.endTime).toDate();
      }

      if (vm.inventoryCount.openTime) {
        vm.inventoryCount.openTime = moment(vm.inventoryCount.openTime).toDate();
      }

      if (vm.inventoryCount.closeTime) {
        vm.inventoryCount.closeTime = moment(vm.inventoryCount.closeTime).toDate();
      }

      vm.historyCount = _.groupBy(_.sortBy(_.get(vm.inventoryCount, 'historyCount', []), 'time'), '_id');
      vm.historyCount = _.flattenDeep(_.map(vm.historyCount, listCount => {
        let countTime = 1;
        return _.map(listCount, count => {
          return _objectSpread({}, count, {
            user: _.get(count.user, 'displayName', 'Không rõ'),
            countTime: countTime++
          });
        });
      }));
      vm.historyCountTable.settings({
        dataset: vm.historyCount
      });
    });
  };

  vm.updateName = function (outlet) {
    if (outlet) {
      vm.inventoryCount.name = `${outlet.code} - Kiểm hàng ngày ${moment().format('YYYY-MM-DD')}`;
    }
  };

  vm.resetCount = function (product) {
    const inventoryCount = vm.inventoryCount;

    if (moment().isAfter(moment(inventoryCount.endTime))) {
      return FhdMessenger.error('Đã quá thời hạn reset Skus');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Bạn thực sự muốn reset số lần đếm, số lượng đếm của mã ${product.sku} - ${product.description}.`,
      actionButtonText: 'Reset'
    }).then(() => {
      return $http.put(`/inventory-counts/${inventoryCount._id}/reset`, {
        productId: product.product
      }).then(() => {
        product.counts = [];
        product.countQuantity = null;
        product.expectedQuantity = null;
        product.verified = null;
        product.verifiedBy = null;
        product.diff = null;
        product.times = 0;
        product.status = 'counting';
        FhdMessenger.info('Ok');
      }).catch(FhdMessenger.errorFromServer);
    });
  };

  vm.removeItem = function (product) {
    const inventoryCount = vm.inventoryCount;

    if (moment().isAfter(moment(inventoryCount.endTime))) {
      return FhdMessenger.error('Đã quá thời hạn xóa Skus');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Bạn thực sự muốn xóa mã ${product.sku} - ${product.description} khỏi buổi kiểm hàng?
Nếu mã này đã được kiểm, số hàng tồn sẽ được khôi phục về trước khi kiểm.`,
      actionButtonText: 'Remove'
    }).then(() => {
      return $http.put(`/inventory-counts/${inventoryCount._id}/remove`, {
        productId: product.product
      }).then(() => {
        const matchIndex = _.findIndex(vm.inventoryCount.items, {
          product: product.product
        });

        if (matchIndex > -1) {
          vm.inventoryCount.items.splice(matchIndex, 1);
          vm.inventoryCountItemsTable.reload();
        }

        vm.inventoryCount.numberOfCountedItems -= 1;
        vm.inventoryCount.numberOfItems -= 1;
        FhdMessenger.info('Ok');
      }).catch(FhdMessenger.errorFromServer);
    });
  };

  vm.searchKeyUp = function ($event) {
    if ($event.keyCode === 13) vm.find();
  };

  vm.openViewDetailInventoryCountPoints = InventoryCountService.openViewDetailPointInventoryCountModal;

  vm.getDiffTime = item => {
    if (!item.counts.length || item.counts.length < 2) {
      return 0;
    }

    const diffSecondTime = moment(item.counts[1].time).diff(moment(item.counts[0].time), 'second') / 60;
    return diffSecondTime;
  };
}]);
"use strict";

