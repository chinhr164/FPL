angular.module('expense-entries').config(['$stateProvider', function ($stateProvider) {
  // Expenses state routing
  $stateProvider.state('listExpenseEntries', {
    url: '/expense-entries',
    templateUrl: 'modules/expense-entries/views/list-expense-entries.client.view.html',
    resolve: {
      $title: _.constant('Expenses Entries')
    }
  }).state('createExpenseEntry', {
    url: '/expense-entries/create',
    templateUrl: 'modules/expense-entries/views/create-expense-entry.client.view.html',
    resolve: {
      $title: _.constant('Create Expenses Entry')
    }
  }).state('importUpdateExpenseCategory', {
    url: '/expense-entries/import-update-expense-category',
    templateUrl: 'modules/expense-entries/views/import-update-expense-category.client.view.html',
    resolve: {
      $title: _.constant('Import Update Expense Category')
    }
  }).state('viewExpenseEntry', {
    url: '/expense-entries/:expenseEntryId',
    templateUrl: 'modules/expense-entries/views/view-expense-entry.client.view.html',
    resolve: {
      $title: _.constant('View Expense Entry')
    }
  });
}]);
"use strict";

angular.module('expense-entries').controller('ExpenseEntryController', ['$state', 'Authentication', 'BuyingEntryService', 'ConfirmModal', 'FhdMessenger', 'NgTableParams', 'ExpenseEntryService', 'ExpenseEntries', 'ExpenseSubCategories', 'ObjectId', '$stateParams', 'UserPhotoService', '$scope', '$q', function ($state, Authentication, BuyingEntryService, ConfirmModal, FhdMessenger, NgTableParams, ExpenseEntryService, ExpenseEntries, ExpenseSubCategories, ObjectId, $stateParams, UserPhotoService, $scope, $q) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.isAdmin = _.intersection(['admin', 'accountant'], vm.user.roles).length;
  vm.data = {};
  vm.outlet = null;
  vm.outlets = [];
  vm.data.type = 'all';
  vm.expenseEntry = {};
  vm.data.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.expenseEntriesTable = new NgTableParams({
    count: 50
  });
  $scope.$watch(() => {
    if (vm.expenseEntry.costAllocation) return vm.expenseEntry.costAllocation.startDate;
  }, () => {
    if (vm.expenseEntry.costAllocation) {
      vm.expenseEntry.costAllocation.startDate = moment(vm.expenseEntry.costAllocation.startDate).format('YYYY-MM');
    }
  });
  $scope.$watch(() => {
    if (vm.expenseEntry.costAllocation) return vm.expenseEntry.costAllocation.endDate;
  }, () => {
    if (vm.expenseEntry.costAllocation) {
      vm.expenseEntry.costAllocation.endDate = moment(vm.expenseEntry.costAllocation.endDate).format('YYYY-MM');
    }
  });
  $scope.$watch(() => vm.outlet, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    const outletId = ObjectId.getObjectId(vm.outlet);

    const mapOutletId = _.map(vm.outlets, '_id');

    if (!mapOutletId.includes(outletId)) {
      vm.outlets.push(newValue);
    }
  });

  vm.removeOutlet = index => {
    vm.outlets.splice(index, 1);
  };

  vm.openModalFindBuyingEntries = function () {
    BuyingEntryService.openFindMultiBuyingEntriesModal().result.then(buyingEntries => {
      vm.expenseEntry.buyingEntries = vm.expenseEntry.buyingEntries || [];

      _.forEach(buyingEntries, buyingEntry => {
        vm.expenseEntry.buyingEntries.push(buyingEntry);
      });

      vm.expenseEntry.buyingEntries = _.uniqBy(vm.expenseEntry.buyingEntries, buyingEntry => {
        return buyingEntry.buyingEntryId;
      });
      vm.expenseEntry.description = `Nhập hàng Buying Entry ${_.reduce(vm.expenseEntry.buyingEntries, (result, buyingEntry) => {
        return `${result} ${buyingEntry.buyingEntryId}`;
      }, '')}`;
    });
  };

  vm.init = function () {
    vm.expenseSubCategoriesPromise = ExpenseSubCategories.query().$promise.then(expenseSubCategories => {
      vm.data.expenseCategories = _.reduce(expenseSubCategories, (result, expenseSubCategory) => {
        result.push({
          expenseSubCategory: {
            _id: ObjectId.getObjectId(expenseSubCategory),
            name: expenseSubCategory.name
          },
          expenseCategory: expenseSubCategory.expenseCategory
        });
        return result;
      }, []);
      vm.expenseEntry.images = vm.expenseEntry.images || [];
    });
  };

  vm.statusMap = {
    open: true,
    void: false,
    closed: true
  };

  vm.find = () => {
    vm.expenseEntriesTable.settings().dataset = [];
    vm.expenseEntriesTable.reload();

    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const subCatgory = _.get(vm.data.category, 'expenseSubCategory', null);

    vm.expenseEntries = ExpenseEntries.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      statuses,
      outlet: ObjectId.getObjectId(vm.outlet),
      costAllocationOutlet: ObjectId.getObjectId(vm.costAllocationOutlet),
      shift: vm.shift ? vm.shift.code : null,
      business: vm.business ? vm.business._id : null,
      type: vm.data.type,
      category: _.get(subCatgory, '_id', null)
    }, function () {
      vm.expenseEntries = _.map(vm.expenseEntries, expenseEntry => {
        if (expenseEntry.costAllocation.outlets.length) {
          expenseEntry.outlets = _.map(expenseEntry.costAllocation.outlets, 'outletCode').join(' ');
        } else {
          expenseEntry.outlets = _.get(expenseEntry, 'outlet.code', 'N/A');
        }

        return expenseEntry;
      });
      vm.expenseEntriesTable.settings({
        dataset: vm.expenseEntries
      });
      vm.totalExpenseEntries = _.reduce(vm.expenseEntries, (result, expenseEntry) => {
        return result + expenseEntry.amount;
      }, 0);
    });
    FhdMessenger.notifyLoading('Đang tải...', vm.expenseEntries.$promise, () => {
      FhdMessenger.success('Tải xong.');
    });
  };

  vm.findOne = function () {
    $q.all([vm.expenseSubCategoriesPromise]).then(() => {
      vm.expenseEntry = ExpenseEntries.get({
        expenseEntryId: $stateParams.expenseEntryId
      });
      vm.expenseEntry.$promise.then(expenseEntry => {
        vm.expenseEntry.costAllocation = vm.expenseEntry.costAllocation || {};

        if (!_.get(vm.expenseEntry.costAllocation, 'outlets.length', false) && expenseEntry.outlet) {
          vm.expenseEntry.costAllocation.outlets = [{
            outletCode: expenseEntry.outlet.code,
            outlet: expenseEntry.outlet._id,
            allocationRate: 1
          }];
        }

        vm.expenseEntry.category = _.find(vm.data.expenseCategories, expenseCategory => {
          return ObjectId.getObjectId(expenseCategory.expenseSubCategory) === ObjectId.getObjectId(expenseEntry.category.expenseSubCategory);
        });
      });
    });
    $scope.$watch(() => vm.addonOutlet, (newValue, oldValue) => {
      if (!newValue || newValue === oldValue || !newValue.code) return;
      const outletId = ObjectId.getObjectId(vm.addonOutlet);

      const mapOutletId = _.map(vm.expenseEntry.costAllocation.outlets, 'outlet');

      if (!mapOutletId.includes(outletId)) {
        vm.expenseEntry.costAllocation.outlets.push({
          outlet: newValue._id,
          allocationRate: 1,
          outletCode: newValue.code
        });
      }
    });

    vm.removeAddonOutlet = index => {
      vm.expenseEntry.costAllocation.outlets.splice(index, 1);
    };

    vm.expenseEntry = ExpenseEntries.get({
      expenseEntryId: $stateParams.expenseEntryId
    });
    vm.expenseEntry.$promise.then(expenseEntry => {
      vm.expenseEntry.costAllocation = vm.expenseEntry.costAllocation || {};

      if (!_.get(vm.expenseEntry.costAllocation, 'outlets.length', false)) {
        vm.expenseEntry.costAllocation.outlets = [{
          outletCode: expenseEntry.outlet.code,
          outlet: expenseEntry.outlet._id,
          allocationRate: 1
        }];
      }

      vm.expenseEntry.category = _.find(vm.data.expenseCategories, expenseCategory => {
        return ObjectId.getObjectId(expenseCategory.expenseSubCategory) === ObjectId.getObjectId(expenseEntry.category.expenseSubCategory);
      });
    });
  };

  vm.removeBuyingEntry = index => {
    vm.expenseEntry.buyingEntries.splice(index, 1);
  };

  vm.update = function () {
    if (!_.get(vm.expenseEntry, 'costAllocation.totalMonths') && _.get(vm.expenseEntry, 'costAllocation.startDate') || _.get(vm.expenseEntry, 'costAllocation.totalMonths') && !_.get(vm.expenseEntry, 'costAllocation.startDate')) {
      return FhdMessenger.error('Phải có số tháng phân bổ và ngày bắt đầu');
    }

    if (_.get(vm.expenseEntry, 'costAllocation.totalMonths') && _.get(vm.expenseEntry, 'costAllocation.startDate')) {
      vm.expenseEntry.costAllocation.endDate = moment(vm.expenseEntry.costAllocation.startDate).add(vm.totalMonths - 1, 'month').endOf('month').toDate();
    }

    vm.waiting = true;
    vm.expenseEntry.$update().then(() => {
      FhdMessenger.success('Cập nhật thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.getStatus = () => [{
    title: 'Đã duyệt',
    id: 'closed'
  }, {
    title: 'Chờ duyệt',
    id: 'open'
  }, {
    title: 'Đã xóa',
    id: 'void'
  }];

  vm.selectAllStatus = function () {
    let changeValue = true;
    if (_.every(vm.statusMap)) changeValue = false;

    _.forEach(vm.statusMap, (value, key) => {
      vm.statusMap[key] = changeValue;
    });
  };

  vm.findBuyingEntry = function (buyingEntryId) {
    if (!buyingEntryId) {
      return FhdMessenger.error('Chưa nhập mã Buying Entry để tìm');
    }

    BuyingEntryService.findByBuyingEntryId(buyingEntryId).then(buyingEntry => {
      if (_.some(vm.expenseEntry.buyingEntries, {
        _id: buyingEntry._id
      })) {
        return FhdMessenger.error('Buying Entry này đã có trong danh sách');
      }

      vm.expenseEntry.buyingEntries = vm.expenseEntry.buyingEntries || [];
      vm.expenseEntry.buyingEntries.push(buyingEntry);
      vm.expenseEntry.description = `Nhập hàng Buying Entry ${_.reduce(vm.expenseEntry.buyingEntries, (result, buyingEntry) => {
        return `${result} ${buyingEntry.buyingEntryId}`;
      }, '')}`;
      vm.buyingEntryId = null;
    });
  };

  vm.create = function () {
    if (!_.get(vm.expenseEntry.category, 'expenseSubCategory') || !_.get(vm.expenseEntry.category, 'expenseCategory')) {
      return FhdMessenger.error('Chưa có phân loại khoản chi');
    }

    if (!vm.expenseEntry.fromAccount) {
      return FhdMessenger.error('Chưa có tài khoản chi');
    }

    if (!vm.expenseEntry.description) {
      return FhdMessenger.error('Chưa có mô tả của khoản chi');
    }

    if (!vm.expenseEntry.amount) {
      return FhdMessenger.error('Chưa có tổng tiền của khoản chi');
    }

    if (_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/Điện sinh hoạt/)) {
      if (!_.get(vm.expenseEntry, 'images.length')) {
        return FhdMessenger.error('Khoản chi điện sinh hoạt bắt buộc có ảnh hóa đơn');
      }

      if (!_.get(vm.expenseEntry, 'electricalNumber')) {
        return FhdMessenger.error('Khoản chi điện sinh hoạt bắt buộc có số công tơ điện cuối kì');
      }
    }

    vm.expenseEntry.category.expenseSubCategory = vm.expenseEntry.category.expenseSubCategory._id;
    vm.expenseEntry.date = moment(vm.expenseEntry.date).startOf('day').toDate();

    if (_.get(vm.expenseEntry, 'fromAccount.needApproveExpenseEntry')) {
      vm.expenseEntry.status = 'open';
    } else {
      vm.expenseEntry.status = 'closed';
    }

    vm.expenseEntry.buyingEntry = _.get(vm.buyingEntry, '_id');
    vm.expenseEntry.account = _.get(vm.expenseEntry.account, '_id', undefined);
    vm.waiting = true;

    if (!vm.outlets.length) {
      const expenseEntry = new ExpenseEntries(_.cloneDeep(vm.expenseEntry));
      return expenseEntry.$save().then(response => {
        vm.expenseEntry = {};
        FhdMessenger.success('Tạo khoản chi thành công');
      }).catch(err => {
        vm.expenseEntry = {};
        FhdMessenger.error(err.data.message);
        vm.init();
      }).finally(() => {
        vm.waiting = false;
      });
    } else {
      const mapPromise = _.map(vm.outlets, outlet => {
        const expenseEntry = new ExpenseEntries(_.cloneDeep(vm.expenseEntry));
        expenseEntry.outlet = outlet;
        expenseEntry.amount /= vm.outlets.length;
        return expenseEntry;
      });

      const numberExpenseEntry = vm.outlets.length - 1;

      _.forEach(mapPromise, (expenseEntry, index) => {
        const outletCode = _.get(expenseEntry.outlet, 'code');

        return expenseEntry.$save().then(response => {
          vm.expenseEntry = {};
          vm.outlets = [];
          FhdMessenger.success(`Tạo khoản chi cho cơ sở ${outletCode} thành công`);
        }).catch(err => {
          vm.expenseEntry = {};
          vm.outlets = [];
          FhdMessenger.error(`Lỗi tạo khoản chi cơ sở ${outletCode}: ${err.data.message}`);
          vm.init();
        }).finally(() => {
          if (index === numberExpenseEntry) vm.waiting = false;
        });
      });
    }
  };

  vm.approve = function (expenseEntry) {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Không',
      actionButtonText: 'Duyệt',
      headerText: 'Duyệt khoản chi?',
      bodyText: `Bạn có muốn duyệt khoản chi ${expenseEntry.description}`
    }).then(() => {
      expenseEntry.$approve().then(response => response.data).then(() => {
        FhdMessenger.success('Đã duyệt');
      }).catch(FhdMessenger.errorFromServer);
    });
  }; // Remove existing Calendar entry


  vm.remove = function (expenseEntry) {
    if (expenseEntry) {
      ConfirmModal.showModal({}, {
        closeButtonText: 'Không',
        actionButtonText: 'Xóa',
        headerText: 'Xóa khoản chi?',
        bodyText: `Bạn có muốn xóa khoản chi ${expenseEntry.description}`
      }).then(() => {
        expenseEntry.$remove();

        const matchIndex = _.find(vm.expenseEntries, expenseEntry);

        if (matchIndex > -1) {
          vm.expenseEntries.splice(matchIndex, 1);
        }
      });
    } else {
      ConfirmModal.showModal({}, {
        closeButtonText: 'Không',
        actionButtonText: 'Xóa',
        headerText: 'Xóa khoản chi?',
        bodyText: `Bạn có muốn xóa khoản chi ${vm.expenseEntry.description}`
      }).then(() => {
        vm.expenseEntry.$remove(function () {
          $state.go('listExpenseEntries');
        }, FhdMessenger.errorFromServer);
      });
    }
  };

  vm.openModalViewExpenseEntry = ExpenseEntryService.openViewExpenseEntry;
}]);
'use strict';

angular.module('products').controller('ImportUpdateExpenseCategoryController', ['Authentication', 'ExpenseEntries', 'FhdMessenger', 'ConfirmModal', function (Authentication, ExpenseEntries, FhdMessenger, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.requireFields = 'expenseEntryId expenseSubCategory'.split(' ');

  function isAllValidField(field) {
    return _.some(vm.rawItems, item => {
      return !_.get(item, field) && _.get(item, field) !== 0;
    });
  }

  function validateExpenseEntries() {
    let errors = [];

    _.forEach(vm.requireFields, requireField => {
      if (isAllValidField(requireField)) {
        errors.push(`Bạn chưa điền đủ ${requireField}`);
      }
    });

    return errors;
  }

  vm.update = () => {
    if (!vm.rawItems) {
      return;
    }

    const errors = validateExpenseEntries();

    if (errors.length) {
      return _.forEach(errors, err => FhdMessenger.error(err));
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ update ${vm.rawItems.length} expense entries?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      ExpenseEntries.importUpdateExpeseCategory({
        rawItems: vm.rawItems
      }).$promise.then(expenseEntries => {
        console.log(expenseEntries);
        vm.updatedExpenseEntries = expenseEntries;
        return FhdMessenger.success(`Update ${expenseEntries.length} ExpenseEntries thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('expense-entries').controller('ModalCreateExpenseEntryController', ['$modalInstance', 'workTask', 'buyingEntries', 'deliverEntries', 'Authentication', 'BuyingEntryService', 'CurrentShift', 'DeliverEntryService', 'ExpenseEntries', 'ExpenseEntryService', 'ExpenseSubCategories', 'FhdMessenger', 'ObjectId', 'UserPhotoService', 'Vendors', '$http', '$state', function ($modalInstance, workTask, buyingEntries, deliverEntries, Authentication, BuyingEntryService, CurrentShift, DeliverEntryService, ExpenseEntries, ExpenseEntryService, ExpenseSubCategories, FhdMessenger, ObjectId, UserPhotoService, Vendors, $http, $state) {
  const vm = this;
  vm.user = Authentication.user;
  vm.adminStaff = _.intersection(['admin', 'accountant'], vm.user.roles).length;
  vm.needImageExpenses = ['Dụng cụ/ Đồ dùng vận hành', 'Gas', 'Internet', 'Nước sinh hoạt', 'Điện sinh hoạt', 'Thẻ điện thoại', 'Vệ sinh môi trường', 'Tài sản cố định', 'Chi phí khác', 'Chi phí sửa chữa, thay thế CSVC', 'Cho vay', 'Thuế', 'Đồ văn phòng phẩm'];
  vm.data = {};
  vm.expenseEntry = {};
  vm.expenseEntry.buyingEntries = [];
  vm.expenseEntry.deliverEntries = [];
  vm.transporterService = null;
  vm.forCreatedSaleReport = false;

  function getTransporterService(input) {
    const listTransporterServices = DeliverEntryService.getTransporterService();

    const matchTransporter = _.find(listTransporterServices, {
      value: input
    });

    return _.get(matchTransporter, 'name', input);
  }

  vm.processDeliverEntries = deliverEntries => {
    vm.expenseEntry.description = `Thanh toán Deliver Entry ${_.reduce(deliverEntries, (result, deliverEntry) => {
      return `${result} ${deliverEntry.deliverEntryId}`;
    }, '')}`;
    vm.expenseEntry.amount = _.reduce(deliverEntries, (result, deliverEntry) => {
      result += deliverEntry.deliverFee;
      return result;
    }, 0);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  if (_.get(buyingEntries, 'length')) {
    vm.buyingEntries = buyingEntries;
    vm.expenseEntry.buyingEntries = buyingEntries;
    vm.expenseEntry.description = `Nhập hàng Buying Entry ${_.reduce(vm.expenseEntry.buyingEntries, (result, buyingEntry) => {
      return `${result} ${buyingEntry.buyingEntryId}`;
    }, '')}`;
    vm.expenseEntry.outlet = buyingEntries[0].destination;
  } else if (_.get(deliverEntries, 'length')) {
    vm.deliverEntries = deliverEntries;
    vm.expenseEntry.deliverEntries = deliverEntries;
    vm.processDeliverEntries(vm.expenseEntry.deliverEntries);
  } else if (workTask) {
    vm.expenseEntry.workTask = workTask._id;
    vm.expenseEntry.outlet = workTask.outlet;
  }

  vm.init = function () {
    ExpenseSubCategories.query({
      isPrivate: false
    }).$promise.then(expenseSubCategories => {
      vm.data.expenseCategories = _.reduce(expenseSubCategories, (result, expenseSubCategory) => {
        result.push({
          expenseSubCategory: {
            _id: ObjectId.getObjectId(expenseSubCategory),
            name: expenseSubCategory.name
          },
          expenseCategory: expenseSubCategory.expenseCategory
        });
        return result;
      }, []);
      vm.expenseEntry.images = vm.expenseEntry.images || [];

      if (_.get(vm, 'buyingEntries.length')) {
        vm.expenseEntry.category = _.find(vm.data.expenseCategories, expenseCategory => {
          return expenseCategory.expenseSubCategory.name === 'Nhập hàng';
        });
        return;
      }

      if (_.get(vm, 'expenseEntry.workTask')) {
        vm.expenseEntry.category = _.find(vm.data.expenseCategories, expenseCategory => {
          return expenseCategory.expenseSubCategory.name === 'Chi phí sửa chữa, thay thế CSVC';
        });
        return;
      }

      if (_.get(vm, 'deliverEntries.length')) {
        vm.transporterService = getTransporterService(_.get(_.head(deliverEntries), 'transporter.transporterService', null));
        vm.expenseEntry.category = _.find(vm.data.expenseCategories, expenseCategory => {
          return expenseCategory.expenseSubCategory.name === `Phí ship restock (${vm.transporterService})`;
        });
      }
    });
    Vendors.getIceVendors().$promise.then(vendors => {
      vm.data.vendors = vendors;
    });
  };

  vm.currentShift = CurrentShift.getCurrentShift();

  vm.addImage = newImage => {
    if (newImage) {
      vm.expenseEntry.images.push({
        data: newImage
      });
    }
  };

  vm.choosePhotos = () => {
    UserPhotoService.view().then(photos => {
      photos.forEach(photo => vm.expenseEntry.images.push({
        link: photo.link
      }));
    });
  };

  vm.removeImage = index => {
    vm.expenseEntry.images.splice(index, 1);
  };

  vm.findBuyingEntry = function (buyingEntryId) {
    if (!buyingEntryId) {
      return FhdMessenger.error('Chưa nhập mã Buying Entry để tìm');
    }

    BuyingEntryService.findByBuyingEntryId(buyingEntryId).then(buyingEntry => {
      if (vm.currentShift && vm.currentShift.outlet && buyingEntry.destination.code !== vm.currentShift.outlet.code) {
        vm.buyingEntryId = null;
        return FhdMessenger.error('Buying này không thuộc về cơ sở của bạn. Vui lòng kiểm tra lại');
      }

      if (_.some(vm.expenseEntry.buyingEntries, {
        _id: buyingEntry._id
      })) {
        return FhdMessenger.error('Buying Entry này đã có trong danh sách');
      }

      vm.expenseEntry.buyingEntries = vm.expenseEntry.buyingEntries || [];
      vm.expenseEntry.buyingEntries.push(buyingEntry);
      vm.expenseEntry.description = `Nhập hàng Buying Entry ${_.reduce(vm.expenseEntry.buyingEntries, (result, buyingEntry) => {
        return `${result} ${buyingEntry.buyingEntryId}`;
      }, '')}`;
      vm.buyingEntryId = null;
    });
  };

  vm.findDeliveryEntry = function (deliverEntryId) {
    if (!deliverEntryId) {
      return FhdMessenger.error('Chưa nhập mã DE nào');
    }

    deliverEntryId = `DE${deliverEntryId.replace(new RegExp(/\D/, 'g'), '').trim()}`;
    $http.post('/deliver-entries/find-by-deliver-id', {
      deliverEntryId
    }).then(response => {
      const deliverEntry = response.data;

      if (!deliverEntry._id) {
        return FhdMessenger.error('Không tìm thấy DE tương ứng');
      }

      if (!deliverEntry.deliverFee) {
        return FhdMessenger.error('DE chưa có chi phí');
      }

      if (deliverEntry.paymentStatus === 'paid') {
        return FhdMessenger.error('DE đã tạo khoản chi');
      }

      if (getTransporterService(deliverEntry.transporter.transporterService) !== vm.transporterService) {
        return FhdMessenger.error('DE có hình thức vận chuyển không cùng nhóm');
      }

      if (!_.find(vm.expenseEntry.deliverEntries, deliverEntry => deliverEntry.deliverEntryId === deliverEntryId)) {
        vm.expenseEntry.deliverEntries.push(deliverEntry);
        vm.processDeliverEntries(vm.expenseEntry.deliverEntries);
      }

      vm.deliverEntryId = null;
    }).catch(err => FhdMessenger.error(err.message));
  };

  vm.removeBuyingEntry = index => {
    vm.expenseEntry.buyingEntries.splice(index, 1);
  };

  vm.removeDeliverEntry = index => {
    vm.expenseEntry.deliverEntries.splice(index, 1);
    vm.processDeliverEntries(vm.expenseEntry.deliverEntries);
  };

  vm.create = function () {
    vm.expenseEntry.notes = [];

    if (!vm.expenseEntry.category.expenseSubCategory || !vm.expenseEntry.category.expenseCategory) {
      return FhdMessenger.error('Chưa có phân loại khoản chi');
    }

    if (!vm.expenseEntry.amount) {
      return FhdMessenger.error('Chưa có tổng tiền của khoản chi');
    }

    if (!vm.expenseEntry.description) {
      return FhdMessenger.error('Chưa có mô tả của khoản chi');
    }

    if (_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/Nhập hàng/) && !_.get(vm.expenseEntry, 'buyingEntries.length')) {
      return FhdMessenger.error('Khoản chi nhập hàng cần có Buying Entry');
    }

    if (_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/Phí ship restock/) && !_.get(vm.expenseEntry, 'deliverEntries.length')) {
      return FhdMessenger.error('Khoản chi cần có Deliver Entry');
    }

    if (_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/Điện sinh hoạt/)) {
      if (!_.get(vm.expenseEntry, 'images.length')) {
        return FhdMessenger.error('Khoản chi điện sinh hoạt bắt buộc có ảnh hóa đơn');
      }

      if (!_.get(vm.expenseEntry, 'electricalNumber')) {
        return FhdMessenger.error('Khoản chi điện sinh hoạt bắt buộc có số công tơ điện cuối kì');
      }
    }

    if (_.get(vm.expenseEntry, 'category.expenseCategory', '').match(/Nhận thêm tiền doanh thu/)) {
      if (vm.expenseEntry.amount > 0) {
        return FhdMessenger.error('Khoản chi nhận thêm doanh thu phải là số âm');
      }
    }

    if (!vm.adminStaff && _.get(vm.expenseEntry, 'category.expenseCategory', '') === 'Chênh lệch doanh thu' || _.get(vm.expenseEntry, 'category.expenseSubCategory.name', '') === 'Chi phí nhân sự' && Authentication.user.business.code === 'SAVOR') {
      if (!vm.expenseEntry.saleEntry) {
        return FhdMessenger.error('Chưa điền mã đơn hàng');
      }
    }

    if (!vm.adminStaff && vm.needImageExpenses.includes(_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '')) && !_.get(vm.expenseEntry.images, 'length', 0)) {
      return FhdMessenger.error('Khoản chi bắt buộc phải có ảnh');
    }

    if (_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/Trả lại khách đơn/)) {
      if (!vm.expenseEntry.saleEntry) {
        return FhdMessenger.error('Bạn cần nhập mã Sale Entry tại cửa hàng');
      }
    }

    if (_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/Mua đá cơ sở/)) {
      if (!_.get(vm.expenseEntry, 'vendor')) {
        return FhdMessenger.error('Khoản chi đá cơ sở cần có vendor');
      }

      if (!_.get(vm.expenseEntry, 'iceQuantity')) {
        return FhdMessenger.error('Khoản chi đá cơ sở cần có số lượng đá đã nhập');
      }
    }

    if (vm.expenseEntry.category.expenseCategory.match(/Cho vay/) && !vm.expenseEntry.borrowStaff) {
      return FhdMessenger.error('Khoản cho vay cần có nhân viên vay tiền');
    }

    if (!vm.buyingEntries && !vm.deliverEntries && !vm.expenseEntry.workTask) {
      if (!vm.currentShift.outlet) {
        return FhdMessenger.error('Bạn chưa đăng nhập ca trực');
      }

      vm.expenseEntry.outlet = vm.currentShift.outlet;

      if (!vm.forCreatedSaleReport) {
        vm.expenseEntry.shift = vm.currentShift.shift;
        vm.expenseEntry.date = vm.currentShift.date;
      } else {
        vm.expenseEntry.shift = vm.expenseEntry.shift.code;

        if (ExpenseEntryService.canCreateExpenseEntryForCreatedSaleReport(vm.expenseEntry)) {
          return FhdMessenger.error('Chỉ khoản vay hoặc nhập hàng mới được dùng doanh thu của ca khác để chi');
        }
      }

      if (!vm.expenseEntry.shift) {
        return FhdMessenger.error('Chưa có ca trực của khoản chi');
      }

      if (!vm.expenseEntry.date) {
        return FhdMessenger.error('Chưa có ngày của khoản chi');
      }

      vm.expenseEntry.status = 'closed';
    } else {
      vm.expenseEntry.status = 'closed';
      vm.expenseEntry.shift = undefined;
    }

    if (vm.expenseEntry.shift || vm.expenseEntry.workTask //   _.get(vm.expenseEntry, 'outlet.code', '') === 'M1' &&
    //   _.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/(Cho vay)/)
    ) {
        vm.expenseEntry.status = 'open';
      } else {
      vm.expenseEntry.status = 'closed';
    }

    vm.expenseEntry.date = moment(vm.expenseEntry.date).startOf('day').toDate();
    vm.expenseEntry.forCreatedSaleReport = vm.forCreatedSaleReport;

    if (vm.content) {
      vm.expenseEntry.notes.push({
        content: vm.content,
        user: vm.user
      });
    }

    vm.expenseEntry.staffType = 'cashier';
    const expenseEntry = new ExpenseEntries(_.cloneDeep(vm.expenseEntry));
    vm.waiting = true;
    return expenseEntry.$save().then(response => {
      FhdMessenger.success('Tạo khoản chi thành công');
      $modalInstance.close();
    }).catch(err => {
      FhdMessenger.error(err.data.message);
      vm.init();
    }).finally(() => {
      vm.waiting = false;
      $state.reload();
    });
  };
}]);
"use strict";

angular.module('expense-entries').controller('ModalViewExpenseEntryController', ['FhdMessenger', 'expenseEntry', '$modalInstance', function (FhdMessenger, expenseEntry, $modalInstance) {
