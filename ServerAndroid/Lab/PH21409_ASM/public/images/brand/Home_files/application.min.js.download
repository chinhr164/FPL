      displayName: 'Chu Huy Thắng',
      outletCode: 'TECH'
    };
    vm.reviewers = [{
      code: 'F432',
      displayName: 'Lê Tuấn Hiệp',
      outletCode: 'OFFICE'
    }, {
      code: 'D708',
      displayName: 'Đinh Phương Thảo',
      outletCode: 'TECH'
    }, defaultReviewer];
    vm.reviewer = _.find(vm.reviewers, {
      code: _.get(vm.workTask, 'reviewer.code')
    }) || defaultReviewer;
    vm.pullRequestLink = _.get(vm.workTask, 'pullRequestLink');
  };

  vm.submit = function () {
    $modalInstance.close({
      pullRequestLink: vm.pullRequestLink,
      reviewer: vm.reviewer
    });
  };
