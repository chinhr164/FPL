angular.module('tet-categories').controller('TetCategoriesController', ['$stateParams', '$state', 'helper', 'Authentication', 'FhdMessenger', 'ConfirmModal', 'TetCategoriesService', '$q', 'TetCategories', 'NgTableParams', '$location', function ($stateParams, $state, helper, Authentication, FhdMessenger, ConfirmModal, TetCategoriesService, $q, TetCategories, NgTableParams, $location) {
  const vm = this;
  vm.user = Authentication.user;
  vm.removeValueFromArray = helper.removeValueFromArray;
  vm.tetCategoriesTable = new NgTableParams();

  vm.find = () => {
    FhdMessenger.info('Đang tìm...');
    vm.tetCategories = TetCategories.query();
    vm.tetCategories.$promise.then(() => {
      vm.tetCategoriesTable.settings({
        dataset: vm.tetCategories
      });
      vm.tetCategoriesTable.reload();
      FhdMessenger.success('Tải xong ');
    });
  };

  vm.findOne = () => {
    FhdMessenger.info('Đang tìm...');
    TetCategories.get({
      tetCategoryId: $stateParams.tetCategoryId
    }).$promise.then(tetCategory => {
      vm.tetCategory = tetCategory;
    });
  };

  vm.update = () => {
    const tetCategory = vm.tetCategory;
    const err = TetCategoriesService.validateTetCategory(tetCategory);

    if (err) {
      return FhdMessenger.error(err);
    }

    vm.waiting = true;
    tetCategory.$update().then(() => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('tet-categories');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
