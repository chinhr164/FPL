angular.module('business-customers').controller('BusinessCustomersController', ['$stateParams', '$location', '$scope', 'Authentication', 'BusinessCustomers', 'FhdMessenger', 'Address', 'NgTableParams', function ($stateParams, $location, $scope, Authentication, BusinessCustomers, FhdMessenger, Address, NgTableParams) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {
    types: ['Sản xuất', 'Thương mại', 'Đại lý chưa kí hợp đồng', 'Đại lý cấp 3', 'Đại lý cấp 2'],
    sources: ['Web', 'Tự tìm'],
    payment: ['Thanh toán trước khi nhận hàng', 'Thanh toán sau khi nhận hàng', 'Công nợ'],
    startDate: moment().subtract(1, 'month').format('YYYY/MM/DD'),
    endDate: moment().format('YYYY/MM/DD'),
    status: ['active', 'inactive', 'pending'],
    showStatus: {
      active: true,
      inactive: false,
      pending: true
    }
  };
  vm.businessCustomersTable = new NgTableParams();
  vm.type = 'Sản xuất';
  vm.source = 'Web';
  vm.products = [];
  vm.data.districts = Address.getDistricts();

  vm.init = () => {
    // Create new Business object
    vm.productSearchSelected = function (item) {
      vm.products = vm.products || [];

      const matchItemIndex = _.findIndex(vm.products, {
        sku: item.sku
      });

      if (matchItemIndex > -1) {
        return FhdMessenger.error('Sản phẩm đã có trong danh sách');
      } else {
        if (vm.saleCampaign) {
          vm.saleCampaign.products.push({
            product: item._id,
            sku: item.sku,
            description: item.description,
            price: item.price
          });
        } else {
          vm.products.push({
            product: item._id,
            sku: item.sku,
            description: item.description,
            price: item.price
          });
        }
      }
    };

    Address.getWards().then(wards => {
      vm.data.wards = wards;
    });

    function checkRequireWard(district) {
      if (!district) {
        return false;
      }

      if ((district.includes('Hồ Chí Minh') || district.includes('Hà Nội')) && district.includes('(Nội thành)')) {
        return true;
      }

      return false;
    }

    function getCity(district) {
      if (district.includes('Hồ Chí Minh')) {
        return 'TP. Hồ Chí Minh';
      }

      return 'Hà Nội';
    }

    vm.getWard = () => {
      if (checkRequireWard(vm.district)) {
        vm.requireWard = true;
        const city = getCity(vm.district);

        const district = _.head(vm.district.split(','));

        vm.data.currentWards = _.get(vm.data.wards[city], district, []);

        if (!_.get(vm.data.currentWards, 'length', 0)) {
          vm.requireWard = false;
        }
      } else {
        vm.requireWard = false;
        vm.data.currentWards = [];
      }
    };

    $scope.$watch(() => vm.district, () => {
      vm.getWard();
    });
  }; // Create new Business


  vm.create = function () {
    if (!vm.district) {
      return FhdMessenger.error('Chưa chọn quận');
    }

    const address = _.find(vm.data.districts, {
      label: vm.district
    });

    const fullAddress = `${vm.street}, ${vm.ward}, ${address.district}, ${address.city}`;

    if (!vm.cellphone.match(/^(0[35789]\d{8}|02\d{9})$/)) {
      return FhdMessenger.error('Số điện thoại nhập chưa đúng');
    }

    const businessCustomer = new BusinessCustomers({
      name: vm.name,
      code: vm.code,
      cellphone: vm.cellphone,
      products: vm.products,
      address: fullAddress,
      city: address.city,
      district: address.district,
      street: vm.street,
      ward: vm.ward || null,
      scale: vm.scale,
      brand: vm.brand,
      source: vm.source,
      type: vm.type,
      area: vm.area,
      images: vm.images,
      facebookLink: vm.facebookLink,
      investment: vm.investment,
      payment: vm.payment
    });
    businessCustomer.$save().then(response => {
      FhdMessenger.success('Tạp business customers entry thành công');
      $location.path('business-customers');
    }).catch(err => {
      return FhdMessenger.error(err.message);
    });
  };

  vm.find = () => {
    const startDate = moment(vm.data.startDate).isValid() ? moment(vm.data.startDate).format('YYYY-MM-DD') : null;
    const endDate = moment(vm.data.endDate).isValid() ? moment(vm.data.endDate).format('YYYY-MM-DD') : null;

    const statuses = _.filter(vm.data.status, status => _.get(vm.data.showStatus, status));

    vm.query = {
      endDate,
      startDate,
      statuses
    };
    FhdMessenger.info('Đang tìm...');
    vm.businessCustomers = BusinessCustomers.query(vm.query);
    vm.businessCustomers.$promise.then(() => {
      vm.businessCustomersTable.settings({
        dataset: vm.businessCustomers
      });
      FhdMessenger.success('Tải xong');
    });
  }; // Find existing Business Customer


  vm.update = function () {
    const address = _.find(vm.data.districts, {
      label: vm.district
    });

    if (!vm.requireWard) {
      vm.businessCustomer.ward = '';
    }

    if (address) {
      vm.businessCustomer.address = `${vm.businessCustomer.street}, ${vm.businessCustomer.ward}, ${address.district}, ${address.city}`;
      vm.businessCustomer.district = address.district;
      vm.businessCustomer.city = address.city;
    }

    if (!vm.businessCustomer.cellphone.match(/^(0[35789]\d{8}|02\d{9})$/)) {
      return FhdMessenger.error('Số điện thoại nhập chưa đúng');
    }

    vm.businessCustomer.products = vm.products;
    const businessCustomer = new BusinessCustomers(vm.businessCustomer);
    vm.waiting = true;
    businessCustomer.$update(() => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('business-customers');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = function () {
    BusinessCustomers.get({
      businessCustomerId: $stateParams.businessCustomerId
    }).$promise.then(businessCustomer => {
      vm.businessCustomer = businessCustomer;
      vm.products = businessCustomer.products;
      vm.district = `${businessCustomer.district}, ${businessCustomer.city}`;
    });
  };
}]);
"use strict";

