angular.module('products').directive('fhdProductInput', ['hotkeys', function (hotkeys) {
  return {
    templateUrl: '/modules/products/templates/fhd-product-input.client.template.html',
    restrict: 'E',
    scope: {
      product: '=',
      permittedItems: '=',
      all: '=?',
      includeDeleted: '=?',
      allowImportData: '=?',
      importProducts: '=',
      label: '@',
      labelColumn: '@',
      noos: '=?',
      autoRestock: '=?',
      isRaw: '=?',
      isLabel: '=?',
      isTool: '=?',
      isVendorProduct: '=?',
      isWrapper: '=?',
