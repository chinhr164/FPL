angular.module('core').filter('filterOutlets', [function () {
  return function (outlets, viewValue, outletSearch) {
    const lowerCaseViewValue = viewValue.toLowerCase();

    const matchOutlet = _.find(outlets, outlet => {
      return outlet.code.toLowerCase() === lowerCaseViewValue;
    });

    if (matchOutlet) {
      return [matchOutlet];
    }

    if (outletSearch && viewValue !== outletSearch) {
      return _.filter(outlets, outlet => {
        return outlet.code.toLowerCase().includes(lowerCaseViewValue) || outlet.name.toLowerCase().includes(lowerCaseViewValue);
      });
    }

    return outlets;
  };
}]).directive('fhdOutletInput', [function () {
  return {
    templateUrl: '/modules/core/templates/fhd-outlet-input.client.view.html',
    restrict: 'AE',
    scope: {
