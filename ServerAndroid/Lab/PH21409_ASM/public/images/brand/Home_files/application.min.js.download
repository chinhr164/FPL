angular.module('inventory-counts').controller('SummaryInventoryCountsController', ['$stateParams', 'NgTableParams', 'FhdMessenger', '$state', '$http', 'ObjectId', function ($stateParams, NgTableParams, FhdMessenger, $state, $http, ObjectId) {
  const vm = this;

  vm.getState = () => {
    vm.startDate = $stateParams.startDate || moment().startOf('week').format('YYYY-MM-DD');
    vm.endDate = $stateParams.endDate || moment().endOf('week').format('YYYY-MM-DD');
    vm.outlet = $stateParams.outlet;
    vm.changeState();
  };

  vm.changeState = () => {
    $state.go('summaryInventoryCounts', {
      startDate: vm.startDate,
      endDate: vm.endDate,
      outlet: vm.outlet ? ObjectId.getObjectId(vm.outlet) : null
    });
  };

  vm.inventoryCountTables = new NgTableParams({
    count: 50
  });

  vm.summarize = () => {
    if (!vm.startDate || !vm.endDate) return;
    $http.get('/inventory-counts/summary', {
      params: {
        startDate: moment(vm.startDate).format('YYYY-MM-DD'),
        endDate: moment(vm.endDate).format('YYYY-MM-DD'),
        outlet: ObjectId.getObjectId(vm.outlet)
      }
    }).then(response => response.data).then(inventoryCounts => {
      vm.inventoryCountTables.settings({
        dataset: inventoryCounts
      });
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.getItemTypes = () => [{
    id: 'gain',
    title: 'gain'
  }, {
    id: 'loss',
    title: 'loss'
  }];

  vm.getItemStatuses = () => [{
    id: 'counting',
    title: 'counting'
  }, {
    id: 'pending',
    title: 'pending'
  }, {
    id: 'verified',
    title: 'verified'
  }, {
    id: 'matched',
    title: 'matched'
  }];
}]);
"use strict";

angular.module('inventory-counts').factory('InventoryCountService', ['$modal', function ($modal) {
  return {
    openViewDetailPointInventoryCountModal(item) {
      return $modal.open({
        templateUrl: '/modules/inventory-counts/templates/modal-view-inventory-count-points.client.template.html',
        controller: 'ModalViewInventoryCountPointsController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          item: () => item
        }
      }).result;
    },

    getTypes() {
      return ['negative', 'daily', 'weekly', 'monthly', 'other', 'checklist'].map(type => ({
        id: type,
        title: type
      }));
    }

  };
}]);
'use strict'; // Inventory counts service used to communicate Inventory counts REST endpoints

angular.module('inventory-counts').factory('InventoryCounts', ['$resource', function ($resource) {
  return $resource('inventory-counts/:inventoryCountId', {
    inventoryCountId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    summaryByOutlet: {
      method: 'GET',
      url: '/inventory-counts/summary-by-outlet',
      isArray: true
    }
  });
}]);
"use strict";

angular.module('inventory-locations').config(['$stateProvider', function ($stateProvider) {
  $stateProvider.state('importInventoryLocations', {
    url: '/inventory-locations/import',
    templateUrl: 'modules/inventory-locations/views/import-inventory-locations.client.view.html',
    resolve: {
      $title: _.constant('Import Inventory Locations')
    }
  });
}]);
