angular.module('training-progresses').controller('ModalCreateTrainingProgressController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'applicationForm', 'TrainingProgresses', '$modalInstance', '$document', 'TrainingProgressesService', '$scope', function (Authentication, FhdMessenger, NgTableParams, applicationForm, TrainingProgresses, $modalInstance, $document, TrainingProgressesService, $scope) {
  const vm = this;
  const staff = applicationForm.staff;
  vm.trainingProgress = {
    user: staff,
    business: staff.business,
    outlet: staff.outlet,
    applicationForm: applicationForm._id
  };
  vm.data = {};
  vm.data.employeeTypes = [{
    id: 'employee',
    name: 'Nhân viên chính thức'
  }, {
    id: 'collaborator-to-employee',
    name: 'Cộng tác viên lên chính thức'
  }];

  if (vm.trainingProgress.user.roles.includes('CTV')) {
    vm.data.employeeTypes = [{
      id: 'collaborator',
      name: 'Cộng tác viên'
    }];
  }

  vm.data.roles = TrainingProgressesService.getRoles();

  vm.create = () => {
    if (!_.get(vm.trainingProgress, 'role')) {
      return FhdMessenger.error('Chưa chọn vị trí');
    }

    if (!_.get(vm.trainingProgress, 'employeeType')) {
      return FhdMessenger.error('Chưa chọn kiểu nhân viên');
    }

    const trainingProgress = new TrainingProgresses(vm.trainingProgress);
    vm.waiting = true;
    trainingProgress.$save().then(function (_trainingProgress) {
      FhdMessenger.success('Tạo training progress thành công');
      $modalInstance.close(_trainingProgress);
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

angular.module('training-progresses').controller('ModalViewTrainingProgressesController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'trainingProgressId', 'TrainingProgresses', '$modalInstance', '$document', 'TrainingProgressesService', '$scope', function (Authentication, FhdMessenger, NgTableParams, trainingProgressId, TrainingProgresses, $modalInstance, $document, TrainingProgressesService, $scope) {
  const vm = this;
  vm.user = Authentication.user;
  vm.points = [0, 1, 2];
  $scope.$watch(() => vm.trainingMode, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    if (!vm.trainingMode) {
      vm.trainingProgress.trainingProgressesTable.settings({
        dataset: vm.trainingProgress.trainingEntries,
        groupOptions: {
          isExpanded: false
        },
        counts: []
      });
    }

    const filterData = _.filter(vm.trainingProgress.trainingEntries, trainingEntry => {
      if (trainingEntry.questionType !== 'essay') {
        return trainingEntry.done && !trainingEntry.feedbacks.length && trainingEntry.point !== 2;
      }

      return trainingEntry.done && _.isUndefined(trainingEntry.point);
    });

    vm.trainingProgress.trainingProgressesTable.settings({
      dataset: filterData,
      counts: []
    });
  });
  vm.countBlock = 0;
  vm.totalPoint = 0;
  vm.avgTotalPoint = 0;

  vm.getAveragePoints = group => {
    const totalPoints = _.reduce(group.data, (result, trainingEntry) => {
      result += trainingEntry.point || 0;
      return result;
    }, 0);

    const numQuestions = _.filter(group.data, entry => entry.point >= 0).length;

    const avgPoint = Math.round(totalPoints / numQuestions * 10) / 10;

    if (numQuestions) {
      vm.totalPoint += avgPoint;
      vm.countBlock += 1;
      vm.avgTotalPoint = Math.round(vm.totalPoint / vm.countBlock * 10) / 10;
    }

    return avgPoint;
  };

  vm.isAllMarked = TrainingProgressesService.isAllMarked;

  vm.savePoint = (group, trainingProgress, trainingEntry) => {
    vm.updatePoint(trainingProgress, trainingEntry);
    vm.getAveragePoints(group);
  };

  vm.isAdmin = _.intersection(['admin', 'tro-ly', 'tro-ly-ns', 'tro-ly-dt', 'tro-ly-kho'], vm.user.roles).length;

  vm.init = () => {
    // vm.waiting = true
    TrainingProgresses.get({
      trainingProgressId
    }).$promise.then(trainingProgress => {
      trainingProgress.progresses = _.reduce(trainingProgress.trainingEntries, (result, trainingEntry) => {
        trainingEntry.feedbackContent = '';

        if (result[trainingEntry.block]) {
          if (trainingEntry.done) result[trainingEntry.block].done++;
          result[trainingEntry.block].total++;
        } else {
          result[trainingEntry.block] = {
            done: 0,
            total: 0
          };
          if (trainingEntry.done) result[trainingEntry.block].done++;
          result[trainingEntry.block].total++;
        }

        if (trainingEntry.feedbacks.length) {}

        return result;
      }, {});

      const summaryWorkDepartment = _.reduce(trainingProgress.trainingEntries, (result, _trainingEntry) => {
        if (_.get(_trainingEntry, 'trainingEntry.workDepartment')) {
          const codeManagers = _.map(_.get(_trainingEntry, 'trainingEntry.workDepartment.managers'), 'code');

          result.push({
            block: _trainingEntry.block,
            codeManagers: codeManagers
          });
        }

        return result;
      }, []);

      let blocksOfManager = [];

      for (let i = 0; i < summaryWorkDepartment.length; i++) {
        if (_.includes(summaryWorkDepartment[i].codeManagers, vm.user.code)) {
          blocksOfManager.push(summaryWorkDepartment[i].block);
        }
      }

      vm.blocksOfManager = _.uniq(blocksOfManager);
      trainingProgress.trainingProgressesTable = new NgTableParams({
        group: 'block',
        count: 50
      });
      trainingProgress.trainingProgressesTable.settings({
        dataset: trainingProgress.trainingEntries,
        groupOptions: {
          isExpanded: false
        },
        counts: []
      }); // create table for checklist

      trainingProgress.checklistTable = new NgTableParams({
        count: 50,
        group: 'block'
      });
      trainingProgress.checklistProgresses = TrainingProgressesService.calculateProgress(trainingProgress.checklists);
      trainingProgress.checklistTable.settings({
        dataset: trainingProgress.checklists,
        groupOptions: {
          isExpanded: false
        },
        counts: []
      });
      return trainingProgress;
    }).then(trainingProgress => {
      vm.trainingProgress = trainingProgress;
      FhdMessenger.success('Lấy dữ liệu thành công!');
    }).catch(err => {
      FhdMessenger.error(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.convertManagersToText = managers => {
    return _.reduce(managers, (result, manager) => {
      const {
        code,
        displayName
      } = manager;
      result += `${code || ''} ${displayName}, `;
      return result;
    }, '');
  };

  vm.convertQuestionType = trainingEntry => {
    const questionType = trainingEntry.questionType || 'essay';

    switch (questionType) {
      case 'essay':
        return 'Tự luận';

      case 'sort':
        return 'Sắp xếp';

      case 'sortTable':
        return 'Nối bảng';

      case 'chooseCorrectAnswer':
        return 'Chọn đáp án đúng';

      default:
        return 'Không xác định';
    }
  };

  vm.update = () => {
    vm.waiting = true;
    vm.trainingProgress.$updateFeedbackAndPoint().then(response => {
      FhdMessenger.success('Lưu thành công');
      vm.init();
      vm.trainingMode = false;
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.processImageInContent = group => {
    const imgElements = $document[0].querySelectorAll(`.block-${group + 1} img`);

    _.forEach(imgElements, imgElement => {
      imgElement.classList.add('img-thumbnail');
      let aTag = $document[0].createElement('A');
      aTag.setAttribute('href', imgElement.currentSrc);
      aTag.setAttribute('target', '_blank');
      let content = $document[0].createTextNode(`Click vào đây để xem full hình nhé`);
      aTag.appendChild(content);
      imgElement.parentNode.insertBefore(aTag, imgElement.nextSibling);
    });
  };

  vm.close = () => $modalInstance.dismiss();
}]);
'use strict';

angular.module('training-progresses').controller('TrainingProgressesController', ['$state', '$window', 'Authentication', 'FhdMessenger', 'NgTableParams', '$http', '$location', 'TrainingProgresses', 'TrainingProgressesService', 'BusinessService', 'OutletService', '$scope', '$q', '$localStorage', 'ConfirmModal', function ($state, $window, Authentication, FhdMessenger, NgTableParams, $http, $location, TrainingProgresses, TrainingProgressesService, BusinessService, OutletService, $scope, $q, $localStorage, ConfirmModal) {
  const vm = this;
  vm.user = Authentication.user;
  vm.trainingProgressesDocument = $localStorage.getObject('trainingProgressAnswers') || [];
  vm.progresses = {};
  vm.data = {};
  vm.trainingProgress = {};
  vm.data.employeeTypes = [{
    id: 'employee',
    name: 'Nhân viên chính thức'
  }, {
    id: 'collaborator',
    name: 'Cộng tác viên'
  }, {
    id: 'collaborator-to-employee',
    name: 'Cộng tác viên lên chính thức'
  }];

  vm.checkPermission = () => {
    if (!_.intersection(vm.user.roles, ['admin', 'training-progress:test'])) {
      $location.path('memos');
    }
  };

  vm.init = () => {
    if (!vm.user.roles.includes('CTV')) {
      vm.data.employeeTypes = _.reject(vm.data.employeeTypes, {
        id: 'collaborator'
      });
    }
  };

  vm.staffSearchSelected = staff => {
    vm.trainingProgress.user = staff;
    vm.trainingProgress.business = staff.business;
    vm.trainingProgress.outlet = staff.outlet;
  };

  vm.onSelectOutlet = outletSelected => {
    vm.data.outlets = _.map(outletSelected, '_id');
  };

  vm.data.roles = TrainingProgressesService.getRoles();

  vm.getRoles = function () {
    return _.map(vm.data.roles, role => {
      return {
        id: role.id,
        title: role.name
      };
    });
  };

  vm.getStaffStatus = function () {
    return [{
      id: 'retired',
      title: 'Nghỉ việc'
    }, {
      id: 'training',
      title: 'Thử việc'
    }, {
      id: 'employee',
      title: 'Chính thức'
    }];
  };

  vm.data.isTester = /admin|training-progress:test/.test(vm.user.roles);
  vm.loading = false;
  vm.saveLoading = false;
  vm.staffTrainingProgressTable = new NgTableParams({
    count: 50,
    sorting: {
      count: 'asc'
    }
  });

  vm.savePoint = (group, trainingProgress, trainingEntry) => {
    vm.updatePoint(trainingProgress, trainingEntry);
    vm.getAveragePoints(group);
  };

  vm.getAveragePoints = group => {
    const totalPoints = _.reduce(group.data, (result, trainingEntry) => {
      result += trainingEntry.point || 0;
      return result;
    }, 0);

    const numQuestions = _.filter(group.data, entry => entry.point >= 0).length;

    const avgPoint = Math.round(totalPoints / numQuestions * 10) / 10;
    return avgPoint;
  };

  vm.isAllMarked = TrainingProgressesService.isAllMarked;

  vm.convertContent = trainingEntry => {
    const questionType = trainingEntry.questionType || 'essay';

    switch (questionType) {
      case 'essay':
        return trainingEntry.content;

      case 'sort':
        return `Sắp xếp thứ tự các thao tác đề ${trainingEntry.content}`;

      case 'sortTable':
        return `Nối bảng A với bảng B: ${trainingEntry.content}`;

      case 'chooseCorrectAnswer':
        return `Chọn ${trainingEntry.totalCorrectAnswer} đáp án đúng cho ${trainingEntry.content}`;

      default:
        return trainingEntry.content;
    }
  };

  vm.contentChanged = _.debounce(() => {
    $localStorage.setObject('trainingProgressAnswers', vm.trainingProgressesDocument);
  }, 500);

  vm.findMyTrainingProgresses = () => {
    FhdMessenger.info('Đang tải');
    vm.waiting = true;
    TrainingProgresses.myTrainingProgresses().$promise.then(trainingProgresses => {
      vm.trainingProgresses = trainingProgresses;

      _.forEach(vm.trainingProgresses, trainingProgress => {
        TrainingProgressesService.shuffleTrainingEntryQuestion(trainingProgress); // create table for training entries

        trainingProgress.progresses = TrainingProgressesService.calculateProgress(trainingProgress.trainingEntries);
        trainingProgress.trainingProgressesTable = new NgTableParams({
          count: 50,
          group: 'block'
        });
        trainingProgress.trainingProgressesTable.settings({
          dataset: trainingProgress.trainingEntries,
          groupOptions: {
            isExpanded: false
          },
          counts: []
        }); // create table for checklist

        trainingProgress.checklistTable = new NgTableParams({
          count: 50,
          group: 'block'
        });
        trainingProgress.checklistProgresses = TrainingProgressesService.calculateProgress(trainingProgress.checklists);
        trainingProgress.checklistTable.settings({
          dataset: trainingProgress.checklists,
          groupOptions: {
            isExpanded: false
          },
          counts: []
        });
      });

      FhdMessenger.success('Đã tải xong');
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.openModalViewNewTrainingProgressbyUser = TrainingProgressesService.openModalViewNewTrainingProgressbyUser;

  vm.create = () => {
    if (!_.get(vm.trainingProgress, 'role')) {
      return FhdMessenger.error('Chưa chọn vị trí');
    }

    if (!_.get(vm.trainingProgress, 'employeeType')) {
      return FhdMessenger.error('Chưa chọn kiểu nhân viên');
    }

    const trainingProgress = new TrainingProgresses(vm.trainingProgress);
    vm.waiting = true;
    trainingProgress.$save().then(() => {
      FhdMessenger.success('Tạo Training Progress thành công');
      $state.reload();
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.delete = (trainingProgress, reload) => {
    ConfirmModal.showModal({}, {
      headerText: 'Xác nhận',
      bodyText: 'Bạn có chắc chắn muốn xoá training progress này không ?'
    }).then(() => {
      vm.waiting = true;
      $http.post(`/training-progresses/${trainingProgress._id}/delete`).then(result => {
        trainingProgress.status = 'closed';
        FhdMessenger.success('Xoá thành công');

        if (reload) {
          $state.reload();
        }
      }).catch(error => {
        FhdMessenger.errorFromServer(error);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.toggleEditable = trainingProgress => {
    if (trainingProgress.saved) return;
    trainingProgress.editable = true;
  };

  function getTrainingProgressErrors(trainingProgress) {
    let errors = [];

    const missingNoteInTrainingEntries = _.filter(trainingProgress.trainingEntries, trainingEntry => {
      return trainingEntry.done && !trainingEntry.note && !trainingEntry.newNote && trainingEntry.questionType === 'essay';
    });

    if (missingNoteInTrainingEntries.length) {
      errors = _.reduce(missingNoteInTrainingEntries, (result, trainingEntry) => {
        result.push(`Câu hỏi ${trainingEntry.content} trong buổi ${trainingEntry.block} chưa có ghi chép`);
        return result;
      }, []);
      return errors;
    } // Kiểm tra số lượt check của user của câu hỏi chooseCorrectAns xem có check nhiều hơn số câu đúng trong câu đó ko


    const checkedMoreThanCorrectAnswer = _.filter(trainingProgress.trainingEntries, trainingEntry => {
      const totalCheckedByUser = _.filter(trainingEntry.chooseCorrectAnswer, question => {
        return question.userAnswer;
      }).length;

      return trainingEntry.done && trainingEntry.questionType === 'chooseCorrectAnswer' && totalCheckedByUser > trainingEntry.totalCorrectAnswer;
    });

    if (checkedMoreThanCorrectAnswer.length) {
      errors = _.reduce(checkedMoreThanCorrectAnswer, (result, trainingEntry) => {
        result.push(`Câu hỏi ${trainingEntry.content} trong buổi ${trainingEntry.block} đang tích quá số câu cho phép`);
        return result;
      }, []);
      return errors;
    }

    return errors;
  }

  vm.find = () => {
    if (!_.includes(vm.user.roles, 'admin') && !_.includes(vm.user.roles, 'tro-ly') && !_.includes(vm.user.roles, 'tro-ly-ns') && !_.includes(vm.user.roles, 'tro-ly-dt') && !_.includes(vm.user.roles, 'tro-ly-kho')) {
      $location.path('memos');
    }

    vm.loading = true;
    TrainingProgresses.query({
      outlets: vm.data.outlets
    }).$promise.then(response => {
      vm.staffTrainingProgressTable.settings({
        dataset: response
      });
      vm.staffTrainingProgressTable.filter().staffStatus = 'training';
    }).catch(err => {
      FhdMessenger.error(err);
    }).finally(() => {
      vm.loading = false;
    });
  };

  vm.updateNote = trainingProgress => {
    const errors = getTrainingProgressErrors(trainingProgress);

    if (errors.length) {
      _.forEach(errors, error => {
        FhdMessenger.errorStick(error);
      });

      return;
    }

    vm.waiting = true;
    trainingProgress.$updateNote().then(response => {
      FhdMessenger.success('Lưu thành công');
      vm.findMyTrainingProgresses();
    }).catch(err => {
      FhdMessenger.error(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateChecklist = trainingProgress => {
    vm.waiting = true;
    trainingProgress.$updateChecklist().then(response => {
      FhdMessenger.success('Lưu thành công');
      vm.findMyTrainingProgresses();
    }).catch(err => {
      FhdMessenger.error(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

angular.module('training-progresses').filter('employeeType', [function () {
