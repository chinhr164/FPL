angular.module('expense-limits').controller('ExpenseLimitsController', ['$stateParams', '$location', '$scope', 'Authentication', 'ExpenseLimits', 'ExpenseSubCategories', 'FhdMessenger', 'NgTableParams', 'ObjectId', function ($stateParams, $location, $scope, Authentication, ExpenseLimits, ExpenseSubCategories, FhdMessenger, NgTableParams, ObjectId) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};

  vm.init = () => {
    ExpenseSubCategories.query({
      isPrivate: false
    }).$promise.then(expenseSubCategories => {
      vm.data.expenseCategories = expenseSubCategories;
    });
  };

  vm.create = function () {
    const expenseLimit = new ExpenseLimits(vm.expenseLimit);
    vm.waiting = true;
    expenseLimit.$save().then(() => {
      FhdMessenger.success('Tạo Expense Limit thành công');
      $location.path('expense-limits');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.expenseLimitsTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    ExpenseLimits.query().$promise.then(expenseLimits => {
      vm.expenseLimits = expenseLimits;
      vm.expenseLimitsTable.settings({
        dataset: vm.expenseLimits
      });
    });
  };

  vm.findOne = async () => {
    vm.expenseLimit = ExpenseLimits.get({
      expenseLimitId: $stateParams.expenseLimitId
    }).$promise.then(expenseLimit => {
      vm.expenseLimit = expenseLimit;
    });
  };

  vm.update = () => {
    vm.waiting = true;
    vm.expenseLimit.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('expense-limits');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

