angular.module('neighbours').controller('NeighboursController', ['$location', 'Neighbours', 'ConfirmModal', 'FhdMessenger', '$stateParams', 'ObjectId', 'Address', 'NgTableParams', 'Authentication', function ($location, Neighbours, ConfirmModal, FhdMessenger, $stateParams, ObjectId, Address, NgTableParams, Authentication) {
  const vm = this;
  vm.districts = Address.getDistricts();
  vm.authentication = Authentication;
  vm.user = Authentication.user; // Create new neighbour

  vm.create = function () {
    // Create new neighbour object
    var neighbour = new Neighbours({
      fullName: vm.fullName,
      cellphone: vm.cellphone,
      email: vm.email,
      birthday: vm.birthday,
      gender: vm.gender,
      address: {
        city: 'Hà Nội'
      }
    });

    if (vm.address.street) {
      neighbour.address.street = vm.address.street;
    } else {
      neighbour.address.street = '';
    }

    if (vm.district) {
      const district = _.find(vm.districts, {
        label: vm.district
      });

      neighbour.address.district = _.get(district, 'district');
      neighbour.address.city = _.get(district, 'city');
    } else {
      neighbour.address.district = null;
      neighbour.address.city = null;
    }

    if (neighbour.fullName && neighbour.cellphone && neighbour.customerId && neighbour.birthday && neighbour.address.street && neighbour.address.district && neighbour.address.city && neighbour.gender) {
      neighbour.registered = true;
    } // Redirect after save


    neighbour.$save(function (response) {
      $location.path('neighbours/' + response._id); // Clear form fields

      vm.fullName = '';
      vm.cellphone = '';
      vm.email = '';
      vm.birthday = '';
      vm.gender = '';
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
      FhdMessenger.errorFromServer(vm.error);
    });
  }; // Remove existing neighbours


  vm.remove = function (neighbour) {
    ConfirmModal.show({}, {
      headerText: `Xác nhận xóa khách hàng ${vm.neighbour.fullName} ?`,
      bodyText: `Bạn có thực sự muốn xóa khách hàng này ?`
    }).then(() => {
      if (neighbour) {
        neighbour.$remove();

        for (var i in vm.neighbours) {
          if (vm.neighbours[i] === neighbour) {
            vm.neighbours.splice(i, 1);
          }
        }
      } else {
        vm.neighbour.$remove(function () {
          $location.path('neighbours');
        });
      }
    });
  }; // Update existing neighbour


  vm.update = function () {
    const neighbour = vm.neighbour;

    if (vm.district) {
      const district = _.find(vm.districts, {
        label: vm.district
      });

      neighbour.address.district = _.get(district, 'district');
      neighbour.address.city = _.get(district, 'city');
    } else {
      neighbour.address.district = null;
      neighbour.address.city = null;
    }

    neighbour.$update(function () {
      // eslint-disable-line angular/document-service
      $location.path('neighbours/' + neighbour._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.neighbourTable = new NgTableParams({
    count: 100
  });

  vm.find = function () {
    vm.neighbours = Neighbours.query(function (neighbours) {
      vm.neighbourTable.settings({
        dataset: neighbours
      });
    });
  }; // Find existing neighbour


  vm.findOne = function () {
    vm.neighbour = Neighbours.get({
      neighbourId: $stateParams.neighbourId
    });
  };
}]);
"use strict";

