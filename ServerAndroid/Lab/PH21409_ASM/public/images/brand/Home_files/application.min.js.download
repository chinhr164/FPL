"use strict";

angular.module('stock-explains').controller('ModalCheckStockExplainController', ['stockExplain', '$modalInstance', 'Authentication', 'FhdMessenger', '$window', 'callback', 'ExplainsService', function (stockExplain, $modalInstance, Authentication, FhdMessenger, $window, callback, ExplainsService) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.stockExplain = stockExplain;
  vm.mapComment = {};

  vm.isAuthorize = () => _.intersection(['admin', 'admin-stock', 'admin-merchandise', 'audit-assistant'], vm.user.roles).length;

  vm.data = {};
  const reasonGroups = ExplainsService.getReason('stock-explains');
  vm.data.mainGroups = _.keys(reasonGroups);

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.addGroup = () => {
    vm.data.subGroups = _.get(reasonGroups, _.get(vm.stockExplain, 'explain.group', ''), []);

    if (_.get(vm.stockExplain, 'explain.group') === `Khác`) {
      const otherCause = $window.prompt('Nhập nguyên nhân khác');

      if (!otherCause || !otherCause.trim()) {
        _.set(vm.stockExplain, 'explain.group', null);

        return FhdMessenger.error('Bạn cần nhập nguyên nhân khác');
      }

      _.set(vm.stockExplain, 'explain.group', otherCause);
    }
  };

  vm.confirm = () => {
    if (!_.get(vm.stockExplain, 'explain.group') && !vm.mapComment[vm.stockExplain._id]) {
      return FhdMessenger.error('Chưa chọn nhóm nguyên nhân hoặc nội dung phản hồi');
    }

    vm.waiting = true;
    vm.stockExplain.$addComment({
      group: _.get(vm.stockExplain, 'explain.group'),
      content: vm.mapComment[vm.stockExplain._id]
    }).then(response => {
      FhdMessenger.success('Comment check giải trình thành công');
      vm.mapComment[vm.stockExplain._id] = null;
      stockExplain = response;

      if (_.isFunction(callback)) {
        callback();
      }

      $modalInstance.dismiss(true);
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('stock-explains').controller('ModalSplitStockExplainController', ['stockExplain', '$modalInstance', 'Authentication', 'FhdMessenger', '$window', 'ExplainsService', function (stockExplain, $modalInstance, Authentication, FhdMessenger, $window, ExplainsService) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.stockExplain = stockExplain;
  vm.mapComment = {};

  vm.isAuthorize = () => _.intersection(['admin', 'admin-stock'], vm.user.roles).length;

  vm.data = {};
  const reasonGroups = ExplainsService.getReason('stock-explains');
  vm.data.mainGroups = _.keys(reasonGroups);

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.addGroup = () => {
    vm.data.subGroups = _.get(reasonGroups, _.get(vm.stockExplain, 'splitGroup', ''), []);

    if (_.get(vm.stockExplain, 'splitGroup') === `Khác`) {
      const otherCause = $window.prompt('Nhập nguyên nhân khác');

      if (!otherCause || !otherCause.trim()) {
        _.set(vm.stockExplain, 'splitGroup', null);

        return FhdMessenger.error('Bạn cần nhập nguyên nhân khác');
      }

      _.set(vm.stockExplain, 'splitGroup', otherCause);
    }
  };

  vm.confirm = () => {
    if (!_.get(vm.stockExplain, 'splitGroup')) {
      return FhdMessenger.error('Chưa chọn nhóm nguyên nhân hoặc nội dung tách');
    }

    if (!_.get(vm.stockExplain, 'splitQuantity')) {
      return FhdMessenger.error('Chưa điền số lượng tách');
    }

    if (Math.abs(vm.stockExplain.diffQuantity) <= Math.abs(vm.stockExplain.splitQuantity)) {
      return FhdMessenger.error('Số lượng tách phải nhỏ hơn số lượng ban đầu của stock explain');
    }

    vm.waiting = true;
    vm.stockExplain.$split().then(response => {
      FhdMessenger.success('Tách Stock Explain thành công');
      $modalInstance.close(vm.stockExplain);
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('stock-explains').controller('StockExplainsController', ['$http', 'Authentication', 'FhdMessenger', 'ObjectId', 'OnlineOrderService', 'NgTableParams', 'StockExplains', 'OutletService', '$window', '$timeout', 'helper', 'ExplainsService', 'StockExplainsService', 'ProductService', 'Products', function ($http, Authentication, FhdMessenger, ObjectId, OnlineOrderService, NgTableParams, StockExplains, OutletService, $window, $timeout, helper, ExplainsService, StockExplainsService, ProductService, Products) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.mapComment = {};
  vm.showUpdateFinalDiffQuantity = false;

  if (vm.user.roles.includes('admin') || vm.user.roles.includes('admin-stock')) {
    vm.showUpdateFinalDiffQuantity = true;
  }

  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus;
  vm.data = {
    statuses: ['active', 'inactive', 'deleted'],
    stockExplainTSV: 'Nhấn vào nút Copy bảng để lấy dữ liệu...'
  };
  vm.statusMap = {
    active: true
  };
  const seeAllRoles = ['admin', 'admin-stock', 'stock-explains:view-all'];
  vm.stockExplainSumarizeByOutletTable = new NgTableParams({
    count: 100
  });
  vm.stockExplainSumarizeByGroupTable = new NgTableParams({
    count: 100
  });
  vm.summaryStockExplainsByOutletTable = new NgTableParams({
    count: 100
  });
  vm.productTable = new NgTableParams({
    count: 1000
  });

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.selectedOutletIds = _.map(selectedOutlets, '_id');
  };

  vm.init = function () {
    OutletService.allAsync().then(outlets => {
      vm.data.outlets = _.filter(outlets, {
        isStorage: true
      });
      vm.depotOutlets = _.filter(outlets, outlet => {
        return outlet.code.match(/^D\d+/);
      });
      vm.showOutletMap = _.reduce(vm.data.outlets, (result, outlet) => {
        const userOutlets = [ObjectId.getObjectId(vm.user.outlet), ..._.map(_.get(vm.user, 'managingOutlets', []), ObjectId.getObjectId), ..._.map(vm.depotOutlets, ObjectId.getObjectId)];

        if (_.intersection(vm.user.roles, seeAllRoles).length > 0 || _.includes(userOutlets, ObjectId.getObjectId(outlet))) {
          result[outlet._id] = true;
        }

        return result;
      }, {});
      vm.enableOutletMap = _.clone(vm.showOutletMap);
    });
  };

  vm.checkShowSumarize = function () {
    vm.showNegativeValue = false;
    vm.showPositiveValue = false;
    vm.showOffsetValue = false;

    if (_.intersection(vm.user.roles, seeAllRoles).length) {
      vm.showNegativeValue = true;
      vm.showPositiveValue = true;
      vm.showOffsetValue = true;
    }

    if (_.some(_.get(vm.user, 'businesses', []), business => {
      return _.get(business, 'code') === 'ABBY';
    })) {
      vm.showNegativeValue = true;
      vm.showPositiveValue = true;
      vm.showOffsetValue = true;
    }

    if (_.some(_.get(vm.user, 'businesses', []), business => {
      return _.get(business, 'code') === 'SAVOR';
    })) {
      vm.showNegativeValue = true;
      vm.showPositiveValue = true;
      vm.showOffsetValue = true;
    }
  };

  vm.startDate = moment().subtract(1, 'week').format('YYYY-MM-DD');
  vm.endDate = moment().add(1, 'week').format('YYYY-MM-DD');
  vm.stockExplainTable = new NgTableParams({
    count: 50
  });

  vm.hasBusinessCode = function (outlet, code) {
    let bussinessName = _.get(_.get(outlet, 'business'), 'name');

    if (bussinessName === code) return true;
  };

  function processTotalPrice() {
    vm.stockExplains = _.map(vm.stockExplains, stockExplain => {
      stockExplain.totalPrice = stockExplain.diffQuantity * getPrice(stockExplain);
      return stockExplain;
    });
  }

  function getPrice(stockExplain) {
    if (moment(stockExplain.created).isAfter('2022-07-13') && stockExplain.price > 0) {
      return stockExplain.price;
    }

    const product = stockExplain.product;

    if (_.get(product, 'price') > 0) {
      return _.get(product, 'price');
    }

    return _.get(product, 'cogs', 0);
  }

  function getTotalPrice(stockExplain) {
    const diffQuantity = stockExplain.diffQuantity;
    return getPrice(stockExplain) * diffQuantity;
  }

  function checkHadAuthorization(stockExplain, user) {
    if (_.intersection(seeAllRoles, vm.user.roles).length) {
      return true;
    }

    const userOutletIds = [ObjectId.getObjectId(user.outlet)].concat(_.map(vm.user.managingOutlets, ObjectId.getObjectId));

    if (_.some(userOutletIds, outletId => {
      return ObjectId.equals(outletId, stockExplain.outlet);
    }) && _.intersection(['tro-ly', 'tro-ly-kho', 'tro-ly-sx', 'stock-entries:find-by-outlet'], vm.user.roles).length) {
      if (_.get(stockExplain, 'comments.length') && _.get(stockExplain, 'outlet.isPos')) {
        return false;
      }

      return true;
    }

    return false;
  }

  vm.find = () => {
    vm.waiting = true;

    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    let promise = StockExplains.query({
      startDate: vm.startDate,
      endDate: vm.endDate,
      outlet: vm.selectedOutletIds,
      statuses
    }).$promise.then(stockExplains => {
      vm.stockExplains = stockExplains;

      _.forEach(vm.stockExplains, stockExplain => {
        stockExplain.tag = _.get(stockExplain, 'product.savorTag', _.get(stockExplain, 'product.tetCategory.name'));
        stockExplain.offsetValue = getOffsetValue(stockExplain);
        stockExplain.needExplain = stockExplain.status === 'active';
        stockExplain.totalPrice = getTotalPrice(stockExplain);
        stockExplain.hadAuthorization = checkHadAuthorization(stockExplain, vm.user);
      });

      vm.stockExplainTable.settings({
        dataset: vm.stockExplains
      });
      summaryStockExplainsByOutlet(stockExplains);
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
  };

  function summaryStockExplainsByOutlet(stockExplains) {
    const filterStockExplain = _.filter(stockExplains, stockExplain => {
      return !stockExplains.parent;
    });

    let stockExplainsGroupByOutlet = _.groupBy(filterStockExplain, 'outlet.code');

    const summaryStockExplain = _.values(_.reduce(stockExplainsGroupByOutlet, (result, stockExplains, outletCode) => {
      const totalExplains = _.get(stockExplains, 'length', 0);

      const hasCheckExplain = _.filter(stockExplains, stockExplain => _.get(stockExplain, 'comments.length')).length;

      const hasExplain = _.filter(stockExplains, stockExplain => {
        return _.get(stockExplain, 'explain.content') || _.get(stockExplain, 'children.length');
      }).length;

      const hasGroupExplain = _.filter(stockExplains, stockExplain => {
        return _.get(stockExplain, 'explain.group');
      }).length;

      const hasExplainPercent = Math.round(hasExplain * 100 / totalExplains);
      const hasCheckExplainPercent = Math.round(hasCheckExplain * 100 / totalExplains);
      const hasGroupExplainPercent = Math.round(hasGroupExplain * 100 / totalExplains);
      result[outletCode] = {
        outletCode,
        totalExplains,
        hasExplain,
        hasCheckExplain,
        hasGroupExplain,
        hasExplainPercent,
        hasCheckExplainPercent,
        hasGroupExplainPercent
      };
      return result;
    }, {}));

    vm.summaryStockExplainsByOutletTable.settings({
      dataset: summaryStockExplain
    });
    vm.totalExplains = _.sumBy(summaryStockExplain, 'totalExplains');
    vm.hasExplain = _.sumBy(summaryStockExplain, 'hasExplain');
    vm.hasCheckExplain = _.sumBy(summaryStockExplain, 'hasCheckExplain');
    vm.hasGroupExplain = _.sumBy(summaryStockExplain, 'hasGroupExplain');
    vm.summaryStockExplainsByOutletTable.sorting({
      outletCode: 'asc'
    });
  }

  vm.summarizeByRevenue = function () {
    const outlets = _.uniq(_.map(vm.stockExplains, stockExplain => {
      return _.get(stockExplain, 'outlet._id');
    }));

    if (moment(vm.endDate).diff(moment(vm.startDate), 'day') > 45) {
      return;
    }

    FhdMessenger.info('Đang tải tổng hợp doanh thu');
    vm.waiting = true;
    $http.get('/reports/revenue-by-outlet', {
      params: {
        startDate: vm.startDate,
        endDate: vm.endDate,
        outlets
      }
    }).then(res => {
      const dataMap = helper.makeMap(res.data, 'outletCode');
      FhdMessenger.success('Đã tải xong tổng hợp doanh thu :)');

      const summarizeByOutlet = _.sortBy(_.reduce(_.groupBy(vm.stockExplains, stockExplain => {
        return _.get(stockExplain, 'outlet.code', 'Chưa rõ');
      }), (result, stockExplains, outletCode) => {
        const negativeStockExplains = _.filter(stockExplains, stockExplain => {
          return stockExplain.diffQuantity < 0;
        });

        const negativeValue = _.sumBy(negativeStockExplains, 'totalPrice');

        const positiveValue = _.sumBy(_.reject(stockExplains, stockExplain => {
          return stockExplain.diffQuantity < 0;
        }), 'totalPrice');

        const revenue = _.get(dataMap, `${outletCode}.total`, 0);

        const offsetValue = _.sumBy(_.filter(negativeStockExplains, stockExplain => {
          return _.get(stockExplain, 'explain.group') === 'Chưa rõ nguyên nhân';
        }), 'offsetValue');

        result.push({
          outletCode,
          negativeValue,
          negativePercentByRevenue: negativeValue / revenue,
          positiveValue,
          positivePercentByRevenue: positiveValue / revenue,
          offsetValue,
          offsetPercentByRevenue: offsetValue / revenue,
          revenue
        });
        return result;
      }, []), 'outletCode');

      vm.stockExplainSumarizeByOutletTable.settings({
        dataset: summarizeByOutlet
      });

      const summarizeByGroup = _.reduce(_.groupBy(vm.stockExplains, stockExplain => {
        return _.get(stockExplain, 'explain.group', 'Chưa rõ');
      }), (result, stockExplains, group) => {
        result.push({
          group,
          count: stockExplains.length
        });
        return result;
      }, []);

      vm.stockExplainSumarizeByGroupTable.settings({
        dataset: summarizeByGroup
      });
      vm.totalStockExplain = _.sumBy(summarizeByGroup, 'count');
      vm.negativeValue = _.sumBy(summarizeByOutlet, 'negativeValue');
      vm.positiveValue = _.sumBy(summarizeByOutlet, 'positiveValue');
      vm.revenue = _.sumBy(summarizeByOutlet, 'revenue');
      vm.offsetValue = _.sumBy(summarizeByOutlet, 'offsetValue');
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateFinalDiffQuantity = function (stockExplain) {
    stockExplain.finalDiffQuantity = $window.prompt('Nhập số lượng');
    vm.waiting = true;
    stockExplain.$updateFinalDiffQuantity().then(() => {
      FhdMessenger.success('Cập nhật số lệch cuối thành công!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  function getOffsetPercent(product) {
    if (product.sku.match(/^[V]\d+/)) {
      if (product.description.match(/BTP/)) {
        return 0.6;
      }

      return 1;
    }

    if (!product.sku.match(/^[B]\d+/)) {
      return 1;
    }

    if (['Tủ đông', 'Tủ mát'].includes(_.get(product, 'warehouseGroup.name', 'Chưa rõ'))) {
      return 0.9;
    } else if (ProductService.isFoodProduct(product)) {
      return 0.8;
    }

    return 0.6;
  }

  function getOffsetValue(stockExplain) {
    let offsetPercent = getOffsetPercent(stockExplain.product);
    return getFinalTotalPrice(stockExplain) * offsetPercent;
  }

  function getFinalTotalPrice(stockExplain) {
    const finalDiffQuantity = _.get(stockExplain, 'finalDiffQuantity', _.get(stockExplain, 'diffQuantity', 0));

    return finalDiffQuantity * getPrice(stockExplain);
  }

  vm.changeStatus = stockExplain => {
    vm.waiting = true;
    stockExplain.$changeStatus().then(() => {
      FhdMessenger.success('Đổi trạng thái thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.copyStockExplainTSV = () => {
    const headers = ['STT', 'Outlet', 'SKU', 'Tên', 'Tag', 'Số lệch đầu', 'ĐLSS', 'ĐMSD', '% sai số', 'Số lệch cuối', 'Nhân viên', 'Thời gian kiểm', 'Nhóm', 'Giải trình', 'Check giải trình', 'Giá trị sai số', 'Giá trị đền bù', 'BKH', 'Link BKH', 'Xét giải trình'].join('\t');
    const stockExplains = vm.stockExplains.map((stockExplain, index) => {
      const commentContent = _.map(stockExplain.comments, comment => {
        const content = _.get(comment, 'content', '').replace(/(\n|\t)/gim, '');

        if (content.match(/Sửa số lệch cuối cùng thành/)) {
          return '';
        }

        return content;
      }).join(' | ');

      const inventoryCountName = _.get(stockExplain, 'inventoryCount.name');

      const fields = [index + 1, _.get(stockExplain, 'outlet.code', ''), _.get(stockExplain, 'product.sku', stockExplain.sku), _.get(stockExplain, 'product.description', stockExplain.description), _.get(stockExplain, 'tag', ''), stockExplain.diffQuantity, stockExplain.errorQuantificationQuantity, stockExplain.usageQuota, Math.round(stockExplain.errorPercent * 100) / 100, stockExplain.finalDiffQuantity, _.get(stockExplain, 'user.displayName', ''), moment(stockExplain.time).format('L LT'), _.get(stockExplain, 'explain.group', ''), _.get(stockExplain, 'explain.content', '').replace(/(\n|\t)/gim, ''), commentContent, stockExplain.totalPrice, stockExplain.offsetValue, inventoryCountName, inventoryCountName ? 'work.4-handy.com/#!/inventory-counts/' + _.get(stockExplain, 'inventoryCount._id') : '', getStockExplainStatusName(stockExplain.status)];
      return fields.join('\t');
    });
    vm.data.stockExplainTSV = headers + '\n' + stockExplains.join('\n');
    const copyText = $window.document.getElementById('stockExplainsCSV');
    $timeout(() => {
      copyText.select();
      $window.document.execCommand('copy');
      FhdMessenger.success('Đã copy');
    }, 2000);
  };

  function getStockExplainStatusName(status) {
    if (status === 'active') {
      return 'Có giải trình';
    }

    if (status === 'inactive') {
      return 'Không giải trình';
    }

    if (status === 'deleted') {
      return 'Đã xóa';
    }

    return status;
  }

  vm.openAddExplainModal = function (explainItem) {
    ExplainsService.openAddExplainModal({
      explainItem,
      callback: processTotalPrice
    });
  };

  vm.openModalCheckExplain = stockExplain => {
    StockExplainsService.openModalCheckExplain({
      stockExplain,
      callback: processTotalPrice
    });
  };

  vm.openModalSplitStockExplain = StockExplainsService.openModalSplitStockExplain;

  vm.removeComment = (trashExplain, index) => {
    trashExplain.comments.splice(index, 1);
    trashExplain.$removeComment().then(() => {
      FhdMessenger.success('Xóa comment thành công');
      processTotalPrice();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.reset = stockExplain => {
    ExplainsService.resetExplain(stockExplain, processTotalPrice);
  };

  vm.remove = (stockExplain, index) => {
    const confirm = $window.confirm(`Bạn chắc chắn muốn reset ${stockExplain.sku} (${stockExplain.type}) ?`);

    if (!confirm) {
      return;
    }

    stockExplain.$remove().then(() => {
      FhdMessenger.success('Xóa thành công');
      vm.stockExplains.splice(index, 1);
      vm.stockExplainTable.reload();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.loadProcessors = function () {
    OutletService.loadProcessors('auditProcessors').then(_outletGroupByProcessorMap => {
      vm.outletByProcessorTable = _.map(_outletGroupByProcessorMap, byProcessor => {
        return {
          code: byProcessor.code,
          displayName: byProcessor.displayName,
          outletContent: helper.sortByProperty(_.map(byProcessor.outlets, 'code')).join(', ')
        };
      });
    });
  };

  vm.findQuantificationProduct = function () {
    Products.findQuantificationProduct().$promise.then(products => {
      _.forEach(products, product => {
        product.isFacility = ProductService.isFacility(product);
      });

      vm.productTable.settings({
        dataset: products
      });
    });
  };
}]);
'use strict';

angular.module('stock-explains').filter('stockExplainStatus', [function () {
  return function (status) {
    switch (status) {
      case 'inactive':
        return 'Không giải trình';

      case 'active':
        return 'Có giải trình';

      case 'deleted':
        return 'Đã xóa';

      default:
        return status;
    }
  };
}]);
'use strict';

angular.module('stock-explains').factory('StockExplainsService', ['$modal', function ($modal) {
  return {
    openModalCheckExplain({
      stockExplain,
      callback
    }) {
      return $modal.open({
        animation: true,
        controller: 'ModalCheckStockExplainController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: '/modules/stock-explains/views/modal-check-stock-explain.client.view.html',
        resolve: {
          stockExplain: () => stockExplain,
          callback: () => callback
        }
      }).result;
    },

    openModalSplitStockExplain(stockExplain) {
      return $modal.open({
        animation: true,
        controller: 'ModalSplitStockExplainController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: '/modules/stock-explains/views/modal-split-stock-explain.client.view.html',
        resolve: {
          stockExplain: () => stockExplain
        }
      }).result;
    }

  };
}]);
"use strict";

angular.module('stock-explains').factory('StockExplains', ['$resource', function ($resource) {
  return $resource('stock-explains/:stockExplainId', {
    stockExplainId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    addComment: {
      method: 'PUT',
      url: 'stock-explains/:stockExplainId/add-comment'
    },
    updateFinalDiffQuantity: {
      method: 'PUT',
      url: 'stock-explains/:stockExplainId/update-final-diff-quantity'
    },
    sumarize: {
      method: 'GET',
      url: 'stock-explains/sumarize',
      isArray: true
    },
    reset: {
      method: 'PUT',
      url: 'stock-explains/:stockExplainId/reset'
    },
    explain: {
      method: 'PUT',
      url: 'stock-explains/:stockExplainId/explain'
    },
    editExplainReason: {
      method: 'PUT',
      url: 'stock-explains/:stockExplainId/edit-reason'
    },
    removeComment: {
      method: 'PUT',
      url: 'stock-explains/:stockExplainId/remove-comment'
    },
    changeStatus: {
      method: 'PUT',
      url: 'stock-explains/:stockExplainId/change-status'
    },
    split: {
      method: 'PUT',
      url: 'stock-explains/:stockExplainId/split'
    }
  });
}]);
