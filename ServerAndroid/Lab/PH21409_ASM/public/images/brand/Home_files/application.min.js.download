0}-\u{11434}\u{11447}-\u{1144A}\u{11480}-\u{114AF}\u{114C4}\u{114C5}\u{114C7}\u{11580}-\u{115AE}\u{115D8}-\u{115DB}\u{11600}-\u{1162F}\u{11644}\u{11680}-\u{116AA}\u{11700}-\u{1171A}\u{11800}-\u{1182B}\u{118A0}-\u{118DF}\u{118FF}\u{11A00}\u{11A0B}-\u{11A32}\u{11A3A}\u{11A50}\u{11A5C}-\u{11A83}\u{11A86}-\u{11A89}\u{11A9D}\u{11AC0}-\u{11AF8}\u{11C00}-\u{11C08}\u{11C0A}-\u{11C2E}\u{11C40}\u{11C72}-\u{11C8F}\u{11D00}-\u{11D06}\u{11D08}\u{11D09}\u{11D0B}-\u{11D30}\u{11D46}\u{11D60}-\u{11D65}\u{11D67}\u{11D68}\u{11D6A}-\u{11D89}\u{11D98}\u{11EE0}-\u{11EF2}\u{12000}-\u{12399}\u{12480}-\u{12543}\u{13000}-\u{1342E}\u{14400}-\u{14646}\u{16800}-\u{16A38}\u{16A40}-\u{16A5E}\u{16AD0}-\u{16AED}\u{16B00}-\u{16B2F}\u{16B40}-\u{16B43}\u{16B63}-\u{16B77}\u{16B7D}-\u{16B8F}\u{16E40}-\u{16E7F}\u{16F00}-\u{16F44}\u{16F50}\u{16F93}-\u{16F9F}\u{16FE0}\u{16FE1}\u{17000}-\u{187F1}\u{18800}-\u{18AF2}\u{1B000}-\u{1B11E}\u{1B170}-\u{1B2FB}\u{1BC00}-\u{1BC6A}\u{1BC70}-\u{1BC7C}\u{1BC80}-\u{1BC88}\u{1BC90}-\u{1BC99}\u{1D400}-\u{1D454}\u{1D456}-\u{1D49C}\u{1D49E}\u{1D49F}\u{1D4A2}\u{1D4A5}\u{1D4A6}\u{1D4A9}-\u{1D4AC}\u{1D4AE}-\u{1D4B9}\u{1D4BB}\u{1D4BD}-\u{1D4C3}\u{1D4C5}-\u{1D505}\u{1D507}-\u{1D50A}\u{1D50D}-\u{1D514}\u{1D516}-\u{1D51C}\u{1D51E}-\u{1D539}\u{1D53B}-\u{1D53E}\u{1D540}-\u{1D544}\u{1D546}\u{1D54A}-\u{1D550}\u{1D552}-\u{1D6A5}\u{1D6A8}-\u{1D6C0}\u{1D6C2}-\u{1D6DA}\u{1D6DC}-\u{1D6FA}\u{1D6FC}-\u{1D714}\u{1D716}-\u{1D734}\u{1D736}-\u{1D74E}\u{1D750}-\u{1D76E}\u{1D770}-\u{1D788}\u{1D78A}-\u{1D7A8}\u{1D7AA}-\u{1D7C2}\u{1D7C4}-\u{1D7CB}\u{1E800}-\u{1E8C4}\u{1E900}-\u{1E943}\u{1EE00}-\u{1EE03}\u{1EE05}-\u{1EE1F}\u{1EE21}\u{1EE22}\u{1EE24}\u{1EE27}\u{1EE29}-\u{1EE32}\u{1EE34}-\u{1EE37}\u{1EE39}\u{1EE3B}\u{1EE42}\u{1EE47}\u{1EE49}\u{1EE4B}\u{1EE4D}-\u{1EE4F}\u{1EE51}\u{1EE52}\u{1EE54}\u{1EE57}\u{1EE59}\u{1EE5B}\u{1EE5D}\u{1EE5F}\u{1EE61}\u{1EE62}\u{1EE64}\u{1EE67}-\u{1EE6A}\u{1EE6C}-\u{1EE72}\u{1EE74}-\u{1EE77}\u{1EE79}-\u{1EE7C}\u{1EE7E}\u{1EE80}-\u{1EE89}\u{1EE8B}-\u{1EE9B}\u{1EEA1}-\u{1EEA3}\u{1EEA5}-\u{1EEA9}\u{1EEAB}-\u{1EEBB}\u{20000}-\u{2A6D6}\u{2A700}-\u{2B734}\u{2B740}-\u{2B81D}\u{2B820}-\u{2CEA1}\u{2CEB0}-\u{2EBE0}\u{2F800}-\u{2FA1D}]+\)$/iu, '');
    return address;
  });
  vm.outletTable = new NgTableParams({
    count: 1000
  });
  vm.summarizeRefrigeratorTable = new NgTableParams({
    count: 50
  });
  vm.outlet = {};
  vm.checkProvider = CustomerService.checkProvider;
  vm.formats = OutletService.getFormats();
  vm.formatsFilters = _.map(vm.formats, format => {
    return {
      id: format,
      title: format
    };
  });
  vm.positions = ['Nhân viên parttime', 'Nhân viên fulltime', 'Trợ lý parttime', 'Trợ lý fulltime'];
  vm.partnerNames = ['SLACK', 'GMAIL', 'LALAMOVE', 'MOCA', 'VNPAY', 'AIRPAY', 'MOMO', 'ONOPAY', 'GRAB', 'NOW', 'BAEMIN'];
  vm.points = [1, 2, 3, 4, 5];
  vm.paymentType = ['prepaid', 'postpaid']; // Use for restockDays

  vm.init = () => {
    vm.days = [1, 2, 3, 4, 5, 6];
    vm.restockDayMap = {
      1: false,
      2: false,
      3: false,
      4: false,
      5: false,
      6: false,
      7: false
    };
    vm.moneyTranferDayMap = {
      1: false,
      2: false,
      3: false,
      4: false,
      5: false,
      6: false,
      7: false
    };
    vm.outlet.shifts = [{
      shift: 'S',
      startTime: null,
      endTime: null
    }, {
      shift: 'C',
      startTime: null,
      endTime: null
    }, {
      shift: 'T',
      startTime: null,
      endTime: null
    }];
    vm.outlet.restockTime = null;
    vm.outlet.positions = _.map(vm.positions, position => ({
      name: position,
      difficultPoint: 1
    }));
  };

  vm.removeValueFromArray = function (array, index) {
    array.splice(index, 1);
  }; // Create new Outlet


  vm.create = function () {
    // Create new Outlet object
    vm.outlet.restockDays = _.reduce(vm.restockDayMap, (restockDays, toShow, days) => {
      if (toShow) restockDays.push(days);
      return restockDays;
    }, []);
    vm.outlet.moneyTranferDays = _.reduce(vm.moneyTranferDayMap, (moneyTranferDays, toShow, days) => {
      if (toShow) moneyTranferDays.push(days);
      return moneyTranferDays;
    }, []);

    if (!vm.outlet.name) {
      return FhdMessenger.error('Please fill outlet name');
    }

    if (!vm.outlet.code) {
      return FhdMessenger.error('Please fill outlet code');
    }

    if (!vm.outlet.format) {
      return FhdMessenger.error('Please fill outlet format');
    }

    if (!vm.outlet.region) {
      return FhdMessenger.error('Please fill outlet region');
    }

    if (vm.outlet.isPos && !vm.outlet.coordinates) {
      return FhdMessenger.error('Hãy điền toạ độ của outlet');
    }

    if (vm.outlet.hasStaff) {
      const error = _.some(vm.outlet.shifts, shift => {
        if (!shift.startTime || !shift.endTime) {
          return true;
        }

        return false;
      });

      if (error) {
        return FhdMessenger.error('Please fill shift time');
      }

      vm.outlet.shifts.forEach(shift => {
        shift.startTime = moment('1993-02-03').hour(moment(shift.startTime).hour()).minute(moment(shift.startTime).minute()).second(0).millisecond(0).toDate();
        shift.endTime = moment('1993-02-03').hour(moment(shift.endTime).hour()).minute(moment(shift.endTime).minute()).second(0).millisecond(0).toDate();
      });
    }

    if (vm.outlet.format === 'metro' || vm.outlet.format === 'express') {
      if (!vm.outlet.restockTime) {
        FhdMessenger.error('Please fill restock time');
        return;
      }

      vm.outlet.restockTime = moment('1993-02-03').hour(moment(vm.outlet.restockTime).hour()).minute(moment(vm.outlet.restockTime).minute()).second(0).toDate();

      if (!vm.outlet.phone) {
        FhdMessenger.error('Please fill outlet phone');
        return;
      }

      if (!vm.outlet.address) {
        FhdMessenger.error('Please fill outlet address');
        return;
      }

      if (!vm.outlet.slackChannel) {
        FhdMessenger.error('Please fill outlet Slack Channel');
        return;
      }

      if (!vm.outlet.order) {
        FhdMessenger.error('Please fill outlet order');
        return;
      }
    }

    const outlet = new Outlets(vm.outlet);
    vm.waiting = true; // Redirect after save

    outlet.$save(function () {
      $location.path('outlets'); // Clear form fields

      vm.outlet.name = '';
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.hideOutletAddress = function (outlet) {
    if (['QC', 'QC_HCM', 'OFFICE'].includes(_.get(vm.user, 'outlet.code'))) {
      return false;
    }

    if (_.get(outlet, 'code', '').match(/[BD]\d+/)) {
      return true;
    }

    return false;
  };

  vm.print = function (outlet) {
    if (!outlet) {
      return FhdMessenger.error('Chưa chọn cơ sở');
    }

    vm.outlet = outlet;
    $timeout(() => {
      JsPrintService.printElementById('print-outlet-client', true);
    }, 100);
  }; // Remove existing Outlet


  vm.remove = function (outlet) {
    if (outlet) {
      outlet.$remove();
    } else {
      vm.outlet.$remove(function () {
        $location.path('outlets');
      });
    }
  };

  vm.openModalEditShifts = OutletService.openModalEditShifts;
  vm.openModalEditProcessors = OutletService.openModalEditProcessors; // Update existing Outlet

  vm.update = function () {
    const restockDays = _.reduce(vm.restockDayMap, (restockDays, toShow, days) => {
      if (toShow) restockDays.push(days);
      return restockDays;
    }, []);

    const moneyTranferDays = _.reduce(vm.moneyTranferDayMap, (moneyTranferDays, toShow, days) => {
      if (toShow) moneyTranferDays.push(days);
      return moneyTranferDays;
    }, []);

    vm.outlet.restockDays = restockDays || [];
    vm.outlet.moneyTranferDays = moneyTranferDays;
    vm.waiting = true;
    vm.outlet.$update(function () {
      FhdMessenger.success('Cập nhật outlet thành công');
      $location.path('outlets');
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Find a list of Outlets


  vm.outletsTable = new NgTableParams({
    count: 100
  });

  vm.find = function () {
    vm.outlets = Outlets.query({
      deleted: false,
      hasStaff: true
    }).$promise.then(outlets => {
      vm.mapOutlets = _.reduce(outlets, (result, outlet) => {
        result[outlet._id] = {
          editMinumumStaff: false
        };
        return result;
      }, {});
      vm.outletTable.settings({
        dataset: outlets
      });
    });
  };

  vm.toggleEditMinimumStaff = _id => {
    vm.mapOutlets[_id].editMinumumStaff = !vm.mapOutlets[_id].editMinumumStaff;
