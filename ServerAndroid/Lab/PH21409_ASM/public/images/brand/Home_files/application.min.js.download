angular.module('logistics-requests').controller('LogisticsRequestsController', ['$location', 'ConfirmModal', 'Authentication', 'ObjectId', 'FhdMessenger', 'NgTableParams', 'LogisticsRequests', 'OutletService', '$stateParams', '$localStorage', '$window', function ($location, ConfirmModal, Authentication, ObjectId, FhdMessenger, NgTableParams, LogisticsRequests, OutletService, $stateParams, $localStorage, $window) {
  const vm = this;
  vm.user = Authentication.user;
  vm.items = [];
  vm.newNote = '';
  vm.data = [];
  vm.productsTable = new NgTableParams({
    count: 100
  });
  vm.logisticRequestsTable = new NgTableParams({
    count: 50
  });
  vm.productsTable.settings({
    dataset: vm.items
  });

  function loadOutlet() {
    OutletService.allAsync().then(result => {
      vm.data.outlets = result;
      vm.data.outlets = _.filter(vm.data.outlets, outlet => {
        if (outlet.code.match(/^E\d+/) || outlet.code.match(/^M\d+/) || outlet.code === 'SHIP') {
          return true;
        }
      });
      vm.showOutletMap = _.reduce(vm.data.outlets, (result, outlet) => {
        result[outlet._id] = true;
        return result;
      }, {});
      vm.enableOutletMap = _.clone(vm.showOutletMap);
    });
  }

  vm.find = function () {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const outlets = _.reduce(vm.showOutletMap, (outlets, toShow, outlet) => {
      if (toShow) outlets.push(outlet);
      return outlets;
    }, []);

    vm.logisticsRequests = LogisticsRequests.query({
      startDate: vm.startDate,
      endDate: vm.endDate,
      statuses,
      outlets
    });
    vm.logisticsRequests.$promise.then(() => {
      vm.logisticRequestsTable.settings({
        dataset: vm.logisticsRequests
      });
    });
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      case 'outlet':
        {
          let changeValue = true;
          if (_.every(vm.showOutletMap)) changeValue = false;

          _.forEach(vm.showOutletMap, (value, key) => {
            vm.showOutletMap[key] = vm.enableOutletMap[key] && changeValue;
          });

          break;
        }

      default:
    }
  };

  function loadStatus() {
    vm.statuses = [{
      status: 'created',
      label: 'Mới',
      className: 'label-primary',
      value: true
    }, {
      status: 'created-logistics-entry',
      label: 'Đã tạo LE (chưa đủ)',
      className: 'label-default',
      value: true
    }, {
      status: 'done-logistics-entry',
      label: 'Đã tạo LE (đã đủ)',
      className: 'label-ready',
      value: true
    }, {
      status: 'created-deliver-entry',
      label: 'Đã chuyển theo DE',
      className: 'label-warning',
      value: true
    }, {
      status: 'received-logistics-entry',
      label: 'Đã confirm LE',
      className: 'label-success',
      value: false
    }];
    vm.statusMap = _.reduce(vm.statuses, (result, status) => {
      result[status.status] = status.value;
      return result;
    }, {});
  }

  vm.findOne = function () {
    vm.logisticsRequest = LogisticsRequests.get({
      logisticsRequestId: $stateParams.logisticsRequestId
    });
  };

  vm.init = function () {
    vm.logisticsRequests = LogisticsRequests.query(function (logisticsRequests) {
      vm.logisticRequestsTable.settings({
        dataset: logisticsRequests
      });
    });
    loadOutlet();
    loadStatus();
  };

  vm.remove = function (logisticsRequest) {
    ConfirmModal.show({}, {
      headerText: `Xác nhận xóa yêu cầu ${vm.logisticsRequest.logisticsRequestId} ?`,
      bodyText: `Bạn có thực sự muốn xóa đơn này ?`
    }).then(() => {
      if (logisticsRequest) {
        logisticsRequest.$remove();

        for (var i in vm.logisticsRequests) {
          if (vm.logisticsRequests[i] === logisticsRequest) {
            vm.logisticsRequests.splice(i, 1);
          }
        }

        FhdMessenger.success('Đã xóa request!');
      } else {
        vm.logisticsRequest.$remove(function () {
          $location.path('logistics-requests');
          FhdMessenger.success('Đã xóa request!');
        });
      }
    });
  };

  vm.create = function () {
    if (!vm.items.length) {
      return FhdMessenger.error('Chưa có sản phẩm yêu cầu thu hồi');
    }

    vm.waiting = true;
    const logisticsRequest = new LogisticsRequests({
      destination: ObjectId.getObjectId(vm.destination),
      deadline: vm.deadline,
      outlet: ObjectId.getObjectId(vm.outlet),
      items: vm.items
    }); // Redirect after save

    logisticsRequest.$save(function (response) {
      $location.path('/logistics-requests');
      vm.waiting = false;
      FhdMessenger.success('Bạn đã tạo yêu cầu thu hồi hàng thành công!');
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
      vm.waiting = false;
    });
  };

  vm.productSearchSelected = function (item) {
    if (!item) return;
    let items = vm.items;

    if (vm.logisticsRequest) {
      items = vm.logisticsRequest.items;
    }

    const matchItemIndex = _.findIndex(items, currentItem => {
      return item.sku === currentItem.sku;
    });

    if (matchItemIndex > -1) {
      return FhdMessenger.error('Sản phẩm đã có trong danh sách');
    } else {
      if (vm.logisticsRequest) {
        vm.logisticsRequest.items.push({
          product: item._id,
          sku: item.sku,
          description: item.description,
          quantity: 1
        });
        return;
      }

      vm.items.push({
        product: item._id,
        sku: item.sku,
        description: item.description,
        quantity: 1
      });
    }
  };

  vm.update = function () {
    if (vm.newNote) {
      vm.logisticsRequest.notes = vm.logisticsRequest.notes || [];
      vm.logisticsRequest.notes.push({
        content: vm.newNote,
        staff: vm.user,
        time: new Date(),
        status: vm.logisticsRequest.status
      });
    }

    const logisticsRequest = vm.logisticsRequest;
    logisticsRequest.$update(function () {
      $location.path('/logistics-requests/' + logisticsRequest._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.createStockEntry = logisticsRequest => {
    if (logisticsRequest) {
      $localStorage.setObject('logisticsRequest', logisticsRequest);
    } else $localStorage.setObject('logisticsRequest', vm.logisticsRequest);

    $window.open(`${$location.protocol()}://${$location.host()}${$location.port() !== 80 ? `:${$location.port()}` : ''}/#!/stock-entries/create`, '_blank');
  };
}]);
"use strict";

