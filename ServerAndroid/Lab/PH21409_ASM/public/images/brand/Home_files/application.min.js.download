angular.module('customer-groups').controller('CustomerGroupsController', ['$scope', '$stateParams', '$location', 'Authentication', 'CustomerGroups', function ($scope, $stateParams, $location, Authentication, CustomerGroups) {
  $scope.authentication = Authentication; // Create new Customer group

  $scope.create = function () {
    // Create new Customer group object
    var customerGroup = new CustomerGroups({
      name: this.name
    }); // Redirect after save

    customerGroup.$save(function (response) {
      $location.path('customer-groups/' + response._id); // Clear form fields

      $scope.name = '';
    }, function (errorResponse) {
      $scope.error = errorResponse.data.message;
    });
  }; // Remove existing Customer group


  $scope.remove = function (customerGroup) {
    if (customerGroup) {
      customerGroup.$remove();

      for (var i in $scope.customerGroups) {
        if ($scope.customerGroups[i] === customerGroup) {
          $scope.customerGroups.splice(i, 1);
        }
      }
    } else {
      $scope.customerGroup.$remove(function () {
        $location.path('customer-groups');
      });
    }
  }; // Update existing Customer group


  $scope.update = function () {
    var customerGroup = $scope.customerGroup;
    customerGroup.$update(function () {
      $location.path('customer-groups/' + customerGroup._id);
    }, function (errorResponse) {
      $scope.error = errorResponse.data.message;
    });
  }; // Find a list of Customer groups


  $scope.find = function () {
    $scope.customerGroups = CustomerGroups.query();
  }; // Find existing Customer group


  $scope.findOne = function () {
