angular.module('customers').directive('fhdCustomerInput', [function () {
  return {
    templateUrl: 'modules/customers/templates/fhd-customer-input.client.template.html',
    restrict: 'E',
    scope: {
      customer: '=',
      date: '=',
      outlet: '=',
      labelColumn: '@',
      onChange: '=',
      matchAll: '=',
      searchForSaleEntry: '=',
      saleOnlyFindByCustomerId: '='
    },
    controller: 'FhdCustomerInputController',
    controllerAs: 'vm',
    replace: true,
    link: function (scope, element, attrs, controller) {
      if (scope.labelColumn) {
        var labelElm = element.find('label');
        var inputElm = element.find('fhd-controls');
        labelElm.addClass('col-sm-' + scope.labelColumn);
        inputElm.addClass('col-sm-' + (12 - scope.labelColumn));
      }
    }
  };
}]).controller('FhdCustomerInputController', ['$scope', 'Authentication', 'CustomerService', '$modal', 'FhdMessenger', function ($scope, Authentication, CustomerService, $modal, FhdMessenger) {
  const vm = this;
  vm.cellphone = null;
  vm.data = {};
  vm.user = Authentication.user;
  const matchAll = $scope.matchAll;
  const searchForSaleEntry = $scope.searchForSaleEntry;
  vm.onChange = $scope.onChange;

  vm.clearCustomer = function () {
    // eslint-disable-next-line
    $scope.customer = null;
  };

  vm.data.isSearching = false;
  vm.data.searchingCustomers = [];
  vm.data.helperText = '';

  vm.customerSearchChanged = searchText => {
    if ($scope.customer && !searchText) {
      vm.customerSearchSelected(null);
    }
  };

  vm.searchCustomers = function (searchText) {
    vm.clearCustomer();
    vm.data.helperText = '';

    if (matchAll && !searchText.match(_wrapRegExp(/(^C[AB]\d{7})|(\d{10})/i, {
      customerId: 1,
      cellphone: 2
    })) && !searchText.match(_wrapRegExp(/(\d{6})/i, {
      cellphone: 1
    }))) {
      return [];
    }

    if ($scope.saleOnlyFindByCustomerId && _.intersection(vm.user.roles, ['sale', 'tro-ly']).length && searchText.match(/^\d{10}/)) {
      FhdMessenger.error('Bạn không thể tìm khách hàng bằng SĐT. Vùi lòng thử tìm kiểm bằng mã khách hàng nhé');
      return [];
    }

    vm.data.isSearching = true;
    vm.data.helperText = 'Đang tìm...';
    return CustomerService.searchCustomers(searchText, searchForSaleEntry).then(customers => {
      vm.data.searchingCustomers = customers || [];

      if (!vm.data.searchingCustomers.length) {
        vm.data.helperText = 'Không tìm thấy khách hàng. Trường hợp bạn đang quét mã khách hàng hiển thị app vui lòng báo khách thử thoát app ra vào lại nhé';
      } else {
        vm.data.helperText = '';
      }

      if (vm.data.searchingCustomers.length === 1) {
        vm.customerSearchSelected(_.head(vm.data.searchingCustomers));
        return [];
      }

      return customers || [];
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      vm.data.searchingCustomers = [];
      vm.data.helperText = '';
      return [];
    }).finally(() => {
      vm.data.isSearching = false;
    });
  };

  vm.customerSearchSelected = function (customer) {
    // eslint-disable-next-line
    $scope.customer = customer;

    if (vm.onChange) {
      vm.onChange(customer);
    }
  };

  vm.createCustomer = function (cellphone) {
    let customer = {
      cellphone
    };

    if ($scope.customer) {
      customer = $scope.customer;
    }

    var customerModal = CustomerService.createCustomer(customer, true);
    customerModal.result.then(function (customer) {
      // eslint-disable-next-line
      $scope.customer = _.assign(customer, {
        fullDescription: CustomerService.getFullDescription(customer)
      });
      vm.data.helperText = '';
      vm.customerSearchSelected(customer);
    });
  };

  vm.editCustomer = function (customer) {
    if (customer && customer.customerId) {
      CustomerService.editCustomer(customer.customerId).result.then(customer => {
        vm.saleEntry.customer = customer;
        vm.customerSearchSelected(customer);
      });
    }
  };
}]);
'use strict';

angular.module('customers').factory('CustomerService', ['Customers', '$http', '$modal', 'CurrentShift', function (Customers, $http, $modal, CurrentShift) {
  let customers;

  function getFullDescription(customer) {
    return `${customer.fullName} - ${customer.customerId}`;
  }

  function checkProvider(cellphone) {
    if (!cellphone) return 'Chưa có SĐT ';

    if (cellphone.match(/^086/) || cellphone.match(/^09(6|7|8)/) || cellphone.match(/^(016|03)(2|3|4|5|6|7|8|9)/)) {
      return 'Viettel';
    }

    if (cellphone.match(/^088/) || cellphone.match(/^09[14]/) || cellphone.match(/^012[34579]/) || cellphone.match(/^08[12345]/)) {
      return 'Vina';
    }

    if (cellphone.match(/^07[67890]/) || cellphone.match(/^(089|090|093)/) || cellphone.match(/^012[1268]/)) {
      return 'Mobi';
    }

    if (cellphone.match(/^092/) || cellphone.match(/^05[268]/)) {
      return 'Vietnammobile';
    }

    if (cellphone.match(/^0[59]9/)) {
      return 'Gmobile';
    }

    return 'Khác';
  }

  return {
    getFullDescription,
    checkProvider,

    add(customer) {
      customers = customers || [];
      customers.push(customer);
    },

    getSaleEntries(cellphone) {
      return function (callback) {
        $http.get(`/customers/api/${cellphone}/sale-entries`).success(function (saleEntries) {
          callback(null, saleEntries);
        }).error(function (errorResponse) {
          callback(errorResponse);
        });
      };
    },

    createCustomer(customerInfo, autoCustomerId) {
      const currentShift = CurrentShift.getCurrentShift(); // Create a modal to quick add customer

      return $modal.open({
        animation: true,
        templateUrl: 'modules/customers/views/modal-create-customer.client.view.html',
        controller: 'CustomersModalController',
        controllerAs: 'vm',
        resolve: {
          customerData() {
            return _.assign({
              cellphone: _.get(customerInfo, 'cellphone', null),
              fullName: _.get(customerInfo, 'name', null),
              autoCustomerId
            }, _.pick(currentShift, ['date', 'outlet', 'shift']));
          }

        }
      });
    },

    sendEmailToListSubscribed(email) {
      return $http.post('customers/email', {
        email
      });
    },

    getAutoCustomerId() {
      return $http.get('/customers/auto-customer-id').then(response => response.data);
    },

    openSaleEntriesModal(cellphone) {
      return $modal.open({
        animation: true,
        size: 'lg',
        templateUrl: '/modules/sale-entries/views/modal-list-sale-entries.client.view.html',
        controller: 'ModalListSaleEntriesController',
        resolve: {
          cellphone() {
            return cellphone;
          }

        }
      });
    },

    getValueAndVouchers(customerId) {
      return $http.get(`/customers/${customerId}/value-vouchers`).then(function (response) {
        return response.data;
      });
    },

    searchCustomers: (searchText, searchForSaleEntry) => $http.get('/api/customers/search', {
      params: {
        searchText,
        searchForSaleEntry
      }
    }).then(response => response.data),
    editCustomer: customerId => $modal.open({
      animation: true,
      templateUrl: 'modules/customers/views/modal-edit-customer.client.view.html',
      controller: 'EditCustomerModalController',
      controllerAs: 'vm',
      resolve: {
        customerId: () => customerId
      }
    })
  };
}]);
'use strict'; // Customers service used to communicate Customers REST endpoints

angular.module('customers').factory('Customers', ['$resource', function ($resource) {
  return $resource('customers/api_v2/:customerId', {
    customerId: '@_id',
    customerID: '@customerId'
  }, {
    getFromCustomerId: {
      method: 'GET',
      url: 'customers/:customerID'
    },
    update: {
      method: 'PUT'
    },
    saleEntries: {
      method: 'GET',
      isArray: true,
      url: 'customers/api_v2/:customerId/sale-entries'
    },
    items: {
      method: 'GET',
      isArray: true,
      url: 'customers/api_v2/:customerId/items'
    },
    portraits: {
      method: 'GET',
      isArray: true,
      url: 'customers/api_v2/:customerId/portraits'
    },
    vouchers: {
      method: 'GET',
      isArray: true,
      url: 'customers/api_v2/:customerId/vouchers'
    }
  });
}]);
'use strict'; // Setting up route

angular.module('deliver-entries').config(['$stateProvider', function ($stateProvider) {
  $stateProvider.state('createDeliverEntry', {
    url: '/deliver-entries/create',
    templateUrl: 'modules/deliver-entries/views/create-deliver-entry.client.view.html',
    resolve: {
      $title: _.constant('Create Deliver Entry')
    }
  });
  $stateProvider.state('listDeliverEntries', {
    url: '/deliver-entries',
    templateUrl: 'modules/deliver-entries/views/list-deliver-entries.client.view.html',
