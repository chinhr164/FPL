angular.module('core').factory('ResourcesService', ['toaster', 'ProductService', 'OutletService', 'BusinessService', 'ShiftService', 'UserService', 'CustomerService', 'ObjectId', 'ProductGroups', 'ProductDepartments', 'ProductCats', 'ProductSubCats', '$q', function (toaster, ProductService, OutletService, BusinessService, ShiftService, UserService, CustomerService, ObjectId, ProductGroups, ProductDepartments, ProductCats, ProductSubCats, $q) {
  let productGroups, productDepartments, productCats, productSubCats;

  function notifySuccess(str) {
    toaster.success(str);
  }

  function addNotify(f, text) {
    // toNotify:Boolean
    return function (toNotify) {
      return function (callback) {
        f(function (err, item) {
          if (err) return callback(err);
          if (toNotify) notifySuccess(text);
          callback(null, item);
        });
      };
    };
  }

  return {
    products: () => cb => {
      return ProductService.essentialProductsAsync().then(products => cb(null, products)).catch(err => cb(err));
    },
    outlets: addNotify(OutletService.all, 'Load xong các cơ sở'),
    businesses: addNotify(BusinessService.all, 'Load xong các shop'),
    shifts: addNotify(ShiftService.all, 'Load xong các ca trực'),
    staffs: addNotify(UserService.allStaffs, 'Load xong danh sách staff'),
    customers: addNotify(CustomerService.fullDescription, 'Load xong danh sách khách hàng'),
    staffsWithNoneOption: addNotify(UserService.allStaffsWithNoneOption, 'Load xong danh sách staff có description'),
    currentDate: function () {
      var date = new Date();
      date.setHours(0, 0, 0, 0);
      return date;
    },
    currentShift: function () {
      return ShiftService.currentShift();
    },
    load: function () {
      OutletService.load();
      UserService.load();
      ProductService.load();
      BusinessService.load();
    },
    productGroupsAsync: () => {
      if (!productGroups) productGroups = ProductGroups.query();
      return productGroups.$promise;
    },
    productDepartmentsAsync: () => {
      if (!productDepartments) productDepartments = ProductDepartments.query();
      return productDepartments.$promise;
    },
    productCatsAsync: () => {
      if (!productCats) productCats = ProductCats.query();
      return productCats.$promise;
    },
    productSubCatsAsync: () => {
      if (!productSubCats) productSubCats = ProductSubCats.query();
      return productSubCats.$promise;
    },
    filterDepartments: (groupId, departments) => groupId ? _.filter(departments, {
      productGroup: groupId
    }) : departments,
    filterCats: (departmentId, groupId, cats) => departmentId ? _.filter(cats, {
      productDepartment: departmentId
    }) : groupId ? _.filter(cats, {
      productGroup: groupId
    }) : cats,
    filterSubCats: (catId, departmentId, groupId, subCats) => catId ? _.filter(subCats, {
      productCat: catId
    }) : departmentId ? _.filter(subCats, {
      productDepartment: departmentId
    }) : groupId ? _.filter(subCats, {
      productGroup: groupId
    }) : subCats
  };
}]);
'use strict';

angular.module('core').factory('ShiftPositions', ['$q', function ($q) {
  const PROBATION_POSITIONS = [{
    name: 'Thử việc A',
    code: 'PROBATION_A'
  }, {
    name: 'Thử việc B',
    code: 'PROBATION_B'
  }];
  const outletPostions = [{
    name: 'Nhân viên BUYING',
    code: 'BUYING',
    outletCode: 'D\\d'
  }, {
    name: 'Nhân viên LOGISTICS',
    code: 'LOGISTICS',
    outletCode: 'D\\d'
  }, {
    name: 'Nhân viên STORING',
    code: 'STORING',
    outletCode: 'D\\d'
  }, {
    name: 'Đóng gói',
    code: 'DG',
    outletCode: '[G]\\d'
  }, {
    name: 'Giám sát',
    code: 'MONITOR',
    outletCode: '[D]\\d'
  }, {
    name: 'In nhãn',
    code: 'PRINT_LABEL',
    outletCode: '[G]\\d'
  }, {
    name: 'Nhân viên bốc xếp',
    code: 'STEVEDORE',
    outletCode: '[D]\\d'
  }, {
    name: 'Tái chế',
    code: 'RECYCLER',
    outletCode: '(G1|G3|G5)'
  }, {
    name: 'Xanh',
    code: 'GREEN',
    outletCode: '(MKT|BUYING)'
  }, {
    name: 'Vàng',
    code: 'YELLOW',
    outletCode: '(MKT|BUYING)'
  }, {
    name: 'Cam',
    code: 'ORANGE',
    outletCode: '(MKT|BUYING|LOGISTICS)'
  }, {
    name: 'QC',
    code: 'QC',
    outletCode: 'MKT'
  }, {
    name: 'CTV',
    code: 'CTV',
    outletCode: '(MKT|[DBMEG]\\d)'
  }, {
    name: 'QC Cơ sở',
    code: 'QC_OUTLET',
    outletCode: 'QC'
  }, {
    name: 'QC Văn phòng',
    code: 'QC_OFFICE',
    outletCode: 'QC'
  }, {
    name: 'Vận Tải',
    code: 'VANTAI',
    outletCode: 'VANTAI'
  }, {
    name: 'Bán hàng',
    code: 'SALEMAN',
    outletCode: '[ME]\\d'
  }, {
    name: 'Nhân viên sơ chế',
    code: 'KITCHENHAND',
    outletCode: '[BK]\\d'
  }, {
    name: 'Trưởng ca',
    code: 'SHIFTLEAD',
    outletCode: '(B1|G4|S12|G1)'
  }, {
    name: 'Nhân viên Đóng sốt',
    code: 'PACKING_SAUCE',
    outletCode: 'SS'
  }, {
    name: 'Nhân viên HR',
    code: 'HR',
    outletCode: 'HR'
  }, {
    name: 'Thu ngân',
    code: 'CASHIER',
    outletCode: '[SKME]\\d'
  }, {
    name: 'Viêt chữ',
    code: 'WRITER',
    outletCode: '[S]\\d'
  }, {
    name: 'Làm bánh',
    code: 'BREAD',
    outletCode: 'S\\d'
  }, {
    name: 'Nhân viên tech',
    code: 'TECH',
    outletCode: 'TECH'
  }, {
    name: 'Remote',
    code: 'REMOTE',
    outletCode: 'TECH'
  }, {
    name: 'Tech support',
    code: 'TECH_SUPPORT',
    outletCode: 'TECH'
  }, {
    name: 'Kế toán',
    code: 'KT',
    outletCode: 'KT'
  }, {
    name: 'Thợ bánh',
    code: 'BAKER',
    outletCode: '(B5|B4)'
  }, {
    name: 'Nhân viên sản xuất mùa vụ',
    code: 'SEASONAL_PRODUCTION_STAFF',
    outletCode: '(B4)'
  }, {
    name: 'Phụ bếp bánh',
    code: 'BAKER_ASSISTANT',
    outletCode: '(B5|B4)'
  }, {
    name: 'Nhân viên xử lý đơn hàng',
    code: 'ORDER_PROCESSINGs',
    outletCode: '(B5|B4)'
  }, {
    name: 'Nhân viên sản xuất bánh trung thu',
    code: 'MOON_CAKE_BAKER',
    outletCode: '(B2)'
  }, ...PROBATION_POSITIONS];
  return {
    outletPostions,

    getPostions(outlet, takeProbation = false) {
      const outletCode = _.get(outlet, 'code', '');

      let positions = _.filter(outletPostions, outletPostion => {
        if (!outletPostion.outletCode) {
          return false;
        }

        const outletRegex = new RegExp(outletPostion.outletCode);
        return outletCode.match(outletRegex);
      });

      if (takeProbation) {
        positions = [...positions, ...PROBATION_POSITIONS];
      }

      if (['S6', 'S17', 'S12'].includes(outlet.code)) {
        if (['S6', 'S12'].includes(outlet.code)) {
          if (moment().isAfter('2022-05-09')) {
            positions = _.reject(positions, {
              code: 'WRITER'
            });
          }
        } else if (moment().isAfter('2022-05-23')) {
          positions = _.reject(positions, {
            code: 'WRITER'
          });
        }
      } else {
        positions = _.reject(positions, {
          code: 'WRITER'
        });
      }

      return positions;
    },

    PROBATION_POSITIONS: PROBATION_POSITIONS
  };
}]);
