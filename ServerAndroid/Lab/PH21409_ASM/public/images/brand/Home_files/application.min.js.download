angular.module('stock-entries').directive('fhdStockEntryItemsInput', ['hotkeys', function (hotkeys) {
  return {
    templateUrl: '/modules/stock-entries/templates/fhd-stock-entry-items-input.client.template.html',
    restrict: 'AE',
    scope: {
      items: '=',
      restockReport: '=?',
      saleTotal: '=',
      outletData: '=?',
      logisticsRequest: '=?',
      restockList: '=?',
      packingOutletCodes: '=?'
    },
    controller: 'FhdStockEntryItemsInputController',
    controllerAs: 'vm',
    bindToController: true,
    link: function (scope, element, attrs) {
      hotkeys.add({
        combo: 'f4',
        allowIn: ['INPUT'],
        description: 'Tìm đến ô số lượng của sản phẩm mới nhất',
        callback: function () {
          var lastRow = angular.element(_.last(element.find('tr')));
          if (!lastRow) return;

          var lastRowInput = _.head(lastRow.find('input'));

          if (!lastRowInput) return;
          lastRowInput.focus();
          lastRowInput.select();
        }
      });
      hotkeys.add({
        combo: 'f2',
        allowIn: ['INPUT'],
        description: 'Tìm đến ô nhập sản phẩm',
        callback: function () {
          var elm = _.head(element.find('input'));

          elm.focus();
          elm.select();
        }
      });
    }
  };
}]).controller('FhdStockEntryItemsInputController', ['$scope', '$window', '$localStorage', 'Authentication', 'ConfirmModal', 'FhdMessenger', 'ModalInputDate', 'ObjectId', 'PreventUnsave', 'ProductService', 'StockEntryService', '$http', 'helper', function ($scope, $window, $localStorage, Authentication, ConfirmModal, FhdMessenger, ModalInputDate, ObjectId, PreventUnsave, ProductService, StockEntryService, $http, helper) {
  const vm = this;
  vm.currentImage = null;
  vm.needNote = false;
  const defaultReasons = ['Lỗi đóng gói PL', 'Thừa hàng cơ sở', 'Ngừng bán cơ sở', 'Lỗi nhà sản xuất', 'Hàng lỗi chuyển cơ sở', 'Thu hồi kho kiểm tra', 'Gửi QC kiểm tra', 'Quá Date', 'Khác'];
  vm.reasons = [];
  const plasticBoxSkus = ['Z0071', 'Z0070'];
  vm.outlet = undefined;
  vm.destination = undefined;
  vm.user = Authentication.user;

  function checkNeedRecycleNote(destination) {
    return _.get(destination, 'code', '').match(/G\d+/);
  }

  vm.updateItemsLocalStorage = function () {
    $localStorage.setObject('stockEntryItems', vm.items);
  };

  function checkNeedNote(outlet, destination) {
    // Nếu là đơn tạo tiêu hủy thì cần lý do
    if (['TRASH', 'R&D', 'VENDOR'].includes(_.get(destination, 'code'))) {
      return true;
    } // Nếu là đơn thu hồi từ nơi bán hàng về kho thì cần lý do


    if (_.get(destination, 'code', '').match(/^(D\d+|KHO)/) && (_.get(outlet, 'isPos') || _.get(outlet, 'code') === 'E0')) {
      return true;
    }

    if (_.get(destination, 'code', '') === 'M6' && _.get(outlet, 'isPos') && _.get(outlet, 'region') === 'SOUTH') {
      return true;
    } // Nếu là đơn chuyển cho DG thì cần lý do


    if (checkNeedRecycleNote(destination)) {
      return true;
    }

    return false;
  }

  function getReasons(outlet, destination) {
    let reasons = defaultReasons;

    if (_.get(outlet, 'code', '').match(/S\d+/)) {
      reasons = reasons.concat(['Cuối ca', 'Quá 3 tiếng']);
    }

    if (checkNeedRecycleNote(destination)) {
      reasons = ['Tái chế', 'Chuyển hàng RAW'];
    }

    return reasons.sort();
  }

  $scope.$watch('vm.outletData', function (newValue) {
    if (!newValue) return;
    const {
      outlet,
      destination
    } = newValue;
    vm.outlet = outlet;
    vm.destination = destination;

    if (checkNeedNote(vm.outlet, vm.destination)) {
      vm.reasons = getReasons(vm.outlet, vm.destination);
      vm.needNote = true;
    } else {
      vm.needNote = false;
    }

    if (_.get(destination, 'code') === 'TRASH' && _.get(outlet, 'code', '').match(/[SK]\d+/)) {
      _.forEach(vm.items, item => {
        if (_.some(_.get(item, 'tags', []), tag => {
          return tag.match(/(Restock (B[12]|5h)|Direct)/gim);
        })) {
          item.showInputManufacturingDate = true;
        }
      });
    }
  }, true);

  function getProductError({
    product,
    warehouseRestockIds
  }) {
    const outletCode = _.get(vm.outlet, 'code', '');

    const destinationCode = _.get(vm.destination, 'code', '');

    const sku = product.sku;
    const description = product.description;

    if (['V0881', 'V0882', 'V0883', 'V0884'].includes(sku)) {
      return `Bạn hãy tạo tiêu hủy bằng mã: V0891 - Suất bánh gạo size nhỏ nhé.`;
    }

    if (['V1294'].includes(sku) && !outletCode.match(/B\d+/)) {
      return `Hạt chia chỉ được tạo đơn từ B1`;
    }

    if (sku.match(/R\d+/) && !outletCode.match(/(G\d+|B4|B1)/)) {
      return `Mã R chỉ được thêm vào cho LE chuyển từ cơ sở DG`;
    }

    if (sku.match(/R\d+/) && !outletCode.match(/(G\d+|B4|B1)/)) {
      return `Mã R chỉ được thêm vào cho LE chuyển từ cơ sở DG`;
    } // Mã B đến ĐG phải có hàng RAW


    if (sku.match(/^B\d+/) && _.includes(vm.packingOutletCodes, destinationCode) && !_.get(product.rawProducts, 'length')) {
      return `Sản phẩm ${sku} - ${description} này không có RAW products tương ứng nên không được tạo phiếu chuyển DG, vui lòng liên hệ Buying và BS để xử lý`;
    }

    if (sku.match(/^B\d+/) && destinationCode.match(/([BS]\d+|SS)/) && !_.some(product.convertProducts, convertProduct => {
      return convertProduct.sku.match(/^V\d+/);
    })) {
      return `Sản phẩm ${sku} - ${description} này không có sản phẩm quy đổi tương ứng sang mã V nên không được tạo phiếu chuyển Savor, vui lòng liên hệ Buying và BS để xử lý`;
    }

    if (sku.match(/^V\d+/) && ProductService.isFoodProduct(product) && outletCode.match(/B\d+/) && destinationCode.match(/S\d+/) && warehouseRestockIds.length && !_.includes(warehouseRestockIds, _.get(vm.outlet, '_id', ''))) {
      return `Sản phẩm ${sku} - ${description} có kho restock khác với kho restock bạn chọn là ${outletCode}`;
    }

    return false;
  }

  vm.openInputDateModal = function (item) {
    ModalInputDate.openInputDateModal().result.then(date => {
      item.manufacturingDate = date;
    });
  };

  vm.onChange = function (product) {
    const outletCode = _.get(vm.outlet, 'code', '');

    const destinationCode = _.get(vm.destination, 'code', '');

    vm.currentImage = _.get(product, 'imageLink') || _.get(product, 'wooProperties.images[0].src');
    vm.items = vm.items || [];
    const sku = product.sku;
    const description = product.sku; // Mã V hàng food chỉ được tạo từ kho restock mặc định đến cơ sở Savor

    const warehouseRestockIds = _.compact(_.concat([_.get(product, 'warehouseRestock._id')], product.warehouseOutlets));

    const productError = getProductError({
      product,
      warehouseRestockIds
    });

    if (productError) {
      return FhdMessenger.error(productError);
    }

    if (!vm.restockList && sku.match(/^[B]\d+/) && outletCode.match(/[ME]\d+/) && outletCode !== 'E0' && destinationCode !== 'D2' && destinationCode.match(/[D]\d+/)) {
      if (ProductService.isFrozenProduct(_.get(product, 'warehouseGroup')) || _.get(product, 'tetCategory.name', '').match(/^(Socola|Chocochip)/) || _.concat(plasticBoxSkus, ['B6769', 'B6768']).includes(product.sku)) {
        if (!['D4'].includes(destinationCode)) {
          return FhdMessenger.error('Sản phẩm bảo quản tủ đông, mát hoặc socola, chocochip chỉ được thu hồi về D4');
        }
      } else {
        if (!['D5', 'D1'].includes(destinationCode)) {
          return FhdMessenger.error('Sản phẩm bảo quản thường chỉ được thu hồi về D5, D1');
        }
      }
    }

    if (sku.match(/^B\d+/) && _.includes(['D2', 'D4', 'D5'], outletCode) && _.includes(['G3', 'G5'], destinationCode) && warehouseRestockIds.length && !_.includes(warehouseRestockIds, _.get(vm.outlet, '_id', ''))) {
      FhdMessenger.errorStick(`Sản phẩm ${sku} - ${description} có kho restock khác với cơ sở gửi đang được chọn là ${outletCode}`);
    }

    if (outletCode && outletCode.match(/D\d+/) && destinationCode && destinationCode.match(/[ME]\d+/)) {
      // Cho phép tiêu hủy các hàng cùng nhóm phân biệt
      const similarProduct = _.find(vm.items, item => {
        return item.sku !== product.sku && item.similarProductGroup && item.similarProductGroup === product.similarProductGroup;
      });

      if (similarProduct) {
        return FhdMessenger.error(`${similarProduct.sku} ${similarProduct.description} không được ở trong cùng đơn với ${sku} ${description} do 2 sản phẩm này nhìn giống nhau, cùng thuộc nhóm ${product.similarProductGroup}.`);
      }

      if (vm.items.length) {
        const firstItem = _.head(vm.items);

        const itemWarehouseGroup = _.get(firstItem, 'warehouseGroup.name', 'Chưa có');

        const productWarehouseGroup = _.get(product, 'warehouseGroup.name', 'Chưa có');

        if (productWarehouseGroup !== itemWarehouseGroup) {
          return FhdMessenger.errorStick(`Đơn này được tạo cho các sản phẩm hàng ${productWarehouseGroup}. Sản phẩm bạn vừa thêm điều kiện bảo quản là ${itemWarehouseGroup}. Vui lòng tạo một LE khác nhé`);
        }
      }
    }

    const matchProductIndex = _.findIndex(vm.items, {
      sku: sku
    });

    if (matchProductIndex > -1) {
      return addProduct(product, matchProductIndex);
    }

    if (vm.restockReport) {
      if (_.some(vm.restockReport.items, item => {
        return item.sku === product.sku; // && item.khoQuantity + item.waitConfirmQuantity > 0 bỏ phần so sánh với kho quantity
      })) {
        return addProduct(product, matchProductIndex);
      }

      return ConfirmModal.showModal({}, {
        closeButtonText: 'Hủy',
        actionButtonText: 'Thêm vào LE',
        headerText: 'Thêm sản phẩm ngoài Restock Report?',
        bodyText: `Bạn có chắc là bạn muốn thêm sản phẩm ${sku} - ${description} không có trong Restock Report vào Logistic Entry?`
      }).then(() => {
        addProduct(product, matchProductIndex);
      });
    }

    if (vm.restockList) {
      if (_.some(vm.restockList.items, {
        sku
      })) {
        return addProduct(product, matchProductIndex);
      }

      if (destinationCode === 'E0') {
        return FhdMessenger.errorStick(`Sản phẩm này không thuộc restock list. Vui lòng kiểm tra lại`);
      }

      return ConfirmModal.showModal({}, {
        closeButtonText: 'Hủy',
        actionButtonText: 'Thêm vào LE',
        headerText: 'Thêm sản phẩm ngoài Restock List?',
        bodyText: `Bạn có chắc là bạn muốn thêm sản phẩm ${sku} - ${description} không có trong Restock List vào Logistic Entry?`
      }).then(() => {
        addProduct(product, matchProductIndex);
      });
    }

    if (vm.logisticsRequest) {
      if (_.some(vm.logisticsRequest.items, {
        sku
      })) {
        return addProduct(product, matchProductIndex);
      }

      return ConfirmModal.showModal({}, {
        closeButtonText: 'Hủy',
        actionButtonText: 'Thêm vào LE',
        headerText: 'Thêm sản phẩm ngoài Logistics Request?',
        bodyText: `Bạn có chắc là bạn muốn thêm sản phẩm ${sku} - ${description} không có trong Logistics Request vào Logistic Entry?`
      }).then(() => {
        addProduct(product, matchProductIndex);
      });
    }

    addProduct(product, matchProductIndex);
  };

  function addProduct(product, matchProductIndex) {
    const destinationBusinessCode = _.get(vm.destination, 'business.code');

    const outletBusinessCode = _.get(vm.outlet, 'business.code');

    const isBackendOutlet = _.get(vm.outlet, 'code', '').match(/^[DB]\d+/);

    const outletRegion = _.get(vm.destination, 'region', 'NORTH');

    const isPosDestination = _.get(vm.destination, 'isPos');

    const sku = product.sku;

    if (!destinationBusinessCode || !outletBusinessCode) {
      return FhdMessenger.errorStick('Bạn phải chọn nơi gửi và nơi nhận trước khi thêm sản phẩm.');
    }

    if (outletRegion === 'NORTH' && isBackendOutlet && isPosDestination && !vm.restockList) {
      if (destinationBusinessCode === 'ABBY' && sku.match(/^([RWV]|LB)\d+/) && !_.get(product, 'category.cat.name') === 'Bánh kẹo Tết' && !_.get(vm.destination, 'sellBirthdayCake')) {
        return FhdMessenger.errorStick('Không thể chuyển từ kho đến cơ sở bán hàng Abby sản phẩm này.');
      }

      if (destinationBusinessCode === 'SAVOR' && sku.match(/^([RW]|LB)\d+/)) {
        return FhdMessenger.errorStick('Không thể chuyển từ bếp đến cơ sở bán hàng Savor sản phẩm này.');
      }
    } // const matchProductIndex = _.findIndex($scope.items, { sku: product.sku })


    const rejectCheckNumSkuRoles = ['admin', 'kitchen', 'purchaser', 'probation-purchaser'];

    if (matchProductIndex === -1) {
      if (_.get(vm.items, 'length') >= 20 && !_.intersection(vm.user.roles, rejectCheckNumSkuRoles).length) {
        return FhdMessenger.errorStick('Logistics Entry đã có 20 sku. Hãy tạo Logistic Entry mới để thêm các sku khác. Lưu ý đảm bảo mỗi túi/thùng hàng tương ứng với 1 Logistics Entry.');
      }

      const {
        outlet,
        destination
      } = vm.outletData;

      const showInputManufacturingDate = _.get(destination, 'code') === 'TRASH' && _.get(outlet, 'code', '').match(/[SK]\d+/) && _.some(_.get(product, 'tags', []), tag => {
        return tag.match(/(Restock (B[12]|5h)|Direct)/gim);
      });

      let orderEntry;

      if (vm.restockList) {
        const matchItem = _.find(vm.restockList.items, {
          sku: product.sku
        });

        if (matchItem) {
          orderEntry = matchItem.orderEntry;
        }
      }

      const item = {
        product: product._id,
        sku: product.sku,
        description: product.description,
        quantity: product.quantity,
        cogs: product.cogs,
        price: product.price,
        category: product.category,
        warehouseRestock: product.warehouseRestock,
        warehouseGroup: product.warehouseGroup,
        similarProductGroup: product.similarProductGroup,
        saleCode: product.saleCodeObject,
        tags: product.tags,
        showInputManufacturingDate,
        rawProducts: product.rawProducts,
        privateLabel: product.privateLabel,
        plTask: product.plTask,
        plTaskId: product.plTaskId,
        orderEntry
      };

      if (item.saleCode) {
        item.note = `Quá Date (SC: ${item.saleCode.saleCodeId})`;
        item.reason = 'Quá Date';
      }

      if (plasticBoxSkus.includes(item.sku)) {
        const note = `Thu hồi thùng nhựa`;

        if (!vm.reasons.includes(note)) {
          vm.reasons.push(note);
        }

        item.note = note;
        item.reason = note;
      }

      vm.items.unshift(item);
    } else {
      vm.items[matchProductIndex].quantity = helper.addDecimalNumber(vm.items[matchProductIndex].quantity, product.quantity);

      const oldItem = _.head(vm.items.splice(matchProductIndex, 1));

      vm.items.unshift(oldItem);
    } // ($scope.items)


    hookBeforeUnload();
    $localStorage.setObject('stockEntryItems', vm.items);
  }

  function hookBeforeUnload() {
    if (_.get(vm.items, 'length')) {
      PreventUnsave.setPreventUnsave(true);
    } else {
      PreventUnsave.setPreventUnsave(false);
    }
  }

  vm.itemQuantityChanged = function () {
    hookBeforeUnload();
    $localStorage.setObject('stockEntryItems', vm.items);
  };

  vm.removeItem = function (index) {
    vm.items.splice(index, 1);
    hookBeforeUnload();
    $localStorage.setObject('stockEntryItems', vm.items);
  };

  vm.takeNote = function (reason, item) {
    if (reason !== 'Khác') {
      item.note = reason;
      item.otherReason = false;

      switch (reason) {
        case 'Hàng lỗi chuyển cơ sở':
          {
            const outlet = vm.outlet;
            StockEntryService.openFindStockEntryModal(item, outlet).result.then(stockEntry => {
              item.restockStockEntry = stockEntry;
            });
            break;
          }

        case 'Lỗi đóng gói PL':
          {
            item.note = null;
            StockEntryService.openErrorPackReasonModal().result.then(({
              note,
              code,
              plCodes
            }) => {
              item.note = note;

              if (code) {
                item.note += ` (LE: ${code})`;
              }

              if (plCodes) {
                item.note += ` (Lô: ${plCodes})`;
              }
            });
            break;
          }

        case 'Lỗi nhà sản xuất':
          {
            item.note = $window.prompt('Nhập lý do');
            break;
          }

        case 'Quá Date':
          {
            item.note = 'Quá Date (Không có sale code)';
            break;
          }
      }
    } else {
      item.otherReason = true;
      item.note = $window.prompt('Nhập lý do');
    }
  };
}]);
'use strict';

