angular.module('promotion-entries').controller('PromotionEntriesController', ['$stateParams', '$location', '$scope', 'Authentication', 'PromotionEntries', 'FhdMessenger', 'NgTableParams', 'ObjectId', '$sce', 'ConfirmModal', 'UserPhotos', 'UserPhotoService', '$state', '$http', function ($stateParams, $location, $scope, Authentication, PromotionEntries, FhdMessenger, NgTableParams, ObjectId, $sce, ConfirmModal, UserPhotos, UserPhotoService, $state, $http) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {
    startDate: moment().subtract(1, 'month').format('YYYY-MM-DD'),
    endDate: moment().format('YYYY-MM-DD'),
    status: ['overdue', 'active', 'deleted']
  };
  vm.limit = 1;
  vm.promotionEntry = {
    content: ''
  };
  vm.simditorConfig = {
    allowedAttributes: {
      p: ['font-family', 'color'],
      span: ['font-family', 'color'],
      b: ['font-family', 'color'],
      i: ['font-family', 'color'],
      strong: ['font-family', 'color'],
      strike: ['font-family', 'color'],
      u: ['font-family', 'color'],
      h1: ['font-family', 'color'],
      h2: ['font-family', 'color'],
      h3: ['font-family', 'color'],
      h4: ['font-family', 'color'],
      h5: ['font-family', 'color'],
      iframe: ['width', 'height', 'src', 'frameborder', 'allowfullscreen']
    },
    allowedStyles: {
      iframe: ['width', 'height', 'src', 'frameborder', 'allowfullscreen'],
      span: ['font-family', 'color'],
      b: ['font-family', 'color'],
      i: ['font-family', 'color'],
      strong: ['font-family', 'color'],
      strike: ['font-family', 'color'],
      u: ['font-family', 'color'],
      p: ['font-family', 'color'],
      h1: ['font-family', 'color'],
      h2: ['font-family', 'color'],
      h3: ['font-family', 'color'],
      h4: ['font-family', 'color'],
      h5: ['font-family', 'color']
    }
  };

  vm.create = function () {
    if (!vm.promotionEntry.title) {
      return FhdMessenger.error('Bạn chưa nhập tiêu đề');
    }

    if (!vm.promotionEntry.content) {
      return FhdMessenger.error('Bạn chưa nhập nội dung');
    }

    if (!vm.promotionEntry.type) {
      return FhdMessenger.error('Bạn chưa chọn kiểu promotion');
    }

    if (!_.get(vm.promotionEntry, 'scope', '').trim()) {
      return FhdMessenger.error('Bạn chưa nhập phạm vi áp dụng');
    }

    if (!vm.promotionEntry.startDate) {
      return FhdMessenger.error('Bạn chưa nhập ngày bắt đầu');
    }

    if (!vm.promotionEntry.endDate) {
      return FhdMessenger.error('Bạn chưa nhập ngày kết thúc');
    }

    const promotionEntry = new PromotionEntries(vm.promotionEntry);
    promotionEntry.$save().then(() => {
      FhdMessenger.success('Tạp Promotion Entry thành công');
      $location.path('promotion-entries');
    }).catch(err => {
      return FhdMessenger.error(err.message);
    });
  };

  vm.promotionEntriesTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    const startDate = moment(vm.data.startDate).format('YYYY-MM-DD');
    const endDate = moment(vm.data.endDate).format('YYYY-MM-DD');
    vm.query = {
      startDate,
      endDate
    };
    PromotionEntries.query(vm.query).$promise.then(promotionEntries => {
      vm.promotionEntries = promotionEntries;
      vm.promotionEntriesTable.settings({
        dataset: vm.promotionEntries
      });
      FhdMessenger.success('Đã tải xong');
    });
  };

  vm.addImage = newImage => {
    vm.images = vm.images || [];

    if (vm.images.length === Number(vm.limit)) {
      return FhdMessenger.error(`Chỉ được upload tối đa ${vm.limit} ảnh`);
    }

    if (UserPhotoService.getImageSize(newImage) > 2048) {
      FhdMessenger.info('Hình ảnh có kích thước lớn, chờ xử lý');
    }

    const resizePhoto = new UserPhotos({
      data: newImage,
      user: vm.user.username
    });
    resizePhoto.$resizeAndUpload().then(res => {
      const {
        link
      } = _.head(res.uploadedImage);

      if (newImage) {
        vm.promotionEntry.imageLink = link;
      }
    }).catch(error => {
      return FhdMessenger.errorFromServer(error);
    });
  };

  vm.findOne = async () => {
    vm.promotionEntry = PromotionEntries.get({
      promotionEntryId: $stateParams.promotionEntryId
    }).$promise.then(promotionEntry => {
      vm.promotionEntry = promotionEntry;
    });
  };

  vm.update = () => {
    if (!vm.promotionEntry.title) {
      return FhdMessenger.error('Bạn chưa nhập tiêu đề');
    }

    if (!vm.promotionEntry.content) {
      return FhdMessenger.error('Bạn chưa nhập nội dung');
    }

    if (!vm.promotionEntry.startDate) {
      return FhdMessenger.error('Bạn chưa nhập ngày bắt đầu');
    }

    if (!vm.promotionEntry.endDate) {
      return FhdMessenger.error('Bạn chưa nhập ngày kết thúc');
    }

    vm.waiting = true;
    vm.promotionEntry.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('promotion-entries');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.remove = function (promotionEntry) {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Huỷ',
      actionButtonText: 'Xóa',
      headerText: 'Xóa Promotion Entry?',
      bodyText: `Bạn có chắc là bạn muốn xóa Promotion Entry: <strong>${promotionEntry.title} </strong> ? \n`
    }).then(() => {
      vm.waiting = true;
      $http.put(`/promotion-entries/${promotionEntry._id}/remove`, promotionEntry).then(() => {
        FhdMessenger.success('Xoá thành công');
        vm.waiting = false;
        $state.reload();
      }).catch(err => {
        return FhdMessenger.error(err.message);
      });
    });
  };
}]);
"use strict";

