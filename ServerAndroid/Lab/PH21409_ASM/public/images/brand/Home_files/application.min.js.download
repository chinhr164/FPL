// InfoTags controller
angular.module('info-tags').controller('InfoTagsController', ['$scope', '$stateParams', '$location', 'Authentication', 'InfoTags', '$sce', 'NgTableParams', 'FhdMessenger', '$window', function ($scope, $stateParams, $location, Authentication, InfoTags, $sce, NgTableParams, FhdMessenger, $window) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.content = '';
  vm.contentHtml = $sce.trustAsHtml(vm.content);
  $scope.$watch(() => vm.content, (newValue, oldValue) => {
    if (newValue !== oldValue) vm.contentHtml = $sce.trustAsHtml(vm.content);
  });

  vm.checkAll = function () {
    _.forEach(vm.infoTagsTable.data, infoTag => {
      infoTag.toPrint = vm.toPrint;
    });

    vm.changePrintInfoTag();
  };

  vm.changePrintInfoTag = function () {
    vm.printingInfoTags = _.filter(vm.infoTagsTable.data, {
      toPrint: true
    });
  };

  vm.now = function () {
    return moment().toDate();
  }; // Create new InfoTag


  vm.create = function () {
    // Create new InfoTag object
    const infoTag = new InfoTags({
      title: vm.title,
      content: vm.content,
      hideLogo: vm.hideLogo
    }); // Redirect after save

    infoTag.$save(function () {
      // eslint-disable-line angular/info-tag-service
      $location.path('info-tags'); // Clear form fields

      vm.name = '';
    }, FhdMessenger.errorFromServer);
  }; // Remove existing InfoTag


  vm.remove = function (infoTag) {
    if (infoTag) {
      infoTag.$remove() // eslint-disable-line angular/info-tag-service
      .then(() => {
        const index = _.findIndex(vm.infoTags, {
          _id: infoTag._id
        });

        if (index > -1) vm.infoTags.splice(index, 1);
        vm.infoTagsTable.reload();
        FhdMessenger.success('Đã xóa');
      });
    } else {
      vm.infoTag.$remove(function () {
        $location.path('info-tags');
      });
    }
  }; // Update existing InfoTag


  vm.update = function () {
    const infoTag = vm.infoTag;
    infoTag.$update(function () {
      // eslint-disable-line angular/info-tag-service
      $location.path('info-tags');
    }, FhdMessenger.errorFromServer);
  };

  vm.infoTagsTable = new NgTableParams({});
  vm.printingInfoTags = []; // Find a list of InfoTags

  vm.find = function () {
    vm.infoTags = InfoTags.query();
    vm.infoTags.$promise.then(() => {
      _.forEach(vm.infoTags, infoTag => {
        infoTag.contentHtml = $sce.trustAsHtml(infoTag.content);
      });

      vm.infoTagsTable.settings({
        dataset: vm.infoTags
      });
    });
  };

  vm.printInfoTags = () => {
    const document = $window.document;
    const printContents = document.getElementById('print-content').innerHTML; // eslint-disable-line angular/document-service no-undef

    const popupWin = window.open(); // eslint-disable-line angular/window-service

    popupWin.document.open();
    popupWin.document.write(`
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="Content-type" content="text/html;charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <link rel="stylesheet" type="text/css" href="${document.location.origin}/css/bootstrap-theme.css"/>
    <link rel="stylesheet" type="text/css" href="${document.location.origin}/modules/core/css/core.css"/>
    <link rel="stylesheet" type="text/css" href="${document.location.origin}/modules/info-tags/css/info-tags.css"/>
  </head>
  <body>
    <script type="text/javascript" src="${document.location.origin}/lib/jquery/dist/jquery.min.js"></script>
    ${printContents}
    <script>
    $(function(){
          if (window.jsPrintSetup)  {
                  jsPrintSetup.setOption('orientation', jsPrintSetup.kPortraitOrientation);
                  jsPrintSetup.setPaperSizeData(11)

                  // set top margins in millimeters
                  jsPrintSetup.setOption('marginTop', 0);
                  jsPrintSetup.setOption('marginRight', 0);
                  jsPrintSetup.setOption('marginLeft', 0);
                  // jsPrintSetup.setOption('headerStrRight', '&PT');
                  // set empty page footer
                  jsPrintSetup.setOption('footerStrLeft', '');
                  jsPrintSetup.setOption('footerStrCenter', '');
                  jsPrintSetup.setOption('footerStrRight', '');

                  // Suppress print dialog
                  jsPrintSetup.setSilentPrint(true);/** Set silent printing */
                  // Do Print

                  // Restore print dialog
                  jsPrintSetup.print();

          } else {
            window.print()
          }
      })
    </script>
  </body>
</html>
        `);
    popupWin.document.close();
