angular.module('application-forms').controller('ModalInformationProbationShiftsController', ['FhdMessenger', 'NgTableParams', 'ProbationShiftEntriesService', 'probationShiftEntry', 'helper', '$modalInstance', 'ObjectId', '$http', '$window', function (FhdMessenger, NgTableParams, ProbationShiftEntriesService, probationShiftEntry, helper, $modalInstance, ObjectId, $http, $window) {
  const vm = this;
  vm.probationShiftEntry = probationShiftEntry;
  vm.probationShiftsTable = new NgTableParams({
    count: 50
  });
  vm.probationShiftsTable.settings({
    dataset: vm.probationShiftEntry.applicationForms
  });
  vm.hasCome = {};
  vm.assessType = {};
  vm.confirmed = {};
  vm.note = {};

  vm.openSelectPointForApplicationForm = applicationForm => {
    ProbationShiftEntriesService.openSelectPointForApplicationForm({
      applicationForm: applicationForm.applicationForm,
      probationShiftEntryId: vm.probationShiftEntry._id
    }).then(point => {
      applicationForm.point = point;
    });
  };

  _.forEach(vm.probationShiftEntry.applicationForms, applicationForm => {
    const probationShiftEntries = applicationForm.applicationForm.probationShiftEntries;

    const matchProbationShiftEntry = _.find(probationShiftEntries, _probationShiftEntry => {
      return ObjectId.equals(_probationShiftEntry.probationShiftEntry, vm.probationShiftEntry);
    });

    vm.hasCome[applicationForm.applicationForm._id] = _.get(matchProbationShiftEntry, 'hasCome', false);
    vm.assessType[applicationForm.applicationForm._id] = _.get(matchProbationShiftEntry, 'assessType');
    vm.confirmed[applicationForm.applicationForm._id] = _.get(matchProbationShiftEntry, 'confirmed', false);
    vm.note[applicationForm.applicationForm._id] = _.get(matchProbationShiftEntry, 'note');
  });

  vm.checkin = applicationForm => {
    const confirm = $window.confirm(`Bạn chắc chắn muốn cập nhật trạng thái checkin của nhân viên ${applicationForm.fullName}`);

    if (!confirm) {
      // đảo ngược boolean khi cancel
      vm.hasCome[applicationForm._id] = !vm.hasCome[applicationForm._id];
      return;
    }

    vm.waiting = true;
    $http.patch(`/application-forms/${applicationForm._id}/checkin/${vm.probationShiftEntry._id}`, {
      hasCome: vm.hasCome[applicationForm._id]
    }).then(() => {
      if (!vm.hasCome[applicationForm._id]) {
        return FhdMessenger.success('Huỷ checkin thành công');
      }

      return FhdMessenger.success('Checkin thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.confirm = applicationForm => {
    const confirm = $window.confirm(`Bạn chắc chắn muốn confirm nhân viên ${applicationForm.fullName}`);

    if (!confirm) {
      // đảo ngược boolean khi cancel
      vm.confirmed[applicationForm._id] = !vm.confirmed[applicationForm._id];
      return;
    }

    vm.waiting = true;
    $http.patch(`/application-forms/${applicationForm._id}/confirm/${vm.probationShiftEntry._id}`, {
      confirmed: vm.confirmed[applicationForm._id]
    }).then(() => {
      if (!vm.confirmed[applicationForm._id]) {
        return FhdMessenger.success('Huỷ confirm thành công');
      }

      return FhdMessenger.success('Confirm thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.assessTypes = [{
    id: 'none',
    title: 'Chưa chọn'
  }, {
    id: 'eliminated',
    title: 'Loại'
  }, {
    id: 'choosen',
    title: 'Chọn'
  }];
  vm.assessTypesMap = helper.makeMap(vm.assessTypes, 'id');

  vm.selectAssessType = applicationForm => {
    let note = '';

    if (vm.assessTypesMap[vm.assessType[applicationForm._id]].title === 'Loại') {
      note = $window.prompt('Nhập lý do Loại');

      if (!note) {
        return FhdMessenger.error('Chưa điền lý do Loại');
      }
    }

    const confirm = $window.confirm(`Bạn chắc chắn muốn cập nhật đánh giá của nhân viên ${applicationForm.fullName} sang ${vm.assessTypesMap[vm.assessType[applicationForm._id]].title}`);

    if (!confirm) {
      return;
    }

    vm.waiting = true;
    $http.patch(`/application-forms/${applicationForm._id}/assess/${vm.probationShiftEntry._id}`, {
      assessType: vm.assessType[applicationForm._id],
      note
    }).then(() => {
      return FhdMessenger.success('Đánh giá thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.addNote = applicationForm => {
    if (!vm.note[applicationForm._id]) {
      return FhdMessenger.error('Chưa điền ghi chú');
    }

    const confirm = $window.confirm(`Bạn chắc chắn muốn cập nhật ghi chú của nhân viên ${applicationForm.fullName}`);

    if (!confirm) {
      return;
    }

    vm.waiting = true;
    $http.patch(`/application-forms/${applicationForm._id}/add-note/${vm.probationShiftEntry._id}`, {
      note: vm.note[applicationForm._id]
    }).then(() => {
      return FhdMessenger.success('Đánh giá thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.cancel = $modalInstance.dismiss;
}]);
"use strict";

