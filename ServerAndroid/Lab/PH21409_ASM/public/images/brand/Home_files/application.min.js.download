"use strict";

// Checklist entries controller
angular.module('checklist-entries').controller('ChecklistEntriesController', ['$window', 'Authentication', 'ChecklistEntries', 'ChecklistCriterias', 'ChecklistEntriesService', 'FhdMessenger', 'NgTableParams', 'OutletReportService', 'OutletService', 'ObjectId', '$state', '$stateParams', '$scope', '$modal', 'UserNoteService', 'ThumbUpService', 'SticketService', 'helper', '$filter', function ($window, Authentication, ChecklistEntries, ChecklistCriterias, ChecklistEntriesService, FhdMessenger, NgTableParams, OutletReportService, OutletService, ObjectId, $state, $stateParams, $scope, $modal, UserNoteService, ThumbUpService, SticketService, helper, $filter) {
  const vm = this;
  vm.user = Authentication.user;
  vm.isAdminStaff = !!_.intersection(vm.user.roles, ['admin', 'tro-ly-lich-truc']).length;
  vm.data = {};
  vm.newNote = '';
  vm.data.startDate = moment().subtract(1, 'month').startOf('month').format('YYYY-MM-DD');
  vm.data.endDate = moment().format('YYYY-MM-DD');
  vm.data.outletIds = [];
  vm.kpiTableSetting = {
    checklistType: 'outlet',
    dataType: 'number'
  };
  vm.openCreateOutletReportModal = OutletReportService.openCreateOutletReportModal;
  vm.types = ChecklistEntriesService.getTypes();
  vm.typeMap = {};

  vm.hideSendNoti = () => {
    return ['outlet', 'mooncake', 'covid', 'checkGoods', 'customerService'].includes(_.get(vm, 'checklist.type'));
  };

  vm.table = {};
  OutletService.all().then(outlets => {
    vm.data.outlets = outlets;
  });
  $scope.$watch(() => vm.checklist.outlets, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    vm.createChecklistCriteriaTable();
    vm.changeTitle();
  });

  vm.changeTitle = () => {
    if (vm.checklist.type === 'outlet') {
      vm.checklist.title = `Checklist QC - ${_.get(_.head(vm.checklist.outlets), 'code', '')} - W${moment(vm.checklist.date).isoWeek()}`;
    }
  };

  vm.createChecklistCriteriaTable = function () {
    if (!_.get(vm.checklist, 'type') || !_.get(vm.checklist, 'outlets.length') || vm.checklist._id) {
      return;
    }

    const outlet = _.head(vm.checklist.outlets);

    let type = vm.checklist.type;

    const businessCode = _.get(outlet, 'business.code');

    let department = 'BACKEND';

    if (_.get(outlet, 'isStore')) {
      department = 'FRONTEND';
    }

    let checklistCriterias = _.filter(_.cloneDeep(vm.data.checklistCriterias), checklistCriteria => {
      if (_.get(checklistCriteria, 'outlets.length')) {
        return checklistCriteria.type === type && checklistCriteria.business.code === businessCode && checklistCriteria.department === department && _.some(checklistCriteria.outlets, _outlet => {
          return ObjectId.equals(_outlet, outlet);
        });
      }

      return checklistCriteria.type === type && checklistCriteria.business.code === businessCode && checklistCriteria.department === department;
    });

    if (vm.checklist.type === 'topical') {
      vm.data.groups = _.uniq(_.map(checklistCriterias, 'group'));

      if (businessCode === 'ABBY') {
        vm.data.groups = vm.data.groups.concat(['Check complaint của Abby']);
      } else {
        vm.data.groups = vm.data.groups.concat(['Check complaint của Savor']);
      }

      vm.data.groups.push('Check task phát sinh khác');
      vm.data.groups = _.sortBy(vm.data.groups);

      if (vm.checklist.group) {
        checklistCriterias = _.filter(checklistCriterias, {
          group: vm.checklist.group
        });
      }
    }

    vm.checklist.checklistCriterias = checklistCriterias;
  };

  vm.loadProcessors = function () {
    OutletService.loadProcessors('qcProcessors').then(_outletGroupByProcessorMap => {
      vm.outletByProcessorTable = _.map(_outletGroupByProcessorMap, byProcessor => {
        return {
          code: byProcessor.code,
          displayName: byProcessor.displayName,
          outletContent: helper.sortByProperty(_.map(byProcessor.outlets, 'code')).join(', ')
        };
      });
    });
    OutletService.loadProcessors('qcPartTimeProcessors').then(_outletGroupByProcessorMap => {
      vm.outletByPartTimeProcessorTable = _.map(_outletGroupByProcessorMap, byProcessor => {
        return {
          code: byProcessor.code,
          displayName: byProcessor.displayName,
          outletContent: helper.sortByProperty(_.map(byProcessor.outlets, 'code')).join(', ')
        };
      });
    });
  };

  vm.checklist = {};
  vm.checklist.images = vm.checklist.images || [];
  vm.loading = false;
  vm.checklist.type = vm.checklist.type || 'outlet';
  vm.checklistEntriesTable = new NgTableParams({
    count: 50
  });

  vm.removeCheckers = index => {
    if (!_.isArray(vm.checklist.checkers)) return;
    vm.checklist.checkers.splice(index, 1);
  };

  vm.removeStaffs = index => {
    if (!_.isArray(vm.checklist.staffs)) return;
    vm.checklist.staffs.splice(index, 1);
  };

  vm.removeOutlets = index => {
    if (!_.isArray(vm.checklist.outlets)) return;
    vm.checklist.outlets.splice(index, 1);
  };

  vm.changeInputError = staff => {
    if (staff.hasError) {
      staff.error = $window.prompt('Nhập lỗi của nhân viên');
    }
  };

  vm.getGroup = find => {
    return find.then(checklistEntries => {
      return _.sortBy(_.compact(_.uniq(_.map(checklistEntries, checklistEntry => {
        return _.get(checklistEntry, 'group', '');
      }))));
    }).then(groups => {
      return _.map(groups, group => ({
        id: group,
        title: group
      }));
    });
  };

  vm.changeResult = (question, type) => {
    question[type] = false;
  };

  vm.getTypes = () => {
    return vm.types;
  };

  vm.getOutletReportStatus = () => {
    return ['Đã tạo', 'Đã hoàn thành'].map(status => {
      return {
        title: status,
        id: status
      };
    });
  };

  vm.getStatuses = () => {
    const statuses = [{
      title: 'Không vấn đề',
      id: 'error'
    }, {
      title: 'Đang xử lý',
      id: 'processing'
    }, {
      title: 'Đã xử lý',
      id: 'done'
    }];
    return statuses;
  };

  vm.init = () => {
    ChecklistCriterias.query({}).$promise.then(checklistCriterias => {
      vm.data.checklistCriterias = checklistCriterias;
    });
    OutletService.all().then(outlets => {
      vm.data.outlets = outlets;
    });
  }; // Create new Checklist entry


  vm.create = function () {
    if (!vm.checklist.title) {
      FhdMessenger.error('Tiêu đề không được bỏ trống.');
      return;
    }

    if (!_.get(vm.checklist.outlets, 'length')) {
      return FhdMessenger.error('Chưa có cơ sở checklist');
    }

    if (['outlet', 'mooncake', 'covid'].includes(vm.checklist.type)) {
      if (!vm.checklist.date) {
        return FhdMessenger.error('Chưa chọn ngày');
      }

      if (!vm.checklist.time) {
        return FhdMessenger.error('Chưa chọn giờ bắt đầu');
      }

      if (!_.get(vm.checklist, 'checkers.length')) {
        return FhdMessenger.error('Chưa điền tên người kiểm tra');
      }
    }

    if (vm.checklist.type === 'shift') {
      if (!vm.content) {
        return FhdMessenger.error('Chưa nhập nội dung checklist');
      }

      vm.checklist.content = _.map(vm.content.split('\n'), _.trim);
    }

    const missingPointChecklistCriterias = _.filter(vm.checklist.checklistCriterias, checklistCriteria => {
      return checklistCriteria.maxPoint > 0 && !_.isNumber(checklistCriteria.point);
    });

    if (missingPointChecklistCriterias.length) {
      return FhdMessenger.error('Có mục chưa được chấm điểm: ' + _.map(missingPointChecklistCriterias, 'content').join('<br>'));
    }

    const missingErrorChecklistCriterias = _.filter(vm.checklist.checklistCriterias, checklistCriteria => {
      return _.get(checklistCriteria, 'values.length') > 0 && !checklistCriteria.error || checklistCriteria.requiredError && !checklistCriteria.error;
    });

    if (missingErrorChecklistCriterias.length) {
      return FhdMessenger.error('Có mục chưa được chọn kết quả kiểm tra trong các giá trị yêu cầu/điền lỗi: ' + _.map(missingErrorChecklistCriterias, 'content').join('<br>'));
    }

    const missingNumberErrorChecklistCriterias = _.filter(vm.checklist.checklistCriterias, checklistCriteria => {
      return checklistCriteria.isNumber && !_.isNumber(checklistCriteria.error);
    });

    if (missingNumberErrorChecklistCriterias.length) {
      return FhdMessenger.error('Có mục chưa được điền : ' + _.map(missingErrorChecklistCriterias, 'content').join('<br>'));
    }

    if (!vm.checklist.endTime) {
      return FhdMessenger.error('Chưa nhập giờ kết thúc checklist');
    }

    if (vm.checklist.type === 'outlet') {
      const endTime = helper.combineTimeAndDate(vm.checklist.date, vm.checklist.endTime);

      if (moment().isAfter(moment(endTime).add(48, 'hours'))) {
        return FhdMessenger.error('Thời gian tạo checklist cách giờ check tối đa 48h');
      }
    } // Create new Checklist entry object


    const checklistEntry = new ChecklistEntries(vm.checklist);
    vm.loading = true;

    if (vm.checklist.images.length > 10) {
      FhdMessenger.info('Số lượng ảnh lớn đang được xử lý');
    } // Redirect after save


    checklistEntry.$save(function (response) {
      vm.loading = false;
      FhdMessenger.success('Thêm thành công!');
      $state.reload();
    }, function (errorResponse) {
      vm.loading = false;
      FhdMessenger.error(errorResponse.data.message);
    });
  };

  vm.find = async function () {
    const types = _.reduce(vm.types, (result, type) => {
      if (vm.typeMap[type.id]) result.push(type.id);
      return result;
    }, []);

    vm.waiting = true;
    FhdMessenger.info('Đang tải ....');
    return ChecklistEntries.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      outlets: vm.data.outletIds,
      types
    }).$promise.then(checklistEntries => {
      // _.forEach(checklistEntries, checklistEntry => checklistEntry.result.replace('\n', '<br>'))
      // console.log(checklistEntries[0].result)
      const combinedChecklistEntries = _.map(checklistEntries, checklistEntry => {
        checklistEntry.outletString = _.map(_.compact([...checklistEntry.outlets, checklistEntry.outlet]), 'code').join(', ');
        checklistEntry.outletReportStatus = getOutletReportStatus(checklistEntry);
        return checklistEntry;
      });

      vm.checklistEntriesTable.settings({
        dataset: combinedChecklistEntries
      });
      vm.checklistEntries = checklistEntries;
      fetchKpiTable(checklistEntries);
      return checklistEntries;
    }).finally(() => {
      vm.waiting = false;
    });
  };

  function getOutletReportStatus(checklistEntry) {
    if (!checklistEntry.outletReport) {
      return '';
    }

    if (checklistEntry.outletReport.status === 'done') {
      return 'Đã hoàn thành';
    }

    return 'Đã tạo';
  }

  function numberValue($scope, row) {
    // eslint-disable-next-line
    const value = _.get(row, this.field);

    if (!value) {
      return '<span></span>';
    }

    if (vm.kpiTableSetting.dataType === 'number') {
      return `<span>${$filter('number')(value.number, '')}</span>`;
    }

    return `<span>${$filter('number')(value.percent, '')} %</span>`;
  }

  function normalValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${_.get(row, vm.field) || ''}</span>`;
  }

  function fetchKpiTable(checklistEntries) {
    const kpiData = _.filter(checklistEntries, checklistEntry => {
      return checklistEntry.type === vm.kpiTableSetting.checklistType;
    });

    vm.checkerSummary = {};
    const kpiTableData = helper.sortByProperty(_.reduce(kpiData, (result, checklistEntry) => {
      result = result || [];

      const outletCode = _.get(checklistEntry, 'outlet.code', 'Không xác định');

      const checkers = _.get(checklistEntry, 'checkers', []);

      result = result || [];

      _.forEach(checkers, checker => {
        const match = _.find(result, {
          outletCode: outletCode
        });

        if (match) {
          match[checker.displayName] = match[checker.displayName] || {};
          match[checker.displayName].number = match[checker.displayName].number || 0;
          match[checker.displayName].number += 1;
          match['outletCheckedTotal'].number += 1;
        } else {
          result.push({
            outletCode: outletCode,
            [checker.displayName]: {
              number: 1
            },
            outletCheckedTotal: {
              number: 1
            }
          });
        }

        vm.checkerSummary[checker.displayName] = vm.checkerSummary[checker.displayName] || {};
        vm.checkerSummary[checker.displayName].number = vm.checkerSummary[checker.displayName].number || 0;
        vm.checkerSummary[checker.displayName].number += 1;
      });

      return result;
    }, []), 'outletCode');
    vm.checkerSummary.outletCode = 'Total';
    vm.checkerSummary.outletCheckedTotal = {
      number: _.sumBy(vm.checkerSummary, 'number'),
      percent: 100
    };

    const checkerSummaryMap = _.reduce(vm.checkerSummary, (result, countData, checker) => {
      result[checker] = result[checker] || 0;
      result[checker] = countData.number;
      return result;
    }, {});

    kpiTableData.push(vm.checkerSummary);

    _.forEach(kpiTableData, object => {
      _.forEach(object, (counter, key) => {
        if (checkerSummaryMap[key]) {
          counter.percent = counter.number / checkerSummaryMap[key] * 100;
        }
      });
    });

    const checkers = _.uniqBy(_.flatten(_.map(kpiData, 'checkers')), '_id');

    vm.cols = [{
      title: 'Cơ sở',
      field: 'outletCode',
      getValue: normalValue
    }];

    _.forEach(checkers, checker => {
      vm.cols.push({
        title: checker.displayName,
        field: checker.displayName,
        getValue: numberValue
      });
    });

    vm.cols.push({
      title: 'Total',
      field: 'outletCheckedTotal',
      getValue: numberValue
    });
    vm.kpiChecklistTable = new NgTableParams({
      count: 50
    });
    vm.kpiChecklistTable.settings({
      dataset: kpiTableData
    });
  }

  vm.openModalNoteDetail = userNote => {
    $modal.open({
      templateUrl: '/modules/checklist-entries/templates/modal-note-detail.client.template.html',
      controller: ['$modalInstance', 'userNote', function ($modalInstance, userNote) {
        const vm = this;
        vm.userNote = userNote;

        vm.close = () => $modalInstance.close();
      }],
      controllerAs: 'vm',
      resolve: {
        userNote: () => userNote
      }
    });
  };

  vm.openModalTicketDetail = sticket => {
    $modal.open({
      templateUrl: '/modules/checklist-entries/templates/modal-sticket-detail.client.template.html',
      controller: ['$modalInstance', 'sticket', function ($modalInstance, sticket) {
        const vm = this;
        vm.sticket = sticket;

        vm.close = () => $modalInstance.close();
      }],
      controllerAs: 'vm',
      resolve: {
        sticket: () => sticket
      }
    });
  };

  vm.openModalThumbUpDetail = thumbUp => {
    $modal.open({
      templateUrl: '/modules/checklist-entries/templates/modal-thumbup-detail.client.template.html',
      controller: ['$modalInstance', 'thumbUp', function ($modalInstance, thumbUp) {
        const vm = this;
        vm.thumbUp = thumbUp;

        vm.close = () => $modalInstance.close();
      }],
      controllerAs: 'vm',
      resolve: {
        thumbUp: () => thumbUp
      }
    });
  };

  vm.staffSelected = staff => {
    vm.staff = null;
    vm.checklist.staffs = vm.checklist.staffs || [];

    if (!staff || _.some(vm.checklist.staffs, checklistStaff => {
      return _.isEqual(ObjectId.getObjectId(checklistStaff.staff), ObjectId.getObjectId(staff));
    })) {
      return;
    }

    vm.checklist.staffs.push({
      staff
    });
  };

  vm.outletSelected = outlet => {
    if (!outlet) {
      return;
    }

    vm.checklist.outlets = vm.checklist.outlets || [];

    if (_.some(vm.checklist.outlets, checklistOutlet => {
      return ObjectId.equals(checklistOutlet, outlet);
    })) {
      vm.outlet = null;
      return FhdMessenger.error('Đã có cơ sở này trong danh sách');
    }

    vm.checklist.outlets.push(outlet);
    vm.outlet = null;
  };

  vm.findOne = async function () {
    ChecklistEntries.get({
      checklistEntryId: $stateParams.checklistEntryId
    }).$promise.then(checklistEntry => {
      vm.checklist = checklistEntry;

      if (vm.checklist.type === 'shift') {
        vm.content = vm.checklist.content.join('\n');
        vm.checklist.outletString = _.map(_.compact([...checklistEntry.outlets, checklistEntry.outlet]), 'code').join(',');
      }
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    });
  };

  vm.update = async function () {
    vm.loading = true;
    let checklistEntry = vm.checklist;

    if (vm.checklist.images.length > 10) {
      FhdMessenger.info('Số lượng ảnh lớn đang được xử lý');
    }

    checklistEntry.$update().then(newChecklist => {
      $state.go('viewChecklistEntry', {
        checklistEntryId: newChecklist._id
      });
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.loading = false;
    });
  };

  function updateCheckListAfterCloseModal(data, type, indexStaff) {
    let checklistEntry = vm.checklist;

    switch (type) {
      case 'userNote':
        checklistEntry.staffs[indexStaff].userNote = data;
        break;

      case 'thumbUp':
        checklistEntry.staffs[indexStaff].thumbUp = data;
        break;

      case 'sticket':
        checklistEntry.staffs[indexStaff].sticket = data;
        break;

      default:
        return FhdMessenger.error('Unknown type modal');
    }

    checklistEntry.$update().catch(err => {
      FhdMessenger.error(err.data.message);
    });
  }

  vm.onSelectOutlet = outletSelected => {
    vm.data.outletIds = _.map(outletSelected, '_id');
  };

  vm.onSelectAllType = () => {
    let changeValue = true;
    if (_.every(vm.typeMap)) changeValue = false;

    _.forEach(vm.typeMap, (value, key) => {
      vm.typeMap[key] = changeValue;
    });
  };

  vm.sendUserNote = (userNotes, indexStaff) => {
    UserNoteService.openAddUserNoteModal(userNotes).then(userNotes => {
      // vm.userNotes = [...userNotes, ...vm.userNotes]
      updateCheckListAfterCloseModal(userNotes[0], 'userNote', indexStaff);
    });
  };

  vm.addThumbUpModal = (userId, checklist, indexStaff) => {
    ThumbUpService.addThumbUpModal(userId, checklist).then(thumbUp => {
      updateCheckListAfterCloseModal(thumbUp, 'thumbUp', indexStaff);
    });
  };

  vm.addTicketModal = (source, indexStaff) => {
    SticketService.openCreateTicket(source).then(sticket => {
      updateCheckListAfterCloseModal(sticket, 'sticket', indexStaff);
    });
  };

  vm.responses = function () {
    if (vm.newNote && vm.newNote.length) {
      vm.checklist.responses = vm.checklist.responses || [];
      vm.checklist.responses.push({
        content: vm.newNote,
        user: Authentication.user,
        time: new Date()
      });
    }

    const notes = vm.checklist;
    vm.waiting = true;
    notes.$update().then(() => {
      FhdMessenger.success('Thêm thành công');
    }).catch(err => {
      vm.error = err.data.message;
    }).finally(() => {
      vm.waiting = false;
      vm.newNote = '';
    });
  };

  $scope.$watch(() => vm.kpiTableSetting.checklistType, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    fetchKpiTable(vm.checklistEntries);
  });
}]);
"use strict";

angular.module('checklist-entries').filter('checklistEntryStatus', [function () {
  return function (type) {
    switch (type) {
      case 'done':
        return 'Đã xử lý';

      case 'processing':
        return 'Đang xử lý';

      case 'no-error':
        return 'Không vấn đề';

      default:
        return type;
    }
  };
}]);
"use strict";

angular.module('checklist-entries').filter('checklistGroup', [function () {
  return function (group) {
    switch (group) {
      case 'outlet':
        return 'Cơ sở';

      default:
        return group;
    }
  };
}]);
"use strict";

angular.module('checklist-entries').filter('checklistType', ['ChecklistEntriesService', 'helper', function (ChecklistEntriesService, helper) {
  const types = ChecklistEntriesService.getTypes();
  const typeMap = helper.makeMap(types, 'id');
  return function (type) {
    return _.get(typeMap[type], 'title', type);
  };
}]);
