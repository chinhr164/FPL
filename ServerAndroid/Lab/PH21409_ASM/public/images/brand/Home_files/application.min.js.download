angular.module('votes').controller('VotePerformanceResultController', ['Votes', 'VoteService', function (Votes, VoteService) {
  const vm = this;
  vm.basePerformances = VoteService.getPerformances();
  vm.performances = Votes.summarizePerformance();
  vm.chartData = [];
  vm.chartLabels = [];
  vm.chartSeries = ['Kết quả bình chọn'];
  vm.performances.$promise.then(() => {
    _.forEach(vm.basePerformances, basePerformance => {
      const matchPerformance = _.find(vm.performances, {
        _id: basePerformance.value
      });

      if (!matchPerformance) {
        vm.performances.push({
          _id: basePerformance.value,
          content: `${basePerformance.name} của ${basePerformance.performer}`,
          voters: [],
          count: 0
        });
      }
    });

    vm.chartData.push(_.map(vm.performances, 'count'));
    vm.chartLabels.push(..._.map(vm.performances, 'content'));
  });
}]);
"use strict";

angular.module('votes').controller('VotePerformanceController', ['Votes', '$state', 'FhdMessenger', 'ConfirmModal', 'Settings', 'VoteService', function (Votes, $state, FhdMessenger, ConfirmModal, Settings, VoteService) {
  const vm = this;
  vm.data = {};
  vm.data.settings = Settings.get();
  vm.performances = VoteService.getPerformances();

  vm.vote = () => {
    if (!vm.performance) {
      FhdMessenger.error('Bạn chưa chọn tiết mục mình muốn bình chọn.');
      return;
    }

    const content = `${vm.performance.name} của ${vm.performance.performer}`;
    ConfirmModal.showModal({}, {
      closeButtonText: 'Không',
      actionButtonText: 'Bình chọn',
      headerText: 'Bạn chắc chắn chưa?',
      bodyText: `Bạn có chắc là bạn muốn bình chọn cho tiết mục ${content}?`
    }).then(() => {
      const vote = new Votes({
        code: 'TALENT_SHOW_2021',
        content,
        candidateCode: vm.performance.value
      });
      vm.waiting = true;
      vote.$save().then(vote => {
        $state.go('voteSuccess', {
          voteId: vote._id
        });
      }).catch(err => {
        if (_.get(err, 'data.message', '').match(/đã bị trùng/)) {
          FhdMessenger.error('Bạn đã bình chọn rồi');
          return;
        }

        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.toggleAllowVote = () => {
    FhdMessenger.info('Đang cập nhật...');
    vm.waiting = true;
    vm.data.settings.$toggleAllowVote().then(settings => {
      const {
        allowVote
      } = settings;
      const action = allowVote ? 'mở' : 'đóng';
      FhdMessenger.success(`Đã ${action}`);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

angular.module('votes').controller('VoteController', ['$state', '$sce', 'Authentication', 'FhdMessenger', 'Votes', 'ConfirmModal', function ($state, $sce, Authentication, FhdMessenger, Votes, ConfirmModal) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.comments = {};
  vm.displayComments = {};
  vm.expired = moment().startOf('day').diff(moment('2020-01-09').endOf('day')) > 0;
  vm.expiredVideoVote = moment().startOf('day').diff(moment('2021-01-03').endOf('day')) > 0 && !vm.user.roles.includes('admin');
  vm.videos = [{
    _id: '11111',
    link: 'https://www.youtube.com/embed/576lHM6cQRM',
    description: 'B1 - Happy Birthday 4handy'
  }, {
    _id: '11112',
    link: 'https://www.youtube.com/embed/ikjI-MHTFdM',
    description: 'E1 - With Luv'
  }, {
    _id: '11113',
    link: 'https://www.youtube.com/embed/fR_Iot_C-g8',
    description: 'E13'
  }, {
    _id: '11114',
    link: 'https://www.youtube.com/embed/Lv5FcKb7NKY',
    description: 'E15'
  }, {
    _id: '11115',
    link: 'https://www.youtube.com/embed/IPsUIb7tBUY',
    description: 'E17'
  }, {
    _id: '11116',
    link: 'https://www.youtube.com/embed/tCPTT14ht2o',
    description: 'E19'
  }, {
    _id: '11117',
    link: 'https://www.youtube.com/embed/R_qf72SeujE',
    description: 'E20'
  }, {
    _id: '11119',
    link: 'https://www.youtube.com/embed/ZuXgvOM86o0',
    description: 'Kho - Những Chiến Binh Mạnh Mẽ'
  }, {
    _id: '11120',
    link: 'https://www.youtube.com/embed/tfMCzEDPJu4',
    description: 'Lịch trực'
  }, {
    _id: '11121',
    link: 'https://www.youtube.com/embed/PbJT4YaPElE',
    description: 'MKT - Tại 4handy Có Gì Vui'
  }, {
    _id: '11122',
    link: 'https://www.youtube.com/embed/p4Q1SoP0jfk',
    description: 'SE29'
  }, {
    _id: '11123',
    link: 'https://www.youtube.com/embed/QqeI1fhZyqM',
    description: '1001 lý do bị ticket ở E0'
  }, {
    _id: '11124',
    link: 'https://www.youtube.com/embed/fDXZyRfcy-0',
    description: 'Chúng mình là S7 đây!'
  }, {
    _id: '11125',
    link: 'https://www.youtube.com/embed/bmyfKj1292M',
    description: 'G1'
  }, {
    _id: '11126',
    link: 'https://www.youtube.com/embed/0LKQodUCa8Y',
    description: 'HR'
  }];

  vm.trust = link => {
    return $sce.trustAsResourceUrl(link);
  };

  vm.init = function () {
    Votes.comment().$promise.then(result => {
      vm.staffs = _.map(vm.staffs, staff => {
        const getStaffComments = _.find(result, comment => comment._id === staff._id) || [];
        staff.comments = getStaffComments.comments;
        return staff;
      });
    });
    Votes.me().$promise.then(result => {
      const getVoters = _.map(result, vote => vote.user.displayName);

      vm.staffs = _.map(vm.staffs, staff => {
        if (staff._id === vm.user._id) {
          staff.voters = getVoters;
        }

        return staff;
      });
    });
  };

  vm.toggle = staff => {
    if (vm.displayComments[staff._id]) {
      vm.displayComments[staff._id] = false;
    } else vm.displayComments[staff._id] = true;
  };

  vm.create = function (staff) {
    if (vm.user._id === staff._id) {
      return FhdMessenger.error('Không được vote cho chính mình nha');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc là bạn muốn bình chọn cho ${staff.displayName} - ${staff.outletCode}`,
      actionButtonText: 'Vote',
      closeButtonText: 'Suy nghĩ lại'
    }).then(() => {
      const vote = new Votes({
        user: vm.user,
        staff: staff,
        code: 'EMPLOYEE_2020'
      });
      vm.waiting = true;
      vote.$save(function () {
        FhdMessenger.success('Bạn đã vote thành công');
        $state.go('home');
      }, function (errorResponse) {
        if (_.get(errorResponse, 'data.message', '').match(/bị trùng/i)) {
          FhdMessenger.error('Bạn đã vote rồi');
          return;
        }

        FhdMessenger.errorFromServer(errorResponse);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.createVideoVote = function (video) {
    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc là bạn muốn bình chọn cho ${video.description}`,
      actionButtonText: 'Vote',
      closeButtonText: 'Suy nghĩ lại'
    }).then(() => {
      const vote = new Votes({
        user: vm.user,
        candidateCode: video._id,
        code: '4HANDY_VIDEO_2021'
      });
      vm.waiting = true;
      vote.$save(function () {
        FhdMessenger.success('Bạn đã vote thành công');
        video.voted = true;
      }, function (errorResponse) {
        if (_.get(errorResponse, 'data.message', '').match(/bị trùng/i)) {
          FhdMessenger.error('Bạn đã vote rồi');
          return;
        }

        FhdMessenger.errorFromServer(errorResponse);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.addComment = function (staff) {
    const comment = vm.comments[staff._id];
    const vote = new Votes({
      user: vm.user,
      staff: staff,
      content: comment,
      code: 'COMMENT_2020'
    });
    vm.waiting = true;
    vote.$save(function () {
      FhdMessenger.success('Cảm ơn bạn');
      $state.reload();
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.summarize4handyVideo = () => {
    if (vm.user.roles.includes('admin')) {
      Votes.summarize4handyVideo().$promise.then(data => {
        _.forEach(vm.videos, video => {
          const matchVote = _.find(data, {
            candidateCode: video._id
          });

          if (matchVote) {
            video.result = matchVote;
          }
        });
      });
    }
  };

  vm.getMyVotes = code => {
    Votes.getMyVotes({
      code
    }).$promise.then(votes => {
      _.forEach(vm.videos, video => {
        const matchVote = _.find(votes, {
          candidateCode: video._id
        });

        if (matchVote) {
          video.voted = true;
        }
      });
    });
  };
}]);
