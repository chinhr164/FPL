  // Expenses state routing
  $stateProvider.state('listExpenseSubCategories', {
    url: '/expense-sub-categories',
    templateUrl: 'modules/expense-sub-categories/views/list-expense-sub-categories.client.view.html',
    resolve: {
      $title: _.constant('Expenses Sub Category')
    }
  }).state('createExpenseSubCategory', {
