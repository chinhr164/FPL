"use strict";

// Contacts controller
angular.module('contacts').controller('ContactsController', ['$scope', 'OutletService', 'FhdMessenger', 'Contacts', '$q', '$stateParams', 'Outlets', 'NgTableParams', '$http', '$location', '$state', 'ConfirmModal', 'ContactService', function ($scope, OutletService, FhdMessenger, Contacts, $q, $stateParams, Outlets, NgTableParams, $http, $location, $state, ConfirmModal, ContactService) {
  const vm = this;

  vm.create = function () {
    var contact = new Contacts(vm.contact);

    if (!ContactService.validateContact(contact)) {
      return;
    }

    return contact.$save(function (response) {
      $location.path('contacts/create');
      FhdMessenger.success(`Tạo contact ${contact.fullName} thành công`); // Clear form fields

      vm.contact = '';
      $state.reload();
    }, function (err) {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.selectOutlet = outlet => {
    vm.contact.outlets = vm.contact.outlets || [];
    vm.contact.outlets.push(outlet);
  };

  vm.removeOutlet = index => {
    vm.contact.outlets = vm.contact.outlets || [];
    vm.contact.outlets.splice(index, 1);
  };

  vm.findOne = function () {
    vm.contact = Contacts.get({
      contactId: $stateParams.contactId
    });
  };

  vm.update = function () {
    var contact = new Contacts(vm.contact);

    if (!ContactService.validateContact(contact)) {
      return;
    }

    return contact.$update(function () {
      $location.path('contacts/' + contact._id);
      FhdMessenger.success('Cập nhật thành công');
      $state.reload();
    }, function (err) {
      vm.submitting = false;
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.contactsTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    Contacts.query().$promise.then(data => {
      vm.contactsTable.settings({
        dataset: data
      });
    });
  };

  vm.remove = function (contact, index) {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Thôi',
      actionButtonText: 'Xóa contact này',
      headerText: 'Xóa Contact?',
      bodyText: `Bạn có chắc là bạn muốn xóa ${contact.fullName}?`
    }).then(() => {
      if (contact) {
        contact.$remove();
        vm.contactsTable.data.splice(index, 1);
        vm.contactsTable.settings({
          dataset: vm.contactsTable.data
        });
      }
    });
  };
}]);
"use strict";

angular.module('contacts').factory('ContactService', ['FhdMessenger', function (FhdMessenger) {
  function validateContact(contact) {
    if (!contact.fullName) {
      FhdMessenger.error('Bạn chưa nhập tên');
      return false;
    }

    if (!this.validateName(contact.fullName)) {
      FhdMessenger.error('Tên chỉ được chứa chữ cái');
      return false;
    }

    if (!contact.address) {
      FhdMessenger.error('Bạn chưa nhập địa chỉ');
      return false;
    }

    if (!contact.cellphone) {
      FhdMessenger.error('Bạn chưa nhập số điện thoại');
      return false;
    }

    if (!this.validatePhoneNumber(contact.cellphone)) {
      FhdMessenger.error('Bạn nhập sai số điện thoại');
      return false;
    }

    if (!contact.outlets) {
      FhdMessenger.error('Bạn chưa chọn cơ sở');
      return false;
    }

    return true;
  }

  function validatePhoneNumber(phoneNumber) {
    const regexNumber = /(03|07|08|09|01[2|6|8|9])+([0-9]{8})\b/;

    if (phoneNumber.match(regexNumber)) {
      return true;
    } else {
      return false;
    }
  }

  function validateName(name) {
    const regexName = /^([^0-9]*)$/;

    if (name.match(regexName)) {
      return true;
    } else {
      return false;
    }
  }

  return {
    validatePhoneNumber,
    validateName,
    validateContact
  };
}]);
"use strict";

angular.module('contacts').factory('Contacts', ['$resource', function ($resource) {
  return $resource('contacts/:contactId', {
    contactId: '@_id'
  }, {
    update: {
      method: 'PUT'
    }
  });
}]);
