    vm.outletReport = {
      type: 'check-product',
      description: vm.workTask.detail,
      title: `Xử lý lỗi hàng hóa trong QC Task - ${vm.getWorkTaskSku}`,
      link: `work.4-handy.com/#!/work-tasks/${vm.workTask._id}`,
      workTask: vm.workTask._id
    };
    vm.disabledSelectType = true;
  }

  if (data.checklistEntry) {
    const checklistEntry = data.checklistEntry;
    vm.outletReport = {
      checklistEntry: checklistEntry,
      type: 'checklist-entry',
      outlets: [checklistEntry.outlet._id],
      title: `Xử lý vấn đề trong checklist cơ sở ${checklistEntry.title}`
