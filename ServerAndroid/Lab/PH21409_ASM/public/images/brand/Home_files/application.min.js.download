angular.module('mkt-posts').controller('mktPostsController', ['$stateParams', '$location', '$scope', 'Authentication', 'MktPosts', 'FhdMessenger', 'NgTableParams', 'ObjectId', '$state', 'ConfirmModal', 'MktPostService', function ($stateParams, $location, $scope, Authentication, MktPosts, FhdMessenger, NgTableParams, ObjectId, $state, ConfirmModal, MktPostService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.content = '';
  vm.data = {};
  vm.data.startDate = moment().subtract(1, 'weeks').startOf('weeks').format('YYYY-MM-DD');
  vm.data.endDate = moment().endOf('day').format('YYYY-MM-DD');
  vm.data.filterTimeType = 'createdDate';
  vm.dateTypes = [{
    id: 'postTime',
    name: 'Ngày đăng bài'
  }, {
    id: 'createdDate',
    name: 'Ngày tạo'
  }];
  vm.types = MktPostService.getTypes();
  vm.updatePostSalary = MktPostService.openUpdatePostSalary;

  vm.create = function () {
    if (!vm.mktPost.title) {
      return FhdMessenger.error('Chưa điền tiêu đề');
    }

    if (!vm.mktPost.mktPostType) {
      return FhdMessenger.error('Chưa chọn kiểu');
    }

    if (!vm.mktPost.url) {
      return FhdMessenger.error('Chưa điền link');
    }

    if (!vm.mktPost.postTime) {
      return FhdMessenger.error('Chưa điền thời gian đăng bài');
    }

    if (moment().diff(moment(vm.mktPost.postTime), 'day', true) > 1) {
      return FhdMessenger.error('Chỉ được tạo MKT Post trong vòng 24h kể từ khi đăng bài');
    }

    const mktPost = new MktPosts(vm.mktPost);
    vm.waiting = true;
    mktPost.$save().then(() => {
      FhdMessenger.success('Tạo Marketing Post thành công');
      $state.go('listMktPosts');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.mktPostsTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    vm.waiting = true;
    MktPosts.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      filterTimeType: vm.data.filterTimeType
    }).$promise.then(mktPosts => {
      vm.mktPosts = _.map(mktPosts, mktPost => {
        mktPost.userName = `${mktPost.user.code} - ${mktPost.user.displayName}`;
        return mktPost;
      });
      vm.mktPostsTable.settings({
        dataset: vm.mktPosts
      });
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = () => {
    vm.mktPost = MktPosts.get({
      mktPostId: $stateParams.mktPostId
    }).$promise.then(mktPost => {
      vm.mktPost = mktPost;
      vm.mktPost.postTime = moment(vm.mktPost.postTime).toDate();
    });
  };

  vm.update = () => {
    vm.waiting = true;

    try {
      if (!vm.mktPost.salary) {
        return FhdMessenger.error('Chưa chọn mức lương');
      }

      vm.mktPost.$update().then(response => {
        FhdMessenger.success('Cập nhật thành công');
        $state.go('listMktPosts');
      }).catch(err => {
        FhdMessenger.error(err.data.message);
      }).finally(() => {
        vm.waiting = false;
      });
    } catch (err) {
      FhdMessenger.error(err.message);
    } finally {
      vm.waiting = false;
    }
  };

  vm.remove = function (mktPost) {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Huỷ',
      actionButtonText: 'Xóa',
      headerText: 'Xóa post này ?',
      bodyText: `Bạn có chắc là bạn muốn xóa post này không ? `
    }).then(() => {
      mktPost.$remove().then(() => {
        FhdMessenger.success('Đã xóa thành công');
        $state.reload();
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
    });
  };
}]);
"use strict";

angular.module('mkt-posts').controller('ModalUpdatePostSalaryController', ['$modalInstance', 'Authentication', '$modal', 'FhdMessenger', '$http', '$window', 'mktPost', function ($modalInstance, Authentication, $modal, FhdMessenger, $http, $window, mktPost) {
  const vm = this;
  vm.user = Authentication.user;
  vm.mktPost = mktPost;
  vm.cancel = $modalInstance.dismiss;
  vm.data = {
    salary: [0, 10000, 20000, 30000]
  };

  vm.suggestSalary = numInteraction => {
    vm.mktPost.salary = getSalary(numInteraction);
  };

  function getSalary(numInteraction) {
    if (numInteraction >= 1000) {
      return 30000;
    }

    if (numInteraction >= 700) {
      return 20000;
    }

    if (numInteraction >= 300) {
      return 10000;
    }

    return 0;
  }

  vm.update = () => {
    if (!_.isNumber(vm.mktPost.salary)) {
      return FhdMessenger.error('Chưa điền mức lương');
    }

    if (!vm.mktPost.numInteraction) {
      return FhdMessenger.error('Chưa điền số lượt tương tác');
    }

    vm.mktPost.$updatePostSalary().then(res => {
      FhdMessenger.success('Cập nhật lương thành công');
      $modalInstance.close();
    }).catch(err => FhdMessenger.error(err));
  };
}]);
"use strict";

angular.module('mkt-posts').filter('mktPostType', ['MktPostService', function (MktPostService) {
  const types = MktPostService.getTypes();
  return function (input) {
    const matchType = _.find(types, {
      id: input
    });

    return _.get(matchType, 'title', input);
  };
}]);
