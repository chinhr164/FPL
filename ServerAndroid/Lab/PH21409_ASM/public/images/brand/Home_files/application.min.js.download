    if (!vm.cartonEntry.images.length) {
      return FhdMessenger.error('Bạn chưa nhập ảnh kiện');
    }

    vm.waiting = true;
    vm.cartonEntry.$edit().then(cartonEntry => {
      FhdMessenger.success('Đã sửa ảnh và khối lượng Package Entry');
      $modalInstance.close(cartonEntry);
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
