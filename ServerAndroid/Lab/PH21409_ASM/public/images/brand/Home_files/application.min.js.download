angular.module('explains').controller('ModalAddResponsibleOutletsController', ['trashExplain', 'callback', '$modalInstance', 'Authentication', 'FhdMessenger', 'ObjectId', function (trashExplain, callback, $modalInstance, Authentication, FhdMessenger, ObjectId) {
  const vm = this;
  vm.authentication = Authentication;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.trashExplain = trashExplain;
  vm.trashExplain.responsibleOutlets = _.get(vm.trashExplain, 'responsibleOutlets', []);

  vm.addResponsibleOutlet = function (outlet) {
    if (!_.get(outlet, 'code', '')) {
      return;
    }

    if (!isDuplicateOutlet(outlet, vm.trashExplain.responsibleOutlets)) {
      vm.trashExplain.responsibleOutlets.push(outlet);
    } else {
      return FhdMessenger.error('Outlet đã tồn tại');
    }
  };

  function isDuplicateOutlet(currentOutlet, outlets) {
    return _.some(outlets, _outlet => {
      return _.isEqual(ObjectId.getObjectId(_outlet), ObjectId.getObjectId(currentOutlet));
    });
  }

  vm.removeResponsibleOutlet = function (index) {
    vm.trashExplain.responsibleOutlets.splice(index, 1);
  };

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.confirm = () => {
    vm.waiting = true;
    trashExplain.$editResponsibleOutlets().then(_explainItem => {
      FhdMessenger.success('Thêm cơ sở chịu trách nhiệm thành công');

      if (_.isFunction(callback)) {
        callback();
      }

      $modalInstance.close(true);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('trash-explains').controller('ModalCheckTrashExplainController', ['trashExplain', '$modalInstance', 'Authentication', 'FhdMessenger', '$window', 'callback', 'ExplainsService', function (trashExplain, $modalInstance, Authentication, FhdMessenger, $window, callback, ExplainsService) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.trashExplain = trashExplain;
  vm.mapComment = {};

  vm.isAuthorize = () => _.intersection(['admin', 'admin-stock', 'admin-merchandise', 'audit-assistant'], vm.user.roles).length;

  vm.data = {};
  const reasonGroups = ExplainsService.getReason('trash-explains');
  vm.data.mainGroups = _.keys(reasonGroups);
  vm.data.subGroups = _.get(reasonGroups, _.get(vm.trashExplain, 'explain.group', ''), []);

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.addGroup = () => {
    vm.data.subGroups = _.get(reasonGroups, _.get(vm.trashExplain, 'explain.group', ''), []);

    if (_.get(vm.trashExplain, 'explain.group') === `Khác`) {
      const otherCause = $window.prompt('Nhập nguyên nhân khác');

      if (!otherCause || !otherCause.trim()) {
        _.set(vm.trashExplain, 'explain.group', null);

        return FhdMessenger.error('Bạn cần nhập nguyên nhân khác');
      }

      _.set(vm.trashExplain, 'explain.group', otherCause);

      _.set(vm.trashExplain, 'explain.subGroup', '');
    }
  };

  vm.confirm = () => {
    if (!_.get(vm.trashExplain, 'explain.group')) {
      return FhdMessenger.error('Chưa chọn nhóm nguyên nhân');
    }

    if (!_.isEmpty(vm.data.subGroups) && !_.get(vm.trashExplain, 'explain.subGroup')) {
      return FhdMessenger.error('Chưa chọn nhóm nguyên nhân phụ');
    }

    vm.waiting = true;
    vm.trashExplain.$addComment({
      explain: vm.trashExplain.explain,
      content: vm.mapComment[vm.trashExplain._id],
      time: moment().toDate()
    }).then(response => {
      FhdMessenger.success('Comment check giải trình thành công');
      vm.mapComment[vm.trashExplain._id] = null;
      trashExplain = response;

      if (_.isFunction(callback)) {
        callback();
      }

      $modalInstance.dismiss(true);
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('explains').controller('ModalEditDeadlineController', ['trashExplain', '$modalInstance', 'Authentication', 'FhdMessenger', function (trashExplain, $modalInstance, Authentication, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.trashExplain = trashExplain;
  vm.deadline = vm.trashExplain.deadline;

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.confirm = () => {
    if (!vm.deadline) {
      return FhdMessenger.error('Chưa chọm deadline');
    }

    vm.trashExplain.deadline = vm.deadline;
    vm.waiting = true;
    trashExplain.$editDeadline().then(() => {
      FhdMessenger.success('Đổi deadline giải trình thành công');
      $modalInstance.close(true);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

angular.module('trash-explains').controller('TrashExplainsController', ['Authentication', 'TrashExplains', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'ExplainsService', 'TrashExplainsService', '$window', 'helper', '$q', function (Authentication, TrashExplains, FhdMessenger, NgTableParams, ObjectId, ExplainsService, TrashExplainsService, $window, helper, $q) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.data.groups = [];

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.outlets = _.map(selectedOutlets, ObjectId.getObjectId);
  };

  const viewAllRoles = ['admin', 'trash-explain:view-all', 'trash-explain:edit'];
  const modifierRoles = ['admin', 'trash-explain:edit'];
  const assistantRoles = ['tro-ly', 'tro-ly-kho', 'tro-ly-sx'];
  vm.canSeeCogRow = (helper.hasRoles(vm.user.roles, ['admin']) || _.get(vm.user, 'position', '') === 'Nhân viên Giám sát Full-time') && !helper.hasRoles(vm.user.roles, ['trainee']);

  vm.canModifier = user => helper.hasRoles(user.roles, modifierRoles);

  vm.canViewAll = user => helper.hasRoles(user.roles, viewAllRoles);

  vm.isAssistant = user => helper.hasRoles(user.roles, assistantRoles);

  vm.isManagingOutlet = (user, outlet) => {
    return ObjectId.equals(outlet, user.outlet) || _.some(vm.user.managingOutlets, _outlet => {
      return ObjectId.equals(_outlet, outlet);
    });
  };

  vm.hasAuthorization = (user, outlet) => {
    if (vm.canViewAll(user)) {
      return true;
    }

    if (vm.isManagingOutlet(user, outlet) && vm.isAssistant(user)) {
      return true;
    }

    return false;
  };

  vm.init = function () {
    vm.startDate = moment().subtract(1, 'week').format('YYYY-MM-DD');
    vm.endDate = moment().add(1, 'week').format('YYYY-MM-DD');
  };

  vm.trashExplainsTable = new NgTableParams({
    count: 50
  });
  vm.summaryTrashExplainsByOutlet = new NgTableParams({
    count: 50
  });
  vm.summaryTrashExplains = new NgTableParams({
    count: 50
  });

  function summaryTrashExplainsByOutlet(trashExplains) {
    let trashExplainsGroupByOutlet = _.groupBy(trashExplains, 'outlet.code');

    trashExplainsGroupByOutlet = _.reduce(trashExplainsGroupByOutlet, (result, trashExplains, outletCode) => {
      result[outletCode] = {
        outletCode,
        totalTrashExplain: _.get(trashExplains, 'length'),
        totalTrashValue: _.sumBy(trashExplains, 'totalPrice'),
        hasExplain: _.filter(trashExplains, 'explain.content').length,
        hasGroup: _.filter(trashExplains, 'explain.group').length
      };
      return result;
    }, {});
    vm.summaryTrashExplainsByOutlet.settings({
      dataset: _.values(trashExplainsGroupByOutlet)
    });
    vm.summaryTrashExplainsByOutlet.sorting({
      outletCode: 'asc'
    });
  }

  function summaryTrashExplainByGroup(trashExplains) {
    let trashExplainsHaveGroup = _.filter(trashExplains, trashExplain => {
      return _.get(trashExplain, 'explain.group');
    });

    trashExplainsHaveGroup = _.map(trashExplainsHaveGroup, trashExplain => {
      trashExplain.contentGroup = `${trashExplain.explain.group} - ${trashExplain.explain.subGroup || 'Không có'}`;
      return trashExplain;
    });
    const reasons = ExplainsService.getReason('trash-explains');

    const groups = _.keys(reasons);

    const trashExplainsGroupByGroup = _.groupBy(trashExplainsHaveGroup, 'explain.group');

    const totalPriceGroupMap = _.reduce(trashExplainsGroupByGroup, (result, _trashExplains, group) => {
      result[group] = _.sumBy(_trashExplains, trashExplain => vm.getTotalPrice(trashExplain));
      return result;
    }, {});

    const totalCompensatePriceGroupMap = _.reduce(trashExplainsGroupByGroup, (result, _trashExplains, group) => {
      result[group] = _.sumBy(_trashExplains, trashExplain => vm.getCompensatePrice(trashExplain));
      return result;
    }, {});

    const trashExplainsGroupByContentGroup = _.groupBy(trashExplainsHaveGroup, 'contentGroup');

    const defaultGroups = _.reduce(groups, (result, group) => {
      const subGroups = _.get(reasons, group, []);

      _.forEach(subGroups, subGroup => {
        _.set(result, `${group}.${subGroup}`, {
          group,
          subGroup,
          hasGroup: 0,
          totalPrice: 0,
          totalCompensatePrice: 0,
          percentTotalCompensatePrice: 0,
          percentTotalPrice: 0
        });
      });

      return result;
    }, {});

    let summaryTrashExplains = _.reduce(trashExplainsGroupByContentGroup, (result, _trashExplains, contentGroup) => {
      const splitGroup = contentGroup.split(' - ');

      const totalPriceSubGroup = _.sumBy(_trashExplains, trashExplain => vm.getTotalPrice(trashExplain));

      const totalCompensatePriceSubGroup = _.sumBy(_trashExplains, trashExplain => vm.getCompensatePrice(trashExplain));

      const totalPriceGroup = _.get(totalPriceGroupMap, splitGroup[0]);

      const totalCompensatePriceGroup = _.get(totalCompensatePriceGroupMap, splitGroup[0]); // for subGroup


      result[splitGroup[0]][splitGroup[1]] = {
        group: splitGroup[0],
        subGroup: splitGroup[1],
        hasGroup: _.uniq(_.map(_trashExplains, 'outlet.code')).length,
        totalPrice: totalPriceSubGroup,
        totalCompensatePrice: totalCompensatePriceSubGroup,
        percentTotalCompensatePrice: totalCompensatePriceSubGroup / totalCompensatePriceGroup * 100,
        percentTotalPrice: totalPriceSubGroup / totalPriceGroup * 100
      };
      return result;
    }, defaultGroups);

    summaryTrashExplains = _.flattenDeep(_.map(_.values(summaryTrashExplains), subGroups => {
      return _.values(subGroups);
    }));
    vm.trashExplainsHaveGroup = _.orderBy(summaryTrashExplains, ['group', 'subGroup'], ['asc', 'asc']);

    _.forEach(groups, group => {
      const trashExplainsByGroup = _.filter(vm.trashExplainsHaveGroup, {
        group: group
      });

      const count = trashExplainsByGroup.length;
      const indexToAdd = _.findLastIndex(vm.trashExplainsHaveGroup, {
        group
      }) + 1;
      const totalPriceGroup = _.get(totalPriceGroupMap, group) || 0;
      const totalCompensatePriceGroup = _.get(totalCompensatePriceGroupMap, group) || 0;
      vm.trashExplainsHaveGroup.splice(indexToAdd, 0, {
        group: group,
        subGroup: 'Tổng theo nhóm chính',
        hasGroup: _.sumBy(trashExplainsByGroup, 'hasGroup'),
        totalPrice: totalPriceGroup,
        totalCompensatePrice: totalCompensatePriceGroup,
        percentTotalPrice: totalPriceGroup / _.sumBy(summaryTrashExplains, 'totalPrice') * 100,
        percentTotalCompensatePrice: totalCompensatePriceGroup / _.sumBy(summaryTrashExplains, 'totalCompensatePrice') * 100,
        isTotal: true
      });

      const firstElementGroupIndex = _.findIndex(vm.trashExplainsHaveGroup, {
        group: group
      });

      vm.trashExplainsHaveGroup[firstElementGroupIndex].groupRowSpan = count + 1;
    });

    const trashExplainsForTotalCalculate = _.filter(vm.trashExplainsHaveGroup, 'isTotal');

    vm.trashExplainsHaveGroup.push({
      group: 'Tổng',
      subGroup: '',
      hasGroup: _.sumBy(trashExplainsForTotalCalculate, 'hasGroup'),
      totalPrice: _.sumBy(trashExplainsForTotalCalculate, 'totalPrice'),
      totalCompensatePrice: _.sumBy(trashExplainsForTotalCalculate, 'totalCompensatePrice'),
      isFinalTotal: true
    });
    vm.summaryTrashExplains.settings({
      dataset: vm.trashExplainsHaveGroup
    });
  }

  vm.find = () => {
    vm.waiting = true;
    let promise = $q(resolve => {
      const trashExplains = TrashExplains.query({
        startDate: vm.startDate,
        endDate: vm.endDate,
        outlet: vm.outlets
      }).$promise;
      resolve(trashExplains);
    });
    promise.then(trashExplains => {
      vm.trashExplains = trashExplains;
      processContent(trashExplains);
      vm.trashExplainsTable.settings({
        dataset: vm.trashExplains
      });
      summaryTrashExplainsByOutlet(vm.trashExplains);
      summaryTrashExplainByGroup(vm.trashExplains);
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
  };

  function processContent(trashExplains) {
    _.forEach(trashExplains, trashExplain => {
      trashExplain.weekInYear = vm.getWeekInYear(trashExplain.created);
      trashExplain.totalPrice = vm.getTotalPrice(trashExplain);
      trashExplain.compensatePrice = vm.getCompensatePrice(trashExplain);
      trashExplain.responsibleOutletsText = vm.convertResponsibleOutletsText(trashExplain);
    });
  }

  vm.convertResponsibleOutletsText = function (trashExplain) {
    const outlets = _.get(trashExplain, 'responsibleOutlets', []);

    return helper.joinArrayWithProperties(outlets, ['code'], '-');
  };

  vm.compensate = function (trashExplain) {
    if (_.isEmpty(trashExplain.responsibleOutlets)) {
      return FhdMessenger.error('Chưa có cơ sở chịu trách nhiệm');
    }

    vm.waiting = true;
    trashExplain.$compensate().then(() => {
      FhdMessenger.success('Công nhận đền bù thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServerr(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.handleCheckRequireExplain = trashExplain => {
    vm.waiting = true;
    trashExplain.$requireExplain().then(() => {
      FhdMessenger.success('Yêu cầu giải trình thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServerr(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.remove = (trashExplain, index) => {
    const confirm = $window.confirm(`Bạn chắc chắn muốn xóa ${trashExplain.sku} (${trashExplain.type}) ?`);

    if (!confirm) {
      return;
    }

    trashExplain.$remove().then(() => {
      FhdMessenger.success('Xóa thành công');
      vm.trashExplains.splice(index, 1);
      vm.trashExplainsTable.reload();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.removeComment = (trashExplain, index) => {
    trashExplain.comments = trashExplain.comments.splice(index, 1);
    trashExplain.$removeComment().then(() => {
      FhdMessenger.success('Xóa comment thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.openAddExplainModal = function (explainItem) {
    ExplainsService.openAddExplainModal({
      explainItem
    });
  };

  vm.openEditDeadlineModal = TrashExplainsService.openEditDeadlineModal;

  vm.openModalCheckExplain = trashExplain => {
    TrashExplainsService.openModalCheckExplain({
      trashExplain
    });
  };

  vm.openModalAddResponsibleOutlets = trashExplain => {
    TrashExplainsService.openModalAddResponsibleOutlets(trashExplain);
  };

  vm.reset = trashExplain => {
    ExplainsService.resetExplain(trashExplain);
  };

  vm.convertExplainGroupToText = trashExplain => {
    return helper.convertObjectToText(trashExplain, ['explain.group', 'explain.subGroup'], ' - ');
  };

  vm.hasBusinessCode = function (outlet, businessCode) {
    let _businessesCode = _.get(_.get(outlet, 'business'), 'code');

    return _businessesCode === businessCode;
  };

  vm.getTotalPrice = TrashExplainsService.getTotalPrice;

  vm.updateTotalPrice = trashExplain => {
    const totalPrice = $window.prompt('Nhập giá trị tiêu hủy');

    if (!totalPrice || Number(totalPrice) < 0 || _.isNaN(Number(totalPrice))) {
      return FhdMessenger.error('Vui lòng nhập giá trị lớn hơn bằng 0');
    }

    trashExplain.totalPrice = totalPrice;
    vm.waiting = true;
    trashExplain.$updateTotalPrice().then(() => {
      return FhdMessenger.success('Cập nhật giá trị hủy thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateCompensatePrice = trashExplain => {
    const compensatePrice = $window.prompt('Nhập giá trị đền bù');

    if (!compensatePrice || Number(compensatePrice) < 0 || _.isNaN(Number(compensatePrice))) {
      return FhdMessenger.error('Vui lòng nhập giá trị lớn hơn bằng 0');
    }

    trashExplain.compensatePrice = compensatePrice;
    vm.waiting = true;
    trashExplain.$updateCompensatePrice().then(() => {
      return FhdMessenger.success('Cập nhật giá trị tiêu hủy thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.getCompensatePrice = TrashExplainsService.getCompensatePrice;

  vm.getWeekInYear = time => {
    return helper.formatWeek(time, 'year');
  };

  vm.getNumberExpiredDaySaleCode = TrashExplainsService.getNumberExpiredDaySaleCode;

  vm.exportForm = function () {
    const trashExplains = vm.trashExplains.map(trashExplain => {
      const data = {
        trashExplainId: trashExplain.uid,
        Tuần: vm.getWeekInYear(trashExplain.created),
        'Mã cơ sở': trashExplain.outlet.code,
        'Ngày tạo tiêu hủy': moment(trashExplain.created).format('YYYY/MM/DD'),
        'Savor Tag': trashExplain.product.savorTag,
        'Mã sản phẩm': trashExplain.product.sku,
        'Tên sản phẩm': trashExplain.product.description,
        'Số lượng tiêu hủy': trashExplain.quantity,
        'Giá bán': trashExplain.price,
        'Giá trị tiêu hủy': vm.getTotalPrice(trashExplain),
        'Giá trị đền bù': vm.getCompensatePrice(trashExplain),
        'Link LE': `=HYPERLINK("https://work.4-handy.com/#!/stock-entries/${trashExplain.stockEntry}")`,
        'Lý do tiêu hủy': trashExplain.reason,
        'Mã salecode': _.get(trashExplain, 'saleCode.saleCodeId') ? `=HYPERLINK("https://work.4-handy.com/#!/sale-codes/${_.get(trashExplain, 'saleCode._id')}/update-info","${_.get(trashExplain, 'saleCode.saleCodeId')}")` : '',
        'Số ngày báo trước khi sale code hết hạn': vm.getNumberExpiredDaySaleCode(trashExplain),
        'Nhân viên tạo': `${_.get(trashExplain, 'user.code')} ${_.get(trashExplain, 'user.displayName')}`,
        'Hạn giải trình': _.get(trashExplain, 'deadline') ? moment(_.get(trashExplain, 'deadline')).format('YYYY/MM/DD') : '',
        'Nhóm chính': _.get(trashExplain, 'explain.group', ''),
        'Nhóm phụ': _.get(trashExplain, 'explain.subGroup', ''),
        'Bộ phận chịu trách nhiệm': _.get(trashExplain, 'responsibleOutletsText', ''),
        'QC Check': _.map(trashExplain.comments, 'content').join(', '),
        'Công nhận đền bù': trashExplain.compensated ? 1 : 0,
        'Lý do không công nhận': _.get(trashExplain, 'explain.content', '')
      };

      if (vm.canSeeCogRow) {
        return helper.addToObject(data, 'Cogs', trashExplain.cogs, 8);
      }

      return data;
    });
    alasql(`SELECT * INTO XLSX("export-trash-explains.xlsx",{headers:true, utf8Bom: true,}) FROM ? ORDER BY "Ngày tạo tiêu hủy" DESC  `, [trashExplains]);
  };
}]);
'use strict';

angular.module('trash-explains').controller('ViewTrashExplainsController', ['$stateParams', 'Authentication', 'TrashExplains', 'FhdMessenger', 'ObjectId', 'ExplainsService', 'TrashExplainsService', '$window', 'helper', '$q', function ($stateParams, Authentication, TrashExplains, FhdMessenger, ObjectId, ExplainsService, TrashExplainsService, $window, helper, $q) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.data.groups = [];
  const viewAllRoles = ['admin', 'trash-explain:view-all', 'trash-explain:edit'];
  const modifierRoles = ['admin', 'trash-explain:edit'];
  const assistantRoles = ['tro-ly', 'tro-ly-kho'];

  vm.canModifier = user => helper.hasRoles(user.roles, modifierRoles);

  vm.canViewAll = user => helper.hasRoles(user.roles, viewAllRoles);

  vm.isAssistant = user => helper.hasRoles(user.roles, assistantRoles);

  vm.isManagingOutlet = (user, outlet) => {
    return ObjectId.equals(outlet, user.outlet) || _.some(vm.user.managingOutlets, _outlet => {
      return ObjectId.equals(_outlet, outlet);
    });
  };

  vm.hasAuthorization = (user, outlet) => {
    if (vm.canViewAll(user)) {
      return true;
    }

    if (vm.isManagingOutlet(user, outlet) && vm.isAssistant(user)) {
      return true;
    }

    return false;
  };

  vm.compensate = function (trashExplain) {
    if (_.isEmpty(trashExplain.responsibleOutlet)) {
      return FhdMessenger.error('Chưa có cơ sở chịu trách nhiệm');
    }

    vm.waiting = true;
    trashExplain.$compensate().then(() => {
      FhdMessenger.success('Công nhận đền bù thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServerr(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.handleCheckRequireExplain = trashExplain => {
    vm.waiting = true;
    trashExplain.$requireExplain().then(() => {
      FhdMessenger.success('Yêu cầu giải trình thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServerr(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = () => {
    TrashExplains.get({
      trashExplainId: $stateParams.trashExplainId
    }).$promise.then(trashExplain => {
      vm.trashExplain = trashExplain;
    });
  };

  vm.remove = trashExplain => {
    const confirm = $window.confirm(`Bạn chắc chắn muốn xóa ${trashExplain.sku} (${trashExplain.type}) ?`);

    if (!confirm) {
      return;
    }

    trashExplain.$remove().then(() => {
      FhdMessenger.success('Xóa thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.removeComment = (trashExplain, index) => {
    trashExplain.$removeComment().then(() => {
      trashExplain.comments.splice(index, 1);
      FhdMessenger.success('Xóa comment thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.openAddExplainModal = function (explainItem) {
    ExplainsService.openAddExplainModal({
      explainItem
    });
  };

  vm.openEditDeadlineModal = TrashExplainsService.openEditDeadlineModal;

  vm.openModalCheckExplain = trashExplain => {
    TrashExplainsService.openModalCheckExplain({
      trashExplain
    });
  };

  vm.convertResponsibleOutletsText = function (trashExplain) {
    const outlets = _.get(trashExplain, 'responsibleOutlets', []);

    return helper.joinArrayWithProperties(outlets, ['code'], '-');
  };

  vm.openModalAddResponsibleOutlets = trashExplain => {
    TrashExplainsService.openModalAddResponsibleOutlets(trashExplain);
  };

  vm.reset = trashExplain => {
    ExplainsService.resetExplain(trashExplain);
  };

  vm.convertExplainGroupToText = trashExplain => {
    return helper.convertObjectToText(trashExplain, ['explain.group', 'explain.subGroup'], ' - ');
  };

  vm.getTotalPrice = TrashExplainsService.getTotalPrice;
  vm.getCompensatePrice = TrashExplainsService.getCompensatePrice;
  vm.getNumberExpiredDaySaleCode = TrashExplainsService.getNumberExpiredDaySaleCode;
}]);
'use strict';

angular.module('trash-explains').factory('TrashExplainsService', ['$modal', 'ProductService', function ($modal, ProductService) {
  function getTotalPrice(trashExplain) {
    if (trashExplain.totalPrice) {
      return trashExplain.totalPrice;
    }

    const _price = _.get(trashExplain, 'price') > 0 ? _.get(trashExplain, 'price') : _.get(trashExplain, 'cogs');

    const totalPrice = trashExplain.quantity * _price;
    return totalPrice;
  }

  return {
    getTotalPrice,

    openModalCheckExplain({
      trashExplain,
      callback
    }) {
      return $modal.open({
        animation: true,
        controller: 'ModalCheckTrashExplainController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: '/modules/trash-explains/views/modal-check-trash-explain.client.view.html',
        resolve: {
          trashExplain: () => trashExplain,
          callback: () => callback
        }
      }).result;
    },

    openModalAddResponsibleOutlets(trashExplain, callback) {
      return $modal.open({
        animation: true,
        controller: 'ModalAddResponsibleOutletsController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: '/modules/trash-explains/views/modal-add-responsible-outlets.client.view.html',
        resolve: {
          trashExplain: () => trashExplain,
          callback: () => callback
        }
      }).result;
    },

    openEditDeadlineModal(trashExplain) {
      return $modal.open({
        animation: true,
        controller: 'ModalEditDeadlineController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: '/modules/trash-explains/views/modal-edit-deadline.client.view.html',
        resolve: {
          trashExplain: () => trashExplain
        }
      }).result;
    },

    getNumberExpiredDaySaleCode(trashExplain) {
      let expiryDate = _.get(trashExplain, 'saleCode.expiryDate', null);

      if (!expiryDate) {
        return '';
      }

      expiryDate = moment(expiryDate).endOf('day');
      const created = moment(_.get(trashExplain, 'saleCode.created')).startOf('day');
      return moment(expiryDate).diff(created, 'day');
    },

    getCompensatePrice(trashExplain) {
      return _.get(trashExplain, 'compensatePrice');
    }

  };
}]);
'use strict';

angular.module('trash-explains').factory('TrashExplains', ['$resource', function ($resource) {
  return $resource('trash-explains/:trashExplainId', {
