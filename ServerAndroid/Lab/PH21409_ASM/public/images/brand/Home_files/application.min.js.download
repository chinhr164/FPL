angular.module('money-entries').controller('MoneyEntryController', ['$scope', '$state', '$http', '$stateParams', 'Authentication', 'BankingTransactionService', 'FhdMessenger', 'ObjectId', 'MoneyEntryService', 'MoneyEntries', 'NgTableParams', 'NumberService', 'Settings', 'Stickets', function ($scope, $state, $http, $stateParams, Authentication, BankingTransactionService, FhdMessenger, ObjectId, MoneyEntryService, MoneyEntries, NgTableParams, NumberService, Settings, Stickets) {
  const vm = this;
  vm.user = Authentication.user;
  vm.shifts = MoneyEntryService.getShifts();
  vm.types = BankingTransactionService.getTypes();
  vm.shiftMap = _.reduce(vm.shifts, (result, shift) => {
    result[shift._id] = false;
    return result;
  }, {});
  vm.data = {
    startDate: moment().subtract(1, 'day').startOf('day').format('YYYY-MM-DD'),
    endDate: moment().startOf('day').format('YYYY-MM-DD')
  };

  if (vm.user.roles.includes('admin')) {
    vm.data.settings = Settings.get();
  }

  vm.showNotRevenue = false;

  vm.changeShiftInDate = function (day) {
    let newValue = true;
    if (_.every(day.shiftMap)) newValue = false;

    _.forEach(day.shiftMap, (value, key) => {
      day.shiftMap[key] = newValue;
    });
  };

  vm.changeAllShiftInDate = function () {
    let newValue = true;

    if (_.every(vm.moneyEntry.saleReportDays, day => {
      return _.every(day.shiftMap);
    })) {
      newValue = false;
    }

    _.forEach(vm.moneyEntry.saleReportDays, day => {
      _.forEach(day.shiftMap, (value, key) => {
        day.shiftMap[key] = newValue;
      });
    });
  };

  vm.openViewMoneyEntryModal = MoneyEntryService.openViewMoneyEntryModal;

  vm.init = function () {
    vm.moneyEntry = {
      content: '',
      tranferCode: '',
      note: null,
      saleReportDays: [],
      images: []
    };
  };

  vm.moneyEntriesTable = new NgTableParams({
    count: 50
  });

  vm.findOne = function () {
    vm.moneyEntry = MoneyEntries.get({
      moneyEntryId: $stateParams.moneyEntryId
    });
    vm.moneyEntry.$promise.then(moneyEntry => {
      _.forEach(moneyEntry.saleReportDays, saleReportDay => {
        saleReportDay.shiftMap = _.cloneDeep(vm.shiftMap);

        _.forEach(saleReportDay.shifts, shift => {
          saleReportDay.shiftMap[shift] = true;
        });
      });
    });
  };

  vm.createStickets = function (outlet) {
    const mapStaffId = _.map(outlet.sticketUsers, staff => ObjectId.getObjectId(staff));

    const content = `Không chuyển đủ doanh thu cơ sở ${outlet.outlet.code} từ ${moment(outlet.startDate).format('DD/MM')} đến ${moment(outlet.endDate).format('DD/MM')} . Số hệ thống ${NumberService.numberWithCommas(outlet.totalCashInSaleReports)}. Số đã chuyển ${NumberService.numberWithCommas(outlet.totalMoneyTranferedAmount)}`; // Create new Sticket object

    const sticket = new Stickets({
      content,
      fineMoney: 50000,
      staff: mapStaffId
    });
    vm.waiting = true; // Redirect after save

    sticket.$save(function (response) {
      FhdMessenger.success('Đã gửi ticket');
      outlet.sentSticket = true;
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
      FhdMessenger.error(vm.error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.find = function () {
    // if (
    //   vm.user.roles.includes('accountant') &&
    //   moment(vm.data.startDate).diff(moment().subtract(2, 'month')) < 0
    // ) {
    //   return FhdMessenger.error(
    //     'Người dùng chỉ có quyền xem thông tin chuyển khoản 2 tháng gần nhất'
    //   )
    // }
    vm.moneyEntries = MoneyEntries.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      outlet: vm.outlet ? vm.outlet._id : null
    }, function () {
      FhdMessenger.success('Tải xong');
      vm.moneyEntriesTable.settings({
        dataset: vm.moneyEntries
      });
      vm.totalRevenue = _.reduce(vm.moneyEntries, function (total, moneyEntry) {
        return total + moneyEntry.totalMoney;
      }, 0);
    });
  };

  vm.create = function () {
    if (!vm.moneyEntry.content) {
      return FhdMessenger.error('Chưa có nội dung chuyển tiền');
    }

    if (!vm.moneyEntry.totalMoney) {
      return FhdMessenger.error('Chưa có số tiền đã chuyển');
    }

    if (!vm.moneyEntry.outlet) {
      return FhdMessenger.error('Chưa chọn cơ sở');
    }

    if (vm.moneyEntry.outlet.code.match(/(M|E|S)\d+/)) {
      if (!vm.moneyEntry.tranferCode) {
        return FhdMessenger.error('Chưa có mã giao dịch');
      }

      if (!vm.moneyEntry.notRevenue && !vm.moneyEntry.saleReportDays.length) {
        return FhdMessenger.error('Chưa có danh sách doanh thu của các ngày');
      }

      _.forEach(vm.moneyEntry.saleReportDays, day => {
        day.shifts = _.reduce(vm.shifts, (result, shift) => {
          if (day.shiftMap[shift._id]) {
            result.push(shift._id);
          }

          return result;
        }, []);
      });

      if (vm.moneyEntry.saleReportDays.length && _.some(vm.moneyEntry.saleReportDays, day => {
        return !day.shifts.length;
      })) {
        return FhdMessenger.error('Có ngày chưa chọn các ca chuyển doanh thu');
      }
    }

    vm.waiting = true;
    vm.moneyEntry.fromAccount = _.get(vm.moneyEntry.fromAccount, '_id', undefined);
    vm.moneyEntry.toAccount = _.get(vm.moneyEntry.toAccount, '_id', undefined); // Redirect after save

    const moneyEntry = new MoneyEntries(vm.moneyEntry);
    moneyEntry.$save(function (moneyEntry) {
      $state.go('listMoneyEntries');
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.update = function () {
    _.forEach(vm.moneyEntry.saleReportDays, day => {
      day.shifts = _.reduce(vm.shifts, (result, shift) => {
        if (day.shiftMap[shift._id]) {
          result.push(shift._id);
        }

        return result;
      }, []);
    });

    vm.waiting = true;
    vm.moneyEntry.$update().then(() => {
      FhdMessenger.success('Cập nhật thành công');

      _.forEach(vm.moneyEntry.saleReportDays, saleReportDay => {
        saleReportDay.shiftMap = _.cloneDeep(vm.shiftMap);

        _.forEach(saleReportDay.shifts, shift => {
          saleReportDay.shiftMap[shift] = true;
        });
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.removeSaleReportDay = function (index) {
    vm.moneyEntry.saleReportDays.splice(index, 1);
  };

  vm.addSaleReportDay = function () {
    const diffDay = moment(vm.endDate).diff(moment(vm.startDate), 'day');

    if (diffDay < 0) {
      return FhdMessenger.error('Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu');
    }

    vm.moneyEntry.saleReportDays = vm.moneyEntry.saleReportDays || [];

    _.range(diffDay + 1).forEach(numDay => {
      const newDay = moment(vm.startDate).add(numDay, 'day');
      vm.moneyEntry.saleReportDays = vm.moneyEntry.saleReportDays || [];

      const dayIndex = _.findIndex(vm.moneyEntry.saleReportDays, day => {
        return moment(newDay).startOf('day').diff(moment(day.date).startOf('day')) === 0;
      });

      if (dayIndex > -1) {
        return FhdMessenger.error(`Đã có ngày ${moment(newDay).format('YYYY/MM/DD')} trong danh sách`);
      }

      vm.moneyEntry.saleReportDays.push({
        date: moment(newDay).startOf('day'),
        shiftMap: _.cloneDeep(vm.shiftMap)
      });
    });
  }; // $scope.$watch(
  //   () => vm.moneyEntry.outlet,
  //   (newValue, oldValue) => {
  //     if (!newValue || newValue === oldValue) return
  //     if (newValue.code.match(/^(M|S|E)\d+/)) {
  //       vm.showNotRevenue = true
  //     } else {
  //       vm.showNotRevenue = false
  //     }
  //   }
  // )

}]);
"use strict";

angular.module('money-entries').controller('RevenueReportsController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'MoneyEntryService', '$window', '$q', '$http', function (Authentication, FhdMessenger, NgTableParams, MoneyEntryService, $window, $q, $http) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {
    startDate: moment().subtract(1, 'week').startOf('day').format('YYYY-MM-DD'),
    endDate: moment().startOf('day').format('YYYY-MM-DD')
  };
  vm.openViewMoneyEntryModal = MoneyEntryService.openViewMoneyEntryModal;
  vm.totalReport = [];

  vm.getRequestTransferLate = () => [{
    title: 'Có',
    id: 'Có'
  }, {
    title: 'Không',
    id: 'Không'
  }];

  vm.getHasCalendarEntry = () => [{
    title: 'Có',
    id: 'Có'
  }, {
    title: 'Không',
    id: 'Không'
  }];

  vm.saleReportsTable = new NgTableParams({
    count: 1000,
    sorting: {
      diffCash: 'asc'
    }
  });
  vm.summaryRevenueReportTable = new NgTableParams({
    count: 1000,
    sorting: {
      diffCash: 'asc'
    }
  });

  vm.removeSticketUser = function (outlet, index) {
    outlet.sticketUsers.splice(index, 1);
  };

  vm.createStickets = function (report) {
    const confirm = $window.confirm('Bạn chắc chắn muốn gửi ticket?');

    if (!confirm) {
      return;
    }

    vm.waiting = true;
    $q(resolve => {
      const promise = $http.post('/money-entries/create-stickets', {
        report
      });
      resolve(promise);
    }).then(_report => {
      FhdMessenger.success('Gửi ticket thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.createUserNotes = function (report) {
    const confirm = $window.confirm('Bạn chắc chắn muốn gửi user note ?');

    if (!confirm) {
      return;
    }

    vm.waiting = true;
    $q(resolve => {
      const promise = $http.post('/money-entries/create-user-notes', {
        report
      });
      resolve(promise);
    }).then(_report => {
      FhdMessenger.success('Gửi user note thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.ignoreZeroDiffCash = true;

  vm.filterIgnoreZeroDiffCash = function (reports) {
    return _.filter(reports, report => {
      if (vm.ignoreZeroDiffCash) {
        return Math.abs(report.diffCash) > 1000;
      }

      return true;
    });
  };

  function summary(reports) {
    const data = _.reduce(reports, (result, report) => {
      const code = report.outlet.code;
      result[code] = result[code] || {
        code: report.outlet.code,
        diffCash: 0,
        transferValue: 0,
        totalCash: 0
      };
      result[code].diffCash += report.diffCash;
      result[code].transferValue += report.transferValue;
      result[code].totalCash += report.totalCash;
      return result;
    }, {});

    vm.summaryRevenueReportTable.settings({
      dataset: _.values(data)
    });
  }

  vm.handleCheckIgnoreZeroDiffCash = function () {
    vm.saleReportsTable.settings({
      dataset: vm.filterIgnoreZeroDiffCash(vm.reports)
    });
  };

  vm.find = function () {
    vm.waiting = true;
    const promise = MoneyEntryService.getRevenueReports({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate
    }).then(({
      reports
    }) => {
      vm.reports = reports;

      _.forEach(vm.reports, report => {
        report.dateText = report.dates.join('\n');
      });

      vm.dataReports = vm.filterIgnoreZeroDiffCash(vm.reports);
      vm.totalReport = [{
        name: 'Tổng cần chuyển',
        value: _.sumBy(vm.dataReports, 'totalCash')
      }, {
        name: 'Tổng đã chuyển',
        value: _.sumBy(vm.dataReports, 'transferValue')
      }, {
        name: 'Tổng chưa chuyển',
        value: -_.sumBy(vm.dataReports, 'diffCash')
      }];
      vm.saleReportsTable.settings({
        dataset: vm.dataReports
      });
      summary(vm.dataReports);
      FhdMessenger.success('Tải xong');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải', promise);
  };

  vm.openModalVerboseSaleReports = MoneyEntryService.openModalVerboseSaleReports;
}]);
"use strict";

angular.module('money-entries').factory('MoneyEntries', ['$resource', function ($resource) {
