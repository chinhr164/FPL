angular.module('stock-entries').controller('AddNoteModalController', ['$modalInstance', 'Authentication', 'FhdMessenger', 'stockEntryId', 'selectedItem', 'StockEntries', '$http', function ($modalInstance, Authentication, FhdMessenger, stockEntryId, selectedItem, StockEntries, $http) {
  const vm = this;
  vm.user = Authentication.user;
  vm.stockEntry = StockEntries.get({
    stockEntryId
  });
  vm.note = {};
  vm.waiting = false;
  selectedItem.notes = selectedItem.notes || [];

  vm.submit = function () {
    vm.note.user = vm.user;
    vm.note.time = moment();
    selectedItem.notes.push(vm.note);
    vm.waiting = true;
    $http.put(`/stock-entries/${stockEntryId}/add-item-note`, {
      itemId: selectedItem._id,
      content: vm.note.content
    }).then(() => {
      FhdMessenger.success('Thêm note thành công');
      $modalInstance.close(selectedItem);
    }).catch(err => {
      selectedItem.notes.pop();
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.close = function () {
    $modalInstance.close();
  };
}]);
