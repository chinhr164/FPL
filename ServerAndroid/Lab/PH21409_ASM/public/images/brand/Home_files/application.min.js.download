angular.module('order-entries').controller('ModalAssignMultiOrderEntriesController', ['$modalInstance', '$scope', 'FhdMessenger', 'orderEntries', 'OrderEntriesService', 'Vendors', function ($modalInstance, $scope, FhdMessenger, orderEntries, OrderEntriesService, Vendors) {
  const vm = this;
  vm.orderEntries = orderEntries;

  _.forEach(vm.orderEntries, orderEntry => {
    orderEntry.deadline = moment(orderEntry.deadline).toDate();
  });

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.data = {};
  vm.data.vendors = Vendors.query();
  vm.dismiss = $modalInstance.dismiss;

  vm.assignMultiOrderEntries = function () {
    if (!vm.assignStaff) {
      return FhdMessenger.error('Chưa có nhân viên xử lý các Order Entry');
    }

    if (_.some(vm.orderEntries, orderEntry => {
      return !orderEntry.deadline;
    })) {
      return FhdMessenger.error('Có Order Entry chưa có deadline');
    }

    _.forEach(vm.orderEntries, orderEntry => {
      orderEntry.assignStaff = vm.assignStaff;
      orderEntry.deadline = moment(orderEntry.deadline).startOf('hours').toDate();
    });

    vm.waiting = true;
    OrderEntriesService.assignMultiOrderEntries({
      orderEntries: vm.orderEntries
    }).then(orderEntries => {
      FhdMessenger.success('Cập nhật/gửi yêu cầu thành công');
      $modalInstance.close(orderEntries);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  $scope.$watch(() => vm.deadlineAll, function (newValue, oldValue) {
    if (newValue === oldValue) return;

    _.forEach(vm.orderEntries, orderEntry => {
      orderEntry.deadline = vm.deadlineAll;
    });
  });
}]);
'use strict'; // Buying entries controller

angular.module('order-entries').controller('ModalBookOrderEntryController', ['$location', '$modalInstance', '$window', 'FhdMessenger', 'orderEntry', 'OrderEntries', 'Vendors', function ($location, $modalInstance, $window, FhdMessenger, orderEntry, OrderEntries, Vendors) {
  const vm = this;
  vm.orderEntry = OrderEntries.get({
    orderEntryId: orderEntry._id
  });

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.dismiss = $modalInstance.dismiss;
  vm.data = {};

  vm.book = function () {
    if (!vm.orderEntry.bookedQuantity) {
      return FhdMessenger.error('Chưa có số lượng đã chuyển cho Order Entry');
    }

    vm.waiting = true;
    vm.orderEntry.$book().then(data => {
      const {
        orderEntry,
        stockEntry
      } = data;
      FhdMessenger.success('Đổi trạng thái Order Entry thành công');

      if (stockEntry) {
        $window.open(`${$location.protocol()}://${$location.host()}${$location.port() !== 80 ? `:${$location.port()}` : ''}/#!/stock-entries/${stockEntry._id}`, '_blank');
      }

      $modalInstance.close(orderEntry);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
