      items: _.map(stockEntry.items, item => {
        return {
          product: ObjectId.getObjectId(item.product),
          sku: item.sku
        };
      }),
      destination: ObjectId.getObjectId(stockEntry.destination)
    }).then(response => {
      vm.buyingEntries = response.data;
    });
  });

  vm.chosseBuyingEntry = buyingEntry => {
    vm.buyingEntry = buyingEntry;
  };

  vm.findBuyingEntry = function (buyingEntryId) {
    if (!buyingEntryId) {
      return FhdMessenger.error('Chưa nhập mã Buying Entry để tìm');
    }

    BuyingEntryService.findByBuyingEntryId(buyingEntryId).then(buyingEntry => {
      vm.buyingEntry = buyingEntry;
    });
  };

  vm.import = function () {
    if (!vm.buyingEntry) {
      return FhdMessenger.error('Bạn chưa nhập BE');
    }

    $modalInstance.close(vm.buyingEntry);
  };
}]);
