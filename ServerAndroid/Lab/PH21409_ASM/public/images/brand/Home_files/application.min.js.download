angular.module('questions').controller('ModalReviewShiftPlanController', ['Authentication', 'shiftPlan', 'shift', 'FhdMessenger', '$modalInstance', 'ShiftPositions', 'ShiftEntries', 'ShiftPlans', '$http', function (Authentication, shiftPlan, shift, FhdMessenger, $modalInstance, ShiftPositions, ShiftEntries, ShiftPlans, $http) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {};

  vm.initOutlet = function () {
    if (!shiftPlan.data) {
      vm.close();
      return FhdMessenger.error('Chưa có thông tin về ca trực này');
    }

    vm.shiftPlans = _.map(shiftPlan.data, 'shiftPlan');
    vm.shift = shift;
    vm.outlet = {
      code: shiftPlan.data[0].shiftPlan.outletCode,
      _id: shiftPlan.data[0].shiftPlan.outlet
    };
    vm.date = moment(shiftPlan.data[0].shiftPlan.date);
    vm.data.positions = vm.data.positions || [];
    const outlet = vm.outlet;
    const positions = ShiftPositions.getPostions(outlet);
    vm.data.positions = positions.map(position => {
      return {
        code: position.code,
        label: position.name
      };
    });
    vm.data.positions.concat(ShiftPositions.PROBATION_POSITIONS);
    vm.shiftPlans = _.map(vm.shiftPlans, shiftPlan => {
      const clonePositions = shiftPlan.positions;
      shiftPlan.positions = {};

      _.forEach(vm.data.positions, position => {
        if (clonePositions.includes(position.code)) {
          shiftPlan.positions[position.code] = true;
        } else {
          shiftPlan.positions[position.code] = false;
        }
      });

      return shiftPlan;
    });
  };

  vm.update = () => {
    let isError = false;

    if (!_.intersection(vm.user.roles, ['admin', 'tro-ly-ns']) && vm.user.outlet.code !== vm.outlet) {
      return FhdMessenger.error('Bạn chỉ được tạo shift Entry cho cơ sở của mình');
    }

    const staffs = _.map(vm.shiftPlans, 'staff');

    const employees = _.map(vm.shiftPlans, shift => ({
      positions: _.reduce(shift.positions, (result, value, index) => {
        if (value) result.push(index);
        return result;
      }, []),
      staff: shift.staff,
      staffName: shift.staffName
    }));

    if (_.some(employees, employee => !employee.positions.length)) {
      return FhdMessenger.error('Có nhân viên chưa có vị trí trực');
    }

    if (vm.outlet.code.match(/^D\d+/)) {
      const allPositions = _.union(_.flattenDeep(_.map(employees, 'positions')));

      const missingPositions = _.difference(['STORING', 'LOGISTICS', 'BUYING'], allPositions);

      if (missingPositions.length) {
        return FhdMessenger.error(`Thiếu vị trí ${missingPositions.join(',')}`);
      }
    }

    if (vm.outlet.code.match(/^[SME]\d+/)) {
      const allPositions = _.union(_.flattenDeep(_.map(employees, 'positions')));

      const missingPositions = _.difference(['CASHIER'], allPositions);

      if (missingPositions.length) {
        return FhdMessenger.error(`Thiếu vị trí thu ngân`);
      }
    }

    const mapPromise = _.map(vm.shiftPlans, shiftPlan => {
      const updatedShiftPlan = new ShiftPlans(_.cloneDeep(shiftPlan));
      updatedShiftPlan.positions = _.reduce(updatedShiftPlan.positions, (result, value, index) => {
        if (value) {
          result.push(index);
        }

        return result;
      }, []);
      return updatedShiftPlan;
    });

    const numberStaff = mapPromise.length - 1;

    _.forEach(mapPromise, (shiftPlan, index) => {
      return $http.put(`/shift-plans/${shiftPlan._id}`, {
        data: shiftPlan
      }).catch(error => {
        isError = true;
        FhdMessenger.error(error.data.message);
      }).finally(() => {
        if (numberStaff === index) {
          if (!isError) {
            const shiftEntry = new ShiftEntries({
              outlet: vm.outlet._id,
              staffs,
              employees,
              user: vm.user._id,
              shift: vm.shift,
              date: moment(vm.date).toDate()
            }); // Redirect after save

            shiftEntry.$save().then(function () {
              FhdMessenger.success('Up lịch thành công');
              vm.close();
            }).catch(FhdMessenger.errorFromServer).finally(() => {
              isError = false;
            });
          } else {
            FhdMessenger.error('Có lỗi xảy ra');
            isError = false;
          }
        }
      });
    });
  };

  vm.close = () => {
    $modalInstance.dismiss();
  };
}]);
"use strict";

angular.module('shift-plans').controller('ShiftPlansController', ['ShiftPlans', 'Authentication', '$state', 'FhdMessenger', 'ObjectId', '$scope', 'ShiftEntries', 'ShiftPlanService', 'ShiftPositions', 'helper', function (ShiftPlans, Authentication, $state, FhdMessenger, ObjectId, $scope, ShiftEntries, ShiftPlanService, ShiftPositions, helper) {
  const vm = this;
  vm.user = Authentication.user;
  vm.date = moment().format('YYYY-MM-DD');
  vm.outlet = vm.user.outlet;
  vm.newShiftPlanOutlet = vm.outlet;
  vm.newShiftPlanPositions = [];
  vm.data = {};

  if (!vm.user) {
    $state.go('signin');
    return;
  }

  vm.canChangeStaff = !!_.intersection(vm.user.roles, ['admin', 'tro-ly-lich-truc', 'shift-entry:edit', 'tro-ly-ns']).length;
  vm.data.defaultPositions = [{
    code: 'TRAINING',
    label: 'Thử việc'
  }, {
    code: 'OFFICIAL',
    label: 'Chính thức'
  }];

  vm.find = () => {
    vm.startDate = moment(vm.date).startOf('week');
    vm.endDate = moment(vm.date).endOf('week');
    ShiftPlans.query({
      startDate: moment(vm.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.endDate).format('YYYY-MM-DD'),
      outlet: ObjectId.getObjectId(vm.outlet)
    }).$promise.then(data => {
      FhdMessenger.success('Tải xong');
      vm.shiftPlans = data.shiftPlans;
      vm.shiftLimit = data.shiftLimit;
      createShiftPlanMap();
    });
  };

  vm.create = () => {
    if (!vm.newShiftPlanShift) {
      FhdMessenger.error('Chưa chọn ca trực');
      return;
    }

    if (!vm.newShiftPlanPosition) {
      return FhdMessenger.error('Chưa chọn vị trí trực');
    }

    let positions = [];

    if (vm.newShiftPlanPosition.code === 'TRAINING') {
      positions = _.map(ShiftPositions.PROBATION_POSITIONS, 'code');
    } else {
      const outlet = {
        code: vm.newShiftPlanOutlet.code
      };

      const _positions = ShiftPositions.getPostions(outlet);

      positions = _positions.map(position => {
        return position.code;
      });
    }

    const shiftPlan = new ShiftPlans({
      staff: vm.newShiftPlanStaff,
      outlet: vm.newShiftPlanOutlet,
      date: vm.newShiftPlanDate,
      shift: vm.newShiftPlanShift.code,
      positions: positions
    });
    shiftPlan.$save().then(() => {
      FhdMessenger.success('Đã đăng ký thành công!');
      vm.clear();
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.clear = () => {
    vm.newShiftPlanStaff = null;
    vm.newShiftPlanDate = null;
    vm.newShiftPlanPosition = null;
    vm.newShiftPlanShift = null;
  };

  vm.remove = ShiftPlanService.openDeleteShiftPlanModal;

  function createShiftPlanMap() {
    vm.shiftPlanMap = _.reduce(vm.shiftPlans, (result, shiftPlan) => {
      const matchDate = _.find(result, date => {
        return moment(date.date).isSame(shiftPlan.date);
      });

      if (matchDate) {
        matchDate[shiftPlan.shift].push({
          label: (shiftPlan.staffCode || 'N/A') + ' ' + shiftPlan.staffName,
          shiftPlan,
          typePosition: helper.isProbationShift(shiftPlan.positions) ? `${shiftPlan.shift}TV` : `${shiftPlan.shift}CT`,
          isMy: shiftPlan.staffCode === vm.user.code,
          positions: shiftPlan.positions.join(',')
        });
      }

      return result;
    }, _.range(7).map(offset => {
      const startOfWeek = moment(vm.date).startOf('week');
      const date = moment(startOfWeek).add(offset, 'day');
      return {
        date,
        S: [],
        C: [],
        T: []
      };
    }));

    const shifts = _.get(vm.shiftLimit, 'shifts', null);

    const startLimitDate = _.get(vm.shiftLimit, 'startDate', null);

    if (_.get(shifts, 'length', 0)) {
      vm.shiftPlanMap = _.map(vm.shiftPlanMap, element => {
        const offsetDate = moment(element.date).diff(moment(startLimitDate), 'day');
        const positionRemainS = caculatePositions(offsetDate, element.S, 'S');
        const positionRemainC = caculatePositions(offsetDate, element.C, 'C');
        const positionRemainT = caculatePositions(offsetDate, element.T, 'T');
        const shiftS = element.S;
        const shiftC = element.C;
        const shiftT = element.T;
        return {
          S: {
            data: shiftS,
            remain: positionRemainS
          },
          C: {
            data: shiftC,
            remain: positionRemainC
          },
          T: {
            data: shiftT,
            remain: positionRemainT
          },
          date: element.date
        };
      });
    }
  }

  function caculatePositions(offset, shiftPlans, shift) {
    const probationAssigned = _.filter(shiftPlans, shiftPlan => {
      const positions = _.get(shiftPlan, 'positions', []);

      return helper.isProbationShift(positions);
    });

    const officialAssigned = _.get(shiftPlans, 'length', 0) - probationAssigned.length;
    const shiftLimit = vm.shiftLimit.shifts[convertShift(shift)][offset];
    return {
      official: shiftLimit.official,
      probationary: shiftLimit.probationary,
      officialAssigned: officialAssigned,
      probationAssigned: probationAssigned.length
    };
  }

  function convertShift(shift) {
    if (shift === 'S') return 0;
    if (shift === 'C') return 1;
    if (shift === 'T') return 2;
  }

  vm.createShiftEntry = ShiftPlanService.openReviewShiftPlanModal;
}]);
