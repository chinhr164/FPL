angular.module('reports').controller('OpenExtraShortageItemsController', ['stockEntry', 'startDate', 'endDate', 'CompareLogisticsRestocks', 'NgTableParams', '$modalInstance', 'FhdMessenger', function (stockEntry, startDate, endDate, CompareLogisticsRestocks, NgTableParams, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.stockEntry = stockEntry;
  vm.extraTable = new NgTableParams();
  vm.shortageItems = new NgTableParams();

  vm.load = () => {
