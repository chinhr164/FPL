    }

    if (!vm.onlineOrder.totalCollect) {
      return FhdMessenger.error('Bạn chưa nhập tổng số tiền');
    }

    vm.waiting = true;
    vm.onlineOrder.$sendAccountNumBank().then(onlineOrder => {
      $modalInstance.close(onlineOrder);
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
"use strict";

angular.module('online-orders').controller('ViewOnlineOrderModalController', ['$modalInstance', 'FhdMessenger', 'onlineOrder', '$http', 'CustomerService', 'OutletService', 'ObjectId', '$q', 'ProductService', 'SaleCampaigns', 'OnlineOrders', 'SaleEntryService', 'BundlePricesService', 'SaleCampaignService', 'PromotionService', '$filter', 'ShippingFee', 'OrderTypes', 'StockMap', function ($modalInstance, FhdMessenger, onlineOrder, $http, CustomerService, OutletService, ObjectId, $q, ProductService, SaleCampaigns, OnlineOrders, SaleEntryService, BundlePricesService, SaleCampaignService, PromotionService, $filter, ShippingFee, OrderTypes, StockMap) {
  const vm = this;
  vm.data = {
    editShipping: true,
    editOrder: true
  };
  vm.onlineOrder = onlineOrder;
  vm.close = $modalInstance.dismiss;

  vm.init = function () {
    vm.onlineOrder = OnlineOrders.get({
      onlineOrderId: onlineOrder._id
    });
    vm.onlineOrder.$promise.then(onlineOrder => {
      vm.onlineOrder = onlineOrder;
      vm.orderCustomer = _.cloneDeep(onlineOrder.orderCustomer);
      vm.onlineOrder.mobileProvider = CustomerService.checkProvider(vm.onlineOrder.orderCustomer.cellphone);
      vm.onlineOrder.receiverMobileProvider = CustomerService.checkProvider(vm.onlineOrder.receiverCustomer.cellphone);
      vm.calculateItems = vm.onlineOrder.items;

      if (vm.onlineOrder.receiverCustomer.district) {
        vm.districtLabel = `${vm.onlineOrder.receiverCustomer.district}, ${vm.onlineOrder.receiverCustomer.city}`;
      }

      OutletService.allAsync().then(outlets => {
        vm.assignedOutlet = _.find(outlets, outlet => ObjectId.equals(outlet, vm.onlineOrder.assignedOutlet));
      });
      vm.getListItems();
      vm.calculateItems = vm.onlineOrder.items;
    });
  };

  vm.getListItems = function () {
    vm.listItems = `Mã đơn hàng ${vm.onlineOrder.onlineOrderId}\n`;
    vm.listItems += _.reduce(vm.calculateItems, (result, item) => {
      let content = `${item.sku} ${item.description} : ${$filter('number')(item.soldPrice, 0)} x ${item.quantity} ${item.discount ? '- ' + $filter('number')(item.discount, 0) + ' ' : ''}= ${$filter('number')(item.lineTotal, 0)}\n`;

      if (item.sku === 'V1408') {
        _.forEach(item.bundledProducts, product => {
          content += `- ${product.sku} ${product.description}\n`;
        });
      }

      result += content;
      return result;
    }, '');
    vm.listItems += `Thành tiền: ${$filter('number')(vm.onlineOrder.orderValue, 0)}\n`;

    const voucherQuantity = _.get(vm.onlineOrder, 'voucher.quantity', 0);

    if (vm.onlineOrder.voucher && voucherQuantity) {
      vm.listItems += `Voucher: ${vm.onlineOrder.voucher.name} - ${voucherQuantity}\n`;
    }

    if (vm.usedPoint) {
      vm.listItems += `Điểm đã sử dụng: ${vm.usedPoint}\n`;
    }

    if (vm.onlineOrder.orderType === 'ORDER') {
      let shippingFee = 20000;

      if (vm.onlineOrder.shipping.provider === 'Giao tại cửa hàng' || vm.onlineOrder.orderValue >= 220000) {
        shippingFee = 0;
      }

      vm.listItems += `Tiền ship: ${$filter('number')(shippingFee, 0)}\n`;

      const depositAmount = _.sumBy(vm.onlineOrder.deposits, 'amount');

      if (depositAmount > 0) {
        vm.listItems += `Tiền cọc đã trả: ${$filter('number')(depositAmount, 0)}\n`;
      }

      vm.listItems += `Tổng thu tiền hàng: ${$filter('number')(vm.onlineOrder.orderValue + shippingFee - voucherQuantity - depositAmount, 0)}\n`;

      if (vm.onlineOrder.textInCake) {
        vm.listItems += `Chữ viết trên bánh: ${vm.onlineOrder.textInCake}\n`;
      }

      if (vm.onlineOrder.textInBase) {
        vm.listItems += `Chữ viết trên đế: ${vm.onlineOrder.textInBase}\n`;
      }

      vm.listItems += `Số điện thoại người nhận: ${vm.onlineOrder.receiverCustomer.cellphone}\n`;
      vm.listItems += `Địa chỉ nhận bánh: ${vm.onlineOrder.receiverCustomer.street}, ` + `${vm.onlineOrder.receiverCustomer.ward}, ` + `${vm.onlineOrder.receiverCustomer.district}, ` + `${vm.onlineOrder.receiverCustomer.city}\n`;
      vm.listItems += `Thời gian giao: ${moment(vm.onlineOrder.deadline).format('DD/MM dddd')} từ ${moment(vm.onlineOrder.deliverStartTime).format('HH:mm')} đến ${moment(vm.onlineOrder.deliverEndTime).format('HH:mm')}\n`;
      vm.listItems += `Hình thức thanh toán: ${vm.onlineOrder.payment.method === 'cod' ? 'COD' : 'Chuyển khoản'}\n`;
    } else {
      vm.listItems += `Tổng thu tiền hàng: ${$filter('number')(vm.onlineOrder.orderValue - voucherQuantity - vm.usedPoint * 10, 0)}\n`;
      vm.listItems += `Đây là đơn hàng tạm thời, sẽ có thể thay đổi tùy vào tình hình hàng tồn và sẽ được chốt khi nhân viên Abby gọi điện thoại trực tiếp.\n`;
    }

    if (vm.onlineOrder.orderNote) {
      vm.listItems += `Ghi chú: ${vm.onlineOrder.orderNote}`;
    }
  };
}]);
'use strict';

angular.module('online-orders').controller('OnlineOrdersController', ['$timeout', 'helper', 'CurrentShift', 'NgTableParams', '$http', 'FhdMessenger', 'OnlineOrderModal', 'OnlineOrders', '$scope', 'Sockets', 'OutletService', 'OnlineOrderService', 'CustomerService', 'Authentication', 'ObjectId', 'SaleEntryService', 'StockMap', function ($timeout, helper, CurrentShift, NgTableParams, $http, FhdMessenger, OnlineOrderModal, OnlineOrders, $scope, Sockets, OutletService, OnlineOrderService, CustomerService, Authentication, ObjectId, SaleEntryService, StockMap) {
  const vm = this;
  const seeAllRoles = ['admin', 'tro-ly', 'accountant', 'ship', 'marketing', 'purchaser', 'probation-purchaser'];
  vm.copyToClipboard = helper.copyToClipboard;

  vm.checkAll = function () {
    _.forEach(vm.onlineOrdersTable.data, onlineOrder => {
      onlineOrder.checked = vm.toCheck;
    });
  };

  vm.cancel = function name() {
    const onlineOrders = _.filter(vm.onlineOrdersTable.data, 'checked');

    vm.waiting = true;
    Promise.each(onlineOrders, onlineOrder => {
      return $timeout(() => {
        onlineOrder.$cancel();
      }, 2000);
    });
  };

  vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().endOf('day').format('YYYY-MM-DD');
  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus;
  vm.onlineOrderByUserTable = new NgTableParams({
    count: 100
  });
  vm.onlineOrderByCustomersTable = new NgTableParams({
    count: 100
  });
  vm.onlineOrderProcessingTable = new NgTableParams({
    count: 100
  }, {
    counts: []
  });
  const currentShift = CurrentShift.getCurrentShift();
  vm.user = Authentication.user;
  vm.data = {
    statuses: OnlineOrderService.getStatuses()
  };
  vm.data.mooncakes = [];
  vm.stockMap = [];

  vm.init = () => {
    vm.statusMap = {
      created: true,
      processing: true,
      confirm: true,
      ready: true,
      done: false,
      cancel: false,
      return: false
    };
    vm.orderTypeMap = {
      HN: true,
      TI: true,
      BUON: true,
      HTT: true,
      TT: false,
      NN: false,
      ORDER: false
    };
    vm.sources = _.map(OnlineOrderService.getSources(), 'value');
    vm.sourceMap = _.reduce(vm.sources, (result, source) => {
      result[source] = false;
      return result;
    }, {});
    vm.getShippingOutlets = OutletService.allAsync().then(outlets => {
      vm.data.outlets = _.reject(_.filter(outlets, {
        isPos: true
      }), outlet => {
        return outlet.code.match(/^S\d+/) || outlet.code.match(/^B/);
      });
      vm.showOutletMap = _.reduce(vm.data.outlets, (result, outlet) => {
        if (_.intersection(vm.user.roles, seeAllRoles).length > 0 || ObjectId.equals(outlet, vm.user.outlet) || ObjectId.equals(outlet, currentShift.outlet)) {
          result[outlet._id] = true;
        }

        return result;
      }, {});
      vm.enableOutletMap = _.clone(vm.showOutletMap);
      vm.find();
    });
  };

  vm.onlineOrdersTable = new NgTableParams({
    count: 100
  });
  vm.onlineOrdersTable.sorting({
    onlineOrderId: 'desc'
  });

  function fitCurrentFilters(onlineOrder) {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const orderTypes = _.reduce(vm.orderTypeMap, (orderTypes, toShow, orderType) => {
      if (toShow) orderTypes.push(orderType);
      return orderTypes;
    }, []);

    const sources = _.reduce(vm.sourceMap, (sources, toShow, source) => {
      if (toShow) sources.push(source);
      return sources;
    }, []);

    const assignedOutlets = _.reduce(vm.showOutletMap, (assignedOutlets, toShow, outlet) => {
      if (toShow) assignedOutlets.push(outlet);
      return assignedOutlets;
    }, []);

    return _.includes(statuses, onlineOrder.status) && _.includes(orderTypes, onlineOrder.orderType) && _.includes(sources, onlineOrder.source) && _.includes(assignedOutlets, ObjectId.getObjectId(onlineOrder.assignedOutlet));
  }

  const fetchOnlineOrdersToTable = onlineOrders => {
    vm.onlineOrders = onlineOrders;

    _.forEach(vm.onlineOrders, onlineOrder => {
      onlineOrder.note = _.map(onlineOrder.notes || [], 'content').join('; ');

      if (onlineOrder.receiverCustomer.district) {
        onlineOrder.fullAddress = `${onlineOrder.receiverCustomer.city} > ${onlineOrder.receiverCustomer.district} > ${onlineOrder.receiverCustomer.street}`;
      } else {
        onlineOrder.fullAddress = onlineOrder.receiverCustomer.address;
      }

      const cellphone = onlineOrder.orderCustomer.cellphone;

      if (cellphone) {
        onlineOrder.maskCellphone = cellphone.replace(cellphone.substring(3, 6), '****');
      }

      onlineOrder.mobileProvider = CustomerService.checkProvider(cellphone) || 'Khác';
    });

    vm.onlineOrdersTable.settings({
      dataset: vm.onlineOrders
    });
  };

  vm.currentResult = [];

  vm.searchFuse = () => {
    if (!vm.omnisearch) {
      vm.currentResult = [];
      vm.showDone = false;
      vm.find();
      return;
    }

    vm.currentResult = [];
    OnlineOrders.query({
      searchQuery: vm.omnisearch
    }, function (orders) {
      vm.currentResult.push(...orders);
      fetchOnlineOrdersToTable(vm.currentResult);
    });
  };

  vm.clearSearch = () => {
    if (!vm.omnisearch) {
      vm.currentResult = [];
      vm.showDone = false;
    }
  };

  vm.updateSummary = function () {
    vm.summary = {};

    const processingOrders = _.filter(vm.onlineOrders, onlineOrder => {
      return _.includes(['created', 'processing', 'confirm'], onlineOrder.status);
    });

    _.forEach(['created', 'processing', 'confirm'], status => {
      vm.summary[status] = (_.filter(processingOrders, {
        status
      }) || []).length;
    });

    _.forEach(vm.sources, source => {
      vm.summary[source] = (_.filter(processingOrders, {
        source
      }) || []).length;
    });

    _.forEach(['HN', 'TI', 'BUON', 'HTT'], orderType => {
      vm.summary[orderType] = (_.filter(processingOrders, {
        orderType
      }) || []).length;
    });

    vm.summary.totalOrderValue = _.sumBy(processingOrders, 'orderValue');
    vm.summary.totalNumberOfHNOrders = _.filter(processingOrders, order => {
      return order.receiverCustomer.city === 'HÀ NỘI (NỘI THÀNH)' || order.receiverCustomer.city === 'Hà Nội (Nội thành)';
    }).length;
    vm.summary.totalNumberOfTIOrders = _.reject(processingOrders, order => {
      return order.receiverCustomer.city === 'HÀ NỘI (NỘI THÀNH)' || order.receiverCustomer.city === 'Hà Nội (Nội thành)';
    }).length;
    vm.getShippingOutlets.then(() => {
      _.forEach(vm.data.outlets, outlet => {
        const outletId = outlet._id;
        vm.summary[outletId] = (_.filter(processingOrders, onlineOrder => {
          return _.get(onlineOrder, 'assignedOutlet._id') === outlet._id;
        }) || []).length;
      });
    });
  };

  vm.getProcessingSummary = function () {
    OnlineOrderService.getProcessingSummary().then(outlets => {
      vm.onlineOrderProcessing = outlets;
      vm.summaryStatus = _.reduce(outlets, (result, outlet) => {
        result.confirm += outlet.statusMap.confirm || 0;
        result.created += outlet.statusMap.created || 0;
        result.processing += outlet.statusMap.processing || 0;
        result.ready += outlet.statusMap.ready || 0;
        return result;
      }, {
        confirm: 0,
        created: 0,
        processing: 0,
        ready: 0
      });
      vm.onlineOrderProcessingTable.settings({
        dataset: outlets
      });
    });
  };

  vm.find = function () {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const orderTypes = _.reduce(vm.orderTypeMap, (orderTypes, toShow, orderType) => {
      if (toShow) orderTypes.push(orderType);
      return orderTypes;
    }, []);

    const sources = _.reduce(vm.sourceMap, (sources, toShow, source) => {
      if (toShow) sources.push(source);
      return sources;
    }, []);

    const assignedOutlets = _.reduce(vm.showOutletMap, (assignedOutlets, toShow, outlet) => {
      if (toShow) assignedOutlets.push(outlet);
      return assignedOutlets;
    }, []);

    vm.waiting = true;
    vm.onlineOrders = OnlineOrders.query({
      statuses,
      orderTypes,
      sources,
      assignedOutlets,
      currentShiftOutlet: _.get(currentShift, 'outlet._id'),
      searchQuery: vm.omnisearch || null
    });
    let promise = vm.onlineOrders.$promise.then(onlineOrders => {
      const length = onlineOrders.length;

      if (length === 500) {
        FhdMessenger.success('Chỉ tải 500 kết quả đầu tiên. Để hiển thị hết, hãy lọc theo cơ sở hoặc thử từ khóa khác.');
      }

      return onlineOrders;
    }).then(onlineOrders => {
      vm.updateSummary();
      return onlineOrders;
    }).then(onlineOrders => {
      _.forEach(onlineOrders, onlineOrder => {
        getStatusForOnlineOrderDeadline(onlineOrder);
      });

      return onlineOrders;
    }).then(fetchOnlineOrdersToTable).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
    return promise;
  };

  vm.createOnlineOrderModal = () => {
    OnlineOrderModal.create().then(onlineOrder => {
      vm.onlineOrders.push(onlineOrder);
      fetchOnlineOrdersToTable(vm.onlineOrders);
      vm.onlineOrdersTable.reload();
    });
  };

  vm.openViewOnlineOrdersByUser = OnlineOrderModal.openViewOnlineOrdersByUser;

  vm.searchKeyUp = function ($event) {
    if ($event.keyCode === 13) vm.find();
  };

  vm.viewSaleEntry = SaleEntryService.viewSaleEntry;

  function listenUpdateOnlineOrder(onlineOrder) {
    if (!onlineOrder) return;
    if (vm.waiting) return;
    if (vm.omnisearch) return;

    const matchOrder = _.find(vm.onlineOrders, {
      _id: onlineOrder._id
    });

    if (!matchOrder && fitCurrentFilters(onlineOrder)) {
      if (!onlineOrder.updated) {
        FhdMessenger.info(`Đơn ${onlineOrder.onlineOrderId} từ ${onlineOrder.source} đã thêm vào danh sách.`);
      }

      vm.onlineOrders.push(_.assign({}, onlineOrder, {
        created: new Date(onlineOrder.created)
      }));

      if (!vm.omnisearch) {
        _.forEach(vm.onlineOrders, onlineOrder => {
          getStatusForOnlineOrderDeadline(onlineOrder);
        });

        fetchOnlineOrdersToTable(vm.onlineOrders);
        vm.onlineOrdersTable.reload();
        vm.updateSummary();
        $scope.$apply();
      }
    }

    if (matchOrder) {
      _.assign(matchOrder, onlineOrder);

      fetchOnlineOrdersToTable(vm.onlineOrders);
      vm.onlineOrdersTable.reload();
      vm.updateSummary();
      $scope.$apply();
    }
  }

  function getStatusForOnlineOrderDeadline(onlineOrder) {
    if (!onlineOrder.deadline) {
      return;
    }

    const deadlineDiffDay = moment(onlineOrder.deadline).startOf('day').diff(moment().startOf('day'), 'days');

    if (deadlineDiffDay <= 0) {
      onlineOrder.deadlineLabel = 'danger';
    } else if (deadlineDiffDay <= 2) {
      onlineOrder.deadlineLabel = 'warning';
    } else {
      onlineOrder.deadlineLabel = 'primary';
    }
  }

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      case 'orderType':
        {
          let changeValue = true;
          if (_.every(vm.orderTypeMap)) changeValue = false;

          _.forEach(vm.orderTypeMap, (value, key) => {
            vm.orderTypeMap[key] = changeValue;
          });

          break;
        }

      case 'source':
        {
          let changeValue = true;
          if (_.every(vm.sourceMap)) changeValue = false;

          _.forEach(vm.sourceMap, (value, key) => {
            vm.sourceMap[key] = changeValue;
          });

          break;
        }

      case 'outlet':
        {
          let changeValue = true;
          if (_.every(vm.showOutletMap)) changeValue = false;

          _.forEach(vm.showOutletMap, (value, key) => {
            vm.showOutletMap[key] = vm.enableOutletMap[key] && changeValue;
          });

          break;
        }

      default:
    }
  };

  vm.updateShippingFee = function () {
    _.forEach(vm.shippings, shipping => {
      shipping.shippingFee = parseFloat(shipping.shippingFee);
    });

    if (_.some(vm.shippings, shipping => {
      return !shipping.billNumber;
    })) {
      return FhdMessenger.error('Chưa có mã đơn vận');
    } //  console.log(vm.shippings)


    if (_.some(vm.shippings, shipping => {
      return !shipping.shippingFee && shipping.shippingFee !== 0;
    })) {
      return FhdMessenger.error('Chưa có phí ship');
    }

    vm.waiting = true;
    OnlineOrders.updateShippingFee(vm.shippings).$promise.then(() => {
      FhdMessenger.notifySticky('Đã cập nhật xong');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    }); // console.log(vm.shippings)
  };

  vm.assignOutlet = (onlineOrder, outlet) => {
    // eslint-disable-next-line
    if (vm.user.roles.includes('admin')) {
      $http.put(`/online-orders/${onlineOrder._id}/change-outlet`, outlet).then(response => {
        if (response.data !== 'Có cập nhật') {
          FhdMessenger.success(response.data);
        }
      }).catch(err => {
        FhdMessenger.error(err.message);
      });
    }
  };

  vm.openModalViewOnlineOrder = onlineOrder => {
    OnlineOrderModal.view(onlineOrder);
  };

  Sockets.on('updateOnlineOrder', listenUpdateOnlineOrder);
  $scope.$on('$destroy', function () {
    Sockets.removeListener('updateOnlineOrder', listenUpdateOnlineOrder);
  });
}]);
"use strict";

angular.module('online-orders').controller('ScanOnlineOrdersController', ['FhdMessenger', 'OnlineOrders', '$q', 'CurrentShift', 'ConfirmModal', '$localStorage', '$scope', function (FhdMessenger, OnlineOrders, $q, CurrentShift, ConfirmModal, $localStorage, $scope) {
  const vm = this;
  vm.searchText = '';
  vm.onlineOrders = [];
  vm.waiting = false;

  vm.loadLocal = function () {
    const localOnlineOrders = $localStorage.getObject('shippingOnlineOrders');
    if (!_.isArray(localOnlineOrders)) return;
    Promise.mapSeries(_.filter(localOnlineOrders, {
      status: 'ready'
    }), onlineOrder => {
      return vm.searchOnlineOrder(_.get(onlineOrder, 'shipping.billNumber', onlineOrder.onlineOrderId));
    }).finally(() => {
      $scope.$apply();
    });
  };

  function hasBillNumber(billNumber, onlineOrders) {
    if (!billNumber) return false;
    return _.some(onlineOrders, onlineOrder => {
      return _.get(onlineOrder, 'shipping.billNumber', '') === billNumber;
    });
  }

  function processOnlineOrder(onlineOrder) {
    onlineOrder.shipping.fullAddress = `${_.get(onlineOrder, 'receiverCustomer.street')}, ${_.get(onlineOrder, 'receiverCustomer.district')}, ${_.get(onlineOrder, 'receiverCustomer.city')}`;

    if (_.get(onlineOrder, 'saleEntry.paymentType', '') === 'transfer') {
      onlineOrder.saleEntry.total = null;
    }

    return onlineOrder;
  }

  function removeAsterisk(searchText) {
    const match = searchText.match(/^\*(.*)\*$/);
    if (match) return match[1];
    return searchText;
  }

  vm.searchOnlineOrder = function (searchText) {
    if (!searchText) {
      FhdMessenger.errorStick('Chưa có mã vận đơn');
      return null;
    }

    searchText = removeAsterisk(searchText);
    searchText = searchText.toUpperCase();

    if (hasBillNumber(searchText, vm.onlineOrders)) {
      FhdMessenger.errorStick(`Mã vận đơn ${searchText} đã có trong danh sách.`);
      return null;
    }

    const onlineOrder = OnlineOrders.getByBillNumber({
      billNumber: searchText,
      status: 'ready'
    });
    vm.waiting = true;
    return onlineOrder.$promise.then(onlineOrder => {
      processOnlineOrder(onlineOrder);
      vm.onlineOrders.unshift(onlineOrder);
      $localStorage.setObject('shippingOnlineOrders', vm.onlineOrders);
      vm.searchText = '';
    }).catch(err => {
      const message = _.get(err, 'data.message', err);

      FhdMessenger.errorStick(message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.remove = function (index, array) {
    if (!_.isArray(array)) return;
    array.splice(index, 1);
    $localStorage.setObject('shippingOnlineOrders', vm.onlineOrders);
  };

  vm.removeList = function () {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Không xóa',
      actionButtonText: 'Xóa danh sách',
      headerText: 'Xóa danh sách?',
      bodyText: 'Danh sách online orders hiện tại sẽ không thể khổi phục.'
    }).then(() => {
      vm.onlineOrders = [];
      $localStorage.set('shippingOnlineOrders', null);
    });
  };

  vm.markDone = function (_onlineOrders) {
    const onlineOrders = _.filter(_onlineOrders, {
      status: 'ready'
    });

    const currentShift = CurrentShift.getCurrentShift();

    if (!_.get(currentShift, '_id')) {
      FhdMessenger.error('Cần đăng nhập vào ca trực để ship đơn hàng');
      return;
    }

    vm.numSuccess = 0;
    vm.numFail = 0;
    vm.waiting = true;
    $q.all(onlineOrders.map(onlineOrder => {
      onlineOrder.shipping = onlineOrder.shipping || {};
      onlineOrder.shipping.outlet = currentShift.outlet;
      onlineOrder.shipping.date = currentShift.date;
      onlineOrder.shipping.shift = currentShift.shift;
      return onlineOrder.$ship().then(() => {
        processOnlineOrder(onlineOrder);
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
        onlineOrder.error = err;
      });
    })).then(() => {
      FhdMessenger.info('Đã xong');
      vm.numSuccess = _.filter(onlineOrders, {
        status: 'done'
      }).length;
      vm.numFail = _.filter(onlineOrders, 'error').length;
    }).finally(() => {
      vm.waiting = false;
      $localStorage.setObject('shippingOnlineOrders', vm.onlineOrders);
    });
  };
}]);
"use strict";

angular.module('online-orders').controller('TableOnlineOrdersController', ['OnlineOrders', 'NgTableParams', 'FhdMessenger', '$scope', 'Authentication', 'ObjectId', 'OnlineOrderModal', 'OutletService', 'OnlineOrderService', 'CurrentShift', 'ConfirmModal', '$timeout', '$window', '$http', function (OnlineOrders, NgTableParams, FhdMessenger, $scope, Authentication, ObjectId, OnlineOrderModal, OutletService, OnlineOrderService, CurrentShift, ConfirmModal, $timeout, $window, $http) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {
    showOutletMap: {}
  };
  vm.startDate = moment().startOf('day').subtract(7, 'day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').subtract(1, 'day').format('YYYY-MM-DD');
  vm.onlineOrdersTable = new NgTableParams({
    count: 100
  });

  vm.init = () => {
    vm.statusMap = {
      created: false,
      processing: false,
      confirm: false,
      ready: false,
      done: true,
      cancel: true,
      return: true
    };
    vm.loadOutletsPromise = OutletService.allAsync().then(outlets => {
      vm.data.outlets = _.filter(outlets, {
        isPos: true
      });
      vm.showOutletMap = _.reduce(vm.data.outlets, (result, outlet) => {
        result[outlet._id] = true;
        return result;
      }, {});
    });
  };

  function fetchOnlineOrderToTable() {
    vm.onlineOrdersTable.settings({
      dataset: vm.onlineOrders
    });
    vm.onlineOrdersTable.reload(); // // For dev
    // $timeout(() => {
    //   vm.onlineOrdersTable.filter({})
    // }, 2000)
  }

  function processOnlineOrder(onlineOrder) {
    onlineOrder.shipping = onlineOrder.shipping || {};

    const shippingSaleEntry = _.get(onlineOrder, 'saleEntry.shipping');

    if (onlineOrder.status === 'cancel') {
      if (shippingSaleEntry) {
        shippingSaleEntry.collect = 0;
      }

      onlineOrder.shipping.collect = 0;
      onlineOrder.shipping.pay = 0;
    }

    if (onlineOrder.status === 'return') {
      if (shippingSaleEntry) {
        shippingSaleEntry.collect = 0;
      }
    }

    if (_.isFinite(_.get(onlineOrder, 'shipping.pay'))) {
      onlineOrder.shipping.diff = (onlineOrder.shipping.pay || 0) - (_.get(onlineOrder, 'saleEntry.shipping.collect') || 0);
    } else {
      onlineOrder.shipping.pay = null;
      onlineOrder.shipping.diff = 0;
    }

    if (_.get(onlineOrder, 'payment.method') === 'transfer') {
      onlineOrder.shipping.toCollect = 0;
    } else {
      onlineOrder.shipping.toCollect = _.get(onlineOrder, 'saleEntry.order.saleTotal') + (_.get(onlineOrder, 'payment.collect') || 0) + (_.get(onlineOrder, 'shipping.collect') || 0);
    }

    onlineOrder.shipping.fullAddress = `${_.get(onlineOrder, 'receiverCustomer.street')}, ${_.get(onlineOrder, 'receiverCustomer.district')}, ${_.get(onlineOrder, 'receiverCustomer.city')}`;
  }

  vm.find = function (status) {
    const user = Authentication.user;
    vm.calculateKPIs();
    if (!user) return;
    vm.waiting = true; // Filter assigned outlets

    const assignedOutlets = _.reduce(vm.showOutletMap, (assignedOutlets, toShow, outlet) => {
      if (toShow) assignedOutlets.push(outlet);
      return assignedOutlets;
    }, []);

    let statuses = [];

    if (status) {
      statuses = [status];
    } else {
      statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
        if (toShow) statuses.push(status);
        return statuses;
      }, []);
    }

    const orderTypes = _.reduce(vm.orderTypeMap, (orderTypes, toShow, orderType) => {
      if (toShow) orderTypes.push(orderType);
      return orderTypes;
    }, []);

    const sources = _.reduce(vm.sourceMap, (sources, toShow, source) => {
      if (toShow) sources.push(source);
      return sources;
    }, []);

    const query = {
      startDate: vm.startDate,
      endDate: vm.endDate,
      assignedOutlets,
      statuses,
      orderTypes,
      sources
    };

    if (!_.includes(user.roles, 'admin') && !_.includes(user.roles, 'accountant')) {
      if (!user.outlet) return;
      query.assignedOutlets = [ObjectId.getObjectId(user.outlet)];
    }

    vm.onlineOrders = OnlineOrders.query(query);
    let promise = vm.onlineOrders.$promise.then(() => {
      _.forEach(vm.onlineOrders, processOnlineOrder);

      fetchOnlineOrderToTable();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
  };

  vm.ebillFilter = function () {
    vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
    vm.endDate = moment().startOf('day').format('YYYY-MM-DD');
    vm.statusMap.confirm = true;
    vm.statusMap.ready = true;
    vm.statusMap.return = false;
    vm.statusMap.cancel = false;
    vm.orderTypeMap.HN = true;
    vm.orderTypeMap.TI = true;
    vm.orderTypeMap.BUON = true;
    vm.onlineOrdersTable.filter()['assignedOutlet.code'] = 'SHIP';
    vm.onlineOrdersTable.filter()['shipping.provider'] = 'Viettel';
    vm.onlineOrdersTable.sorting({
      'stages.done.time': 'asc'
    });
  };

  vm.selectOutlet = outlet => {
    vm.onlineOrdersTable.filter()['assignedOutlet.code'] = outlet.code;
  };

  vm.calculateKPIs = function () {
    if (_.includes(vm.user.roles, 'admin') || _.includes(vm.user.roles, 'ship')) {
      const sources = _.reduce(vm.sourceMap, (sources, toShow, source) => {
        if (toShow) sources.push(source);
        return sources;
      }, []);

      const orderTypes = _.reduce(vm.orderTypeMap, (orderTypes, toShow, orderType) => {
        if (toShow) orderTypes.push(orderType);
        return orderTypes;
      }, []);

      vm.loadOutletsPromise.then(() => {
        const assignedOutlets = _.reduce(vm.showOutletMap, (assignedOutlets, toShow, outlet) => {
          if (toShow) assignedOutlets.push(outlet);
          return assignedOutlets;
        }, []);

        OnlineOrderService.calculateKPIs({
          startDate: vm.startDate,
          endDate: vm.endDate,
          assignedOutlets,
          orderTypes,
          sources
        }).then(result => {
          vm.KPIs = result;
        });
      });
    }
  };

  vm.ship = function (onlineOrder) {
    if (onlineOrder.status === 'ship') {
      FhdMessenger.error('Đơn này đã ở trạng thái ship');
      return;
    }

    const currentShift = CurrentShift.getCurrentShift();

    if (!_.get(currentShift, '_id')) {
      FhdMessenger.error('Cần đăng nhập vào ca trực để ship đơn hàng');
      return;
    }

    ConfirmModal.showModal({}, {
      bodyText: `Ship đơn #${onlineOrder.onlineOrderId} - ${onlineOrder.receiverCustomer.name}?`
    }).then(() => {
      vm.waiting = true;
      onlineOrder.shipping = onlineOrder.shipping || {};
      onlineOrder.shipping.outlet = currentShift.outlet;
      onlineOrder.shipping.date = currentShift.date;
      onlineOrder.shipping.shift = currentShift.shift;
      return onlineOrder.$ship().then(processOnlineOrder).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.handleChecked = (e, onlineOrder) => {
    e.preventDefault();
    ConfirmModal.showModal({}, {
      bodyText: `${onlineOrder.checked ? 'Hủy trạng thái đã' : 'Chuyển trạng thái đã'} đối soát đơn ${onlineOrder.onlineOrderId}?`
    }).then(() => {
      onlineOrder.$check().then(res => {
        onlineOrder.checked = res.checked;
        FhdMessenger.success('Cập nhật thành công!');
      });
    });
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      case 'orderType':
        {
          let changeValue = true;
          if (_.every(vm.orderTypeMap)) changeValue = false;

          _.forEach(vm.orderTypeMap, (value, key) => {
            vm.orderTypeMap[key] = changeValue;
          });

          break;
        }

      case 'source':
        {
          let changeValue = true;
          if (_.every(vm.sourceMap)) changeValue = false;

          _.forEach(vm.sourceMap, (value, key) => {
            vm.sourceMap[key] = changeValue;
          });

          break;
        }

      case 'outlet':
        {
          let changeValue = true;
          if (_.every(vm.showOutletMap)) changeValue = false;

          _.forEach(vm.showOutletMap, (value, key) => {
            vm.showOutletMap[key] = changeValue;
          });

          break;
        }

      default:
    }
  };

  $scope.$watch(() => vm.onlineOrdersTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.totalSaleTotal = _.sumBy(newValue, 'saleEntry.order.saleTotal');
    vm.totalShippingCollect = _.sumBy(newValue, 'saleEntry.shipping.collect');
    vm.totalShippingPay = _.sumBy(newValue, 'shipping.pay');
    vm.totalShippingDiff = _.sumBy(newValue, 'shipping.diff');
  });

  vm.copyEBillViettelTSV = () => {
    vm.data.ebillsTSV = 'Đang copy dữ liệu....';

    const ebills = _.map(vm.onlineOrdersTable.data, onlineOrder => {
      let shippingService = '';

      switch (onlineOrder.shipping.service) {
        case 'vtk':
          shippingService = 'VTK - Chuyển phát tiết kiệm';
          break;

        case 'vcn':
          shippingService = 'VCN - Chuyển phát nhanh';
          break;

        default:
          break;
      }

      const fields = [onlineOrder.shipping.billNumber, onlineOrder.receiverCustomer.name, onlineOrder.receiverCustomer.cellphone, onlineOrder.shipping.fullAddress, onlineOrder.receiverCustomer.city, onlineOrder.receiverCustomer.district, onlineOrder.receiverCustomer.ward, 'NQ01', 'DỤNG CỤ LÀM BÁNH - DỄ VỠ', '1', _.get(onlineOrder, 'saleEntry.order.saleTotal'), onlineOrder.shipping.calculatedWeight, shippingService, undefined, onlineOrder.shipping.billNumber, undefined, undefined, 'Người bán', _.get(onlineOrder, 'shipping.toCollect'), undefined, undefined, undefined, 'Cho xem hàng', undefined];
      return fields.join('\t');
    });

    vm.data.ebillsTSV = ebills.join('\n');
    const copyText = $window.document.getElementById('ebillsCSV');
    $timeout(() => {
      /* Select the text field */
      copyText.select();
      /* Copy the text inside the text field */

      $window.document.execCommand('copy');
      FhdMessenger.success('Đã copy'); // $timeout(() => {
      //   vm.data.productTSV = 'Nhấn vào nút Copy bảng để lấy dữ liệu...'
      // }, 2000)
    }, 2000);
  };

  vm.copyEbillTSV = () => {
    const headers = ['STT', 'Done', 'Tên', 'Địa chỉ', 'SĐT', 'Nội dung', 'Dịch vụ', 'Số vận đơn', 'Mã KH', 'Trọng lượng', 'Tiền hàng', 'Tiền ship thu KH', 'Tiền COD thu KH', 'Tiền thu hộ'];
    vm.data.ebillsTSV = 'Đang copy dữ liệu....';

    const ebills = _.map(vm.onlineOrdersTable.data, (onlineOrder, index) => {
      const fields = [index + 1, moment(onlineOrder.stages.done.time).format('L LT'), onlineOrder.receiverCustomer.name, onlineOrder.shipping.fullAddress, onlineOrder.receiverCustomer.cellphone, onlineOrder.onlineOrderId, onlineOrder.shipping.service.toUpperCase(), onlineOrder.shipping.billNumber, 1165, _.get(onlineOrder, 'shipping.calculatedWeight', 0), _.get(onlineOrder, 'saleEntry.order.saleTotal', 0), _.get(onlineOrder, 'shipping.collect', 0), _.get(onlineOrder, 'payment.collect', 0), _.get(onlineOrder, 'shipping.toCollect', 0)];
      return fields.join('\t');
    });

    vm.data.ebillsTSV = headers.join('\t') + '\n' + ebills.join('\n');
    const copyText = $window.document.getElementById('ebillsCSV');
    $timeout(() => {
      /* Select the text field */
      copyText.select();
      /* Copy the text inside the text field */

      $window.document.execCommand('copy');
      FhdMessenger.success('Đã copy'); // $timeout(() => {
      //   vm.data.productTSV = 'Nhấn vào nút Copy bảng để lấy dữ liệu...'
      // }, 2000)
    }, 2000);
  };
}]);
"use strict";

angular.module('online-orders').controller('UpdateProductImageForOnlineOrderController', ['$stateParams', 'OnlineOrders', 'FhdMessenger', function ($stateParams, OnlineOrders, FhdMessenger) {
  const vm = this;

  vm.findOne = function () {
    vm.onlineOrder = OnlineOrders.get({
      onlineOrderId: $stateParams.onlineOrderId
    });
  };

  vm.update = function () {
    vm.waiting = true;
    const promise = vm.onlineOrder.$updateProductImages().then(() => {
      FhdMessenger.success('Cập nhật ảnh bánh thành phẩm thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang cập nhật ảnh bánh thành phẩm...', promise);
  };
}]);
'use strict';

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('online-orders').controller('ViewOnlineOrderController', ['$document', '$timeout', 'helper', 'ShippingEntriesService', 'OnlineOrders', 'OnlineOrderService', 'ShippingAreaService', 'Authentication', 'BundlePricesService', 'FhdMessenger', '$scope', '$filter', '$localStorage', '$state', 'ConfirmModal', '$window', '$location', 'ProductService', 'StockMap', 'Vouchers', 'OutletService', 'Address', 'Sockets', 'CurrentShift', 'SaleEntryService', 'ComplaintService', 'ObjectId', '$stateParams', 'OnlineOrderModal', 'PromotionService', 'ShippingFee', '$q', 'OrderTypes', 'JsPrintService', 'CustomerService', 'SaleCampaigns', 'SaleCampaignService', '$http', 'CalculateService', function ($document, $timeout, helper, ShippingEntriesService, OnlineOrders, OnlineOrderService, ShippingAreaService, Authentication, BundlePricesService, FhdMessenger, $scope, $filter, $localStorage, $state, ConfirmModal, $window, $location, ProductService, StockMap, Vouchers, OutletService, Address, Sockets, CurrentShift, SaleEntryService, ComplaintService, ObjectId, $stateParams, OnlineOrderModal, PromotionService, ShippingFee, $q, OrderTypes, JsPrintService, CustomerService, SaleCampaigns, SaleCampaignService, $http, CalculateService) {
  const vm = this;
  vm.waiting = false;
  vm.copyToClipboard = helper.copyToClipboard;
  vm.user = Authentication.user;
  vm.currentShift = CurrentShift.getCurrentShift();
  vm.lastFiveOrder = [];
  vm.assignedShippingEntries = [];
  vm.data = _objectSpread({
    editShipping: false,
    editOrder: false
  }, OnlineOrderService.getSharedData());
  vm.isValentine = false;
  vm.isWomenDay = false;
  vm.isNumber = _.isNumber;

  vm.modifierShipperPhoneNumber = phoneNumber => {
    if (_.isString(phoneNumber) && !phoneNumber.match(/^0/)) {
      vm.onlineOrder.shipping.shipperPhoneNumber = '0' + phoneNumber;
    }
  };

  vm.getPaymentMethodByShippingProvider = () => {
    vm.data.paymentMethods = OnlineOrderService.getPaymentMethodByShippingProvider(_.get(vm.onlineOrder, 'shipping.provider'));
  };

  vm.autoDeliverEndTime = () => {
    vm.onlineOrder.deliverEndTime = moment(vm.onlineOrder.deliverStartTime).add(1, 'hour');
  };

  vm.showManufacturingDate = function (item) {
    if (_.get(vm, 'onlineOrder.orderType') !== 'ORDER') {
      return false;
    }

    if (item.sku === 'V1408') {
      return false;
    }

    return _.get(item, 'category.cat.name') === 'Bánh sinh nhật';
  };

  vm.openModalConfirmInfo = () => {
    const shippingCollect = _.get(vm.onlineOrder, 'shipping.collect', vm.shippingFee);

    OnlineOrderModal.openConfirmInfoModal(_objectSpread({}, vm.onlineOrder, {
      calculateItems: vm.calculateItems,
      shippingFee: shippingCollect,
      depositAmount: vm.depositAmount,
      voucherQuantity: vm.voucherQuantity,
      isBSNOrder: vm.cakeTotal > 0
    }));
  };

  vm.openModalQR = () => {
    const shippingCollect = _.get(vm.onlineOrder, 'shipping.collect', vm.shippingFee);

    OnlineOrderModal.openQRModal(_objectSpread({}, vm.onlineOrder, {
      calculateItems: vm.calculateItems,
      shippingFee: shippingCollect,
      depositAmount: vm.depositAmount,
      voucherQuantity: vm.voucherQuantity,
      isBSNOrder: vm.cakeTotal > 0,
      link: vm.link
    }));
  };

  vm.updateFacebookConversationId = () => {
    if (!_.isString(vm.facebookConversationId)) {
      return;
    }

    const match = vm.facebookConversationId.match(/\d{16}_\d{16}/);

    if (match) {
      vm.facebookConversationId = _.head(match);
    }
  };

  vm.findVoucher = () => {
    vm.waiting = true;
    Vouchers.searchVoucher({
      couponCode: vm.couponCode.trim()
    }).$promise.then(voucher => {
      vm.onlineOrder.voucher = voucher;
      vm.onlineOrder.customer.vouchers = [voucher];
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.chooseFillingTypeSkus = OnlineOrderService.getFillingTypeSkus();
  vm.needPhotoSkus = _.concat(OnlineOrderService.getNeedPhotoSkus(), vm.chooseFillingTypeSkus);
  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus;
  vm.updateShippingEntry = ShippingEntriesService.update;

  vm.createShippingEntry = function (data) {
    ShippingEntriesService.create(data).then(() => {
      vm.findOne();
    });
  };

  vm.getYetToShip = function () {
    if (_.get(vm.onlineOrder, 'shipping.provider') !== 'Ship nội bộ') {
      return;
    }

    $http.get('/shipping-entries/get-yet-to-ship', {
      params: {
        assignedOutlet: ObjectId.getObjectId(vm.onlineOrder.assignedOutlet),
        onlineOrderId: ObjectId.getObjectId(vm.onlineOrder)
      }
    }).then(response => {
      vm.assignedShippingEntries = response.data;
    });
  };

  vm.addShipDestination = function (shippingEntry) {
    ConfirmModal.showModal({}, {
      bodyText: 'Bạn có chắc chắn muốn thêm điểm ship bánh vào shipping entry đã chọn này không?'
    }).then(() => {
      FhdMessenger.info('Đang thêm');
      vm.waiting = true;
      const destination = {
        cellphone: vm.onlineOrder.receiverCustomer.cellphone,
        name: vm.onlineOrder.receiverCustomer.name,
        address: vm.onlineOrder.receiverCustomer.address,
        onlineOrder: vm.onlineOrder._id
      };
      ShippingEntriesService.addDestination(shippingEntry._id, destination).then(() => {
        FhdMessenger.success('Đã thêm điểm ship thành công');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.openModalSelectCakeFillingType = OnlineOrderModal.openModalSelectCakeFillingType;
  vm.openModalSelectManufacturingDate = OnlineOrderModal.openModalSelectManufacturingDate;

  vm.openModalSelectVariants = item => {
    OnlineOrderService.openModalSelectVariants({
      item,
      items: vm.calculateItems,
      assignedOutlet: vm.onlineOrder.assignedOutlet,
      source: vm.onlineOrder.source
    }).then(calculateItems => {
      vm.calculateItems = calculateItems;
      vm.calculate();
    });
  };

  vm.openChangeAssignedOutletModal = onlineOrder => {
    const assignedOutletId = ObjectId.getObjectId(onlineOrder.assignedOutlet);
    const outlets = [vm.user.outlet].concat(vm.user.managingOutlets);

    if (!_.intersection(vm.user.roles, ['admin', 'marketing']).length && !ObjectId.equals(assignedOutletId, vm.currentShift.outlet) && !_.some(outlets, outlet => ObjectId.equals(assignedOutletId, outlet))) {
      return FhdMessenger.error('Bạn không có quyền chuyển đơn online order này');
    }

    OnlineOrderModal.openChangeAssignedOutletModal(onlineOrder);
  };

  vm.getStockMap = function () {
    StockMap.getStockMapCache().then(data => {
      vm.stockMap = data;
    });
  };

  function hasAuthorization(user, onlineOrder, currentShift) {
    if (_.intersection(_.get(user, 'roles'), ['admin', 'tro-ly', 'accountant', 'marketing', 'ship', 'wholesale', 'purchaser', 'probation-purchaser']).length > 0) {
      return true;
    }

    if (user.roles.includes('kitchen') && vm.onlineOrder.orderType === 'TT') {
      return true;
    }

    if (_.get(currentShift, 'outlet.code') === 'D3' && vm.onlineOrder.orderType === 'HTT') {
      return true;
    }

    const currentShiftOutletId = ObjectId.getObjectId(_.get(currentShift, 'outlet'));
    const assignedOutletId = ObjectId.getObjectId(onlineOrder.assignedOutlet);

    if (currentShiftOutletId === assignedOutletId) {
      return true;
    }

    return false;
  }

  vm.selectCustomer = customer => {
    if (!customer) {
      vm.onlineOrder.customer = null;
      vm.customerPoints = 0;
      vm.calculate();
      return;
    }

    vm.onlineOrder.customer = customer;
    CustomerService.getValueAndVouchers(customer.customerId).then(customer => {
      vm.customerPoints = customer.customerPoints;
      vm.onlineOrder.customer.isStaff = customer.isStaff;

      if (!vm.onlineOrder.saleEntry && !vm.onlineOrder.voucher) {
        if (customer.vouchers.length) {
          vm.onlineOrder.customer.vouchers = customer.vouchers;
          vm.onlineOrder.customer.vouchers.push({
            _id: 'NONE',
            name: 'Không dùng voucher',
            voucherType: 'PERCENTATE',
            target: 'PRODUCT',
            products: [],
            quantity: 0
          }); // vm.onlineOrder.voucher = _.head(vm.onlineOrder.customer.vouchers)
        }

        vm.calculate();
      }

      SaleCampaigns.fromCustomer(customer).$promise.then(saleCampaigns => {
        vm.onlineOrder.customer.saleCampaigns = saleCampaigns;
      });
    });
  };

  function markMatchOrder(orders) {
    vm.lastFiveOrder = _.map(orders, order => {
      if (order.onlineOrderId === vm.onlineOrder.onlineOrderId) {
        order.match = true;
      }

      return order;
    });
    vm.lastFiveOrder = _.sortBy(vm.lastFiveOrder, '-created');
  }

  vm.findOne = function () {
    vm.printLink = $window.location.href; //  + '/update-product-images'

    vm.onlineOrder = OnlineOrders.get({
      onlineOrderId: $stateParams.onlineOrderId
    });
    vm.waiting = true;
    vm.onlineOrder.$promise.then(onlineOrder => {
      const paymentMethod = _.get(vm.onlineOrder, 'payment.method');

      if (paymentMethod && !_.some(vm.data.paymentMethods, {
        value: paymentMethod
      })) {
        vm.data.paymentMethods.push({
          value: paymentMethod,
          label: paymentMethod
        });
      }

      vm.onlineOrder = onlineOrder;
      vm.orderCustomer = _.cloneDeep(onlineOrder.orderCustomer);
      vm.onlineOrder.fees = onlineOrder.fees || [];
      vm.cakeTotal = OnlineOrderService.getCakeTotal(vm.onlineOrder.items);
      vm.addOnTotal = vm.cakeTotal + OnlineOrderService.getAddOnTotal(vm.onlineOrder.items);

      if (vm.onlineOrder.fees.length > 0) {
        vm.frozenFee = _.find(vm.onlineOrder.fees, {
          type: 'FROZEN_SHIPPING'
        }).value || 0;
      } else {
        vm.frozenFee = 0;
      }

      vm.usedPoint = _.get(vm.onlineOrder, 'usedPoint', 0);

      if (vm.onlineOrder.customer) {
        vm.selectCustomer(vm.onlineOrder.customer);
      }

      if (_.get(onlineOrder, 'saleEntry.voucher')) {
        vm.onlineOrder.voucher = onlineOrder.saleEntry.voucher;
      }

      vm.onlineOrder.mobileProvider = CustomerService.checkProvider(vm.onlineOrder.orderCustomer.cellphone);
      vm.onlineOrder.receiverMobileProvider = CustomerService.checkProvider(vm.onlineOrder.receiverCustomer.cellphone);

      if (_.get(vm.onlineOrder.receiverCustomer, 'cellphone', null)) {
        $http.get('/online-orders/last-five-order', {
          params: {
            cellphone: _.get(vm.onlineOrder.receiverCustomer, 'cellphone')
          }
        }).then(response => {
          markMatchOrder(response.data);
        });
      }

      if (!hasAuthorization(vm.user, vm.onlineOrder, CurrentShift.getCurrentShift())) {
        FhdMessenger.error('Bạn không có quyền xử lý online order này');
        return $state.go('home');
      }

      vm.calculateItems = vm.onlineOrder.items;

      if (vm.onlineOrder.receiverCustomer.district) {
        vm.districtLabel = `${vm.onlineOrder.receiverCustomer.district}, ${vm.onlineOrder.receiverCustomer.city}`;
      }

      vm.getPaymentMethodByShippingProvider(); // enable fast edit

      if (_.includes(['done', 'cancel', 'return'], vm.onlineOrder.status) && !vm.user.roles.includes('online-order:edit')) {
        vm.data.editShipping = false;
      } else {
        vm.data.editShipping = true;
      }

      if (_.includes(['created', 'processing', 'confirm'], vm.onlineOrder.status)) {
        vm.data.editOrder = true;
      } else {
        vm.data.editOrder = false;
      }

      OutletService.allAsync().then(outlets => {
        vm.data.outlets = _.filter(_.filter(outlets, outlet => {
          return outlet.isPos || outlet.sellBirthdayCake;
        }), outlet => {
          if (vm.onlineOrder.orderType === 'ORDER') {
            return outlet.sellBirthdayCake;
          }

          return outlet.code.match(/^[ME]\d+/);
        });
        vm.assignedOutlet = _.find(outlets, outlet => ObjectId.equals(outlet, vm.onlineOrder.assignedOutlet));
      });
      $q.all([vm.onlineOrder.$promise, ProductService.getAllSellingProductsFromServer()]).then(([onlineOrder, products]) => {
        const imageLinkMap = _.reduce(products, (result, product) => {
          result[product.sku] = product.imageLink;
          return result;
        }, {});

        vm.calculateItems = _.compact(_.map(onlineOrder.items, item => {
          if (item.sku === 'V1408') {
            _.forEach(item.bundledProducts, product => {
              product.imageLink = imageLinkMap[product.sku];
              product.imageLink = imageLinkMap[product.sku];
            });

            return item;
          }

          const matchProduct = _.find(products, {
            sku: item.sku
          });

          if (!matchProduct && !item.description.match(/(Không còn trên web work)/)) {
            return _.assign({}, item, {
              description: `${item.description} (Không còn trên web work)`
            });
          }

          let price = getOutletProperty('price', vm.onlineOrder.assignedOutlet, matchProduct, vm.onlineOrder.source);
          let salePrice = getOutletProperty('salePrice', vm.onlineOrder.assignedOutlet, matchProduct, vm.onlineOrder.source);
          let cogs = getOutletProperty('cogs', vm.onlineOrder.assignedOutlet, matchProduct);
          return _.assign({}, item, matchProduct, {
            product: matchProduct._id,
            quantity: item.quantity,
            originalPrice: price,
            salePrice,
            cogs,
            bundledProducts: item.bundledProducts.length ? item.bundledProducts : matchProduct.bundledProducts,
            websitePrice: item.websitePrice,
            lineTotal: matchProduct.price,
            maxQuantityPerOnlineOrder: matchProduct.maxQuantityPerOnlineOrder,
            warehouseRestock: matchProduct.warehouseRestock
          });
        }));
        vm.onlineOrder = onlineOrder;
        vm.getTotalValue = OnlineOrderService.getTotalValue;
        vm.calculate();

        if (!_.get(vm.onlineOrder, 'shipping.weight')) {
          vm.onlineOrder.shipping.weight = _.reduce(vm.calculateItems, (result, item) => {
            result += _.get(item, 'netWeight', 0) * 1000 * item.quantity;
            return result;
          }, 0);
          vm.calculateFees();
        }

        if (_.get(vm.onlineOrder, 'shipping.provider') === 'Ship nội bộ') {
          vm.getYetToShip();
        }

        createVoucherLink(vm.onlineOrder);
        suggestShippingOutlet(vm.onlineOrder);
        vm.isValentine = OnlineOrderService.checkValentine(vm.onlineOrder);
        vm.isWomenDay = OnlineOrderService.checkWomenDay(vm.onlineOrder);
      }).then(() => {
        vm.getStockMap();
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  function suggestShippingOutlet(onlineOrder) {
    if (onlineOrder.orderType !== 'ORDER') {
      return;
    }

    if (vm.suggestOutlet && vm.suggestKitchen) {
      return;
    }

    ShippingAreaService.getSavorShippingArea().then(shippingArea => {
      const matchItem = _.find(shippingArea.items, {
        district: onlineOrder.receiverCustomer.district,
        ward: onlineOrder.receiverCustomer.ward
      });

      vm.suggestOutlet = _.get(matchItem, 'outlet', 'Chưa rõ');
      vm.suggestKitchen = _.get(matchItem, 'kitchen', 'Chưa rõ');
    });
  }

  vm.removeDeposit = function () {
    ConfirmModal.showModal({}, {
      bodyText: 'Bạn chắc chắn muốn xóa tiền cọc cho Online Order này chứ?'
    }).then(() => {
      FhdMessenger.info('Đang xóa tiền cọc');
      vm.waiting = true;
      vm.onlineOrder.$removeDeposit().then(() => {
        FhdMessenger.success('Đã xóa tiền cọc.');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.changePaymentCollect = function () {
    if (_.get(vm.onlineOrder, 'payment.method', '') === 'transfer') {
      vm.onlineOrder.payment.collect = 0;
    }
  };

  vm.removeNote = function (note) {
    const matchNoteIndex = _.findIndex(vm.onlineOrder.notes, {
      _id: note._id
    });

    if (matchNoteIndex > -1) {
      vm.onlineOrder.notes.splice(matchNoteIndex, 1);
    }
  };

  function updateDistrict() {
    const district = _.find(vm.data.districts, {
      label: vm.districtLabel
    });

    if (!district && !vm.onlineOrder.receiverCustomer.address) {
      return FhdMessenger.error('Bạn phải chọn quận để lưu đơn hàng');
    }

    if (district) {
      vm.onlineOrder.receiverCustomer.district = district.district;
      vm.onlineOrder.receiverCustomer.city = district.city;
    }
  }

  vm.updateDistrict = updateDistrict; // Remember to return a promise for this function

  function updateOnlineOrder() {
    updateDistrict();

    if (vm.newNote) {
      vm.onlineOrder.notes = vm.onlineOrder.notes || [];
      vm.onlineOrder.notes.push({
        content: vm.newNote,
        user: Authentication.user,
        time: new Date()
      });
    }

    vm.onlineOrder.items = vm.calculateItems;
    vm.onlineOrder.updated = new Date();
    const error = validateUpdateAndConfirm(vm.onlineOrder);

    if (error) {
      vm.waiting = false;
      return FhdMessenger.error(error);
    }

    return vm.onlineOrder.$update().then(onlineOrder => {
      vm.onlineOrder = onlineOrder;
      createVoucherLink(vm.onlineOrder);
      vm.newNote = '';
      return onlineOrder;
    });
  }

  function validateUpdateAndConfirm() {
    if (_.some(vm.calculateItems, item => {
      return vm.needPhotoSkus.includes(item.sku);
    })) {
      if (!vm.onlineOrder.images.length) {
        return 'Đơn bánh vẽ/tulip phải có ảnh mẫu';
      }
    }

    if (vm.onlineOrder.requestCard && !vm.onlineOrder.requestCardContent) {
      return 'Chưa có nội dung của thiệp khách yêu cầu thêm';
    }

    const validate = OnlineOrderService.validate(vm.onlineOrder);
    const validateSpecialSkusWomenDay = validate.validateSpecialSkusOnSpecialDays(PromotionService.getSpecialCakeSkus(), moment().set({
      month: 2,
      date: 7
    }).startOf('day'), moment().set({
      month: 2,
      date: 8
    }).endOf('day'));

    if (validateSpecialSkusWomenDay) {
      return validateSpecialSkusWomenDay;
    }

    if (vm.onlineOrder.orderType === 'ORDER') {
      const deliveryTimeError = validate.validateDeliveryTime();

      if (deliveryTimeError) {
        return deliveryTimeError;
      }

      const transferOnlyError = validate.validateTransferOnly();

      if (transferOnlyError) {
        return transferOnlyError;
      }
    }

    const paymentCodeError = validate.validatePaymentCode();

    if (paymentCodeError) {
      return paymentCodeError;
    }

    if (vm.onlineOrder.deposits.length) {
      return;
    }

    vm.onlineOrder.deposits = _.get(vm.deposit, 'amount') > 0 ? [{
      amount: _.get(vm.deposit, 'amount'),
      transferCode: _.get(vm.deposit, 'code'),
      depositType: 'transfer'
    }] : [];
    const cakeDepositError = validate.validateCakeDeposit({
      chooseFillingTypeSkus: vm.chooseFillingTypeSkus,
      status: vm.onlineOrder.status,
      orderValue: vm.onlineOrder.orderValue - vm.voucherQuantity,
      shippingFee: vm.shippingFee
    });

    if (cakeDepositError) {
      return cakeDepositError;
    }

    const depositAmountError = validate.validateDepositAmount(vm.depositAmount, vm.deposit);

    if (depositAmountError) {
      return depositAmountError;
    }
  }

  vm.update = function () {
    if (!_.get(vm.onlineOrder, 'feedbackImages.length') && vm.onlineOrder.status === 'done') {
      if (_.get(vm.onlineOrder, 'shipping.provider') === 'Ahamove') {
        if (!_.get(vm.onlineOrder, 'shipping.billNumber')) {
          return FhdMessenger.error('Chưa có mã đơn Ahamove');
        }

        if (!_.get(vm.onlineOrder, 'shipping.billNumber').match(/^\w+/)) {
          return FhdMessenger.error('Mã vận đơn Ahamove chỉ gồm 6 ký tự chữ cái hoặc số');
        }
      }

      if (_.get(vm.onlineOrder, 'shipping.provider') === 'Lalamove') {
        if (!_.get(vm.onlineOrder, 'shipping.billNumber')) {
          return FhdMessenger.error('Chưa có mã đơn Lalamove');
        }

        if (!_.get(vm.onlineOrder, 'shipping.billNumber').match(/(^\w{18}$|^\w{10}$|^\w{12}$)/)) {
          return FhdMessenger.error('Mã vận đơn Lalamove chỉ gồm 10,12 hoặc 18 ký tự chữ cái hoặc số');
        }
      }
    }

    const voucherType = _.get(vm.onlineOrder, 'voucher.voucherType', '');

    if (voucherType === 'DISCOUNT_CAKE_ORDER_NORMAL' && !_.some(vm.calculateItems, item => {
      return item.description.match(/(cỡ|size) nhỏ/gim) || ['V1408'].includes(item.sku);
    })) {
      return FhdMessenger.error('Trong danh sách sản phẩm không có bánh cỡ nhỏ để sử dụng voucher');
    }

    if (voucherType === 'DISCOUNT_CAKE_ORDER_BIG' && !_.some(vm.calculateItems, item => {
      return item.description.match(/(cỡ|size) vừa/gim) || ['V1788'].includes(item.sku);
    })) {
      return FhdMessenger.error('Trong danh sách sản phẩm không có bánh cỡ vừa để sử dụng voucher');
    }

    if (vm.onlineOrder.orderType === 'ORDER' && _.some(vm.calculateItems, item => {
      return !item.sku.match(/V\d+/);
    })) {
      return FhdMessenger.error('Đơn bánh sinh nhật/trung thu chỉ được thêm mã V');
    }

    if (vm.facebookConversationId) {
      if (!vm.facebookConversationId.match(/\d{16}_\d{16}/)) {
        return FhdMessenger.error('Facebook Conversation Id không hợp lệ');
      }

      vm.onlineOrder.facebookConversationId = vm.facebookConversationId;
    }

    vm.waiting = true;
    updateOnlineOrder().then(() => {
      FhdMessenger.success('Cập nhật thành công!');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.confirm = function () {
    const currentShift = CurrentShift.getCurrentShift();

    if (!_.get(currentShift, '_id') && !_.intersection(vm.user.roles, ['admin', 'tro-ly']).length) {
      return FhdMessenger.error('Bạn cần đăng nhập vào để confirm');
    }

    const {
      date,
      outlet,
      shift
    } = currentShift;
    vm.waiting = true;
    updateOnlineOrder().then(() => {
      return vm.onlineOrder.$confirm({
        date,
        outlet: _.get(outlet, '_id', ''),
        shift
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.ready = function () {
    if (_.get(vm.onlineOrder, 'orderType', '') === 'ORDER') {
      const {
        date,
        outlet,
        shift
      } = vm.currentShift;
      vm.waiting = true;
      return updateOnlineOrder().then(() => {
        return vm.onlineOrder.$ready({
          date,
          outlet: _.get(outlet, '_id', ''),
          shift
        });
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    }

    if (_.get(vm.currentShift, 'outlet.code', '') !== _.get(vm.onlineOrder, 'assignedOutlet.code', '')) {
      return FhdMessenger.error('Bạn chỉ được tạo hóa đơn khi đăng nhập trùng cơ sở với cơ sở xử lý online order');
    }

    if (!_.isFinite(_.get(vm.onlineOrder, 'shipping.collect'))) {
      return FhdMessenger.error('Chưa có phí ship thu KH');
    }

    if (['Ship ngoài'].includes(_.get(vm.onlineOrder, 'shipping.provider', ''))) {
      if (!_.isFinite(_.get(vm.onlineOrder, 'shipping.pay'))) {
        return FhdMessenger.error('Chưa có giá ship ngoài');
      }
    }

    if (_.get(vm.onlineOrder, 'shipping.provider') === 'Gửi nhà xe') {
      if (!_.isFinite(_.get(vm.onlineOrder, 'shipping.pay'))) {
        return FhdMessenger.error('Chưa điền phí ship trả ĐV Vận chuyển (phí gửi ship đến nhà xe)');
      }
    }

    if (!vm.onlineOrder.customer) {
      return FhdMessenger.error('Chưa có thông tin tài khoản khách hàng');
    }

    if (_.get(vm.onlineOrder, 'payment.method') === 'cod' && !_.isFinite(_.get(vm.onlineOrder, 'payment.collect'))) {
      return FhdMessenger.error('Chưa có phí thanh toán/cod thu KH');
    }

    if (_.get(vm.onlineOrder, 'payment.method') === 'transfer') {
      if (!_.get(vm.onlineOrder, 'payment.code')) {
        return FhdMessenger.error('Chưa nhập mã giao dịch');
      }
    }

    if (vm.shippingFee && vm.shippingFee !== vm.onlineOrder.shipping.collect) {
      ConfirmModal.showModal({}, {
        bodyText: `Phí ship gợi ý là ${vm.shippingFee || 0} khác phí ship đã chọn là ${vm.onlineOrder.shipping.collect || 0}. Bạn có chắc chắn về mức phí này?`
      }).then(() => {
        ready();
      });
    } else {
      ready();
    }
  };

  function ready() {
    vm.waiting = true;

    if (vm.onlineOrder.orderType === 'TT') {
      vm.onlineOrder.status = 'ready';
      vm.onlineOrder.notes.push({
        content: 'Đã làm xong bánh cho khách',
        user: vm.user
      });
    }

    updateOnlineOrder().then(() => {
      $localStorage.setObject('onlineOrder', _.assign({}, vm.onlineOrder, {
        items: vm.calculateItems
      }));

      if (vm.onlineOrder.orderType !== 'TT') {
        if (_.get(vm.onlineOrder, 'assignedOutlet.code') === 'BSG') {
          $window.open(`${$location.protocol()}://${$location.host()}${$location.port() !== 80 ? `:${$location.port()}` : ''}/#!/wholesale-entries/create`, '_blank');
        } else {
          $window.open(`${$location.protocol()}://${$location.host()}${$location.port() !== 80 ? `:${$location.port()}` : ''}/#!/sale-entries/create`, '_blank');
        }
      }
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }

  vm.ship = function () {
    const currentShift = CurrentShift.getCurrentShift();

    if (!_.get(currentShift, '_id')) {
      FhdMessenger.error('Cần đăng nhập vào ca trực để ship đơn hàng');
      return;
    }

    const validate = OnlineOrderService.validate(vm.onlineOrder);
    const error = validate.validateShip();

    if (error) {
      return FhdMessenger.error(error);
    }

    ConfirmModal.showModal({}, {
      bodyText: `Ship đơn #${vm.onlineOrder.onlineOrderId} - ${vm.onlineOrder.receiverCustomer.name}?`
    }).then(() => {
      vm.waiting = true;
      updateOnlineOrder().then(() => {
        if (vm.onlineOrder.orderType === 'TT') {
          let shift = 'S';

          if (moment().hour() >= 12 && moment().hour() < 17) {
            shift = 'C';
          } else if (moment().hour() >= 17) {
            shift = 'T';
          }

          vm.onlineOrder.shipping.outlet = vm.onlineOrder.assignedOutlet;
          vm.onlineOrder.shipping.date = moment().startOf('day');
          vm.onlineOrder.shipping.shift = shift;
        } else {
          vm.onlineOrder.shipping.outlet = currentShift.outlet;
          vm.onlineOrder.shipping.date = currentShift.date;
          vm.onlineOrder.shipping.shift = currentShift.shift;
        }

        vm.onlineOrder.shipping = vm.onlineOrder.shipping || {};
        const {
          date,
          outlet,
          shift
        } = currentShift;
        const outletId = outlet._id;
        return vm.onlineOrder.$ship({
          date,
          outletId,
          shift
        });
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.cancel = function () {
    const currentShift = CurrentShift.getCurrentShift() || {};
    const items = vm.calculateItems;
    OnlineOrderModal.getReason('cancel', items).then(data => {
      const reason = data.reason;
      const _items = data.items;

      if (!reason) {
        FhdMessenger.error('Chưa có lý do hủy đơn');
        return;
      }

      const outStockSkus = _.map(_items, 'sku');

      vm.waiting = true;
      vm.onlineOrder.$cancel({
        outlet: ObjectId.getObjectId(currentShift.outlet),
        date: currentShift.date,
        shift: ObjectId.getObjectId(currentShift.shift),
        reason,
        outStockSkus
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.return = function () {
    const currentShift = CurrentShift.getCurrentShift();

    if (!_.get(currentShift, '_id')) {
      FhdMessenger.error('Cần đăng nhập vào ca trực để hoàn đơn hàng');
      return;
    }

    vm.waiting = true;
    OnlineOrderModal.getReason('return').then(data => {
      const reason = data.reason;

      if (!reason) {
        FhdMessenger.error('Chưa có lý do hoàn đơn');
        return;
      }

      vm.onlineOrder.$return({
        outlet: ObjectId.getObjectId(currentShift.outlet),
        date: currentShift.date,
        shift: ObjectId.getObjectId(currentShift.shift),
        reason
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.restore = function () {
    vm.waiting = true;
    vm.onlineOrder.$restore().catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.unconfirm = function () {
    vm.waiting = true;
    vm.onlineOrder.$unconfirm().catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.edit = function () {
    vm.waiting = true;
    vm.onlineOrder.$editSaleEntry().catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.notifyPickUp = function () {
    vm.waiting = true;
    updateOnlineOrder().then(() => {
      return vm.onlineOrder.$notifyPickUp();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.changeStatus = function () {
    if (!_.includes(vm.user.roles, 'admin')) return;
    if (vm.onlineOrder.status === 'created') vm.onlineOrder.status = 'processing';else if (vm.onlineOrder.status === 'processing') vm.onlineOrder.status = 'confirm';else if (vm.onlineOrder.status === 'confirm') vm.onlineOrder.status = 'ready';else if (vm.onlineOrder.status === 'ready') vm.onlineOrder.status = 'done';else if (vm.onlineOrder.status === 'done') vm.onlineOrder.status = 'created';else if (vm.onlineOrder.status === 'cancel') vm.onlineOrder.status = 'processing';else if (vm.onlineOrder.status === 'return') vm.onlineOrder.status = 'processing';
  };

  vm.removeItem = index => {
    if (_.get(vm.calculateItems[index], 'uid')) {
      const uid = vm.calculateItems[index].uid;
      vm.calculateItems = _.reject(vm.calculateItems, item => {
        return item.uid === uid || item.parentUid === uid;
      });
    } else {
      vm.calculateItems.splice(index, 1);
    }

    vm.calculate();
  };

  vm.checkWeight = function () {
    if (vm.onlineOrder.shipping.weight >= 10000) {
      if (!$window.confirm('Số kg bạn nhập vào đang lớn hơn 10kg, bạn có chắc chắn với khối lượng này?')) {
        vm.onlineOrder.shipping.weight = 0;
      }
    }
  };

  vm.calculateFees = function () {
    const noShippingPayProviders = ['Ahamove', 'Lalamove', 'GHTK_2H'];

    if (noShippingPayProviders.includes(_.get(vm.onlineOrder, 'shipping.provider', '')) && !vm.onlineOrder.shipping.pay) {
      vm.onlineOrder.shipping.pay = 0;
    }

    const city = _.get(vm.onlineOrder, 'receiverCustomer.city');

    if (vm.onlineOrder && vm.onlineOrder.orderType !== 'TT' && vm.onlineOrder.orderType !== 'NN') {
      vm.onlineOrder.orderType = OrderTypes.getOrderType(vm.calculateItems, city);
    }

    vm.calculateFeesError = '';

    const orderValue = _.get(vm.onlineOrder, 'orderValue');

    const orderType = _.get(vm.onlineOrder, 'orderType');

    const outlet = _.get(vm.onlineOrder, 'assignedOutlet');

    const frozenFee = vm.frozenFee;

    const district = _.get(vm.onlineOrder, 'receiverCustomer.district');

    const ward = _.get(vm.onlineOrder, 'receiverCustomer.ward');

    return ShippingFee.getExpectedCollect({
      orderValue,
      orderType,
      city,
      shipping: _.get(vm.onlineOrder, 'shipping'),
      payment: _.get(vm.onlineOrder, 'payment'),
      created: _.get(vm.onlineOrder, 'created'),
      deadline: _.get(vm.onlineOrder, 'deadline'),
      district,
      outlet,
      ward
    }).then(({
      shipping,
      payment,
      discountReason
    }) => {
      if (vm.onlineOrder) {
        vm.onlineOrder.shipping.expectedCollect = shipping;
        vm.onlineOrder.payment.expectedCollect = payment;
        vm.onlineOrder.shipping.discountReason = discountReason;
      }

      vm.shippingFee = shipping;
      vm.paymentFee = payment;

      if (!_.isNumber(vm.onlineOrder.shipping.collect)) {
        vm.onlineOrder.shipping.collect = vm.shippingFee;
      }

      if (!_.isNumber(vm.onlineOrder.payment.collect)) {
        vm.onlineOrder.payment.collect = vm.paymentFee;
      }

      vm.totalCollect = orderValue + (_.get(vm.onlineOrder, 'shipping.collect') || shipping || 0) + (parseInt(frozenFee) || 0) + (_.get(vm.onlineOrder, 'payment.collect') || payment || 0) - (vm.onlineOrder.voucher ? vm.onlineOrder.voucher.quantity : 0) - vm.usedPoint * 10;
      vm.getListItems();
      return {
        shipping,
        payment
      };
    }).catch(error => {
      vm.paymentFee = null;
      vm.shippingFee = null;
      vm.totalCollect = orderValue + (_.get(vm.onlineOrder, 'shipping.collect') || 0) + (_.get(vm.onlineOrder, 'payment.collect') || 0) - (vm.onlineOrder.voucher ? vm.onlineOrder.voucher.quantity : 0);
      vm.calculateFeesError = error;
      return {
        payment: vm.paymentFee,
        shipping: vm.shippingFee
      };
    });
  };

  vm.calculate = function () {
    // Giá sỉ bánh kẹo tết
    const lunarCatName = 'Bánh kẹo Tết';
    const valentineCatName = 'Valentine';

    function isDiscountCat(category) {
      return [lunarCatName, valentineCatName].includes(category);
    }

    const totalLunarNewYearItemQuantity = _.sumBy(vm.calculateItems, item => {
      if (_.get(item, 'category.cat.name') === lunarCatName && item.description.includes('1kg')) {
        return item.quantity;
      }

      return 0;
    });

    let availableDiscount = 0;

    if (_.get(vm.onlineOrder, 'customer.isStaff') && moment(vm.onlineOrder.created).isBefore('2023-02-13') && _.some(vm.calculateItems, item => {
      return isDiscountCat(_.get(item, 'category.cat.name'));
    })) {
      availableDiscount = 500000;
    }

    const jarSkus = PromotionService.getJarSkus();

    const totalJarItemValue = _.sumBy(vm.calculateItems, item => {
      if (jarSkus.includes(item.sku)) {
        return item.price * item.quantity;
      }

      return 0;
    }); // Reset to base price


    _.forEach(vm.calculateItems, item => {
      if (item.addGiftItem || item.toLock) return;
      if (item.isShockSale) return;
      if (item.quantity < 0) item.quantity = -item.quantity;

      if (!item.old) {
        if (item.websitePrice) {
          item.soldPrice = item.websitePrice;
        } else {
          item.soldPrice = item.salePrice || item.originalPrice;
        }

        item.discount = 0;
        item.onSale = item.soldPrice < item.originalPrice;
        item.isWholesale = SaleEntryService.getIsWholesale(item);
      }

      if (_.isFinite(item.maxQuantityPerOnlineOrder) && item.maxQuantityPerOnlineOrder > 0 && item.quantity > item.maxQuantityPerOnlineOrder) {
        FhdMessenger.error(`Sản phẩm ${item.description} bán tối đa số lượng là ${item.maxQuantityPerOnlineOrder}.`);
        item.quantity = item.maxQuantityPerOnlineOrder;
      }

      if (isDiscountCat(_.get(item, 'category.cat.name'))) {
        const discount = Math.min(item.price * 0.3 * item.quantity, availableDiscount);

        if (discount > 0) {
          item.soldPrice = (item.price * item.quantity - discount) / item.quantity;
          availableDiscount -= discount;
          item.onSale = true;
        }
      }

      if (item.hasSaltedEgg) {
        item.soldPrice += 10000;
      }
    });

    const itemQuantityMap = _.reduce(vm.calculateItems, (result, item) => {
      result[item.sku] = result[item.sku] || 0;
      result[item.sku] += item.quantity;
      return result;
    }, {});

    _.forEach(vm.calculateItems, function (item) {
      if (item.addGiftItem || item.toLock) return;
      if (item.isShockSale) return;

      const region = _.get(vm.onlineOrder, 'assignedOutlet.region', 'NORTH');

      item.nearestBundlePrice = null;
      const bundlePrices = BundlePricesService.getBundlePrices(item, region, null, vm.onlineOrder.source);
      let totalQuantity = itemQuantityMap[item.sku];

      if (_.get(item, 'category.cat.name') === lunarCatName && item.description.includes('1kg')) {
        totalQuantity = totalLunarNewYearItemQuantity;
      }

      item = BundlePricesService.processBundlePrices({
        item,
        bundlePrices,
        totalQuantity,
        totalJarItemValue,
        jarSkus
      }); // Find the bundlePrice with the least quantity of all bundlePrices but also greater than item.quantity

      item.nearestBundlePrice = BundlePricesService.getNearestBundlePrices({
        item,
        bundlePrices,
        totalQuantity
      });
    });

    _.forEach(vm.calculateItems, item => {
      item.lineTotal = item.soldPrice * item.quantity;
    });

    vm.calculateItems = PromotionService.processMoonCakeDiscount(vm.calculateItems, _.get(vm.onlineOrder, 'customer.isStaff'));

    if (vm.onlineOrder.orderType === 'ORDER') {
      vm.calculateItems = PromotionService.getSpecialDayPromotion(vm.calculateItems, vm.onlineOrder.deadline);
      vm.calculateItems = PromotionService.processPromotionLunarNewYear(vm.calculateItems);
      vm.calculateItems = PromotionService.getDiscountAlmostExpiredCake({
        items: vm.calculateItems,
        deadline: vm.onlineOrder.deadline,
        deliverStartTime: vm.onlineOrder.deliverStartTime
      });
    }

    SaleCampaignService.processSaleCampaigns(vm.calculateItems, _.get(vm.onlineOrder, 'customer.saleCampaigns')); // // Sale shock price handling
    // if (_.get(vm.onlineOrder, 'customer.customerId', '').match(/^C\w\d{7}/)) {

    const {
      numShockPriceItems,
      shockPriceMessage,
      shockPriceItems
    } = PromotionService.processShockSalePrice(vm.calculateItems, vm.assignedOutlet);
    vm.numShockPriceItems = numShockPriceItems;
    vm.shockPriceMessage = shockPriceMessage;
    vm.calculateItems = shockPriceItems;
    const {
      monthlyShockPriceItems
    } = PromotionService.processMonthlyShockSalePrice(vm.calculateItems, vm.assignedOutlet);
    vm.calculateItems = monthlyShockPriceItems;
    vm.subTotal = 0;

    _.forEach(vm.calculateItems, item => {
      item.lineTotal = item.soldPrice * item.quantity - (item.discount || 0);
      vm.subTotal += item.lineTotal;
    });

    vm.onlineOrder.orderValue = vm.subTotal;
    vm.disableTexts = OnlineOrderService.checkDisableCakeTexts(vm.calculateItems);

    if (vm.disableTexts) {
      vm.onlineOrder.textInBase = '';
      vm.onlineOrder.textInCake = '';
    }

    vm.calculateFees();
  };

  vm.getListItems = function () {
    vm.listItems = `Mã đơn hàng ${vm.onlineOrder.onlineOrderId}\n`;
    vm.listItems += _.reduce(vm.calculateItems, (result, item) => {
      let content = `${item.sku} ${item.description} ${item.cakeFillingType ? `Hương vị ${item.cakeFillingType} ` : ''}: ${$filter('number')(item.soldPrice, 0)} x ${item.quantity} ${item.discount ? '- ' + $filter('number')(item.discount, 0) + ' ' : ''}= ${$filter('number')(item.lineTotal, 0)}\n`;

      if (item.sku === 'V1408') {
        _.forEach(item.bundledProducts, product => {
          content += `- ${product.sku} ${product.description}\n`;
        });
      }

      result += content;
      return result;
    }, '');
    vm.listItems += `Thành tiền: ${$filter('number')(vm.onlineOrder.orderValue, 0)}\n`;
    vm.voucherQuantity = _.get(vm.onlineOrder, 'voucher.quantity', 0);

    if (vm.onlineOrder.voucher && vm.voucherQuantity) {
      vm.listItems += `Voucher: ${vm.onlineOrder.voucher.name} - ${vm.voucherQuantity}\n`;
    }

    if (vm.usedPoint) {
      vm.listItems += `Điểm đã sử dụng: ${vm.usedPoint}\n`;
    }

    const shippingCollect = _.get(vm.onlineOrder, 'shipping.collect', vm.shippingFee);

    if (vm.onlineOrder.orderType === 'ORDER') {
      vm.listItems += `Tiền ship: ${$filter('number')(shippingCollect, 0)}\n`;
      vm.depositAmount = _.sumBy(vm.onlineOrder.deposits, 'amount');

      if (vm.depositAmount > 0) {
        vm.listItems += `Tiền cọc đã trả: ${$filter('number')(vm.depositAmount, 0)}\n`;
      }

      vm.listItems += `Tổng thu tiền hàng: ${$filter('number')(vm.onlineOrder.orderValue + shippingCollect - vm.voucherQuantity - vm.depositAmount, 0)}\n`;

      if (vm.cakeTotal) {
        const textInCakeFinal = vm.onlineOrder.textInCake || '<<Không có chữ viết trên mặt bánh>>';
        vm.listItems += `Chữ viết trên mặt bánh: ${textInCakeFinal}\n`;
        const textInBaseFinal = vm.onlineOrder.textInBase || '<<Không có chữ viết trên đế bánh>>';
        vm.listItems += `Chữ viết trên đế bánh: ${textInBaseFinal}\n`;
      }

      if (vm.onlineOrder.requestCard && vm.onlineOrder.requestCardContent) {
        vm.listItems += `Nội dung thiệp đính kèm: ${vm.onlineOrder.requestCardContent}\n`;
      }

      vm.listItems += `Số điện thoại người nhận: ${vm.onlineOrder.receiverCustomer.cellphone}\n`;
      vm.listItems += `Địa chỉ nhận bánh: ${vm.onlineOrder.receiverCustomer.street}, ` + `${vm.onlineOrder.receiverCustomer.ward}, ` + `${vm.onlineOrder.receiverCustomer.district}, ` + `${vm.onlineOrder.receiverCustomer.city}\n`;
      vm.listItems += `Thời gian giao: ${moment(vm.onlineOrder.deadline).format('DD/MM dddd')} từ ${moment(vm.onlineOrder.deliverStartTime).format('HH:mm')} đến ${moment(vm.onlineOrder.deliverEndTime).format('HH:mm')}\n`;
      vm.listItems += `Hình thức thanh toán: ${vm.onlineOrder.payment.method === 'transfer' ? 'Chuyển khoản' : _.upperCase(vm.onlineOrder.payment.method)}\n`;
    } else {
      vm.listItems += `Tổng thu tiền hàng: ${$filter('number')(vm.onlineOrder.orderValue - vm.voucherQuantity - vm.usedPoint * 10, 0)}\n`;
      vm.listItems += `Đây là đơn hàng tạm thời, sẽ có thể thay đổi tùy vào tình hình hàng tồn và sẽ được chốt khi nhân viên Abby gọi điện thoại trực tiếp.\n`;
    }

    if (vm.onlineOrder.orderNote) {
      vm.listItems += `Ghi chú: ${vm.onlineOrder.orderNote}`;
    }
  };

  function createVoucherLink(onlineOrder) {
    if (onlineOrder.voucherToken) {
      vm.voucherLink = `https://savor.vn/get-voucher/?voucherToken=${onlineOrder.voucherToken}`;
    }
  }

  function printAddress() {
    const printer = JsPrintService.getActivePrinter();
    const printContents = $window.document.getElementById('print-address').innerHTML;
    const popupWin = $window.open('');
    const origin = `${$location.protocol()}://${$location.host()}${$location.port() !== 80 ? `:${$location.port()}` : ''}`;
    popupWin.document.open();
    popupWin.document.write(`<!DOCTYPE html>
        <head>
          <meta charset="utf-8">
          <meta http-equiv="Content-type" content="text/html;charset=UTF-8">
          <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
          <link rel="stylesheet" type="text/css" href="${origin}/lib/bootstrap/dist/css/bootstrap.css"/>
          <link rel="stylesheet" type="text/css" href="${origin}/modules/online-orders/css/online-orders.css"/>
        </head>
        <body>
        <script type="text/javascript" src="${origin}/lib/jquery/dist/jquery.min.js"></script>
        ${printContents}
        <script>
        $(function(){
          if (window.jsPrintSetup)  {
            jsPrintSetup.setPrinter('${printer}')

            // set top margins in millimeters
            jsPrintSetup.setOption('marginTop', 0);
            jsPrintSetup.setOption('marginRight', 0);
            jsPrintSetup.setOption('marginLeft', 0);

            // set empty page footer
            jsPrintSetup.setOption('footerStrLeft', '');
            jsPrintSetup.setOption('footerStrRight', '');
            jsPrintSetup.setOption('footerStrCenter', '');

            jsPrintSetup.clearSilentPrint();

            // Suppress print dialog
            jsPrintSetup.setSilentPrint(false); /** Set silent printing */
            // Do Print
          }
        })
        </script>
        </body>
        </html>`);
    popupWin.document.close();
  }

  vm.printAddress = function () {
    updateDistrict();
    vm.fullAddress = `${_.get(vm.onlineOrder, 'receiverCustomer.street')}, ${_.get(vm.onlineOrder, 'receiverCustomer.district')}, ${_.get(vm.onlineOrder, 'receiverCustomer.city')}`;

    if (!_.get(vm.onlineOrder, 'shipping.service') || !_.get(vm.onlineOrder, 'shipping.provider') || !_.isFinite(_.get(vm.onlineOrder, 'payment.collect')) || !_.isFinite(_.get(vm.onlineOrder, 'shipping.collect')) || !_.get(vm.onlineOrder, 'shipping.calculatedWeight')) {
      FhdMessenger.error('Còn thiếu thông tin về đơn hàng');
      return;
    }

    $timeout(printAddress, 10);
  };

  function convertQrCodeSaleEntryToImage() {
    const qrCodeCanvas = $document[0].querySelector('#qrcode > canvas');
    if (!qrCodeCanvas) return;
    let img = $document[0].createElement('img');
    img.src = qrCodeCanvas.toDataURL('image/png');
    const qrCode = $document[0].querySelector('#qrcode');
    qrCode.removeChild(qrCodeCanvas);
    qrCode.appendChild(img);
  }

  vm.printOnlineOrder = () => {
    if ($window.Cypress) return;
    const customStyle = true;
    const autoPrint = true;
    convertQrCodeSaleEntryToImage();
    JsPrintService.printElementById('receipt-table', autoPrint, customStyle);
  };

  vm.now = function () {
    return moment().format('MM-DD HH:mm');
  };

  const getOutletProperty = ProductService.getOutletProperty;

  vm.addProduct = function () {
    const item = vm.product;

    if (item.sku === 'V1408') {
      PromotionService.openComboModal(item).result.then(selectedItems => {
        const cogs = _.reduce(selectedItems, (result, selectedItem) => {
          return result + _.get(selectedItem, 'item.cogs', 0) * _.get(selectedItem, 'quantity', 1);
        }, 0);

        const price = Math.floor(_.sumBy(selectedItems, item => {
          return _.get(item, 'item.price', 0) * item.quantity;
        }) * 0.75 / 10000) * 10000;

        const newItem = _.assign({}, item, {
          product: item._id,
          quantity: item.needQuantity ? 0 : 1,
          price: price,
          originalPrice: price,
          soldPrice: price,
          lineTotal: price,
          discount: 0,
          cogs,
          isCombo: true,
          bundledProducts: _.map(selectedItems, selectedItem => ({
            product: _.get(selectedItem, 'item._id'),
            sku: _.get(selectedItem, 'item.sku'),
            description: _.get(selectedItem, 'item.description'),
            quantity: _.get(selectedItem, 'quantity')
          })),
          toLock: true
        });

        vm.calculateItems.push(newItem);
        vm.calculate();
      });
      return;
    }

    if (item.saleCode) {
      return FhdMessenger.error('Vui lòng chỉ nhập sale code ở bước tạo sale entry');
    }

    if (vm.onlineOrder.orderType === 'TT' && !item.description.match(/^Bánh nướng/) && !item.description.match(/^Bánh dẻo/) && !item.description.match(/^Set 6 bánh 50g/) && !item.description.match(/^Set 4 bánh 150g/)) {
      return FhdMessenger.error('Sản phẩm không thuộc danh sách bánh trung thu');
    }

    vm.calculateItems = vm.calculateItems || [];

    const matchItemIndex = _.findIndex(vm.calculateItems, currentItem => {
      if (currentItem.cakeFillingType) {
        return currentItem.cakeFillingType === item.cakeFillingType && currentItem.sku === item.sku;
      }

      if (currentItem.refId) {
        return currentItem.refId === item.refId || currentItem.refId === item.sku;
      }

      return currentItem.sku === item.sku;
    });

    if (matchItemIndex > -1 && !vm.calculateItems[matchItemIndex].toLock && !vm.calculateItems[matchItemIndex].addGiftItem) {
      if (item.quantityFromBarcode) {
        vm.calculateItems[matchItemIndex].quantity += item.quantity;
      } else if (item.needQuantity) {
        vm.calculateItems[matchItemIndex].quantity = 0;
      } else {
        vm.calculateItems[matchItemIndex].quantity += 1;
      }
    } else {
      let salePrice = getOutletProperty('salePrice', vm.onlineOrder.assignedOutlet, item, vm.onlineOrder.source);
      const price = getOutletProperty('price', vm.onlineOrder.assignedOutlet, item, vm.onlineOrder.source);
      const cogs = getOutletProperty('cogs', vm.onlineOrder.assignedOutlet, item);

      if (salePrice >= price) {
        salePrice = null;
      }

      let warehouseRestock = item.warehouseRestock;

      if (!warehouseRestock) {
        OutletService.findOutletFromCode('OFFICE').then(outlet => {
          warehouseRestock = outlet;
        });
      }

      const newItem = _objectSpread({}, item, {
        salePrice,
        price,
        originalPrice: price,
        cogs
      });

      vm.calculateItems.push(newItem);
    }

    vm.calculate();
  };

  vm.viewSaleEntry = SaleEntryService.viewSaleEntry;

  const notifyUpdate = _.throttle(() => FhdMessenger.info('Đơn được cập nhật. Đang tải lại.'), 5000, {
    trailing: false
  });

  const listenUpdateOnlineOrder = function (onlineOrder) {
    if (!onlineOrder) return;

    if (onlineOrder._id === vm.onlineOrder._id) {
      notifyUpdate();
      vm.findOne();
    } else if (_.get(onlineOrder.receiverCustomer, 'cellphone') === _.get(vm.onlineOrder.receiverCustomer, 'cellphone')) {
      FhdMessenger.info(`1 đơn hàng của khách ${_.get(vm.onlineOrder.receiverCustomer, 'name')} từ cơ sở ${onlineOrder.assignedOutlet.code} vừa được tạo`);
      vm.findOne();
    }
  };

  vm.calulateCalculatedWeight = function () {
    vm.onlineOrder.shipping.calculatedWeight = CalculateService.calculateWeight(vm.onlineOrder);
  };

  vm.autoFillForViettelProvider = () => {
    vm.onlineOrder.shipping.billNumber = `ABBY${vm.onlineOrder.onlineOrderId}`;
  };

  vm.createComplaint = ComplaintService.openCreateComplaintModal;

  vm.changedCheckedAll = () => {
    _.forEach(vm.calculateItems, item => {
      item.customerOrder = vm.customerOrder;
    });

    vm.changeChecked();
  }; // vm.changeChecked = () => {
  //   vm.showCreateStockEntry = _.some(vm.calculateItems, 'customerOrder')
  // }


  vm.inputShippingCollect = async () => {
    vm.onlineOrder.shipping.collect = await parseInt($window.prompt('Nhập phí ship thu KH:'));
    vm.calculateFees();
  };

  vm.changeFrozenFee = _.debounce(() => {
    let index = _.findIndex(vm.onlineOrder.fees, {
      type: 'FROZEN_SHIPPING'
    });

    vm.onlineOrder.fees.splice(index, 1, {
      value: vm.frozenFee,
      type: 'FROZEN_SHIPPING',
      description: 'Ship hàng lạnh'
    });
    vm.calculateFees();
  }, 500);
  Sockets.on('updateOnlineOrder', listenUpdateOnlineOrder);
  $scope.$on('$destroy', function () {
    Sockets.removeListener('updateOnlineOrder', listenUpdateOnlineOrder);
  });
  vm.sendAccountNumBank = OnlineOrderModal.openAccountNumBank;
}]);
'use strict';

angular.module('online-orders').directive('fhdOnlineOrderSource', [function () {
  return {
    restrict: 'EA',
    scope: {
      onlineOrder: '=',
      value: '='
    },
    template: `<a
      ng-href="{{ onlineOrder.originalLink }}"
      target="_blank"
      class="label"
      ng-class="{
      'label-info': onlineOrder.source === 'facebook',
      'label-danger': onlineOrder.source === 'abby.vn',
      'label-primary': onlineOrder.source === 'shopee',
      'label-ready': onlineOrder.source === 'tiktok',
      'label-warning': onlineOrder.source === 'app',
      'label-default': onlineOrder.source === 'phone',
      'label-success': onlineOrder.source === 'savor.vn'
    }"
      >{{value}}</a
    >`
  };
}]);
'use strict';

angular.module('online-orders').directive('fhdOnlineOrderStatus', [function () {
  return {
    restrict: 'EA',
    scope: {
      status: '=',
      onlineOrderId: '='
    },
    template: `<a target="_blank" ui-sref="viewOnlineOrder({onlineOrderId:onlineOrderId})"  class="label" ng-class="{
        'label-primary': status === 'created',
        'label-default': status === 'processing',
        'label-info': status === 'confirm',
        'label-warning': status === 'cancel',
        'label-danger': status === 'return',
        'label-ready': status === 'ready',
        'label-success': status === 'done'
      }">{{status}}</a>`
  };
}]);
'use strict';

angular.module('online-orders').factory('OnlineOrderModal', ['$modal', function ($modal) {
  return {
    view: onlineOrder => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/view-online-order-modal.client.template.html',
      controller: 'ViewOnlineOrderModalController',
      controllerAs: 'vm',
      backdrop: 'static',
      windowClass: 'modal-online-order',
      size: 'lg',
      resolve: {
        onlineOrder: () => onlineOrder
      }
    }).result,
    create: orderType => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/create-online-order-modal.client.template.html',
      controller: 'CreateOnlineOrderModalController',
      controllerAs: 'vm',
      backdrop: 'static',
      windowClass: 'modal-online-order',
      resolve: {
        orderType: () => orderType
      },
      size: 'lg'
    }).result,
    getReason: (type, items) => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/get-reason-modal.client.template.html',
      controller: 'GetReasonModalController',
      controllerAs: 'vm',
      resolve: {
        type: () => type,
        items: () => items
      }
    }).result,
    openAccountNumBank: (totalCollect, onlineOrderId) => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/modal-send-account-num-bank.client.html',
      controller: 'AccountNumBankModalController',
      controllerAs: 'vm',
      resolve: {
        totalCollect: () => totalCollect,
        onlineOrderId: () => onlineOrderId
      }
    }).result,
    openModalSelectCakeFillingType: item => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/modal-select-cake-filling-type.client.html',
      controller: 'ModalSelectCakeFillingTypeController',
      controllerAs: 'vm',
      resolve: {
        item: () => item
      }
    }).result,
    openModalSelectVariants: item => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/modal-select-variants.client.view.html',
      controller: 'ModalSelectVariantsController',
      controllerAs: 'vm',
      resolve: {
        item: () => item
      }
    }).result,
    openModalSelectManufacturingDate: item => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/modal-select-manufacturing-date.client.html',
      controller: 'ModalSelectManufacturingDateController',
      controllerAs: 'vm',
      resolve: {
        item: () => item
      }
    }).result,
    openChangeAssignedOutletModal: onlineOrder => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/modal-change-assign-outlet-client.template.html',
      controller: 'ModalChangeAssignedOutletController',
      size: 'lg',
      controllerAs: 'vm',
      resolve: {
        onlineOrder: () => onlineOrder
      }
    }),
    openChangeCakeDeadlineModal: onlineOrder => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/modal-change-cake-deadline.client.template.html',
      controller: 'ModalChangeCakeDeadlineController',
      size: 'small',
      controllerAs: 'vm',
      resolve: {
        onlineOrder: () => onlineOrder
      }
    }),
    openConfirmInfoModal: onlineOrder => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/modal-confirm-info.client.template.html',
      controller: 'ModalConfirmInfoController',
      size: 'lg',
      backdrop: 'static',
      windowClass: 'modal-online-order',
      controllerAs: 'vm',
      resolve: {
        onlineOrder: () => onlineOrder
      }
    }),
    openQRModal: onlineOrder => $modal.open({
      animation: true,
      templateUrl: '/modules/online-orders/templates/modal-qr-code.client.template.html',
      controller: 'ModalQRController',
      size: 'md',
      controllerAs: 'vm',
      resolve: {
        onlineOrder: () => onlineOrder
      }
    })
  };
}]);
"use strict";

angular.module('online-orders').factory('OnlineOrderService', ['Address', 'OnlineOrderModal', 'CalculateService', '$http', 'helper', function (Address, OnlineOrderModal, CalculateService, $http, helper) {
  const womenDay = '08/03';
  const specialDates = [womenDay];
  const sources = [{
    value: 'facebook',
    name: 'Facebook',
    label: 'label-info',
    business: 'both'
  }, {
    value: 'abby.vn',
    name: 'Abby.vn',
    label: 'label-warning',
    business: 'abby'
  }, {
    value: 'phone',
    name: 'Điện thoại',
    label: 'label-default',
    business: 'both'
  }, {
    value: 'shopee',
    name: 'Shopee',
    label: 'label-primary',
    business: 'abby'
  }, {
    value: 'tiktok',
    name: 'Tiktok',
    label: 'label-ready',
    business: 'abby'
  }, {
    value: 'savor.vn',
    name: 'Savor.vn',
    label: 'label-success',
    business: 'savor'
  }, {
    value: 'app',
    business: 'abby'
  }];
  const statuses = ['created', 'processing', 'confirm', 'ready', 'done', 'cancel', 'return'];
  const sharedData = {
    districts: Address.getDistricts(),
    paymentMethods: [{
      value: 'cod',
      label: 'COD'
    }, {
      value: 'transfer',
      label: 'Chuyển khoản'
    }],
    depositValues: ['50000', '100000', 'Khác']
  };

  const includeInSpecialDates = onlineOrder => {
    return _.some(specialDates, specialDate => {
      return moment(onlineOrder.deadline).format('DD/MM') === specialDate;
    });
  };

  return {
    calculateKPIs(KPIsquery) {
      return $http.get('online-orders/calculate-KPIs', {
        params: KPIsquery
      }).then(response => response.data);
    },

    getProcessingSummary() {
      return $http.get('/online-orders/get-processing-summary').then(response => response.data);
    },

    getSharedData() {
      return sharedData;
    },

    getStatuses() {
      return statuses;
    },

    getSources(orderType) {
      if (orderType === 'ORDER') {
        return _.filter(sources, source => {
          return ['both', 'savor'].includes(source.business);
        });
      } else {
        return _.filter(sources, source => {
          return ['both', 'abby'].includes(source.business);
        });
      }
    },

    getLabelFromStatus(status) {
      const labelStatusMap = {
        created: 'label-primary',
        processing: 'label-default',
        confirm: 'label-info',
        cancel: 'label-warning',
        return: 'label-danger',
        ready: 'label-ready',
        done: 'label-success',
        taken: 'label-info',
        delivered: 'label-info',
        received: 'label-success',
        lost: 'label-danger',
        deleted: 'label-default',
        disabled: 'label-warning',
        active: 'label-success',
        inactive: 'label-warning'
      };
      return _.get(labelStatusMap, status, 'label-default');
    },

    getCakeTotal(items) {
      return _.sumBy(items, item => {
        if (item.sku === 'V1408') {
          return item.quantity * 2;
        }

        if (_.get(item, 'category.cat') === '625ce6e71fac7f5be7c2c9f5') {
          return item.quantity;
        }
      });
    },

    getAddOnTotal(items) {
      return _.sumBy(items, item => {
        if (_.get(item, 'category.cat') === '62c4d2bd8512ab02048d59e0') {
          return item.quantity;
        }

        return 0;
      });
    },

    getPaymentMethodByShippingProvider(value) {
      let defaultValues = [{
        value: 'cod',
        label: 'COD'
      }, {
        value: 'transfer',
        label: 'Chuyển khoản'
      }];

      if (value === 'Giao tại cửa hàng') {
        return _.concat(defaultValues, [{
          value: 'momo',
          label: 'MoMo'
        }, {
          value: 'shopeepay',
          label: 'ShopeePay'
        }, {
          value: 'vnpay',
          label: 'VNPay'
        }]);
      }

      return defaultValues;
    },

    getFillingTypeSkus() {
      return ['V1444', 'V1445', 'V1496', 'V1536', 'V1537', 'V1538'];
    },

    getNeedPhotoSkus() {
      return ['V1852', 'V1867', 'V1882'];
    },

    checkValentine(onlineOrder) {
      return _.some(onlineOrder.items, item => {
        return ['V2204', 'V2205'].includes(item.sku);
      });
    },

    openModalSelectVariants(data) {
      let {
        item,
        items,
        assignedOutlet,
        source
      } = data;
      return OnlineOrderModal.openModalSelectVariants(item).then(variants => {
        // Xóa các sản phẩm con (nếu có) và reset sản phẩm cha
        if (_.get(item, 'uid')) {
          items = _.reject(items, product => {
            return product.parentUid === item.uid;
          });
          item = _.omitBy(_.assign({}, item, {
            uid: undefined,
            variants: undefined,
            toLock: undefined
          }), _.isNil);
        } // Xóa sản phẩm cha cũ


        const itemIndex = _.findIndex(items, item);

        items.splice(itemIndex, 1);

        if (!variants.length) {
          items = CalculateService.addProduct({
            inputItem: item,
            items: items,
            assignedOutlet,
            source,
            addIndex: itemIndex
          });
          return items;
        }

        const uid = moment().valueOf();
        item.uid = uid; // Trường hợp sản phẩm cha số lượng > 1

        if (item.quantity > 1) {
          const dividedItem = _.omitBy(_.assign({}, angular.copy(item), {
            uid: undefined,
            quantity: item.quantity - 1
          }), _.isNil);

          item.quantity = 1;
          items = CalculateService.addProduct({
            inputItem: dividedItem,
            items: items,
            assignedOutlet,
            source,
            addIndex: itemIndex
          });
        }

        item = _.assign({}, item, {
          variants,
          toLock: true
        }); // Thêm sản phẩm cha mới

        items = CalculateService.addProduct({
          inputItem: item,
          items: items,
          assignedOutlet,
          source,
          addIndex: itemIndex
        }); // Thêm các sản phẩm con

        _.forEach(variants, variant => {
          let product = _.get(variant, 'product');

          if (!product) {
            return;
          }

          product = _.assign({}, product, {
            parentUid: uid,
            toLock: true,
            product: product._id,
            quantity: _.isNumber(product.quantity) ? product.quantity : 1,
            originalPrice: product.price,
            salePrice: product.salePrice,
            soldPrice: product.salePrice ? product.salePrice : product.price,
            lineTotal: product.salePrice ? product.salePrice : product.price
          });
          items = CalculateService.addProduct({
            inputItem: product,
            items: items,
            assignedOutlet,
            source,
            addIndex: itemIndex + 1
          });
        });

        return items;
      });
    },

    checkWomenDay(onlineOrder) {
      if (!onlineOrder.deadline || onlineOrder.orderType !== 'ORDER') {
        return false;
      }

      return onlineOrder.deadline && moment(onlineOrder.deadline).format('DD/MM') === womenDay;
    },

    checkDisableCakeTexts(items) {
      const disableTextsSKUs = ['V2250', 'V2251', 'V2252', 'V2253', 'V2254', 'V2255'];

      const onlineOrderItemSKUs = _.map(items, 'sku');

      return _.every(onlineOrderItemSKUs, onlineOrderItemSKU => {
        return _.includes(disableTextsSKUs, onlineOrderItemSKU);
      });
    },

    getTotalValue(onlineOrder) {
      if (!onlineOrder) return;

      if (onlineOrder.payment.method !== 'cod') {
        return 0;
      }

      let voucherQuantity = _.get(onlineOrder, 'voucher.quantity', 0);

      let shippingCollect = _.get(onlineOrder, 'shipping.collect', 0);

      let depositAmount = _.sumBy(onlineOrder.deposits, 'amount');

      return onlineOrder.orderValue + shippingCollect - voucherQuantity - depositAmount;
    },

    validate(onlineOrder) {
      const orderType = onlineOrder.orderType;

      const checkNotCakeOrder = isNew => {
        if (isNew) {
          return !onlineOrder.isCakeOrder;
        }

        return orderType && orderType !== 'ORDER';
      };

      const paymentMethod = _.get(onlineOrder, 'payment.method');

      const paymentCode = _.get(onlineOrder, 'payment.code');

      return {
        validateShip() {
          if (['Ahamove', 'Lalamove'].includes(_.get(onlineOrder, 'shipping.provider'))) {
            if (!_.get(onlineOrder, 'shipping.billNumber')) {
              return 'Chưa có mã đơn Lalamove/Ahamove';
            }

            if (_.get(onlineOrder, 'shipping.provider') === 'Lalamove') {
              if (!_.get(onlineOrder, 'shipping.billNumber').match(/(^\w{18}$|^\w{10}$|^\w{12}$)/)) {
                return 'Mã vận đơn Lalamove chỉ gồm 10, 12, 18 ký tự chữ cái hoặc số';
              }
            }
          } // if (['Viettel'].includes(_.get(onlineOrder, 'shipping.provider', ''))) {
          //   if (!onlineOrder.shipping.containerImages.length) {
          //     return 'Chưa có ảnh thùng hàng'
          //   }
          //   if (
          //     _.get(onlineOrder, 'shipping.containerImages.length', 0) <
          //     _.get(onlineOrder, 'shipping.containerQuantity', 0)
          //   ) {
          //     return 'Số lượng ảnh phải lớn hơn hoặc bằng số lượng thùng hàng'
          //   }
          // }

        },

        validateCakeDeposit({
          chooseFillingTypeSkus,
          isNew,
          status,
          orderValue,
          shippingFee
        }) {
          if (status === 'done') {
            return;
          }

          if (checkNotCakeOrder(isNew)) {
            return;
          }

          if (paymentMethod !== 'cod') {
            return;
          }

          if (_.some(_.get(onlineOrder, 'items'), item => {
            return chooseFillingTypeSkus.includes(item.sku) || _.get(item, 'category.cat.name') === 'Bánh sinh nhật' && item.description.match(/(cỡ|size) (nhỏ|vừa)/gim);
          })) {
            let checkDeposit = _.sumBy(_.get(onlineOrder, 'deposits'), 'amount');

            if (isNew) {
              checkDeposit = _.get(onlineOrder.deposit, 'amount');
            }

            const minDeposit = Math.min(50000, orderValue + (shippingFee || 0));

            if (!(checkDeposit >= minDeposit)) {
              let err = `Đơn bánh vẽ, order và cỡ nhỏ/vừa phải đặt cọc tiền trước tối thiểu 50k`;
              if (minDeposit < 50000) err += `. Riêng đơn này là ${minDeposit / 1000}k nhé`;
              return err;
            }
          }
        },

        validateDepositAmount(depositAmount, deposit, isNew) {
          if (checkNotCakeOrder(isNew)) {
            return;
          }

          if (depositAmount && !_.get(deposit, 'amount')) {
            return 'Bạn chưa điền số tiền cọc thực tế';
          }
        },

        validatePaymentCode() {
          if (_.includes(['created', 'done'], onlineOrder.status) || !_.get(onlineOrder, 'status')) {
            return;
          }

          if (_.includes(['transfer', 'momo', 'shopeepay', 'vnpay'], paymentMethod) && !paymentCode) {
            return 'Bạn chưa điền nội dung chuyển khoản/mã giao dịch';
          }
        },

        validateDeliveryTime() {
          if (onlineOrder.status === 'done') {
            return false;
          }

          if (moment(onlineOrder.deliverStartTime).hour() < 7 || moment(onlineOrder.deliverStartTime).hour() > 23) {
            return 'Thời gian khách nhận hàng ngoài thời gian làm việc, bạn kiểm tra lại giờ giao hàng nhé.';
          }

          const diffTime = moment(onlineOrder.deliverEndTime).startOf('minute').diff(moment(onlineOrder.deliverStartTime).startOf('minute'), 'minute', true);

          if (diffTime < 0) {
            return 'Thời gian bắt đầu không được sau thời gian kết thúc';
          }

          if (includeInSpecialDates(onlineOrder)) {
            if (diffTime < 60) {
              return 'Khoảng thời gian giao hàng phải tối thiểu 1 tiếng';
            }

            return;
          }

          if (diffTime !== 60) {
            return 'Khoảng thời gian giao hàng phải cách nhau đúng 1 tiếng';
          }
        },

        validateTransferOnly() {
          const isOnTransferOnlyDay = includeInSpecialDates(onlineOrder);

          if (!isOnTransferOnlyDay) {
            return;
          }

          if (paymentMethod === 'transfer') {
            return;
          }

          return `Chỉ áp dụng PTTT Chuyển khoản khi ngày giao là ${moment(onlineOrder.deadline).format('DD/MM')}`;
        },

        validateSpecialSkusOnSpecialDays(specialSkus, specialDayStart, specialDayEnd) {
          const deliverStartTime = helper.combineTimeAndDate(moment(onlineOrder.deadline).toDate(), moment(onlineOrder.deliverStartTime).toDate());

          if (!moment(deliverStartTime).isBetween(moment(specialDayStart), moment(specialDayEnd))) {
            return;
          }

          const itemSkus = _.map(_.filter(onlineOrder.items, item => {
            return _.get(item, 'category.cat.name') === 'Bánh sinh nhật';
          }), 'sku');

          const invalidSkus = _.reject(itemSkus, itemSku => {
            return _.includes(_.concat(specialSkus), itemSku);
          });

          if (!invalidSkus.length) {
            return;
          }

          return `Các mã: ${_.join(invalidSkus, ', ')} không được mở bán vào ngày ${moment(deliverStartTime).format('DD/MM')}`;
        }

      };
    }

  };
}]);
'use strict'; // Orders service used to communicate OnlineOrders REST endpoints

