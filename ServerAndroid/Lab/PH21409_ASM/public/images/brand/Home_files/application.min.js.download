      url: 'stock-entries/:stockEntryId/update-return'
    },
    updateRecyclePlTask: {
      method: 'POST',
      url: 'stock-entries/:stockEntryId/update-recycle-pl-task'
    },
    softRemove: {
      method: 'PUT',
      url: 'stock-entries/:stockEntryId/soft-remove'
    },
    split: {
      method: 'PUT',
      url: 'stock-entries/:stockEntryId/split'
    },
    search: {
      method: 'GET',
      url: 'stock-entries/search'
    },
    checkNotScanned: {
      method: 'GET',
      url: 'stock-entries/check-not-scanned'
    },
    changeBuyingEntry: {
      method: 'PUT',
      url: 'stock-entries/:stockEntryId/change-buying-entry'
    },
    fromPlTask: {
      method: 'GET',
      url: 'stock-entries/from-pl-task',
      isArray: true
    },
    getUnreceivedStockEntries: {
      method: 'GET',
      url: 'stock-entries/unreceived-stock-entries',
      isArray: true
    },
    getLosted: {
      method: 'GET',
      url: '/stock-entries/list-losted',
      isArray: true
    },
    getRotationStockEntries: {
      method: 'GET',
      url: 'stock-entries/get-rotation',
      isArray: true
    },
    enoughItems: {
      method: 'PUT',
      url: '/stock-entries/:stockEntryId/enough-items'
    },
    confirmMulti: {
      method: 'POST',
      url: '/stock-entries/confirm-multi',
      isArray: true
    },
    explain: {
