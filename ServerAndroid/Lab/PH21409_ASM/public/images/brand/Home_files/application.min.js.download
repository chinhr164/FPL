angular.module('users').filter('salaryPosition', ['SalariesService', function (SalariesService) {
  const positions = SalariesService.getPositions();

  const positionMap = _.reduce(positions, (result, position) => {
    result[position.value] = position;
    return result;
  }, {});

  return function (input) {
    const position = positionMap[input];
    return _.get(position, 'name', input);
  };
}]);
