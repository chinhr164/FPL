angular.module('work-tasks').controller('ImportQCWorkTasksController', ['Authentication', 'WorkTasks', 'FhdMessenger', '$http', '$location', '$state', 'ConfirmModal', function (Authentication, WorkTasks, FhdMessenger, $http, $location, $state, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;

  vm.import = () => {
    if (!vm.googleSheetLink) {
      return FhdMessenger.error('Bạn chưa điền link google sheet');
    }

    if (!_.includes(vm.googleSheetLink, 'https://docs.google.com/spreadsheets/d/')) {
      return FhdMessenger.error('Link google sheet không đúng định dạng');
    }

    ConfirmModal.showModal({}, {
      headerText: `Hành động này sẽ import QC work task từ link gg sheet?`,
      bodyText: `<strong>Lưu ý</strong>: <p>Link google sheet <a href="${vm.googleSheetLink}">này</a> cần được cấp quyền xem cho tài khoản chuthang205@gmail.com</p>`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      WorkTasks.importQCWorkTasks({
        googleSheetLink: vm.googleSheetLink
      }).$promise.then(WorkTasks => {
        return FhdMessenger.success(`Import thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('work-tasks').controller('ModalAddNoteWorkTaskController', ['FhdMessenger', 'workTask', '$modalInstance', function (FhdMessenger, workTask, $modalInstance) {
  const vm = this;
  vm.workTask = workTask;

  vm.confirm = function () {
    if (!vm.content) {
      return FhdMessenger.error('Bạn chưa nhập ghi chú');
    }

    vm.workTask.note = vm.content;
    vm.waiting = true;
    workTask = vm.workTask;
    workTask.$updateNote().then(() => {
      FhdMessenger.success('Thêm ghi chú thành công');
      $modalInstance.dismiss();
    }).catch(error => vm.error = error.data.messagge).finally(() => {
      vm.waiting = false;
      vm.content = '';
    });
  };
}]);
"use strict";

angular.module('work-tasks').controller('ModalCreateQCWorkTaskController', ['data', 'helper', 'Authentication', 'FhdMessenger', 'OutletService', 'WorkTaskService', 'WorkTasks', '$modalInstance', '$scope', 'UserService', function (data, helper, Authentication, FhdMessenger, OutletService, WorkTaskService, WorkTasks, $modalInstance, $scope, UserService) {
  const vm = this;
  vm.data = {};
  vm.user = Authentication.user;
  vm.groups = WorkTaskService.getGroups();
  vm.isQcOrAdmin = _.intersection(vm.user.roles, ['admin', 'QC']).length || !_.get(vm.user, 'outlet.code', '').match(/[MESBDG]\d+/);

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.workTask.outlets = _.map(selectedOutlets, '_id');
  };

  vm.productSearchSelected = product => {
    vm.workTask.products = vm.workTask.products || [];

    const matchProduct = _.find(vm.workTask.products, {
      sku: product.sku
    });

    if (matchProduct) {
      return FhdMessenger.error(`Đã có sản phẩm ${product.sku} - ${product.description} trong danh sách`);
    }

    if (vm.workTask.products.length > 1) {
      return FhdMessenger.error(`Chỉ được có 1 sản phẩm trong danh sách`);
    }

    vm.workTask.products.push({
      product: product._id,
      sku: product.sku,
      description: product.description,
      privateLabel: product.privateLabel
    });
  };

  vm.workTask = {
    complaint: data.complaint,
    group: 'goods',
    name: `Liên quan đến complaint ${data.complaint.complaintId}`
  };

  if (_.get(data, 'complaint.products.length')) {
    vm.workTask.products = vm.workTask.products || [];
    vm.workTask.products = _.map(data.complaint.products, product => {
      return {
        product: product.product,
        sku: product.sku,
        description: product.description,
        badQuantity: product.quantity
      };
    });
  }

  UserService.allStaffs(function (err, staffs) {
    vm.workTask.staff = _.find(staffs, {
      code: 'D1516'
    });
    if (err) FhdMessenger.errorFromServer(err);
  });
  vm.removeValueFromArray = helper.removeValueFromArray;

  vm.create = taskType => {
    if (taskType) {
      vm.workTask.taskType = taskType;
    }

    if (vm.workTask.taskType === 'HC') {
      if (!_.get(vm.workTask, 'outlet._id')) {
        return FhdMessenger.error('Chưa chọn cơ sở');
      }

      if (!_.get(vm.workTask, 'group')) {
        return FhdMessenger.error('Chưa chọn nhóm vấn đề');
      }

      if (!_.get(vm.workTask, 'facility')) {
        return FhdMessenger.error('Chưa chọn cơ sở vật chất tương ứng');
      }

      if (!_.get(vm.workTask, 'name')) {
        return FhdMessenger.error('Chưa điền tên vấn đề');
      }
    }

    if (vm.workTask.taskType === 'tech') {
      if (!_.get(vm.workTask, 'name')) {
        return FhdMessenger.error('Chưa điền tên vấn đề');
      }
    }

    if (vm.workTask.taskType === 'description') {
      if (!_.get(vm.workTask, 'product')) {
        return FhdMessenger.error('Chưa chọn sản phẩm cần viết mô tả');
      }
    }

    if (vm.workTask.taskType === 'QC') {
      if (!_.get(vm.workTask, 'group')) {
        return FhdMessenger.error('Chưa điền loại QC task');
      }

      if (!_.get(vm.workTask, 'detail')) {
        return FhdMessenger.error('Chưa điền mô tả');
      }

      if (!_.get(vm.workTask, 'name')) {
        return FhdMessenger.error('Chưa điền tên task');
      }

      if (!_.get(vm.workTask, 'staff') && vm.isQcOrAdmin) {
        return FhdMessenger.error('Chưa điền nhân viên xử lý');
      }

      if (!_.get(vm.workTask, 'outlets.length')) {
        return FhdMessenger.error('Chưa chọn cơ sở');
      }

      if (vm.workTask.group === 'goods') {
        if (!_.get(vm.workTask, 'products.length')) {
          return FhdMessenger.error('Chưa thêm sản phẩm');
        }

        if (_.get(vm.workTask, 'products.length')) {
          const products = _.get(vm.workTask, 'products');

          const isNotHaveBadQuantity = _.some(products, qcTaskProduct => {
            return qcTaskProduct.badQuantity < 0 || !qcTaskProduct.badQuantity;
          });

          if (isNotHaveBadQuantity) {
            return FhdMessenger.error('Chưa điền đủ số lượng lỗi cho từng sản phẩm');
          }
        }

        if (!_.get(vm.workTask, 'images.length') && !_.get(vm.workTask, 'complaint')) {
          return FhdMessenger.error('Chưa chọn ảnh');
        }
      }
    }

    if (vm.workTask.taskType === 'VM') {
      if (!_.get(vm.workTask, 'name')) {
        return FhdMessenger.error('Chưa điền tiêu đề');
      }

      if (!_.get(vm.workTask, 'detail')) {
        return FhdMessenger.error('Chưa điền mô tả');
      }

      if (!_.get(vm.workTask, 'outlet._id')) {
        return FhdMessenger.error('Chưa chọn cơ sở');
      }
    }

    const workTask = new WorkTasks(vm.workTask);
    vm.waiting = true;
    workTask.$save().then(_workTask => {
      FhdMessenger.success('Tạo thành công');
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('work-tasks').controller('ModalDoneWorkDepartmentForWorkTaskController', ['FhdMessenger', 'workTask', '$modalInstance', function (FhdMessenger, workTask, $modalInstance) {
  const vm = this;
