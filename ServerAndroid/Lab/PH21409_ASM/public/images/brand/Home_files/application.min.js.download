angular.module('work-tasks').controller('ModalRequestChangeDeadlineQCWorkTaskController', ['FhdMessenger', 'workTask', '$modalInstance', function (FhdMessenger, workTask, $modalInstance) {
  const vm = this;
  vm.workTask = workTask;

  vm.init = () => {
    vm.deadline = vm.workTask.deadline;
  };

  vm.send = function () {
    if (_.isEqual(vm.deadline, vm.workTask.deadline)) {
      return FhdMessenger.error('Deadline chưa được thay đổi');
    }

    vm.workTask.deadline = vm.deadline;
    vm.waiting = true;
    workTask = vm.workTask;
    workTask.$requestChangeDeadlineQCTask().then(() => {
      FhdMessenger.success('Yêu cầu thành công');
      $modalInstance.dismiss();
    }).catch(error => FhdMessenger.error(error.message)).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('work-tasks').controller('ModalSelectQCTaskProblemController', ['$modalInstance', 'FhdMessenger', 'item', function ($modalInstance, FhdMessenger, item) {
  const vm = this;
  vm.item = _objectSpread({}, item);
  vm.problems = ['Lỗi theo lô', 'Lỗi dị vật', 'Lỗi nhãn(sai thông tin nhãn)', 'Lỗi hàng điện tử', 'Lỗi hàng food nhà sản xuất', 'Lỗi hàng nonfood', 'Lỗi dập nhiệt, hút chân không'];
  const requiredNoteProblems = vm.problems;
  const requiredPlTaskProblems = [];
  const requiredDueDate = ['Lỗi hàng food nhà sản xuất'];

  vm.shouldRequireNote = problem => {
    return _.includes(requiredNoteProblems, problem);
  };

  vm.shouldRequirePlTask = problem => {
    return _.includes(requiredPlTaskProblems, problem) && vm.item.sku.match(/B\d+/) && vm.item.privateLabel;
  };

  vm.shouldRequireDueDate = problem => {
