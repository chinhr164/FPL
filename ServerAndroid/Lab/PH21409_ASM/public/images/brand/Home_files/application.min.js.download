    }
  }).state('editVoucher', {
    url: '/vouchers/:voucherId/edit',
    templateUrl: 'modules/vouchers/views/edit-voucher.client.view.html',
    resolve: {
      $title: _.constant('Edit Voucher')
    }
  });
}]);
"use strict";

angular.module('vouchers').controller('ModalEditVoucherController', ['$modalInstance', 'voucherId', 'Vouchers', '$http', 'Authentication', 'FhdMessenger', function ($modalInstance, voucherId, Vouchers, $http, Authentication, FhdMessenger) {
  const vm = this;

  vm.close = () => {
    $modalInstance.dismiss();
  };

  vm.user = Authentication.user;
  vm.voucher = Vouchers.get({
    voucherId
  });

  vm.update = () => {
    vm.voucher.$update().then(() => {
      FhdMessenger.success('Cập nhật voucher thành công!');
      $modalInstance.dismiss();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };
}]);
'use strict'; // Vouchers controller

angular.module('vouchers').controller('VouchersController', ['$scope', '$stateParams', '$location', 'Authentication', 'Vouchers', 'CustomerRequests', 'CustomerService', 'FhdMessenger', '$state', function ($scope, $stateParams, $location, Authentication, Vouchers, CustomerRequests, CustomerService, FhdMessenger, $state) {
  // $scope.authentication = Authentication
  const vm = this;
  vm.user = Authentication.user;
  vm.targetCustomers = [];
  vm.loading = false;
  vm.target = 'ANY';
  vm.voucherType = 'AMOUNT';
  vm.withoutCard = true;
  vm.expiryDate = moment().add(3, 'month').startOf('day').format('YYYY-MM-DD'); // Create Voucher From User

  vm.create = () => {
    if (!vm.name) {
      return FhdMessenger.errorFromServer('Vui lòng nhập tên voucher');
    }

    if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('marketing')) {
      return FhdMessenger.errorFromServer('Bạn không có quyền tạo voucher');
    }

    if (vm.targetCustomers.length === 0) {
      return FhdMessenger.errorFromServer('Vui lòng chọn khách hàng');
    }

    vm.loading = true;
    const voucher = new Vouchers({
      name: vm.name.trim(),
      voucherType: vm.voucherType,
      quantity: vm.quantity,
      target: vm.target,
      startDate: vm.startDate,
      expiryDate: vm.expiryDate,
      withoutCard: vm.withoutCard,
      saleEntry: vm.user._id,
      targetCustomers: vm.targetCustomers,
      useOnce: true,
      used: false
    });
    voucher.$save().then(() => {
      FhdMessenger.success('Tạo voucher thành công');
      $state.reload();
      vm.loading = false;
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      vm.loading = false;
    });
  }; // Search for target customer


  vm.searchCustomers = searchText => {
    vm.clearCustomer();
    return CustomerService.searchCustomers(searchText).then(customers => {
      return customers || [];
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      return [];
    }).finally(() => {
      vm.searchingCustomer = false;
    });
  }; // Clear Customer


  vm.clearCustomer = () => {
    vm.customerSearch = null;
  }; // Selected customer


  vm.customerSearchSelected = function (customer) {
    if (customer) {
      if (vm.targetCustomers.findIndex(targetCustomer => {
        return targetCustomer._id === customer._id;
      }) < 0) {
        vm.targetCustomers.push(customer);
      }

      vm.clearCustomer();
    }
  }; // Remove customer


  vm.removeCustomer = index => {
    vm.targetCustomers.splice(index, 1);
  };
}]);
'use strict';

angular.module('vouchers').factory('VoucherService', ['$http', '$modal', function ($http, $modal) {
  function openEditVoucherModal(voucherId) {
    return $modal.open({
      templateUrl: '/modules/vouchers/views/modal-edit-voucher.client.view.html',
      controller: 'ModalEditVoucherController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        voucherId: () => voucherId
      }
    }).result;
  }

  return {
    openEditVoucherModal,
    forCustomer: function (customerId) {
      return function (callback) {
        $http.get('/customers/api/' + customerId + '/vouchers').success(function (vouchers) {
          callback(null, vouchers);
        }).error(function (errorResponse) {
          callback(errorResponse);
        });
      };
    },
    getVoucherStatus: function (voucher) {
      if (voucher.deleted) {
        return 'Đã xóa';
      }

      if (voucher.used) {
        return 'Rồi';
      }

      if (moment(voucher.expiryDate).isBefore(new Date())) {
        return 'Quá hạn';
      }

      return 'Chưa';
    }
  };
}]);
'use strict'; // Vouchers service used to communicate Vouchers REST endpoints

