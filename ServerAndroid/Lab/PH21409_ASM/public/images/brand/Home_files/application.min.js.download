angular.module('businesses').controller('BusinessesController', ['$scope', '$stateParams', '$location', 'Authentication', 'Businesses', function ($scope, $stateParams, $location, Authentication, Businesses) {
  const vm = this;
  vm.authentication = Authentication;
  vm.business = {}; // Create new Business

  vm.create = function () {
    // Create new Business object
    var business = new Businesses(vm.business); // Redirect after save

    business.$save(function (response) {
      $location.path('businesses/' + response._id); // Clear form fields

      vm.business.name = '';
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Remove existing Business


  vm.remove = function () {
    if (vm.business) {
      vm.business.$remove();

      for (var i in vm.businesses) {
        if (vm.businesses[i] === vm.business) {
          vm.businesses.splice(i, 1);
        }
      }
    } else {
      vm.business.$remove(function () {
        $location.path('businesses');
      });
    }
  }; // Update existing Business


  vm.update = function () {
    var business = vm.business;
    business.$update(function () {
      $location.path('businesses/' + business._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of Businesses


  vm.find = function () {
    vm.businesses = Businesses.query();
  }; // Find existing Business


  vm.findOne = function () {
    vm.business = Businesses.get({
      businessId: $stateParams.businessId
    });
  };
}]);
'use strict'; // Setting up route

