angular.module('user-photos').factory('UserPhotos', ['$resource', 'EnvironmentService', function ($resource, EnvironmentService) {
  const defaultURL = 'user-photos';
  const url = EnvironmentService.getImageWorkerServiceURL() || defaultURL;
  return $resource('user-photos/:userPhotoId', {
    userPhotoId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    resizeAndUpload: {
      method: 'POST',
      url: `${url}/resize-and-upload`,
      isArray: false
    } // upload: {
    //   method: 'POST',
    //   url: ` ${url}/upload`,
    // },

  });
}]);
'use strict';

angular.module('user-photos').factory('UserPhotoService', ['$modal', '$http', 'EnvironmentService', function ($modal, $http, EnvironmentService) {
  const defaultURL = 'user-photos';
  const url = EnvironmentService.getImageWorkerServiceURL() || defaultURL;
  return {
    view: () => $modal.open({
      animation: true,
      templateUrl: '/modules/user-photos/templates/choose-user-photos-modal.client.template.html',
      controller: 'ModalChooseUserPhotosController',
      controllerAs: 'vm',
      backdrop: 'static',
      windowClass: 'modal-choose-user-photos-modal',
      size: 'lg'
    }).result,

    removeMany(images) {
      return $http.delete(`/user-photos/remove-user-photos`, {
        params: {
          images
        }
      }).then(response => response.data);
    },

    removeS3(image) {
      return $http.delete(`${url}/remove-image-s3`, {
        params: {
          image
        }
      }).then(response => response.data);
    },

    getImageSize(base64) {
      let base64Length = base64.length - (base64.indexOf(',') + 1);
      let padding = base64.charAt(base64.length - 2) === '=' ? 2 : base64.charAt(base64.length - 1) === '=' ? 1 : 0;
      let fileSize = ((base64Length * 0.75 - padding) / 1024).toFixed(2);
      return fileSize;
    }

  };
}]);
'use strict';

