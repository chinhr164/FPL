  vm.selectProduct = function (product) {
    vm.products = vm.products || [];
    vm.products.push({
      description: product.description,
      quantity: 0,
      vendorName: product.vendorName,
      hasBill: false,
      hasRegistration: false,
      hasQuarantine: false,
      checked: false,
      note: '',
      time: moment().toDate()
    });
    product = null;
  };

  vm.update = () => {
    $http.put('/settings/import-entries/update', {
      products: vm.products
    }).then(response => {
      FhdMessenger.success('Ok');
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.find = () => {
    $http.get('/settings/import-entries').then(response => {
      vm.importEntries = response.data;
      FhdMessenger.success('Ok');
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.print = function (importEntry) {
    vm.importEntry = importEntry;
    $timeout(() => {
      JsPrintService.printElementById('import-entry', true);
    }, 100);
  };
}]);
