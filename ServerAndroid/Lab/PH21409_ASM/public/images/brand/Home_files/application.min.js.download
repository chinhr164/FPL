angular.module('fhd-simditor').constant('simditorConfig', {
  placeholder: 'Nhập nội dung ở đây',
  locale: 'en-US',
  toolbar: ['title', 'bold', 'italic', 'underline', 'strikethrough', 'color', '|', 'ol', 'ul', 'blockquote', 'table', '|', 'link', 'image', 'hr', '|', 'indent', 'outdent', 'alignment', '|', 'html'],
  pasteImage: true,
  defaultImage: '',
  toolbarFloat: true,
  upload: {
    url: 'https://resizeimage.4-handy.com/upload'
  },
  allowedTags: ['br', 'a', 'img', 'b', 'strong', 'i', 'u', 'font', 'p', 'ul', 'ol', 'li', 'blockquote', 'pre', 'h1', 'h2', 'h3', 'h4', 'hr', 'div', 'script', 'style', 'iframe'],
  allowedAttributes: {
    img: ['src', 'alt', 'width', 'height', 'data-non-image'],
    a: ['href', 'target', 'title'],
    font: ['color'],
    code: ['class'],
    table: ['class'],
    iframe: ['width', 'height', 'src', 'frameborder', 'allowfullscreen']
  },
  cleanPaste: false
}).directive('ngSimditor', ['$timeout', 'simditorConfig', function ($timeout, simditorConfig) {
  // Runs during compile
  return {
    // name: '',
    // priority: 1,
    // terminal: true,
    scope: {
      onChange: '=',
      content: '=',
      config: '=?'
    },
    // {} = isolate, true = child, false/undefined = no change
    // controller: function($scope, $element, $attrs, $transclude) {},
    // require: 'ngModel', // Array = multiple requires, ? = optional, ^ = check parent elements
    restrict: 'E',
    // E = Element, A = Attribute, C = Class, M = Comment
    template: '<textarea data-autosave="editor-content" autofocus></textarea>',
    // templateUrl: '',
    replace: true,

    // transclude: true,
    // compile: function(tElement, tAttrs, function transclude(function(scope, cloneLinkingFn){ return function linking(scope, elm, attrs){}})),
    link($scope, iElm, iAttrs, controller) {
      Simditor.locale = 'en-US';
      $scope.config = $scope.config || {};
      const editor = new Simditor(angular.extend({
        textarea: iElm
      }, simditorConfig, $scope.config));
      let nowContent = '';
      $scope.$watch('content', function (value, old) {
        if (angular.isDefined(typeof value) && value !== nowContent) {
          editor.setValue(value);
        }
      });
      editor.on('valuechanged', function (e) {
        if ($scope.content !== editor.getValue()) {
          $timeout(function () {
            $scope.content = nowContent = editor.getValue();

            if ($scope.onChange) {
              $scope.onChange($scope.content);
            }
          });
        }
      });
    }

  };
}]);
Simditor.i18n = {
  'en-US': {
    blockquote: 'blockquote',
    bold: 'bold',
    code: 'code',
    color: 'color',
    hr: 'hr',
    image: 'image',
    externalImage: 'External Image',
    uploadImage: 'Upload Image',
    uploadFailed: 'Upload Failed',
