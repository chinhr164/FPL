/* eslint-disable angular/controller-as */
angular.module('users').controller('AuthenticationController', ['$http', '$location', 'Authentication', 'FhdMessenger', 'ResourcesService', '$window', '$localStorage', 'geolocationSvc', function ($http, $location, Authentication, FhdMessenger, ResourcesService, $window, $localStorage, geolocationSvc) {
  const vm = this;
  vm.authentication = Authentication;
  const expectRoute = $localStorage.getObject('expectRoute');
  vm.error = $location.search().error;

  if (vm.authentication.user) {
    if (expectRoute && expectRoute !== '/signin') {
      // Redirect to expectRoute
      $location.path(expectRoute);
      $localStorage.setObject('expectRoute', null);
    } else {
      // If user is signed in then redirect back home
      $location.path('/');
    }
  }

  vm.signup = function () {
    $http.post('/auth/signup', vm.credentials).success(function (response) {
      // If successful we assign the response to the global user model
      vm.authentication.user = response; // And redirect to the index page

      $location.path('/');
    }).error(function (response) {
      vm.error = response.message;
    });
  };

  vm.signin = function () {
    vm.waiting = true;
    geolocationSvc.getCurrentPosition().then(position => {
      vm.credentials.latitude = _.get(position, 'coords.latitude');
      vm.credentials.longitude = _.get(position, 'coords.longitude');
      $localStorage.reset();
      $http.post('/auth/signin', vm.credentials).success(function (response) {
        if (vm.credentials.password === '12345678') {
          $localStorage.setObject('needChangePassword', true);
        } // Set Object again cause it's reset at line 49


        $localStorage.setObject('expectRoute', expectRoute);
        vm.authentication.user = response;

        if (response.roles.includes('login:by-google') && _.get(vm.authentication, 'user.email').match(/gmail\.com/)) {
          $http.get('/auth/signout');
          $location.path(expectRoute);
          $localStorage.setObject('expectRoute', null);
          return FhdMessenger.notifySticky('Vui lòng đăng nhập bằng Google (bấm "Login with Google")');
        }

        if (!_.get(vm.authentication, 'user.email').match(/(4-handy\.com|gmail\.com)/)) {
          FhdMessenger.notifySticky('Email của bạn không phải là Gmail. Hãy gửi cho HR tài khoản Gmail của bạn để cập nhật lại sau đó bạn có thể dùng chức năng đăng nhập bằng tài khoản Google để đăng nhập nhé');
        } // If successful we assign the response to the global user model


        vm.waiting = false;
        $window.location.reload();
      }).error(function (response) {
        vm.waiting = false;
        vm.error = response.message;
        FhdMessenger.error(response.message);
      });
    });
  };
}]);
'use strict'; // User controller

angular.module('users').controller('CreateUserController', ['$location', 'Users', 'UserService', 'FhdMessenger', function ($location, Users, UserService, FhdMessenger) {
  const vm = this;
  vm.user = {}; // Create new user

  vm.create = function () {
    // Check fill enough info
    if (!vm.user.code) {
      FhdMessenger.error('Please fill user code');
      return;
    }

    if (!vm.user.firstName) {
      FhdMessenger.error('Please fill user first name');
      return;
    }

    if (!vm.user.lastName) {
      FhdMessenger.error('Please fill user last name');
      return;
    }

    if (!vm.user.outlet) {
      FhdMessenger.error('Please fill user outlet');
      return;
    }

    if (!vm.user.email) {
      FhdMessenger.error('Please fill user email');
      return;
    }

    if (!vm.user.cellphone) {
      FhdMessenger.error('Please fill user cellphone');
      return;
    }

    if (!vm.user.position) {
      FhdMessenger.error('Please fill user position');
      return;
    }

    if (!vm.user.business) {
      FhdMessenger.error('Please fill user business');
      return;
    }

    if (!vm.user.business) {
      FhdMessenger.error('Please fill user business');
      return;
    }

    if (!vm.user.address) {
      return FhdMessenger.error('Please fill user address');
    } // if (!vm.user.college) {
    //   FhdMessenger.error('Please fill user college')
    //   return
    // }
    // if (!vm.user.graduationYear) {
    //   FhdMessenger.error('Please fill graduation year')
    //   return
    // }


    const roles = _.reduce(vm.user.roleMap, (rolesValue, toShow, role) => {
      if (toShow) rolesValue.push(role);
      return rolesValue;
    }, []);

    if (!roles.includes('outlet') && !_.intersection(roles, vm.user.rolePositions).length) {
      return FhdMessenger.error('Người dùng phải có ít nhất một quyền tại Positions');
    }

    vm.user.password = '12345678';
    vm.user.roles = roles;
    vm.user.username = vm.user.email;
    const user = new Users(vm.user);
    vm.waiting = true;
    user.$save(function () {
      $location.path('users'); // Clear form fill

      vm.code = '';
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

