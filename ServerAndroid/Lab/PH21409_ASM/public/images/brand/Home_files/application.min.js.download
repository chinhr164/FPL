angular.module('restock-reports').factory('RestockReportService', ['$modal', '$http', function ($modal, $http) {
  const productConditionTypes = [{
    id: 'normal',
    value: 'Hàng thường'
  }, {
    id: 'cool',
    value: 'Hàng lạnh'
  }];
  return {
    openReadyRestockReportModal(restockReportId) {
      return $modal.open({
        templateUrl: '/modules/restock-reports/views/modal-ready-restock-report.client.view.html',
        controller: 'ModalReadyRestockReportController',
        controllerAs: 'vm',
        resolve: {
          restockReportId: () => restockReportId
        }
      });
    },

    getDuplicateRestockReport(outletCode, warehouseRestock, productConditionTypes) {
      return $http.post('restock-reports/get-duplicate-restock-report', {
        outletCode,
        warehouseRestock,
        productConditionTypes
      }).then(res => res.data);
    },

    attachProductionContionTypeText(restockReport) {
      restockReport.productConditionText = _.map(restockReport.productConditionTypes, type => {
        return _.get(_.find(productConditionTypes, {
          id: type
        }), 'value', type);
      }).join(', ');
    },

    getProductConditionTypes() {
      return productConditionTypes;
    }

  };
}]);
'use strict'; // Setting up route

