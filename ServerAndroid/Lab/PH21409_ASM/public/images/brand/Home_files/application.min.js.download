angular.module('users').factory('RolesService', ['$state', function ($state) {
  function hasRole(user, role) {
    return _.includes(_.get(user, 'roles'), role);
  }

  function hasRoles(user, roles) {
    return _.some(roles, role => hasRole(user, role));
  }

  function permitRoles(user, roles) {
    if (hasRoles(user, roles)) {
      $state.go('home');
    }
  }

  return {
    hasRole,
    hasRoles,
    permitRoles
  };
}]);
"use strict";

