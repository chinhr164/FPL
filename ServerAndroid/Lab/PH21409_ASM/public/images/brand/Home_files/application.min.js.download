}]);
"use strict";

angular.module('pl-tasks').controller('AssignPlTasksController', ['$scope', 'PlTasks', 'FhdMessenger', 'NgTableParams', 'StockMap', 'UserService', '$q', 'ObjectId', 'PlTaskService', 'Authentication', '$window', 'TetCategories', function ($scope, PlTasks, FhdMessenger, NgTableParams, StockMap, UserService, $q, ObjectId, PlTaskService, Authentication, $window, TetCategories) {
  const vm = this;
  vm.data = {
    plTaskTypes: PlTaskService.getPlTaskTypes(),
    cat: 'tet'
  };
  vm.bulkMergePlTasks = [];
  vm.needResetPlTasks = [];
  vm.user = Authentication.user;
  vm.data.catHeader = 'Tết Tag';

  vm.getSpecialCategories = () => {
    const mapCategories = categories => {
      return _.map(categories, category => ({
        id: category.name,
        title: category.name
      }));
    };

    return TetCategories.query().$promise.then(tetCategories => {
      vm.data.catHeader = 'Tết Tag';
      return mapCategories(tetCategories);
    });
  };

  vm.processingPlTasksTable = new NgTableParams({});

  function getInProgress() {
    vm.processingPlTasks = PlTasks.query({
      sortByPoint: true,
      status: 'processing',
      outlet: ObjectId.getObjectId(vm.outlet)
    });
    vm.processingPlTasks.$promise.then(() => {
      vm.processingPlTasksTable.settings({
        dataset: vm.processingPlTasks
      });
    });
  }

  vm.skippedPlTasksTable = new NgTableParams({});

  function getSkipped() {
    vm.skippedPlTasks = PlTasks.query({
      status: 'skipped',
      outlet: ObjectId.getObjectId(vm.outlet),
      autoCreateStockEntry: false
    });
    vm.skippedPlTasks.$promise.then(() => {
      vm.skippedPlTasksTable.settings({
        dataset: vm.skippedPlTasks
      });
    });
  }

  vm.getOutletLabel = outletCode => {
    if (outletCode === 'G1') {
      return 'label-danger';
    }

    if (outletCode === 'G2') {
      return 'label-info';
    }

    if (outletCode === 'G3') {
      return 'label-default';
    }

    if (outletCode === 'G4') {
      return 'label-ready';
    }

    return 'label-success';
  };

  vm.openViewDetailPlTaskPoints = PlTaskService.openViewDetailPointPlTaskModal;
  vm.createdPlTasksTable = new NgTableParams({});
  vm.createdPlTasksTable.sorting({
    shortage: 'desc'
  });

  function getCreatedTasks() {
    vm.waiting = true;
    vm.createdPlTasks = PlTasks.query({
      sortByPoint: true,
      status: 'created',
      outlet: ObjectId.getObjectId(vm.outlet),
      autoCreateStockEntry: false
    });
    return $q.all([vm.data.getStaffs, vm.createdPlTasks.$promise]).then(() => {
      const name = 'tet';

      _.forEach(vm.createdPlTasks, plTask => {
        if (plTask.product) {
          plTask.product.specialCategory = plTask.product[`${name}Category`];
          plTask.canReceive = _.get(plTask.stockEntryDistributes, 'length') && plTask.assignedStaff;
        }
      });

      vm.createdPlTasksTable.settings({
        dataset: vm.createdPlTasks
      });
      PlTaskService.getToConfirmItems().then(items => _.reduce(items, (result, item) => {
        result[item._id] = item.processingQuantity || 0;
        return result;
      }, {})).then(processingMap => {
        vm.processingMap = processingMap;
        vm.createdPlTasksTable.reload();
      }).finally(() => {
        vm.waiting = false;
      });
    });
  }

  vm.fetch = function () {
    getInProgress();
    getCreatedTasks();
    getSkipped();
    vm.data.getStaffs = UserService.allStaffsAsync().then(users => {
      vm.data.staffs = _.sortBy(_.map(_.filter(users, user => _.includes(user.roles, 'sx')), user => {
        return {
          _id: user._id,
          code: user.code,
          displayName: user.displayName,
          outletCode: _.get(user, '.outlet.code', '')
        };
      }), ['outletCode', 'code']);
      vm.data.staffs.unshift({
        _id: null,
        code: '--- Không chọn ---'
      });
    });
    FhdMessenger.success('Tải xong...');
    $q.all([vm.processingPlTasks.$promise, vm.skippedPlTasks.$promise, vm.createdPlTasks.$promise]).then(() => {
      StockMap.getStockMapCache().then(data => {
        vm.stockMap = data;

        _.forEach(['createdPlTasks', 'skippedPlTasks', 'processingPlTasks'], name => {
          _.forEach(vm[name], plTask => {
            plTask.stock = _.get(vm.stockMap, `${_.get(plTask, 'product._id')}.${_.get(plTask, 'product.warehouseRestock.code')}`);
          });
        });
      });
    });
  };

  function refreshCreatedPlTask() {
    vm.createdPlTasksTable.settings({
      dataset: vm.createdPlTasks
    });
    vm.createdPlTasksTable.reload();
  }

  vm.assignStaff = function (plTask, staff) {
    const originalStaffs = plTask.assignedStaffs;
    FhdMessenger.info('Đang lưu');

    if (_.some(plTask.assignedStaffs, {
      _id: staff._id
    })) {
      FhdMessenger.error('Nhân viên đã có tên trong PL Task');
      return;
    }

    if (_.get(staff, '_id')) {
      plTask.assignedStaff = staff;
      plTask.assignedStaffs = plTask.assignedStaffs || [];
      plTask.assignedStaffs.push(staff);
    }

    plTask.waiting = true;
    plTask.$update().then(() => {
      FhdMessenger.success('Đã lưu người được giao việc.');
      refreshCreatedPlTask();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      plTask.assignedStaffs = originalStaffs;
    }).finally(() => {
      plTask.waiting = false;
    });
  };

  vm.removeStaff = function (plTask, staff) {
    _.remove(plTask.assignedStaffs, {
      _id: staff._id
    });

    plTask.assignedStaff = _.last(plTask.assignedStaffs) || null;
    plTask.waiting = true;
    plTask.$update().then(() => {
      FhdMessenger.success('Đã bỏ nhân viên ra khỏi PL Task');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      plTask.waiting = false;
    });
  };

  vm.skip = function (plTask) {
    PlTaskService.openSkipPlTaskModal(plTask).then(() => {
      vm.fetch();
    });
  };

  vm.restore = function (plTask) {
    vm.waiting = true;
    plTask.$restore().then(() => {
      vm.fetch();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.openCreatePlTaskModal = function () {
    PlTaskService.openCreatePlTaskModal().finally(() => {
      vm.fetch();
    });
  };

  vm.caculateETA = function (processing, orderQuantity, productionTime) {
    const startProcessing = new Date(processing);
    const endProcesing = moment(startProcessing).add(orderQuantity * productionTime, 'minute');
    return endProcesing.toDate();
  };

  vm.caculateTotalTimeProduct = function (orderQuantity, productionTime) {
    const totalTimeProduct = orderQuantity * productionTime * 60 * 1000;
    const duration = moment.duration(totalTimeProduct);
    let hours = duration.hours();

    if (orderQuantity * productionTime / 60 > 24) {
      hours += 24 * Math.floor(orderQuantity * productionTime / 60 / 24);
    }

    const minutes = duration.minutes();
    return hours * 60 + minutes;
  };

  $scope.$watch(() => vm.createdPlTasksTable.data, function (tableRows, oldValue) {
    if (tableRows === oldValue) return;
    vm.summaryTotalTimeProduct = _.reduce(vm.createdPlTasksTable.data, (result, plTask) => {
      return result + vm.caculateTotalTimeProduct(plTask.orderQuantity, plTask.inputProductionTime || plTask.product.productionTime);
    }, 0);
  });

  vm.getPlTypes = () => [{
    title: 'Bao tải',
    id: 'sack'
  }, {
    title: 'Phi thực phẩm',
    id: 'non-food'
  }, {
    title: 'Hàng hút chân không',
    id: 'vacuum'
  }, {
    title: 'Khác',
    id: 'other'
  }];

  vm.getPlOutlets = () => {
    const outletCodes = ['G1', 'G2', 'G3', 'G4', 'G5', 'G7', 'G8', 'G9'];
    return _.map(outletCodes, outletCode => {
      return {
        title: outletCode,
        id: outletCode
      };
    });
  };

  vm.markProcessing = plTask => {
    if (!_.get(plTask.assignedStaffs, 'length')) {
      FhdMessenger.error('Không có nhân viên thực hiện Task');
      return;
    }

    plTask.status = 'processing';
    plTask.processing = new Date();
    plTask.$update().then(() => {
      FhdMessenger.success('Đã đánh dấu đang đóng gói');
      vm.fetch();
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.markDelivered = plTask => {
    if (!_.get(plTask.assignedStaffs, 'length')) {
      FhdMessenger.error('Không có nhân viên thực hiện Task');
      return;
    }

    PlTaskService.openMarkDeliverPlTaskModal(plTask).then(() => {
      vm.fetch();
    });
  };

  vm.editChecked = function (toAdd, plTask) {
    if (toAdd) {
      vm.bulkMergePlTasks.push(plTask);
      vm.needResetPlTasks.push(plTask);
    } else {
      vm.bulkMergePlTasks = _.reject(vm.bulkMergePlTasks, bulkMergePlTask => {
        return plTask._id === bulkMergePlTask._id;
      });
      vm.needResetPlTasks = _.reject(vm.needResetPlTasks, needResetPlTask => {
        return plTask._id === needResetPlTask._id;
      });
    }
  };

  vm.resetNotiTimesPlTasks = () => {
    vm.waiting = true;
    vm.reason = $window.prompt('Nhập lí do');
    const needResetNotiTimesPlTasks = new PlTasks({
      plTaskIds: _.map(vm.needResetPlTasks, plTask => {
        return plTask._id;
      }),
      reason: vm.reason
    });
    needResetNotiTimesPlTasks.$requestResetNotiTimes().then(() => {
      FhdMessenger.success('Gửi yêu cầu thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.mergePlTasks = function () {
    vm.waiting = true;

    const plTaskIds = _.map(vm.bulkMergePlTasks, plTask => {
      return plTask._id;
    });

    PlTaskService.mergePlTask(plTaskIds).then(() => {
      vm.bulkMergePlTasks = [];
      vm.fetch();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.splitPlTasks = PlTaskService.openSplitPlTaskModal;
}]);
"use strict";

angular.module('pl-tasks').controller('ConfirmPlTaskModalController', ['Authentication', 'FhdMessenger', '$modalInstance', 'PlTasks', 'plTask', 'StockEntryService', function (Authentication, FhdMessenger, $modalInstance, PlTasks, plTask, StockEntryService) {
  const vm = this;
  vm.user = Authentication.user;

  vm.findOne = function () {
    const plTaskId = plTask._id;
    vm.plTask = PlTasks.get({
      plTaskId
    });
    vm.plTask.$promise.then(() => {
      vm.imageLink = _.get(vm.plTask, 'product.wooProperties.images.0.src') || _.get(vm.plTask, 'product.imageLink');

      if (vm.user.roles.includes('admin')) {
        vm.plTask.confirmedStaff = vm.user;
      }
    });
  };

  vm.confirm = function () {
    if (!vm.plTask.confirmedStaff) {
      return FhdMessenger.error('Chưa có nhân viên confirm PlTask');
    }

    if (plTask.plTaskType !== 'adhoc' && plTask.sku.match(/^B\d+/)) {
      if (vm.plTask.confirmQuantity !== vm.plTask.checkedItems.length && vm.plTask.checkedItems.length < 3) {
        return FhdMessenger.error('Chưa nhập đủ danh sách sản phẩm kiểm tra ngẫu nhiên');
      }

      if (!vm.plTask.noDate && (!vm.plTask.confirmManufactureDate || !vm.plTask.confirmExpiryDate)) {
        return FhdMessenger.error('Bạn chưa nhập NSX và HSD');
      }

      if (vm.plTask.noDate && vm.plTask.expiryDate) {
        return FhdMessenger.error('Lô này bắt buộc phải có hạn sử dụng.');
      }

      if (moment(vm.plTask.confirmExpiryDate).startOf('day').diff(moment().startOf('day')) < 0) {
        return FhdMessenger.error('HSD phải lớn hơn ngày hôm nay. Vui lòng kiểm tra lại');
      }

      if (_.some(vm.plTask.checkedItems, item => {
        return !item.maxWeightAllow || !item.minWeightAllow;
      })) {
        return FhdMessenger.error('Có sản phẩm chưa có khối lượng tối đa hoặc tối thiểu. Vui lòng liên hệ với quản lý ĐG');
      }

      if (_.some(vm.plTask.checkedItems, item => {
        if (item.minWeightAllow && item.maxWeightAllow && !item.weight) {
          return true;
        }
      })) {
        return FhdMessenger.error('Có sản phẩm chưa nhập khối lượng kiểm tra');
      }

      if (_.some(vm.plTask.checkedItems, 'wrongWeight')) {
        return FhdMessenger.error('Có sản phẩm sai khối lượng đóng gói. Vui lòng liên hệ với quản lý ĐG');
      }

      if (_.some(vm.plTask.checkedItems, 'wrongLabel')) {
        return FhdMessenger.error('Có sản phẩm sai mã vạch. Vui lòng liên hệ với quản lý ĐG');
      }

      if (!vm.plTask.confirmQuantity) {
        return FhdMessenger.error('Chưa nhập số lượng sản phẩm nhập kho');
      }
    }

    vm.waiting = true;
    vm.plTask.$confirm().then(plTask => {
      $modalInstance.close(plTask);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.chooseStaff = function () {
    StockEntryService.chooseStaffModal().then(user => {
      vm.plTask.confirmedStaff = user;
    });
  };

  vm.checkShelfLife = function () {
    vm.shelfLifeNote = '';

    let productShelfLife = _.get(vm.plTask, 'product.shelfLife');

    const errorNote = 'Hạn sử dụng trên bao bì không khớp với thông tin sản phẩm lưu trên hệ thống';

    if (!productShelfLife) {
      return;
    }

    if (!vm.plTask.confirmManufactureDate || !vm.plTask.confirmExpiryDate) {
      return;
    }

    const confirmShelfLife = moment(vm.plTask.confirmExpiryDate).diff(moment(vm.plTask.confirmManufactureDate), 'days');

    if (confirmShelfLife > 180) {
      if (Math.abs(confirmShelfLife / productShelfLife - 1) > 0.05) {
        vm.shelfLifeNote = errorNote;
      }
    } else if (Math.abs(confirmShelfLife - productShelfLife) > 3) {
      vm.shelfLifeNote = errorNote;
    }

    if (vm.shelfLifeNote) {
      vm.shelfLifeNote += '. Hạn bạn nhập vào là ' + Math.round(confirmShelfLife / 365 * 12 * 100) / 100 + ' tháng';
    }
  };

  vm.addItem = item => {
    const currentItem = _.clone(item);

    if (vm.plTask.checkedItems.length === 3) {
      return FhdMessenger.error('Đã quét đủ 3 sản phẩm');
    }

    if (currentItem.plTaskId && currentItem.plTaskId !== vm.plTask.plTaskId) {
      return FhdMessenger.error(`Sai số lô đóng gói. PL Task ${vm.plTask.plTaskId}, mã vạch là ${currentItem.sku}L${vm.plTask.plTaskId}.`);
    }

    if (currentItem.sku !== vm.plTask.sku) {
      FhdMessenger.error(`Sai SKU: PL Task ${vm.plTask.sku}, nhập ${currentItem.sku}`);
      currentItem.wrongLabel = true;
    } else {
      currentItem.wrongLabel = false;
    }

    if (currentItem.quantityFromBarcode) {
      currentItem.minWeightAllow = currentItem.quantity * 100 * 0.1;
      currentItem.maxWeightAllow = currentItem.quantity * 100 * 1.1;
    }

    vm.plTask.checkedItems = vm.plTask.checkedItems || [];
    vm.plTask.checkedItems.push(currentItem);
  };

  vm.removeItem = index => {
    vm.plTask.checkedItems.splice(index, 1);
  };

  vm.checkWeight = item => {
    if (!_.isFinite(item.weight)) {
      item.wrongWeight = null;
      return;
    }

    if (!item.minWeightAllow || !item.maxWeightAllow) {
      item.wrongWeight = null;
      return;
    }

    if (item.maxWeightAllow < item.weight || item.minWeightAllow > item.weight) {
      item.wrongWeight = true;
    } else {
      item.wrongWeight = false;
    }
  };

  vm.close = $modalInstance.dismiss;
}]);
"use strict";

angular.module('pl-tasks').controller('ConfirmPlTasksController', ['Authentication', 'CurrentShift', 'PlTasks', 'FhdMessenger', 'NgTableParams', 'PlTaskService', function (Authentication, CurrentShift, PlTasks, FhdMessenger, NgTableParams, PlTaskService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.currentShift = CurrentShift.getCurrentShift();
  vm.destination = vm.currentShift.outlet;

  if (!vm.currentShift.created && !vm.user.roles.includes('admin') && !vm.user.roles.includes('flexi-time') && !vm.user.roles.includes('tro-ly-sx') && !vm.user.roles.includes('tro-ly-kho')) {
    return FhdMessenger.error('Chưa đăng nhập ca trực');
  }

  if (!_.get(vm.destination, '_id') && vm.user.roles.includes('flexi-time') && !vm.user.roles.includes('tro-ly-kho') && !vm.user.roles.includes('tro-ly-sx')) {
    vm.destination = _.get(vm.user, 'outlet');
  }

  vm.plTasksTable = new NgTableParams({
    count: 1000
  });
  vm.plTaskOptions = _.map(PlTaskService.getPlTaskTypes(), plTaskType => ({
    id: plTaskType.value,
    title: plTaskType.label
  }));

  vm.find = function () {
    vm.plTasks = PlTasks.query({
      status: 'delivered',
      destination: _.get(vm.destination, '_id', _.get(vm, 'destination'))
    });
    vm.plTasks.$promise.then(() => {
      vm.plTasksTable.settings({
        dataset: vm.plTasks
      });
    });
  };

  vm.confirm = function (plTask) {
    PlTaskService.openConfirmPlTaskModal(plTask).then(() => {
      vm.find();
    });
  };
}]);
"use strict";

angular.module('pl-tasks').controller('CreatePlTaskModalController', ['FhdMessenger', '$modalInstance', 'PlTasks', 'Authentication', 'PlTaskService', 'StockEntries', 'recycleStockEntry', function (FhdMessenger, $modalInstance, PlTasks, Authentication, PlTaskService, StockEntries, recycleStockEntry) {
  const vm = this;
  vm.user = Authentication.user;
  vm.recycleStockEntry = recycleStockEntry;
  vm.manufactureDate = null;
  vm.expiryDate = null;
  vm.data = {
    plTaskTypes: PlTaskService.getPlTaskTypes()
  };

  if (vm.recycleStockEntry._id) {
    vm.plTaskType = 'redo';
    vm.outlet = recycleStockEntry.destination;
    vm.destination = recycleStockEntry.outlet;
  } else {
    vm.plTaskType = 'new';
  }

  vm.submit = function () {
    const item = vm.product || null;

    if (!item && vm.plTaskType !== 'adhoc') {
      return FhdMessenger.error('Chưa chọn sản phẩm');
    }

    if (vm.plTaskType === 'new' && vm.user.roles.includes('tro-ly-sx')) {
      return FhdMessenger.error('Bạn chỉ được tạo PL Task Adhoc hoặc tái chế');
    }

    if (!_.get(item, '_id') && !vm.inputProductionTime) {
      return FhdMessenger.error('Bạn chưa điền số phút sản xuất cho PL Task');
    }

    const plTask = new PlTasks({
      status: 'created',
      plTaskType: vm.plTaskType,
      outlet: vm.outlet,
      destination: vm.destination,
      product: _.get(item, '_id'),
      sku: _.get(item, 'sku'),
      description: _.get(item, 'description', vm.adHocTaskName),
      inputProductionTime: vm.inputProductionTime,
      orderQuantity: vm.orderQuantity,
      assignedStaff: vm.assignedStaff || null,
      manufactureDate: vm.manufactureDate || null,
      expiryDate: vm.expiryDate || null
    });
    vm.waiting = true;
    plTask.$save().then(result => {
      FhdMessenger.success('Đã tạo PlTask thành công');

      if (vm.recycleStockEntry._id) {
        vm.recycleStockEntry.recyclePlTask = result.plTask._id;
        new StockEntries(vm.recycleStockEntry).$updateRecyclePlTask().then(res => {
          FhdMessenger.success('Cập nhật trạng thái của stock entry tái chế thành công !');
          $modalInstance.close(true);
        }).catch(FhdMessenger.errorFromServer);
      }
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.close = $modalInstance.close;
}]);
"use strict";

angular.module('pl-tasks').controller('CreateTrashNoteModalController', ['recycleStockEntry', '$modalInstance', 'FhdMessenger', 'StockEntries', 'OutletService', function (recycleStockEntry, $modalInstance, FhdMessenger, StockEntries, OutletService) {
  const vm = this;
  vm.waiting = false;
  vm.dismiss = $modalInstance.dismiss;
  vm.recycleStockEntry = new StockEntries(recycleStockEntry);
  OutletService.allAsync().then(outlets => {
    vm.outlets = outlets;
  });

  vm.createTrashNote = async () => {
    if (!vm.recycleStockEntry.trashNote.content) {
      return FhdMessenger.error('Thiếu lí do tiêu hủy. ');
    }

    vm.waiting = true;

    let trashStockEntry = _.clone(recycleStockEntry);

    trashStockEntry.outlet = recycleStockEntry.destination;
    trashStockEntry.destination = _.find(vm.outlets, {
      code: 'TRASH'
    });
    delete trashStockEntry._id;

    try {
      await new StockEntries(trashStockEntry).$save();
    } catch (error) {
      vm.waiting = false;
      return FhdMessenger.errorFromServer(error);
    }

    vm.recycleStockEntry.$update().then(recycleStockEntry => {
      FhdMessenger.success('Tạo tiêu hủy thành công !! ');
      $modalInstance.close(recycleStockEntry);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ModalDisablePlTaskController', ['$modalInstance', 'FhdMessenger', 'plTask', function ($modalInstance, FhdMessenger, plTask) {
  const vm = this;

  vm.submit = function () {
    if (!vm.reason) {
      return FhdMessenger.error('Chưa có lý doa xóa plTask');
    }

    plTask.disabledReason = vm.reason;
    vm.waiting = true;
    plTask.$disable().then(() => $modalInstance.close(plTask)).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
"use strict";

angular.module('pl-tasks').controller('FilterPTasksByDateController', ['PlTasks', 'FhdMessenger', 'NgTableParams', 'UserService', 'PlTaskService', 'Settings', 'Authentication', 'SaleEntriesService', function (PlTasks, FhdMessenger, NgTableParams, UserService, PlTaskService, Settings, Authentication, SaleEntriesService) {
  const vm = this;
  vm.started = false;
  vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').add(7, 'day').format('YYYY-MM-DD');
  vm.data = {};
  vm.user = Authentication.user;
  vm.plTasks = [];
  vm.saleEntries = [];
  vm.data.settings = Settings.get();
  vm.filterPlTasksTable = new NgTableParams({});
  vm.waiting = false;

  vm.submit = function () {
    vm.started = true;
    vm.waiting = true;
    let promise = PlTaskService.getPlTasksByExpiryDate(vm.startDate, vm.endDate).then(filterPlTasks => {
      vm.plTasks = _.map([...filterPlTasks], '_id');
    }).then(() => {
      SaleEntriesService.getSaleEntriesByPlTaskCode(vm.plTasks).then(saleEntries => {
        if (saleEntries.length <= 0) {
          return FhdMessenger.info('Không có dữ liệu');
        }

        vm.plTasks = saleEntries;
        vm.filterPlTasksTable.settings({
          dataset: vm.plTasks
        });
      });
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Đã tải xong');
    });
  };
}]);
'use strict';

angular.module('pl-tasks').controller('FindPlTaskController', ['$state', '$scope', function ($state, $scope) {
  const vm = this;
  $scope.$watch(() => vm.selectPlTask, () => {
    return $state.go('viewPlTask', {
      plTaskId: vm.selectPlTask._id
    });
  });
}]);
"use strict";

angular.module('pl-tasks').controller('ListSavorPlTasksController', ['Authentication', 'PlTasks', 'PlTaskService', 'FhdMessenger', 'NgTableParams', function (Authentication, PlTasks, PlTaskService, FhdMessenger, NgTableParams) {
  const vm = this;
  vm.user = Authentication.user;

  vm.init = () => {
    vm.startDate = moment().startOf('day').format('YYYY-MM-DD');
    vm.endDate = moment().format('YYYY-MM-DD');
  };

  vm.getStatus = () => [{
    id: 'created',
    title: 'created'
  }, {
    id: 'pending',
    title: 'pending'
  }, {
    id: 'done',
    title: 'done'
  }, {
    id: 'disabled',
    title: 'disabled'
  }];

  vm.disable = function (plTask) {
    PlTaskService.openDisablePlTaskModal(plTask).then(() => {
      const matchPlTaskIndex = _.findIndex(vm.plTasks, plTask);

      vm.plTasks.splice(matchPlTaskIndex, 1);
      vm.fetchPlTasksTable();
    });
  };

  vm.fetchPlTasksTable = function () {
    vm.plTasksTable.settings({
      dataset: vm.plTasks
    });
    vm.plTasksTable.reload();
  };

  vm.plTasksTable = new NgTableParams({});

  vm.find = () => {
    vm.waiting = true;
    vm.plTasks = PlTasks.savorQuery({
      startDate: moment(vm.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.endDate).format('YYYY-MM-DD')
    });
    vm.plTasks.$promise.then(() => {
      vm.fetchPlTasksTable();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('pl-tasks').controller('MarkDeliverPlTaskModalController', ['$modalInstance', 'plTask', 'PlTasks', 'FhdMessenger', function ($modalInstance, plTask, PlTasks, FhdMessenger) {
  const vm = this;
  vm.plTask = PlTasks.get({
    plTaskId: plTask._id
  });

  vm.removeAssignedStaff = function (index) {
    if (!_.isArray(vm.plTask.assignedStaffs)) return;
    vm.plTask.assignedStaffs.splice(index, 1);
  };

  vm.deliver = function () {
    const region = _.get(vm.plTask, 'outlet.region');

    if (vm.plTask.assignedStaffs.length && _.difference(_.map(vm.plTask.assignedStaffs, 'outlet.region'), [region]).length) {
      return FhdMessenger.error('Không được thêm nhân viên khác miền vào PL Task');
    }

    vm.waiting = true;
    vm.plTask.$deliver().then(() => {
      FhdMessenger.success('Ok');
      $modalInstance.close(plTask);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.dismiss = $modalInstance.dismiss;
}]);
"use strict";

angular.module('pl-tasks').controller('ModalEditPlTaskController', ['Authentication', '$stateParams', 'plTask', 'PlTasks', 'FhdMessenger', 'ObjectId', '$modalInstance', function (Authentication, $stateParams, plTask, PlTasks, FhdMessenger, ObjectId, $modalInstance) {
  const vm = this;
