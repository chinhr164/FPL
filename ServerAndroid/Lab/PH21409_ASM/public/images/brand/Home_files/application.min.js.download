angular.module('portraits').controller('ModalChooseProcessWorkDepartmentController', ['portrait', 'Authentication', 'FhdMessenger', '$modalInstance', 'ObjectId', function (portrait, Authentication, FhdMessenger, $modalInstance, ObjectId) {
  const vm = this;
  vm.portrait = portrait;
  vm.user = Authentication.user;

  vm.selectWorkDepartment = workDepartment => {
    vm.portrait.workDepartments = vm.portrait.workDepartments || [];

    const matchWorkDepartment = _.find(vm.portrait.workDepartments, _workDepartment => {
      return ObjectId.equals(_workDepartment.workDepartment, workDepartment);
    });

    if (matchWorkDepartment) {
      return FhdMessenger.error('Đã có bộ phận này rồi');
    }

    vm.portrait.workDepartments.push({
      workDepartment: workDepartment,
      user: vm.user
    });
  };

  vm.update = () => {
    if (_.some(vm.portrait.workDepartments, workDepartment => {
      return !workDepartment.note;
    })) {
      return FhdMessenger.error('Có bộ phận chưa điền vấn đề');
    }

    $modalInstance.close(vm.portrait);
  };

  vm.removeWorkDepartment = index => {
    vm.portrait.workDepartments.splice(index, 1);
  };
}]);
'use strict'; // User controller

angular.module('portraits').controller('ModalCreatePortraitController', ['Authentication', 'FhdMessenger', 'Portraits', 'PortraitService', 'saleReport', '$modalInstance', '$state', function (Authentication, FhdMessenger, Portraits, PortraitService, saleReport, $modalInstance, $state) {
  const vm = this;
  vm.user = Authentication.user;
  vm.portrait = {};

  if (saleReport) {
    vm.portrait = {
      date: moment(saleReport.date).format('YYYY-MM-DD'),
      shift: saleReport.shift,
      outlet: saleReport.outlet
    };
  }

  vm.positions = PortraitService.getPositions(vm.user);

  vm.dismiss = function () {
    $modalInstance.dismiss();
  };

  vm.create = () => {
    const err = PortraitService.validatePortrait(vm.portrait);

    if (err) {
      return FhdMessenger.error(err);
    }

    vm.portrait.shift = _.get(vm.portrait.shift, 'code');
    const portrait = new Portraits(vm.portrait);
    portrait.date = moment(portrait.date).startOf('day').toDate();
    vm.waiting = true; // Redirect after save

    portrait.$save().then(portrait => {
      FhdMessenger.success('Tạo Portrait thành công!');
      $modalInstance.close(portrait);
    }).catch(errorResponse => {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('portraits').controller('ModalReplyPortraitController', ['FhdMessenger', 'portrait', 'workDepartment', '$modalInstance', 'ObjectId', function (FhdMessenger, portrait, workDepartment, $modalInstance, ObjectId) {
  const vm = this;
  vm.portrait = portrait;
  vm.delegate = workDepartment;
  vm.comment = '';

  vm.dismiss = function () {
    $modalInstance.dismiss();
  };

  vm.reply = () => {
    if (!vm.comment || !vm.comment.length) {
      return FhdMessenger.error('Bạn chưa điền trả lời');
    }

    vm.portrait.workDepartment = ObjectId.getObjectId(vm.delegate.workDepartment);
    vm.portrait.comment = vm.comment;
    vm.waiting = true;
    vm.portrait.$done().then(function (response) {
      FhdMessenger.success(`Trả lời và Done ${vm.delegate.workDepartment.code} thành công`);
      $modalInstance.close();
    }).catch(function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

/* eslint-disable angular/controller-as */
// Portraits controller
angular.module('portraits').controller('PortraitsController', ['ConfirmModal', '$stateParams', '$location', 'Authentication', '$state', 'NgTableParams', 'Portraits', 'ObjectId', 'FhdMessenger', '$q', 'SticketService', 'PortraitService', '$scope', function (ConfirmModal, $stateParams, $location, Authentication, $state, NgTableParams, Portraits, ObjectId, FhdMessenger, $q, SticketService, PortraitService, $scope) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.comment = '';
  vm.isHidden = false;
  vm.startDateFlagged = moment().startOf('day').subtract(1, 'week').format('YYYY-MM-DD');
  vm.endDateFlagged = moment().endOf('day').format('YYYY-MM-DD');
  vm.isAdmin = vm.user.roles.includes('admin');
  vm.portrait = {};
  vm.positions = PortraitService.getPositions(vm.user);

  vm.done = (workDepartment, isReply) => {
    if (!isReply) {
      ConfirmModal.showModal({}, {
        actionButtonText: `Xác nhận`,
        headerText: `Hoàn thành cho bộ phận ${workDepartment.workDepartment.code}`,
        bodyText: ``
      }).then(() => {
        vm.portrait.workDepartment = ObjectId.getObjectId(workDepartment.workDepartment);
        vm.waiting = true;
        vm.portrait.$done().then(function (response) {
          $state.reload();
          FhdMessenger.success(`Done ${workDepartment.workDepartment.code} thành công`);
        }).catch(function (errorResponse) {
          FhdMessenger.errorFromServer(errorResponse);
        }).finally(() => {
          vm.waiting = false;
        });
      });
    } else {
      PortraitService.openReplyPortraitModal(vm.portrait, workDepartment).then(() => $state.reload());
    }
  };

  vm.toggleHiddenMode = () => {
    vm.isHidden = !vm.isHidden;
  };

  vm.toggleFlag = _.debounce(function (currentPortrait) {
    let portrait = {};

    if (currentPortrait) {
      currentPortrait.flagged = !currentPortrait.flagged;
      portrait = currentPortrait;
    } else {
      vm.portrait.flagged = !vm.portrait.flagged;
      portrait = vm.portrait;
    }

    if (!portrait.flagged) {
      toggleFlag(portrait);
    } else {
      PortraitService.openChooseProcessWorkDepartmentModal(portrait).then(_portrait => {
        toggleFlag(_portrait);
      });
    }
  }, 500);

  function toggleFlag(portrait) {
    portrait.$toggleFlag().then(response => {
      if (response.flagged) {
        FhdMessenger.success('Gắn cờ thành công');
      } else {
        FhdMessenger.success('Bỏ gắn cờ thành công');
      }
    });
  }

  vm.checkByStaff = function () {
    if (!vm.staff) {
      return FhdMessenger.error('Chưa chọn nhân viên');
    }

    vm.waiting = true;
    Portraits.checkByStaff({
      startDate: vm.startDate,
      endDate: vm.endDate,
      staff: ObjectId.getObjectId(vm.staff)
    }).$promise.then(saleReports => {
      FhdMessenger.success('Tải danh sách thành công');
      vm.saleReports = saleReports;
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }; // Remove customer


  vm.removeCustomer = function (portrait) {
    if (portrait) portrait.customer = null;else vm.customer = null;
  }; // Remove staff


  vm.removeStaff = function (portrait) {
    if (portrait) portrait.staff = null;else vm.staff = null;
  }; // Create new Portrait


  vm.create = function () {
    vm.portrait.shift = _.get(vm.portrait.shift, 'code');
    const portrait = new Portraits(vm.portrait);
    const err = PortraitService.validatePortrait(portrait);

    if (err) {
      return FhdMessenger.error(err);
    }

    portrait.date = moment(portrait.date).startOf('day').toDate();
    vm.waiting = true;
    portrait.$save().then(function (response) {
      $location.path(`portraits/${response._id}`);
      FhdMessenger.success('Tạo Portrait thành công!');
    }).catch(function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Remove existing Portrait


  vm.remove = function (portrait) {
    if (portrait) {
      portrait.$remove();

      const index = _.findIndex(vm.portraits, {
        _id: portrait._id
      });

      if (index > -1) {
        vm.portraits.splice(index, 1);
      }
    } else {
      vm.portrait.$remove(function () {
        $location.path('portraits');
      });
    }
  };

  vm.checkHadThumbUp = function (portrait) {
    if (portrait.thumbUps.length) {
      return true;
    }

    return false;
  };

  vm.startDate = moment().startOf('day').subtract(1, 'day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').format('YYYY-MM-DD'); // Find a list of Portraits

  vm.find = function () {
    $q.all([vm.businessPromise, vm.outletPromise]).then(() => {
      vm.portraits = Portraits.query({
        outlets: vm.selectedOutletIds,
        startDate: vm.startDate,
        endDate: vm.endDate,
        staff: ObjectId.getObjectId(vm.staff),
        shift: _.get(vm.shift, 'code')
      });
    });
  }; // Find existing Portrait


  vm.findOne = function () {
    vm.portrait = Portraits.get({
      portraitId: $stateParams.portraitId
    });
    vm.portrait.$promise.then(portrait => {
      vm.portrait = portrait;
      vm.isHidden = _.get(portrait.comments, 'length', 0) === 0 && !vm.user.roles.includes('admin') && !vm.user.roles.includes('portraits:comment');
    });
  };

  vm.addThumbUp = function () {
    if (!_.intersection(vm.user.roles, ['admin', 'portraits:comment']).length) {
      return FhdMessenger.error('Bạn không có quyền gửi thumb up');
    }

    vm.waiting = true;
    vm.portrait.$addThumbUp().then(() => {
      FhdMessenger.success('Ok!');
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.thumbUpsPortraitTable = new NgTableParams({
    count: 50
  });

  vm.findThumbUps = function () {
    vm.loading = true;
    vm.portraits = Portraits.query({
      startDate: vm.startDate,
      endDate: vm.endDate,
      thumbUps: true
    });
    vm.portraits.$promise.then(() => {
      vm.portraits = _.map(vm.portraits, portrait => {
        portrait.departmentDescription = _.map(portrait.workDepartments, 'workDepartment.name').join(', ');
        return portrait;
      });
      vm.thumbUpsPortraitTable.settings({
        dataset: vm.portraits
      });
    });
    vm.portraits.$promise.then(() => {
      vm.loading = false;
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
      vm.loading = false;
    });
  };

  vm.sendTicket = function (portrait) {
    const user = portrait.user;
    const fineMoney = 20000;
    const reason = 'Portrait rác, viết chống đối hoặc sao chép - không đem lại giá trị cho tổ chức và không hoàn thành trách nhiệm trong ca trực.';
    SticketService.openCreateTicket({
      user,
      reason,
      fineMoney,
      portrait
    }).then(result => {
      if (result) {
        portrait.$updateSendTicket().then(() => FhdMessenger.success('Oki'));
      }
    });
  };

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.selectedOutletIds = _.map(selectedOutlets, '_id');
  };

  vm.onChangeSelectedProcessOutlet = selectedOutlets => {
    vm.selectedProcessOutletIds = _.map(selectedOutlets, '_id');
  };

  vm.queryStringToTableFilter = function () {
    // get workDepartments from query string
    const workDepartment = $location.search().workDepartment;

    if (workDepartment) {
      vm.thumbUpsPortraitTable.filter()['workDepartments.workDepartment.code'] = workDepartment;
    }
  };

  vm.findFlagged = function () {
    FhdMessenger.info('Đang tải');
    vm.waiting = true;
    vm.portraits = Portraits.query({
      startDate: vm.startDateFlagged,
      endDate: vm.endDateFlagged,
      outlets: vm.selectedOutletIds,
      processOutlet: vm.selectedProcessOutletIds,
      flagged: true
    });
    vm.portraits.$promise.then(() => {
      FhdMessenger.success('Đã tải xong');
      vm.thumbUpsPortraitTable.settings({
        dataset: vm.portraits
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.addComment = function () {
    if (!vm.comment) {
      return FhdMessenger.error('Bạn chưa nhập gì cả');
    }

    vm.portrait.comment = vm.comment;
    vm.waiting = true;
    vm.portrait.$comment().then(response => {
      vm.comment = '';
      vm.isReplying = false;
      FhdMessenger.success('Phản hồi thành công');
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => vm.waiting = false);
  };

  vm.openModalUpdateWorkDepartment = () => {
    PortraitService.openChooseProcessWorkDepartmentModal(vm.portrait).then(() => {
      vm.portrait.$updateWorkDepartment().then(res => {
        vm.portrait = res;
      }).catch(err => {
        FhdMessenger.error(err.message);
      });
    });
  };

  $scope.$watch(() => {
    return vm.thumbUpsPortraitTable.filter()['workDepartments.workDepartment.code'];
  }, (oldValue, newValue) => {
    // update query string to workDepartment
    if (oldValue !== newValue) {
      $location.search('workDepartment', vm.thumbUpsPortraitTable.filter()['workDepartments.workDepartment.code']);
    }
  });
}]);
'use strict';

angular.module('portraits').filter('portraitTitle', ['Authentication', '$filter', function (Authentication, $filter) {
  return function (portrait) {
    var header = 'Portrait #' + portrait.portraitId + ': ';
    var content = 'không rõ viết về ai?';
    if (!portrait.customer) content = 'Customer';else content = 'Customer ' + portrait.customer.fullName + ' - ' + portrait.customer.cellphone + (_.get(portrait, 'outlet.code') ? ' - ' + _.get(portrait, 'outlet.code', '') : '') + (_.get(portrait, 'shift') ? ' - ' + _.get(portrait, 'shift', '') : '') + (portrait.date ? ' - ' + moment(portrait.date).format('YYYY-MM-DD') : '');

    if (portrait.probability && _.intersection(Authentication.user.roles, ['admin', 'marketing']).length) {
      content += ` - ${$filter('number')(portrait.probability * 100, 0)}%`;
    }

    return header.concat(content);
  };
}]);
"use strict";

angular.module('portraits').factory('PortraitService', ['$http', '$modal', function ($http, $modal) {
  return {
    getPositions: user => {
      const positions = [];

      if (user.roles.includes('sale')) {
        positions.push({
          value: 'sale',
          name: 'Bán hàng'
        });
      }

      if (user.roles.includes('tro-ly')) {
        positions.push({
          value: 'tro-ly',
          name: 'Trợ lý'
        });
      }

      if (user.roles.includes('kho')) {
        positions.push({
          value: 'kho',
          name: 'Kho'
        });
      }

      if (user.roles.includes('kitchen')) {
        positions.push({
          value: 'kitchen',
          name: 'Bếp'
        });
      }

      if (user.roles.includes('sx')) {
        positions.push({
          value: 'sx',
          name: 'Đóng gói'
        });
      }

      return positions;
    },
    validatePortrait: portrait => {
      if (!portrait.position) {
        return 'Bạn chưa chọn vị trí cho portrait';
      }

      if (portrait.position !== 'tro-ly') {
        if (!_.get(portrait, 'outlet')) {
          return 'Bạn chưa chọn cơ sở cho portrait';
        }

        if (!_.get(portrait, 'shift')) {
          return 'Bạn chưa chọn ca cho portrait';
        }

        if (!_.get(portrait, 'date')) {
          return 'Bạn chưa chọn ngày cho portrait';
        }
      }
    },
    openCreatePortraitModal: saleReport => $modal.open({
      animation: true,
      templateUrl: '/modules/portraits/views/modal-create-portrait.client.view.html',
      controller: 'ModalCreatePortraitController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        saleReport: () => saleReport
      }
    }).result,
    openChooseProcessWorkDepartmentModal: portrait => $modal.open({
      animation: true,
      templateUrl: '/modules/portraits/templates/modal-choose-process-work-department.view.html',
      controller: 'ModalChooseProcessWorkDepartmentController',
      controllerAs: 'vm',
      resolve: {
        portrait: () => portrait
      }
    }).result,
    openReplyPortraitModal: (portrait, workDepartment) => $modal.open({
      animation: true,
      templateUrl: '/modules/portraits/views/modal-reply-portrait.client.view.html',
      controller: 'ModalReplyPortraitController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        portrait: () => portrait,
        workDepartment: () => workDepartment
      }
    }).result
  };
}]);
'use strict'; // Portraits service used to communicate Portraits REST endpoints

angular.module('portraits').factory('Portraits', ['$resource', function ($resource) {
  return $resource('portraits/:portraitId', {
    portraitId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    checkByStaff: {
      method: 'PUT',
      url: 'portraits/check-by-staff',
      isArray: true
    },
    addThumbUp: {
      method: 'POST',
      url: 'portraits/:portraitId/add-thumb-up'
    },
    done: {
      method: 'POST',
      url: 'portraits/:portraitId/done'
    },
    comment: {
      method: 'PUT',
      url: 'portraits/:portraitId/comment'
    },
    toggleFlag: {
      method: 'PUT',
      url: 'portraits/:portraitId/toggle-flag'
    },
    updateSendTicket: {
      method: 'PUT',
      url: 'portraits/:portraitId/send-ticket'
    },
    updateWorkDepartment: {
      method: 'PUT',
      url: 'portraits/:portraitId/update-work-department'
    }
  });
}]);
