angular.module('tet-categories').controller('ModalCreateTetCategoryController', ['$modalInstance', 'FhdMessenger', 'TetCategories', 'Authentication', 'TetCategoriesService', function ($modalInstance, FhdMessenger, TetCategories, Authentication, TetCategoriesService) {
  const vm = this;
  vm.tetCategory = {};
  vm.user = Authentication.user;
  vm.waiting = false;

  vm.dismiss = () => $modalInstance.dismiss();

  vm.create = function () {
    const tetCategory = new TetCategories(vm.tetCategory);
    const err = TetCategoriesService.validateTetCategory(tetCategory);

    if (err) {
      return FhdMessenger.error(err);
    }

    vm.waiting = true;
    tetCategory.$save().then(response => {
      FhdMessenger.success('Tạo thành công');
      $modalInstance.close(response);
    }).catch(err => {
      FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
