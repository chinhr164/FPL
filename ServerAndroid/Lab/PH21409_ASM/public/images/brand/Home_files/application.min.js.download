angular.module('missing-restocks').controller('MissingRestockController', ['$stateParams', '$state', '$timeout', 'FhdMessenger', 'InventoryLocations', 'MissingRestocks', 'MissingRestockService', 'NgTableParams', function ($stateParams, $state, $timeout, FhdMessenger, InventoryLocations, MissingRestocks, MissingRestockService, NgTableParams) {
  const vm = this;
  vm.productsTable = new NgTableParams({
    count: 50
  });
  vm.data = {};
  vm.data.inventoryLocations = InventoryLocations.query();

  function attachTagToItems(items) {
    _.forEach(items, attachTagToItem);
  }

  function attachTagToItem(item) {
    item.tag = _.get(item, 'product.tag', '') || '';
  }

  vm.findOne = function () {
    const missingRestockId = $stateParams.missingRestockId;
    vm.missingRestock = MissingRestocks.get({
      missingRestockId
    });
    vm.missingRestock.$promise.then(missingRestock => {
      attachTagToItems(missingRestock.items);
      vm.productsTable.settings({
        dataset: missingRestock.restockReport ? missingRestock.items : _.filter(missingRestock.items, {
          totalTransferedQuantity: 0
        })
      });
    });
  };

  vm.calculateNumProductNotRestock = function (items, warehouseCode) {
    let count = 0;

    _.forEach(items, item => {
      if (item.warehouseRestock.code === warehouseCode && item.totalTransferedQuantity === 0 && _.get(item.outletStockMap, warehouseCode, 0) > 0) {
        count += 1;
      }
    });

    return count;
  };

  vm.startChangeLocation = product => {
    product.changingLocation = !product.changingLocation;
  };

  vm.selectLocation = (product, inventoryLocation) => {
    vm.missingRestock.inventoryLocation = inventoryLocation;
    vm.missingRestock.product = product.product;
    vm.missingRestock.$addLocation().then(missingRestock => {
      FhdMessenger.success('Ok');
      vm.productsTable.settings({
        dataset: _.filter(missingRestock.items, {
          totalTransferedQuantity: 0
        })
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      product.changingLocation = false;
    });
  };

  vm.changeMarkOutOfStock = product => {
    if (product.khoOos) {
      changeMarkOutOfStock(product);
    } else {
      MissingRestockService.openModalInputOutStockNote().result.then(note => {
        vm.missingRestock.note = note;
        product.outStockNote = note;
        changeMarkOutOfStock(product);
      });
    }
  };

  function changeMarkOutOfStock(product) {
    product.khoOos = !product.khoOos;
    vm.missingRestock.sku = product.sku;
    vm.waiting = true;
    vm.missingRestock.$changeMarkOutOfStock().then(() => {
      if (product.khoOos) {
        FhdMessenger.success('Đã đánh dấu Hết hàng');
      } else {
        FhdMessenger.success('Đã bỏ đánh dấu Hết hàng');
      }
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  }
}]);
"use strict";

angular.module('missing-restocks').controller('ModalInputOutStockNoteController', ['$modalInstance', 'FhdMessenger', function ($modalInstance, FhdMessenger) {
  const vm = this;
  vm.cancel = $modalInstance.dismiss;

  vm.takeNote = function (reason) {
    if (reason !== 'Khác') {
      vm.note = reason;
      vm.otherReason = false;
    } else {
      vm.otherReason = true;
      vm.note = null;
    }
  };

  vm.submit = function () {
    if (!vm.note) {
      return FhdMessenger.error('Chưa có lý do hết hàng');
    }

    vm.waiting = true;
    const note = vm.note;
    $modalInstance.close(note);
  };
}]);
