angular.module('shift-reports').controller('ModalMissionMktController', ['$scope', '$modalInstance', 'FhdMessenger', 'shiftReport', 'currentShift', 'createShiftReport', function ($scope, $modalInstance, FhdMessenger, shiftReport, currentShift, createShiftReport) {
  const vm = this;
  vm.shiftReport = shiftReport;
  vm.currentShift = currentShift;
  vm.createShiftReport = createShiftReport;
  vm.data = {};
  vm.data.missions = [];
  vm.shiftReport.missions = {
    'Reply inbox, comment Abby': false,
    'Nghe hotline Abby': false,
    'Post bài trên fanpage Abby': false,
    'Reply inbox, comment Savor': false,
    'Check món Savor': false,
    'Check Portrait': false,
    'Done Min 3 Photo Task': false,
    'Đánh giá điểm cho CTV': false
  };

  if (vm.currentShift.shift === 'S') {
    // Ca sáng
    vm.shiftReport.missions['Đăng Instagram Savor link sang Facebook'] = false;
  }

  if (vm.currentShift.shift === 'C') {
    // Ca chiều
    vm.shiftReport.missions['Check review Foody'] = false;

    if (moment(vm.currentShift.date).day() === 1) {
      // Ca chiều thứ 2
      vm.shiftReport.missions['Tổng hợp ưu đãi Savor'] = false;
    }
  }

  if (vm.currentShift.shift === 'T') {// Ca tối
  }

  vm.data.missions = Object.keys(vm.shiftReport.missions);

  vm.close = () => $modalInstance.dismiss();

  vm.confirm = () => {
    const missions = _.map(vm.shiftReport.missions, (value, mission) => ({
      name: mission,
      done: value
    }));

    const hasNotDone = _.every(missions, {
      done: true
    });

    if (!hasNotDone) {
      return FhdMessenger.error('Bạn chưa hoàn thành hết nhiệm vụ');
    }

    vm.shiftReport.missions = missions;
    vm.createShiftReport(vm.shiftReport);
    vm.close();
  };
}]);
'use strict';

angular.module('shift-reports').controller('ShiftReportController', ['$http', '$location', '$state', '$stateParams', '$scope', 'Authentication', 'CurrentShift', 'ConfirmModal', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'Outlets', 'ShiftPositions', 'ShiftReports', 'ShiftReportsService', 'ShiftService', 'SticketService', 'UserPhotoService', 'UserPhotos', 'ShiftEntryService', '$modal', function ($http, $location, $state, $stateParams, $scope, Authentication, CurrentShift, ConfirmModal, FhdMessenger, NgTableParams, ObjectId, Outlets, ShiftPositions, ShiftReports, ShiftReportsService, ShiftService, SticketService, UserPhotoService, UserPhotos, ShiftEntryService, $modal) {
  const vm = this;
  vm.user = Authentication.user;
  vm.shiftReport = {};
  vm.data = {};
  vm.data.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().endOf('day').format('YYYY-MM-DD');
  vm.images = [];
  vm.isAdmin = vm.user.roles.includes('admin');
  vm.data.shifts = _.concat(ShiftService.getShifts(), ShiftService.getExtendShifts());
  vm.points = [0, 1, 2, 3];

  vm.loadValues = function () {
    vm.data.outlets = Outlets.query({
      deleted: false,
      hasStaff: true
    });
  };

  vm.staffsInShiftEntry = [];
  vm.shiftReportTable = new NgTableParams();

  function getMatchPositions(outlet) {
    let positions = ShiftPositions.getPostions(outlet);
    positions = positions.concat(ShiftPositions.PROBATION_POSITIONS);
    return positions;
  }

  vm.find = function () {
    vm.shiftReports = ShiftReports.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      outlet: ObjectId.getObjectId(vm.outlet),
      shift: _.get(vm.data.shift, 'code')
    });
    vm.shiftReports.$promise.then(shiftReports => {
      _.forEach(shiftReports, shiftReport => {
        shiftReport.totalOverTime = _.reduce(shiftReport.employees, (result, employee) => {
          return result + employee.overTime;
        }, 0);
      });

      vm.shiftReports = shiftReports;
      vm.shiftReportTable.settings({
        dataset: shiftReports
      });
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    });
    FhdMessenger.notifyLoading('Đang tải...', vm.shiftReports.$promise);
  };

  vm.updateNoteImages = () => {
    vm.shiftReport.$updateNoteImages().then(() => {
      FhdMessenger.success('Cập nhật note cho các ảnh thành công');
      vm.newNote = '';
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateNoteAndPoint = () => {
    vm.waiting = false;
    vm.shiftReport.$updateNoteAndPoint().then(() => {
      FhdMessenger.success(`Cập nhật điểm và ghi chú cho ca trực thành công`);
      $state.reload();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = function () {
    const shiftReportId = $stateParams.shiftReportId;
    vm.shiftReport = ShiftReports.get({
      shiftReportId
    });
    vm.shiftReport.$promise.then(shiftReport => {
      const outlet = shiftReport.outlet;
      vm.positions = getMatchPositions(outlet);
      ShiftReportsService.getShiftReportImagesContentAndMinImage(shiftReport.outlet.code).then(({
        imageContent,
        minImage
      }) => {
        vm.imageContent = imageContent;
      });

      if (outlet.code === 'MKT' && _.get(shiftReport, 'missions').length) {
        vm.data.missions = _.map(shiftReport.missions, mission => mission.name);
        shiftReport.missions = _.reduce(shiftReport.missions, (result, mission) => {
          result[mission.name] = mission.done;
          return result;
        }, {});
      }

      vm.beEvaluated = !!_.intersection([shiftReport.outlet.code], ['B3', 'D1', 'D2', 'G1']).length;

      _.forEach(shiftReport.employees, employee => {
        const matchStaff = _.find(shiftReport.staffs, {
          _id: employee.staff._id
        });

        matchStaff.overTime = employee.overTime;

        _.forEach(employee.positions, position => {
          matchStaff[position] = true;
        });
      });

      return shiftReport;
    });
  };

  vm.sendTicket = (user, shiftReport) => {
    SticketService.openCreateTicket({
      user,
      shiftReport
    });
  };

  vm.thumbUp = user => {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Thôi',
      actionButtonText: 'Thưởng Thumb Up',
      headerText: 'Thưởng Thumb Up?',
      bodyText: `Bạn có chắc chắn muốn thưởng Thumb Up ? Người gửi là ${user.displayName} sẽ được nhận 20k thưởng.`
    }).then(() => {
      vm.updating = true;
      return vm.shiftReport.$awardThumbUp({
        receiver: user
      }).then(() => {
        FhdMessenger.success('Đã tặng Thumb Up');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.updating = false;
      });
    });
  };

  function getEmployees(staffs) {
    return _.map(staffs, function (staff) {
      const positions = _.reduce(vm.positions, function (positions, position) {
        if (staff[position.code]) positions.push(position.code);
        return positions;
      }, []);

      return {
        staff: ObjectId.getObjectId(staff),
        staffName: staff.displayName,
        cellphone: staff.cellphone,
        isManager: staff.isManager,
        overTime: staff.overTime,
        positions
      };
    });
  } // Update existing Shift entry


  vm.update = function () {
    vm.shiftReport.employees = getEmployees(vm.shiftReport.staffs);
    vm.shiftReport.updatedBy = vm.user;
    vm.shiftReport.updated = new Date();
    vm.waiting = true;
    vm.shiftReport.$update().then(() => {
      $state.go('viewShiftReport', {
        shiftReportId: vm.shiftReport._id
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.remove = function (shiftReport) {
    ConfirmModal.show().then(() => {
      if (shiftReport) {
        shiftReport.$remove(function () {
          const shiftReportIndex = _.findIndex(vm.shiftReports, {
            _id: shiftReport._id
          });

          if (shiftReportIndex > -1) vm.shiftReports.splice(shiftReportIndex, 1);
          vm.shiftReportTable.reload();
        }, function (err) {
          FhdMessenger.errorFromServer(err);
        });
      } else {
        vm.shiftReport.$remove(function () {
          $location.path('shift-reports');
        });
      }
    });
  };

  vm.getStaff = function () {
    $http.get('/users/staffs').success(function (users) {
      vm.data.staffs = users;

      _.forEach(users, function (user) {
        user.fullDescription = `${user.code} - ${user.displayName} - ${user.outlet ? user.outlet.name : ''}`;
      });
    }).error(function (errorRespond) {
      FhdMessenger.errorFromServer(errorRespond);
    });
  };

  vm.init = function () {
    vm.getStaff();
    vm.currentShift = CurrentShift.getCurrentShift();

    if (!vm.currentShift.created) {
      return FhdMessenger.error('Chưa đăng nhập ca trực');
    } else {
      vm.data.points = _.reduce(new Array(5), (result, item, index) => {
        result.push(index + 1);
        return result;
      }, []);
      vm.shiftReport.staffs = _.map(vm.currentShift.staffs, staff => {
        return staff;
      });
      vm.shiftReport.shift = vm.currentShift.shift;
      vm.shiftReport.outlet = vm.currentShift.outlet;
      vm.shiftReport.shiftRecord = vm.currentShift._id;
      vm.shiftReport.shiftReportId = vm.currentShift.shiftRecordId;
      vm.shiftReport.securityStaffCame = false;
      vm.shiftReport.securityStaffNotCame = false;
      vm.shiftReport.date = vm.currentShift.date;
      vm.positions = getMatchPositions(vm.shiftReport.outlet);

      vm.currentShiftEntry = () => {
        return ShiftEntryService.findShiftEntry({
          outlet: vm.currentShift.outlet._id,
          shift: vm.currentShift.shift,
          date: vm.currentShift.date
        }).then(shiftEntry => {
          if (!shiftEntry) {
            FhdMessenger.error('Không tìm thấy Shift Entry tương ứng');
          } else {
            const staffWithPositions = _.reduce(shiftEntry.employees, (result, employee) => {
              result[employee.staff] = employee.positions;
              return result;
            }, {});

            vm.shiftReport.staffs = _.map(vm.shiftReport.staffs, staff => {
              const positions = staffWithPositions[staff._id];

              _.forEach(positions, position => {
                _.set(staff, `${position}`, true);
              });

              staff.hasPosition = true;
              return staff;
            });
            vm.staffsInShiftEntry = _.cloneDeep(vm.shiftReport.staffs);
          }
        });
      };

      ShiftReportsService.getShiftReportImagesContentAndMinImage(vm.shiftReport.outlet.code).then(({
        imageContent,
        minImage
      }) => {
        vm.imageContent = imageContent;
        vm.minImage = minImage;
      });
    }
  };

  vm.createShiftReport = dataShiftReport => {
    dataShiftReport.staffs = _.map(dataShiftReport.staffs, staff => {
      return ObjectId.getObjectId(staff);
    });
    const shiftReport = new ShiftReports(dataShiftReport);
    return shiftReport.$save(function (shiftReport) {
      CurrentShift.resetCurrentShift();
      $state.go('viewShiftReport', {
        shiftReportId: shiftReport._id
      });
    }, error => {
      FhdMessenger.errorFromServer(error);
      vm.saving = false;
    });
  };

  vm.create = function () {
    if (['B1', 'D2'].includes(vm.shiftReport.outlet.code)) {
      if (!vm.shiftReport.coolerTemperature) {
        return FhdMessenger.error('Bạn chưa điền nhiệt độ phòng mát');
      }

      if (['B1'].includes(vm.shiftReport.outlet.code)) {
        if (!vm.shiftReport.freezerTemperature) {
          return FhdMessenger.error('Bạn chưa điền nhiệt độ phòng đông');
        }
      }
    }

    vm.shiftReport.employees = _.map(vm.shiftReport.staffs, function (staff) {
      const positions = _.reduce(vm.positions, function (positions, position) {
        if (staff[position.code]) positions.push(position.code);
        return positions;
      }, []);

      return {
        staff: ObjectId.getObjectId(staff),
        positions,
        point: staff.point
      };
    });

    if (_.some(vm.shiftReport.employees, employee => {
      return !employee.positions || !employee.positions.length;
    })) {
      return FhdMessenger.error('Có nhân viên chưa có vị trí');
    }

    if (vm.minImage && vm.shiftReport.images.length < vm.minImage) {
      return FhdMessenger.error(`Bạn chưa chụp đủ ${vm.minImage} ảnh yêu cầu`);
    }

    if (vm.currentShift.outlet.code === 'MKT') {
      // check if mkt => show modal rồi mới tạo
      return $modal.open({
        templateUrl: 'modules/shift-reports/views/modal-mission-mkt.client.view.html',
        controller: 'ModalMissionMktController',
        size: 'md',
        controllerAs: 'vm',
        resolve: {
          shiftReport: () => vm.shiftReport,
          currentShift: () => vm.currentShift,
          createShiftReport: () => vm.createShiftReport
        }
      });
    } else {
      vm.saving = true;
      vm.createShiftReport(vm.shiftReport).finally(() => {
        vm.saving = false;
      });
    }
  };

  vm.staffSearchSelected = function (staff) {
    if (!staff) return;

    const checkDuplicate = _.find(vm.shiftReport.staffs, currentStaff => {
      return ObjectId.getObjectId(currentStaff) === ObjectId.getObjectId(staff);
    });

    if (checkDuplicate) {
      FhdMessenger.error('Người dùng đã có tên trong ca trực');
    } else {
      staff = _.find(vm.staffsInShiftEntry, s => s._id === staff._id) || staff;
      vm.shiftReport.staffs.push(_.cloneDeep(staff));
    }

    vm.staffSearch = null;
  };

  vm.removeStaff = function (index) {
    vm.shiftReport.staffs.splice(index, 1);
  };

  vm.sameOverTime = function () {
    const overTime = _.reduce(vm.shiftReport.staffs, (result, staff) => {
      if (staff.overTime > result) {
        return staff.overTime;
      }

      return result;
    }, 0);

    _.forEach(vm.shiftReport.staffs, staff => {
      staff.overTime = overTime;
    });
  };

  $scope.$watch(() => vm.shiftReport.securityStaffCame, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;

    if (newValue) {
      vm.shiftReport.securityStaffNotCame = false;
    }
  });
  $scope.$watch(() => vm.shiftReport.securityStaffNotCame, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;

    if (newValue) {
      vm.shiftReport.securityStaffCame = false;
    }
  });
  $scope.$watch(() => vm.shiftReportTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.totalPoint = _.reduce(newValue, (result, shiftReport) => result + _.get(shiftReport, 'points', 0), 0);
  });
}]);
"use strict";

angular.module('shift-reports').controller('UpdateHoursInSalaryReportsController', ['FhdMessenger', 'NgTableParams', 'Authentication', '$http', '$q', function (FhdMessenger, NgTableParams, Authentication, $http, $q) {
  const vm = this;
  vm.user = Authentication.user;
  vm.updatedReports = new NgTableParams({
    count: 30
  });
  vm.requireFields = 'hours id'.split(' ');

  function isAllValidField(items, field) {
    return _.some(items, item => {
      return !_.get(item, field);
    });
  }

  function validateItems(items, requireFields) {
    let errors = [];

    _.forEach(requireFields, requireField => {
      if (isAllValidField(items, requireField)) {
        errors.push(`Bạn chưa điền đủ ${requireField}`);
      }
    });

    return errors;
  }

  vm.import = () => {
    if (!_.get(vm, 'items.length')) {
      return;
    }

    const errors = validateItems(vm.items, vm.requireFields);

    if (errors.length) {
      _.forEach(errors, err => {
        return FhdMessenger.error(err);
      });

      return;
    }

    vm.waiting = true;
    const promise = $q(resolve => {
      const res = $http.put('/shift-reports/update-hour-in-salary-reports', {
        reports: vm.items
      });
      resolve(res);
    }).then(res => {
      vm.updatedReports.settings({
        dataset: res.data
      });
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang import...', promise, () => {
      FhdMessenger.success('Import thành công');
    });
  };
}]);
'use strict';

angular.module('shift-reports').factory('ShiftReportsService', ['$modal', 'OutletService', function ($modal, OutletService) {
  return {
    getShiftReportImagesContentAndMinImage(outletCode) {
      return OutletService.findOutletFromCode(outletCode).then(outlet => {
        const imageContent = _.get(outlet, 'imageReportContent', '');

        const minImage = _.get(outlet, 'shiftReportMinImage', 0);

        return {
          imageContent,
          minImage
        };
      });
    }

  };
}]);
'use strict';

