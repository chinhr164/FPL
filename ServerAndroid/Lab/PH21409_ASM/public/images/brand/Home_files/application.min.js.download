'use strict'; // Outlets controller

angular.module('chat-gpt').controller('ChatGPTController', ['ChatGPT', 'FhdMessenger', '$state', function (ChatGPT, FhdMessenger, $state) {
  const vm = this;
  vm.messages = [];

  vm.addMessage = function () {
    vm.messages.push({
      text: vm.newMessage,
      isUser: true
    });
    const chatGpt = new ChatGPT({
      content: vm.newMessage
    });
    vm.waiting = true;
    chatGpt.$save().then(function (response) {
      vm.newMessage = '';
      vm.messages.push({
        text: response.content.replace(/\n/g, '<br>'),
        isUser: false
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
