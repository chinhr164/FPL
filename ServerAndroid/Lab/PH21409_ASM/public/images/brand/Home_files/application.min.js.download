angular.module('expense-entries').factory('ExpenseEntryService', ['$modal', '$http', function ($modal, $http) {
  return {
    createExpenseEntry(buyingEntries, deliverEntries = null, workTask) {
      return $modal.open({
        templateUrl: '/modules/expense-entries/views/modal-create-expense-entry.client.view.html',
        controller: 'ModalCreateExpenseEntryController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          buyingEntries: () => buyingEntries,
          deliverEntries: () => deliverEntries,
          workTask: () => workTask
        }
      });
    },

    hideExpenseEntry(expenseEntry) {
      return $http.delete(`/expense-entries/${expenseEntry._id}`).then(response => {
        return response;
      });
    },

    openViewExpenseEntry(expenseEntry) {
      return $modal.open({
        templateUrl: '/modules/expense-entries/views/modal-view-expense-entry.client.view.html',
        controller: 'ModalViewExpenseEntryController',
        controllerAs: 'vm',
        resolve: {
          expenseEntry: () => expenseEntry
        }
      });
    },

    canCreateExpenseEntryForCreatedSaleReport(expenseEntry) {
      return !_.get(expenseEntry.category, 'expenseSubCategory.name', '').match(/(Cho vay|Nhập hàng|Điện sinh hoạt|Nước sinh hoạt)/gim) && expenseEntry.outlet && expenseEntry.outlet.code && expenseEntry.outlet.code.match(/^(M|E)\d+/);
    }

  };
}]);
"use strict";

