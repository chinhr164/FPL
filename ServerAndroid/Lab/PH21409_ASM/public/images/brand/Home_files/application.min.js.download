angular.module('carton-entries').factory('CartonEntryService', ['Outlets', 'ngStore', 'ngDexie', '$q', '$http', 'FhdMessenger', '$modal', '$rootScope', '$localStorage', 'helper', function (Outlets, ngStore, ngDexie, $q, $http, FhdMessenger, $modal, $rootScope, $localStorage, helper) {
  function createMulti(vendor, outlet, numCartonEntry) {
