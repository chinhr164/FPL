  let vm = this;
  console.log('running');

  vm.keyup = function ($event) {
    if ($event.keyCode === 27) {
      $scope.product.edit[$scope.outletCode] = false;
    }
  };

  vm.startEdit = function () {
    vm.newDisplayStockQuantity = $scope.product.displayStock[$scope.outletCode] || 0;
    $scope.product.edit = $scope.product.edit || {};
    $scope.product.edit[$scope.outletCode] = true;
  };

  vm.saveDisplayStock = function () {
    $scope.product.edit[$scope.outletCode] = false;
    if (vm.newDisplayStockQuantity === $scope.product.displayStock[$scope.outletCode]) return;
    FhdMessenger.success('Cập nhật xong.');
    $scope.product.displayStock[$scope.outletCode] = vm.newDisplayStockQuantity;
    console.log('vm.newDisplayStockQuantity', vm.newDisplayStockQuantity);
    console.log('$scope.outletCode', $scope.outletCode);
    console.log('$scope.product', $scope.product);
  };
}]);
