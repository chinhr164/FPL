angular.module('papers').controller('PapersController', ['$scope', '$stateParams', '$location', 'Authentication', 'Papers', 'NgTableParams', 'FhdMessenger', '$http', '$state', 'ConfirmModal', function ($scope, $stateParams, $location, Authentication, Papers, NgTableParams, FhdMessenger, $http, $state, ConfirmModal) {
  $scope.authentication = Authentication;
  $scope.user = Authentication.user;
  $scope.points = [0, 1, 2, 3, 4, 5];
  $scope.numberRightQuestions = 0;
  $scope.hasAuthorized = false;
  $scope.notesMap = {};

  $scope.bindBreakeLine = data => {
    return data.replace(/(\n)/g, '<br />&nbsp; &nbsp;');
  }; // Send question note


  $scope.sendNote = (questionId, questionNotes) => {
    let paper = $scope.paper;
    if (!paper) return FhdMessenger.error('Có lỗi load dữ liệu bài làm này.');

    if ($scope.notesMap[questionId]) {
      $http.post('/papers/' + paper._id + '/notes', {
        note: $scope.notesMap[questionId],
        questionId
      }).then(response => {
        FhdMessenger.success('Thêm nhận xét thành công');
        questionNotes = questionNotes || [];
        questionNotes.push({
          content: $scope.notesMap[questionId],
          user: $scope.user,
          time: moment().toDate()
        });
        $scope.notesMap[questionId] = null;
      }).catch(FhdMessenger.errorFromServer);
    }
  }; // Remove existing Paper


  $scope.remove = function () {
    $scope.waiting = true;
    $scope.paper.$remove({}).then(response => {
      FhdMessenger.success('Xóa bài thi thành công');
      $location.path('quizzes');
    }).finally(() => {
      $scope.waiting = true;
    });
  }; // Update existing Paper


  $scope.update = function () {
    var paper = $scope.paper;

    if (_.some(paper.questions, question => {
      return !_.isNumber(question.point);
    })) {
      return FhdMessenger.error('Có câu hỏi chưa được chẩm điểm. Bạn kiểm tra lại nhé');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ cập nhật lại điểm dựa trên đáp án hiện tại của question (Dành cho câu trắc nghiệm và điền chỗ trống). Bạn chắc chắn chứ ?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      $scope.waiting = true;
      paper.$update().then(() => {
        FhdMessenger.success('Ok!');
        $state.reload();
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        $scope.waiting = false;
      });
    });
  };

  $scope.paperTable = new NgTableParams({
    count: 50
  }, {}); // Find existing Paper

  $scope.findOne = function () {
    $scope.paper = Papers.get({
      paperId: $stateParams.paperId
    }, function () {
      $scope.paper.created = new Date($scope.paper.created);
      var created = new Date($scope.paper.created);
      var submited = new Date($scope.paper.submited);

      if (_.intersection($scope.user.roles, ['admin', 'tro-ly-ns', 'tro-ly-dt']).length) {
        $scope.hasAuthorized = true;
      }

      $scope.paper.doTime = submited - created;

      _.forEach($scope.paper.questions, question => {
        if (question.question.questionType === 'ESSAY' && question.point || question.question.questionType !== 'ESSAY' && question.point > 0) {
          $scope.numberRightQuestions += 1;
        }
      });

      _.forEach($scope.paper.questions, function (question) {
        if (question.question.questionType === 'MULTIPLE') {
          question.question.answer = _.get(_.find(question.question.answers, {
            isKey: true
          }), 'content');
        }
      });
    });
  };

  $scope.navigate = function (paper) {
    $location.path('papers/' + paper._id);
  };

  $scope.newComment = function (content) {
    let paper = $scope.paper;
    if (!paper) return FhdMessenger.error('Có lỗi load dữ liệu bài làm này.');
    $http.post('/papers/' + paper._id + '/comments', {
      content: content
    }).then(_ => {
      FhdMessenger.success('Phản hồi thành công');
      paper.comments = paper.comments || [];
      paper.comments.push({
        content,
        user: Authentication.user,
        time: new Date()
      });
    }).catch(FhdMessenger.errorFromServer);
  };

  $scope.removeComment = (_note, _question) => {
    const noteId = _note._id;
    const questionId = _question._id;
    $scope.paper.questions = _.map($scope.paper.questions, question => {
      if (_.isEqual(questionId, question._id)) {
        question.notes = _.reject(question.notes, note => _.isEqual(note._id, noteId));
      }

      return question;
    });
    $scope.paper.$update(function (paper) {
      $scope.paper = paper;
      FhdMessenger.success('Xóa comment thành công');
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  };
}]);
'use strict'; // Papers service used to communicate Papers REST endpoints

angular.module('papers').factory('Papers', ['$resource', function ($resource) {
  return $resource('papers/:paperId', {
    paperId: '@_id'
  }, {
    update: {
      method: 'PUT'
    }
  });
}]);
