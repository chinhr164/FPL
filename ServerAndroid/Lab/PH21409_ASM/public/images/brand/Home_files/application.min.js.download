angular.module('restock-lists').controller('ModalAddNoteRestockListController', ['FhdMessenger', 'restockList', 'item', '$modalInstance', function (FhdMessenger, restockList, item, $modalInstance) {
  const vm = this;
  vm.item = item;

  vm.confirm = function () {
    if (!vm.content) {
