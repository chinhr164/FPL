angular.module('reviewRanks').controller('ReviewRanksController', ['$stateParams', '$location', 'Authentication', 'ReviewRanks', function ($stateParams, $location, Authentication, ReviewRanks) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.reviewRank = {}; // Create new ReviewRank

  vm.create = function () {
    // Create new ReviewRank object
    var reviewRank = new ReviewRanks(vm.reviewRank); // Redirect after save

    reviewRank.$save(function (response) {
      $location.path('review-ranks/' + response._id); // Clear form fields

      vm.name = '';
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Remove existing ReviewRank


  vm.remove = function (reviewRank) {
    if (reviewRank) {
      reviewRank.$remove();

      for (var i in vm.reviewRanks) {
        if (vm.reviewRanks[i] === reviewRank) {
          vm.reviewRanks.splice(i, 1);
        }
      }
    } else {
      vm.reviewRank.$remove(function () {
        $location.path('review-ranks');
      });
    }
  }; // Update existing ReviewRank


  vm.update = function () {
    var reviewRank = vm.reviewRank;
    reviewRank.$update(function () {
      $location.path('review-ranks');
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of ReviewRanks


  vm.find = function () {
    vm.reviewRanks = ReviewRanks.query();
  }; // Find existing ReviewRank


  vm.findOne = function () {
    vm.reviewRank = ReviewRanks.get({
      reviewRankId: $stateParams.reviewRankId
    });
  };
}]);
"use strict";

