angular.module('thumb-ups').controller('ModalReportsBySupportStaffController', ['staffId', 'Users', '$modalInstance', 'NgTableParams', 'reports', 'ObjectId', 'ThumbUpService', 'FhdMessenger', 'startDate', 'endDate', function (staffId, Users, $modalInstance, NgTableParams, reports, ObjectId, ThumbUpService, FhdMessenger, startDate, endDate) {
  const vm = this;
  vm.hideShiftReceivedThumbUp = true;
  vm.reportsTable = new NgTableParams({
    count: 20
  });
  vm.user = Users.get({
    userId: staffId
  });
  vm.reportsTable.settings({
    dataset: reports
  });
  vm.reportsTable.sorting({
    date: 'desc'
  });

  vm.cancel = function () {
    $modalInstance.close({
      startDate,
      endDate
    });
  };

  vm.init = function () {
    vm.calcReports();
    vm.changeStatus();
  };

  vm.calcReports = function () {
    calcCheckedReports();
  };

  vm.addThumbUpModal = function (userId, options) {
    ThumbUpService.addThumbUpModal(userId, options).then(() => {
      vm.cancel();
    }).catch(error => {
      return FhdMessenger.error(error.message);
    });
  };

  const calcCheckedReports = function () {
    vm.checkedReports = _.reduce(reports, (result, report) => {
      if (report.checked && !report.employees.receivedThumbUp) {
        result.push(report);
      }

      return result;
    }, []);
    vm.amount = Math.floor(vm.checkedReports.length / 5);
    vm.showCreateThumbUp = _.get(vm.checkedReports, 'length') === 5;
    vm.showQuickCreateThumbUp = _.get(vm.checkedReports, 'length') > 5;
  };

  vm.changeStatus = function () {
    const filteredReports = _.filter(reports, report => !(vm.hideShiftReceivedThumbUp && report.employees.receivedThumbUp));

    vm.reportsTable.settings({
      dataset: filteredReports
    });
  };

  vm.checkAll = function () {
    _.forEach(vm.reportsTable.data, report => {
      report.checked = vm.checkedAll || report.employees.receivedThumbUp;
    });

    calcCheckedReports();
  };
}]);
'use strict';

angular.module('thumb-ups').controller('TableSummarySupportStaffsController', ['Authentication', 'NgTableParams', 'FhdMessenger', '$http', 'ThumbUpService', function (Authentication, NgTableParams, FhdMessenger, $http, ThumbUpService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};

  vm.init = function () {
    vm.startDate = moment().subtract(7, 'day').startOf('day').format('YYYY/MM/DD');
    vm.endDate = moment().endOf('day').format('YYYY/MM/DD');
  };

  vm.supportStaffsTable = new NgTableParams({
    count: 50
  });
  vm.waiting = false;

  vm.find = function (startDate, endDate) {
    vm.waiting = true;
    let promise = $http.get('thumb-ups/summary-support-staffs', {
      params: {
        startDate: moment(startDate).toDate(),
        endDate: moment(endDate).toDate()
      }
    }).then(({
      data
    }) => {
      vm.supportStaffsTable.settings({
        dataset: data
      });
      vm.supportStaffsTable.reload();
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
  };

  vm.openThumbUpsBySupportStaffModal = ThumbUpService.openThumbUpsBySupportStaffModal;

  vm.openTotalReportsBySupportStaffModal = function (userId, thumbUps, startDate, endDate) {
    ThumbUpService.openTotalReportsBySupportStaffModal(userId, thumbUps, startDate, endDate).then(({
      startDate,
      endDate
    }) => {
      vm.supportStaffsTable.settings({
        dataset: []
      });
      vm.find(startDate, endDate);
    });
  };
}]);
'use strict';

angular.module('thumb-ups').controller('TableSummaryThumbUpsController', ['Authentication', 'NgTableParams', 'FhdMessenger', '$http', 'ThumbUpService', function (Authentication, NgTableParams, FhdMessenger, $http, ThumbUpService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};

  vm.init = function () {
    vm.data.months = _.range(12).map(d => d + 1);
    vm.data.year = moment().year();
    vm.data.month = moment().month() + 1;
  };

  vm.thumbUpsTable = new NgTableParams({
    count: 50
  });
  vm.waiting = false;

  vm.find = function () {
    vm.waiting = true;
    let promise = $http.get('thumb-ups/summary-thumbups', {
      params: {
        month: vm.data.month - 1,
        year: vm.data.year
      }
    }).then(({
      data
    }) => {
      vm.thumbUpsTable.settings({
        dataset: data.thumbUps
      });
      vm.thumbUpsTable.reload();
      vm.time = data.time;
      vm.time.month = parseInt(vm.time.month) + 1;
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong.');
    });
  };

  vm.openThumbUpsByUserModal = ThumbUpService.openThumbUpsByUserModal;
}]);
'use strict'; // Thumb ups controller

angular.module('thumb-ups').controller('ThumbUpsController', ['$scope', '$stateParams', '$location', '$state', 'Authentication', 'ObjectId', 'ShiftEntries', 'ThumbUps', 'NgTableParams', 'FhdMessenger', function ($scope, $stateParams, $location, $state, Authentication, ObjectId, ShiftEntries, ThumbUps, NgTableParams, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.type = 'week';
  vm.staffs = [];

  vm.init = () => {
    vm.startDate = moment().startOf('month').format('YYYY-MM-DD');
    vm.endDate = moment().endOf('month').format('YYYY-MM-DD');
  };

  vm.getStaff = function (array) {
    const staffCodes = _.compact(vm.inputStaffs.split('\n'));

    const combinedCodes = _.map(staffCodes, code => code.trim().toLowerCase().replace(/(^|\s)\S/g, l => l.toUpperCase()));

    const thumbUpStaff = ShiftEntries.checkAndGetStaffs({
      query: combinedCodes
    });
    thumbUpStaff.$promise.then(staffs => {
      const mapCodeStaffs = _.map(staffs, 'code');

      const diffStaffs = _.difference(combinedCodes, mapCodeStaffs);

      if (diffStaffs.length > 0) {
        return FhdMessenger.error(`Nhân viên: ${diffStaffs.join(' ')} bị sai`);
      }

      _.forEach(staffs, staff => {
        if (!staff) return;

        const checkDuplicate = _.find(array, element => element.code === staff.code);

        if (!checkDuplicate) {
          array.push(_.cloneDeep(staff));
        }
      });

      vm.clearInput();
    });
  };

  vm.clearInput = function () {
    vm.inputStaffs = null;
  };

  vm.removeStaff = index => {
    vm.staffs.splice(index, 1);
  };

  vm.thumbUpsTable = new NgTableParams(); // Find a list of Thumb ups

  vm.find = function () {
    vm.thumbUps = ThumbUps.query({
      startDate: vm.startDate,
      endDate: vm.endDate
    });
    vm.thumbUps.$promise.then(() => {
      vm.thumbUpsTable.settings({
        dataset: vm.thumbUps
      });
    }).catch(FhdMessenger.errorFromServer);
  }; // Find existing Thumb up


  vm.findOne = function () {
    vm.thumbUp = ThumbUps.get({
      thumbUpId: $stateParams.thumbUpId
    });
  };

  vm.update = function () {
    const thumbUp = vm.thumbUp;
    thumbUp.$update(function () {
      $location.path(`thumb-ups/${thumbUp._id}`);
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  }; // Remove existing Sticket


  vm.remove = function (thumbUp) {
    vm.thumbUp.$remove(function () {
      $location.path('thumb-ups');
    });
  };

  vm.canCreateThumbUps = function () {
    if (vm.user.roles.includes('admin') || vm.user.roles.includes('tro-ly')) {
      return true;
    }
  }; // Create new Rank a point


  vm.create = function () {
    const inactiveStaffs = _.filter(vm.staffs, staff => staff.roles.includes('inactive'));

    if (inactiveStaffs.length > 0) {
      const invalidThumbUpsStaffs = _.reduce(inactiveStaffs, (result, staff) => {
        if (moment(vm.salaryDate).isAfter(staff.disabled)) {
          result.push(`${staff.code}-${staff.displayName}`);
        }

        return result;
      }, []);

      if (invalidThumbUpsStaffs.length > 0) {
        _.forEach(invalidThumbUpsStaffs, staff => {
          FhdMessenger.error(`${staff}, ngày tính lương phải trước thời gian khóa tài khoản`);
        });

        return;
      }
    }

    if (!vm.name) {
      return FhdMessenger.errors('Chưa có lý do nhận Thumb Up');
    }

    const nameLength = vm.name.split(' ').length;

    if (nameLength < 3) {
      return FhdMessenger.error('Lý do nhận thumbup tối thiểu 3 từ');
    }

    if (!vm.prizeMoney) {
      return FhdMessenger.error('Chưa có số tiền thưởng Thumb Up');
    }

    if (!vm.staffs.length) {
      return FhdMessenger.error('Chưa có nhân viên nào');
    }

    if (vm.user.roles.includes('thumb-up-budget:require')) {
      if (!vm.thumbUpBudget) {
        return FhdMessenger.error('Chưa có thumb up budget cho thumb up này');
      }
    }

    if (vm.thumbUpBudget && vm.prizeMoney * vm.staffs.length > vm.thumbUpBudget.amount) {
      return FhdMessenger.error('Tổng tiền thưởng lớn hơn quỹ thưởng đã chọn');
    }

    const mapStaffId = _.map(vm.staffs, staff => ObjectId.getObjectId(staff));

    Promise.each(mapStaffId, (staffId, index) => {
      // Create new Rank a point object
      const thumbUp = new ThumbUps({
        staff: staffId,
        name: vm.name,
        thumbUpType: vm.type,
        prizeMoney: vm.prizeMoney,
        startDate: new Date(),
        endDate: new Date(),
        salaryDate: vm.salaryDate,
        thumbUpBudget: vm.thumbUpBudget
      });
      vm.waiting = true; // Redirect after save

      return thumbUp.$save(function (response) {
        const successStaff = _.find(vm.staffs, staff => staff._id === staffId);

        vm.staffs = _.reject(vm.staffs, staff => staff._id === staffId);
        FhdMessenger.success(`Gửi thumbup thành công cho nhân viên ${successStaff.code}-${successStaff.displayName}`);
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
        FhdMessenger.error(vm.error);
      }).finally(() => {
        if (index === mapStaffId.length - 1) vm.waiting = false;
      });
    });
  };

  $scope.$watch(() => vm.staff, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    const staffId = ObjectId.getObjectId(vm.staff);
    vm.staff = null;

    const mapStaffId = _.map(vm.staffs, '_id');

    if (mapStaffId.includes(staffId) === false) {
      vm.staffs.push(newValue);
    }
  });
}]);
"use strict";

angular.module('thumb-ups').directive('fhdThumbUp', [function () {
  return {
    restrict: 'E',
    scope: {
      color: '=?'
    },
    template: `<img ng-src="/uploads/thumb-up-{{vm.color}}.jpg" alt="{{vm.name}}" />`,
    controller: ['$scope', function ($scope) {
      const vm = this;
      vm.color = $scope.color === 'red' ? 'red' : 'orange';
    }],
    controllerAs: 'vm'
  };
}]);
