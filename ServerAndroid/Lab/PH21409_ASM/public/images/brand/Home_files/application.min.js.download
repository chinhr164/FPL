angular.module('work-task-categories').controller('ModalWorkTaskCategoryController', ['$state', 'FhdMessenger', 'WorkTaskCategories', '$modalInstance', 'data', function ($state, FhdMessenger, WorkTaskCategories, $modalInstance, data) {
  const vm = this;
  vm.workTaskCategory = _.get(data, 'workTaskCategory', new WorkTaskCategories());
  vm.modalType = data.modalType;
  vm.labels = ['primary', 'default', 'info', 'warning', 'danger', 'ready', 'success'];

  vm.create = () => {
    if (!_.get(vm.workTaskCategory, 'name')) {
      return FhdMessenger.error('Chưa điền tên project');
    }

    vm.waiting = true;
    WorkTaskCategories.save(vm.workTaskCategory).$promise.then(() => {
      FhdMessenger.success('Tạo thành công');
      $modalInstance.close();
      $state.reload();
    }).catch(error => FhdMessenger.errorFromServer(error)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.update = () => {
    if (!_.get(vm.workTaskCategory, 'name')) {
      return FhdMessenger.error('Chưa điền tên project');
    }

    vm.waiting = true;
    WorkTaskCategories.update(vm.workTaskCategory).$promise.then(() => {
      FhdMessenger.success('Sửa thành công');
    }).catch(FhdMessenger.errorFromServer()).finally(() => {
      vm.waiting = false;
      $modalInstance.close();
      $state.reload();
    });
  };
}]);
