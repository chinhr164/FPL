angular.module('quotations').controller('QuotationsController', ['$location', 'Quotations', 'FileUpload', 'FhdMessenger', '$stateParams', 'ObjectId', 'Vendors', 'NgTableParams', function ($location, Quotations, FileUpload, FhdMessenger, $stateParams, ObjectId, Vendors, NgTableParams) {
  const vm = this;
  vm.uploader = FileUpload.uploadQuotation();

  vm.uploader.onSuccessItem = function (item, response) {
    vm.filePaths = vm.filePaths || [];
    vm.filePaths.push({
      filePath: response.filePath,
      fileName: response.fileName
    });

    if (_.get(vm.quotation, 'filePaths', []).length) {
      vm.quotation.filePaths.push({
        filePath: response.filePath,
        fileName: response.fileName
      });
    }

    FhdMessenger.success('Upload file thành công.');
  };

  vm.uploader.onErrorItem = function (item, error) {
    FhdMessenger.errorFromServer(error);
  };

  vm.initQuotation = () => {
    vm.data = vm.data || {};
    vm.filePaths = [];
    vm.data.vendors = Vendors.query();
  }; // Create new Quotation


  vm.create = function () {
    // Create new Quotation object
    var quotation = new Quotations({
      title: vm.title,
      filePaths: vm.filePaths,
      vendor: ObjectId.getObjectId(vm.quotation.vendor)
    }); // Redirect after save

    quotation.$save(function (response) {
      $location.path('quotations/' + response._id); // Clear form fields

      vm.title = '';
      vm.vendor = '';
      vm.uploader.queue = [];
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Remove existing Quotations


  vm.remove = function (quotation) {
    if (quotation) {
      quotation.$remove();

      for (var i in vm.quotations) {
        if (vm.quotations[i] === quotation) {
          vm.quotations.splice(i, 1);
        }
      }
    } else {
      vm.quotation.$remove(function () {
        $location.path('quotations');
      });
    }
  }; // Update existing Quotation


  vm.update = function () {
    const quotation = vm.quotation;
    quotation.$update(function () {
      // eslint-disable-line angular/document-service
      $location.path('quotations/' + quotation._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.quotationTable = new NgTableParams({
    count: 100
  });

  vm.find = function () {
    vm.quotations = Quotations.query(function (quotations) {
      vm.quotationTable.settings({
        dataset: quotations
      });
    });
  };

  vm.removeFile = function (index) {
    // vm.quotation.filePaths.splice(index, 1)
    vm.quotation.filePaths.pop();
  }; // Find existing quotation


  vm.findOne = function () {
    vm.data = vm.data || {};
    vm.data.vendors = Vendors.query();
    vm.quotation = Quotations.get({
      quotationId: $stateParams.quotationId
    });
  };
}]);
