    templateUrl: 'modules/stock-entries/views/confirm-stock-entry.client.view.html',
    resolve: {
      $title: _.constant('Confirm Logistics Entry')
    }
  }).state('stockEntriesNeedBuyingEntry', {
    url: '/stock-entries/need-buying-entry',
    templateUrl: 'modules/stock-entries/views/list-stock-entries-need-buying-entry.client.view.html',
    resolve: {
      $title: _.constant('List Stock Entries Need Buying Entry')
    }
  }).state('createConvertStockEntry', {
    url: '/create-convert-stock-entry',
    templateUrl: 'modules/stock-entries/views/create-convert-stock-entry.client.view.html',
