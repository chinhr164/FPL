angular.module('form-entries').controller('FormEntriesController', ['FormEntries', 'ConfirmModal', 'FhdMessenger', 'Authentication', function (FormEntries, ConfirmModal, FhdMessenger, Authentication) {
  const vm = this;
  vm.title = 'Hello';
  vm.formEntries = FormEntries.query({
    limit: 500
  });
  vm.filterDateStart = moment().subtract(1, 'week').format('YYYY-MM-DD');
  vm.filterDateEnd = moment().format('YYYY-MM-DD');
  vm.user = Authentication.user;

  function getFirstAnswerValue(answer) {
    return _.get(answer, 'answers.0.answerValue');
  }

  vm.find = () => {
    vm.formEntries = FormEntries.query({
      filterDateStart: vm.filterDateStart,
      filterDateEnd: vm.filterDateEnd,
      limit: 500
    });
    vm.formEntries.$promise.then(() => {
      _.forEach(vm.formEntries, formEntry => {
        formEntry.fullName = getFirstAnswerValue(_.find(formEntry.fields, {
          fieldLabel: 'Họ và tên'
        }));
        formEntry.cellphone = getFirstAnswerValue(_.find(formEntry.fields, {
          fieldLabel: 'Số điện thoại'
        }));
        formEntry.userCode = getFirstAnswerValue(_.find(formEntry.fields, {
          fieldLabel: 'Mã nhân viên (Nếu có)'
        }));
        formEntry.pointGroupMap = {};
        const groups = `Bất ổn cảm xúc	Hướng ngoại	Hòa đồng	Tự chủ	Sự trải nghiệm`.split('\t');

        _.forEach(groups, (group, index) => {
          const matchPointGroup = _.find(formEntry.pointGroups, {
            pointGroup: group
          });

          formEntry.pointGroupMap[group] = _.get(matchPointGroup, 'points');
        });
      });
    });
  };

  vm.remove = formEntry => {
    ConfirmModal.show().then(() => {
      formEntry.$remove(function () {
        const formEntriesIndex = _.findIndex(vm.formEntries, {
          _id: formEntry._id
        });

        if (formEntriesIndex > -1) vm.formEntries.splice(formEntriesIndex, 1);
      }, function (err) {
        FhdMessenger.errorFromServer(err);
      });
    });
  };

  vm.formEntries.$promise.then(() => {
    _.forEach(vm.formEntries, formEntry => {
      formEntry.fullName = getFirstAnswerValue(_.find(formEntry.fields, {
        fieldLabel: 'Họ và tên'
      }));
      formEntry.cellphone = getFirstAnswerValue(_.find(formEntry.fields, {
        fieldLabel: 'Số điện thoại'
      }));
      formEntry.userCode = getFirstAnswerValue(_.find(formEntry.fields, {
        fieldLabel: 'Mã nhân viên (Nếu có)'
      }));
      formEntry.pointGroupMap = {};
      const groups = `Bất ổn cảm xúc	Hướng ngoại	Hòa đồng	Tự chủ	Sự trải nghiệm`.split('\t');

      _.forEach(groups, (group, index) => {
        const matchPointGroup = _.find(formEntry.pointGroups, {
          pointGroup: group
        });

        formEntry.pointGroupMap[group] = _.get(matchPointGroup, 'points');
      });
    });
  });
}]);
"use strict";

