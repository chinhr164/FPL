angular.module('customers').config(['$stateProvider', function ($stateProvider) {
  // Customers state routing
  $stateProvider.state('update-customer', {
    url: '/link-customer',
    templateUrl: 'modules/customers/views/update-customer.client.view.html',
    resolve: {
      $title: _.constant('Link Customer')
    }
  }).state('searchCustomer', {
    url: '/customers/search',
