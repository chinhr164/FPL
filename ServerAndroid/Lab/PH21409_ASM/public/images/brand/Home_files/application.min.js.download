    templateUrl: 'modules/expense-sub-categories/views/view-expense-sub-category.client.view.html',
    resolve: {
      $title: _.constant('View Sub Category')
    }
  });
}]);
"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('expense-sub-categories').controller('ExpenseSubCategoryController', ['Authentication', 'ExpenseSubCategories', 'NgTableParams', 'Outlets', 'UserService', 'FhdMessenger', 'ObjectId', '$stateParams', '$state', function (Authentication, ExpenseSubCategories, NgTableParams, Outlets, UserService, FhdMessenger, ObjectId, $stateParams, $state) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.data.expenseCategories = ['Nhận thêm tiền doanh thu', 'Chi phí sửa chữa, thay thế CSVC', 'Chi phí restock', 'Cho vay', 'Chênh lệch doanh thu', 'Chi phí ship hàng', 'Chi phí cố định', 'Chưa phân loại', 'Chi phí duy trì hoạt động', 'Nhập hàng', 'Phí vận chuyển', 'Chi phí khác', 'Hoàn tiền doanh thu', 'Chi phí bán hàng', 'Chi phí R&D', 'Tài sản cố định', 'Chênh lệch doanh thu', 'Chi phí Marketting'];
  vm.expenseSubCategory = {};
  vm.expenseSubCategoryTable = new NgTableParams({}, {});

  function processToObjectId(expenseSubCategory) {
    expenseSubCategory.outlets = _.map(expenseSubCategory.outlets, ObjectId.getObjectId);
    expenseSubCategory.business = ObjectId.getObjectId(expenseSubCategory.business);
  }

  vm.find = () => {
    ExpenseSubCategories.query().$promise.then(expenseSubCategories => {
      vm.expenseSubCategories = _.map(expenseSubCategories, category => _objectSpread({}, category, {
        outlets: _.get(category.outlets, 'length', 0) ? _.map(category.outlets, 'code').join(', ') : 'Tất cả',
        positions: _.get(category.positions, 'length', 0) ? _.map(category.positions, position => vm.mapPositions[position].label).join(', ') : 'Tất cả'
      }));
      vm.expenseSubCategoryTable.settings({
        dataset: vm.expenseSubCategories
      });
      vm.expenseSubCategoryTable.sorting({
        expenseCategory: 'asc'
      });
    });
  };

  vm.init = () => {
    vm.data.outlets = Outlets.query({
      deleted: false
    });
    UserService.getRolesInTypes().then(roleTypes => {
      vm.roleTypes = roleTypes;
      vm.data.positions = _.find(vm.roleTypes, {
        id: 'positions'
      }).roles;
      vm.mapPositions = _.reduce(vm.data.positions, (result, position) => {
        result[position.id] = {
          value: _.get(vm.expenseSubCategory, 'positions', []).includes(position.id),
          label: position.label
        };
        return result;
      }, {});
    });
  };

  vm.create = () => {
    if (!vm.expenseSubCategory.name) {
      return FhdMessenger.error('Chưa có tên');
    }

    if (!vm.expenseSubCategory.expenseCategory) {
      return FhdMessenger.error('Chưa có loại khoản chi');
    }

    if (!vm.user.roles.includes('admin')) {
      return FhdMessenger.error('Bạn không có quyền tạo');
    }

    processToObjectId(vm.expenseSubCategory);

    const positions = _.reduce(vm.mapPositions, (result, data, position) => {
      if (data.value) result.push(position);
      return result;
    }, []);

    vm.expenseSubCategory.positions = positions;
    const expenseSubCategory = new ExpenseSubCategories(vm.expenseSubCategory);
    expenseSubCategory.$save().then(() => {
      FhdMessenger.success('Tạo thành công');
      vm.expenseSubCategory = {};
    }).catch(() => FhdMessenger.error('Có lỗi xảy ra'));
  };

  vm.findOne = () => {
    ExpenseSubCategories.get({
      expenseSubCategoryId: $stateParams.expenseSubCategoryId
    }).$promise.then(expenseSubCategory => {
      vm.expenseSubCategory = expenseSubCategory;
      vm.init();
    });
  };

  vm.update = () => {
    const positions = _.reduce(vm.mapPositions, (result, data, position) => {
      if (data.value) result.push(position);
      return result;
    }, []);

    vm.expenseSubCategory.positions = positions;
    vm.expenseSubCategory.$update().then(() => {
      FhdMessenger.success('Cập nhật thành công');
      $state.go('listExpenseSubCategories');
    }).catch(() => FhdMessenger.error('Có lỗi xảy ra'));
  };
}]);
'use strict';

angular.module('expense-sub-categories').factory('ExpenseSubCategories', ['$resource', function ($resource) {
  return $resource('expense-sub-categories/:expenseSubCategoryId', {
    expenseSubCategoryId: '@_id'
  }, {
    update: {
      method: 'PUT'
    }
  });
}]);
"use strict";

angular.module('explains').controller('ModalAddExplainsController', ['explainItem', '$modalInstance', 'Authentication', 'FhdMessenger', 'callback', function (explainItem, $modalInstance, Authentication, FhdMessenger, callback) {
  const vm = this;
  vm.authentication = Authentication;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.explainItem = explainItem;

  vm.close = function () {
    $modalInstance.dismiss();
  };

  vm.confirm = () => {
    if (!_.get(vm.explainItem.explain, 'content')) {
      return FhdMessenger.error('Chưa điền nội dung giải trình');
    }

    vm.explainItem.explain.user = vm.user;
    vm.explainItem.explain.time = moment().toDate();
    vm.waiting = true;
    explainItem.$explain().then(_explainItem => {
      FhdMessenger.success('Thêm giải trình thành công');

      if (_.isFunction(callback)) {
        callback();
      }

      $modalInstance.close(true);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

angular.module('explains').factory('ExplainsService', ['$modal', 'FhdMessenger', '$window', function ($modal, FhdMessenger, $window) {
  return {
    openAddExplainModal({
      explainItem,
      callback
    }) {
      return $modal.open({
        animation: true,
        controller: 'ModalAddExplainsController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: '/modules/explains/views/modal-add-explain.client.view.html',
        resolve: {
          explainItem: () => explainItem,
          callback: () => callback
        }
      }).result;
    },

    resetExplain(explainItem, next) {
      if (!_.get(explainItem, 'explain.content', null) && !_.get(explainItem, 'explain.group')) {
        return FhdMessenger.error('Chưa có giải trình');
      }

      const confirm = $window.confirm(`Bạn chắc chắn muốn reset ${explainItem.sku} (${explainItem.type}) ?`);

      if (!confirm) {
        return;
      }

      explainItem.$reset().then(response => {
        FhdMessenger.success('Reset thành công');
        explainItem = response;
        explainItem.hadAuthorization = true;

        if (_.isFunction(next)) {
          next();
        }
      }).catch(err => FhdMessenger.errorFromServer(err));
    },

    openModalCheckExplain({
      explainItem,
      callback,
      explainType
    }) {
      return $modal.open({
        animation: true,
        controller: 'ModalCheckExplainController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: '/modules/explains/views/modal-check-explain.client.view.html',
        resolve: {
          explainItem: () => explainItem,
          explainType: () => explainType,
          callback: () => callback
        }
      }).result;
    },

    getReason(explainType) {
      const reasonGroups = {
        'trash-explains': {
          'Quá date': ['Bộ phận xử lý muộn', 'Báo SC muộn', 'Thừa hàng CS', 'Buying xử lý muộn', 'Không báo SC', 'Hàng Vendor tặng'],
          'Chuột cắn': ['Lỗi bảo quản', 'HC chưa khắc phục CSVC', 'Kho chuyển hàng lỗi', 'Lưu kho tàu hỏa'],
