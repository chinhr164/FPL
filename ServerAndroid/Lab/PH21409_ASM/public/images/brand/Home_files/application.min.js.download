    getFileWorkerServiceURL() {
      return $window.FILE_WORKER_URL;
    },

    getChatwootCredentials() {
      return [$window.CHATWOOT_URL, $window.CHATWOOT_TOKEN];
    }

  };
}]);
'use strict';

angular.module('core').factory('FhdMessenger', ['toaster', function (toaster) {
  var info = function (msg) {
    toaster.info(msg);
  };

  var success = function (msg) {
    toaster.success(msg);
  };

  var error = function (msg) {
    let message;
    if (_.isString(msg)) message = msg;else if (_.isObject(msg)) message = angular.toJson(msg);else message = 'Có lỗi xảy ra.';
    toaster.pop({
      type: 'error',
      bodyOutputType: 'trustedHtml',
      showCloseButton: false,
      toastId: 'error',
      body: `<span>${message}</span>`
    });
  };

  var notifyLoading = function (msg, promise, callback = null) {
    toaster.pop({
      type: 'info',
      bodyOutputType: 'trustedHtml',
      timeout: 0,
      showCloseButton: false,
      toastId: 'notifyLoadingToastId',
      body: `<span class="blink-text">${msg}</span>`
    });
    promise.finally(() => {
      toaster.clear(undefined, 'notifyLoadingToastId');
      if (callback) callback();
    });
  };

  var errorStick = function (msg) {
    toaster.pop({
      type: 'error',
      bodyOutputType: 'trustedHtml',
      timeout: 0,
      showCloseButton: true,
      title: msg
    });
  };

  const errorWithMultiline = function (msg) {
    let _message;

    if (_.isString(msg)) {
      _message = msg;
    } else if (_.isObject(msg)) {
      _message = angular.toJson(msg);
    } else _message = 'Có lỗi xảy ra.';

    toaster.pop({
      type: 'error',
      bodyOutputType: 'trustedHtml',
      showCloseButton: true,
      toastId: 'errorWithMultiline',
      body: `<span>${_message}</span>`
    });
  };

  var errorFromServer = function (err, isMultiline = false) {
    if (!err) {
      return;
    }

    if (_.get(err, 'status') === 404) {
      const url = _.get(err, 'config.url');

      if (url) {
        return error(`Truy vấn đến ${url} nhận trạng thái 404 - Not Found!`);
      } else {
        return error(`Truy vấn trả về trạng thái 404 - Not Found`);
      }
    }

    const message = err.data ? err.data.message : err.message || err;

    if (isMultiline) {
      return errorWithMultiline(message);
    }

    return error(message);
  };

  var notifyNotice = function (notice) {
    toaster.pop({
      type: 'info',
      bodyOutputType: 'trustedHtml',
      timeout: 0,
      showCloseButton: true,
      title: notice.message
    });
  };

  var notifySticky = function (message, type, timeout) {
    toaster.pop({
      type: type || 'info',
      bodyOutputType: 'trustedHtml',
      timeout: timeout || 0,
      showCloseButton: true,
      animationClass: 'toast-top-left',
      body: message
    });
  };

  return {
    info: info,
    error: error,
    success: success,
    errorFromServer: errorFromServer,
    errorStick: errorStick,
    notifyNotice: notifyNotice,
    notifySticky: notifySticky,
    notifyLoading: notifyLoading,
    errorWithMultiline
  };
}]);
'use strict';

angular.module('core').factory('FileUpload', ['FileUploader', function (FileUploader) {
  var meeting = new FileUploader({
    url: '/upload/meetings'
  });
  var saleReport = new FileUploader({
