// eslint-disable angular/
angular.module('customers').controller('CustomersModalController', ['$modalInstance', 'Customers', 'customerData', 'FhdMessenger', 'CustomerService', 'Address', 'ObjectId', function ($modalInstance, Customers, customerData, FhdMessenger, CustomerService, Address, ObjectId) {
  const vm = this;
  vm.data = {};
  vm.customer = {
    cellphone: customerData.cellphone,
    fullName: customerData.fullName,
    date: customerData.date,
    shift: customerData.shift,
    outlet: customerData.outlet,
    address: {
      city: 'Hà Nội'
    },
    isOrder: customerData.isOrder
  };
  vm.autoCustomerId = _.get(customerData, 'autoCustomerId', false); // if (vm.autoCustomerId) {
  //   autoCreateCustomerId()
  // }

  vm.autoCreateCustomerId = autoCreateCustomerId;

  function autoCreateCustomerId() {
    vm.waiting = true;
    CustomerService.getAutoCustomerId().then(result => {
      vm.customer.customerId = result.autoCustomerId;
      vm.disableCustomerId = true;
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }

  vm.checkAutoCustomerId = function () {
    if (vm.autoCustomerId) {
      autoCreateCustomerId();
    } else {
      vm.disableCustomerId = false;
    }
  };

  vm.cancel = function () {
    $modalInstance.dismiss('cancel');
  };

  vm.districts = Address.getDistricts();

  vm.create = function () {
    const customer = new Customers(vm.customer);

    if (customer.customerId && !customer.customerId.match(/^C\w\d{7}/)) {
      return FhdMessenger.error('Mã thẻ KH không hợp lệ');
    }

    customer.shift = ObjectId.getObjectId(customer.shift);
    customer.date = moment(customer.date).startOf('day').toDate();
    customer.outlet = ObjectId.getObjectId(customer.outlet);

    if (vm.district) {
      const district = _.find(vm.districts, {
        label: vm.district
      });

      customer.address.district = _.get(district, 'district');
      customer.address.city = _.get(district, 'city');
    } else {
      customer.address.district = null;
      customer.address.city = null;
    }

    if (customer.fullName && customer.cellphone && customer.customerId && customer.address.street && customer.address.district && customer.address.city && customer.gender) {
      customer.registered = true;
      customer.registerTime = new Date();
    }

    if (customer.customerId && customer.customerId.match(/^CA\d{7}/) && !customer.indentityCardNumber) {
      return FhdMessenger.error('Đăng ký thẻ KH cần mã thẻ CMT/CCCD.');
    }

    if (customer.customerId && customer.customerId.match(/^C\w\d{7}/) && !customer.registered) {
      return FhdMessenger.error('Đăng ký thẻ KH cần điền đầy đủ thông tin.');
    }

    customer.customerId = customer.customerId || customer.cellphone;
    vm.waiting = true; // Save to database

    return customer.$save(function (response) {
      vm.waiting = false;
      $modalInstance.close(response);
    }, function (err) {
      vm.waiting = false;
      FhdMessenger.errorFromServer(err);
    });
  };
}]);
'use strict'; // Customers controller

angular.module('customers').controller('CustomersController', ['Customers', '$state', '$stateParams', 'Authentication', 'NgTableParams', 'FhdMessenger', 'SaleEntryService', 'ConfirmModal', '$http', 'CustomerService', 'VoucherService', function (Customers, $state, $stateParams, Authentication, NgTableParams, FhdMessenger, SaleEntryService, ConfirmModal, $http, CustomerService, VoucherService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.canViewRoles = ['accountant', 'admin', 'marketing', 'customers:view'];

  vm.goToCustomer = customer => {
    if (!_.intersection(vm.user.roles, vm.canViewRoles).length) {
      return FhdMessenger.error('Bạn không có quyền tìm kiếm thông tin khách hàng');
    }

    $state.go('viewCustomer', {
      customerId: customer._id
    });
  };

  vm.customerItemsTable = new NgTableParams();
  vm.customerVouchersTable = new NgTableParams();

  vm.findOne = toEdit => {
    if (!_.intersection(vm.user.roles, vm.canViewRoles).length) {
      return FhdMessenger.error('Bạn không có quyền tìm kiếm thông tin khách hàng');
    }

    vm.customer = Customers.get({
      customerId: $stateParams.customerId
    });

    if (toEdit) {
      vm.customer.$promise.then(() => {
        vm.customer.customerGroups = _.map(vm.customer.customerGroups, '_id');
      });
    }

    vm.portraits = Customers.portraits({
      customerId: $stateParams.customerId
    });
    Customers.vouchers({
      customerId: $stateParams.customerId
    }).$promise.then(vouchers => {
      vm.vouchers = vouchers;

      _.forEach(vm.vouchers, voucher => {
        voucher.voucherStatus = VoucherService.getVoucherStatus(voucher);
      });
    });

    if (_.intersection(vm.user.roles, ['sale', 'tro-ly']) && _.get(vm.user, 'outlet.code').match(/[MES]\d+/)) {
      return;
    }

    vm.saleEntries = Customers.saleEntries({
      customerId: $stateParams.customerId
    });
    vm.saleEntries.$promise.then(() => {
      vm.totalRevenue = _.sumBy(vm.saleEntries, 'order.saleTotal');
    });
    vm.items = Customers.items({
      customerId: $stateParams.customerId
    });
    vm.items.$promise.then(() => {
      vm.customerItemsTable.settings({
        dataset: vm.items
      });
    });
  };

  vm.removeVoucher = function (voucher, index) {
    if (voucher.used) {
      return FhdMessenger.error('Không thể xóa voucher đã được sử dụng');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Bạn chắc chắn muốn xoá ${voucher.name}`
    }).then(() => {
      vm.waiting = true;
      $http.delete(`/vouchers/${voucher._id}`).then(res => {
        FhdMessenger.success('Xoá thành công');
        vm.vouchers.splice(index, 1);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err.message);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.update = goToView => {
    if (vm.newNote) {
      vm.customer.notes = vm.customer.notes || [];
      vm.customer.notes.push({
        content: vm.newNote,
        time: new Date(),
        user: Authentication.user
      });
    }

    vm.waiting = true;
    vm.customer.$update().then(() => {
      FhdMessenger.success('Ok');
      vm.newNote = '';

      if (goToView) {
        $state.go('viewCustomer', {
          customerId: vm.customer._id
        });
      }
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.openSaleEntry = SaleEntryService.viewSaleEntry;
}]);
'use strict';

angular.module('customers').controller('EditCustomerModalController', ['customerId', 'Customers', 'CustomerService', 'FhdMessenger', '$modalInstance', 'Authentication', '$http', 'Address', function (customerId, Customers, CustomerService, FhdMessenger, $modalInstance, Authentication, $http, Address) {
  const vm = this;

  vm.checkAutoCustomerId = function () {
    if (vm.autoCustomerId) {
      autoCreateCustomerId();
    } else {
      vm.disableCustomerId = false;
    }
  };

  vm.autoCreateCustomerId = autoCreateCustomerId;

  function autoCreateCustomerId() {
    vm.waiting = true;
    CustomerService.getAutoCustomerId().then(result => {
      vm.customer.customerId = result.autoCustomerId;
      vm.disableCustomerId = true;
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }

  vm.user = Authentication.user;

  vm.findOne = function () {
    vm.customer = Customers.getFromCustomerId({
      customerID: customerId
    });
    vm.districts = Address.getDistricts();
    vm.customer.$promise.then(customer => {
      if (customer.password) {
        vm.disableCustomerId = true;
      }

      vm.district = _.get(_.find(vm.districts, {
        label: `${_.get(customer, 'address.district')}, ${_.get(customer, 'address.city')}`
      }), 'label') || '';

      if (customer.registered && customer.registerTime) {
        vm.registered = true;
      }

      if (!customer.customerId || !customer.customerId.match(/^C\w\d{7}/)) {
        customer.oldCustomerId = customer.customerId;
        customer.customerId = '';
      }
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.isAdmin = _.includes(vm.user.roles, 'admin') || _.includes(vm.user.roles, 'customers:edit');

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.update = function () {
    const customer = vm.customer;

    if (vm.district) {
      const district = _.find(vm.districts, {
        label: vm.district
      });

      customer.address.district = _.get(district, 'district');
      customer.address.city = _.get(district, 'city');
    } else {
      customer.address.district = null;
      customer.address.city = null;
    }

    if (customer.fullName && customer.cellphone && customer.customerId && customer.address.street && customer.address.district && customer.address.city && customer.gender) {
      if (!vm.registered) customer.registerTime = new Date();
      customer.registered = true;
    } else {
      return FhdMessenger.error('Chưa điền đầy đủ thông tin.');
    }

    if (!customer.customerId.match(/^C\w\d{7}/)) {
      return FhdMessenger.error('Mã thẻ KH không hợp lệ');
    }

    vm.waiting = true;
    return $http.put(`/customers/update-info/${customer._id}`, customer).then(response => $modalInstance.close(response.data)).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

angular.module('customers').controller('UpdateCustomerIdController', ['$scope', '$http', 'FhdMessenger', 'CustomerService', 'Authentication', function ($scope, $http, FhdMessenger, CustomerService, Authentication) {
  $scope.updateCustomer = function () {
    var outlet = Authentication.user.outlet ? Authentication.user.outlet.code : 'N/A';
    $http.post('/customers/update-customer-id', {
      cellphone: $scope.cellphone,
      customerId: $scope.customerId,
      outlet: outlet
    }).then(function (response) {
      CustomerService.refresh();
      FhdMessenger.success('Link với mã KH thành công.');
    }, function (response) {
      var data = response.data;
      FhdMessenger.errorFromServer(data);
    });
  };
}]);
