angular.module('users').component('fhdCollegeInput', {
  templateUrl: 'modules/users/templates/fhd-college-input.client.template.html',
  controller: 'FhdCollegeInputController',
  transclude: true,
  controllerAs: 'vm',
  bindings: {
    college: '=',
    disabled: '<',
    label: '@',
    labelColumn: '@',
    inputColumn: '@',
    isShow: '<'
  }
