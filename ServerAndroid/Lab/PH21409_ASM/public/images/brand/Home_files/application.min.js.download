angular.module('training-progresses').factory('TrainingProgressesService', ['$modal', function ($modal) {
  return {
    openModalViewNewTrainingProgressbyUser(trainingProgressId) {
      return $modal.open({
        templateUrl: 'modules/training-progresses/views/modal-view-training-progresses.client.view.html',
        controller: 'ModalViewTrainingProgressesController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          trainingProgressId: () => trainingProgressId
        }
      });
    },

    openModalCreateTrainingProgress(applicationForm) {
      return $modal.open({
        templateUrl: 'modules/training-progresses/views/modal-create-training-progress.client.view.html',
        controller: 'ModalCreateTrainingProgressController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          applicationForm: () => applicationForm
        }
      }).result;
    },

    isAllMarked(input, isTrainingEntry) {
      const data = isTrainingEntry ? input : input.data;
      return _.every(data, trainingEntry => {
        // default js see 0 point as false
        return !_.isUndefined(trainingEntry.point);
      });
    },

    shuffleTrainingEntryQuestion(trainingProgress) {
      // Shuffle question, init data
      _.forEach(trainingProgress.trainingEntries, trainingEntry => {
        const questionType = trainingEntry.questionType || 'essay';

        switch (questionType) {
          case 'essay':
            return;

          case 'sort':
            if (!trainingEntry.doneTime) {
              trainingEntry.sortQuestion = _.shuffle(trainingEntry.sortQuestion);
            }

            break;

          case 'chooseCorrectAnswer':
            const totalCorrectAnswer = _.filter(trainingEntry.chooseCorrectAnswer, question => {
              return question.isCorrect;
            }).length;

            trainingEntry.chooseCorrectAnswer = _.shuffle(trainingEntry.chooseCorrectAnswer);
            trainingEntry.totalCorrectAnswer = totalCorrectAnswer;

            if (!trainingEntry.doneTime) {
              _.forEach(trainingEntry.chooseCorrectAnswer, question => {
                question.userAnswer = false;
              });
            }

            break;

          case 'sortTable':
            if (!trainingEntry.doneTime) {
              trainingEntry.sortTable.groupB = _.shuffle(trainingEntry.sortTable.groupB);
            }

            break;

          default:
        }
      });
    },

    calculateProgress(trainingEntries) {
      return _.reduce(trainingEntries, (result, trainingEntry) => {
        if (result[trainingEntry.block]) {
          if (trainingEntry.done) result[trainingEntry.block].done++;
          result[trainingEntry.block].total++;
        } else {
          result[trainingEntry.block] = {
            done: 0,
            total: 0
          };
          if (trainingEntry.done) result[trainingEntry.block].done++;
          result[trainingEntry.block].total++;
        }

        return result;
      }, {});
    },

    getRoles() {
      return [{
        id: 'sale',
        name: 'Bán hàng'
      }, {
        id: 'ship',
        name: 'Ship'
      }, {
        id: 'kho',
        name: 'Kho'
      }, {
        id: 'logistic-fulltime',
        name: 'Soạn hàng Fulltime'
      }, {
        id: 'kitchen',
        name: 'Bếp'
      }, {
        id: 'packing',
        name: 'Đóng gói'
      }, {
        id: 'marketing',
        name: 'Marketing'
      }, {
        id: 'tro-ly',
        name: 'Trợ lý'
      }, {
        id: 'kitchen-3h',
        name: 'Nhân viên bếp 3h'
      }, {
        id: 'kitchen-parttime',
        name: 'Nhân viên bếp PT'
      }, {
        id: 'kitchen-fulltime',
        name: 'Nhân viên bếp FT'
      }, {
        id: 'baker-fulltime',
        name: 'Thợ bánh FT'
      }, {
        id: 'baker-parttime',
        name: 'Thợ bánh PT'
      }, {
        id: 'kitchen-porter',
        name: 'Phụ bếp'
      }].sort((a, b) => {
        return a['name'].localeCompare(b['name']);
      });
    }

  };
}]);
