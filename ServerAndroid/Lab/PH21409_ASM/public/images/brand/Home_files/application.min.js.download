  vm.dismiss = () => $modalInstance.dismiss();

  vm.archived = () => {
    const notice = 'Lưu trữ';
    $http.put(`/application-forms/${vm.applicationForm._id}/archived`).then(response => {
      const note = {
        content: `Đã chuyển trạng thái <strong>${notice}</strong>`,
        user: vm.user
      };
      $http.put(`/application-forms/${vm.applicationForm._id}/update-notes`, note).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
      FhdMessenger.success(`Đã chuyển thành trạng thái: ${notice}`);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.dismiss();
      $state.reload();
    });
  };

  vm.applicationForm = applicationForm;
  vm.applicationFormId = vm.applicationForm.applicationFormId;
}]);
