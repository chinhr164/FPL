  vm.filterToolProducts = outlet => {
    if (!_.get(outlet, 'code')) {
      return true;
    }

    if (outlet.code.match(/[SK]\d+/)) {
      vm.canChooseUrgent = true;
    } else {
      vm.canChooseUrgent = false;
    }

    const matchToolProducts = _.filter(vm.toolProducts, product => {
      const tags = _.get(product, 'tags', []);

      if (vm.canChooseUrgent && !_.some(tags, tag => tag.match(/restock B3/i))) {
        return false;
      }

      product.maxDisplayStock = _.get(product.maxDisplayStockOutlets, outlet.code, 0);

      if (outlet) {
        return !_.get(product.stopSellOutlets, outlet.code, true);
      }

      return true;
    });

    vm.toolProductsTable.settings({
      dataset: _.filter(matchToolProducts, product => {
        return product.sku.match(/(Z|LB|W|V)\d+/);
      })
    });
  };

  vm.filterKitchenProducts = outlet => {
    if (!_.get(outlet, 'code')) {
      return true;
    }

    const matchKitchenProducts = _.filter(vm.kitchenProducts, product => {
      const tags = _.get(product, 'tags', []);

      if (vm.orderB1Products && !_.some(tags, tag => tag.match(/(restock|sx) B1/i))) {
        return false;
      }

      if (outlet) {
        return !_.get(product.stopSellOutlets, outlet.code, true);
      }

      return true;
