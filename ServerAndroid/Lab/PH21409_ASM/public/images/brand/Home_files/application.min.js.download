'use strict'; // Setting up route

angular.module('announcements').config(['$stateProvider', function ($stateProvider) {
  // Announcements state routing
  $stateProvider.state('trainingAnnoucements', {
    url: '/memos/training',
    templateUrl: 'modules/announcements/views/list-training-announcements.client.view.html',
    resolve: {
      $title: _.constant('Training Memos')
    }
  }).state('listAnnouncements', {
    url: '/memos',
    templateUrl: 'modules/announcements/views/list-announcements.client.view.html',
    resolve: {
      $title: _.constant('Memos')
    }
  }).state('createAnnouncement', {
    url: '/memos/create',
    templateUrl: 'modules/announcements/views/create-announcement.client.view.html',
    resolve: {
      $title: _.constant('Create Memo')
    }
  }).state('viewAnnouncement', {
    url: '/memos/:announcementId',
    templateUrl: 'modules/announcements/views/view-announcement.client.view.html',
    resolve: {
      $title: _.constant('View Memo')
    }
  }).state('editAnnouncement', {
    url: '/memos/:announcementId/edit',
    templateUrl: 'modules/announcements/views/edit-announcement.client.view.html',
    resolve: {
      $title: _.constant('Edit Memo')
    }
  });
}]);
