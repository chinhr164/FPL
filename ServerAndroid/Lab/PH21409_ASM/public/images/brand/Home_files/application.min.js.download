      controllerAs: 'vm',
      backdrop: 'static',
      size: 'lg',
      resolve: {
        shippingEntry: () => shippingEntry
      }
    }).result,

    addDestination(shippingEntryId, destination) {
      return $http.put(`/shipping-entries/${shippingEntryId}/add-destination`, destination).then(function (response) {
        return response.data;
      });
    }

  };
}]);
