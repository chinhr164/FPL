angular.module('raw-products').controller('RawProductsController', ['Products', 'ProductService', 'Vendors', 'FhdMessenger', '$location', '$state', 'NgTableParams', 'RawProducts', 'ConfirmModal', 'Authentication', 'RolesService', function (Products, ProductService, Vendors, FhdMessenger, $location, $state, NgTableParams, RawProducts, ConfirmModal, Authentication, RolesService) {
  const vm = this;
  vm.data = {};

  vm.permitRoles = function (roles) {
    const user = Authentication.user;

    if (!RolesService.hasRoles(user, roles)) {
      $state.go('home');
    }
  };

  vm.loadVendors = () => {
    vm.data.vendors = Vendors.query();
  };

  vm.newRawSku = function () {
    ProductService.newRawSku().then(data => {
      vm.sku = data.sku;
    });
  };

  vm.create = function () {
    const product = new Products({
      sku: vm.sku,
      description: vm.description,
      category: vm.category,
      wooProperties: {
        images: _.reject(vm.images, {
          src: ''
        })
      },
      cogs: vm.cogs,
      reorderLinks: [vm.reorderLink],
      buyingCode: vm.buyingCode,
      vendor: vm.vendor,
      isRaw: vm.isRaw
    });
    product.$save(function () {
      $location.path('products/create');
      FhdMessenger.success(`Tạo SKU ${product.sku} thành công`); // Clear form fields

      vm.sku = '';
      $state.reload();
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  };

  vm.rawProductsTable = new NgTableParams({
    count: 1000
  });

  vm.find = () => {
    RawProducts.list().then(rawProducts => {
      vm.rawProducts = rawProducts;
      vm.rawProductsTable.settings({
        dataset: vm.rawProducts
      });
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.quickEditProduct = ProductService.quickEditProduct;

  vm.remove = product => ConfirmModal.showModal({}, {
    bodyText: `Bạn có chắc muốn xóa sản phẩm ${product.sku} ${product.description}?`
  }).then(() => RawProducts.remove(product).then(() => FhdMessenger.success('Đã xóa')).then(() => {
    const productIndex = _.findIndex(vm.rawProducts, {
      _id: product._id
    });

    vm.rawProducts.splice(productIndex, 1);
  }).catch(FhdMessenger.errorFromServer));
}]);
'use strict';

angular.module('raw-products').factory('RawProducts', ['$http', function ($http) {
  return {
    list: () => $http.get('raw-products').then(response => response.data),
    remove: product => $http.delete(`products/${product._id}`)
  };
}]);
