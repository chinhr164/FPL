angular.module('buying').factory('BuyingService', ['$http', 'FhdMessenger', '$modal', function ($http, FhdMessenger, $modal) {
  const VIPLv = {
    lv: 'VIP6',
    weightDiscount: 0.12,
    purchaseDiscount: 0.3
  };
  return {
    getVIPLv() {
      return VIPLv;
    },

    openBuyingModal(vendorWithInfo) {
      return $modal.open({
        size: 'lg',
        backdrop: true,
        keyboard: true,
        modalFade: true,
        templateUrl: '/modules/buying/views/modal-buying.client.view.html',
        controller: 'ModalBuyingController',
        controllerAs: 'vm',
        windowClass: 'modal-buying',
        resolve: {
          vendorWithInfo: () => vendorWithInfo
        }
      }).result;
    },

    openDirectBuyingModal(vendorWithInfo, outlet) {
      return $modal.open({
        size: 'lg',
        templateUrl: '/modules/buying/views/modal-direct-buying.client.view.html',
        controller: 'ModalDirectBuyingController',
        controllerAs: 'vm',
        windowClass: 'modal-buying',
        resolve: {
          vendorWithInfo: () => vendorWithInfo,
          outlet: () => outlet
        }
      });
    }

  };
}]);
