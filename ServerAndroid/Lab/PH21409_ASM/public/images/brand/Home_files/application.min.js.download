angular.module('sale-entries').controller('SaleEntriesController', ['$scope', '$stateParams', '$location', 'Authentication', 'BusinessService', 'BundlePricesService', 'ConfirmModal', 'ComplaintService', 'ExpenseEntryService', 'EnvironmentService', 'OnlineOrderModal', 'SaleCodeService', 'SaleEntries', '$state', 'SaleEntriesService', 'toaster', 'OutletService', 'ShiftService', 'CustomerService', 'CurrentShift', 'ObjectId', 'FhdMessenger', '$localStorage', 'ProductService', 'PromotionService', 'NgTableParams', '$window', '$timeout', 'SaleEntryService', 'OfflineMode', 'JsPrintService', 'CustomerRequestService', 'SaleCampaigns', 'SaleCampaignService', 'Customers', 'Complaints', '$q', 'helper', '$document', '$http', function ($scope, $stateParams, $location, Authentication, BusinessService, BundlePricesService, ConfirmModal, ComplaintService, ExpenseEntryService, EnvironmentService, OnlineOrderModal, SaleCodeService, SaleEntries, $state, SaleEntriesService, toaster, OutletService, ShiftService, CustomerService, CurrentShift, ObjectId, FhdMessenger, $localStorage, ProductService, PromotionService, NgTableParams, $window, $timeout, SaleEntryService, OfflineMode, JsPrintService, CustomerRequestService, SaleCampaigns, SaleCampaignService, Customers, Complaints, $q, helper, $document, $http) {
  const vm = $scope; // TOFIX: Do this to get away with eslint, refactor later

  vm.authentication = Authentication;
  vm.user = vm.authentication.user;
  vm.data = {};
  vm.isFirstSaleEntry = false;
  vm.data.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD');

  vm.getTime = () => {
    return moment().format('YYYY-MM-DD HH:mm');
  };

  vm.openModalSaleCodeDetail = SaleCodeService.openModalSaleCodeDetail;
  vm.getContentButtonUpdateReturnItem = SaleEntryService.getContentButtonUpdateReturnItem;
  vm.environment = EnvironmentService.getEnvironment();
  vm.hasCustomerCard = false;
  vm.customerRegistered = true;
  vm.receivedGift = true;
  vm.receivedM3Gift = true;
  vm.showLuckyRound = false;
  vm.reload = $state.reload;
  vm.giftLeft = 0;
  vm.currentImage = null;
  vm.offlineModeData = OfflineMode.offlineModeData;
  vm.openCreateComplaintModal = ComplaintService.openCreateComplaintModal;
  vm.viewComplaint = ComplaintService.openViewComplaintModal;
  vm.createExpenseEntry = ExpenseEntryService.createExpenseEntry;
  vm.isShowBlacklistNote = false;
  vm.data.blacklistNote = '';
  vm.totalFee = 0;

  vm.showReturnButton = function () {
    if (_.get(vm.saleEntry, 'business.code') === 'ABBY' || _.intersection(_.get(vm.user, 'roles'), ['superadmin', 'admin', 'sale-entry:edit-payment']).length) {
      return true;
    }

    return false;
  };

  vm.createOnlineOrderModal = () => {
    OnlineOrderModal.create().then(onlineOrder => {
      FhdMessenger.success('Tạo đơn Online Order thành công');
    });
  };

  vm.showNewPoint = () => {
    return _.get(vm.customer, 'availablePoint') && (vm.environment === 'development' || ['app', 'card'].includes(_.get(vm.saleEntry, 'customer.searchCustomerType')));
  };

  vm.checkBrowserNotFirefox = () => {
    if (_.includes(navigator.userAgent, 'Firefox')) {
      vm.saleEntry.staffBrowser = 'Firefox';
      return false;
    } else if (_.includes(navigator.userAgent, 'Chrome')) {
      vm.saleEntry.staffBrowser = 'Chrome';
    } else if (_.includes(navigator.userAgent, 'MSIE')) {
      vm.saleEntry.staffBrowser = 'IE';
    } else if (_.includes(navigator.userAgent, 'Safari')) {
      vm.saleEntry.staffBrowser = 'Safari';
    } else if (_.includes(navigator.userAgent, 'OP')) {
      vm.saleEntry.staffBrowser = 'Opera';
    } else {
      vm.saleEntry.staffBrowser = 'Other';
    }

    return true;
  };

  vm.complaintsTable = new NgTableParams({
    page: 1,
    count: 3
  }, {
    counts: []
  });

  vm.findComplaints = function (type) {
    vm.complaints = Complaints.query({
      types: [type],
      searchQuery: vm.saleEntry.customer.cellphone || null,
      limit: 3
    });
    vm.complaints.$promise.then(() => {
      vm.complaintsTable.settings({
        dataset: vm.complaints
      });
    });
  };

  vm.addCustomer = function (saleEntry) {
    SaleEntryService.addCustomerToSaleEntry(saleEntry).result.then(function () {
      FhdMessenger.success('Thêm thành công khách hàng');
      $state.reload();
    });
  };

  vm.updatePermissionReturnItems = function (saleEntry) {
    SaleEntryService.inputPermissionReturnItems(saleEntry).result.then(function () {
      FhdMessenger.success('Thêm quyền đổi trả thành công');
      $state.reload();
    });
  };

  vm.addBlackListNote = function () {
    if (vm.data.blacklistNote !== '') {
      vm.waiting = true;
      Customers.get({
        customerId: vm.saleEntry.customer._id
      }).$promise.then(customer => {
        customer.blacklistNotes = customer.blacklistNotes || [];
        customer.blacklistNotes.push({
          content: vm.data.blacklistNote,
          time: new Date(),
          user: vm.user
        });
        customer.$update().then(() => {
          FhdMessenger.success('Thêm blacklist thành công !');
          vm.data.blacklistNote = '';
        }).catch(FhdMessenger.errorFromServer).finally(() => {
          vm.waiting = false;
        });
      });
    }
  };

  const currentShift = CurrentShift.getCurrentShift();

  vm.selectAll = function (field) {
    const map = vm[`${field}Map`];
    let newValue = true;
    if (_.every(map)) newValue = false;

    _.forEach(map, (value, key) => {
      map[key] = newValue;
    });
  };

  vm.loadResources = function (callback) {
    vm.data.saleEntryTypes = ['SHOP', 'HN', 'TI', 'BUON', 'TT', 'NN', 'HTT'];
    vm.data.mooncakeBoxHandleOutlets = ['SHIP', 'D3'];
    if (callback) callback();
  };

  vm.loadLessResources = function (callback) {
    vm.data.saleEntryTypes = ['SHOP', 'HN', 'TI', 'BUON', 'TT', 'NN'];
    if (callback) callback();
  };

  vm.changeHandleOutlet = async function () {
    await OutletService.findOutletFromCode(vm.saleEntry.handleOutletCode).then(outlet => {
      vm.saleEntry.outlet = outlet;
    });
  };

  vm.init = async function () {
    if (!_.get(currentShift, '_id')) {
      FhdMessenger.error('Không có dữ liệu về ca trực hiện tại!');
    }

    vm.saleEntry = {
      _id: ObjectId.newObjectId(),
      outlet: currentShift.outlet,
      order: {
        discount: 0,
        usedPoint: 0,
        discounts: null,
        fees: [],
        refunds: [],
        note: null,
        saleTotal: 0
      },
      shift: ShiftService.getFromCode(currentShift.shift),
      saleEntryType: 'SHOP',
      date: currentShift.date,
      tranferCode: '',
      customer: {},
      shipping: {
        provider: null,
        address: {
          street: null,
          district: null,
          city: null
        },
        fullName: null,
        cellphone: null,
        pay: null,
        collect: null
      },
      payment: {
        method: null,
        collect: null,
        pay: null
      },
      paymentType: 'cash'
    };
    vm.saleEntry.voucher = _.last(_.get(vm.saleEntry, 'customer.vouchers', []));
    vm.saleEntry.order.subTotal = 0;
    vm.items = [];
    vm.returnItems = vm.returnItems || [];
    vm.data.shipping = 0;
    vm.data.canEditCustomer = _.includes(vm.user.roles, 'admin') || _.includes(vm.user.roles, 'tro-ly');
    const onlineOrder = $localStorage.getObject('onlineOrder') || null;

    if (angular.isArray(_.get(onlineOrder, 'items'))) {
      if (_.get(currentShift, 'outlet.autoPopulateItems')) {
        _.forEach(onlineOrder.items, item => {
          if (item.sku === 'B1128' || item.sku === 'B2472') {
            item.quantity = 0;
            notifyNeedQuantityItem(item);
          }
        });

        vm.items = _.map(onlineOrder.items, item => _objectSpread({}, item, {
          onlineOrderPrice: item.soldPrice,
          originalNoLoyalty: item.noLoyalty
        }));
      } else {
        vm.onlineOrder = onlineOrder;
      }

      $localStorage.setObject('onlineOrder', null);
      vm.saleEntry.shipping.fullName = onlineOrder.receiverCustomer.name;
      vm.saleEntry.shipping.provider = _.get(onlineOrder, 'shipping.provider');
      vm.saleEntry.order.usedPoint = _.get(onlineOrder, 'usedPoint', 0) * 10;
      vm.saleEntry.shipping.cellphone = onlineOrder.receiverCustomer.cellphone;
      vm.saleEntry.shipping.address.street = onlineOrder.receiverCustomer.street;
      vm.saleEntry.shipping.address.district = onlineOrder.receiverCustomer.district;
      vm.saleEntry.shipping.address.city = onlineOrder.receiverCustomer.city;
      vm.saleEntry.shipping.collect = _.get(onlineOrder, 'shipping.collect');
      vm.saleEntry.order.fees = [...vm.saleEntry.order.fees, ...onlineOrder.fees];
      vm.saleEntry.payment.collect = _.get(onlineOrder, 'payment.collect');
      vm.saleEntry.onlineOrder = onlineOrder;
      vm.saleEntry.status = 'open';
      vm.saleEntry.saleEntryType = _.get(onlineOrder, 'orderType');
      vm.onlineCustomer = onlineOrder.orderCustomer;
      vm.onlineOrderId = _.get(onlineOrder, 'onlineOrderId');
      vm.websiteOrderId = _.get(onlineOrder, 'websiteOrderId');

      if (_.get(onlineOrder, 'customer.customerId')) {
        vm.customerSearchSelected(onlineOrder.customer);
      }

      if (_.get(onlineOrder, 'payment.method') !== 'cod') {
        vm.saleEntry.paymentType = _.get(onlineOrder, 'payment.method');
      }

      if (onlineOrder.orderType === 'HTT') {
        await OutletService.findOutletFromCode('D3').then(outlet => {
          vm.saleEntry.outlet = outlet;
        });
        vm.saleEntry.handleOutletCode = 'D3';
      }

      vm.calculate();
    } else {
      if (_.get(currentShift, 'outlet.code') === 'SHIP' || _.get(currentShift, 'outlet.code') === 'B1') {
        FhdMessenger.error('Bạn cần sử dụng chức năng Confirm & Xếp hàng để tạo đơn.');
        return $state.go('home');
      }

      const items = $localStorage.getObject('saleEntryItems');

      if (angular.isArray(items)) {
        vm.items = items;
        vm.calculate();
      }
    }

    const mobileCustomer = $localStorage.getObject('mobileCustomer');

    if (mobileCustomer && mobileCustomer.customerId) {
      vm.customerSearchSelected(mobileCustomer);
      $localStorage.setObject('mobileCustomer', null);
    }

    vm.updateOrderNumber();
  };

  vm.updateOrderNumber = function () {
    if (vm.offlineModeData.offlineMode) {
      vm.updateSaleEntryId();
      return;
    }

    if (!vm.saleEntry.outlet || !vm.saleEntry.shift || !vm.saleEntry.date) {
      FhdMessenger.error('Không có dữ liệu về ca trực');
      return;
    }

    if (_.get(vm.saleEntry, 'onlineOrder.onlineOrderId')) {
      vm.saleEntry.orderNumber = parseInt(_.get(vm.saleEntry, 'onlineOrder.onlineOrderId'));
      vm.updateSaleEntryId();
    } else {
      SaleEntriesService.getOrderNumber().get({
        outlet: vm.saleEntry.outlet._id,
        shift: vm.saleEntry.shift.code,
        date: vm.saleEntry.date
      }, function (response) {
        vm.saleEntry.orderNumber = response.orderNumber;
        vm.updateSaleEntryId();
      });
    }
  };

  vm.updateSaleEntryId = function () {
    // Process info and prepare to send
    const date = new Date(vm.saleEntry.date);
    const dateString = moment(date).format('YYYY-MM-DD');

    if (_.get(vm.saleEntry.onlineOrder, 'onlineOrderId')) {
      vm.saleEntry.saleEntryId = _.get(vm.saleEntry.onlineOrder, 'onlineOrderId');
    } else {
      if (!vm.saleEntry.outlet) return;

      if (!vm.offlineModeData.offlineMode) {
        vm.saleEntry.saleEntryId = `${vm.saleEntry.outlet.code}_${dateString}_${vm.saleEntry.shift.code}_${vm.saleEntry.orderNumber}`;
        vm.saleEntry.offlineSaleEntryId = null;
      } else {
        vm.saleEntry.saleEntryId = `${vm.saleEntry.outlet.code}_${dateString}_${vm.saleEntry.shift.code}_Auto`;
        const uid = new Date().getTime().toString(36);
        vm.saleEntry.offlineSaleEntryId = `${vm.saleEntry.outlet.code}_${dateString}_${vm.saleEntry.shift.code}_${uid}`;
      }
    }
  };

  function resetVoucher() {
    PromotionService.resetVoucher(vm.saleEntry, vm.items);
  }

  function processVoucher() {
    PromotionService.processVoucher(vm.saleEntry.voucher, vm.saleEntry, vm.items);
  } // Customer stuff


  const checkValidCard = customer => {
    const today = moment().startOf('day');

    if (customer.registerTime) {
      const registerTime = moment(customer.registerTime).startOf('day');

      if (today.diff(registerTime, 'day') < 1) {
        return false;
      }
    }

    return true;
  };

  vm.editCustomer = function ($event, customer) {
    $event.preventDefault();
    $event.stopPropagation();

    if (customer && customer.customerId) {
      CustomerService.editCustomer(customer.customerId).result.then(customer => {
        vm.saleEntry.customer = customer;
        vm.customer = customer;
        vm.customerSearchSelected(customer);
      });
    }
  };

  vm.reloadVoucher = customer => {
    vm.saving = true;
    vm.waiting = true;
    CustomerService.getValueAndVouchers(customer.customerId).then(customer => {
      vm.waiting = false; // This object contains point and voucher values

      vm.customer = customer;

      if (vm.saleEntry.customer) {
        vm.saleEntry.customer.isStaff = customer.isStaff;
        vm.saleEntry.order.discountStaff = customer.discountStaff;
        vm.saleEntry.customer.outletCode = customer.outletCode;
        vm.saleEntry.customer.vouchers = customer.vouchers || [];
        vm.remainItemMap = customer.remainItemMap;
        vm.saleEntry.customer.created = customer.created;
        vm.saleEntry.customer.gender = customer.gender;
        vm.saleEntry.customer.vouchers = _.reject(vm.saleEntry.customer.vouchers, {
          name: 'Voucher mua hàng 100k tại Savor'
        });

        const outlet = _.get(CurrentShift.getCurrentShift(), 'outlet', {});

        const region = _.get(outlet, 'region', 'NORTH');

        if (_.get(outlet, 'code') === 'E24') {
          vm.saleEntry.customer.availableMap = customer.availableMap;
        }

        if (region === 'NORTH') {
          vm.saleEntry.customer.vouchers = _.reject(vm.saleEntry.customer.vouchers, {
            name: 'Voucher 83k sử dụng tại Savor/Abby'
          });
        }

        if (vm.saleEntry.customer.vouchers.length) {
          vm.saleEntry.customer.vouchers.push({
            _id: 'NONE',
            name: 'Không dùng voucher',
            voucherType: 'PERCENTATE',
            target: 'PRODUCT',
            products: [],
            quantity: 0
          });
          vm.saleEntry.voucher = _.last(vm.saleEntry.customer.vouchers);
        }

        if (!vm.saleEntry.customer.isStaff) {
          vm.calculate();
          return;
        }

        if (vm.saleEntry.order.discountStaff) {
          if (!['app'].includes(_.get(vm.saleEntry, 'customer.searchCustomerType'))) {
            vm.saleEntry.order.discountStaff = null;
            vm.calculate();
            return FhdMessenger.info('Vui lòng quét mã để có thể sử dụng giảm giá nhân viên');
          }

          vm.calculate();
          return FhdMessenger.success('Nhân viên được giảm giá');
        }

        vm.saleEntry.order.discountStaff = null;
        vm.calculate();
        return FhdMessenger.info('Nhân viên không được giảm giá');
      } else {
        vm.waiting = false;
        vm.saleEntry.voucher = undefined;
        resetVoucher();
        vm.calculate();
      }
    }).catch(function (response) {
      const data = response.data;
      FhdMessenger.errorFromServer(data);
    }).finally(() => {
      vm.saving = false;
    });
    SaleCampaigns.fromCustomer({
      customerId: customer.customerId
    }).$promise.then(saleCampaigns => {
      if (saleCampaigns && saleCampaigns.length) {
        vm.saleEntry.customer.saleCampaigns = saleCampaigns;
        vm.calculate();
      }
    });
  };

  vm.customerSearchSelected = function (customer) {
    if (!_.get(customer, 'customerId')) {
      vm.clearCustomer();
      return;
    }

    if (_.get(vm.saleEntry, 'onlineOrder')) {
      const customerCellphone = _.get(customer, 'cellphone', '');

      if (!$window.Cypress && _.get(vm.saleEntry, 'onlineOrder.receiverCustomer.cellphone', '') !== customerCellphone && _.get(vm.saleEntry, 'onlineOrder.orderCustomer.cellphone', '') !== customerCellphone) {
        return FhdMessenger.error('Khách hàng phải trùng SĐT với khách hàng đặt hoặc khách hàng nhận trong online order. Nếu sai SĐT khách hàng vui lòng liên hệ team code để được xử lý');
      }
    }

    vm.saleEntry.customer = customer;
    vm.saleEntry.customer.vouchers = [];

    if (_.get(vm.saleEntry, 'customer.registered') && vm.saleEntry.customer.customerId.match(/^C\w\d{7}/)) {
      vm.customerRegistered = true;
      vm.hasCustomerCard = true;
    } else {
      vm.customerRegistered = false;
      vm.hasCustomerCard = false;
    }

    if (!checkValidCard(vm.saleEntry.customer)) {
      vm.noValidCard = true;
    } else {
      vm.noValidCard = false;
    }

    vm.reloadVoucher(customer);
    vm.findComplaints('external');
  };

  vm.showCustomerType = function () {
    if (vm.saleEntry.onlineOrder) {
      return '';
    }

    if (!vm.saleEntry.customer) {
      return '';
    }

    if (_.get(vm.saleEntry, 'customer.promotion') || _.get(vm.saleEntry, 'customer.customerId', '').match(/CB/)) {
      return 'Khách dùng App';
    }

    if (_.get(vm.saleEntry, 'customer.customerId', '').match(/CA/)) {
      return 'Khách hàng dùng thẻ giấy';
    }

    return 'Khách chưa chuyển đổi';
  };

  const notifyNeedQuantityItem = item => {
    FhdMessenger.notifySticky(`
        <img src="https://abby.vn/wp-content/uploads/2016/12/mozzarella.jpg" width="200px">
        Nhập tay khối lượng ghi trên bao bì cho sản phẩm ${item.sku} ${item.description}.<br/>
        <a href="/#!/memos/57e646914fbc94be1176884f" target="_blank">
          Link hướng dẫn
        </a>
      `);
  };

  function checkLateExpiryDate(item) {
    if (item.expiryDate) {
      const today = moment().startOf('day');

      if (today.diff(item.expiryDate) > 0) {
        return true;
      }
    }

    return false;
  }

  const getOutletProperty = ProductService.getOutletProperty;

  vm.productSearchSelected = function (item) {
    if (!item) return;
    vm.saleEntry.scanHistories = vm.saleEntry.scanHistories || [];
    vm.saleEntry.scanHistories.push({
      product: item._id,
      time: moment().toDate()
    });

    if (item.saleNotifyContent) {
      FhdMessenger.notifySticky(item.saleNotifyContent);
    }

    if (item.sku.match(/R\d+/)) {
      return FhdMessenger.error(`Không được nhập mã R`);
    }

    let toLock = false;

    if (item.expiryDate && checkLateExpiryDate(item)) {
      return FhdMessenger.error(`${item.sku} ${item.description} có hạn sử dụng ${moment(item.expiryDate).format('DD/MM/YYYY')} đã quá hạn sử dụng`);
    }

    vm.productSearch = '';
    vm.currentImage = null;
    vm.currentImage = _.get(item, 'imageLink') || _.get(item, 'wooProperties.images[0].src');

    if (item.isCombo) {
      PromotionService.openComboModal(item).result.then(selectedItems => {
        const cogs = _.reduce(selectedItems, (result, selectedItem) => {
          return result + _.get(selectedItem, 'item.cogs', 0) * _.get(selectedItem, 'quantity', 1);
        }, 0);

        const newItem = _.assign({}, item, {
          product: item._id,
          quantity: item.needQuantity ? 0 : 1,
          originalPrice: item.price,
          soldPrice: _.isNumber(item.salePrice) ? item.salePrice : item.price,
          lineTotal: item.price,
          discount: 0,
          cogs,
          isCombo: true,
          bundledProducts: _.map(selectedItems, selectedItem => ({
            product: _.get(selectedItem, 'item._id'),
            sku: _.get(selectedItem, 'item.sku'),
            description: _.get(selectedItem, 'item.description'),
            quantity: _.get(selectedItem, 'quantity')
          })),
          toLock: true
        });

        newItem.onSale = newItem.soldPrice < newItem.originalPrice;
        vm.items.unshift(newItem);
        vm.calculate();
      });
      return;
    }

    if (item.needQuantity && !item.quantityFromBarcode) {
      notifyNeedQuantityItem(item);
    }

    const matchItemIndex = _.findIndex(vm.items, currentItem => {
      if (currentItem.isShockSale) {
        return false;
      }

      if (currentItem.plTaskId) {
        return currentItem.plTaskId === item.plTaskId;
      }

      if (currentItem.refId) {
        return currentItem.refId === item.refId;
      }

      return currentItem.sku === item.sku;
    });

    if (matchItemIndex > -1 && !vm.items[matchItemIndex].toLock) {
      if (item.quantityFromBarcode) {
        vm.items[matchItemIndex].quantity = helper.addDecimalNumber(vm.items[matchItemIndex].quantity, item.quantity); // vm.items[matchItemIndex].quantity += item.quantity
      } else if (item.needQuantity) {
        vm.items[matchItemIndex].quantity = 0;
      } else {
        vm.items[matchItemIndex].quantity += 1;
      }

      const oldItem = vm.items[matchItemIndex];
      vm.items.splice(matchItemIndex, 1);
      vm.items.splice(0, 0, oldItem);
    } else {
      const quantity = item.quantityFromBarcode ? item.quantity : item.needQuantity ? 0 : 1;
      let onlineOrderPrice;
      let onlineOrderNoLoyalty;
      let onlineOrderQuantity;

      if (_.get(vm.onlineOrder, 'items.length')) {
        const matchOnlineOrderItem = _.find(vm.onlineOrder.items, {
          sku: item.sku
        });

        if (matchOnlineOrderItem) {
          onlineOrderPrice = _.get(matchOnlineOrderItem, 'soldPrice', _.get(matchOnlineOrderItem, 'originalPrice'));
          onlineOrderNoLoyalty = _.get(matchOnlineOrderItem, 'noLoyalty', false);
          onlineOrderQuantity = _.get(matchOnlineOrderItem, 'quantity', false);
        }
      }

      let salePrice = getOutletProperty('salePrice', _.get(currentShift, 'outlet'), item);

      if (item.saleCode) {
        salePrice = item.salePrice;
      }

      const price = getOutletProperty('price', _.get(currentShift, 'outlet'), item);

      if (salePrice >= price) {
        salePrice = null;
      }

      const cogs = getOutletProperty('cogs', _.get(currentShift, 'outlet'), item);
      const clearanceSale = getOutletProperty('clearanceSale', _.get(currentShift, 'outlet'), item);
      let almostExpired;

      if (item.expiryDate && item.shelfLife) {
        if (item.shelfLife < 30) {
          almostExpired = moment(item.expiryDate).diff(moment(), 'day') < 7;
        } else if (moment(item.expiryDate).diff(moment(), 'day') < 14) {
          almostExpired = true;
        }

        if (almostExpired) {
          FhdMessenger.error(`Sản phẩm ${item.sku} - ${item.description} là hàng cận date. Cơ sở nhớ báo cho khách nhé`);
        }
      }

      const newItem = _.assign({}, item, {
        product: item._id,
        quantity,
        originalPrice: price,
        soldPrice: salePrice || price,
        onlineOrderNoLoyalty,
        onlineOrderQuantity,
        clearanceSale,
        price,
        almostExpired,
        cogs,
        salePrice,
        onlineOrderPrice,
        lineTotal: 0,
        discount: 0,
        toLock
      });

      newItem.onSale = newItem.soldPrice < newItem.originalPrice;
      if (item.needQuantity && !item.quantityFromBarcode) item.quantity = 0;
      vm.items.unshift(newItem);
    }

    vm.calculate();
  };

  function calculateLineTotal(saleEntry, items) {
    _.forEach(items, item => {
      item.lineTotal = item.soldPrice * item.quantity - item.discount;
    });
  }

  function calculateSaleTotal(saleEntry, items) {
    let subTotal = 0;
    let originalTotal = 0;

    _.forEach(items, item => {
      item.lineTotal = item.soldPrice * item.quantity - item.discount || 0;
      subTotal += item.lineTotal;
      originalTotal += item.originalPrice * item.quantity;
    });

    const returnItemsTotal = _.reduce(vm.returnItems, (result, item) => {
      return result + item.lineTotal;
    }, 0);

    saleEntry.order.returnItemsTotal = returnItemsTotal;
    saleEntry.order.subTotal = subTotal - returnItemsTotal;
    saleEntry.order.saleTotal = saleEntry.order.subTotal - (saleEntry.order.discount || 0) - (saleEntry.order.usedPoint || 0);
    saleEntry.order.discountPercent = (saleEntry.order.saleTotal / (originalTotal > 0 ? originalTotal : 1) * 10).toFixed(2);
    vm.calculateForPartnership(vm.saleEntry);
  }

  function resetBasePrice(items) {
    const itemQuantityMap = _.reduce(items, (result, item) => {
      result[item.sku] = result[item.sku] || 0;
      result[item.sku] += item.quantity;
      return result;
    }, {});

    _.forEach(items, item => {
      if (item.toLock) return;
      if (item.isShockSale) return;
      if (item.quantity < 0) item.quantity = -item.quantity;

      if (item.onlineOrderQuantity && itemQuantityMap[item.sku] >= item.onlineOrderQuantity) {
        item.soldPrice = item.onlineOrderPrice;
        item.noLoyalty = item.onlineOrderNoLoyalty || item.originalNoLoyalty || false;
      } else {
        item.soldPrice = item.salePrice || item.originalPrice;
        item.noLoyalty = item.originalNoLoyalty || false;
      }

      if (item.saleCode) {
        item.soldPrice = item.salePrice;
      }

      item.onSale = !!item.salePrice;
      item.discount = 0;
      item.saleProgram = '';
      item.lineTotal = item.soldPrice * item.quantity - item.discount;
      item.isWholesale = SaleEntryService.getIsWholesale(item);

      if (_.isFinite(item.maxQuantityPerOnlineOrder) && item.maxQuantityPerOnlineOrder > 0 && item.quantity > item.maxQuantityPerOnlineOrder) {
        FhdMessenger.error(`Sản phẩm ${item.description} có số lượng mua tối đa là ${item.maxQuantityPerOnlineOrder} mỗi lần`);
        item.quantity = item.maxQuantityPerOnlineOrder;
      }

      if (_.isNumber(_.get(item, 'saleCodeObject.quantity'))) {
        item.quantity = Math.min(item.quantity, _.get(item, 'saleCodeObject.quantity'));
      }
    });
  }

  function resetOnSale(items) {
    _.forEach(items, item => {
      if (item.soldPrice < item.price) {
        item.onSale = true;
      } else {
        item.onSale = false;
      }
    });
  }

  vm.inputQuantity = function (event) {
    if ([190, 110].includes(event.keyCode)) {
      FhdMessenger.error('Không thể nhập số thập phân ở đây!');
      event.preventDefault();
    }
  };

  vm.calculate = function (oldEntry) {
    try {
      if (vm.editing || oldEntry) {
        calculateSaleTotal(vm.saleEntry, vm.items);
        return;
      }

      const outlet = _.get(CurrentShift.getCurrentShift(), 'outlet', {});

      const region = _.get(outlet, 'region', 'NORTH');

      vm.saleEntry.order.subTotal = 0; // Reset voucher

      resetVoucher(); // Reset to base price

      resetBasePrice(vm.items); // Reset on sale

      resetOnSale(vm.items); // Notify of big quantity

      _.forEach(vm.items, item => {
        if (item.maxQuantityPerSaleEntry > 0 && item.maxQuantityPerSaleEntry < item.quantity) {
          FhdMessenger.errorStick(`Sản phẩm ${item.sku} ${item.description} được mua quá số lượng ${item.maxQuantityPerSaleEntry}. Thu ngân gọi điện cho anh Dũng (0127 2768 688) để giải quyết.`);
        }
      });

      const itemQuantityMap = _.reduce(vm.items, (result, item) => {
        result[item.sku] = result[item.sku] || 0;
        result[item.sku] += item.quantity;
        return result;
      }, {}); // Giá sỉ bánh kẹo tết


      const catName = 'Bánh kẹo Tết';

      const totalLunarNewYearItemQuantity = _.sumBy(vm.items, item => {
        if (_.get(item, 'category.cat.name') === catName && item.description.includes('1kg')) {
          return item.quantity;
        }

        return 0;
      });

      const jarSkus = PromotionService.getJarSkus();

      const totalJarItemValue = _.sumBy(vm.items, item => {
        if (jarSkus.includes(item.sku)) {
          return item.price * item.quantity;
        }

        return 0;
      }); // Notify of wholesale product


      _.forEach(vm.items, item => {
        item.nearestBundlePrice = null;
        const bundlePrices = BundlePricesService.getBundlePrices(item, region, outlet, _.get(vm.onlineOrder, 'source'));
        let totalQuantity = itemQuantityMap[item.sku];

        if (_.get(item, 'category.cat.name') === catName && item.description.includes('1kg')) {
          totalQuantity = totalLunarNewYearItemQuantity;
        }

        item = BundlePricesService.processBundlePrices({
          item,
          bundlePrices,
          totalQuantity,
          totalJarItemValue,
          jarSkus
        });
        item = BundlePricesService.processNoLoyaltyByBundlePrices({
          item,
          bundlePrices
        }); // Find the bundlePrice with the least quantity of all bundlePrices but also greater than item.quantity

        item.nearestBundlePrice = BundlePricesService.getNearestBundlePrices({
          item,
          bundlePrices,
          totalQuantity
        });
      }); // Voucher stuff


      if (_.get(vm.saleEntry, 'voucher._id')) {
        processVoucher();
      } // if (
      //   ['app'].includes(_.get(vm.saleEntry, 'customer.searchCustomerType')) &&
      //   _.some(vm.items, { sku: 'B5916' })
      // ) {
      //   _.forEach(vm.items, (item) => {
      //     if (item.sku === 'B6263') {
      //       item.discount = item.soldPrice - 29000
      //     }
      //   })
      // }


      if (_.get(vm.saleEntry, 'customer.saleCampaigns.length')) {
        SaleCampaignService.processSaleCampaigns(vm.items, vm.saleEntry.customer.saleCampaigns);
      }

      if ( // ['app'].includes(_.get(vm.saleEntry, 'customer.searchCustomerType')) &&
      outlet.code === 'E24' && !_.get(vm.saleEntry, 'onlineOrder') && !_.get(vm.saleEntry, 'order.discountStaff')) {
        vm.items = PromotionService.processPromotionCustomerUseApp(vm.items, _.cloneDeep(_.get(vm.saleEntry, 'customer.availableMap', {})));
      }

      if (_.get(vm.saleEntry, 'order.discountStaff') && !_.get(vm.saleEntry, 'voucher.created')) {
        _.forEach(vm.items, function (item) {
          if (item.isWholesale) return;
          if (item.quantity <= 0) return;
          item.discount = item.soldPrice * item.quantity * 10 / 100;
          item.onSale = true;
          item.noLoyalty = true;
        });
      } // if (_.get(vm.saleEntry, 'customer.isStaff')) {
      //   vm.items = PromotionService.processAbbyGiftForStaff(vm.items, vm.remainItemMap, region)
      // }


      calculateLineTotal(); // // Sale shock price handling

      const {
        numShockPriceItems,
        shockPriceMessage,
        shockPriceItems
      } = PromotionService.processShockSalePrice(vm.items, outlet);
      vm.numShockPriceItems = numShockPriceItems;
      vm.shockPriceMessage = shockPriceMessage;
      vm.items = shockPriceItems;
      const {
        monthlyShockPriceMessage,
        monthlyShockPriceItems
      } = PromotionService.processMonthlyShockSalePrice(vm.items, outlet);
      vm.monthlyShockPriceMessage = monthlyShockPriceMessage;
      vm.items = monthlyShockPriceItems;

      if (['NORTH'].includes(region)) {
        const {
          creamCheeseMessage,
          items
        } = PromotionService.processComboGift(vm.items, region, outlet);
        vm.creamCheeseMessage = creamCheeseMessage;
        vm.items = items;
      }

      vm.items = PromotionService.processPromotionLunarNewYear(vm.items); // Calculate sale total without shockSale

      vm.saleTotalWithoutShockSale = _.reduce(vm.items, (result, item) => {
        if (item.isShockSale) return result;
        result = result + item.lineTotal;
        return result;
      }, 0);
      calculateSaleTotal(vm.saleEntry, vm.items);

      if (vm.saleEntry.order.discountStaff && !_.get(vm.saleEntry, 'voucher.created') && vm.saleEntry.order.saleTotal > vm.discountStaffLimit) {
        _.forEach(vm.items, item => {
          item.discount = 0;
        });

        resetVoucher();
        calculateLineTotal();
        calculateSaleTotal(vm.saleEntry, vm.items);
        FhdMessenger.error(`Đơn hàng vượt quá mức: ${vm.discountStaffLimit}đ.`);
      }

      if (vm.saleEntry.order.saleTotal < 0) {
        vm.saleEntry.order.saleTotal = 0;
      }

      vm.totalFee = _.reduce(vm.saleEntry.order.fees, (result, fee) => {
        result += parseInt(fee.value);
        return result;
      }, 0);
      vm.saleEntry.total = vm.saleEntry.order.saleTotal + _.get(vm.saleEntry, 'shipping.collect', 0) + _.get(vm.saleEntry, 'payment.collect', 0) + (parseInt(vm.totalFee) || 0);
      vm.availableGifts = PromotionService.getAvailableGifts({
        items: vm.items,
        saleEntry: vm.saleEntry,
        isFirstSaleEntry: vm.isFirstSaleEntry
      });

      if (_.some(vm.gifts, gift => {
        const skus = _.get(vm.availableGifts, 'sku');

        return !_.includes(skus, gift.sku);
      })) {
        vm.gifts = [];
      }

      if (!_.get(vm.availableGifts, 'length', 0)) {
        vm.gifts = [];
        vm.availableGifts = [];
      } else {
        vm.gift = _.head(vm.availableGifts);
        vm.changeGift(vm.gift);
      }

      $localStorage.setObject('saleEntryItems', _.clone(vm.items));
    } catch (error) {
      vm.saleEntry.order.saleTotal = 0;
      vm.saleEntry.total = 0;
      vm.saving = true;
      FhdMessenger.error(error);
      FhdMessenger.error('Có lỗi khi tính tiền trong sale entry. Vui lòng liên hệ team Tech theo SĐT 0328590515 để được xử lý');
    }
  };

  vm.calculateForPartnership = saleEntry => {
    if (!saleEntry.referrer) {
      return;
    }

    let saleTotal = saleEntry.order.saleTotal;
    let commissionPercentage = saleEntry.partnership.commissionPercentage;
    let conmissionAmount = saleTotal * commissionPercentage;

    if (saleEntry.referrer === 'NOW') {
      saleEntry.partnership.commissionAmount = conmissionAmount;
      saleEntry.partnership.receivableAmount = saleEntry.order.saleTotal - saleEntry.partnership.commissionAmount;
      saleEntry.payments[0].amount = saleEntry.partnership.receivableAmount;
    } else if (['GRAB_FOOD', 'BAEMIN', 'BE_FOOD', 'GO_FOOD'].includes(saleEntry.referrer)) {
      saleEntry.partnership.commissionableAmount = conmissionAmount;
      saleEntry.partnership.receivableAmount = saleEntry.order.saleTotal;
      saleEntry.payments[0].amount = saleTotal;
    } else if (saleEntry.referrer === 'DINOS') {
      saleEntry.partnership.commissionableAmount = conmissionAmount;
      saleEntry.payments[0].amount = saleTotal;
    }
  };

  vm.changeGift = function (gift) {
    if (_.get(gift, 'skus', null)) {
      vm.gifts = gift.skus;
      return;
    }

    if (!_.get(gift, 'sku', '')) {
      vm.gifts = [];
      return;
    }

    vm.gifts = [gift];
  };

  vm.removeItem = function (index) {
    vm.items.splice(index, 1);
    vm.calculate();
  };

  vm.removeItems = function () {
    ConfirmModal.showModal({}, {
      bodyText: 'Bạn có chắc chắn muốn xóa hết sản phẩm không?'
    }).then(() => {
      vm.items = [];
      vm.calculate();
    });
  };

  vm.calculateTotalFee = function () {
    vm.totalFee = _.reduce(vm.saleEntry.order.fees, (result, fee) => {
      result += parseInt(fee.value);
      return result;
    }, 0);
  };

  vm.openAddBillNumberModal = saleEntry => {
    SaleEntryService.openAddBillNumberModal(saleEntry).result.then(saleEntry => {
      vm.saleEntry = saleEntry;
    });
  };

  vm.openFindCustomerRequest = () => {
    const currentShift = CurrentShift.getCurrentShift();

    const outlet = _.get(currentShift, 'outlet', null);

    SaleEntryService.openFindCustomerRequestModal(outlet).then(result => {
      if (result.success) {
        vm.customerRequest = result.customerRequest;
      }
    });
  };

  vm.printReceipt = function () {
    if ($window.Cypress) return;
    const customStyle = true;
    const autoPrint = true;

    if (_.get(vm.saleEntry, 'business.code') === 'SAVOR') {
      JsPrintService.printElementById('receipt-table-savor', autoPrint, customStyle);
    } else {
      JsPrintService.printElementById('receipt-table', autoPrint, customStyle);
    }
  };

  vm.printItems = function () {
    if ($window.Cypress) return;

    if (_.some(vm.items, item => {
      return !item.quantity;
    })) {
      return FhdMessenger.error('Có sản phẩm chưa có số lượng trong sale entry');
    }

    if (_.some(vm.items, item => {
      return !item.soldPrice;
    })) {
      return FhdMessenger.error('Có sản phẩm chưa có giá bán trong sale entry');
    }

    const customStyle = true;
    const autoPrint = true;
    JsPrintService.printElementById('print-items', autoPrint, customStyle);
  };

  function processObjectId(saleEntry) {
    if (_.get(vm.returnItems, 'length')) {
      saleEntry.order.returnItems = _.clone(vm.returnItems);
    }

    if (_.get(saleEntry, 'returnSaleEntry')) {
      vm.items.push(..._.reduce(vm.returnItems, (result, returnItem) => {
        if (!_.some(vm.items, item => {
          return item.sku === returnItem.sku && item.quantity === -returnItem.returnQuantity && item.isReturned;
        })) {
          result.push(_objectSpread({}, returnItem, {
            quantity: -returnItem.returnQuantity,
            lineTotal: -returnItem.lineTotal,
            isReturned: true,
            toLock: true
          }));
        }

        return result;
      }, []));
    }

    saleEntry.order.items = _.cloneDeep(vm.items);
    saleEntry.outlet = ObjectId.getObjectId(saleEntry.outlet);
    saleEntry.shift = ObjectId.getObjectId(saleEntry.shift);

    if (saleEntry.customerRequest) {
      saleEntry.customerRequest = ObjectId.getObjectId(saleEntry.customerRequest);
    }

    if (_.get(saleEntry.customer, '_id')) {
      if (!_.get(saleEntry, 'order.searchCustomerType')) {
        saleEntry.order.searchCustomerType = _.get(saleEntry, 'customer.searchCustomerType', 'cellphone');
      }

      if (!_.get(saleEntry, 'order.searchText')) {
        saleEntry.order.searchText = _.get(saleEntry, 'customer.searchText', '');
      }

      saleEntry.customer = ObjectId.getObjectId(saleEntry.customer);
    } else delete saleEntry.customer;

    if (saleEntry.voucher) saleEntry.voucher = ObjectId.getObjectId(saleEntry.voucher);
    if (saleEntry.voucher === 'NONE') delete saleEntry.voucher;
  } // Create new Sale entry


  vm.create = function () {
    if (!vm.saleEntry.outlet || !vm.saleEntry.shift || !vm.saleEntry.date) {
      return FhdMessenger.error('Chưa có thông tin về ca trực hiện tại');
    }

    if (vm.offlineModeData.offlineMode) {
      return FhdMessenger.error('Chức năng thanh toán offline đã bị khóa. Liên hệ kĩ thuật nếu bạn gặp vấn đề về mạng.');
    }

    if (!vm.items.length && !vm.returnItems.length && !vm.gifts.length) {
      FhdMessenger.error('Đơn hàng chưa có một sản phẩm nào?');
      return;
    } // if (_.get(vm, 'returnItems.length') && !vm.saleEntry.customer) {
    //   return FhdMessenger.error(
    //     'Đơn hàng không đủ điều kiện đổi trả do không có thông tin khách hàng'
    //   )
    // }


    if (_.get(vm, 'saleEntry.order.usedPoint', 0) < 0) {
      return FhdMessenger.error('Giá trị điểm sử dụng phải lơn hơn hoặc bằng 0');
    }

    if (_.get(vm, 'saleEntry.order.usedPoint', 0) > Math.max(_.get(vm, 'saleEntry.order.subTotal', 0) - _.get(vm, 'saleEntry.order.discount', 0), 0)) {
      return FhdMessenger.error('Giá trị điểm sử dụng phải nhỏ hơn giá trị đơn hàng');
    }

    if (vm.onlineOrder && vm.onlineOrder.items.length) {
      const saleEntryNotLock = _.reject(vm.items, item => {
        return !item.isCombo && item.toLock;
      });

      const saleEntryMap = _.reduce(saleEntryNotLock, (result, item) => {
        result[item.sku] = result[item.sku] || 0;
        result[item.sku] += item.quantity;
        return result;
      }, {});

      const onlineOrderMap = _.reduce(vm.onlineOrder.items, (result, item) => {
        result[item.sku] = result[item.sku] || {
          quantity: 0,
          sku: item.sku,
          description: item.description
        };
        result[item.sku].quantity += item.quantity;
        return result;
      }, {});

      const onlineOrderWrongItems = _.reduce(_.values(onlineOrderMap), (result, item) => {
        if (Math.abs(_.get(saleEntryMap, item.sku, 0) - item.quantity) > 0.5) {
          result.push({
            sku: item.sku,
            description: item.description,
            onlineOrderQuantity: item.quantity,
            saleEntryQuantity: _.get(saleEntryMap, item.sku, 0)
          });
        }

        return result;
      }, []);

      if (onlineOrderWrongItems.length > 0) {
        _.forEach(onlineOrderWrongItems, item => {
          let content = ``;

          if (item.saleEntryQuantity === 0) {
            content = `Sản phẩm ${item.sku} - ${item.description} trong Online Order chưa có trong Sale Entry`;
          } else {
            content = `Sản phẩm ${item.sku} - ${item.description} có số lượng trong Sale Entry là ${item.saleEntryQuantity} khác số lượng trong Online Order là ${item.onlineOrderQuantity}`;
          }

          FhdMessenger.errorStick(content);
        });

        return;
      }
    } // checkValidMooncakeGifts()


    if (vm.saleTotalWithoutShockSale < 100000 && _.some(vm.items, item => {
      return item.isShockSale;
    })) {
      return FhdMessenger.error('Đơn hàng dưới 100k và trong đơn hàng có sản phẩm được sale giá shock');
    }

    vm.now = moment().format('L LT'); // Create new Sale entry object

    $q((resolve, reject) => {
      if (vm.saleEntry.onlineOrder) {
        if (_.includes(['momo', 'shopeepay', 'vnpay'], vm.saleEntry.paymentType)) {
          vm.saleEntry.partnership = {
            provider: vm.saleEntry.paymentType,
            receivableAmount: vm.saleEntry.order.saleTotal
          };
        }

        if (vm.customerRequest) {
          vm.saleEntry.customerRequest = vm.customerRequest;
        }

        resolve(vm.saleEntry);
      } else {
        resolve(SaleEntryService.openAddPaymentSaleEntryModal(vm.saleEntry, vm.customerRequest));
      }
    }).then(paymentSaleEntry => {
      vm.saving = true;
      const saleEntry = new SaleEntries(paymentSaleEntry);
      vm.cashReceived = saleEntry.cashReceived;
      vm.totalDeposit = 0;
      saleEntry.order.gifts = _.filter(vm.gifts, gift => {
        return _.get(gift, 'sku');
      });

      if (saleEntry.customerRequest) {
        vm.totalDeposit = saleEntry.customerRequest.totalDeposit;
        saleEntry.order.deposit = vm.totalDeposit;
      }

      processObjectId(saleEntry); // Tính số lượng voucher khách còn lại

      vm.numOfVouchers = 0;

      if (saleEntry.customer) {
        // Mảng vouchers luôn có 1 item là không chọn voucher nên phải trừ 1 mới ra
        // tổng số lượng voucher hiện tại
        const totalNumVouchers = _.get(saleEntry, 'customer.vouchers.length', 0) - 1;
        vm.numOfVouchers = totalNumVouchers - (saleEntry.voucher ? 1 : 0);
      } // Redirect after save


      saleEntry.$save(function (newSaleEntry) {
        _.assign(vm.saleEntry, {
          cashier: newSaleEntry.cashier,
          saleEntryId: newSaleEntry.saleEntryId,
          orderNumber: newSaleEntry.orderNumber,
          createdAt: newSaleEntry.createdAt
        });

        vm.hasNoLoyaltyItem = _.some(vm.saleEntry.order.items, {
          noLoyalty: true
        });
        $timeout(() => {
          vm.printReceipt();
          $state.reload();
          $localStorage.setObject('saleEntryItems', []);
          toaster.success('Tạo đơn hàng thành công!'); // Clear form fields

          vm.items = '';
          vm.saving = false;
        });
      }, error => {
        FhdMessenger.errorFromServer(error);
        vm.saving = false;
      });
    });
  }; // Remove existing Sale entry


  vm.remove = function (saleEntry) {
    if (saleEntry) {
      SaleEntryService.openDeleteSaleEntryModal(saleEntry);
    } else {
      SaleEntryService.openDeleteSaleEntryModal(vm.saleEntry);
    }
  }; // Update existing Sale entry


  vm.update = function () {
