      vm.vouchers = response.data;

      _.forEach(vm.vouchers, voucher => {
        voucher.voucherStatus = VoucherService.getVoucherStatus(voucher);
      });
    });
  };

  vm.viewListVouchers = SaleEntryService.viewListVouchers;
