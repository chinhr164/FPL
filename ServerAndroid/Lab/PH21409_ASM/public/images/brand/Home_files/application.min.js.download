angular.module('staff-salary-monthly-reports').controller('StaffSalaryMonthlyReportsController', ['$scope', '$stateParams', '$location', 'Authentication', 'ConfirmModal', 'NgTableParams', 'StaffSalaryMonthlyReports', '$http', 'FhdMessenger', '$modal', function ($scope, $stateParams, $location, Authentication, ConfirmModal, NgTableParams, StaffSalaryMonthlyReports, $http, FhdMessenger, $modal) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.endDate = moment().format('YYYY-MM-DD');
  vm.startDate = moment(vm.endDate).subtract(1, 'month').format('YYYY-MM-DD');
  vm.staffSalaryMonthlyReportsTable = new NgTableParams({
    count: 100
  });
  vm.complaintedStaffSalaryMonthlyReportsTable = new NgTableParams({
    count: 100
  });
  vm.complaintContent = ``;
  vm.doneComplaintContent = ``;
  $scope.$watch(() => vm.staffSalaryMonthlyReportsTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.totalSalary = _.sumBy(newValue, 'actualSalary');
  });
  const numRepayDate = 120;

  vm.showRepayDate = (employeeDate, startDate, position) => {
    if (position && position.match(/collaborator/gim)) {
      return false;
    }

    return employeeDate && startDate && moment(employeeDate).add(numRepayDate, 'day').isAfter(moment(startDate));
  };

  vm.getRepayDate = date => {
    return moment(date).add(120, 'day').toDate();
  };

  vm.confirm = function () {
    ConfirmModal.showModal({}, {
      bodyText: `Bạn muốn xác nhận bảng lương này?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      if (!vm.doc) return;
      vm.waiting = true;
      $http.get('/staff-salary-monthly-reports/' + vm.doc._id + '/confirm').then(function () {
        vm.waiting = false;
        vm.doc.confirmed = true;
      }, function (response) {
        var data = response.data;
        vm.waiting = false;
        FhdMessenger.errorFromServer(data);
      });
    });
  };

  vm.findMine = function () {
    $http.get('/staff-salary-monthly-reports/my-reports').then(function (response) {
      vm.staffSalaryMonthlyReports = response.data;
    }, function (response) {
      var data = response.data;
      FhdMessenger.errorFromServer(data);
    });
  }; // Remove existing Staff salary monthly report


  vm.remove = function (staffSalaryMonthlyReport) {
    if (staffSalaryMonthlyReport) {
      staffSalaryMonthlyReport.$remove();

      for (var i in vm.staffSalaryMonthlyReports) {
        if (vm.staffSalaryMonthlyReports[i] === staffSalaryMonthlyReport) {
          vm.staffSalaryMonthlyReports.splice(i, 1);
        }
      }
    } else {
      vm.doc.$remove(function () {
        $location.path('staff-salary-monthly-reports');
      });
    }
  }; // Update existing Staff salary monthly report


  vm.complaint = function () {
    var staffSalaryMonthlyReport = vm.doc;

    if (!staffSalaryMonthlyReport.complaintContent) {
      return FhdMessenger.error('Chưa có nội dung khiếu nại');
    }

    staffSalaryMonthlyReport.$complaint(function () {
      $location.path('staff-salary-monthly-reports/' + staffSalaryMonthlyReport._id);
      vm.complaintContent = '';
      FhdMessenger.success('Khiếu nại thành công');
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.doneComplaint = function () {
    var staffSalaryMonthlyReport = vm.doc;

    if (!staffSalaryMonthlyReport.doneComplaintContent) {
      return FhdMessenger.error('Chưa có nội dung hoàn thành khiếu nại');
    }

    staffSalaryMonthlyReport.$doneComplaint(function () {
      $location.path('staff-salary-monthly-reports/' + staffSalaryMonthlyReport._id);
      vm.complaintContent = '';
      FhdMessenger.success('Hoàn thành khiếu nại thành công');
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Find a list of Staff salary monthly reports


  vm.find = function () {
    vm.waiting = true;
    vm.staffSalaryMonthlyReports = StaffSalaryMonthlyReports.query({
      startDate: vm.startDate,
      endDate: vm.endDate
    });
    vm.staffSalaryMonthlyReports.$promise.then(reports => {
      vm.staffSalaryMonthlyReportsTable.settings({
        dataset: reports
      });
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Find a list of Staff salary monthly reports


  vm.findComplaint = function () {
    vm.waiting = true;
    vm.staffSalaryMonthlyReports = StaffSalaryMonthlyReports.findComplaint({
      startDate: vm.startDate,
      endDate: vm.endDate
    });
    vm.staffSalaryMonthlyReports.$promise.then(reports => {
      vm.complaintedStaffSalaryMonthlyReportsTable.settings({
        dataset: reports
      });
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Find existing Staff salary monthly report


  vm.findOne = function () {
    vm.doc = StaffSalaryMonthlyReports.get({
      staffSalaryMonthlyReportId: $stateParams.staffSalaryMonthlyReportId
    });
  };
}]);
"use strict";

