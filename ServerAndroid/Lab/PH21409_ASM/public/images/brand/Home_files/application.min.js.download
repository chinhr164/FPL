angular.module('cogs-modifiers').controller('CogsModifiersController', ['CogsModifiers', '$state', 'FhdMessenger', 'NgTableParams', '$stateParams', '$location', 'Authentication', function (CogsModifiers, $state, FhdMessenger, NgTableParams, $stateParams, $location, Authentication) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {
    status: ['active', 'inactive']
  };
  vm.status = 'active';
  vm.data.startDate = moment().subtract(1, 'month').startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD');

  vm.create = () => {
    vm.creating = true;
    FhdMessenger.info('Đang tạo...');
    const cogsModifier = new CogsModifiers({
      product: _.get(vm.product, '_id'),
      sku: _.get(vm.product, 'sku'),
      price: _.get(vm.product, 'price'),
      description: _.get(vm.product, 'description'),
      originalCogs: _.get(vm.product, 'cogs'),
      cogs: vm.cogs,
      originalQuantity: vm.originalQuantity,
      note: vm.note,
      changeProduct: vm.changeProduct
    });
    cogsModifier.$save().then(() => {
      FhdMessenger.success('Ok');
      $state.reload();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.creating = false;
    });
  };

  vm.update = () => {
    FhdMessenger.info('Đang cập nhật...');

    if (!vm.cogs) {
      return FhdMessenger.error('Bạn chưa nhập giá vốn');
    }

    if (vm.cogs === _.get(vm.cogsModifier, 'cogs')) {
      return FhdMessenger.error('Giá trị giá vốn chưa thay đổi');
    }

    vm.cogsModifier.originalCogs = _.get(vm.cogsModifier, 'cogs');
    vm.cogsModifier.cogs = vm.cogs;
    vm.cogsModifier.changeProduct = vm.changeProduct;
    const cogsModifier = new CogsModifiers(vm.cogsModifier);
    vm.waiting = true;
    const promise = cogsModifier.$update().then(() => {
      $location.path('cogs-modifiers');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Cập nhật thành côngg.');
    });
  };

  vm.cogsModifiersTable = new NgTableParams();

  vm.remove = function (cogsModifier) {
    if (cogsModifier) {
      FhdMessenger.info('Đang xóa');
      cogsModifier.$remove(function () {
        FhdMessenger.success('Xóa thành công');
      });
    }
  };

  vm.find = () => {
    vm.waiting = true;
    vm.cogsModifiers = CogsModifiers.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      status: vm.status,
      products: _.map(vm.products, '_id')
    });
    vm.cogsModifiers.$promise.then(() => {
      vm.cogsModifiersTable.settings({
        dataset: vm.cogsModifiers
      });
    });
    vm.cogsModifiers.$promise.catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = () => {
    CogsModifiers.get({
      cogsModifierId: $stateParams.cogsModifierId
    }).$promise.then(cogsModifier => {
      vm.cogsModifier = cogsModifier;
      vm.cogs = _.get(cogsModifier, 'cogs', 0);
    });
  };

  vm.products = [];

  vm.productSearchSelected = item => {
    const productIndex = _.findIndex(vm.products, {
      sku: item.sku
    });

    if (productIndex > -1) {
      return FhdMessenger.error('Đã có sản phẩm này trong danh sách report!');
    }

    vm.products.push(vm.product);
  };

  vm.removeItem = index => {
    vm.products.splice(index, 1);
  };
}]);
"use strict";

