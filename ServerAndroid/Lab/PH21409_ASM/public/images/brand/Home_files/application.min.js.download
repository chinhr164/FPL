angular.module('core').directive('fhdTypeahead', [function () {
  return {
    template: '<input type="text" data-ng-model="input" ' + 'typeahead="item.displayName for item in filteredData | limitTo:50" ' + 'typeahead-wait-ms="300" typeahead-min-length="2" ' + 'typeahead-on-select="itemSelected($item, $model, $fhdLabel)" ' + 'placeholder="{{fhdPlaceholder}}" ' + 'class="form-control" ng-keyup="keyUp($event)">',
    restrict: 'E',
    scope: {
      fhdIdName: '@',
      fhdData: '=',
      fhdItem: '=?',
      fhdList: '=?',
      fhdUniqueId: '@',
      fhdBarcode: '@',
      fhdBarcode2: '@',
      fhdLoadAsync: '=',
      fhdLabel: '@',
      fhdWait: '@',
      fhdPlaceholder: '=?',
      fhdMinLength: '@',
      fhdAutoClearInput: '=?'
    },
    compile: function (tElm, tAttrs) {
      var inputElm = tElm.children();
      if (tAttrs.fhdLabel) inputElm.attr('typeahead', 'item.' + tAttrs.fhdLabel + ' for item in filteredData  | limitTo:50');
      if (tAttrs.fhdWait) inputElm.attr('typeahead-wait-ms', tAttrs.fhdWait);
      if (tAttrs.fhdMinLength) inputElm.attr('typeahead-min-length', tAttrs.fhdMinLength);
      if (tAttrs.fhdLoadAsync) inputElm.attr('typeahead', 'item.' + (tAttrs.fhdLabel || 'label') + ' for item in fhdLoadAsync($viewValue) | filter:$viewValue  | limitTo:50');
      return {
        post: function (scope, iElm, iAttrs) {
          if (iAttrs.fhdItem) scope.toItem = true;else scope.toItem = false;
        }
      };
    },
    controller: 'FhdTypeaheadController'
  };
}]).controller('FhdTypeaheadController', ['$scope', '$timeout', 'FhdMessenger', function ($scope, $timeout, FhdMessenger) {
  $scope.fhdList = $scope.fhdList || [];

  $scope.itemSelected = function (item) {
    $scope.input = '';
    if (_.includes($scope.fhdList, item)) return;

    if ($scope.toItem) {
      $scope.fhdItem = item;
      if ($scope.fhdAutoClearInput !== true) $scope.input = item[$scope.fhdUniqueId];
    } else {
      if ($scope.fhdUniqueId && _.some($scope.fhdList, function (_item) {
        return item[$scope.fhdUniqueId] === _item[$scope.fhdUniqueId];
      })) return;
      $scope.fhdList.push(item);
    }
  };

  $scope.keyUp = function ($event) {
    if ($event.keyCode !== 13) return;
    if (!$scope.fhdBarcode) return;

    const matchItem = _.find($scope.fhdData, function (item) {
      return $scope.input === item[$scope.fhdBarcode] || ($scope.fhdBarcode2 ? $scope.input === item[$scope.fhdBarcode2] : false);
    });

    console.log(2, matchItem);
    if (matchItem) $scope.itemSelected(matchItem);else {
      if ($scope.input) {
        FhdMessenger.error('Không có mã ' + $scope.input);
        $scope.input = '';
      }
    }
  };

  $scope.$watch('fhdItem', function (newValue, oldValue) {
    if (newValue && !$scope.input && $scope.fhdAutoClearInput !== true) {
      $scope.input = _.get(newValue, $scope.fhdUniqueId);
    }

    if (newValue === oldValue) return;
    if (!newValue) $scope.input = '';
  });
  $scope.$watch('input', function (newValue, oldValue) {
    if (!newValue) return;
    let keywords = newValue.trim().toLowerCase().split(' ');
    $scope.filteredData = _($scope.fhdData).map(item => {
      let score = _.sumBy(keywords, key => {
        return _.includes(_.get(item, $scope.fhdLabel || 'displayName', '').toLowerCase(), key) ? key.length : 0;
      });

      if (_.isString(item.code)) {
        if (item.code && _.includes(keywords, item.code.toLowerCase())) {
          score += item.code.length * 3;
        }
      }

      return _.assign({}, item, {
        score
      });
    }).filter(item => item.score > 0).sortBy(item => -item.score).value();
  });
}]);
"use strict";

angular.module('core').directive('fhdUploadFiles', [function () {
  return {
    templateUrl: 'modules/core/templates/fhd-upload-files.template.html',
    controller: 'FhdUploadFilesController',
    controllerAs: 'vm',
    replace: true,
    bindToController: true,
    scope: {
      uploadedFiles: '=?',
      labelColumn: '@',
      onChange: '=?'
    },

    link(scope, element) {
      const vm = scope.vm;

      if (vm.labelColumn) {
        const labelElm = element.find('label');
        const inputElm = element.find('fhd-controls');
        labelElm.addClass(`col-sm-${vm.labelColumn}`);
        inputElm.addClass(`col-sm-${12 - vm.labelColumn}`);
      }
    }

  };
}]).controller('FhdUploadFilesController', ['$scope', 'Authentication', 'FhdMessenger', 'FileUploader', 'EnvironmentService', function ($scope, Authentication, FhdMessenger, FileUploader, EnvironmentService) {
  const vm = this;
  const url = EnvironmentService.getFileWorkerServiceURL();
  vm.uploadedFiles = [];
  vm.uploader = new FileUploader({
    url: url ? `${url}/upload` : '/upload-files',
    autoUpload: true,
    queueLimit: 10
  });

  vm.uploader.onCompleteItem = (item, response, status) => {
    if (response.message) {
      return FhdMessenger.error(response.message);
    }

    vm.uploadedFiles = [...vm.uploadedFiles, ...response];
  };

  vm.uploader.onErrorItem = item => {
    item.remove();
  };

  vm.uploader.onCompleteAll = () => {
    if (vm.onChange) {
      vm.onChange(vm.uploadedFiles);
    }
  };

  vm.removeFile = file => {
    _.remove(vm.files, {
      fileName: file.file.name
    });

    file.remove();
  };
}]);
