    }).then(() => {
      vm.waiting = true;
      tetCategory.$delete().then(() => {
        FhdMessenger.success('Đã xóa category');
        vm.tetCategories.splice(index, 1);
        vm.tetCategoriesTable.reload();
        vm.waiting = false;
      });
    });
  };

  vm.openModalCreateTetCategory = TetCategoriesService.openCreateTetCategoryModal;
}]);
