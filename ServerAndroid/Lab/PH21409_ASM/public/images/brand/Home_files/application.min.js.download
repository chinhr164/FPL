      if (!leaveLimit.startDate || !leaveLimit.endDate) {
        return 'Ngày bắt đầu hoặc ngày kết thúc không được để trống';
      }

      if (moment(leaveLimit.startDate).isAfter(moment(leaveLimit.endDate))) {
