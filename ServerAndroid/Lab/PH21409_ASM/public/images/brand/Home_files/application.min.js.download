angular.module('stock-entries').factory('StockEntryService', ['$modal', '$http', function ($modal, $http) {
  const allStatuses = [{
    id: 'delivered',
    title: 'Đã chuyển'
  }, {
    id: 'received',
    title: 'Đã nhận'
  }, {
    id: 'deleted',
    title: 'Đã xoá'
  }, {
    id: 'lost',
    title: 'Thất lạc'
  }, {
    id: 'disabled',
    title: 'Đã khóa'
  }];
  const statuses = [{
    name: 'Đã chuyển hàng',
    status: 'delivered'
  }];
  return {
    getStatuses() {
      return statuses;
    },

    getAllStatuses() {
      return allStatuses;
    },

    openHistory(stockEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalStockEntryHistoryController',
        controllerAs: 'vm',
        templateUrl: 'modules/stock-entries/templates/modal-stock-entry-history.client.template.html',
        resolve: {
          stockEntry() {
            return stockEntry;
          }

        }
      });
    },

    openAddBillNumberModal(stockEntry) {
      return $modal.open({
        templateUrl: 'modules/stock-entries/templates/modal-add-bill-number.client.view.html',
        controller: 'ModalAddBillNumberForStockEntryController',
        controllerAs: 'vm',
        resolve: {
          stockEntry: () => stockEntry
        }
      });
    },

    openFindStockEntryModal(item, outlet) {
      return $modal.open({
        templateUrl: 'modules/stock-entries/templates/modal-find-stock-entry.client.view.html',
        controller: 'ModalFindStockEntryController',
        controllerAs: 'vm',
        resolve: {
          item: () => item,
          outlet: () => outlet
        }
      });
    },

    openUpdateFeedback(stockEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalUpdateFeedbackController',
        controllerAs: 'vm',
        templateUrl: 'modules/stock-entries/templates/modal-update-feedback.client.template.html',
        size: 'lg',
        resolve: {
          stockEntry() {
            return stockEntry;
          }

        }
      });
    },

    openDoneReturnStockEntry(stockEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalDoneReturnStockEntryController',
        controllerAs: 'vm',
        size: 'lg',
        templateUrl: 'modules/stock-entries/templates/modal-done-return-stock-entry.client.templates.html',
        resolve: {
          stockEntry() {
            return stockEntry;
          }

        }
      });
    },

    openCreateStockEntryModal(items, destination) {
      return $modal.open({
        animation: true,
        controller: 'ModalCreateStockEntryController',
        controllerAs: 'vm',
        size: 'lg',
        backdrop: 'static',
        templateUrl: 'modules/stock-entries/templates/modal-create-stock-entry.client.templates.html',
        resolve: {
          items() {
            return items;
          },

          destination() {
            return destination;
          }

        }
      });
    },

    openCreateStockEntryForPlTaskModal(data) {
      return $modal.open({
        animation: true,
        controller: 'ModalCreateStockEntryForPlTaskController',
        controllerAs: 'vm',
        size: 'lg',
        backdrop: 'static',
        templateUrl: 'modules/stock-entries/templates/modal-create-stock-entry-for-pl-task.client.templates.html',
        resolve: {
          data() {
            return data;
          }

        }
      });
    },

    listStockEntriesNotInDeliverEntries(query) {
      return $http.get('/stock-entries/check-le-not-in-de', {
        params: query
      }).then(response => response.data);
    },

    openViewModalStockEntry(stockEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalViewStockEntryController',
        controllerAs: 'vm',
        templateUrl: 'modules/stock-entries/templates/modal-view-stock-entry.client.template.html',
        resolve: {
          stockEntryId() {
            return stockEntry._id;
          }

        }
      });
    },

    openAddExplainModal(stockEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalAddExplainLostStockEntryController',
        controllerAs: 'vm',
        templateUrl: 'modules/stock-entries/templates/modal-add-explain.client.view.html',
        resolve: {
          stockEntry: () => stockEntry
        }
      }).result;
    },

    openAddCommentModal(stockEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalAddCommentLostStockEntryController',
        controllerAs: 'vm',
        templateUrl: 'modules/stock-entries/templates/modal-add-comment.client.view.html',
        resolve: {
          stockEntry: () => stockEntry
        }
      }).result;
    },

    getStockEntryType(stockEntry) {
      const outlet = _.get(stockEntry, 'outlet', {});

      const outletCode = _.get(stockEntry, 'outlet.code', '');

      const destinationCode = _.get(stockEntry, 'destination.code', ''); // Buying


      if (!outletCode && destinationCode.match(/^D\d/)) {
        return 'buy';
      } else if (outletCode === 'G1' && destinationCode.match(/^D\d/)) {
        // Manufacturing
        return 'pl';
      } else if (outletCode.match(/^D\d/) && !destinationCode === 'TL') {
        // Sell stock
        return 'sell';
      } else if ((outletCode === 'TL' || outletCode.match(/^D\d/)) && destinationCode === 'TRASH') {
        // trash
        return 'trash';
      } else if (!destinationCode.match(/^D\d/) && !outletCode.match(/^D\d/) && !destinationCode.match(/^S\d/) && outletCode !== 'B1') {
        // transfer stock between outlets
        return 'transfer';
      } else if (outletCode.match(/^D\d/) || outletCode === 'B1' && destinationCode.match(/^S\d/)) {
        // Distribute goods from warehouse to store
        return 'restock';
      } else if (destinationCode.match(/^D\d/) && _.get(outlet, 'isPos') && !stockEntry.onlineOrder) {
        // Return goods from store to warehouse
        return 'return';
      }

      return 'n/a';
    },

    chooseStaffModal() {
      return $modal.open({
        templateUrl: 'modules/stock-entries/templates/modal-choose-staff.client.template.html',
        controller: 'ChooseStaffModalController',
        controllerAs: 'vm'
      }).result;
    },

    openDeleteStockEntryModal(stockEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalDeleteStockEntryController',
        controllerAs: 'vm',
        templateUrl: 'modules/stock-entries/templates/modal-delete-stock-entry.client.templates.html',
        resolve: {
          stockEntryId() {
            return stockEntry._id;
          }

        }
      }).result;
    },

    openErrorPackReasonModal() {
      return $modal.open({
        animation: true,
        controller: 'ModalAddNotePackErrorController',
        controllerAs: 'vm',
        size: 'sm',
        templateUrl: 'modules/stock-entries/templates/modal-additional-reason-pack-error.client.view.html'
      });
    },

    openFindSaleCode(item, outlet) {
      return $modal.open({
        animation: true,
        controller: 'ModalFindSaleCodeController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: 'modules/stock-entries/templates/modal-find-sale-code.client.view.html',
        resolve: {
          outlet: () => outlet,
          item: () => item
        }
      });
    },

    openFindBuyingEntryModal(stockEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalFindBuyingEntryController',
        controllerAs: 'vm',
        size: 'lg',
        templateUrl: 'modules/stock-entries/templates/modal-find-buying-entry.client.view.html',
        resolve: {
          stockEntry() {
            return stockEntry;
          }

        }
      });
    },

    openAddItemNoteModal(stockEntryId, selectedItem) {
      return $modal.open({
        animation: true,
        controller: 'AddNoteModalController',
        controllerAs: 'vm',
        templateUrl: 'modules/stock-entries/templates/modal-add-item-note.client.view.html',
        resolve: {
          stockEntryId: () => stockEntryId,
          selectedItem: () => selectedItem
        }
      }).result;
    },

    openQuickCreateModal: ({
      items,
      outletCode,
      destinationCode,
      onlineOrder
    }) => $modal.open({
      animation: true,
      templateUrl: 'modules/stock-entries/templates/quick-create-stock-entry.client.template.html',
      controller: 'QuickCreateStockEntryModalController',
      controllerAs: 'vm',
      resolve: {
        data: () => ({
          items,
          outletCode,
          destinationCode,
          onlineOrder
        })
      }
    }).result,

    openModalSelectProblem(item) {
      return $modal.open({
        animation: true,
        controller: 'ModalSelectProblemController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: 'modules/stock-entries/templates/modal-select-problem.client.view.html',
        resolve: {
          item: () => item
        }
      }).result;
    },

    openModalSelectResponsibleOutlet(stockEntry) {
      return $modal.open({
        animation: true,
        controller: 'ModalSelectResponsibleOutletController',
        controllerAs: 'vm',
        size: 'md',
        templateUrl: 'modules/stock-entries/templates/modal-select-responsible-outlet.client.view.html',
        resolve: {
          stockEntry: () => stockEntry
        }
      }).result;
    }

  };
}]);
