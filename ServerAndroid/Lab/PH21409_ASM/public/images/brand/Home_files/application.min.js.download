angular.module('checklist-entries').component('checklistCriteria', {
  bindings: {
    mode: '@?',
    checklistEntry: '='
  },
  templateUrl: 'modules/checklist-entries/templates/checklist-criteria.client.template.html',
  controllerAs: 'vm',
  controller: ['$scope', 'NgTableParams', '$document', '$timeout', 'SlugService', function ($scope, NgTableParams, $document, $timeout, SlugService) {
    const vm = this; // mode : ["view","edit"]

    vm.isViewMode = true;
    vm.checklistCriterias = {};
    vm.filter = {};

    if (!vm.mode) {
      vm.mode = 'view';
      vm.isViewMode = true;
    }

    if (['edit', 'create'].includes(vm.mode)) {
      vm.isViewMode = false;
    }

    vm.table = {};
    vm.checklistCriteriasTable = new NgTableParams({
      count: 500
    });

    vm.changePass = itemId => {
      const index = _.findIndex(vm.checklistCriterias, {
        _id: itemId
      });

      if (vm.checklistCriterias[index].pass) {
        vm.checklistCriterias[index].notPass = false;
        vm.checklistCriterias[index].notCheck = false;
      }
    };

    vm.changeNotPass = itemId => {
      const index = _.findIndex(vm.checklistCriterias, {
        _id: itemId
      });

      if (vm.checklistCriterias[index].notPass) {
        vm.checklistCriterias[index].pass = false;
        vm.checklistCriterias[index].notCheck = false;
      }
    };

    vm.changeNotCheck = itemId => {
      const index = _.findIndex(vm.checklistCriterias, {
        _id: itemId
      });

      if (vm.checklistCriterias[index].notCheck) {
        vm.checklistCriterias[index].pass = false;
        vm.checklistCriterias[index].notPass = false;
      }
    };

    $scope.$watch(() => vm.checklistEntry.checklistCriterias, (newValue, oldValue) => {
      if (!newValue || newValue === oldValue) {
        return;
      }

      vm.checklistEntry.showPoint = _.some(vm.checklistEntry.checklistCriterias, checklistCriteria => {
        return checklistCriteria.maxPoint;
      });
      vm.checklistCriterias = vm.checklistEntry.checklistCriterias;
      renderTable(vm.checklistCriterias);
    });
    $scope.$watch(() => vm.filter.content, (newValue, oldValue) => {
      if (newValue === oldValue) return;
      vm.filter.data = filterChecklistCriterias(vm.checklistCriterias);
      renderTable(vm.filter.data);
    });
    $scope.$watch(() => vm.filter.condition, (newValue, oldValue) => {
      if (newValue === oldValue) return;
      vm.filter.data = filterChecklistCriterias(vm.checklistCriterias);
      renderTable(vm.filter.data);
    });

    const filterChecklistCriterias = checklistCriterias => {
      const contentFilter = SlugService.getSlug(vm.filter.content).toLowerCase();
      const conditionFilter = SlugService.getSlug(vm.filter.condition).toLowerCase();
      checklistCriterias = _.filter(checklistCriterias, checklistCriteria => {
        const content = SlugService.getSlug(checklistCriteria.content).toLowerCase().trim();
        const condition = SlugService.getSlug(checklistCriteria.condition).toLowerCase().trim();
        return content.includes(contentFilter) && condition.includes(conditionFilter);
      });
      checklistCriterias = _.map(checklistCriterias, checklistCriteria => {
        checklistCriteria.groupRowSpan = null;
        checklistCriteria.subGroupRowSpan = null;
        return checklistCriteria;
      });
      return checklistCriterias;
    };

    const renderTable = data => {
      // Thêm 1 trường để sort
      let checklistCriterias = _.map(data, checklistCriteria => {
        if (checklistCriteria.group === 'space') {
          checklistCriteria.groupOrder = 1;
        } else if (checklistCriteria.group === 'product') {
          checklistCriteria.groupOrder = 2;
        } else if (checklistCriteria.group === 'process') {
          checklistCriteria.groupOrder = 3;
        } else {
          checklistCriteria.groupOrder = 4;
        }

        checklistCriteria.subGroupOrder = _.get(checklistCriteria, 'subGroup', '').match(/^Chung/gim) ? '' : checklistCriteria.subGroup;
        checklistCriteria.pointOrder = checklistCriteria.maxPoint ? 1 : 2;

        if (vm.mode === 'create') {
          checklistCriteria.point = checklistCriteria.maxPoint;
        }

        checklistCriteria.dataSubGroup = `${checklistCriteria.group} - ${checklistCriteria.subGroup}`;
        return checklistCriteria;
      });

      checklistCriterias = _.orderBy(checklistCriterias, ['groupOrder', 'subGroupOrder', 'pointOrder'], ['asc', 'asc', 'asc']);

      const contentSubGroups = _.uniq(_.map(checklistCriterias, 'dataSubGroup'));

      const contentGroup = _.uniq(_.map(checklistCriterias, 'group'));

      _.forEach(contentGroup, content => {
        const group = _.filter(checklistCriterias, {
          group: content
        });

        const count = group.length;

        const firstElementGroupIndex = _.findIndex(checklistCriterias, {
          group: content
        });

        checklistCriterias[firstElementGroupIndex].groupRowSpan = count;
      });

      _.forEach(contentSubGroups, content => {
        const group = _.filter(checklistCriterias, {
          dataSubGroup: content
        });

        const count = group.length;

        const firstElementGroupIndex = _.findIndex(checklistCriterias, {
          dataSubGroup: content
        });

        checklistCriterias[firstElementGroupIndex].subGroupRowSpan = count;
      });

      vm.checklistCriteriasTable.settings({
        dataset: checklistCriterias
      });
    };
  }]
});
'use strict'; // Setting up route

