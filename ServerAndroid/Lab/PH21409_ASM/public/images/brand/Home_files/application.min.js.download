angular.module('core').directive('typeaheadClickOpen', ['$parse', '$timeout', function ($parse, $timeout) {
  return {
    restrict: 'A',
    require: 'ngModel',
    link: function ($scope, elem, attrs) {
      const triggerFunc = function (evt) {
        const ctrl = elem.controller('ngModel');
        const prev = ctrl.$modelValue || '';

        if (prev && prev !== '== Chưa chọn ==') {
          ctrl.$setViewValue('');
          $timeout(function () {
            ctrl.$setViewValue(prev);
          });
        } else {
          if (prev === '== Chưa chọn ==') ctrl.$setViewValue('');else ctrl.$setViewValue(' ');
          ctrl.$render();
        }
      };

      elem.bind('click', triggerFunc);
    }
  };
}]);
