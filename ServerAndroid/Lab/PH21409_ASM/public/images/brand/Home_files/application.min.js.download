angular.module('leave-limits').controller('ImportLeaveLimitsController', ['Authentication', 'LeaveLimits', 'FhdMessenger', 'ConfirmModal', function (Authentication, LeaveLimits, FhdMessenger, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.requireFields = 'leaveType staffCode limitDays startDate endDate'.split(' ');

  function isAllValidField(field) {
    return _.some(vm.rawItems, item => {
      return !_.get(item, field) && _.get(item, field) !== 0;
    });
  }

  function validateItems() {
    let errors = [];

    if (!_.intersection(vm.user.roles, ['superadmin', 'leave-limit:create']).length) {
      errors.push(`Bạn không có quyền import leave limits`);
      return errors;
    }

    _.forEach(vm.requireFields, requireField => {
      if (isAllValidField(requireField)) {
        errors.push(`Bạn chưa điền đủ ${requireField}`);
      }
    });

    return errors;
  }

  vm.import = () => {
    if (!vm.rawItems) {
      return;
    }

    const errCreate = validateItems();

    if (errCreate.length) {
      _.forEach(errCreate, err => {
        return FhdMessenger.error(err);
      });

      return;
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ import ${vm.rawItems.length} leave limits ?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      LeaveLimits.importLeaveLimits({
        rawItems: vm.rawItems
      }).$promise.then(leaveLimits => {
        vm.leaveLimits = leaveLimits;

        _.forEach(vm.leaveLimits, leaveLimit => {
          leaveLimit.startDate = moment(leaveLimit.startDate).format('L');
          leaveLimit.endDate = moment(leaveLimit.endDate).format('L');
        });

        return FhdMessenger.success(`Import ${leaveLimits.length} leave limits thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
'use strict';

angular.module('leave-limits').controller('LeaveLimitsController', ['Authentication', 'LeaveLimits', 'LeaveLimitService', 'FhdMessenger', 'NgTableParams', '$state', '$stateParams', 'ConfirmModal', '$location', function (Authentication, LeaveLimits, LeaveLimitService, FhdMessenger, NgTableParams, $state, $stateParams, ConfirmModal, $location) {
  const vm = this;
  vm.leaveLimitsTable = new NgTableParams();
  vm.staffTable = new NgTableParams({
    count: 100
  });
  vm.user = Authentication.user;
  vm.leaveLimit = {
    leaveType: 'Làm việc tại nhà (WFH)',
    startDate: null,
    endDate: null // Timeframe 4 tháng theo kỳ review

  };
  const currentMonth = moment().month() + 1;
  let startMonth = 3;

  if ([7, 8, 9, 10].includes(currentMonth)) {
    startMonth = 7;
  }

  if ([11, 12, 1, 2].includes(currentMonth)) {
    startMonth = 11;
  }

  vm.startDate = moment().set('month', startMonth - 1).startOf('year').format('YYYY-MM-DD');
  vm.endDate = moment().set('month', startMonth - 1).add(3, 'month').endOf('month').format('YYYY-MM-DD');
  vm.leaveTypes = ['Làm việc tại nhà (WFH)'];

  vm.create = function () {
    const validate = LeaveLimitService.validate(vm.leaveLimit, 'create');

    if (validate) {
      return FhdMessenger.error(validate);
    }

    vm.waiting = true;
    const leaveLimit = new LeaveLimits(vm.leaveLimit);
    leaveLimit.$save().then(res => {
      FhdMessenger.success('Tạo leave limit thành công');
      vm.leaveLimit = {};
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }; // Find a list of Leave limits


  vm.find = function () {
    vm.waiting = true;
    vm.leaveLimitsTable.settings({
      dataset: []
    });
    vm.leaveLimits = LeaveLimits.query({
      startDate: moment(vm.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.endDate).format('YYYY-MM-DD'),
      status: 'actived'
    });
    vm.leaveLimits.$promise.then(() => {
      vm.leaveLimitsTable.settings({
        dataset: vm.leaveLimits
      });
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Find an existing Leave limit


  vm.findOne = function () {
    vm.leaveLimit = LeaveLimits.get({
      leaveLimitId: $stateParams.leaveLimitId
    });
  }; // Edit Leave limit


  vm.update = function () {
    const validate = LeaveLimitService.validate(vm.leaveLimit);

    if (validate) {
      return FhdMessenger.error(validate);
    }

    vm.waiting = true;
    const leaveLimit = new LeaveLimits(vm.leaveLimit);
    leaveLimit.$update().then(res => {
      FhdMessenger.success('Sửa leave limit thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
      $state.go('listLeaveLimits');
    });
  };

  vm.remove = function (leaveLimit) {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Huỷ',
      actionButtonText: 'Xóa',
      headerText: 'Xóa leave limit',
      bodyText: `Bạn có chắc muốn xóa leave limit này không ? `
    }).then(() => {
      vm.waiting = true;
      leaveLimit.$remove().then(() => {
        FhdMessenger.success('Đã xóa leave limit');
