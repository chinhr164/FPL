angular.module('work-departments').controller('WorkDepartmentsController', ['$stateParams', '$location', '$scope', 'helper', 'Authentication', 'WorkDepartments', 'FhdMessenger', 'NgTableParams', 'ObjectId', '$http', function ($stateParams, $location, $scope, helper, Authentication, WorkDepartments, FhdMessenger, NgTableParams, ObjectId, $http) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.removeValueFromArray = helper.removeValueFromArray;

  vm.init = () => {
    vm.data = vm.data || {};
  };

  $scope.$watch(() => vm.staff, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    vm.workDepartment.managers = vm.workDepartment.managers || [];

    const existManagers = _.find(vm.workDepartment.managers, {
      _id: vm.staff._id
    });

    if (!existManagers) {
      vm.workDepartment.managers.push(vm.staff);
    }

    vm.staff = null;
  });

  vm.changeManager = function () {
    vm.workDepartment.managers = vm.workDepartment.managers || [];
    vm.workDepartment.managers.push(vm.manager);
  };

  vm.removeManager = index => {
    vm.workDepartment.managers.splice(index, 1);
  }; // Create new Work Department


  vm.create = function () {
    const workDepartment = new WorkDepartments(vm.workDepartment); // Redirect after save

    workDepartment.$save(function (response) {
      $location.path(`work-departments`); // Clear form fields

      vm.workDepartment = {};
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.workDepartmentsTable = new NgTableParams({
    count: 100
  });

  vm.find = () => {
    vm.workDepartments = WorkDepartments.query(function () {
      vm.workDepartments = _.map(vm.workDepartments, workDepartment => {
        workDepartment.managerText = _.map(workDepartment.managers, 'displayName').join(', ');
        return workDepartment;
      });
      vm.workDepartmentsTable.settings({
        dataset: vm.workDepartments
      });
    });
  };

  vm.findOne = async () => {
    vm.workDepartment = WorkDepartments.get({
      workDepartmentId: $stateParams.workDepartmentId
    });
  };

  vm.update = () => {
    if (!vm.workDepartment.name) {
      return FhdMessenger.error('Chưa có tên');
    }

    if (!vm.workDepartment.code) {
      return FhdMessenger.error('Chưa có code');
    }

    vm.workDepartment.$update().then(response => {
      FhdMessenger.success('Update thành công');
      $location.path(`work-departments`); // Clear form fields

      vm.name = '';
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    });
  };

  vm.remove = (workDepartment, index) => {
    workDepartment.$remove().then(() => {
      FhdMessenger.success('Xóa thành công');
      vm.workDepartments.splice(index, 1);
      vm.workDepartmentsTable.reload();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };
}]);
'use strict';

angular.module('work-departments').factory('WorkDepartmentService', ['WorkDepartments', function (WorkDepartments) {
  let workDepartments;
  let avaiableWorkDepartments;

  let all = function (callback) {
    if (!workDepartments) {
      workDepartments = WorkDepartments.query();
    }

    workDepartments.$promise.then(workDepartments => {
      callback(null, workDepartments);
    }, err => {
      workDepartments = WorkDepartments.query();
      callback(err);
    });
  };

  let loadAvaible = function () {
    avaiableWorkDepartments = WorkDepartments.query();
    avaiableWorkDepartments = avaiableWorkDepartments.$promise;
  };

  return {
    all,
    getFromId: id => {
      return _.find(workDepartments, {
        _id: id
      });
    },

    allAsync() {
      if (!avaiableWorkDepartments) {
        loadAvaible();
      }

      return avaiableWorkDepartments;
    }

  };
}]);
