angular.module('licenses').factory('LicensesService', ['$modal', 'helper', 'OutletService', 'LicenseTypes', function ($modal, helper, OutletService, LicenseTypes) {
  const targets = _.sortBy([{
    id: 'vendor',
    title: 'Vendor'
  }, {
    id: 'staff',
    title: 'Nhân Viên'
  }, {
    id: 'outlet',
    title: 'Cơ sở'
  }, {
    id: 'product',
    title: 'Sản phẩm'
  }, {
    id: 'businessCustomer',
    title: 'Đại lý'
  }], 'title');

  const targetsMap = helper.makeMap(targets, 'id');
  const statuses = [{
    title: 'Bảo quản',
    id: 'free'
  }, {
    title: 'Đã được mượn',
    id: 'on-loan'
  }, {
    title: 'Lưu trữ',
    id: 'archived'
  }, {
    title: 'Đã xóa',
    id: 'disabled'
  }, {
    title: 'Thất lạc',
    id: 'lost'
  }];
  const isExpiredTypes = [{
    title: 'Hết hạn',
    id: true
  }, {
    title: 'Còn hạn',
    id: false
  }];
  const expiredTypesMap = helper.makeMap(isExpiredTypes, 'id');
  return {
    cleanTarget: license => {
      license.staff = null;
      license.outlet = null;
      license.vendor = null;
    },
    getStatuses: () => statuses,
    getTypes: () => {
      return LicenseTypes.query().$promise.then(items => {
        const types = _.reduce(items, (result, item) => {
          result = result || [];
          result.push({
            id: item.slug,
            title: item.name,
            _id: item._id
          });
          return result;
        }, []);

        return _.sortBy(types, 'title');
      });
    },
    getTargets: () => targets,
    getExpiredTypes: () => isExpiredTypes,
    openUpdateLicense: license => {
      return $modal.open({
        templateUrl: '/modules/licenses/templates/modal-open-update-license.client.template.html',
        controller: 'ModalOpenUpdateLicenseController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          license: () => license
        }
      }).result;
    },
    openModalViewLicenseBackupEntries: license => {
      return $modal.open({
        templateUrl: 'modules/licenses/templates/modal-view-license-backup-entries.client.view.html',
        controller: 'ModalViewLicenseBackupEntryController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          license: () => license
        }
      });
    },
    filterTargetType: function (targetType) {
      return _.get(targetsMap, `${targetType}.title`, targetType);
    },
    filterTargetValue: function (license, target) {
      const targetDefault = 'Khác';

      if (target === 'vendor') {
        const vendor = _.get(license, 'vendor', {});

        return `${_.get(vendor, 'code')} - ${_.get(vendor, 'name')}`;
      }

      if (target === 'staff') {
        const staff = _.get(license, 'staff', {});

        return `${_.get(staff, 'code')} - ${_.get(staff, 'displayName')}`;
      }

      if (target === 'outlet') {
        const outlet = _.get(license, 'outlet', {});

        return `${_.get(outlet, 'code')} - ${_.get(outlet, 'name')}`;
      }

      if (target === 'businessCustomer') {
        const businessCustomer = _.get(license, 'businessCustomer', {});

        return `${_.get(businessCustomer, 'businessCustomerId')} - ${_.get(businessCustomer, 'name')}`;
      }

      return targetDefault;
    },
    filterIsExpired: function (isExpired) {
      return _.get(expiredTypesMap, `${isExpired}.title`, isExpired);
    },
    validate: function (license) {
      if (!license.licenseType) {
        return 'Bạn chưa chọn loại giấy tờ';
      }

      if (!license.content) {
        return 'Bạn chưa nhập nội dung';
      }

      if (!license.isSoftVersion && !license.code) {
        return 'Bạn chưa nhập mã giấy tờ';
      }

      if (!license.startDate) {
        return 'Chưa có ngày bắt đầu';
      }

      if (!license.target) {
        return 'Bạn chưa chọn kiểu đối tượng';
      }

      if (license.target === 'product') {
        if (!_.get(license, 'products.length')) {
          return 'Bạn chưa nhập danh sách sản phẩm';
        }
      } else if (_.isEmpty(_.get(license, license.target))) {
        return 'Bạn chưa nhập đối tượng tương ứng';
      }

      if (!license.hasNoEndDate) {
        if (!license.endDate) {
          return 'Chưa có ngày kết thúc';
        }

        if (moment(license.startDate).isAfter(license.endDate)) {
          return 'Ngày bắt đầu phải trước hơn ngày kết thúc';
        }
      }

      if (_.isEmpty(license.keeperStaff)) {
        return 'Bạn chưa điền nhân viên giữ';
      }

      return false;
    }
  };
}]);
"use strict";

angular.module('licenses').factory('Licenses', ['$resource', function ($resource) {
