            return products;
          }

        }
      }).result;
    },

    openEditPlDescriptionForProduct(product) {
      return $modal.open({
        templateUrl: '/modules/products/views/modal-open-edit-pl-description-for-product.client.temlate.html',
        controller: 'ModalOpenEditPlDescriptionForProductController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          product: () => product
        }
      });
    },

    getAllCategories: () => Products.getAllCategories().$promise.then(response => response),
    newSku: (productType, businessCode) => $http({
      url: '/new-sku',
      method: 'GET',
      params: {
        productType,
        businessCode
      }
    }).then(response => {
      return response.data.sku;
    }),
    newRawSku: () => $http.get('/new-raw-sku').then(response => response.data),

    requestConvertProduct(productId) {
      return $http.post('/request-convert-product', {
        productId
      }).then(response => response.data);
    },

    requestWorkTask(product, request) {
      const {
        taskType
      } = request;
      return $http.post('/work-tasks', {
        product,
        taskType
      }).then(response => response.data);
    },

    getNearestForeignPrice({
      skus,
      buyingEntry
    }) {
      // console.log({ skus, buyingEntry })
      return $http.put('/products/get-nearest-foreign-price', {
        skus,
        buyingEntry
      }).then(response => response.data);
    },

    openInventoryLocationHistory(product) {
      return $modal.open({
        templateUrl: '/modules/products/templates/modal-open-inventory-location-history.client.template.html',
        controller: 'ModalOpenInventoryLocationHistoryController',
        controllerAs: 'vm',
        resolve: {
          product: () => product
        }
      });
    },

    openModalEditRegionAttribute(regionAttribute) {
      return $modal.open({
        templateUrl: '/modules/products/templates/modal-edit-region-attribute.client.template.html',
        controller: 'ModalEditRegionAttributeController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          regionAttribute: () => regionAttribute
        }
      });
    },

    openModalComboElement(comboElement) {
      return $modal.open({
        templateUrl: '/modules/products/templates/modal-edit-combo-element.client.template.html',
        controller: 'ModalEditComboElementController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          comboElement: () => comboElement
        }
      });
    },

    getOutletProperty,
    getSoldPrice,

    getStopSellProduct(items, outletCode) {
      return $http.post('products/get-stop-sell-product', {
        items,
        outletCode
      }).then(res => res.data);
    },

    getProductStock(productId) {
      return $http.get('/get-stock', {
        params: {
          productId
        }
      }).then(response => response.data);
    },

    getProductAttributes() {
      return ['material', 'ingredients', 'dimensionsText', 'weightText', 'packaging', 'usage', 'origin', 'condition', 'expiryInfo'];
    },

    validate(product) {
      return {
        checkDelayBuying(errors = []) {
          _.forEach(_.get(product, 'regionAttributes'), regionAttribute => {
            if (regionAttribute.delayBuying && !regionAttribute.expectedBuyingDate) {
              errors.push(`Cần thêm <i>Ngày dự kiến nhập lại</i> khi tick <i>Tạm ngừng nhập miền ${regionAttribute.region}}</i>`);
            }

            if (regionAttribute.expectedBuyingDate && moment().isAfter(regionAttribute.expectedBuyingDate)) {
              errors.push(`<i>Ngày dự kiến nhập lại tại ${regionAttribute.region}</i> phải lớn hơn ngày hôm nay`);
            }

            if (regionAttribute.expectedBuyingDate && !regionAttribute.delayBuying) {
              errors.push(`Cần tick <i>tạm ngừng nhập</i> khi thêm <i>Ngày dự kiến nhập lại tại ${regionAttribute.region}</i>`);
            }
          });

          return errors;
        },

        checkBundlePrice(errors = []) {
          _.forEach(['NORTH', 'SOUTH'], region => {
            const outlet = {
              region
            };
            const price = getOutletProperty('price', outlet, product);
            const salePrice = getOutletProperty('salePrice', outlet, product);
            const bundlePrices = BundlePricesService.getBundlePrices(product, region);

            if (!_.get(bundlePrices, 'length')) {
              return;
            }

            const quantityLack = _.filter(bundlePrices, bundlePrice => {
              return !bundlePrice.quantity;
            });

            const priceLack = _.filter(bundlePrices, bundlePrice => {
              return !bundlePrice.price;
            });

            if (quantityLack.length) {
              errors.push('Chưa có số lượng sỉ');
            }

            if (priceLack.length) {
              errors.push('Chưa có giá sỉ');
            }

            const highestBundlePrice = _.get(_.maxBy(bundlePrices, 'price'), 'price');

            if (price < highestBundlePrice || salePrice > 0 && salePrice < highestBundlePrice) {
              errors.push(`Giá bán ở miền ${helper.getRegionName(region)} của sản phẩm thấp hơn giá sỉ `);
            }

            const sortedBundlePrices = _.sortBy(bundlePrices, 'quantity');

            _.forEach(sortedBundlePrices, ({
              price
            }, index) => {
              if (index === 0) {
                return;
              }

              const prevPrice = sortedBundlePrices[index - 1].price;

              if (price >= prevPrice) {
                errors.push(`Không thể đặt giá sỉ cho mức mua ít hơn rẻ hơn giá sỉ cho mức mua nhiều hơn`);
                return false;
              }
            });
          });

          return errors;
        },

        checkRawProducts(errors = []) {
          if (!product.privateLabel) {
            return errors;
          }

          const vendorProducts = _.get(product, 'vendorProducts', []);

          const vendorRawProductSkus = _.flattenDeep(_.map(vendorProducts, vendorProduct => {
            return _.map(_.get(vendorProduct.product, 'rawProducts', []), 'sku');
          }));

          const rawProductSkus = _.map(_.get(product, 'rawProducts', []), 'sku');

          if (!vendorRawProductSkus.length && !rawProductSkus.length) {
            return errors;
          }

          const intersectionSkus = _.intersection(_.uniq(vendorRawProductSkus), _.uniq(rawProductSkus));

          if (!intersectionSkus.length) {
            errors.push('Raw Products của Vendor Product không trùng với Raw Product ');
          }

          return errors;
        }

      };
    },

    validateRawProduct(product) {
      if (product.privateLabel && !_.get(product.rawProducts, 'length')) {
        return 'Sản phẩm được tick Private Label nhưng chưa được link với mã R tương ứng !';
      }
    },

    validateUpdateToSell: function (product, errors = []) {
      const isFrontendAbby = outletCode => {
        return outletCode.match(/[ME]\d+/);
      };

      return {
        checkDS: function () {
          const {
            outletAttributes
          } = product;

          const invalidOutlets = _.filter(outletAttributes, outlet => {
            const {
              stopSell,
              displayStock,
              outletCode
            } = outlet;
            return !stopSell && displayStock <= 0 && isFrontendAbby(outletCode);
          });

          if (invalidOutlets.length) {
            errors.push(`Sản phẩm được tick bán nhưng chưa có DS tại ${_.map(invalidOutlets, 'outletCode').join(' ')}`);
          }

          return this;
        },
        checkStopSell: function () {
          const {
            toSell,
            outletAttributes
          } = product;

          if (toSell && _.every(outletAttributes, outlet => {
            return outlet.stopSell && isFrontendAbby(outlet.outletCode);
          })) {
            errors.push('Sản phẩm được tick bán nhưng đang stopSell tất cả cơ sở.');
          }

          return this;
        },
        checkProductTime: function () {
          const {
            productionTime,
            privateLabel
          } = product;

          if (privateLabel && !_.isNumber(productionTime)) {
            errors.push('Sản phẩm PL nhưng chưa có Số phút đóng gói.');
          }

          return this;
        },
        checkMinWeight: function () {
          const {
            minWeightAllow,
            privateLabel
          } = product;

          if (privateLabel && !_.isNumber(minWeightAllow)) {
            errors.push('Sản phẩm PL nhưng chưa có khối lượng tối thiểu.');
          }

          return this;
        },
        checkMaxWeight: function () {
          const {
            maxWeightAllow,
            privateLabel
          } = product;

          if (privateLabel && !_.isNumber(maxWeightAllow)) {
            errors.push('Sản phẩm PL nhưng chưa có khối lượng tối đa.');
          }

          return this;
        },
        checkNetWeight: function () {
          const {
            netWeight
          } = product;

          if (!_.isNumber(netWeight)) {
            errors.push('Sản phẩm chưa có khối lượng tịnh.');
          }

          return this;
        },
        checkSKU: function () {
          const {
            sku
          } = product;

          if (!sku) {
            errors.push('Sản phẩm chưa có sku.');
          }

          return this;
        },
        checkDescription: function () {
          const {
            description
          } = product;

          if (!description) {
            errors.push('Sản phẩm chưa có description.');
          }

          return this;
        },
        checkCogs: function () {
          const {
            cogs
          } = product;

          if (!cogs) {
            errors.push('Sản phẩm chưa có cogs.');
          }

          return this;
        },
        checkPrice: function () {
          const {
            price
          } = product;

          if (!price) {
            errors.push('Sản phẩm chưa có price.');
          }

          return this;
        },
        checkCategory: function () {
          const {
            category
          } = product;

          if (!category) {
            errors.push('Sản phẩm chưa có category.');
          }

          return this;
        },
        checkCategoryGroup: function () {
          const group = _.get(product, 'category.group', null);

          if (!group) {
            errors.push('Sản phẩm chưa có category group.');
          }

          return this;
        },
        errors: () => errors
      };
    },
    checkDone: function () {
      function getErrors(product, requireFields, getDetail) {
        let errors = [];
        const lines = requireFields.split('\n');

        _.forEach(lines, field => {
          const splited = field.split('\t');

          const id = _.trim(splited[0]);

          const title = splited[1];

          let dataField = _.get(product, id, '');

          if (id === 'leadTime') {
            dataField = _.isNumber(dataField);
          }

          if (!dataField) {
            errors.push(title);
          }

          if (splited[3] && dataField && _.some(_.get(product, 'wooProperties.images'), image => {
            const src = _.get(image, 'src') || '';
            return !src.match(/placeholder/i);
          })) {
            errors.push(title);
          }
        });

        if (!getDetail) {
          return !errors.length;
        }

        return errors.join('<br />');
      }

      return {
        doneBuyer(product, getDetail) {
          const requireFields = `sku	Chưa có SKU
            vendor	Chưa có nhà cung cấp
            leadTime	Chưa có leadTime`;
          return getErrors(product, requireFields, getDetail);
        },

        doneInfo(product, getDetail) {
          const requireFields = `price	Chưa có giá sản phẩm
            wooProperties.categories.length	Chưa có Web Categories`;
          return getErrors(product, requireFields, getDetail);
        },

        doneImage(product, getDetail) {
          const requireFields = `wooProperties.images.length	Chưa có ảnh web Abby phù hợp	special`;
          return getErrors(product, requireFields, getDetail);
        },

        doneInventory(product, getDetail) {
          const requireFields = `cogs	Chưa có giá vốn
            category.group	Chưa có Group
            warehouseGroup	Chưa có điều kiện bảo quản`;
          return getErrors(product, requireFields, getDetail);
        },

        doneUpWork(product) {
          return _.get(product, 'toSell');
        },

        doneUpAbby(product) {
          return _.get(product, 'wooProperties.websiteId');
        },

        isReady(product) {
          return _.get(product, 'doneBuyer') && _.get(product, 'doneInventory') && _.get(product, 'doneInfo') && _.get(product, 'doneImage') && _.get(product, 'doneUpWork') && _.get(product, 'doneUpAbby');
        },

        canUpWork(product) {
          return _.get(product, 'sku') && _.get(product, 'description') && _.get(product, 'cogs') && _.get(product, 'price') && _.get(product, 'category.group');
        },

        canUpAbby(product) {
          return _.get(product, 'sku') && _.get(product, 'description') && _.get(product, 'price') && _.get(product, 'wooProperties.images.length') && _.get(product, 'wooProperties.categories.length');
        },

        canUpFb(product) {
          return _.get(product, 'sku') && _.get(product, 'description') && _.get(product, 'price') && _.get(product, 'wooProperties.images.length');
        },

        canDone(product) {
          return _.get(product, 'doneBuyer') && _.get(product, 'doneInfo') && _.get(product, 'doneInventory') && _.get(product, 'websiteId');
        }

      };
    },

    getVariantTypes() {
      return [{
        type: 'BASE',
        name: 'Đế'
      }, {
        type: 'BOX',
        name: 'Hộp'
      }];
    }

  };
}]);
"use strict";

