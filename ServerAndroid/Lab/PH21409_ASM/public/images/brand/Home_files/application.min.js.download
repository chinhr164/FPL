angular.module('display-groups').controller('DisplayGroupsController', ['DisplayGroups', 'FhdMessenger', '$modal', function (DisplayGroups, FhdMessenger, $modal) {
  const vm = this;
  vm.loading = false;
  vm.name = '';
  vm.displayGroups = [];
  DisplayGroups.query().$promise.then(result => {
    vm.displayGroups = result;
  }).catch(() => {
    FhdMessenger.error('Có lỗi xảy ra khi tải danh sách tag trưng bày');
  });

  vm.create = () => {
    if (vm.name === '') {
      FhdMessenger.error('Bạn phải nhập tên tag trưng bày');
      return;
    }

    vm.loading = true;
    const displayGroup = new DisplayGroups({
      name: vm.name
    });
    displayGroup.$save().then(result => {
      FhdMessenger.success('Thành công');
      vm.displayGroups.push(result);
      vm.name = '';
      vm.loading = false;
    }).catch(() => {
      FhdMessenger.error('Có lỗi xảy ra');
      vm.loading = false;
    });
  };

  vm.update = displayGroupEdit => {
    $modal.open({
      templateUrl: 'modules/display-groups/views/modal-display-groups.client.view.html',
      controller: 'ModalDisplayGroupsController',
      resolve: {
        displayGroupEdit: () => displayGroupEdit
      },
      controllerAs: 'vm'
    });
  };
}]);
