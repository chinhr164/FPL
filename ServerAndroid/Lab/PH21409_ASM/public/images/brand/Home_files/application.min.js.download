angular.module('users').filter('roles', ['UserService', function (UserService) {
  const roles = UserService.getRoles();

  const roleMap = _.reduce(roles, (result, role) => {
    result[role.id] = role;
    return result;
  }, {});

  return function (input) {
    const role = roleMap[input];
    return _.get(role, 'label', input);
  };
}]);
