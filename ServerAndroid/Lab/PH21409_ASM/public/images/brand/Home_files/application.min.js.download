angular.module('wholesale-orders').controller('CreateWholesaleOrderModalController', ['$scope', 'FhdMessenger', 'Address', 'BusinessCustomerService', 'OutletService', 'WholesaleOrders', 'Authentication', 'ObjectId', '$modalInstance', 'CalculateService', function ($scope, FhdMessenger, Address, BusinessCustomerService, OutletService, WholesaleOrders, Authentication, ObjectId, $modalInstance, CalculateService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.close = $modalInstance.dismiss;
  vm.data = {
    districts: Address.getDistricts()
  };
  vm.usedPoints = 0;

  vm.calculate = () => {
    let result = CalculateService.calculate({
      items: vm.items,
      assignedOutlet: vm.assignedOutlet,
      saleCampaigns: vm.saleCampaigns,
      orderValue: vm.orderValue,
      businessCustomer: vm.businessCustomer,
      specialPrice: vm.specialPrice
    });

    _.assign(vm, result);
  };

  vm.removeItem = index => {
    vm.items.splice(index, 1);
    vm.calculate();
  };

  vm.initOne = () => {
    vm.items = [];
    vm.deadline = null;
    Address.getWards().then(wards => {
      vm.data.wards = wards;
    });
    OutletService.allAsync().then(outlets => {
      vm.data.outlets = _.filter(outlets, {
        isPos: true
      });
    });
  };

  function checkRequireWard(district) {
    if (!district) {
      return false;
    }

    if ((district.includes('Hồ Chí Minh') || district.includes('Hà Nội')) && district.includes('(Nội thành)')) {
      return true;
    }

    return false;
  }

  function getCity(district) {
    if (district.includes('Hồ Chí Minh')) {
      return 'TP. Hồ Chí Minh';
    }

    return 'Hà Nội';
  }

  vm.getWard = () => {
    if (checkRequireWard(vm.receiverCustomerDistrict)) {
      vm.requireWard = true;
      const city = getCity(vm.receiverCustomerDistrict);

      const district = _.head(vm.receiverCustomerDistrict.split(','));

      vm.data.currentWards = vm.data.wards[city][district];

      if (!_.get(vm.data.currentWards, 'length', 0)) {
        vm.requireWard = false;
      }
    } else {
      vm.requireWard = false;
      vm.data.currentWards = [];
    }
  };

  function isCity(city, district) {
    const districts = Address.getDistricts();

    const matchDistrict = _.find(districts, {
      label: district
    });

    return matchDistrict && matchDistrict.city === city;
  }

  vm.changeDistrict = () => {
    const district = vm.receiverCustomerDistrict;
    OutletService.allAsync().then(outlets => {
      if (isCity('TP. Hồ Chí Minh (Nội thành)', district)) {
        // const outlet = _.find(outlets, { code: 'M6' })
        // vm.assignedOutlet = outlet
        vm.region = 'HCM';
      } else if (isCity('Hà Nội (Nội thành)', district)) {
        // const outlet = _.find(outlets, { code: 'SHIP' })
        // vm.assignedOutlet = outlet
        vm.region = 'HN';
      } else {
        // const outlet = _.find(outlets, { code: 'SHIP' })
        // vm.assignedOutlet = outlet
        vm.region = 'OTHER';
      }

      vm.calculate();
    });
  };

  vm.submit = () => {
    if (vm.requireWard && !vm.receiverCustomerWard) {
      return FhdMessenger.error('Cần điền phường của người nhận hàng');
    }

    if (!vm.items.length) {
      return FhdMessenger.error('Bạn chưa nhập sản phẩm');
    }

    if (!vm.businessCustomer) {
      return FhdMessenger.error('Chưa điền khách mua sỉ');
    }

    if (!vm.deadline) {
      return FhdMessenger.error('Chưa điền ngày nhận dự kiến');
    }

    _.forEach(vm.items, item => {
      if (item.businessSoldPrice) {
        item.price = item.businessSoldPrice;
      }
    });

    create();
  };

  function create() {
    vm.receiverCustomerAddress = `${vm.receiverCustomerStreet}, ${vm.receiverCustomerDistrict}`;

    const receiverDistrict = _.find(vm.data.districts, {
      label: vm.receiverCustomerDistrict
    });

    if (!receiverDistrict) {
      return FhdMessenger.error('Chưa chọn quận của địa chỉ nhận hàng');
    }

    _.forEach(vm.items, item => {
      if (item.businessSoldPrice) {
        item.soldPrice = item.businessSoldPrice;
      }
    });

    FhdMessenger.info('Đang tạo...');
    const wholesaleOrder = new WholesaleOrders({
      items: vm.items,
      businessCustomer: vm.businessCustomer,
      orderValue: vm.orderValue,
      receiverCustomer: {
        name: vm.receiverCustomerName,
        email: vm.receiverCustomerEmail,
        cellphone: vm.receiverCustomerCellphone,
        address: vm.receiverCustomerAddress,
        originalAddress: vm.receiverCustomerAddress,
        city: receiverDistrict.city,
        district: receiverDistrict.district,
        street: vm.receiverCustomerStreet,
        ward: vm.receiverCustomerWard || null
      },
      usedPoints: vm.usedPoints,
      status: 'created',
      deadline: vm.deadline,
      outlet: vm.outlet,
      sellingOutlet: vm.sellingOutlet,
      notes: vm.note ? [{
        content: vm.note,
        user: ObjectId.getObjectId(vm.user),
        time: Date.now()
      }] : []
    });
    return wholesaleOrder.$save().then(wholesaleOrder => {
      FhdMessenger.success('Tạo xong!');
      return wholesaleOrder;
    }).then(wholesaleOrder => $modalInstance.close(wholesaleOrder)).catch(FhdMessenger.errorFromServer);
  }

  vm.selectCustomer = async businessCustomer => {
    if (!businessCustomer) {
      vm.businessCustomer = null;
      vm.calculate();
      return;
    }

    CalculateService.getSpecialPrice(businessCustomer).then(specialPrice => {
      vm.specialPrice = specialPrice;

      _.forEach(vm.items, item => {
        if (specialPrice[item.sku]) {
          item.businessSoldPrice = specialPrice[item.sku].expectPrice;
          item.specialPriceEntry = specialPrice[item.sku]._id;
        }
      });

      vm.calculate();
      vm.receiverCustomerName = businessCustomer.name;
      vm.receiverCustomerCellphone = businessCustomer.cellphone;

      if (businessCustomer.email) {
        vm.receiverCustomerEmail = businessCustomer.email;
      }

      if (businessCustomer.address) {
        vm.receiverCustomerDistrict = vm.receiverCustomerDistrict = _.find(vm.data.districts, {
          district: businessCustomer.district
        }).label;
        vm.getWard();
        vm.receiverCustomerWard = businessCustomer.ward;
        vm.receiverCustomerStreet = businessCustomer.street;
      }
    }).catch(err => {
      FhdMessenger.error(err);
    });
    BusinessCustomerService.getCustomerPoints(businessCustomer).then(data => {
      vm.availablePoints = data.point;
    });
  };

  vm.addItem = function (inputItem) {
    const allItems = CalculateService.addProduct({
      inputItem,
      items: vm.items,
      assignedOutlet: vm.assignedOutlet
    });
    vm.items = allItems;
    vm.calculate();
  };
}]);
"use strict";

angular.module('wholesale-orders').controller('ModalCancelWholesaleOrderController', ['$modalInstance', 'FhdMessenger', 'WholesaleOrderModal', 'WholesaleOrders', 'wholesaleOrder', function ($modalInstance, FhdMessenger, WholesaleOrderModal, WholesaleOrders, wholesaleOrder) {
  const vm = this;
  vm.wholesaleOrder = wholesaleOrder;
  vm.data = {};
  vm.dismiss = $modalInstance.dismiss;

  vm.cancel = function (wholesaleOrder, index) {
    if (!vm.cancelNote) {
      return FhdMessenger.error('Wholesale Order chưa có lý do xóa');
    }

    vm.waiting = true;
    wholesaleOrder.$cancel().then(wholesaleOrder => {
      FhdMessenger.success('Xóa thành công');
      $modalInstance.close(wholesaleOrder);
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('wholesale-orders').controller('ModalCreateRestockListsController', ['$modalInstance', 'Authentication', 'FhdMessenger', 'StockMap', 'wholesaleOrder', function ($modalInstance, Authentication, FhdMessenger, StockMap, wholesaleOrder) {
  const vm = this;
  vm.user = Authentication.user;
  vm.wholesaleOrder = wholesaleOrder;
  vm.data = {};
  vm.dismiss = $modalInstance.dismiss;
  StockMap.getStockMapCache().then(data => {
    _.forEach(vm.wholesaleOrder.items, item => {
      item.stock = _.get(data, `${item.product._id}.${_.get(item.product, 'warehouseRestock.code', 'D5')}`, 0);
      item.takeFromD5 = false;
    });

    vm.wholesaleOrder.items = _.sortBy(vm.wholesaleOrder.items, 'stock');
  });

  vm.createRestockLists = () => {
    if (!_.intersection(vm.user.roles, ['admin', 'restock-lists:import']).length) {
      return FhdMessenger.error('Bạn không có quyền tạo restock list');
    }

    if (vm.wholesaleOrder.outlet.code === 'E0' && !vm.wholesaleOrder.shippingArea) {
      return FhdMessenger.error('Bạn chưa chọn khu vực restock cho wholesale order');
    }

    vm.waiting = true;
    vm.wholesaleOrder.$createRestockLists().then(_wholesaleOrder => {
      FhdMessenger.success('Tạo restock lists thành công');
      return $modalInstance.close(_wholesaleOrder);
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('wholesale-orders').controller('ModalUpdateActualItemsForWholesaleOrderController', ['$modalInstance', '$scope', 'Authentication', 'FhdMessenger', 'wholesaleOrder', function ($modalInstance, $scope, Authentication, FhdMessenger, wholesaleOrder) {
  const vm = this;
  vm.user = Authentication.user;
  vm.wholesaleOrder = wholesaleOrder;
  vm.data = {};
  vm.wholesaleOrder.actualItems = [];
  vm.dismiss = $modalInstance.dismiss;

  vm.calculate = () => {
    vm.wholesaleOrder.actualItems = _.map(vm.wholesaleOrder.actualItems, item => {
      item.soldPrice = item.specialPrice || item.salePrice || item.price;
      item.originalPrice = item.price;
      item.lineTotal = item.soldPrice * item.quantity;
      return item;
    });
    vm.wholesaleOrder.actualValue = _.sumBy(vm.wholesaleOrder.actualItems, 'lineTotal');
  };

  vm.addActualItem = function (product) {
    vm.wholesaleOrder.actualItems = vm.wholesaleOrder.actualItems || [];

    const item = _objectSpread({}, product, {
      product: product._id
    });

    vm.wholesaleOrder.actualItems.push(item);
    vm.calculate();
  };

  vm.updateActualItems = () => {
    if (!_.get(vm.wholesaleOrder, 'actualItems.length')) {
      return FhdMessenger.error('Bạn chưa điền danh sách sản phẩm tạo sale entry');
    }

    vm.waiting = true;
    vm.wholesaleOrder.$updateActualItems().then(_wholesaleOrder => {
      FhdMessenger.success('Cập nhật danh sách sản phẩm tạo sale entry thành công');
      return $modalInstance.close(_wholesaleOrder);
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('wholesale-orders').controller('ModalUpdateUsedPointsController', ['wholesaleOrder', 'FhdMessenger', 'Address', '$modalInstance', function (wholesaleOrder, FhdMessenger, Address, $modalInstance) {
  const vm = this;

  vm.close = () => {
