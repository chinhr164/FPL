}]);
"use strict";

angular.module('evaluation-rank-entries').controller('ModalVoteController', ['FhdMessenger', 'evaluationRankEntry', 'outletCode', '$modalInstance', function (FhdMessenger, evaluationRankEntry, outletCode, $modalInstance) {
  const vm = this;
  vm.evaluationRankEntry = evaluationRankEntry;
  vm.outletCode = outletCode;

  vm.submit = () => {
    if (!vm.vote) {
      return FhdMessenger.error('Bạn chưa chọn kết quả');
    }

    if (!vm.comment && vm.outletCode !== 'HR') {
      return FhdMessenger.error('Bạn chưa điền nhận xét');
    }

    const allowed = vm.vote === 'Đồng ý';
    const comment = vm.comment;
    $modalInstance.close({
      allowed,
      comment
    });
  };

  vm.votes = ['Đồng ý', 'Không đồng ý'];

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
"use strict";

angular.module('evaluation-rank-entries').factory('EvaluationRankEntries', ['$resource', function ($resource) {
  return $resource('evaluation-rank-entries/:evaluationRankEntryId', {
    evaluationRankEntryId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    vote: {
      method: 'POST',
      url: '/evaluation-rank-entries/:evaluationRankEntryId/vote'
    },
    selectResult: {
      method: 'POST',
      url: '/evaluation-rank-entries/:evaluationRankEntryId/select-result'
    },
    import: {
      method: 'POST',
      url: '/evaluation-rank-entries/import',
      isArray: true
    }
  });
}]);
"use strict";

angular.module('evaluation-rank-entries').factory('EvaluationRankEntriesService', ['$modal', function ($modal) {
  function openModalVote(evaluationRankEntry, outletCode) {
    return $modal.open({
      animation: true,
      controller: 'ModalVoteController',
      controllerAs: 'vm',
      templateUrl: '/modules/evaluation-rank-entries/templates/modal-vote.client.view.html',
      resolve: {
        evaluationRankEntry: () => evaluationRankEntry,
        outletCode: () => outletCode
      }
    }).result;
  }

  function openModalViewEvaluationRankEntry(evaluationRankEntry) {
    return $modal.open({
      animation: true,
      controller: 'ModalViewEvaluationRankEntryController',
      controllerAs: 'vm',
      templateUrl: '/modules/evaluation-rank-entries/templates/modal-view-evaluation-rank-entry.client.view.html',
      resolve: {
        evaluationRankEntry: () => evaluationRankEntry
      }
    }).result;
  }

  return {
    openModalVote,
    openModalViewEvaluationRankEntry
  };
}]);
