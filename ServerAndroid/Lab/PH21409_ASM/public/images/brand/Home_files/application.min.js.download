'use strict'; // Checklist criterias controller

angular.module('checklist-criterias').controller('ChecklistCriteriasController', ['helper', 'Authentication', 'ChecklistCriterias', 'ChecklistEntriesService', 'ConfirmModal', 'FhdMessenger', 'NgTableParams', 'OutletService', 'ObjectId', '$state', '$stateParams', '$scope', '$location', function (helper, Authentication, ChecklistCriterias, ChecklistEntriesService, ConfirmModal, FhdMessenger, NgTableParams, OutletService, ObjectId, $state, $stateParams, $scope, $location) {
  const vm = this;
  vm.user = Authentication.user;
  vm.checklistCriteria = {};
  vm.data = {};
  vm.checklistCriteriasTable = new NgTableParams({
    count: 50
  });
  const defaultGroups = [{
    id: 'product',
    title: 'CHẤT LƯỢNG SẢN PHẨM'
  }, {
    id: 'process',
    title: 'QUY TRÌNH NHÂN VIÊN'
  }, {
    id: 'space',
    title: 'KHÔNG GIAN CHUNG'
  }, {
    id: 'facility',
    title: 'CƠ SỞ VẬT CHẤT'
  }];
  vm.removeValueFromArray = helper.removeValueFromArray;
  vm.getTypes = ChecklistEntriesService.getTypes;

  vm.addValue = value => {
    vm.checklistCriteria.values = vm.checklistCriteria.values || [];
    if (!_.includes(vm.checklistCriteria.values, value)) vm.checklistCriteria.values.push(value);
  };

  vm.getDepartments = () => [{
    title: 'FRONTEND',
    id: 'FRONTEND'
  }, {
    title: 'BACKEND',
    id: 'BACKEND'
  }];

  vm.getListGroups = async query => {
    const checklistCriterias = await query;

    const groups = _.uniq(_.map(checklistCriterias, checklistCriteria => {
      return _.trim(_.get(checklistCriteria, 'group', ''));
    }));

    return _.sortBy(_.map(groups, group => {
      const matchGroup = _.find(defaultGroups, {
        id: group
      });

      return {
        id: group,
        title: _.get(matchGroup, 'title', group)
      };
    }), 'title');
  };

  vm.data = {}; // Create new Checklist entry

  vm.create = function () {
    if (!vm.checklistCriteria.business) {
      return FhdMessenger.error('Chưa có business');
    }

    if (!vm.checklistCriteria.department) {
      return FhdMessenger.error('Chưa có bộ phận kiểm tra');
    }

    if (!vm.checklistCriteria.type) {
      return FhdMessenger.error('Chưa có kiểu kiểm tra');
    }

    if (!vm.checklistCriteria.group) {
      return FhdMessenger.error('Chưa có nhóm kiểm tra');
    }

    if (!vm.checklistCriteria.content) {
      return FhdMessenger.error('Chưa có nội dung kiểm tra');
    }

    const checklistCriteria = new ChecklistCriterias(vm.checklistCriteria);
    vm.waiting = true; // Redirect after save

    checklistCriteria.$save(function (response) {
      FhdMessenger.success('Thêm thành công!');
      $state.reload();
    }, function (errorResponse) {
      vm.waiting = false;
      FhdMessenger.error(errorResponse.data.message);
    });
  };

  vm.find = async function () {
    return ChecklistCriterias.query({}).$promise.then(checklistCriterias => {
      vm.checklistCriteriasTable.settings({
        dataset: checklistCriterias
      });
      return checklistCriterias;
    });
  };

  vm.init = () => {
    OutletService.all().then(outlets => {
      vm.data.outlets = outlets;
    });
    vm.data.groups = defaultGroups;
  };

  vm.getGroups = () => {
    if (['outlet', 'mooncake', 'covid'].includes(_.get(vm.checklistCriteria, 'type'))) {
      vm.data.groups = defaultGroups;
    } else if (_.get(vm.checklistCriteria, 'type') === 'topical') {
      vm.data.groups = [{
        id: 'Poster Abby',
        title: 'Poster Abby'
      }, {
        id: 'Tiêu hủy cuối ca',
        title: 'Tiêu hủy cuối ca'
      }, {
        id: 'Double check tag nhãn và hóa đơn',
        title: 'Double check tag nhãn và hóa đơn'
      }, {
        id: 'Savor - Tác phong giờ vắng khách',
        title: 'Savor - Tác phong giờ vắng khách'
      }, {
        id: 'Quy trình tiếp đón khách hàng Abby',
        title: 'Quy trình tiếp đón khách hàng Abby'
      }];
    }
  };

  vm.findOne = async function () {
    ChecklistCriterias.get({
      checklistCriteriaId: $stateParams.checklistCriteriaId
    }).$promise.then(checklistCriteria => {
      vm.checklistCriteria = checklistCriteria;
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    });
  };

  vm.update = async function () {
    vm.waiting = true;
    let checklistCriteria = vm.checklistCriteria;
    checklistCriteria.$update().then(_checklistCriteria => {
      //  vm.checklistCriteria = _checklistCriteria
      FhdMessenger.success('Cập nhật thành công');
      $location.path('/checklist-criterias');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.remove = async function (checklistCriteria) {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Xóa Checklist Criteria của  ${checklistCriteria.description ? checklistCriteria.description : checklistCriteria.content}`
    }).then(() => {
      vm.waiting = true;
      checklistCriteria.$remove().then(_checklistCriteria => {
        //  vm.checklistCriteria = _checklistCriteria
        FhdMessenger.success('Xóa thành công');
        vm.find();
      }).catch(err => {
        FhdMessenger.error(err.data.message);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
'use strict';

angular.module('users').filter('checklistCriteriaGroup', [function () {
  return function (group) {
    switch (group) {
      case 'product':
        return 'CHẤT LƯỢNG SẢN PHẨM';

      case 'process':
        return 'QUY TRÌNH NHÂN VIÊN';

      case 'space':
        return 'KHÔNG GIAN CHUNG';

      case 'facility':
        return 'Cơ sở vật chất';

      default:
        return group;
    }
  };
}]);
'use strict';

angular.module('users').filter('checklistCriteriaType', ['ChecklistEntriesService', 'helper', function (ChecklistEntriesService, helper) {
  const types = ChecklistEntriesService.getTypes();
  const typeMap = helper.makeMap(types, 'id');
  return function (type) {
    return _.get(typeMap[type], 'title', type);
  };
}]);
