angular.module('users').component('createUser', {
  bindings: {
    user: '='
  },
  templateUrl: 'modules/users/templates/create-user.client.template.html',
  controllerAs: 'vm',
  controller: ['Authentication', 'FhdMessenger', 'ObjectId', 'UserService', 'Address', 'WorkDepartmentService', 'WorkPositions', 'BusinessService', 'Outlets', function (Authentication, FhdMessenger, ObjectId, UserService, Address, WorkDepartmentService, WorkPositions, BusinessService, Outlets) {
    const vm = this;
    vm.Authentication = Authentication;
    vm.theUser = Authentication.user;

    vm.init = () => {
      vm.data = vm.data || {};
      vm.user.images = vm.user.images || [];
      vm.districts = Address.getDistricts();
      BusinessService.allAsync().then(businesses => {
        vm.data.businesses = businesses;
      });
      WorkDepartmentService.allAsync().then(workDepartments => {
        vm.data.workDepartments = workDepartments;
      });
      WorkPositions.query().$promise.then(workPositions => {
        vm.data.workPositions = workPositions;
      });
      vm.data.outlets = Outlets.query();
      UserService.getRolesInTypes().then(roleTypes => {
        vm.roleTypes = roleTypes;
        vm.rolePositionsMap = _.find(vm.roleTypes, {
          id: 'positions'
        }).roles;
      });
      UserService.getRoleHideMap().then(roleHideMap => {
        vm.roleHideMap = roleHideMap;
        vm.rolePositionsMap = _.find(vm.roleTypes, {
          id: 'positions'
        }).roles;
        vm.user.rolePositions = _.map(vm.rolePositionsMap, 'id');
      });
      UserService.getRoleMap().then(roleMap => {
        vm.user.roleMap = _.clone(roleMap);
        vm.user.roleMap['rank-a'] = true;
        vm.user.roleMap['user'] = true;
        vm.user.roleMap['staff'] = true;
      });
    };

    vm.getCode = function (code) {
      if (!code) {
        return FhdMessenger.error('Bạn chưa điền ký tự đầu của mã nhân viên');
      }

      UserService.getCode(code).then(code => {
        vm.user.code = code;
      });
    };

    vm.removeBusiness = function (index) {
      vm.user.businesses.splice(index, 1);
    };

    vm.changeBusiness = function () {
      vm.user.businesses = vm.user.businesses || [];
      vm.user.businesses.push(vm.user.business);
      vm.user.businesses = _.union(vm.user.businesses);
    };

    vm.removeOutlet = function (index) {
      vm.user.managingOutlets.splice(index, 1);
    };

    vm.addManagingOutlet = function () {
      const managingOutlet = vm.user.managingOutlet;
      vm.user.managingOutlets = vm.user.managingOutlets || [];
      vm.user.managingOutlet = null;

      if (_.some(vm.user.managingOutlets, outlet => {
        return outlet._id === managingOutlet._id;
      })) {
        return;
      }

      vm.user.managingOutlets.push(managingOutlet);
    };

    vm.removeWorkDepartment = function (index) {
      vm.user.workDepartments.splice(index, 1);
    };

    vm.removeWorkPosition = function (index) {
      vm.user.workPositions.splice(index, 1);
    };

    vm.changeWorkDepartment = choosenWorkDepartment => {
      vm.workDepartment = null;
      vm.user.workDepartments = vm.user.workDepartments || [];

      if (!_.some(vm.user.workDepartment, workDepartment => _.isEqual(workDepartment._id, choosenWorkDepartment._id))) {
        vm.user.workDepartments.push(choosenWorkDepartment);
      }
    };

    vm.changeWorkPosition = choosenWorkPosition => {
      vm.workPosition = null;
      vm.user.workPositions = vm.user.workPositions || [];

      if (!_.some(vm.user.workPositions, workPosition => ObjectId.equals(workPosition, choosenWorkPosition))) {
        vm.user.workPositions.push(choosenWorkPosition);

        _.forEach(choosenWorkPosition.roles, role => {
          vm.user.roleMap[role] = true;
        });
      }
    };
  }]
});
'use strict'; // Config HTTP Error Handling

angular.module('users').config(['$httpProvider', function ($httpProvider) {
  // Set the httpProvider "not authorized" interceptor
  $httpProvider.interceptors.push(['$q', '$location', 'Authentication', '$localStorage', function ($q, $location, Authentication, $localStorage) {
    return {
      responseError: function (rejection) {
        switch (rejection.status) {
          case 401:
            // Deauthenticate the global user
            Authentication.user = null;
            const expectRoute = $localStorage.get('expectRoute');

            if (expectRoute === 'null') {
              // If there are no expectRoute => set new one
              $localStorage.setObject('expectRoute', $location.path());
            } // Redirect to signin page


            $location.path('signin');
            break;

          case 403:
            // Add unauthorized behaviour
            break;
        }

        return $q.reject(rejection);
      }
    };
  }]);
}]);
