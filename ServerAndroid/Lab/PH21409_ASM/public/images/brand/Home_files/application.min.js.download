angular.module('kpi-salaries').controller('KpiSalaryController', ['$state', 'Authentication', 'ConfirmModal', 'KpiSalaries', 'FhdMessenger', 'NgTableParams', function ($state, Authentication, ConfirmModal, KpiSalaries, FhdMessenger, NgTableParams) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.showResult = false;
  vm.data.startDate = moment().startOf('month').format('YYYY-MM-DD');
  vm.data.endDate = moment().endOf('month').format('YYYY-MM-DD');
  vm.month = moment().dates() < 20 ? moment().subtract(1, 'month').startOf('month').format('YYYY-MM-DD') : moment().startOf('month').format('YYYY-MM-DD');
  vm.kpiSalariesTable = new NgTableParams({
    count: 50
  });

  function isAllValidField(items, field) {
    return _.some(items, item => {
      return !_.get(item, field);
    });
  }

  vm.months = _.range(1, 13);

  vm.find = () => {
    vm.kpiSalaries = KpiSalaries.query({
      startDate: vm.data.startDate,
      endDate: vm.data.endDate
    });
    vm.kpiSalaries.$promise.then(kpiSalaries => {
      _.forEach(kpiSalaries, kpiSalary => {
        kpiSalary.sumSalary = _.sumBy(kpiSalary.results, result => {
          return result.salary;
        });
      });

      vm.kpiSalariesTable.settings({
        dataset: kpiSalaries
      });
    });
  };

  vm.remove = (kpiSalary, index) => {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Huỷ',
      actionButtonText: 'Xóa',
      headerText: 'Xóa Kpi Salary ?',
      bodyText: `Bạn có chắc là bạn muốn xóa không ? `
    }).then(() => {
      vm.waiting = true;
      kpiSalary.$delete().then(() => {
        FhdMessenger.success('Đã xóa Kpi Salary');
        vm.kpiSalaries.splice(index, 1);
        vm.kpiSalariesTable.reload();
        vm.waiting = false;
      });
    });
  };

  vm.import = () => {
    if (!vm.items) {
      return;
    }

    if (isAllValidField(vm.items, 'userCode')) {
      return FhdMessenger.error('Bạn chưa điền đủ userCode');
    }

    if (isAllValidField(vm.items, 'outletCode')) {
      return FhdMessenger.error('Bạn chưa điền đủ outletCode');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Bạn chắc chắc muốn import chứ?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      KpiSalaries.import({
        items: vm.items,
        month: vm.month
      }).$promise.then(kpiSalaries => {
        FhdMessenger.success(`Import ${kpiSalaries.length} Kpi Salaries thành công`);
        return $state.go('listKpiSalaries');
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
