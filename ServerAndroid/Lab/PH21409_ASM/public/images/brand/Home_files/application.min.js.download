angular.module('products').controller('ListUseInPlProductsController', ['NgTableParams', 'Products', 'ProductService', 'StockMap', '$q', function (NgTableParams, Products, ProductService, StockMap, $q) {
  const vm = this;
  vm.productsTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    vm.products = Products.query({
      productType: ['wrapper', 'label', 'tool', 'vendorProduct']
    });
