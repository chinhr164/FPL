angular.module('probation-shift-entries').controller('ModalSelectPointForApplicationFormController', ['$modalInstance', 'FhdMessenger', 'ProbationShiftEntries', 'ProbationShiftEntriesService', 'data', function ($modalInstance, FhdMessenger, ProbationShiftEntries, ProbationShiftEntriesService, data) {
  const vm = this;
  vm.waiting = true;
  ProbationShiftEntries.get({
    probationShiftEntryId: data.probationShiftEntryId
  }).$promise.then(probationShiftEntry => {
    vm.probationShiftEntry = probationShiftEntry;
    vm.waiting = false;
  });
  vm.applicationForm = data.applicationForm;
  vm.data = {};
  vm.dismiss = $modalInstance.dismiss;

  vm.update = function () {
    if (!vm.probationShiftEntry.point) {
      return FhdMessenger.error('Probation Shift Entry chưa có lý do xóa');
    }

    const point = _.cloneDeep(vm.probationShiftEntry.point);

    vm.probationShiftEntry.applicationForm = vm.applicationForm._id;
    vm.waiting = true;
    vm.probationShiftEntry.$updatePoint().then(probationShiftEntry => {
      FhdMessenger.success('Cập nhật điểm thành công');
      $modalInstance.close(point);
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('probation-shift-entries').controller('ProbationShiftEntriesController', ['$stateParams', '$location', '$scope', 'helper', 'Authentication', 'ProbationShiftEntries', 'ProbationShiftEntriesService', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'HRTasks', 'WorkPositions', 'WorkPositionService', function ($stateParams, $location, $scope, helper, Authentication, ProbationShiftEntries, ProbationShiftEntriesService, FhdMessenger, NgTableParams, ObjectId, HRTasks, WorkPositions, WorkPositionService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.startDate = moment().startOf('week').format('YYYY-MM-DD');
  vm.endDate = moment().add(1, 'week').endOf('week').format('YYYY-MM-DD');
  vm.statuses = {
    active: {
      value: true,
      className: 'label-success',
      name: 'active'
    },
    inactive: {
      value: false,
      className: 'label-danger',
      name: 'inactive'
    }
  };

  vm.workPositionSelected = workPosition => {
    vm.probationShiftEntry.workPositions = vm.probationShiftEntry.workPositions || [];
    vm.probationShiftEntry.workPositions.push(workPosition);
  };

  vm.removeValueFromArray = helper.removeValueFromArray;

  vm.create = function () {
    if (!vm.probationShiftEntry.workPositions.length) {
      return FhdMessenger.error('Chưa chọn vị trí');
    }

    if (!vm.probationShiftEntry.date) {
      return FhdMessenger.error('Chưa chọn ngày');
    }

    if (moment(vm.probationShiftEntry.date).isBefore(moment().subtract(1, 'day').endOf('day'))) {
      return FhdMessenger.error(`Ngày của ca học việc phải sau ngày hôm nay. Hiện tại bạn đang nhập ngày học việc là ${moment(vm.probationShiftEntry.date).format('YYYY/MM/DD')}`);
    }

    if (!vm.probationShiftEntry.outlet) {
      return FhdMessenger.error('Chưa chọn cơ sở học việc');
    }

    if (!vm.probationShiftEntry.staff) {
      return FhdMessenger.error('Chưa chọn người hướng dẫn');
    }

    if (!vm.probationShiftEntry.startTime) {
      return FhdMessenger.error('Chưa chọn giờ bắt đầu');
    }

    if (!vm.probationShiftEntry.endTime) {
      return FhdMessenger.error('Chưa chọn giờ kết thúc');
    }

    vm.probationShiftEntry.startTime = helper.combineTimeAndDate(vm.probationShiftEntry.date, vm.probationShiftEntry.startTime);
    vm.probationShiftEntry.endTime = helper.combineTimeAndDate(vm.probationShiftEntry.date, vm.probationShiftEntry.endTime);
    const probationShiftEntry = new ProbationShiftEntries(vm.probationShiftEntry);
    vm.waiting = true;
    probationShiftEntry.$save().then(newProbationShiftEntry => {
      FhdMessenger.success('Tạp Probation Shift Entry thành công');
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.probationShiftEntriesTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    const statuses = _.reduce(vm.statuses, (result, status, name) => {
      if (status.value) result.push(name);
      return result;
    }, []);

    ProbationShiftEntries.query({
      startDate: vm.startDate,
      endDate: vm.endDate,
      statuses
    }).$promise.then(probationShiftEntries => {
      vm.probationShiftEntries = probationShiftEntries;
      vm.probationShiftEntriesTable.settings({
        dataset: vm.probationShiftEntries
      });
    });
  };

  vm.findOne = async () => {
    vm.probationShiftEntry = ProbationShiftEntries.get({
      probationShiftEntryId: $stateParams.probationShiftEntryId
    }).$promise.then(probationShiftEntry => {
      vm.probationShiftEntry = probationShiftEntry;
    });
  };

  vm.update = () => {
    vm.waiting = true;
    vm.probationShiftEntry.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('probation-shift-entries');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statuses, 'value')) changeValue = false;

          _.forEach(vm.statuses, (value, key) => {
            vm.statuses[key].value = changeValue;
          });

          break;
        }

      default:
    }
  };

  vm.openModalCancelProbationShiftEntry = ProbationShiftEntriesService.openModalCancelProbationShiftEntry;
}]);
"use strict";

angular.module('probation-shift-entries').factory('ProbationShiftEntriesService', ['$modal', function ($modal) {
  return {
