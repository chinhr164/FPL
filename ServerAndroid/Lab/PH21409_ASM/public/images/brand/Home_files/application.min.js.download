angular.module('accounts').controller('AccountsController', ['$state', 'Accounts', 'Authentication', 'AccountService', 'NgTableParams', 'FhdMessenger', '$stateParams', '$location', function ($state, Accounts, Authentication, AccountService, NgTableParams, FhdMessenger, $stateParams, $location) {
  const vm = this;
  vm.user = Authentication.user;
  vm.accountsTable = new NgTableParams({
    count: 50
  });
  vm.account = {};
  vm.staffType = 'other';
  vm.staffTypes = [{
    _id: 'outlet',
    name: 'Cơ sở'
  }, {
    _id: 'vendor',
    name: 'Vendor'
  }, {
    _id: 'business-customer',
    name: 'Đại lý'
  }, {
    _id: 'other',
    name: 'Khác'
  }];
  vm.openViewAccountHistoryModal = AccountService.openViewAccountHistoryModal;

  vm.find = () => {
    vm.accounts = Accounts.query({
      staffType: vm.staffType
    }).$promise.then(accounts => {
      vm.accountsTable.settings({
        dataset: accounts
      });
    });
  };

  vm.findOne = () => {
    vm.account = Accounts.get({
      accountId: $stateParams.accountId
    });
  };

  vm.update = () => {
    if (!vm.account.code) {
      return FhdMessenger.error('Vui lòng nhập code');
    }

    if (!vm.account.name) {
      return FhdMessenger.error('Vui lòng nhập tên');
    }

    if (!vm.account.staff) {
      return FhdMessenger.error('Vui lòng nhập nhân viên');
    }

    if (!_.intersection(vm.user.roles, ['admin', 'accountant']).length) {
      return FhdMessenger.error('Bạn không có quyền sửa tài khoản');
    }

    vm.waiting = true;
    vm.account.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      $location.path('/accounts');
      vm.waiting = false;
    });
  };

  vm.create = function () {
    if (!vm.account.code) {
      return FhdMessenger.error('Vui lòng nhập code');
    }

    if (!vm.account.name) {
      return FhdMessenger.error('Vui lòng nhập tên');
    }

    if (!vm.account.staff) {
      return FhdMessenger.error('Vui lòng nhập nhân viên');
    }

    if (!_.intersection(vm.user.roles, ['admin', 'accountant']).length) {
      return FhdMessenger.error('Bạn không có quyền tạo tài khoản');
    }

    var account = new Accounts(vm.account);
    vm.waiting = true;
    account.$save().then(response => {
      vm.account = {};
      FhdMessenger.success('Tạo tài khoản thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('accounts').controller('ModalViewAccountHistoryController', ['$state', '$modalInstance', 'account', 'Authentication', 'NgTableParams', function ($state, $modalInstance, account, Authentication, NgTableParams) {
  const vm = this;
  vm.user = Authentication.user;
  vm.accountTransactionTable = new NgTableParams({
    count: 100
  });
  vm.dismiss = $modalInstance.dismiss;

  vm.find = () => {
    vm.accountHistory = account.$history().then(account => {
      vm.account = account;
      vm.accountTransactionTable.settings({
        dataset: account.transactions
      });
      vm.accountTransactionTable.sorting({
        created: 'desc'
      });
    });
  };
}]);
"use strict";

angular.module('accounts').controller('OutstandingPaymentsController', ['$scope', '$state', 'AccountService', 'Authentication', 'ConfirmModal', 'ExpenseEntryService', 'FhdMessenger', 'NgTableParams', 'PaymentRequests', 'PaymentRequestsService', function ($scope, $state, AccountService, Authentication, ConfirmModal, ExpenseEntryService, FhdMessenger, NgTableParams, PaymentRequests, PaymentRequestsService) {
  const vm = this;
  vm.user = Authentication.user;
  const user = vm.user;
  vm.openModalViewPaymentRequest = PaymentRequestsService.openModalViewPaymentRequest;

  vm.openCreateExpenseEntryModal = function (buyingEntry) {
    const buyingEntries = [buyingEntry];
    ExpenseEntryService.createExpenseEntry(buyingEntries);
  };

  if (!user.roles.includes('admin') && !user.roles.includes('accountant')) {
    $state.go('home');
  }

  vm.buyingEntries = [];

  vm.checkAll = function () {
    _.forEach(vm.buyingEntriesAndPaymentRequestsTable.data, buyingEntry => {
      buyingEntry.checked = vm.toCheck;
    });
  };

  vm.createExpenseEntry = () => {
    vm.buyingEntries = _.filter(vm.buyingEntriesAndPaymentRequestsTable.data, 'checked');

    if (!vm.buyingEntries.length) {
      return FhdMessenger.error('Chưa chọn Buying Entry nào');
    }

    ExpenseEntryService.createExpenseEntry(vm.buyingEntries);
  };

  vm.buyingEntriesAndPaymentRequestsTable = new NgTableParams({
    count: 1000
  });
  vm.accountsTable = new NgTableParams({
    count: 100
  });
  vm.accountsTable.sorting({
    created: 'desc'
  });

  vm.init = () => {
    AccountService.requestMoneySumarize().then(data => {
      vm.data = data;

      _.forEach(vm.data.urgentPaymentRequests, paymentRequest => {
        if (!paymentRequest.vendor && paymentRequest.receiveStaff) {
          paymentRequest.vendor.name = paymentRequest.receiveStaff.displayName;
        }
      });

      vm.buyingEntriesAndPaymentRequestsTable.settings({
        dataset: vm.data.urgentPaymentRequests
      });
      vm.accountsTable.settings({
        dataset: vm.data.accounts
      });
    });
  };

  vm.sumarize = () => {
    if (!vm.data) {
      return;
    }

    vm.totalPaymentRequest = 0;
    vm.totalPaymentRequest = _.reduce(vm.data.urgentPaymentRequests, (result, paymentRequest) => {
      result += paymentRequest.totalMoney;
      return result;
    }, 0);
    vm.totalAmountInAccounts = 0;
    vm.totalAmountInAccounts = _.reduce(vm.accountsTable.data, (result, account) => {
      result += account.totalAmount;
      return result;
    }, 0);
    vm.totalMoneyNeed = vm.totalPaymentRequest - vm.totalAmountInAccounts;
  };

  vm.createMoneyRequest = () => {
    const totalMoneyNeed = vm.totalMoneyNeed;
    vm.waiting = true;
    AccountService.createMoneyRequest(totalMoneyNeed).then(() => {
      FhdMessenger.success('Gửi yêu cầu thành công');
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.close = function (paymentRequest) {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Hoàn thành Payment Request có nội dung ${paymentRequest.content}`,
      bodyText: `Bạn chắc chắn muốn hoàn thành Payment Request với số tiền ${paymentRequest.totalMoney}`
    }).then(() => {
      vm.paymentRequest = PaymentRequests.get({
        paymentRequestId: paymentRequest._id
      });
      vm.paymentRequest.$promise.then(_paymentRequest => {
        vm.waiting = false;

        _paymentRequest.$close().then(paymentRequest => {
          FhdMessenger.success('Hoàn thành yêu cầu chuyển tiền');
          vm.init();
        }).catch(error => {
          FhdMessenger.errorFromServer(error);
        }).finally(() => {
          vm.waiting = false;
        });
      });
    });
  };

  vm.cancel = function (paymentRequest) {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Hủy Payment Request có nội dung ${paymentRequest.content}`,
      bodyText: `Bạn chắc chắn muốn hủy Payment Request với số tiền ${paymentRequest.totalMoney}`
    }).then(() => {
      vm.paymentRequest = PaymentRequests.get({
        paymentRequestId: paymentRequest._id
      });
      vm.paymentRequest.$promise.then(_paymentRequest => {
        vm.waiting = false;

        _paymentRequest.$cancel().then(paymentRequest => {
          FhdMessenger.success('Hủy yêu cầu chuyển tiền');
          vm.init();
        }).catch(error => {
          FhdMessenger.errorFromServer(error);
        }).finally(() => {
          vm.waiting = false;
        });
      });
    });
  };

  $scope.$watch(() => vm.buyingEntriesAndPaymentRequestsTable.data, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    vm.sumarize();
  });
  $scope.$watch(() => vm.accountsTable.data, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    vm.sumarize();
  });
}]);
'use strict';

angular.module('accounts').factory('Accounts', ['$resource', function ($resource) {
  return $resource('accounts/:accountId', {
    accountId: '@_id'
  }, {
    history: {
      method: 'GET',
      url: 'accounts/:accountId/history'
    },
    update: {
      method: 'PUT'
    }
  });
}]);
'use strict';

angular.module('accounts').factory('AccountService', ['$http', '$modal', 'Accounts', function ($http, $modal, Accounts) {
  var accounts;
  var accountsAsync;
  var outletsWithAllAsync;

  function load() {
    accounts = $http.get('/accounts/avaiable').then(response => {
      return response.data;
    });
    accountsAsync = accounts;
  }

  function attachAllAccountsOption(accounts) {
    var _accounts = _.cloneDeep(accounts);

    _accounts.push({
      code: null,
      name: '== Chưa chọn =='
    });

    return _accounts;
  }

  return {
    openViewAccountHistoryModal(account) {
      return $modal.open({
        templateUrl: 'modules/accounts/views/modal-view-account-history.client.view.html',
        controller: 'ModalViewAccountHistoryController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          account: () => account
        }
      });
    },

    requestMoneySumarize() {
      return $http.get('/reports/request-money').then(response => response.data);
    },

    createMoneyRequest(totalMoneyNeed) {
      return $http.put('/reports/request-money', {
        totalMoneyNeed
      }).then(response => response.data);
    },

    allAsync() {
      if (!accountsAsync) {
        load();
      }

      return accountsAsync;
    },

    withAllOptionAsync() {
      if (!accountsAsync) {
        load();
      }

      if (!outletsWithAllAsync) {
        outletsWithAllAsync = accountsAsync.then(attachAllAccountsOption);
      }

      return outletsWithAllAsync;
    }

  };
}]);
"use strict";

