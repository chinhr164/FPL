angular.module('product-cats').controller('ModalCreateProductCatController', ['$scope', '$modalInstance', 'department', 'ProductCats', 'FhdMessenger', function ($scope, $modalInstance, department, ProductCats, FhdMessenger) {
  $scope.department = department;

  $scope.create = function () {
    var productCat = new ProductCats({
      name: $scope.name,
      productDepartment: department._id,
      productGroup: department.productGroup
    });
    productCat.$save(function (productCat) {
      FhdMessenger.success('Tạo thành công.');
      $modalInstance.close(productCat);
    }, function (error) {
      FhdMessenger.errorFromServer(error);
    });
  };
}]);
'use strict'; // Product cats controller

angular.module('product-cats').controller('ProductCatsController', ['$scope', '$stateParams', '$location', 'Authentication', 'ProductCats', function ($scope, $stateParams, $location, Authentication, ProductCats) {
  $scope.authentication = Authentication; // Create new Product cat

  $scope.create = function () {
    // Create new Product cat object
    var productCat = new ProductCats({
      name: this.name
    }); // Redirect after save

    productCat.$save(function (response) {
      $location.path('product-cats/' + response._id); // Clear form fields

      $scope.name = '';
    }, function (errorResponse) {
      $scope.error = errorResponse.data.message;
    });
  }; // Remove existing Product cat


  $scope.remove = function (productCat) {
    if (productCat) {
      productCat.$remove();

      for (var i in $scope.productCats) {
        if ($scope.productCats[i] === productCat) {
          $scope.productCats.splice(i, 1);
        }
      }
    } else {
      $scope.productCat.$remove(function () {
        $location.path('product-cats');
      });
    }
  }; // Update existing Product cat


  $scope.update = function () {
    var productCat = $scope.productCat;
    productCat.$update(function () {
      $location.path('product-cats/' + productCat._id);
    }, function (errorResponse) {
      $scope.error = errorResponse.data.message;
    });
  }; // Find a list of Product cats


  $scope.find = function () {
    $scope.productCats = ProductCats.query();
  }; // Find existing Product cat


  $scope.findOne = function () {
    $scope.productCat = ProductCats.get({
      productCatId: $stateParams.productCatId
    });
  };
}]);
"use strict";

angular.module('product-cats').factory('ProductCatService', ['ProductCats', function (ProductCats) {
  let productCats;
  return {
    getProductCats(callback) {
      if (!productCats) {
        productCats = ProductCats.query();
      }

      productCats.$promise.then(productCats => {
        if (callback) callback(productCats);
      });
      return productCats.$promise;
    },

    getSavorCats() {
      return ProductCats.getSavor().$promise.then(cats => _.map(cats.sort((a, b) => {
        return a.name.localeCompare(b.name);
      }), cat => ({
        id: cat.name,
        title: cat.name
      })));
    }

  };
}]);
'use strict'; // Product cats service used to communicate Product cats REST endpoints

angular.module('product-cats').factory('ProductCats', ['$resource', function ($resource) {
  return $resource('product-cats/:productCatId', {
    productCatId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    getSavor: {
      method: 'GET',
      url: '/product-cats/savor',
      isArray: true
    }
  });
}]);
