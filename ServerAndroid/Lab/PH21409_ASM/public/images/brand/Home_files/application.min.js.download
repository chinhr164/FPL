angular.module('probation-shift-entries').controller('ModalCancelProbationShiftEntryController', ['$modalInstance', 'FhdMessenger', 'ProbationShiftEntries', 'ProbationShiftEntriesService', 'probationShiftEntry', function ($modalInstance, FhdMessenger, ProbationShiftEntries, ProbationShiftEntriesService, probationShiftEntry) {
  const vm = this;
  vm.probationShiftEntry = probationShiftEntry;
  vm.data = {};

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.dismiss = $modalInstance.dismiss;

  vm.cancel = function () {
    if (!vm.probationShiftEntry.cancelNote) {
      return FhdMessenger.error('Probation Shift Entry chưa có lý do xóa');
    }

    vm.waiting = true;
    probationShiftEntry.$cancel().then(probationShiftEntry => {
      FhdMessenger.success('Xóa thành công');
      $modalInstance.close(probationShiftEntry);
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
