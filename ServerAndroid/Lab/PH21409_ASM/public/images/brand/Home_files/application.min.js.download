angular.module('payment-requests').controller('ModalCreatePaymentRequestController', ['$modalInstance', 'buyingEntries', 'Vendors', '$scope', 'FhdMessenger', 'PaymentRequests', 'PaymentRequestsService', 'BuyingEntryService', 'workTask', '$state', 'complaint', function ($modalInstance, buyingEntries, Vendors, $scope, FhdMessenger, PaymentRequests, PaymentRequestsService, BuyingEntryService, workTask, $state, complaint) {
  const vm = this;
  vm.paymentRequest = {};
  vm.data = {};
  vm.buyingEntries = buyingEntries;
  vm.vendorOnly = true;
  vm.complaint = complaint;

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.waiting = false;

  vm.init = () => {
    if (_.get(buyingEntries, 'length')) {
      vm.data.vendors = Vendors.query();
      vm.paymentRequest.vendor = _.head(vm.buyingEntries).vendor;
      vm.paymentRequest.buyingEntries = vm.buyingEntries;
      vm.paymentRequest.content = `Thanh toán đơn hàng ${_.map(vm.buyingEntries, 'buyingEntryId').join(',')} cho ${_.map(vm.buyingEntries, 'vendor.name').join(',')}`;
      vm.processBankAccount();
      vm.processDeadline();
    } else if (workTask) {
      vm.paymentRequest.workTask = workTask._id;
    }

    if (complaint) {
      vm.paymentRequest.business = _.get(vm.complaint, 'saleEntry.business', _.get(vm.complaint, 'outlet.business', null));

      const businessText = _.get(vm.paymentRequest, 'business.code');

      vm.paymentRequest.content = `${businessText} - Hoàn tiền KH liên quan cpl #${complaint.complaintId}`;
    }
  };

  $scope.$watch(() => _.get(vm.paymentRequest.buyingEntries, 'length'), () => {
    if (_.get(vm.paymentRequest.buyingEntries, 'length', 0)) {
      vm.paymentRequest.content = `Thanh toán đơn hàng ${_.map(vm.buyingEntries, 'buyingEntryId').join(',')} cho ${_.uniq(_.map(vm.buyingEntries, 'vendor.name')).join(',')}`;
    }
  });

  vm.processDeadline = () => {
    if (_.get(vm.paymentRequest, 'vendor', null)) {
      if (vm.paymentRequest.vendor.deadline) {
        if (_.get(vm.paymentRequest.vendor, 'payment', null) === 'credit') {
          const deadline = _.get(vm.paymentRequest.vendor, 'deadline', {});

          if (deadline.type === 'month') {
            vm.paymentRequest.deadline = moment().date(deadline.value).endOf('day').format('YYYY-MM-DD');
          } else if (deadline.type === 'day') {
            vm.paymentRequest.deadline = moment().add(deadline.value, 'day').endOf('day').format('YYYY-MM-DD');
          }
        } else {
          vm.paymentRequest.deadline = moment().endOf('day').format('YYYY-MM-DD');
        }
      }
    }
  };

  vm.processBankAccount = () => {
    if (_.get(vm.paymentRequest.vendor, 'bankAccount', null)) {
      vm.paymentRequest.bankAccount = vm.paymentRequest.vendor.bankAccount;
    } else {
      vm.paymentRequest.bankAccountInfo = null;
    }
  };

  vm.openModalFindBuyingEntries = function () {
    BuyingEntryService.openFindMultiBuyingEntriesModal().result.then(buyingEntries => {
      vm.paymentRequest.buyingEntries = vm.paymentRequest.buyingEntries || [];

      _.forEach(buyingEntries, buyingEntry => {
        vm.paymentRequest.buyingEntries.push(buyingEntry);
      });

      vm.paymentRequest.buyingEntries = _.uniqBy(vm.paymentRequest.buyingEntries, buyingEntry => {
        return buyingEntry.buyingEntryId;
      });
    });
  };

  vm.removeBuyingEntry = index => {
    vm.paymentRequest.buyingEntries.splice(index, 1);
  };

  $scope.$watch(() => {
    return _.get(vm.paymentRequest, 'vendor');
  }, () => {
    vm.processBankAccount();
    vm.processDeadline();
  });

  vm.findBuyingEntry = function (buyingEntryId) {
    if (!buyingEntryId) {
      return FhdMessenger.error('Chưa nhập mã Buying Entry để tìm');
    }

    BuyingEntryService.findByBuyingEntryId(buyingEntryId).then(buyingEntry => {
      if (buyingEntry.buyingEntryId) {
        vm.paymentRequest.buyingEntries = vm.paymentRequest.buyingEntries || [];
        vm.paymentRequest.buyingEntries.push(buyingEntry);
        vm.buyingEntryId = '';
      }
    });
  };

  vm.create = () => {
    const error = PaymentRequestsService.validatePaymentRequest(vm.paymentRequest);

    if (error) {
      return FhdMessenger.error(error);
    }

    const paymentRequest = new PaymentRequests(vm.paymentRequest);

    if (!_.get(paymentRequest, 'receiveAccount._id')) {
      paymentRequest.receiveAccount = undefined;
    }

    if (vm.workTask) {
      paymentRequest.workTask = vm.workTask._id;
    }

    if (vm.complaint) {
      paymentRequest.complaint = vm.complaint;
    }

    if (_.get(paymentRequest, 'buyingEntries.length')) {
      paymentRequest.reviewer = undefined;
    }

    vm.waiting = true;
    paymentRequest.$save().then(paymentRequest => {
      FhdMessenger.success('Tạo Payment Request thành công');
      vm.cancel();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
      $state.reload();
    });
  };
}]);
"use strict";

angular.module('payment-requests').controller('ModalViewPaymentRequestController', ['$modalInstance', 'paymentRequest', 'ObjectId', 'PaymentRequestsService', function ($modalInstance, paymentRequest, ObjectId, PaymentRequestsService) {
  const vm = this;
  vm.paymentRequest = paymentRequest;
  vm.complaint = ObjectId.getObjectId(vm.paymentRequest.complaint);
  vm.link = PaymentRequestsService.getQRLink(vm.paymentRequest);
  vm.image = {
    link: vm.link
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
"use strict";

angular.module('payment-requests').controller('PaymentRequestsController', ['$scope', 'Authentication', 'BuyingEntryService', 'ConfirmModal', 'FhdMessenger', 'NgTableParams', 'PaymentRequests', 'PaymentRequestsService', 'Vendors', 'SlugService', '$state', '$location', function ($scope, Authentication, BuyingEntryService, ConfirmModal, FhdMessenger, NgTableParams, PaymentRequests, PaymentRequestsService, Vendors, SlugService, $state, $location) {
  const vm = this;
  vm.paymentRequest = {};
  vm.data = vm.data || {};
  vm.user = Authentication.user;
  vm.statuses = PaymentRequestsService.getStatuses();
  vm.statusMap = {
    open: true,
    pending: true,
    void: false,
    closed: false
  };

  vm.getListAccountForPay = () => _.map(['Cá nhân', '4handy', 'Savor', 'Cần check lại số tiền CK'], account => {
    return {
      title: account,
      id: account
    };
  });

  vm.urgentStatus = () => [{
    title: 'Gấp',
    id: true
  }, {
    title: 'Không gấp',
    id: false
  }];

  vm.data.endDate = moment().format('YYYY-MM-DD');
  vm.data.type = 'all';
  vm.data.startDate = moment().subtract(1, 'month').format('YYYY-MM-DD');

  vm.init = () => {
    vm.data.vendors = Vendors.query();
  };

  vm.paymentRequestsTable = new NgTableParams({
    count: 1000,
    sorting: {
      deadline: 'asc',
      created: 'asc'
    }
  });
  vm.openModalViewPaymentRequest = PaymentRequestsService.openModalViewPaymentRequest;

  vm.openModalFindBuyingEntries = function () {
    BuyingEntryService.openFindMultiBuyingEntriesModal().result.then(buyingEntries => {
      vm.paymentRequest.buyingEntries = vm.paymentRequest.buyingEntries || [];

      _.forEach(buyingEntries, buyingEntry => {
        vm.paymentRequest.buyingEntries.push(buyingEntry);
      });

      vm.paymentRequest.buyingEntries = _.uniqBy(vm.paymentRequest.buyingEntries, buyingEntry => {
        return buyingEntry.buyingEntryId;
      });
    });
  };

  vm.openChangeDeadlineRequest = paymentRequest => {
    if (paymentRequest.deadlineRequest) {
      return FhdMessenger.error('Đã gửi yêu cầu chuyển deadline cho payment request này rồi');
    }

    PaymentRequestsService.openModalChangeDeadlineRequest(paymentRequest);
  };

  $scope.$watch(() => vm.paymentRequest.vendor, () => {
    if (_.get(vm.paymentRequest, 'vendor', null)) {
      if (vm.paymentRequest.vendor.deadline) {
        if (_.get(vm.paymentRequest.vendor, 'payment', null) === 'credit') {
          const deadline = _.get(vm.paymentRequest.vendor, 'deadline', {});

          if (deadline.type === 'month') {
            vm.paymentRequest.deadline = moment().date(deadline.value).endOf('day').format('YYYY-MM-DD');
          } else if (deadline.type === 'day') {
            vm.paymentRequest.deadline = moment().add(deadline.value, 'day').endOf('day').format('YYYY-MM-DD');
          }
        } else {
          vm.paymentRequest.deadline = moment().endOf('day').format('YYYY-MM-DD');
        }
      }
    }
  });

  vm.standardizeTransferContent = function () {
    vm.paymentRequest.transferContent = SlugService.getSlug(vm.paymentRequest.transferContent);
  };

  vm.close = function (paymentRequest) {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Hoàn thành Payment Request có nội dung ${paymentRequest.content}`,
      bodyText: `Bạn chắc chắn muốn hoàn thành Payment Request với số tiền ${paymentRequest.totalMoney}`
    }).then(() => {
      vm.waiting = false;
      paymentRequest.$close().then(paymentRequest => {
        FhdMessenger.success('Đã hoàn thành yêu cầu chuyển tiền');
      }).catch(error => {
        FhdMessenger.error(error);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.urgent = function (paymentRequest) {
    vm.waiting = false;
    paymentRequest.$urgent().then(paymentRequest => {
      FhdMessenger.success('Đã đổi trạng thái thanh toán ngay');
    }).catch(error => {
      FhdMessenger.error(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.notUrgent = function (paymentRequest) {
    vm.waiting = false;
    paymentRequest.$notUrgent().then(paymentRequest => {
      FhdMessenger.success('Đã đổi trạng thái thanh toán không cần ngay');
    }).catch(error => {
      FhdMessenger.error(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.cancel = function (paymentRequest) {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Xóa Payment Request có nội dung ${paymentRequest.content}`,
      bodyText: `Bạn chắc chắn muốn xóa Payment Request với số tiền ${paymentRequest.totalMoney}`
    }).then(() => {
      vm.waiting = false;
      paymentRequest.$cancel().then(paymentRequest => {
        FhdMessenger.success('Đã xóa yêu cầu chuyển tiền');
      }).catch(error => {
        FhdMessenger.error(error);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.disapprove = function (paymentRequest) {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Hủy Payment Request có nội dung ${paymentRequest.content}`,
      bodyText: `Bạn chắc chắn muốn hủy Payment Request với số tiền ${paymentRequest.totalMoney}`
    }).then(() => {
      vm.waiting = false;
      paymentRequest.$disapprove().then(paymentRequest => {
        FhdMessenger.success('Đã hủy yêu cầu chuyển tiền');
      }).catch(error => {
        FhdMessenger.error(error);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.approve = function (paymentRequest) {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Duyệt Payment Request có nội dung ${paymentRequest.content}`,
      bodyText: `Bạn chắc chắn muốn duyệt Payment Request với số tiền ${paymentRequest.totalMoney}`
    }).then(() => {
      vm.waiting = false;
      paymentRequest.$approve().then(paymentRequest => {
        FhdMessenger.success('Đã duyệt yêu cầu chuyển tiền');
      }).catch(error => {
        FhdMessenger.error(error);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.selectAllStatus = function () {
    let changeValue = true;
    if (_.every(vm.statusMap)) changeValue = false;

    _.forEach(vm.statusMap, (value, key) => {
      vm.statusMap[key] = changeValue;
    });
  };

  vm.findBuyingEntry = function (buyingEntryId) {
    if (!buyingEntryId) {
      return FhdMessenger.error('Chưa nhập mã Buying Entry để tìm');
    }

    BuyingEntryService.findByBuyingEntryId(buyingEntryId).then(buyingEntry => {
      if (buyingEntry.buyingEntryId) {
        vm.paymentRequest.buyingEntries = vm.paymentRequest.buyingEntries || [];
        vm.paymentRequest.buyingEntries.push(buyingEntry);
        vm.buyingEntryId = '';
      }
    });
  };

  vm.removeBuyingEntry = index => {
    vm.paymentRequest.buyingEntries.splice(index, 1);
  };

  vm.create = () => {
    const error = PaymentRequestsService.validatePaymentRequest(vm.paymentRequest);

    if (error) {
      return FhdMessenger.error(error);
    }

    const paymentRequest = new PaymentRequests(vm.paymentRequest);

    if (!_.get(paymentRequest, 'receiveAccount._id')) {
      paymentRequest.receiveAccount = undefined;
    }

    if (_.get(paymentRequest, 'buyingEntries.length')) {
      paymentRequest.reviewer = undefined;
    }

    vm.waiting = true;
    paymentRequest.$save().then(paymentRequest => {
      $state.go('listPaymentRequests');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.queryStringToTableFilter = () => {
    // get reviewerDisplayName from search query
    const reviewerDisplayName = $location.search().reviewerDisplayName;

    if (reviewerDisplayName) {
      vm.paymentRequestsTable.filter()['reviewer.displayName'] = reviewerDisplayName;
    }
  };

  vm.find = () => {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    vm.waiting = true;
    PaymentRequests.query({
      statuses,
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      type: vm.data.type
    }).$promise.then(paymentRequests => {
      vm.paymentRequests = paymentRequests;
      FhdMessenger.success('Tải xong.');
      vm.paymentRequests = _.map(vm.paymentRequests, paymentRequest => {
        paymentRequest.estimatedBeTotal = _.reduce(paymentRequest.buyingEntries, (result, buyingEntry) => {
          result += buyingEntry.totalBuyingValue || 0;
          return result;
        }, 0);
        paymentRequest.accountForPay = vm.getAccountForPay(paymentRequest);
        return paymentRequest;
      });

      const countPRByVendor = _.countBy(vm.paymentRequests, 'vendor.code');

      vm.paymentRequests = _.map(vm.paymentRequests, paymentRequest => {
        if (_.get(paymentRequest.vendor, 'code', null)) {
          paymentRequest.totalRequest = countPRByVendor[paymentRequest.vendor.code];
        }

        return paymentRequest;
      });
      vm.paymentRequestsTable.settings({
        dataset: vm.paymentRequests
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.getAccountForPay = paymentRequest => {
    if (!_.get(paymentRequest, 'vendor')) {
      return 'Cá nhân';
    }

    if (paymentRequest.vendor.billType === 'Cần check lại') {
      return 'Cần check lại số tiền CK';
    }

    if (paymentRequest.vendor.payment === 'credit' || paymentRequest.totalMoney >= 20000000) {
      if (paymentRequest.vendor.billType === 'Về 4handy') {
        return '4handy';
      }

      if (paymentRequest.vendor.billType === 'Về Savor') {
        return 'Savor';
      }
    }

    return 'Cá nhân';
  };

  $scope.$watch(() => vm.paymentRequestsTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.totalPaymentRequest = _.reduce(newValue, (result, paymentRequest) => {
      return result + paymentRequest.totalMoney;
    }, 0);
  });
  $scope.$watch(() => vm.paymentRequest.vendor, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;

    if (_.get(newValue, 'bankAccount.accountNumber')) {
      vm.paymentRequest.bankAccount = newValue.bankAccount;
    }
  });
  $scope.$watch(() => vm.paymentRequestsTable.filter()['reviewer.displayName'], (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;
    $location.search('reviewerDisplayName', newValue);
  });
}]);
"use strict";

angular.module('payment-requests').controller('ViewPaymentRequestController', ['$stateParams', 'ObjectId', 'PaymentRequests', 'PaymentRequestsService', function ($stateParams, ObjectId, PaymentRequests, PaymentRequestsService) {
  const vm = this;

  vm.findOne = () => {
    PaymentRequests.get({
      paymentRequestId: $stateParams.paymentRequestId
    }).$promise.then(paymentRequest => {
      vm.paymentRequest = paymentRequest;
      vm.complaint = ObjectId.getObjectId(vm.paymentRequest.complaint);
      vm.link = PaymentRequestsService.getQRLink(vm.paymentRequest);
      vm.image = {
        link: vm.link
      };
    });
  };
}]);
"use strict";

angular.module('payment-requests').directive('fhdPaymentRequestStatus', [function () {
  return {
    restrict: 'E',
    scope: {
      paymentRequest: '='
    },
    controllerAs: 'vm',
    replace: true,
    template: `  <span
      ng-click="vm.openModalViewPaymentRequest(paymentRequest)"
      class="label"
      ng-class="{
                          'label-primary' : paymentRequest.status === 'open',
                          'label-danger' : paymentRequest.status === 'void',
                          'label-info' : paymentRequest.status === 'pending',
                          'label-warning' : paymentRequest.status === 'disapproved',
                          'label-success' : paymentRequest.status === 'closed'}"
    >
      {{ paymentRequest.status | paymentRequestStatus }}
    </span>`,
    controller: 'FhdPaymentRequestStatusController'
  };
}]).controller('FhdPaymentRequestStatusController', ['PaymentRequestsService', function (PaymentRequestsService) {
  const vm = this;
  vm.openModalViewPaymentRequest = PaymentRequestsService.openModalViewPaymentRequest;
}]);
'use strict';

angular.module('payment-requests').filter('paymentRequestStatus', ['PaymentRequestsService', function (PaymentRequestsService) {
  return function (status) {
    const statuses = PaymentRequestsService.getStatuses();

    const matchStatus = _.find(statuses, {
      id: status
    });

    return _.get(matchStatus, 'name', status);
  };
}]);
"use strict";

angular.module('payment-requests').factory('PaymentRequests', ['$resource', function ($resource) {
  return $resource('payment-requests/:paymentRequestId', {
    paymentRequestId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    delete: {
      method: 'DELETE'
    },
    close: {
      method: 'PUT',
      url: 'payment-requests/:paymentRequestId/close'
    },
    urgent: {
      method: 'PUT',
      url: 'payment-requests/:paymentRequestId/urgent'
    },
    notUrgent: {
      method: 'PUT',
      url: 'payment-requests/:paymentRequestId/not-urgent'
    },
    cancel: {
      method: 'PUT',
      url: 'payment-requests/:paymentRequestId/cancel'
    },
    approve: {
      method: 'PUT',
      url: 'payment-requests/:paymentRequestId/approve'
    },
    disapprove: {
      method: 'PUT',
      url: 'payment-requests/:paymentRequestId/disapprove'
    }
  });
}]);
"use strict";

angular.module('payment-requests').factory('PaymentRequestsService', ['$modal', 'FhdMessenger', function ($modal, FhdMessenger) {
  const statuses = [{
    id: 'open',
    label: 'primary',
    name: 'Chờ chuyển khoản'
  }, {
    id: 'closed',
    label: 'success',
    name: 'Đã chuyển'
  }, {
    id: 'pending',
    label: 'info',
    name: 'Chờ xác nhận'
  }, {
    id: 'disapproved',
    label: 'warning',
    name: 'Đã hủy'
  }, {
    id: 'void',
    label: 'danger',
    name: 'Đã xóa'
  }];
  return {
    validatePaymentRequest(paymentRequest) {
      if (!paymentRequest.content) {
        return 'Chưa có lý do chuyển tiền';
      }

      if (!paymentRequest.transferContent) {
        return 'Chưa có nội dung chuyển khoản';
      }

      if (!paymentRequest.totalMoney) {
        return 'Chưa có số tiền cần chuyển';
      }

      if (!paymentRequest.deadline) {
        return 'Chưa có hạn chuyển tiền';
      }

      if (!_.get(paymentRequest, 'buyingEntries.length') && !_.get(paymentRequest, 'reviewer._id')) {
        return 'Payment Request không có Buying Entry cần có người duyệt';
      }

      if (moment(paymentRequest.deadline).diff(moment(), 'day') < 0) {
        return 'Không được chuyển tiền vào các ngày trong quá khứ';
      }

      let isSunday = moment(paymentRequest.deadline).weekday() === 6;

      if (isSunday) {
        return 'Không được chuyển tiền vào chủ nhật';
      }

      let isToday = moment(paymentRequest.deadline).isSame(moment(), 'day');

      if (isToday && moment().isAfter(moment().hour(15).startOf('hour'))) {
        return 'Không được chuyển tiền sau 15h cùng ngày';
      }

      if (paymentRequest.vendor && _.get(paymentRequest, 'receiveAccount._id')) {
        return 'Chỉ được chọn hoặc vendor hoặc tài khoản nhân viên';
      }

      return '';
    },

    openModalViewPaymentRequest(paymentRequest) {
      return $modal.open({
        templateUrl: '/modules/payment-requests/views/modal-view-payment-request.client.view.html',
        controller: 'ModalViewPaymentRequestController',
        controllerAs: 'vm',
        resolve: {
          paymentRequest: () => paymentRequest
        }
      });
    },

    openModalCreatePaymentRequest({
      buyingEntries,
      workTask,
      complaint
    }) {
      return $modal.open({
        templateUrl: '/modules/payment-requests/views/modal-create-payment-request.client.view.html',
        controller: 'ModalCreatePaymentRequestController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          buyingEntries: () => buyingEntries,
          workTask: () => workTask,
          complaint: () => complaint
        }
      });
    },

    getStatuses() {
      return statuses;
    },

    getQRLink(paymentRequest) {
      const bankAccount = paymentRequest.bankAccount || {};
      let link = `https://img.vietqr.io/image/${bankAccount.bankName}-${bankAccount.accountNumber}-compact2.png?amount=${paymentRequest.totalMoney}&addInfo=${paymentRequest.transferContent}`;

      if (_.get(bankAccount, 'holderName')) {
        link += `&accountName=${bankAccount.holderName}`;
      }

      return link;
    },

    openModalChangeDeadlineRequest(paymentRequest) {
      return $modal.open({
        template: `
          <div class="modal-header">
          <h3 class="modal-title">
            Yêu cầu đổi hạn chuyển khoản khoản chi {{ vm.paymentRequest.paymentRequestId }} |
            <span
              class="label"
              ng-class="{
                    'label-primary': vm.paymentRequest.status === 'closed',
                    'label-warning': vm.paymentRequest.status === 'open',
                    'label-default': vm.paymentRequest.status === 'void',}"
            >
              {{ vm.paymentRequest.status }}
            </span>
          </h3>
        </div>
        <div class="modal-body">
          <table class="table table-bordered table-hover">
            <colgroup>
              <col width="30%" />
              <col width="70%" />
            </colgroup>
            <thead>
              <th>Attribute</th>
              <th>Value</th>
            </thead>
            <tbody>
              <tr>
                <td>
                  <label>
                    <strong>Người tạo</strong>
                  </label>
                </td>
                <td>
                  <div>{{ vm.paymentRequest.user.code }} - {{ vm.paymentRequest.user.displayName }}</div>
                </td>
              </tr>
              <tr>
                <td>
                  <label>
                    <strong>Tài khoản ngân hàng</strong>
                  </label>
                </td>
                <td>
                  <div>{{ vm.paymentRequest.bankAccountInfo }}</div>
                </td>
              </tr>
              <tr>
                <td>
                  <label>
                    <strong>Tài khoản nhận chi</strong>
                  </label>
                </td>
                <td>
                  <div>
                    {{ vm.paymentRequest.receiveAccount.code }} - {{ vm.paymentRequest.receiveAccount.name
                    }}
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <label>
                    <strong>Vendor</strong>
                  </label>
                </td>
                <td>
                  <div>{{ vm.paymentRequest.vendor.code }} - {{ vm.paymentRequest.vendor.name }}</div>
                </td>
              </tr>
              <tr>
                <td>
                  <label>
                    <strong>Thời gian tạo</strong>
                  </label>
                </td>
                <td>
                  <div>
                    {{ vm.paymentRequest.created | momentDate: 'L LT' }}
                  </div>
                </td>
              </tr>
              <tr>
              <td>
                <label>
                  <strong>Hạn chuyển khoản</strong>
                </label>
              </td>
              <td>
                <div>
                  {{ vm.paymentRequest.deadline | momentDate: 'L LT' }}
                </div>
              </td>
            </tr>
            </tbody>
          </table>
          <form class="form-horizontal">
          <fhd-date-input
          date="vm.date"
          label="Đổi hạn chuyển khoản"
          format="YYYY-MM-DD"
          no-default="true"
          label-column="3"
        ></fhd-date-input>
        <div class="text-right">
        <button class="btn btn-success" ng-click="vm.submit()" ng-disabled="vm.waiting">Gửi yêu cầu</button>
        <button class="btn btn-primary" ng-click="vm.cancel()">Hủy</button>
        </div>
          </form>
        </div>
        </div>
    `,
        controllerAs: 'vm',
        controller: ['$modalInstance', 'FhdMessenger', '$http', function ($modalInstance, FhdMessenger, $http) {
          const vm = this;
          vm.waiting = false;
          vm.paymentRequest = paymentRequest;

          vm.submit = () => {
            if (!vm.date) {
              return FhdMessenger.error('Chưa nhập hạn chuyển khoản mới');
            }

            if (moment(vm.paymentRequest.created).diff(moment(vm.date), 'day') > 0) {
              return FhdMessenger.error('Không thể đổi ngày trong quá khứ');
            }

            if (moment(vm.paymentRequest.deadline).isSame(moment(vm.date), 'day')) {
              return FhdMessenger.error('Deadline cũ trùng với deadline mới');
            }

            vm.waiting = true;
            $http.put(`/payment-requests/${vm.paymentRequest._id}/change-deadline`, {
              newDeadline: vm.date
            }).then(response => {
              FhdMessenger.success('Yêu cầu thành công');
              vm.cancel();
            }).catch(err => {
              FhdMessenger.errorFromServer(err);
            }).finally(() => {
              vm.waiting = false;
            });
          };

          vm.cancel = () => {
            $modalInstance.close(false);
          };
        }]
      });
    }

  };
}]);
"use strict";

angular.module('photo-reports').config(['$stateProvider', $stateProvider => {
  $stateProvider.state('listPhotoReports', {
