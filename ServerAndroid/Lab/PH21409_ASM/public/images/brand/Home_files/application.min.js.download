angular.module('hr-tasks').controller('HRDashboardController', ['HRTaskService', 'NgTableParams', function (HRTaskService, NgTableParams) {
  const vm = this;
  vm.startDate = moment().subtract(1, 'month').startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().endOf('month').format('YYYY-MM-DD');
  vm.dashboardTable = new NgTableParams({}, {
    count: 100
  });

  vm.summaryNew = () => {
    vm.waiting = true;
    const startDate = vm.startDate;
    const endDate = vm.endDate;
    vm.hrTasks = HRTaskService.summaryNew(startDate, endDate).then(hrTasks => {
      // console.log(hrTasks)
      vm.dashboardTable.settings({
        dataset: hrTasks
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.init = () => {
    vm.dashboardTable.settings({
      dataset: [{
        code: 'S14',
        position: 'Nhân viên Parttime',
        quantity: 3,
        employeeRatio: 0.1,
        numNeededApplicationForms: 30,
        numDaysLeft: 10,
        numApplicationFormsPerDay: 3,
        numNeededProbationForms: 9,
        numNeededTrainingForms: 5,
        note: 'Chuyên ca sáng; Làm linh động các ca.'
      }]
    });
  };
}]);
"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('hr-tasks').controller('HRTaskController', ['$location', '$state', '$stateParams', 'BusinessService', 'HRTasks', 'HRTaskService', 'OutletService', 'Authentication', 'ConfirmModal', 'ObjectId', 'NgTableParams', 'FhdMessenger', '$scope', '$http', '$q', function ($location, $state, $stateParams, BusinessService, HRTasks, HRTaskService, OutletService, Authentication, ConfirmModal, ObjectId, NgTableParams, FhdMessenger, $scope, $http, $q) {
  const vm = this;
  vm.selectedPosition = null;
  vm.user = Authentication.user;
  vm.statuses = ['created', 'recruiting', 'done', 'pause', 'void'];
  vm.statusMap = _.reduce(vm.statuses, (result, status) => {
    result[status] = ['recruiting'].includes(status);
    return result;
  }, {});

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.outlets = _.map(selectedOutlets, '_id');
  };

  vm.hrTaskTable = new NgTableParams({
    count: 50
  });
  vm.hrTaskSelectTable = new NgTableParams({
    count: 50
  });
  const seeAllRoles = ['admin', 'tro-ly-ns', 'marketing', 'tro-ly-dt'];

  vm.canChangeStatus = user => _.intersection(user.roles, ['admin', 'tro-ly-ns', 'hr-task:edit']).length;

  vm.isDeleted = hrTask => hrTask.status === 'void';

  vm.init = function () {
    vm.data = {};
    vm.data.shifts = [{
      shift: 'S',
      quantity: 0
    }, {
      shift: 'C',
      quantity: 0
    }, {
      shift: 'T',
      quantity: 0
    }];
    vm.businessPromise = BusinessService.allAsync().then(businesses => {
      vm.data.businesses = _.filter(businesses, {
        deleted: false
      });
      vm.showBusinessMap = _.reduce(vm.data.businesses, (result, business, value) => {
        result[business._id] = {
          value: true,
          business
        };
        return result;
      }, {});
    }); // load outlet

    vm.outletPromise = OutletService.allAsync().then(result => {
      vm.data.outlets = result;
      vm.data.outlets = _.filter(vm.data.outlets, outlet => {
        if (outlet.code === 'KHONTD' || !outlet.hasStaff) {
          return false;
        }

        return true;
      });

      const managingOutletIds = _.map(vm.user.managingOutlets || [], outlet => {
        return ObjectId.getObjectId(outlet);
      });

      vm.showOutletMap = _.reduce(vm.data.outlets, (result, outlet) => {
        if (_.intersection(vm.user.roles, seeAllRoles).length > 0 || ObjectId.equals(outlet, vm.user.outlet) || _.some(managingOutletIds, outletId => {
          return ObjectId.equals(outletId, outlet);
        })) {
          result[outlet._id] = {
            outlet,
            value: true,
            enable: true
          };
        }

        return result;
      }, {});
    });
    vm.hrTask = {};
  };

  vm.updateSeverityPoint = (hrTask, point) => {
    hrTask.severityPoint = point;
    hrTask.$updateSeverityPoint().then(() => {
      FhdMessenger.success('Thành công');
    }).catch(error => {
      FhdMessenger.error(error);
    });
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'outlet':
        {
          let changeValue = true;
          if (_.every(_.map(vm.showOutletMap, 'value'))) changeValue = false;

          _.forEach(vm.showOutletMap, (outlet, key) => {
            vm.showOutletMap[key].value = changeValue;
          });

          break;
        }

      case 'status':
        {
          let changeValue = true;

          if (_.every(_.map(vm.statusMap))) {
            changeValue = false;
          }

          _.forEach(vm.statusMap, (status, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }
    }
  };

  vm.onCopied = () => {
    FhdMessenger.success('Đã copy!');
  };

  $scope.$watch(() => vm.outlet, (newValue, oldValue) => {
    if (!newValue || newValue === oldValue) return;

    if (!_.get(newValue, '_id')) {
      return;
    }

    const outletId = ObjectId.getObjectId(newValue);
    vm.hrTask.outlets = vm.hrTask.outlets || [];

    const mapOutletId = _.map(vm.hrTask.outlets, '_id');

    if (!mapOutletId.includes(outletId)) {
      vm.hrTask.outlets.push(newValue);
    }
  });

  vm.count = () => {
    $http({
      method: 'GET',
      url: 'application-forms/count-forms-by-positions',
      params: {
        startDate: vm.startDate,
        endDate: vm.endDate,
        positionInOutlet: _.get(vm.selectedPosition, 'name', null)
      }
    }).then(response => {
      const countAllByStatus = _.reduce(response.data, (result, outlet) => {
        const countMap = _.countBy(outlet.status);

        result[outlet._id] = countMap;
        return result;
      }, {});

      const combinedData = _.map(vm.hrTaskTable.data, data => {
        const countByStatus = countAllByStatus[data.outlet._id];
        return _objectSpread({}, data, {
          countByStatus
        });
      });

      vm.hrTaskSelectTable.settings({
        dataset: combinedData
      });
    });
  };

  function getTotalLine(hrTasks) {
    if (!hrTasks) return {};

    const quantity = _.sumBy(hrTasks, 'quantity');

    const employee = _.sumBy(hrTasks, 'statusMap.employee');

    const totalRemainingTarget = _.sumBy(hrTasks, 'remainingTarget');

    const numStatusForm = _.sumBy(hrTasks, 'statusMap.form');

    const training = _.sumBy(hrTasks, 'statusMap.training');

    const yesterdayApplicationForm = _.sumBy(hrTasks, 'yesterdayApplicationForm');

    const targetApplicationForm = _.sumBy(hrTasks, 'targetApplicationForm');

    const yesterdaySpend = _.sumBy(hrTasks, 'yesterdaySpend');

    const todaySpend = _.sumBy(hrTasks, 'todaySpend');

    const avgJobPosts = _.sumBy(hrTasks, 'jobPosts.length') / hrTasks.length;
    return {
      quantity,
      employee,
      totalRemainingTarget,
      numStatusForm,
      training,
      yesterdayApplicationForm,
      targetApplicationForm,
      yesterdaySpend,
      todaySpend,
      avgJobPosts
    };
  }

  function updateTotalLine() {
    _.assign(vm.totalLine, getTotalLine(vm.hrTaskTable.data));
  }

  vm.totalLine = {};
  $scope.$watch(() => vm.hrTaskTable.data, () => {
    updateTotalLine();
  }, true);

  vm.find = () => {
    vm.waiting = true;
    const choosensStatuses = Object.entries(vm.statusMap).filter(d => d[1]).map(d => d[0]);
    const hrTasksPromise = HRTasks.list({
      outlets: vm.outlets,
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      statuses: choosensStatuses
    }).$promise;
    hrTasksPromise.then(hrTasks => {
      vm.hrTasks = hrTasks;
      vm.hrTaskTable.settings({
        dataset: vm.hrTasks
      });
      $q.all([vm.getApplicationFormSummary(_.map(hrTasks, '_id')), vm.getAverageApplicationForm(_.map(hrTasks, '_id')), vm.getHrTaskJobPostMap(_.map(hrTasks, '_id')), vm.getAdCampaignReportMap(_.map(hrTasks, '_id'), moment().subtract(1, 'day').startOf('day').format(), moment().subtract(1, 'day').endOf('day').format()), vm.getAdCampaignReportMap(_.map(hrTasks, '_id'), moment().startOf('day').format(), moment().endOf('day').format())]).then(([summaryHrTaskMap, avgAppFormMap, jobPostMap, yesterdayAdCamapaignReportMap, todayAdCampaignReportMap]) => {
        _.forEach(vm.hrTasks, hrTask => {
          hrTask.statusMap = summaryHrTaskMap[hrTask._id] || {};
          const statuses = ['created', 'confirmed', 'interviewed', 'probationary'];
          hrTask.statusMap['form'] = _.reduce(hrTask.statusMap, (result, value, status) => {
            result += statuses.includes(status) ? value : 0;
            return result;
          }, 0);
          hrTask.jobPosts = jobPostMap[hrTask._id] || [];
          hrTask.total = _.sum(_.values(hrTask.statusMap));
          hrTask.jobPostText = _.map(hrTask.jobPost, 'title').join(' | ');
          hrTask.explainFormText = statuses.map(d => `${d}: ${hrTask.statusMap[d]}`).join(' | ');
          hrTask.yesterdayApplicationForm = avgAppFormMap[hrTask._id] || 0;
          hrTask.yesterdaySpend = yesterdayAdCamapaignReportMap[hrTask._id] || 0;
          hrTask.todaySpend = todayAdCampaignReportMap[hrTask._id] || 0;
          hrTask.totalTarget = Math.round((hrTask.quantity - hrTask.statusMap.employee - hrTask.statusMap.training / hrTask.trainingToEmployeeRatio) * hrTask.createdToEmployeeRatio - hrTask.statusMap.form);
          hrTask.targetApplicationFormPerDay = hrTask.totalTarget / moment(hrTask.stopApplicationFormDate).diff(moment(), 'day');
          hrTask.targetPercent = (hrTask.statusMap.employee * hrTask.createdToEmployeeRatio + hrTask.statusMap.form + hrTask.statusMap.training / hrTask.trainingToEmployeeRatio * hrTask.createdToEmployeeRatio) / (hrTask.quantity * hrTask.createdToEmployeeRatio);
          hrTask.remainingTarget = hrTask.quantity - hrTask.statusMap.employee;
          hrTask.isLate = moment(hrTask.stopApplicationFormDate).isBefore(moment());
          vm.hrTaskTable.settings({
            dataset: vm.hrTasks
          });
        });
      });
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.getApplicationFormSummary = hrTaskIds => {
    if (!hrTaskIds.length) {
      return FhdMessenger.error('Chưa chọn HR Task Id');
    }

    return $http.post('/hr-tasks/applicaton-form-summary', {
      hrTaskIds: hrTaskIds
    }).then(response => {
      return response.data;
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.getAverageApplicationForm = hrTaskIds => {
    if (!hrTaskIds.length) {
      return FhdMessenger.error('Chưa chọn HR Task Id');
    }

    return $http.post('/hr-tasks/average-applicaton-form', {
      hrTaskIds: hrTaskIds
    }).then(response => {
      return response.data;
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.getHrTaskJobPostMap = hrTaskIds => {
    if (!hrTaskIds.length) {
      return FhdMessenger.error('Chưa chọn HR Task Id');
    }

    return $http.post('/hr-tasks/job-post-map', {
      hrTaskIds
    }).then(response => response.data).catch(FhdMessenger.errorFromServer);
  };

  vm.getAdCampaignReportMap = (hrTaskIds, startDate, endDate) => {
    if (!hrTaskIds.length) {
      return FhdMessenger.error('Chưa chọn HR Task Id');
    }

    return $http.post('/hr-tasks/ad-campaign-report-map', {
      hrTaskIds,
      startDate,
      endDate
    }).then(response => response.data).catch(FhdMessenger.errorFromServer);
  };

  vm.openJobPostsModal = HRTaskService.openJobPostsModal;

  vm.openHrTaskApplicationFormsModal = employeeApplicationForms => {
    return HRTaskService.openHrTaskApplicationFormsModal(employeeApplicationForms);
  };

  vm.summary = () => {
    vm.waiting = true;
    vm.hrTasks = HRTasks.summary({}).$promise.then(hrTasks => {
      vm.hrTaskTable.settings({
        dataset: hrTasks
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = () => {
    vm.hrTask = HRTasks.get({
      hrTaskId: $stateParams.hrTaskId
    });
    vm.hrTask.$promise.then(hrTask => {
      $http.get(`/hr-tasks/${hrTask._id}/job-posts`).then(response => response.data).then(jobPosts => {
        vm.hrTask.jobPosts = jobPosts;
        vm.canEditHrTask = vm.user.roles.includes('hr-task:edit');
      });
    });
  };

  vm.update = _hrTask => {
    const hrTask = _hrTask || vm.hrTask;

    if (!hrTask.position) {
      return FhdMessenger.error('Bạn chưa chọn vị trí cần tuyển');
    }

    if (!_.get(hrTask, 'outlet.code')) {
      return FhdMessenger.error('Bạn chưa chọn cơ sở cần tuyển');
    }

    if (!_.some(hrTask.shifts, shift => {
      return shift.quantity > 0;
    })) {
      return FhdMessenger.error('Bạn chưa nhập số lượng nhân viên cần tuyển');
    }

    vm.waiting = true;
    hrTask.$update().then(() => {
      FhdMessenger.success(`Cập nhật ${hrTask.position} - ${hrTask.outlet.code} thành công.`);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.summaryNew = () => {
    vm.waiting = true;
    const startDate = vm.startDate;
    const endDate = vm.endDate;
    vm.hrTasks = HRTaskService.summaryNew(startDate, endDate).$promise.then(hrTasks => {
      vm.hrTaskTable.settings({
        dataset: hrTasks
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.addNewNote = hrTask => {
    vm.waiting = true;
    hrTask.$addNewNote({
      note: vm.newNote.replace('\n', ', ')
    }).then(() => {
      vm.newNote = '';
      FhdMessenger.success('Đã thêm ghi chú');
    }).catch(err => {
      return FhdMessenger.error(err.mesage);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.addJobPost = hrTask => {
    vm.waiting = true;
    hrTask.$addJobPost({
      title: vm.jobPostTitle,
      content: vm.jobPostContent
    }).then(() => {
      vm.newNote = '';
      FhdMessenger.success('Đã thêm ghi chú');
    }).catch(err => {
      return FhdMessenger.error(err.mesage);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.changeStatus = HRTaskService.openChangeStatusModal;

  vm.changeWorkPosition = workPosition => {
    if (!workPosition) {
      vm.hrTask.position = '';
    }

    vm.hrTask.position = workPosition.name;
    vm.hrTask.recruitmentInfo = _.assign(vm.hrTask.recruitmentInfo, _.get(workPosition, 'recruitmentInfo', {}));
  };

  vm.changeOutlet = outlet => {
    vm.hrTask.recruitmentInfo = vm.hrTask.recruitmentInfo || {};
    vm.hrTask.recruitmentInfo['address'] = outlet.address;
  };

  vm.create = function () {
    if (!vm.hrTask.position) {
      return FhdMessenger.error('Bạn chưa chọn vị trí cần tuyển');
    }

    if (!_.get(vm.hrTask, 'outlet.code')) {
      return FhdMessenger.error('Bạn chưa chọn cơ sở cần tuyển');
    }

    if (!_.some(vm.data.shifts, shift => {
      return shift.quantity > 0;
    })) {
      return FhdMessenger.error('Bạn chưa nhập số lượng nhân viên cần tuyển');
    }

    if (!vm.hrTask.endDate || !vm.hrTask.startDate) {
      return FhdMessenger.error('Bạn phải nhập Start Date và End Date');
    }

    if (!vm.hrTask.trainingToEmployeeRatio) {
      return FhdMessenger.error('Bạn phải nhập tỷ lệ thử việc/chính thức');
    }

    if (!vm.hrTask.createdToEmployeeRatio) {
      return FhdMessenger.error('Bạn phải nhập tỷ lệ hồ sơ/chính thức');
    }

    if (!vm.hrTask.stopApplicationFormDate) {
      return FhdMessenger.error('Bạn phải nhập ngày dừng nhận hồ sơ');
    }

    if (moment(vm.hrTask.startDate).add(1, 'months').isAfter(vm.hrTask.endDate)) {
      return FhdMessenger.error('Thời gian tuyển dụng phải tối thiểu 1 tháng ');
    }

    vm.hrTask.shifts = vm.data.shifts;
    var hrTask = new HRTasks(vm.hrTask);
    vm.waiting = true;
    hrTask.$save().then(response => {
      vm.hrTask = {};
      FhdMessenger.success('Tạo HR Task thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.openModalInvolveApplicationForms = (hrTask, status) => {
    let statuses = [status];

    if (status === 'waiting') {
      statuses = ['created', 'confirmed', 'interviewed', 'probationary'];
    }

    HRTaskService.openModalInvolveApplicetionForm(hrTask, statuses);
  };

  vm.openModalRecruitmentInfo = HRTaskService.openModalRecruitmentInfo;

  vm.bindNewLine = content => {
    if (!_.isString(content)) {
      return '';
    }

    return content.replace(/\n/g, '<br>');
  };
}]);
"use strict";

angular.module('hr-tasks').controller('HRTrackingController', ['HRTasks', 'NgTableParams', function (HRTasks, NgTableParams) {
  const vm = this;
  vm.waiting = false;
  vm.startDate = moment().subtract(2, 'week').startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().format('YYYY-MM-DD');
  vm.hrTrackTable = new NgTableParams({}, {
    count: 100
  });

  vm.find = () => {
    vm.waiting = true;
    vm.hrTracks = HRTasks.track({
      startDate: vm.startDate,
      endDate: vm.endDate
    }).$promise.then(hrTracks => {
      console.log(hrTracks);
      vm.hrTrackTable.settings({
        dataset: hrTracks
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

angular.module('hr-tasks').controller('ModalChangeStatusController', ['$modalInstance', 'FhdMessenger', 'Authentication', '$q', 'newStatus', 'hrTask', function ($modalInstance, FhdMessenger, Authentication, $q, newStatus, hrTask) {
  const vm = this;
  vm.user = Authentication.user;
  vm.newStatus = newStatus;
  vm.note = {};
  vm.waiting = false;
  vm.historyStatus = hrTask.historyStatus || [];
  vm.tableStatus = {
    done: {
      headerText: `Hoàn thành Hr Task của vị trí ${hrTask.position}`,
      bodyText: `Bạn chắc chắn muốn hoàn thành Hr Task của vị trí ${hrTask.position} - tổng số lượng ${hrTask.quantity}?`,
      content: 'Chuyển trạng thái sang hoàn thành'
    },
    recruiting: {
      headerText: `Chuyển trạng thái đang tuyển Hr Task của vị trí ${hrTask.position}`,
      bodyText: `Bạn chắc chắn muốn chuyển trạng thái đang tuyển Hr Task của vị trí ${hrTask.position} - tổng số lượng ${hrTask.quantity}?`,
      content: 'Chuyển trạng thái sang đang tuyển'
    },
    void: {
      headerText: `Xóa Hr Task của vị trí ${hrTask.position}`,
      bodyText: `Bạn chắc chắn muốn xóa Hr Task của vị trí ${hrTask.position} - tổng số lượng ${hrTask.quantity}?`,
      content: 'Chuyển trạng thái sang đã xóa'
    },
    pause: {
      headerText: `Tạm dừng tuyển Hr Task của vị trí ${hrTask.position}`,
      bodyText: `Bạn chắc chắn muốn tạm dừng tuyển Hr Task của vị trí ${hrTask.position} - tổng số lượng ${hrTask.quantity}?`,
      content: `Chuyển trạng thái sang tạm dừng tuyển`
    }
  };

  vm.dismiss = function () {
    return $modalInstance.dismiss();
  };

  vm.confirm = function () {
    if (!vm.content) {
      return FhdMessenger.error('Chưa nhập ghi chú');
    }

    vm.note = {
      user: Authentication.user,
      time: new Date(),
      content: `${vm.tableStatus[newStatus].content}\n${vm.content}`
    };
    vm.historyStatus.push(vm.note);
    vm.waiting = true;

    switch (newStatus) {
      case 'pause':
        {
          hrTask.$pause().then(() => {
            FhdMessenger.success('Chuyển trạng thái tạm dừng tuyển tuyển thành công!');
            vm.dismiss();
          }).catch(FhdMessenger.errorFromServer).finally(() => {
            vm.waiting = false;
          });
          break;
        }

      case 'recruiting':
        {
          hrTask.$recruiting().then(() => {
            FhdMessenger.success('Chuyển trạng thái đang tuyển thành công!');
            vm.dismiss();
          }).catch(FhdMessenger.errorFromServer).finally(() => {
            vm.waiting = false;
          });
          break;
        }

      case 'done':
        {
          hrTask.$done().then(() => {
            FhdMessenger.success('Đã hoàn thành!');
            vm.dismiss();
          }).catch(FhdMessenger.errorFromServer).finally(() => {
            vm.waiting = false;
          });
          break;
        }

      case 'void':
        {
          if (!_.intersection(vm.user.roles, ['admin', 'hr-task:delete']).length) {
            return FhdMessenger.error('Bạn không có quyền sử dụng chức năng này!');
          }

          hrTask.$remove().then(() => {
            FhdMessenger.success('Xóa thành công!');
            vm.dismiss();
          }).catch(FhdMessenger.errorFromServer).finally(() => {
            vm.waiting = false;
          });
        }
    }
  };
}]);
"use strict";

angular.module('hr-tasks').controller('ModalInvolveApplicationFormsController', ['$modalInstance', 'hrTask', 'statuses', 'HRTasks', 'NgTableParams', 'helper', 'CustomerService', function ($modalInstance, hrTask, statuses, HRTasks, NgTableParams, helper, CustomerService) {
  const vm = this;
  vm.dismiss = $modalInstance.dismiss;
  vm.hrTask = hrTask;

  function convertInterviewerToText(interviewer) {
    return helper.convertObjectToText(interviewer, ['code', 'displayName'], ' - ') || 'Chưa có';
  }

  vm.init = () => {
    vm.applicationFormsTable = new NgTableParams({
      count: 50
    });
    HRTasks.getInvolveApplicationForms({
      statuses,
      hrTaskId: hrTask._id
    }).$promise.then(applicationForms => {
      _.forEach(applicationForms, applicationForm => {
        applicationForm.interviewerText = convertInterviewerToText(applicationForm.interviewer);

        if (applicationForm.interviewDate) {
          applicationForm.textInterviewDate = moment(applicationForm.interviewDate).format('DD/MM');
        }

        if (applicationForm.interviewTime) {
          applicationForm.textInterviewTime = moment(applicationForm.interviewTime).format('HH:mm');
        }

        applicationForm.mobileProvider = CustomerService.checkProvider(applicationForm.cellphone) || 'Khác';
      });

      vm.applicationFormsTable.settings({
        dataset: applicationForms
      });
    });
  };
}]);
"use strict";

angular.module('hr-tasks').controller('ModalViewHrTaskApplicationFormsController', ['$modalInstance', 'employeeApplicationForms', function ($modalInstance, employeeApplicationForms) {
  const vm = this;

  vm.init = () => {
    vm.employeeApplicationForms = employeeApplicationForms;
  };

  vm.dismiss = $modalInstance.dismiss;
}]);
"use strict";

angular.module('hr-tasks').controller('ModalViewJobPostsController', ['$modalInstance', '$http', 'hrTask', 'Authentication', 'ConfirmModal', 'FhdMessenger', function ($modalInstance, $http, hrTask, Authentication, ConfirmModal, FhdMessenger) {
  const vm = this;
  vm.user = Authentication.user;
  vm.hrTask = hrTask;
  vm.dismiss = $modalInstance.dismiss;

  vm.delete = jobPost => {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Xóa Job Post ${jobPost.title}`,
      bodyText: `Bạn chắc chắn muốn xóa chứ`
    }).then(() => {
      vm.waiting = true;
      $http.delete(`/job-posts/${jobPost.jobPost}`).then(response => {
        FhdMessenger.success('Xóa thành công');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('hr-tasks').controller('ModalViewRecruitmentInfoController', ['$modalInstance', 'hrTask', function ($modalInstance, hrTask) {
  const vm = this;
  vm.hrTask = hrTask;
  vm.dismiss = $modalInstance.dismiss;
}]);
"use strict";

angular.module('reports').controller('ProbationCountController', ['$http', 'FhdMessenger', 'NgTableParams', '$scope', '$q', 'BusinessService', 'OutletService', function ($http, FhdMessenger, NgTableParams, $scope, $q, BusinessService, OutletService) {
  const vm = this;
  vm.waiting = false;
  vm.data = {};
  vm.data.startDate = moment().subtract(1, 'month').startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.probationStaffTable = new NgTableParams({
    count: 50
  });

  vm.staffSearchSelected = staff => {
    vm.data.staff = staff;
  };

  vm.init = () => {
    // load business
    vm.businessPromise = BusinessService.allAsync().then(businesses => {
      vm.data.businesses = _.filter(businesses, {
        deleted: false
      });
      vm.showBusinessMap = _.reduce(vm.data.businesses, (result, business, value) => {
        result[business._id] = {
          value: true,
          business
        };
        return result;
      }, {});
    }); // load outlet

    vm.outletPromise = OutletService.allAsync().then(result => {
      vm.data.outlets = result;
      vm.data.outlets = _.filter(vm.data.outlets, outlet => {
        if (outlet.code === 'KHONTD' || !outlet.hasStaff || outlet.code === 'MKT' || outlet.code === 'OFFICE') {
          return false;
        }

        return true;
      });
      vm.showOutletMap = _.reduce(vm.data.outlets, (result, outlet) => {
        result[outlet._id] = {
          outlet,
          value: true,
          enable: true
        };
        return result;
      }, {});
    });
  };

  $scope.$watch(() => {
    return {
      businessMap: vm.showBusinessMap
    };
  }, () => {
    _.forEach(_.values(vm.showBusinessMap), business => {
      const businessId = _.get(business, 'business._id');

      const outlets = _.filter(vm.showOutletMap, outlet => {
        return _.get(outlet, 'outlet.business._id') === businessId;
      });

      _.forEach(outlets, outlet => {
        outlet.enable = business.value;
      });
    });
  }, true);

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'outlet':
        {
          let changeValue = true;
          if (_.every(_.map(vm.showOutletMap, 'value'))) changeValue = false;

          _.forEach(vm.showOutletMap, (outlet, key) => {
            vm.showOutletMap[key].value = changeValue;
          });

          break;
        }

      default:
    }
  };

  vm.find = () => {
    vm.waiting = true;
    vm.staffId = _.get(vm.data.staff, '_id', null);
    let promise = $q.all([vm.outletPromise]).then(() => {
      const outlets = _.reduce(vm.showOutletMap, (outlets, outlet, outletId) => {
        if (outlet.value && outlet.enable) outlets.push(outletId);
        return outlets;
      }, []);

      $http({
        method: 'GET',
        url: '/shift-reports/probation-counts',
        params: {
          startDate: vm.data.startDate,
          endDate: vm.data.endDate,
          staffId: vm.staffId,
          outlets: outlets
        }
      }).then(respons => {
        const data = respons.data;
        vm.probationStaffTable.settings({
          dataset: data
        });
      }).finally(() => {
        vm.data.staff = null;
        vm.waiting = false;
      });
    });
    FhdMessenger.notifyLoading('Đang tải dữ liệu...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
  };
}]);
"use strict";

angular.module('hr-tasks').filter('filterHrTaskInput', [function () {
  return function (hrTasks, viewValue, hrTaskSearch) {
    const lowerCaseViewValue = viewValue.toLowerCase();

    const matchHrTask = _.find(hrTasks, hrTask => hrTask.name.toLowerCase() === lowerCaseViewValue);

    if (matchHrTask) {
      return [matchHrTask];
    }

    if (hrTaskSearch && viewValue !== hrTaskSearch) {
      return _.filter(hrTasks, hrTask => {
        return hrTask.name.toLowerCase().includes(lowerCaseViewValue);
      });
    }

    return hrTasks;
  };
}]).directive('fhdHrTaskInput', [function () {
  return {
    templateUrl: 'modules/hr-tasks/templates/fhd-hr-task-input.client.template.html',
    restrict: 'AE',
    scope: {
      hrTask: '=?',
      labelColumn: '@',
      noLabel: '=?',
      label: '@',
      onChange: '=?',
      onSelect: '=?',
      onSelectExp: '&',
      removeAfterSelect: '@',
      breakpoint: '@'
    },
    controller: 'fhdHrTaskInputController',
    controllerAs: 'vm',
    bindToController: true,

    link(scope, element) {
      const vm = scope.vm;

      if (vm.labelColumn) {
        vm.labelColumn = vm.labelColumn || 2;
        vm.breakpoint = vm.breakpoint || 'sm';
        const labelElm = element.find('label');
        const inputElm = element.find('fhd-controls');
        labelElm.addClass(`col-${vm.breakpoint}-${vm.labelColumn}`);
        inputElm.addClass(`col-${vm.breakpoint}-${12 - vm.labelColumn}`);
      }
    }

  };
}]).controller('fhdHrTaskInputController', ['$scope', 'ObjectId', 'HRTaskService', function ($scope, ObjectId, HRTaskService) {
  const vm = this;
  const notSelected = '';
  vm.hrTaskSearch = notSelected;
  vm.hrTasks = [];
  vm.hrTask = vm.hrTask || null;

  if (_.get(vm.hrTask, 'position')) {
    vm.hrTaskSearch = `${vm.hrTask.position} - ${_.get(vm.hrTask, 'outlet.code', '')}`;
  }

  vm.getHrTasks = HRTaskService.getRecruiting().then(hrTasks => {
    return hrTasks.map(hrTask => {
      hrTask.name = `${hrTask.position} - ${_.get(hrTask, 'outlet.code', '')}`;
      return hrTask;
    });
  });

  vm.handleRemove = () => {
    vm.hrTask = null;
    vm.hrTaskSearch = '';
  };

  vm.selectHrTask = item => {
    vm.hrTask = item;

    if (vm.onSelect) {
      vm.onSelect(item);

      if (vm.removeAfterSelect) {
        vm.handleRemove();
      }
    } else if (vm.onSelectExp) {
      vm.onSelectExp({
        $hrTask: item
      });

      if (vm.removeAfterSelect) {
        vm.handleRemove();
      }
    }
  };

  vm.getDefaultHrTask = () => {
    vm.getHrTasks.then(function (hrTasks) {
      vm.hrTasks = hrTasks;

      if (vm.hrTask) {
        const matchHrTask = _.find(hrTasks, {
          _id: ObjectId.getObjectId(vm.hrTask)
        });

        if (matchHrTask) {
          return matchHrTask;
        }
      }
    }).then(hrTask => {
      vm.hrTask = hrTask;
      if (hrTask) vm.hrTaskSearch = hrTask.name;
    });
  };

  $scope.$watch('vm.hrTask', (newValue, oldValue) => {
    if (newValue === oldValue) return;

    if (vm.onChange && newValue) {
      vm.onChange(newValue);
    }
  });
}]);
'use strict';

angular.module('hr-tasks').factory('HRTaskService', ['$http', '$modal', function ($http, $modal) {
  return {
