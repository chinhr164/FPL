angular.module('users').controller('IdentifyTokenController', ['$stateParams', '$http', 'FhdMessenger', function ($stateParams, $http, FhdMessenger) {
  const vm = this;

  vm.findByIdentifyToken = () => {
    if (!$stateParams.identifyToken) {
      return FhdMessenger.error('Identify Token không tồn tại');
    }

    $http.get(`/users/identify-token/${$stateParams.identifyToken}`).then(res => {
      vm.user = res.data;
      FhdMessenger.success('Lấy dữ liệu thành công');
    }).catch(err => {
      vm.error = true;
      FhdMessenger.error(err.data.message);
    });
  };
}]);
