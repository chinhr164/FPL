/* eslint-disable angular/controller-as-vm */
angular.module('stocks').controller('DaysLeftController', ['$http', 'Authentication', 'Stocks', 'FhdMessenger', 'NgTableParams', 'RolesService', 'ReportStats', 'StyleService', 'OutletService', '$q', 'ProductService', 'TetCategoriesService', '$localStorage', '$filter', '$window', '$timeout', '$scope', function ($http, Authentication, Stocks, FhdMessenger, NgTableParams, RolesService, ReportStats, StyleService, OutletService, $q, ProductService, TetCategoriesService, $localStorage, $filter, $window, $timeout, $scope) {
  const vm = this;
  vm.user = Authentication.user;
  vm.permitRoles = RolesService.permitRoles;
  vm.data = {
    cat: 'tet',
    tetCategories: TetCategoriesService.getTags(),
    inputDescriptionFilter: ''
  };
  vm.specialFilter = {
    description: {
      using: false,
      data: []
    },
    catman: {
      using: false,
      data: []
    }
  };

  function intersectionBySku(arr1, arr2) {
    const skuArr1 = _.map(arr1, 'sku');

    const skuArr2 = _.map(arr2, 'sku');

    const skuIntersection = _.intersection(skuArr1, skuArr2);

    return _.filter(vm.stocks, product => {
      return _.includes(skuIntersection, product.sku);
    });
  }

  function mergeFilter(defaultData, withDefaultFilter) {
    const isUsingCatman = vm.specialFilter.catman.using;
    const isUsingDescription = vm.specialFilter.description.using;

    if (withDefaultFilter) {
      if (isUsingCatman) {
        return intersectionBySku(defaultData, vm.specialFilter.catman.data);
      }

      if (isUsingDescription) {
        return intersectionBySku(defaultData, vm.specialFilter.description.data);
      }
    }

    if (!isUsingDescription || !isUsingCatman) {
      return defaultData;
    }

    return intersectionBySku(vm.specialFilter.description.data, vm.specialFilter.catman.data);
  }

  $scope.$watch(() => vm.data.inputDescriptionFilter, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const originalText = vm.data.inputDescriptionFilter;

    const hasSpecialFilter = _.includes(originalText, '*');

    if (hasSpecialFilter) {
      const splited = originalText.replace(/\s/g, '').split('*');

      const regexString = _.reduce(splited, (result, word) => {
        result += `(.*?)${word}`;
        return result;
      }, '');

      let matchDescription = _.filter(vm.stocks, stock => {
        return _.get(stock, 'description', '').replace(/\s/g, '').match(new RegExp(regexString, 'gi'));
      });

      vm.specialFilter.description.data = matchDescription;
      vm.specialFilter.description.using = true;
      vm.tableParams.filter()['description'] = '';
      vm.tableParams.settings({
        dataset: mergeFilter(matchDescription)
      });
    } else {
      vm.specialFilter.description.using = false;
      vm.tableParams.settings({
        dataset: mergeFilter(vm.stocks, true)
      });
      vm.tableParams.filter()['description'] = originalText;
    }
  });
  $scope.$watch(() => vm.data.cat, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    if (newValue !== 'tet') {
      vm.tableParams.settings({
        dataset: vm.stocks
      });
    }
  });
  $scope.$watch(() => vm.data.categoryName, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    if (!newValue) {
      vm.specialFilter.catman.using = false;
      vm.tableParams.settings({
        dataset: mergeFilter(vm.stocks, true)
      });
    } else {
      const matchCategory = _.filter(vm.stocks, stock => {
        return _.get(stock, 'tetCategory.name', '').match(new RegExp(`^(${newValue})$`));
      });

      vm.specialFilter.catman.data = matchCategory;
      vm.specialFilter.catman.using = true;
      vm.tableParams.settings({
        dataset: mergeFilter(matchCategory)
      });
    }
  });
  vm.showOutlets = false;
  const regions = ['SOUTH', 'NORTH', 'CENTRAL'];
  vm.tableParams = new NgTableParams({
    filter: {
      toBuy: 'Buying',
      isBaking: '',
      isMooncake: '',
      toSell: '',
      toUse: '',
      publishWeb: ''
    }
  }, {});

  vm.init = async () => {
    vm.startDate = moment().subtract(14, 'day').format('YYYY-MM-DD');
    vm.endDate = moment().subtract(1, 'day').format('YYYY-MM-DD');
    await defineDaysLeftTableCols();
  };

  vm.quickEditProduct = ProductService.quickEditProduct;
  vm.quickEditProductAttributes = ProductService.quickEditProductAttributes;

  function indexCol($scope, row, rowIndex) {
    return `<span>${rowIndex + 1}</span>`;
  }

  function normalValue($scope, row) {
    const value = _.get(row, this.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${_.get(row, this.field) || ''}</span>`;
  }

  function numberValue($scope, row) {
    const value = _.get(row, this.field, '');

    return `<span>${$filter('number')(value, 0)}</span>`;
  }

  function percentValue($scope, row) {
    // eslint-disable-next-line
    let value = $filter('number')(_.get(row, this.field));

    if (!value) {
      return '';
    }

    value = (value * 100).toFixed(2);
    return `<span>${value}%</span>`;
  }

  function getSkuCell($scope, row) {
    return `<a ng-click="vm.quickEditProduct(row)">${row.sku}</a>`;
  }

  function getDescriptionCell($scope, row) {
    return `<a ng-click="vm.quickEditProductAttributes(row)">${row.description}</a>`;
  }

  const defineDaysLeftTableCols = async () => {
    const {
      SALE_OUTLET_CODES
    } = await OutletService.getOutletCodes();
    const outletStyle = await StyleService.getOutletStyle();

    function getStyle(row) {
      const value = _.get(row, this.field);

      const outlet = _.get(this.field.split('.'), '1');

      const maxDayLeftOfOutlet = _.get(row, 'maxDayLeftOfOutlet');

      if (maxDayLeftOfOutlet === value) {
        return {
          'background-color': 'red',
          color: 'white'
        };
      } // Highlight southern Outlets


      return outletStyle(outlet);
    }

    vm.cols = [{
      title: 'STT',
      show: true,
      getValue: indexCol
    }, {
      field: 'sku',
      title: 'SKU',
      sortable: 'sku',
      filter: {
        sku: '/modules/stocks/template/input-sku-filter.client.template.html'
      },
      show: true,
      getValue: getSkuCell
    }, {
      field: 'vendor.code',
      title: 'Mã vendor',
      sortable: 'vendor.code',
      filter: {
        'vendor.code': 'text'
      },
      show: true,
      getValue: normalValue
    }, {
      field: 'description',
      title: 'Description',
      sortable: 'description',
      filter: {
        description: '/modules/reports/templates/input-description-filter.client.template.html'
      },
      show: true,
      getValue: getDescriptionCell,
      getStyle: () => {
        return {
          'min-width': 200
        };
      }
    }, {
      field: 'toBuy',
      title: 'Buying',
      filter: {
        toBuy: 'select'
      },
      filterData: [{
        id: 'Buying',
        title: 'Buying'
      }, {
        id: 'Stop',
        title: 'Not Buying'
      }],
      sortable: 'toBuy',
      show: true,
      getValue: normalValue
    }, {
      field: 'tetCategory.name',
      title: 'Tết Tag',
      filter: {
        'tetCategory.name': '/modules/reports/templates/select-categories-filter.client.template.html'
      },
      filterData: vm.data.tetCategories,
      sortable: 'tetCategory.name',
      show: () => {
        return vm.data.cat === 'tet';
      },
      getValue: normalValue
    }, {
      field: 'tag',
      title: 'Tag',
      sortable: 'tag',
      filter: {
        tag: 'select'
      },
      filterData: ProductService.getAllProductsTagsFromServer,
      getValue: normalValue
    }, ...SALE_OUTLET_CODES.map(outletCode => {
      return {
        field: `outletDaysLeftMap.${outletCode}`,
        title: outletCode,
        sortable: `${outletCode}`,
        showOn: 'showOutlets',
        show: vm.showOutlets,
        getStyle: getStyle,
        getValue: numberValue
      };
    }), {
      field: 'totalStock',
      title: 'Stock',
      sortable: 'totalStock',
      show: true,
      getValue: numberValue
    }, {
      field: 'buyingQuantity',
      title: 'Buying',
      sortable: 'buyingQuantity',
      show: true,
      getValue: numberValue
    }, {
      field: 'northBuyingQuantity',
      title: 'North Buying',
      sortable: 'northBuyingQuantity',
      show: true,
      getValue: numberValue
    }, {
      field: 'southBuyingQuantity',
      title: 'South Buying',
      sortable: 'southBuyingQuantity',
      show: true,
      getValue: numberValue
    }, {
      field: 'centralBuyingQuantity',
      title: 'Central Buying',
      sortable: 'centralBuyingQuantity',
      show: true,
      getValue: numberValue
    }, {
      field: 'processingQuantity',
      title: 'Processing',
      sortable: 'processingQuantity',
      show: true,
      getValue: numberValue
    }, {
      field: 'northProcessingQuantity',
      title: 'North Processing',
      sortable: 'northProcessingQuantity',
      show: true,
      getValue: numberValue
    }, {
      field: 'southProcessingQuantity',
      title: 'South Processing',
      sortable: 'southProcessingQuantity',
      show: true,
      getValue: numberValue
    }, {
      field: 'total_inTransit',
      title: 'Total Stock',
      sortable: 'total_inTransit',
      show: true,
      getValue: numberValue
    }, {
      field: 'NORTH_inTransit',
      title: 'North Total Stock',
      sortable: 'NORTH_inTransit',
      show: true,
      getValue: numberValue
    }, {
      field: 'SOUTH_inTransit',
      title: 'South Total Stock',
      sortable: 'SOUTH_inTransit',
      show: true,
      getValue: numberValue
    }, {
      field: 'CENTRAL_inTransit',
      title: 'Central Total Stock',
      sortable: 'CENTRAL_inTransit',
      show: true,
      getValue: numberValue
    }, {
      field: 'sale',
      title: 'Sales',
      sortable: 'sale',
      show: true,
      getValue: numberValue
    }, {
      field: 'salePerDay',
      title: 'SPD',
      sortable: 'salePerDay',
      show: true,
      getValue: numberValue
    }, {
      field: 'daysLeft',
      title: 'Days Left',
      sortable: 'daysLeft',
      show: true,
      getValue: numberValue
    }, {
      field: 'northDaysLeft',
      title: 'NORTH Days Left',
      sortable: 'northDaysLeft',
      show: true,
      getValue: numberValue
    }, {
      field: 'southDaysLeft',
      title: 'SOUTH Days Left',
      sortable: 'southDaysLeft',
      show: true,
      getValue: numberValue
    }, {
      field: 'centralDaysLeft',
      title: 'CENTRAL Days Left',
      sortable: 'centralDaysLeft',
      show: true,
      getValue: numberValue
    }, {
      field: 'northServiceLevel',
      title: 'NORTH Service Level',
      sortable: 'northServiceLevel',
      show: true,
      getValue: percentValue
    }, {
      field: 'southServiceLevel',
      title: 'SOUTH Service Level',
      sortable: 'southServiceLevel',
      show: true,
      getValue: percentValue
    }, {
      field: 'totalServiceLevel',
      title: 'Total Service Level',
      sortable: 'totalServiceLevel',
      show: true,
      getValue: percentValue
    }];
  };

  vm.changeShowOutlets = newValue => {
    _.forEach(vm.cols, col => {
      if (col.showOn === 'showOutlets') {
        col.show = newValue;
      }
    });
  };

  function formatFieldValue(fieldValue = '') {
    if (angular.isNumber(fieldValue)) {
      return $filter('number')(fieldValue, 0);
    }

    return fieldValue;
  }

  vm.copyDayLeftTableCSV = async () => {
    const {
      SALE_OUTLET_CODES
    } = await OutletService.getOutletCodes();

    const tableColumns = _.cloneDeep(vm.cols);

    tableColumns.shift();

    const dayLeftTableCols = _.filter(tableColumns, col => vm.showOutlets ? true : !SALE_OUTLET_CODES.includes(col.title));

    vm.dayLeftTableCSV = _.map(dayLeftTableCols, 'title').join('\t') + '\n';

    _.forEach(vm.stocks, stock => {
      const stockRow = _.reduce(dayLeftTableCols, (result, col) => {
        result += formatFieldValue(_.get(stock, col.field, 0)) + `\t`;
        return result;
      }, '');

      vm.dayLeftTableCSV += stockRow + '\n';
    });

    $timeout(() => {
      $window.document.getElementById('days-left-csv').select();
      $window.document.execCommand('copy');
      FhdMessenger.success('Đã copy');
    }, 2000);
  };

  vm.find = function () {
    vm.numDiffDays = moment(vm.endDate).diff(moment(vm.startDate), 'days') + 1; // Code này để test nhanh TODO: comment đoạn dưới nhé
    // vm.stocks = $localStorage.getObject('vmstocks')
    // if (vm.stocks && vm.stocks.length) {
    //   // Set data for tables
    //   vm.tableParams.settings({ dataset: vm.stocks })
    //   vm.tableParams.sorting({ sku: 'asc' })
    //   return
    // }

    if (moment(vm.endDate).diff(moment(vm.startDate), 'days') >= 60) {
      return FhdMessenger.error('Chỉ được lấy dữ liệu trong tối đa 60 ngày. ');
    }

    vm.isLoading = true;
    const saleTotalPromise = $http.get('/reports/sale-total', {
      params: {
        startDate: vm.startDate,
        endDate: vm.endDate,
        businessId: '5710bb19731ce0c4ebf685dd' // business 'ABBY' code

      }
    }).then(res => res.data);
    const getStocksPromise = Stocks.query({}).$promise;
    const getServiceLevel = ReportStats.getServiceLevelByRegionMap({});
    let promise = $q.all([saleTotalPromise, getStocksPromise, getServiceLevel, OutletService.getOutletCodes()]).then(values => {
      const [quantitySaleProducts, products, serviceLevelByRegionMap, outletCodes] = values;
      const {
        SALE_OUTLET_CODES,
        DEPOT_OUTLET_CODES
      } = outletCodes;
      const SALE_OUTLET_WITH_DEPOT_CODES = [...SALE_OUTLET_CODES, ...DEPOT_OUTLET_CODES];
      vm.quantitySaleProductsMap = {};

      _.forEach(quantitySaleProducts, product => {
        vm.quantitySaleProductsMap[product._id] = {
          totalSale: _.get(product, 'quantity')
        };
        vm.quantitySaleProductsMap[product._id].salePerDayOfOutletMap = _.reduce(SALE_OUTLET_WITH_DEPOT_CODES, (result, outletCode) => {
          const outlet = _.find(product.outlets, outlet => outlet.outlet.code === outletCode);

          result[outletCode] = _.get(outlet, 'quantity', 0);
          return result;
        }, {});
        vm.quantitySaleProductsMap[product._id].saleOfRegions = _.reduce(product.outlets, (result, outlet) => {
          const outletRegion = _.get(outlet, 'outlet.region');

          const quantity = _.get(outlet, 'quantity', 0);

          _.forEach(regions, region => {
            if (outletRegion === region) {
              result[region] = result[region] || 0;
              result[region] += quantity;
            }
          });

          return result;
        }, {});
      }); // Filter stocks


      vm.stocks = _.filter(products, product => {
        return product.stockControl && product.sku.match(/^B/);
      }); // Format stocks

      _.forEach(vm.stocks, function (product) {
        product.totalStock = _.reduce(SALE_OUTLET_WITH_DEPOT_CODES, (result, outletCode) => {
          return _.get(product, `${outletCode}_inTransit`, 0) + result;
        }, 0);
        product.description = _.get(product, 'description', '');
        product.salePerDay = _.get(vm.quantitySaleProductsMap, `${product._id}.totalSale`, 0) / vm.numDiffDays;
        product.buyingQuantity = _.get(product, 'buyingQuantity', 0) || 0;
        product.processingQuantity = _.get(product, 'processingQuantity', 0) || 0;
        product.salePerDayOfOutletMap = _.get(vm.quantitySaleProductsMap, `${product._id}.salePerDayOfOutletMap`, {});
        product.total_inTransit = _.get(product, 'totalStock', 0) + _.get(product, 'buyingQuantity', 0) + _.get(product, 'processingQuantity', 0);
        product.maxDayLeftOfOutlet = 0; // Fet default value

        product.outletDaysLeftMap = _.reduce(product.salePerDayOfOutletMap, (result, quantity, outletCode) => {
          const dayLeft = _.get(product, `${outletCode}_inTransit`, 0) / (quantity / vm.numDiffDays); // Find max day left

          if (dayLeft > product.maxDayLeftOfOutlet) {
            product.maxDayLeftOfOutlet = dayLeft;
          }

          result[outletCode] = dayLeft;
          return result;
        }, {});

        const saleOfRegions = _.get(vm.quantitySaleProductsMap, `${product._id}.saleOfRegions`, {
          NORTH: 0,
          SOUTH: 0,
          CENTRAL: 0
        });

        product.salePerDayOfRegion = _.reduce(saleOfRegions, (result, value, key) => {
          result[key] = value / vm.numDiffDays;
          return result;
        }, {});
        product.southDaysLeft = _.get(product, 'SOUTH_inTransit', 0) / product.salePerDayOfRegion.SOUTH;
        product.northDaysLeft = _.get(product, 'NORTH_inTransit', 0) / product.salePerDayOfRegion.NORTH;
        product.centralDaysLeft = _.get(product, 'CENTRAL_inTransit', 0) / product.salePerDayOfRegion.CENTRAL;
        product.northServicelLevel = _.get(serviceLevelByRegionMap[product.sku], 'northServiceLevel');
        product.southServiceLevel = _.get(serviceLevelByRegionMap[product.sku], 'southServiceLevel');
        product.totalServiceLevel = _.get(serviceLevelByRegionMap[product.sku], 'totalServiceLevel');
        product.daysLeft = product.total_inTransit / product.salePerDay;
        product.toBuy = product.notBuying ? 'Stop' : 'Buying';
      }); // Set data for tables


      vm.tableParams.settings({
        dataset: vm.stocks
      });
      vm.tableParams.sorting({
        sku: 'asc'
      }); // Code này để test nhanh TODO: comment dòng dưới đi nhé
      // $localStorage.setObject('vmstocks', _.take(vm.stocks, 100))

      vm.isLoading = false;
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tính số lượng hàng tồn và số hàng bán ra...', promise, () => {
      FhdMessenger.success('Đã tính xong.');
    });
  };
}]);
"use strict";

angular.module('stocks').controller('RawStockController', ['$http', '$window', '$timeout', 'NgTableParams', 'FhdMessenger', 'OutletService', 'StyleService', '$filter', function ($http, $window, $timeout, NgTableParams, FhdMessenger, OutletService, StyleService, $filter) {
  const vm = this;
  vm.stockTable = new NgTableParams({
    count: 100
  });
  vm.stockProducts = [];

  vm.resetState = () => {
    vm.stockData = [];
    vm.stockTable.settings({
      dataset: []
    });
  };

  vm.load = () => {
    vm.loading = true;
    vm.resetState();
    let promise = $http.post('/stock-products', {
      select: 'sku description',
      endDate: new Date(),
      isRaw: true
    }).then(({
      data
    }) => {
      vm.stockProducts = data;
      vm.stockTable.settings({
        dataset: vm.stockProducts
      });
    }).catch(e => {
      return FhdMessenger.errorFromServer(e);
    }).finally(() => {
      vm.loading = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
  };

  function getIndex(scope, row, column, field) {
    return `<span>${field + 1}</span>`;
  }

  function getStock(scope, row, col) {
    const {
      stock
    } = _.get(row, `outletMap.${col.field}`);

    return `<span>${$filter('number')(stock, 0)}</span>`;
  }

  function getTotalStock(scope, row, col) {
    const totalStock = _.get(row, col.field);

    return `<span>${$filter('number')(totalStock, 0)}</span>`;
  }

  function getNormalValue(scope, row, col) {
    const value = _.get(row, col.field);

    return `<span>${value}</span>`;
  }

  vm.init = async () => {
    const {
      PACKING_OUTLET_CODES
    } = await OutletService.getOutletCodes();
    vm.outletCodes = PACKING_OUTLET_CODES;
    const outletStyle = await StyleService.getOutletStyle();

    function getStyle(row) {
      const vm = this;
      const outlet = vm.field;
      return outletStyle(outlet);
    }

    vm.columns = [{
      field: '$index',
      title: 'STT',
      show: true,
      getValue: getIndex
    }, {
      field: 'sku',
      title: 'SKU',
      show: true,
      sortable: 'sku',
      filter: {
        sku: 'text'
      },
      getValue: getNormalValue
    }, {
      field: 'description',
      title: 'Description',
      show: true,
      sortable: 'description',
      filter: {
        description: 'text'
      },
      getValue: getNormalValue
    }, ..._.map(vm.outletCodes, outletCode => {
      return {
        field: outletCode,
        title: outletCode,
        show: true,
        sortable: `outletMap.${outletCode}.stock`,
        getValue: getStock,
        getStyle
      };
    }), {
      field: 'totalStock',
      title: 'Total',
      sortable: 'totalStock',
      show: true,
      getValue: getTotalStock
    }];
  };

  vm.copyProductTSV = () => {
    const headers = ['STT', 'SKU', 'Description', 'Tags', ...vm.outletCodes, 'total'].join('\t');
    const products = vm.stockProducts.map((product, index) => {
      const numbers = vm.outletCodes.map(outletCode => {
        return $filter('number')(_.get(product, `outletMap.${outletCode}.stock`, 0), 0);
      });
      const fields = [index + 1, product.sku, product.description, ...numbers, $filter('number')(product.totalStock, 0)];
      return fields.join('\t');
    });
    vm.productTSV = `Cập nhật lúc ${moment().format('YYYY-MM-DD HH:mm')}\n` + headers + '\n' + products.join('\n');
    const copyText = $window.document.getElementById('productsCSV');
    $timeout(() => {
      /* Select the text field */
      copyText.select();
      /* Copy the text inside the text field */

      $window.document.execCommand('copy');
      FhdMessenger.success('Đã copy'); // $timeout(() => {
      //   vm.productTSV = 'Nhấn vào nút Copy bảng để lấy dữ liệu...'
      // }, 2000)
    }, 2000);
  };

  vm.exportFile = () => {
    const stocks = _.map(vm.stockProducts, function (product) {
      const row = {
        sku: product.sku,
        description: product.description
      };

      _.forEach(vm.outletCodes, outletCode => {
        _.assign(row, {
          [outletCode]: _.get(product, `outletMap.${outletCode}.stock`, 0)
        });
      });

      _.assign(row, {
        Total: $filter('number')(product.totalStock, 0)
      });

      return row;
    });

    alasql(`SELECT * INTO XLSX("raw-stock.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [stocks]);
  };
}]);
"use strict";

angular.module('stocks').controller('SavorStockController', ['$http', '$window', '$timeout', 'NgTableParams', 'FhdMessenger', function ($http, $window, $timeout, NgTableParams, FhdMessenger) {
  const vm = this;
  const OUTLET_CODES = ['S1', 'S2', 'S4', 'S6', 'S7', 'S8', 'S10', 'S11', 'S12', 'S13', 'S14', 'S16', 'S17', 'S18', 'S19', 'B1', 'B2', 'B3'];
  vm.outletCodes = OUTLET_CODES;
  vm.stockTable = new NgTableParams({
    count: 100
  });
  vm.stockProducts = [];

  vm.resetState = () => {
    vm.stockData = [];
    vm.stockTable.settings({
      dataset: []
    });
  };

  vm.loading = false;

  vm.load = () => {
    vm.loading = true;
    vm.resetState();
    let promise = $http.post('/stock-products', {
      select: 'sku description tags',
      limit: 500,
      outletCodes: OUTLET_CODES,
      endDate: new Date(),
      filterProductsByStoreDisplay: true,
      filterProductsByBusinessCode: 'SAVOR',
      filterProductsMap: {
        deleted: false,
        tags: {
          $in: ['SX B1 Sáng', 'SX B1 Chiều', 'SX B2', 'Direct B1', 'SX B2', 'SX B1 Chiều', 'SX B1 Sáng', 'SX 5h', 'Direct CS', 'Restock B3', 'Buying B3', 'Restock B1', 'Buying Sáng', 'Restock B2', 'Restock B2 Sáng', 'SX CS', 'Buying B1', 'Raw B1']
        }
      }
    }).then(response => {
      vm.loading = false;
      vm.stockProducts = response.data;

      _.forEach(vm.stockProducts, product => {
        const tags = _.compact(product.tags || []).join(', ');

        product.allTagsText = tags;
      }); // console.log(response.data)


      vm.stockTable.settings({
        dataset: response.data
      });
    }).catch(e => {
      vm.loading = false;
      FhdMessenger.errorFromServer(e);
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
  };

  vm.copyProductTSV = () => {
    const headers = ['STT', 'SKU', 'Description', 'Tags', ...OUTLET_CODES, 'total'].join('\t');
    const products = vm.stockProducts.map((product, index) => {
      const numbers = OUTLET_CODES.map(outletCode => {
        return _.get(product, `outletMap.${outletCode}.stock`, 0);
      });
      const fields = [index + 1, product.sku, product.description, product.allTagsText, ...numbers, product.totalStock];
      return fields.join('\t');
    });
    vm.productTSV = `Cập nhật lúc ${moment().format('YYYY-MM-DD HH:mm')}\n` + headers + '\n' + products.join('\n');
    const copyText = $window.document.getElementById('productsCSV');
    $timeout(() => {
      /* Select the text field */
      copyText.select();
      /* Copy the text inside the text field */

      $window.document.execCommand('copy');
      FhdMessenger.success('Đã copy'); // $timeout(() => {
      //   vm.productTSV = 'Nhấn vào nút Copy bảng để lấy dữ liệu...'
      // }, 2000)
    }, 2000);
  };

  vm.exportFile = () => {
    const stocks = _.map(vm.stockProducts, function (product) {
      const row = {
        sku: product.sku,
        description: product.description,
        Tags: product.allTagsText
      };

      _.forEach(vm.outletCodes, outletCode => {
        _.assign(row, {
          [outletCode]: _.get(product, `outletMap.${outletCode}.stock`, 0)
        });
      });

      _.assign(row, {
        Total: product.totalStock
      });

      return row;
    });

    alasql(`SELECT * INTO XLSX("savor-current-stock.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [stocks]);
  };
}]);
"use strict";

/* eslint-disable angular/controller-as */
angular.module('stocks').controller('StocksMapController', ['$state', 'Authentication', 'NgTableParams', 'StockMap', 'MooncakeCategoriesService', 'OutletService', 'Products', 'ProductService', 'ProductCatService', 'ProductWeight', 'ValentineCategoriesService', 'TetCategoriesService', '$scope', 'JsPrintService', 'FhdMessenger', 'CurrentShift', '$filter', '$http', 'OutletStockService', function ($state, Authentication, NgTableParams, StockMap, MooncakeCategoriesService, OutletService, Products, ProductService, ProductCatService, ProductWeight, ValentineCategoriesService, TetCategoriesService, $scope, JsPrintService, FhdMessenger, CurrentShift, $filter, $http, OutletStockService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.tableParams = new NgTableParams({
    filter: {
      isMooncake: '',
      toSell: '',
      toUse: '',
      publishWeb: '',
      tags: ''
    }
  }, {});

  vm.round = function (num) {
    return Math.round(num);
  };

  vm.maxCoolerWeightMap = {};
  vm.maxFreezerWeightMap = {};
  vm.displayStockCoolerWeightMap = {};
  vm.displayStockFreezerWeightMap = {};
  vm.currentStockCoolerWeightMap = {};
  vm.currentStockFreezerWeightMap = {};
  vm.business = 'Abby';
  vm.data = {
    products: [],
    outlet: null,
    product: null,
    availableProducts: [],
    currentView: 'stock',
    tetCategories: TetCategoriesService.getTags(),
    tagProducts: ProductService.getAllProductsTagsFromServer(),
    cat: 'tet',
    withInTransit: false,
    buyingFilter: [{
      id: 'Buying',
      title: 'Đang nhập'
    }, {
      id: 'Stop',
      title: 'Không nhập nữa'
    }, {
      id: '',
      title: 'Tất cả'
    }],
    warehouseRestockFilter: [{
      id: 'D1',
      title: 'D1'
    }, {
      id: 'D2',
      title: 'D2'
    }, {
      id: 'D3',
      title: 'D3'
    }, {
      id: 'D4',
      title: 'D4'
    }, {
      id: 'D5',
      title: 'D5'
    }, {
      id: 'D7',
      title: 'D7'
    }, {
      id: 'D10',
      title: 'D10'
    }, {
      id: 'B1',
      title: 'B1'
    }, {
      id: 'B2',
      title: 'B2'
    }, {
      id: 'B3',
      title: 'B3'
    }, {
      id: '',
      title: 'Tất cả'
    }],
    warehouseGroupFilter: [{
      id: 'Tủ đông',
      title: 'Tủ đông'
    }, {
      id: 'Tủ mát',
      title: 'Tủ mát'
    }, {
      id: 'Nhiệt độ phòng',
      title: 'Nhiệt độ phòng'
    }, {
      id: '',
      title: 'Tất cả'
    }],
    showOutlet: {
      NORTH: true,
      CENTRAL: true,
      SOUTH: true,
      DEPOT: true,
      CROPDEPOT: true
    }
  };
  vm.abbyOutletCodes = _.concat(['E0'], OutletStockService.abbyOutletCodes);
  vm.savorOutletCodes = OutletStockService.savorOutletCodes;
  vm.depotOutletCodes = OutletStockService.depotOutletCodes;
  vm.packingOutletCodes = OutletStockService.packingOutletCodes;
  vm.extendedWarehouseCodes = OutletStockService.extendedWarehouseCodes;
  vm.cropDepotOutletCodes = OutletStockService.cropDepotOutletCodes;
  vm.extendedOutletCodes = _.concat(['E0'], OutletStockService.extendedOutletCodes);

  _.forEach(vm.extendedOutletCodes, outletCode => {
    OutletService.findOutletFromCode(outletCode).then(outlet => {
      vm.maxCoolerWeightMap[outletCode] = _.get(outlet, 'maxCoolerStorageWeight');
      vm.maxFreezerWeightMap[outletCode] = _.get(outlet, 'maxFreezerStorageWeight');
    });
  }); // dynamic Table


  vm.outletRegionMap = OutletStockService.outletRegionMap;

  vm.matchFilterByRegion = outletCode => {
    if (_.includes(vm.cropDepotOutletCodes, outletCode)) {
      return vm.data.showOutlet.CROPDEPOT;
    }

    if (outletCode.match(/((D)\d+|KHO)/)) {
      return vm.data.showOutlet.DEPOT;
    }

    const region = _.get(vm.outletRegionMap, outletCode);

    return _.get(vm.data.showOutlet, region);
  };

  function indexCol($scope, row, rowIndex) {
    return `<span>${rowIndex + 1}</span>`;
  }

  function getSkuCell($scope, row) {
    return `<a ng-click="vm.viewProductAttributes(row)" target="_blank">${row.sku}</a>`;
  }

  function getDescriptionCell($scope, row) {
    if (_.get(row, 'wooProperties.websiteId')) {
      return ` <a ng-href="https://abby.vn/?p=${_.get(row, 'wooProperties.websiteId')}" target="_blank"
          >${row.description}</a>`;
    }

    return `<span>${row.description}</span>`;
  }

  function numberValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field, '');

    return `<span>${$filter('number')(value, 0)}</span>`;
  }

  function normalValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${_.get(row, vm.field) || ''}</span>`;
  }

  function totalValue($scope, row) {
    return `<span>${row.total}</span>`;
  }

  vm.cols = [{
    title: 'STT',
    show: true,
    getValue: indexCol
  }, {
    field: 'sku',
    title: 'SKU',
    sortable: 'sku',
    filter: {
      sku: 'text'
    },
    show: true,
    getValue: getSkuCell,
    getStyle: () => {
      return {
        'min-width': 100
      };
    }
  }, {
    field: 'description',
    title: 'Description',
    sortable: 'description',
    filter: {
      description: 'text'
    },
    show: true,
    getValue: getDescriptionCell,
    getStyle: () => {
      return {
        'min-width': 200
      };
    }
  }, {
    field: 'tag',
    title: 'Tag',
    sortable: 'tag',
    filter: {
      tag: 'select'
    },
    filterData: vm.data.tagProducts,
    show: true,
    getValue: normalValue
  }, {
    field: 'tetCategory.name',
    title: 'Cat Man',
    sortable: 'tetCategory.name',
    filter: {
      'tetCategory.name': 'select'
    },
    filterData: vm.data.tetCategories,
    show: () => {
      return vm.data.cat === 'tet' && vm.business === 'Abby';
    },
    getValue: normalValue
  }, {
    field: 'savorTag',
    title: 'Savor Tag',
    sortable: 'savorTag',
    filter: {
      savorTag: 'text'
    },
    show: () => {
      return vm.business === 'Savor';
    },
    getValue: normalValue
  }, {
    field: 'category.cat.name',
    title: 'Savor Cat',
    sortable: 'category.cat.name',
    filter: {
      'category.cat.name': 'select'
    },
    filterData: ProductCatService.getSavorCats,
    show: () => {
      return vm.business === 'Savor';
    },
    getValue: normalValue
  }, {
    field: 'toBuy',
    title: 'Buying',
    sortable: 'toBuy',
    filter: {
      toBuy: 'select'
    },
    filterData: vm.data.buyingFilter,
    show: true,
    getValue: normalValue
  }, {
    field: 'warehouseRestock.code',
    title: 'Warehouse Restock',
    sortable: 'warehouseRestock.code',
    filter: {
      warehouseRestock: 'select'
    },
    filterData: vm.data.warehouseRestockFilter,
    show: () => {
      return vm.business === 'Abby';
    },
    getValue: normalValue
  }, {
    field: 'warehouseGroup.name',
    title: 'Bảo quản',
    sortable: 'warehouseGroup.name',
    filter: {
      'warehouseGroup.name': 'select'
    },
    filterData: vm.data.warehouseGroupFilter,
    show: () => {
      return vm.business === 'Abby';
    },
    getValue: normalValue
  }];

  function getCurrentView() {
    return _.get(vm, 'data.currentView', 'stock');
  }

  function stockValue($scope, row) {
    const vm = this;
    const outletCode = vm.field;

    const normalStock = _.get(row, vm.field, ''); // product.M6


    const outletMap = _.get(row, 'outletMap', '');

    const outletMapCode = _.get(outletMap, outletCode); // product.outletMap.M6


    const currentView = getCurrentView();

    if (currentView === 'displayStock') {
      return `<span>${$filter('number')(outletMapCode, 0)}</span>`;
    }

    return `<span>${$filter('number')(normalStock, 0)}</span>`;
  }

  function getSize(field) {
    switch (field) {
      case 'stt':
        return '20px';

      case 'description':
        return '200px';

      case 'sku':
        return '80px';

      default:
        return '20px';
    }
  }

  function getStyle(row) {
    const vm = this;
    const outlet = vm.field;
    const isPrimary = ['stt', 'sku', 'description'].includes(vm.field);

    if (isPrimary) {
      if (row.justEdited) {
        return {
          'background-color': '#ff0',
          'min-width': getSize(vm.field)
        };
      } else {
        return {
          'min-width': getSize(vm.field)
        };
      }
    }

    if (['M6', 'E12', 'E15', 'E16', 'E30', 'E31', 'E32', 'E33'].includes(outlet)) {
      return {
        'background-color': '#dbfa87'
      };
    }

    if (['M1', 'M2'].includes(outlet)) {
      return {
        'background-color': '#7effe7'
      };
    }

    if (_.get(vm, 'depotOutletCodes', []).includes(outlet)) {
      return {
        'background-color': '#f4ece8'
      };
    }

    if (_.get(vm, 'savorOutletCodes', []).includes(outlet)) {
      return {
        'background-color': '#7effe7'
      };
    }

    if (_.get(vm, 'packingOutletCodes', []).includes(outlet)) {
      return {
        'background-color': '#f4ece8'
      };
    }
  }

  _.forEach(vm.abbyOutletCodes, outlet => {
    const outletCol = {
      field: outlet,
      title: outlet,
      sortable: outlet,
      filter: {
        [outlet]: 'number'
      },
      show: () => {
        return vm.business === 'Abby' && (!_.get(vm.data, 'outlet') || vm.data.outlet.code === outlet) && vm.matchFilterByRegion(outlet);
      },
      getStyle: getStyle,
      getValue: stockValue
    };
    vm.cols.push(outletCol);
  });

  _.forEach(vm.savorOutletCodes, outlet => {
    const outletCol = {
      field: outlet,
      title: outlet,
      sortable: outlet,
      filter: {
        [outlet]: 'number'
      },
      show: () => {
        return vm.data.currentView === 'stock' && vm.business === 'Savor' && (!_.get(vm.data, 'outlet') || vm.data.outlet.code === outlet) && vm.matchFilterByRegion(outlet);
      },
      getStyle: getStyle,
      getValue: numberValue
    };
    vm.cols.push(outletCol);
  });

  _.forEach(vm.depotOutletCodes, outlet => {
    const outletCol = {
      field: outlet,
      title: outlet,
      sortable: outlet,
      filter: {
        [outlet]: 'number'
      },
      show: () => {
        return vm.data.currentView === 'stock' && (!_.get(vm.data, 'outlet') || vm.data.outlet.code === outlet) && vm.matchFilterByRegion(outlet);
      },
      getStyle: getStyle,
      getValue: numberValue
    };
    vm.cols.push(outletCol);
  });

  _.forEach(_.concat(vm.extendedWarehouseCodes, vm.cropDepotOutletCodes, vm.packingOutletCodes), outlet => {
    const outletCol = {
      field: outlet,
      title: outlet,
      sortable: outlet,
      filter: {
        [outlet]: 'number'
      },
      show: () => {
        return vm.data.currentView === 'stock' && (!_.get(vm.data, 'outlet') || vm.data.outlet.code === outlet) && vm.matchFilterByRegion(outlet);
      },
      getStyle: getStyle,
      getValue: numberValue
    };
    vm.cols.push(outletCol);
  });

  const priceCol = {
    field: 'outletProductPrice',
    title: 'Price',
    sortable: 'outletProductPrice',
    filter: {
      outletProductPrice: 'number'
    },
    show: () => {
      return vm.data.outlet !== null;
    },
    getValue: numberValue
  };
  vm.cols.push(priceCol);
  const salePriceCol = {
    field: 'outletProductSalePrice',
    title: 'Sale Price',
    sortable: 'outletProductSalePrice',
    filter: {
      outletProductSalePrice: 'number'
    },
    show: () => {
      return vm.data.outlet !== null;
    },
    getValue: numberValue
  };
  vm.cols.push(salePriceCol);
  const totalCol = {
    field: 'Total',
    title: 'Total',
    sortable: 'total',
    filter: {
      total: 'number'
    },
    show: () => {
      return vm.data.currentView === 'stock' && !vm.data.outlet;
    },
    getValue: totalValue
  };
  vm.cols.push(totalCol);

  function caculateAvailableProduct() {
    let products = vm.data.products;

    if (vm.data.showAvailableSku && vm.data.currentView === 'stock' && vm.data.outlet) {
      products = _.filter(vm.data.products, product => _.get(product, `${vm.data.outlet.code}`, 0) > 0).sort((a, b) => a.description > b.description);
      vm.data.availableProducts = products;
    }

    vm.tableParams.settings({
      dataset: products
    });
    vm.tableParams.reload();
  }

  $scope.$watch(() => vm.data.outlet, () => {
    if (!_.get(vm.data, 'outlet.code', null)) {
      vm.data.outlet = null;
      vm.data.showAvailableSku = false;
    } else caculateAvailableProduct();
  });
  $scope.$watch(() => vm.data.showAvailableSku, () => caculateAvailableProduct());

  vm.productSearchSelected = product => {
    if (product) {
      vm.tableParams.filter().sku = product.sku;
    } else {
      delete vm.tableParams.filter()['sku'];
    }

    vm.data.product = product;
  };

  vm.viewProductAttributes = ProductService.viewProductAttributes;

  vm.exportFile = function (buyingType) {
    if (!vm.user.roles.includes('product:export') && !vm.user.roles.includes('admin')) {
      return FhdMessenger.error('Bạn không có quyền dùng chức năng này');
    }

    let products = _.filter(vm.data.products, product => {
      return _.get(product, 'sku', '').match(/B\d+/);
    });

    if (buyingType) {
      products = _.filter(products, product => {
        return product.toBuy === 'Buying';
      });
    }

    const stocks = _.map(products, function (product) {
      const row = {
        sku: product.sku,
        description: product.description,
        toBuy: product.toBuy
      };

      _.forEach(vm.extendedOutletCodes, outletCode => {
        _.assign(row, {
          [outletCode]: _.get(product, outletCode)
        });
      });

      return row;
    });

    const now = moment().startOf('day').format('YYYY-MM-DD');
    alasql(`SELECT * INTO XLSX("stocks-${now}.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [stocks]);
  };

  vm.printAvailableSku = () => {
    if (!_.get(vm.data, 'availableProducts.length')) {
      return FhdMessenger.error('Chưa chọn cơ sở');
    }

    JsPrintService.printElementById('available-sku-print');
  };

  vm.loadStockMap = function () {
    let onlyAbby = false;

    if (_.intersection(vm.user.roles, ['tro-ly', 'sale']).length && _.get(vm.user, 'outlet.code', '').match(/[SK]\d+/)) {
      onlyAbby = true;
    }

    const currentShift = CurrentShift.getCurrentShift();

    const userOutlet = _.get(vm.user, 'outlet', {});

    const outletCurrentShift = _.get(currentShift, 'outlet', undefined);

    if (angular.isUndefined(outletCurrentShift)) {
      vm.data.outlet = userOutlet;
    } else {
      vm.data.outlet = outletCurrentShift;
    }

    FhdMessenger.info('Đang tải');
    return StockMap.getStockMapWithProductInfo().then(async response => {
      vm.lastModified = response.lastModified;

      let products = _.filter(_.map(response._products, product => {
        product.toBuy = product.notBuying ? 'Stop' : 'Buying';
        const weight = ProductWeight.getWeight(_.get(product, 'description', ''));

        _.forEach(vm.extendedOutletCodes, outletCode => {
          const stock = _.get(product, outletCode, 0);

          const displayStock = _.get(product.outletMap, outletCode, 0);

          if (!product.deleted && product.toSell || !product.notBuying) {
            if (_.get(product, 'warehouseGroup.name') === 'Tủ đông') {
              if (_.get(product.stopSellMap, outletCode)) {
                vm.displayStockFreezerWeightMap[outletCode] = vm.displayStockFreezerWeightMap[outletCode] || 0;
                vm.displayStockFreezerWeightMap[outletCode] += displayStock * weight;
              }

              vm.currentStockFreezerWeightMap[outletCode] = vm.currentStockFreezerWeightMap[outletCode] || 0;
              vm.currentStockFreezerWeightMap[outletCode] += stock * weight;
            }

            if (_.get(product, 'warehouseGroup.name') === 'Tủ mát') {
              if (_.get(product.stopSellMap, outletCode)) {
                vm.displayStockCoolerWeightMap[outletCode] = vm.displayStockCoolerWeightMap[outletCode] || 0;
                vm.displayStockCoolerWeightMap[outletCode] += displayStock * weight;
              }

              vm.currentStockCoolerWeightMap[outletCode] = vm.currentStockCoolerWeightMap[outletCode] || 0;
              vm.currentStockCoolerWeightMap[outletCode] += stock * weight;
            }
          }
        });

        if (!_.get(product, 'tags.length')) {
          product.tags = '';
        } else {
          if (_.isString(product.tags)) {
            return;
          }

          product.tags = product.tags.join(',');
        }

        let outletProductPrice = {};
        let outletProductSalePrice = {};

        if (angular.isUndefined(outletCurrentShift)) {
          outletProductPrice = ProductService.getOutletProperty('price', userOutlet, product);
          outletProductSalePrice = ProductService.getOutletProperty('salePrice', userOutlet, product);
        } else {
          outletProductPrice = ProductService.getOutletProperty('price', outletCurrentShift, product);
          outletProductSalePrice = ProductService.getOutletProperty('salePrice', outletCurrentShift, product);
        }

        product.outletProductPrice = outletProductPrice;
        product.outletProductSalePrice = outletProductSalePrice;
        return product;
      }));

      if (onlyAbby) {
        products = _.reject(products, product => {
          return _.get(product, 'sku', '').match(/V\d+/);
        });
      }

      return products;
    }).then(products => {
      vm.data.products = products;
      vm.tableParams.settings({
        dataset: products
      });
      FhdMessenger.success('Đã tải xong');
      return products;
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.getTags = getProducts => getProducts.then(products => {
    return _.sortBy(_.compact(_.uniq(_.map(products, product => {
      return _.get(product, 'tag', '');
    }))));
  }).then(tags => _.map(tags, tag => ({
    id: tag,
    title: tag
  })));
}]);
"use strict";

/* eslint-disable angular/controller-as */
angular.module('stocks').controller('StocksController', ['$scope', '$stateParams', '$http', 'Authentication', 'Outlets', 'toaster', '$location', 'Stocks', 'ObjectId', 'FhdMessenger', 'NgTableParams', 'Products', 'ProductService', 'ProductCatService', 'hotkeys', 'OutletService', '$state', 'RolesService', 'StyleService', 'ValentineCategoriesService', 'TetCategoriesService', 'ProductWeight', '$window', '$timeout', 'StockService', '$localStorage', '$filter', 'OutletStockService', function ($scope, $stateParams, $http, Authentication, Outlets, toaster, $location, Stocks, ObjectId, FhdMessenger, NgTableParams, Products, ProductService, ProductCatService, hotkeys, OutletService, $state, RolesService, StyleService, ValentineCategoriesService, TetCategoriesService, ProductWeight, $window, $timeout, StockService, $localStorage, $filter, OutletStockService) {
  $scope.user = Authentication.user;

  $scope.permitRoles = function (roles) {
    if (!RolesService.hasRoles($scope.user, roles)) {
      $state.go('home');
    }
  };

  $scope.specialFilter = {
    description: {
      using: false,
      data: []
    },
    catman: {
      using: false,
      data: []
    }
  };
  $scope.ticket = {};
  $scope.data = {
    product: null,
    date: null,
    time: moment().second(0).milliseconds(0).toDate(),
    currentView: 'stock',
    tetCategories: TetCategoriesService.getTags(),
    cat: 'tet',
    withInTransit: false,
    productTSV: 'Nhấn vào nút Copy bảng để lấy dữ liệu...',
    tagProducts: ProductService.getAllProductsTagsFromServer(),
    inputDescriptionFilter: '',
    regions: [{
      id: 'NORTH',
      name: 'Bắc'
    }, {
      id: 'CENTRAL',
      name: 'Trung'
    }, {
      id: 'SOUTH',
      name: 'Nam'
    }, {
      id: '',
      name: '--Miền--'
    }],
    showOutlet: {
      NORTH: true,
      CENTRAL: true,
      SOUTH: true,
      DEPOT: true,
      EXTRADEPOT: false,
      CROPDEPOT: false,
      DG: false
    }
  };

  function intersectionBySku(arr1, arr2) {
    const skuArr1 = _.map(arr1, 'sku');

    const skuArr2 = _.map(arr2, 'sku');

    const skuIntersection = _.intersection(skuArr1, skuArr2);

    return _.filter($scope.stocks, product => {
      return _.includes(skuIntersection, product.sku);
    });
  }

  function mergeFilter(defaultData, withDefaultFilter) {
    const isUsingCatman = $scope.specialFilter.catman.using;
    const isUsingDescription = $scope.specialFilter.description.using;

    if (withDefaultFilter) {
      if (isUsingCatman) {
        return intersectionBySku(defaultData, $scope.specialFilter.catman.data);
      }

      if (isUsingDescription) {
        return intersectionBySku(defaultData, $scope.specialFilter.description.data);
      }
    }

    if (!isUsingDescription || !isUsingCatman) {
      return defaultData;
    }

    return intersectionBySku($scope.specialFilter.description.data, $scope.specialFilter.catman.data);
  }

  $scope.$watch(() => $scope.data.inputDescriptionFilter, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const originalText = $scope.data.inputDescriptionFilter;

    const hasSpecialFilter = _.includes(originalText, '*');

    if (hasSpecialFilter) {
      const splited = originalText.replace(/\s/g, '').split('*');

      const regexString = _.reduce(splited, (result, word) => {
        result += `(.*?)${word}`;
        return result;
      }, '');

      let matchDescription = _.filter($scope.stocks, stock => {
        return _.get(stock, 'description', '').replace(/\s/g, '').match(new RegExp(regexString, 'gi'));
      });

      $scope.specialFilter.description.data = matchDescription;
      $scope.specialFilter.description.using = true;
      $scope.tableParams.filter()['description'] = '';
      $scope.tableParams.settings({
        dataset: mergeFilter(matchDescription)
      });
    } else {
      $scope.specialFilter.description.using = false;
      $scope.tableParams.settings({
        dataset: mergeFilter($scope.stocks, true)
      });
      $scope.tableParams.filter()['description'] = originalText;
    }
  });
  $scope.$watch(() => $scope.data.cat, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    if (newValue !== 'tet') {
      $scope.tableParams.settings({
        dataset: $scope.stocks
      });
    }
  });
  $scope.$watch(() => $scope.data.categoryName, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    if (!newValue) {
      $scope.specialFilter.catman.using = false;
      $scope.tableParams.settings({
        dataset: mergeFilter($scope.stocks, true)
      });
    } else {
      const matchCategory = _.filter($scope.stocks, stock => {
        const catName = _.get(stock, 'tetCategory.name', '');

        return catName === newValue || catName.match(new RegExp(`^(${newValue})$`));
      });

      $scope.specialFilter.catman.data = matchCategory;
      $scope.specialFilter.catman.using = true;
      $scope.tableParams.settings({
        dataset: mergeFilter(matchCategory)
      });
    }
  });
  $scope.$watch(() => $scope.data.product, (newValue, oldValue) => {
    if (newValue === oldValue || !newValue) {
      return;
    }

    $scope.tableParams.filter().sku = newValue.sku;
  });

  $scope.loadOutlets = function () {
    OutletService.all().then(outlets => {
      const outletCodes = $scope.business === 'Savor' ? $scope.savorOutletCodes : $scope.extendedOutletCodes;
      return _.filter(outlets, outlet => {
        return _.includes(outletCodes, outlet.code);
      });
    }).then(outlets => {
      $scope.outlets = outlets;
    });
  };

  const isAdmin = _.includes(_.get($scope.user, 'roles'), 'admin') || _.includes(_.get($scope.user, 'roles'), 'investor') || _.includes(_.get($scope.user, 'roles'), 'accountant') || _.includes(_.get($scope.user, 'roles'), 'purchaser') || _.includes(_.get($scope.user, 'roles'), 'admin-merchandise');

  $scope.isAdmin = isAdmin;
  $scope.tableParams = new NgTableParams({
    filter: {
      isFood: '',
      isMooncake: '',
      toSell: '',
      toUse: '',
      publishWeb: ''
    }
  }, {});
  $scope.data.outlets = Outlets.query(function () {
    let defaultOutlet = null;

    if ($scope.user.outlet) {
      defaultOutlet = _.find($scope.data.outlets, {
        _id: $scope.user.outlet._id
      });
    }

    if (defaultOutlet) {
      $scope.ticket.outlet = defaultOutlet;
    } else {
      defaultOutlet = $scope.data.outlets[1];
    }
  });
  $scope.$watch(function () {
    return $scope.outlet;
  }, function (newValue, oldValue) {
    if (newValue === oldValue || !oldValue) {
      return;
    }

    $scope.tableParams.settings({
      dataset: _.find($scope.outletsWithStocks, function (outlet) {
        return outlet.outlet.code === newValue.code;
      }).stocks
    });
  });
  $scope.data.shifts = [{
    name: 'Sáng',
    code: 'S'
  }, {
    name: 'Chiều',
    code: 'C'
  }, {
    name: 'Tối',
    code: 'T'
  }];
  $scope.business = _.get($stateParams, 'business', 'Abby');
  $scope.category = {};

  const filterOutStocksByOutlet = function (stocks, outletCode) {
    const newStocks = _.filter(stocks, product => {
      return !isStopSell(product, outletCode) && isOutOfStock(product, outletCode);
    });

    return newStocks;
  };

  $scope.$watch(() => $scope.data.withInTransit, () => {
    if ($scope.data.outletCode) $scope.changeOutlet();
  });

  $scope.getTotalByRegion = function (region, type) {
    const valueTypeMap = {
      quantity: `${region.toLowerCase()}Total`,
      weight: `total${region}Weight`,
      inventoryValue: `${region.toLowerCase()}InventoryValue`
    };

    if ($scope.data.currentView !== 'stock') {
      return _.get($scope.summary, `total${region}DisplayStock`);
    }

    return _.get($scope.summary, valueTypeMap[type] + `${$scope.data.withInTransit ? '_inTransit' : ''}`);
  };

  $scope.filterProducts = function () {
    _.forEach($scope.tableParams.filter(), function (value, key) {
      delete $scope.tableParams.filter()[key];
    });
  };

  $scope.changeOutlet = function () {
    const newStocks = $scope.data.outletCode ? filterOutStocksByOutlet($scope.stocks, $scope.data.outletCode) : $scope.stocks;
    $scope.tableParams.settings({
      dataset: newStocks
    });
  };

  function isStopSell(product, outletCode) {
    return _.get(product.stopSellOutlets, outletCode, null);
  }

  function isOutOfStock(product, outletCode) {
    return $scope.data.withInTransit ? _.get(product, `${outletCode}_inTransit`, null) <= 0 : _.get(product, outletCode, null) <= 0;
  } // dynamic Table


  $scope.outletRegionMap = OutletStockService.outletRegionMap;
  $scope.abbyOutletCodes = OutletStockService.abbyOutletCodes;
  $scope.savorOutletCodes = OutletStockService.savorOutletCodes;
  $scope.depotOutletCodes = OutletStockService.depotOutletCodes;
  $scope.cropDepotOutletCodes = OutletStockService.cropDepotOutletCodes;
  $scope.packingOutletCodes = OutletStockService.packingOutletCodes;
  $scope.extendedWarehouseCodes = OutletStockService.extendedWarehouseCodes;
  $scope.extendedOutletCodes = OutletStockService.extendedOutletCodes;
  $scope.warehouseRestocks = _.sortBy($scope.depotOutletCodes.map(code => {
    return {
      code,
      name: code
    };
  }), 'code');

  if ($scope.business === 'Savor') {
    $scope.warehouseRestocks = ['B1', 'B2', 'B3'].map(code => {
      return {
        code,
        name: code
      };
    });
  }

  $scope.warehouseRestocks = _.concat($scope.warehouseRestocks, [{
    code: '',
    name: 'Tất cả'
  }]);

  $scope.matchFilterByType = outletCode => {
    if (outletCode.match(/([DG]\d+|KHO)/)) {
      if (_.includes($scope.cropDepotOutletCodes, outletCode)) {
        return $scope.data.showOutlet.CROPDEPOT;
      }

      if (_.includes($scope.packingOutletCodes, outletCode)) {
        return $scope.data.showOutlet.DG;
      }

      if (_.includes($scope.extendedWarehouseCodes, outletCode)) {
        return $scope.data.showOutlet.EXTRADEPOT;
      }

      return $scope.data.showOutlet.DEPOT;
    }

    const region = _.get($scope.outletRegionMap, outletCode);

    return _.get($scope.data.showOutlet, region);
  };

  function indexCol($scope, row, rowIndex) {
    return `<span>${rowIndex + 1}</span>`;
  }

  function getSkuCell($scope, row) {
    if ($scope.user.roles.includes('admin') || $scope.user.roles.includes('admin-merchandise')) {
      return `<a
        ng-click="editInventoryInfo(row)"
        >${row.sku}</a>`;
    }

    return `<span>${row.sku}</span>`;
  }

  function getDescriptionCell($scope, row) {
    if ($scope.user.roles.includes('admin') || $scope.user.roles.includes('admin-merchandise') || $scope.user.roles.includes('marketing')) {
      return `<a
        ng-click="editInfoInfo(row)"
        >${row.description}</a>`;
    }

    return `<span>${row.description}</span>`;
  }

  function getActionCell($scope, row) {
    return `<a ng-click="editDisplayStock(row)">
      Edit DS
    </a>`;
  }

  function numberValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field, '');

    return `<span>${$filter('number')(value, 0)}</span>`;
  }

  function getPriceValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field, 0);

    let html = '<span>';

    _.forEach($scope.data.regions, (region, index) => {
      if (index === 3) {
        return;
      }

      const regionPrice = _.get(row.regionPrice, region.id, 0);

      if (+regionPrice !== +value && regionPrice) {
        html += `<span ng-show="filterPriceByRegion === '${region.id}'">
          <s style="font-size: smaller;">${$filter('number')(value, 0)} </s> ${$filter('number')(regionPrice, 0)}</span>`;
      } else {
        html += `<span ng-show="filterPriceByRegion === '${region.id}'">${$filter('number')(value, 0)}</span>`;
      }
    });

    html += `<span ng-show="!filterPriceByRegion">${$filter('number')(value, 0)}</span></span>`;
    return html;
  }

  function normalValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${_.get(row, vm.field) || ''}</span>`;
  }

  function stockValue($scope, row) {
    const vm = this;
    const outletCode = vm.field;

    const normalStock = _.get(row, vm.field, ''); // product.M6


    const outletMap = _.get(row, 'outletMap', '');

    const outletMapCode = _.get(outletMap, outletCode); // product.outletMap.M6


    const outletInTransit = `${outletCode}_inTransit`;

    const stockInTransit = _.get(row, outletInTransit); // product.M6_inTransit


    const weightMap = _.get(row, 'weightMap');

    const valueWeightMap = _.get(weightMap, outletCode, ''); // product.weightMap.M6
    // show value of Savor


    if ($scope.savorOutletCodes.includes(outletCode) && $scope.business === 'Savor') {
      return `<div ng-if="${$scope.data.currentView === 'stock' && !$scope.data.withInTransit}">
              ${$filter('number')(normalStock, 0)}
            </div>
            <div ng-if="${$scope.data.currentView === 'stock' && $scope.data.withInTransit}">
            ${$filter('number')(stockInTransit, 0)}
            </div>`;
    } // show value of Abby


    let spanStart = `<span ng-show="${$scope.data.showAllCell || !!outletMapCode || !!normalStock}" ng-class="{
        'text-primary': ${!!outletMapCode && normalStock < 0},
        'text-blue': ${!!outletMapCode && normalStock <= 0.2}
      }">`;
    let spanEnd = `</span>`; // show value of Depot

    if ($scope.depotOutletCodes.includes(outletCode) || $scope.extendedWarehouseCodes.includes(outletCode)) {
      spanStart = `<span
        ng-class="{
        'text-primary': ${!row.notBuying && normalStock < 0},
        'text-blue': ${!row.notBuying && normalStock <= 0.2}
      }">`;
    }

    if ($scope.packingOutletCodes.includes(outletCode)) {
      spanStart = `<span
              ng-class="{
              'text-primary': ${!row.notBuying && normalStock < 0},
              'text-blue': ${!row.notBuying && normalStock <= 0.2}
            }">`;
    }

    let content = '';

    if ($scope.data.currentView === 'stock' && !$scope.data.withInTransit) {
      content = $filter('number')(normalStock, 0);
    }

    if ($scope.data.currentView === 'stock' && $scope.data.withInTransit) {
      content = $filter('number')(stockInTransit, 0);
    }

    if ($scope.data.currentView === 'displayStock') {
      content = $filter('number')(outletMapCode, 0);

      if ($scope.packingOutletCodes.includes(outletCode) || $scope.depotOutletCodes.includes(outletCode) || $scope.extendedWarehouseCodes.includes(outletCode)) {
        content = 'N/A';
      }
    }

    if ($scope.data.currentView === 'difStock') {
      content = $filter('number')($scope.difStock(normalStock, outletMapCode), 0);

      if ($scope.packingOutletCodes.includes(outletCode) || $scope.depotOutletCodes.includes(outletCode) || $scope.extendedWarehouseCodes.includes(outletCode)) {
        content = '';
      }
    }

    if ($scope.data.currentView === 'weight') {
      content = $filter('number')(valueWeightMap, 0);
    }

    return `${spanStart}${content}${spanEnd}`;
  }

  function getPercentProfit($scope, row) {
    const percent = row.profitPercentage;
    return `<span>${$filter('number')(percent, 0)}%</span>`;
  }

  function getSize(field) {
    switch (field) {
      case 'stt':
        return '20px';

      case 'description':
        return '200px';

      case 'sku':
        return '80px';

      default:
        return '20px';
    }
  }

  function getStyle(row) {
    const vm = this;
    const outlet = vm.field;
    const isPrimary = ['stt', 'sku', 'description'].includes(vm.field);

    if (isPrimary) {
      if (row.justEdited) {
        return {
          'background-color': '#ff0',
          'min-width': getSize(vm.field)
        };
      } else {
        return {
          'min-width': getSize(vm.field)
        };
      }
    }

    if (['M6', 'E12', 'E15', 'E16', 'E30', 'E31', 'E32', 'E33'].includes(outlet)) {
      return {
        'background-color': '#dbfa87'
      };
    }

    if (['E63', 'E64', 'E66'].includes(outlet)) {
      return {
        'background-color': '#7effe7'
      };
    }

    if ($scope.depotOutletCodes.includes(outlet)) {
      return {
        'background-color': '#f4ece8'
      };
    }

    if ($scope.extendedWarehouseCodes.includes(outlet)) {
      return {
        'background-color': '#75bd86'
      };
    }

    if ($scope.cropDepotOutletCodes.includes(outlet)) {
      return {
        'background-color': '#cdacc4'
      };
    }

    if ($scope.savorOutletCodes.includes(outlet)) {
      return {
        'background-color': '#7effe7'
      };
    }

    if ($scope.packingOutletCodes.includes(outlet)) {
      return {
        'background-color': '#f4ece8'
      };
    }

    if (vm.field === 'Vendor') {
      return {
        'text-align': 'right'
      };
    }
  }

  function buyingValue($scope, row) {
    if ($scope.data.currentView === 'stock' && !!row.buyingQuantity) {
      return `<span>${$filter('number')(row.buyingQuantity, 0)}</span>`;
    }

    if ($scope.data.currentView === 'weight' && !!row.weightMap['buying']) {
      return `<span>${$filter('number')(row.weightMap['buying'], 0)}</span>`;
    }
  }

  function processingValue($scope, row) {
    if ($scope.data.currentView === 'stock' && !!row.processingQuantity) {
      return `<span>${$filter('number')(row.processingQuantity, 0)}</span>`;
    }

    if ($scope.data.currentView === 'weight' && !!row.weightMap['processing']) {
      return `<span>${$filter('number')(row.weightMap['processing'], 0)}</span>`;
    }
  }

  function waitingValue($scope, row) {
    const vm = this;
    const field = vm.field;
    return `<span>${Math.round(_.get(row, field, 0) * 100) / 100}</span>`;
  }

  function totalValue($scope, row) {
    if ($scope.data.currentView === 'stock' && !$scope.data.withInTransit) {
      return `<span>${$filter('number')(row.total, 0)}</span>`;
    }

    if ($scope.data.currentView === 'stock' && $scope.data.withInTransit) {
      return `<span>${$filter('number')(row.total_inTransit, 0)}</span>`;
    }

    if ($scope.data.currentView === 'displayStock') {
      return `<span>${$filter('number')(row.totalDisplayStock, 0)}</span>`;
    }

    if ($scope.data.currentView === 'difStock') {
      return `<span>${$filter('number')($scope.difStock(row.total, row.totalDisplayStock), 0)}</span>`;
    }

    if ($scope.data.currentView === 'weight' && !$scope.data.withInTransit) {
      return `<span>${$filter('number')(row.weightMap['total'], 0)}</span>`;
    }

    if ($scope.data.currentView === 'weight' && $scope.data.withInTransit) {
      return `<span>${$filter('number')(row.weightMap['total_inTransit'], 0)}</span>`;
    }
  }

  function totalByRegionValue($scope, row) {
    const vm = this;
    const field = vm.field;
    let value;

    if ($scope.data.currentView === 'stock') {
      if ($scope.data.withInTransit) {
        value = _.get(row, `${field}_inTransit`, 0);
      } else {
        value = _.get(row, field, 0);
      }
    }

    if ($scope.data.currentView === 'displayStock') {
      value = _.get(row, `${field}DisplayStock`, 0);
    }

    if ($scope.data.currentView === 'difStock') {
      value = $scope.difStock(row[field], row[`${field}DisplayStock`]);
    }

    if ($scope.data.currentView === 'weight' && !$scope.data.withInTransit) {
      if ($scope.data.withInTransit) {
        value = row.weightMap[`${field}_inTransit`];
      } else {
        value = row.weightMap[field];
      }
    }

    return `<span>${$filter('number')(value, 0)}</span>`;
  }

  function valueOfValue($scope, row) {
    if (!$scope.data.withInTransit) {
      return `<span>${$filter('number')(row.inventoryValue, 0)}</span>`;
    }

    if ($scope.data.withInTransit) {
      return `<span>${$filter('number')(row.inventoryValue_inTransit, 0)}</span>`;
    }
  }

  function vendorCodeValue($scope, row) {
    return `<a ui-sref="viewVendor({vendorId: row.vendor._id})" target="_blank">${row.vendor.code}</a>`;
  }

  $scope.infoCols = [{
    field: 'stt',
    title: 'STT',
    show: true,
    renderAnimation: true,
    getValue: indexCol,
    getStyle: getStyle
  }, {
    field: 'sku',
    title: 'SKU',
    sortable: 'sku',
    filter: {
      sku: '/modules/stocks/template/input-sku-filter.client.template.html'
    },
    show: true,
    renderAnimation: true,
    getValue: getSkuCell,
    getStyle: getStyle
  }, {
    field: 'description',
    title: 'Description',
    sortable: 'description',
    filter: {
      description: '/modules/stocks/template/input-description-filter.client.template.html'
    },
    show: true,
    renderAnimation: true,
    getStyle: getStyle,
    getValue: getDescriptionCell
  }, {
    field: 'action',
    title: 'Action',
    show: () => {
      return _.includes($scope.user.roles, 'admin');
    },
    getValue: getActionCell
  }, {
    field: 'price',
    title: 'Price',
    sortable: 'price',
    filter: {
      price: 'number'
    },
    show: true,
    getValue: getPriceValue
  }, {
    field: 'cogs',
    title: 'COGS',
    sortable: 'cogs',
    filter: {
      cogs: 'number'
    },
    show: () => !$scope.hideCogs,
    getValue: numberValue
  }, {
    title: '%profit',
    sortable: 'profitPercentage',
    filter: {
      profitPercentage: 'number'
    },
    show: () => {
      return !$scope.hideCogs;
    },
    getValue: getPercentProfit
  }, {
    field: 'tag',
    title: 'Tag',
    sortable: 'tag',
    filter: {
      tag: 'select'
    },
    show: () => {
      return $scope.business === 'Abby';
    },
    filterData: $scope.data.tagProducts,
    getValue: normalValue
  }, {
    field: 'category.cat.name',
    title: 'Savor Cat',
    sortable: 'category.cat.name',
    filter: {
      'category.cat.name': 'select'
    },
    filterData: ProductCatService.getSavorCats,
    show: () => {
      return $scope.business === 'Savor';
    },
    getValue: normalValue
  }, {
    field: 'tetCategory.name',
    title: 'Cat Man',
    sortable: 'tetCategory.name',
    filter: {
      'tetCategory.name': '/modules/stocks/template/select-categories-filter.client.template.html'
    },
    filterData: $scope.data.tetCategories,
    show: () => {
      return $scope.business === 'Abby';
    },
    getValue: normalValue
  }, {
    field: 'warehouseRestock.code',
    title: 'Warehouse',
    sortable: 'warehouseRestock.code',
    filter: {
      'warehouseRestock.code': 'select'
    },
    filterData: _.map($scope.warehouseRestocks, warehouse => {
      return {
        id: warehouse.code,
        title: warehouse.code
      };
    }),
    show: () => {
      return $scope.business === 'Abby';
    },
    getValue: normalValue
  }, {
    field: 'note',
    title: 'Note',
    show: () => {
      return $scope.tableParams.filter().delayBuying === 'true';
    },
    getValue: normalValue
  }, {
    field: 'savorTag',
    title: 'Savor Tag',
    sortable: 'savorTag',
    filter: {
      savorTag: 'text'
    },
    show: () => {
      return $scope.business === 'Savor';
    },
    getValue: normalValue
  }];
  $scope.allOutletCodes = _.concat($scope.abbyOutletCodes, $scope.depotOutletCodes, $scope.extendedWarehouseCodes, $scope.cropDepotOutletCodes, $scope.packingOutletCodes); // show data column

  _.forEach($scope.allOutletCodes, outlet => {
    const outletInTransit = `${outlet}_inTransit`;
    const outletCol = {
      field: outlet,
      title: outlet,
      sortable: () => $scope.data.withInTransit ? outletInTransit : outlet,
      filter: {
        [outlet]: 'number'
      },
      show: () => {
        return $scope.business === 'Abby' && $scope.matchFilterByType(outlet);
      },
      getStyle: getStyle,
      getValue: stockValue
    };
    $scope.infoCols.push(outletCol);
  });

  _.forEach($scope.savorOutletCodes, outlet => {
    const outletInTransit = `${outlet}_inTransit`;
    const outletCol = {
      field: outlet,
      title: outlet,
      sortable: () => $scope.data.withInTransit ? outletInTransit : outlet,
      filter: {
        [outlet]: 'number'
      },
      show: () => {
        return $scope.business === 'Savor' && $scope.matchFilterByType(outlet);
      },
      getStyle: getStyle,
      getValue: stockValue
    };
    $scope.infoCols.push(outletCol);
  });

  const buyingCol = {
    field: 'Buying',
    title: 'Buying',
    sortable: () => $scope.data.currentView === 'stock' ? 'buyingQuantity' : 'weightMap.buying',
    filter: {
      total: 'number'
    },
    show: () => {
      return $scope.data.withInTransit;
    },
    getValue: buyingValue
  };
  const processingCol = {
    field: 'Processing',
    title: 'Processing',
    sortable: () => $scope.data.currentView === 'stock' ? 'processingQuantity' : 'weightMap.processing',
    filter: {
      total: 'number'
    },
    show: () => {
      return $scope.data.withInTransit;
    },
    getValue: processingValue
  };
  const northWaitingCol = {
    field: 'northWaiting',
    title: 'North Waiting',
    sortable: 'northWaiting',
    show: () => {
      return $scope.data.waitingValue;
    },
    filter: {
      northWaiting: 'number'
    },
    getValue: waitingValue
  };
  const southWaitingCol = {
    field: 'southWaiting',
    title: 'South Waiting',
    sortable: 'southWaiting',
    filter: {
      southWaiting: 'number'
    },
    show: () => {
      return $scope.data.waitingValue;
    },
    getValue: waitingValue
  };
  const totalCol = {
    field: 'total',
    title: 'Total',
    sortable: () => {
      if ($scope.data.currentView === 'weight') {
        return 'weightMap.total';
      } else {
        if ($scope.data.withInTransit) {
          return 'total_inTransit';
        } else return 'total';
      }
    },
    filter: {
      total: 'number'
    },
    show: true,
    getValue: totalValue
  };
  const northTotalCol = {
    field: 'northTotal',
    title: 'North Total',
    sortable: 'northTotal',
    filter: {
      northTotal: 'number'
    },
    show: true,
    getValue: totalByRegionValue
  };
  const southTotalCol = {
    field: 'southTotal',
    title: 'South Total',
    sortable: 'southTotal',
    filter: {
      southTotal: 'number'
    },
    show: true,
    getValue: totalByRegionValue
  };
  const valueCol = {
    field: 'Value',
    title: 'Value (Nghìn đồng)',
    sortable: () => $scope.data.withInTransit ? 'inventoryValue_inTransit' : 'inventoryValue',
    show: () => {
      return !$scope.showVendor && $scope.data.currentView === 'stock';
    },
    getValue: valueOfValue
  };
  const vendorCodeCol = {
    field: 'Vendor',
    title: 'Vendor',
    sortable: 'vendor.code',
    filter: {
      vendorText: 'text'
    },
    show: () => {
      return $scope.showVendor;
    },
    getStyle: getStyle,
    getValue: vendorCodeValue
  };
  $scope.cols = [...$scope.infoCols, buyingCol, processingCol, northWaitingCol, southWaitingCol, totalCol, northTotalCol, southTotalCol, valueCol, vendorCodeCol];

  $scope.find = function (showAll) {
    const query = {
      outlet: ObjectId.getObjectId($scope.outlet),
      business: $scope.business
    };

    if (_.get($scope.data, 'date') && $scope.checkPastData) {
      query.endDate = moment($scope.data.date).hours(moment($scope.data.time).hour()).minutes(moment($scope.data.time).minute()).format('YYYY-MM-DDTHH:mm');
    }

    $scope.waiting = true;

    if (!_.intersection($scope.user.roles, ['admin', 'current-stock:view-cogs']).length) {
      $scope.hideCogs = true;
    }

    $scope.stocks = Stocks.query(query, function (products) {
      const outlets = $scope.outlets;
      $scope.maxCoolerWeightMap = {};
      $scope.maxFreezerWeightMap = {};

      _.forEach(outlets, outlet => {
        const outletCode = outlet.code;
        const outletRegion = OutletService.getOutletRegion(outlet);

        const maxCoolerStorageWeight = _.get(outlet, 'maxCoolerStorageWeight', 0);

        $scope.maxCoolerWeightMap[outletCode] = maxCoolerStorageWeight;
        $scope.maxCoolerWeightMap['total'] = $scope.maxCoolerWeightMap['total'] || 0;
        $scope.maxCoolerWeightMap[outletRegion] = $scope.maxCoolerWeightMap[outletRegion] || 0;
        $scope.maxCoolerWeightMap['total'] += maxCoolerStorageWeight;
        $scope.maxCoolerWeightMap[outletRegion] += maxCoolerStorageWeight;

        const maxFreezerStorageWeight = _.get(outlet, 'maxFreezerStorageWeight', 0);

        $scope.maxFreezerWeightMap[outletCode] = maxFreezerStorageWeight;
        $scope.maxFreezerWeightMap['total'] = $scope.maxFreezerWeightMap['total'] || 0;
        $scope.maxFreezerWeightMap[outletRegion] = $scope.maxFreezerWeightMap[outletRegion] || 0;
        $scope.maxFreezerWeightMap['total'] += maxFreezerStorageWeight;
        $scope.maxFreezerWeightMap[outletRegion] += maxFreezerStorageWeight;
      });

      $scope.stocks = products;

      _.forEach($scope.stocks, function (product) {
        product.regionPrice = _.reduce(product.regionAttributes, (result, regionAttribute) => {
          result[regionAttribute.region] = _.get(regionAttribute, 'price', 0);
          return result;
        }, {});
        product.profitPercentage = Math.round((1 - product.cogs / product.price) * 100);
        const weight = ProductWeight.getWeight(_.get(product, 'description', ''));
        product.weightMap = {};

        const southWaiting = _.get(product, 'southWaiting', 0);

        const northWaiting = _.get(product, 'northWaiting', 0);

        const buyingQuantity = _.get(product, 'buyingQuantity', 0);

        const processingQuantity = _.get(product, 'processingQuantity', 0);

        _.forEach($scope.extendedOutletCodes, outletCode => {
          product.weightMap[outletCode] = weight * _.get(product, outletCode, 0);
        });

        product.weightMap['processing'] = weight * processingQuantity;
        product.weightMap['buying'] = weight * buyingQuantity;
        product.weightMap['total_inTransit'] = product.weightMap['total'] + product.weightMap['processing'] + product.weightMap['buying'];

        if (_.get(product, 'warehouseGroup.name') === 'Tủ đông') {
          product.condition = 'hàng lạnh tủ đông';
        } else if (_.get(product, 'warehouseGroup.name') === 'Tủ mát') {
          product.condition = 'hàng lạnh tủ mát';
        } else {
          product.condition = 'hàng khô';
        }

        product.isFood = ProductService.isFoodProduct(product);
        product.southTotal = getTotalByRegion(product, outlets, 'SOUTH') - southWaiting;
        product.northTotal = getTotalByRegion(product, outlets, 'NORTH') - northWaiting;
        product.southTotal_inTransit = getTotalByRegion(product, outlets, 'SOUTH', true) - southWaiting;
        product.northTotal_inTransit = getTotalByRegion(product, outlets, 'NORTH', true) - northWaiting;
        product.total = getTotal(product, outlets) - southWaiting - northWaiting;
        product.southTotalDisplayStock = getTotalByRegion(product.outletMap, outlets, 'SOUTH');
        product.northTotalDisplayStock = getTotalByRegion(product.outletMap, outlets, 'NORTH');
        product.totalDisplayStock = getTotal(product.outletMap, outlets);
        product.total_inTransit = _.reduce($scope.extendedOutletCodes, (result, outletCode) => {
          return _.get(product, `${outletCode}_inTransit`, 0) + result;
        }, 0) + buyingQuantity + processingQuantity - southWaiting - northWaiting;
        product.inventoryValue = Math.round(parseFloat(product.cogs || 0) * parseFloat(product.total || 0) / 1000);
        product.inventoryValue_inTransit = Math.round(parseFloat(product.cogs || 0) * parseFloat(product.total_inTransit || 0) / 1000);
        product.vendorText = `${_.get(product, 'vendor.code')} ${_.get(product, 'vendor.name')}`;
        product.rawType = product.isRaw && !product.toSell ? 'TRUE' : 'FALSE';
        product.delayBuying = _.get(product, 'regionAttributes.length') && _.every(product.regionAttributes, {
          delayBuying: true
        });

        if (product.delayBuying) {
          product.note = moment(_.head(product.regionAttributes).expectedBuyingDate).format('YYYY-MM-DD');
        }

        if ($scope.business === 'Savor') {
          product.warehouseRestock = getWarehouseRestockByTags(product);
        }
      });

      $scope.tableParams.settings({
        dataset: $scope.stocks
      });
      $scope.tableParams.sorting({
        sku: 'asc'
      });

      if ($scope.business === 'Savor') {
        $scope.tableParams.filter()['sku'] = 'V';
      }

      $scope.waiting = false;
    }, function (err) {
      FhdMessenger.errorFromServer(err);
      $scope.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tính số lượng hàng tồn...', $scope.stocks.$promise, () => {
      FhdMessenger.success('Đã tính xong.'); // for test
      // $localStorage.setObject('vmstocks', _.take($scope.stocks, 500))
    });
    return $scope.stocks.$promise;
  };

  function getWarehouseRestockByTags(product) {
    let tags = product.tags || [];

    if (tags.includes('Restock B1') || tags.includes('SX 5h')) {
      return {
        code: 'B1'
      };
    }

    if (tags.includes('Restock B2')) {
      return {
        code: 'B2'
      };
    }

    if (tags.includes('Restock B3')) {
      return {
        code: 'B3'
      };
    }

    return null;
  }

  $scope.exportFile = function (fileType) {
    let outletCodes = $scope.business === 'Savor' ? $scope.savorOutletCodes : $scope.allOutletCodes;

    const stocks = _.map($scope.stocks, function (product) {
      const row = {
        sku: product.sku,
        description: product.description,
        price: product.price,
        salePrice: product.salePrice,
        cogs: product.cogs,
        tag: product.tag || '',
        warehouseGroup: _.get(product, 'warehouseGroup.name')
      };

      if (fileType === 'restock') {
        _.forEach(outletCodes, outletCode => {
          const displayStock = _.get(product, `outletMap.${outletCode}`);

          if (!_.isNumber(displayStock)) {
            return _.assign(row, {
              [outletCode]: ''
            });
          }

          const currentStock = _.get(product, outletCode) || 0;
          const restockQuantity = displayStock - currentStock;

          _.assign(row, {
            [outletCode]: restockQuantity > 0 ? restockQuantity : 0
          });
        });
      } else {
        _.forEach(outletCodes, outletCode => {
          _.assign(row, {
            [outletCode]: _.get(product, outletCode)
          });
        });
      }

      return row;
    });

    const now = moment().startOf('day').format('YYYY-MM-DD');
    alasql(`SELECT * INTO XLSX("stocks-${now}.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [stocks]);
  };

  $scope.orderItems = []; // Date stuff //

  $scope.open = function ($event) {
    $event.preventDefault();
    $event.stopPropagation();
    $scope.opened = true;
  };

  $scope.dateOptions = {
    formatYear: 'yy',
    startingDay: 1
  };
  $scope.minDate = '2015-05-01';

  function setHighlightForSkuEdited(product) {
    const stock = _.find($scope.stocks, stock => {
      return stock.sku === product.sku;
    });

    stock.justEdited = true;
    stock.renderAnimation = true;
  }

  $scope.editInventoryInfo = product => {
    ProductService.quickEditProduct(product).then(_product => {
      return setHighlightForSkuEdited(_product);
    });
  };

  $scope.editInfoInfo = product => {
    ProductService.quickEditProductAttributes(product).then(_product => {
      return setHighlightForSkuEdited(_product);
    });
  };

  $scope.getTags = getProducts => getProducts.then(products => _.sortBy(_.compact(_.uniq(_.map(products, product => product.tag))))).then(tags => _.map(tags, tag => ({
    id: tag,
    title: tag
  })));

  $scope.switchView = function () {
    if ($scope.data.currentView === 'stock') {
      $scope.data.currentView = 'displayStock';
    } else {
      $scope.data.currentView = 'stock';
    }
  };

  const getWeight = ProductWeight.getWeight;

  function getTotalByRegion(object, outlets, region, inTrasit) {
    const matchOutlets = _.filter(outlets, outlet => {
      const outletRegion = OutletService.getOutletRegion(outlet);
      return outletRegion === region;
    });

    const total = _.sumBy(matchOutlets, outlet => {
      return object[`${outlet.code}${inTrasit ? '_inTransit' : ''}`] || 0;
    });

    return total;
  }

  function getTotal(object, outlets) {
    const total = _.sumBy(outlets, outlet => {
      return object[outlet.code] || 0;
    });

    return total;
  }

  $scope.$watch(() => $scope.tableParams.data, function (tableRows, oldValue) {
    if (tableRows === oldValue) return;
    let outlets = $scope.outlets;

    const outletCodes = _.filter(_.map(outlets, 'code'), $scope.matchFilterByType);

    outlets = _.filter($scope.outlets, outlet => {
      if ([...$scope.packingOutletCodes, ...$scope.extendedWarehouseCodes].includes(outlet.code) && !$scope.data.showOutlet.EXTRADEPOT && !$scope.data.showOutlet.DG) {
        return false;
      }

      return outletCodes.includes(outlet.code);
    });

    const summary = _.reduce(outlets, (result, outlet) => {
      result[outlet.code] = _.sumBy(tableRows, outlet.code);
      result[`${outlet.code}_inTransit`] = _.sumBy(tableRows, `${outlet.code}_inTransit`);
      return result;
    }, {});

    summary.buying = _.sumBy(tableRows, 'buyingQuantity') || 0;
    summary.processing = _.sumBy(tableRows, 'processingQuantity') || 0;
    summary.northWaiting = _.sumBy(tableRows, 'northWaiting') || 0;
    summary.southWaiting = _.sumBy(tableRows, 'southWaiting') || 0;
    summary.totalWaiting = summary.northWaiting + summary.southWaiting;
    summary.total = getTotal(summary, outlets) - summary.totalWaiting;
    summary.southTotal = getTotalByRegion(summary, outlets, 'SOUTH') - summary.southWaiting;
    summary.northTotal = getTotalByRegion(summary, outlets, 'NORTH') - summary.northWaiting;
    summary.southTotal_inTransit = getTotalByRegion(summary, outlets, 'SOUTH', true) - summary.southWaiting;
    summary.northTotal_inTransit = getTotalByRegion(summary, outlets, 'NORTH', true) - summary.northWaiting;
    summary.total_inTransit = _.reduce(outlets, (result, outlet) => {
      return result + (summary[`${outlet.code}_inTransit`] || 0);
    }, 0) + summary.buying + summary.processing - summary.totalWaiting;
    summary.inventoryValue = _.sumBy(tableRows, tableRow => {
      return (tableRow.total || 0) * tableRow.cogs / 1000;
    });
    summary.northInventoryValue = _.sumBy(tableRows, tableRow => {
      return (tableRow.northTotal || 0) * tableRow.cogs / 1000;
    });
    summary.southInventoryValue = _.sumBy(tableRows, tableRow => {
      return (tableRow.southTotal || 0) * tableRow.cogs / 1000;
    });
    summary.inventoryValue_inTransit = _.sumBy(tableRows, tableRow => {
      return (tableRow.total_inTransit || 0) * tableRow.cogs / 1000;
    });
    summary.northInventoryValue_inTransit = _.sumBy(tableRows, tableRow => {
      return (tableRow.northTotal_inTransit || 0) * tableRow.cogs / 1000;
    });
    summary.southInventoryValue_inTransit = _.sumBy(tableRows, tableRow => {
      return (tableRow.southTotal_inTransit || 0) * tableRow.cogs / 1000;
    });
    summary.valueMap = _.reduce(tableRows, (result, tableRow) => {
      const cogs = _.get(tableRow, 'cogs', 0);

      _.forEach(outlets, outlet => {
        const outletCode = outlet.code;
        result[outletCode] = result[outletCode] || 0;
        result[outletCode] += cogs * _.get(tableRow, outletCode, 0) / 1000;
        result[`${outletCode}_inTransit`] = result[`${outletCode}_inTransit`] || 0;
        result[`${outletCode}_inTransit`] += cogs * _.get(tableRow, `${outletCode}_inTransit`, 0) / 1000;
        result[`buying`] = cogs * _.get(tableRow, `buyingQuantity`, 0) / 1000;
        result[`processing`] = cogs * _.get(tableRow, `processingQuantity`, 0) / 1000;
      });

      return result;
    }, {});
    summary.weightMap = _.reduce(tableRows, (result, tableRow) => {
      const weight = getWeight(tableRow.description);
      result[`buying`] = result[`buying`] || 0;
      result[`processing`] = result[`processing`] || 0;
      result[`buying`] += weight * _.get(tableRow, `buyingQuantity`, 0);
      result[`processing`] += weight * _.get(tableRow, `processingQuantity`, 0);

      _.forEach(outlets, outlet => {
        const outletCode = outlet.code;
        result[outletCode] = result[outletCode] || 0;
        result[outletCode] += weight * _.get(tableRow, outletCode, 0);
        result[`${outletCode}_inTransit`] = result[`${outletCode}_inTransit`] || 0;
        result[`${outletCode}_inTransit`] += weight * _.get(tableRow, `${outletCode}_inTransit`, 0);
      });

      return result;
    }, {});
    summary.totalWeight = _.sumBy(tableRows, tableRow => {
      const weight = getWeight(tableRow.description);
      return (tableRow.total || 0) * weight;
    }, 0);
    summary.totalSouthWeight = _.sumBy(tableRows, tableRow => {
      const weight = getWeight(tableRow.description);
      return (tableRow.southTotal || 0) * weight;
    }, 0);
    summary.totalNorthWeight = _.sumBy(tableRows, tableRow => {
      const weight = getWeight(tableRow.description);
      return (tableRow.northTotal || 0) * weight;
    }, 0);
    summary.totalWeight_inTransit = _.sumBy(tableRows, tableRow => {
      const weight = getWeight(tableRow.description);
      return (tableRow.total_inTransit || 0) * weight;
    }, 0);
    summary.totalNorthWeight_inTransit = _.sumBy(tableRows, tableRow => {
      const weight = getWeight(tableRow.description);
      return (tableRow.northTotal_inTransit || 0) * weight;
    }, 0);
    summary.totalSouthWeight_inTransit = _.sumBy(tableRows, tableRow => {
      const weight = getWeight(tableRow.description);
      return (tableRow.southTotal_inTransit || 0) * weight;
    }, 0); // Display Stock

    $scope.summary = summary;
  });

  $scope.difStock = function (stock, displayStock) {
    return stock - displayStock;
  };

  $scope.copyProductTSV = () => {
    let outletCodes = $scope.business === 'Savor' ? $scope.savorOutletCodes : $scope.allOutletCodes;
    const currentView = $scope.data.currentView;
    const withInTransit = $scope.data.withInTransit;
    const headers = ['STT', 'SKU', 'Description', 'Price', 'COGS', 'WarehouseRestock', 'CatMan', 'Buying', ...outletCodes, 'Buying', 'Processing', 'northWaiting', 'southWaiting', 'total', 'northTotal', 'southTotal'].join('\t');
    const products = $scope.stocks.map((product, index) => {
      let numbers = outletCodes.map(outletCode => {
        const outletMapCode = _.get(product, `outletMap.${outletCode}`, 0);

        switch (currentView) {
          case 'stock':
            const hideStock = $scope.hideStockNotToSell && outletCode.match(/[ME]\d+/) && !outletMapCode;

            if (withInTransit) {
              if (hideStock) {
                return '';
              }

              return _.get(product, `${outletCode}_inTransit`, 0);
            }

            if (hideStock) {
              return '';
            }

            return _.get(product, `${outletCode}`, 0);

          case 'displayStock':
            return outletMapCode;

          case 'difStock':
            return $scope.difStock(product[outletCode], product.outletMap[outletCode]);

          case 'weight':
            return _.get(product`weightMap.${outletCode}`, 0);

          default:
            return '';
        }
      });
      const buying = $scope.data.withInTransit ? $scope.data.currentView === 'stock' ? product.buyingQuantity || 0 : $scope.data.currentView === 'weight' ? product.weightMap['buying'] || 0 : '' : '';
      const processing = $scope.data.withInTransit ? $scope.data.currentView === 'stock' ? product.processingQuantity || 0 : $scope.data.currentView === 'weight' ? product.weightMap['processing'] || 0 : '' : '';

      const total = _.sum([...numbers, buying, processing, -product.southWaiting, -product.northWaiting]);

      const warehouseRestock = _.get(product.warehouseRestock, 'code', '');

      const catman = _.get(product.tetCategory, 'name', '');

      numbers = _.map(numbers, number => {
        return number === 0 ? ' ' : number;
      });
      const fields = [index + 1, product.sku, product.description, product.salePrice || product.price, product.cogs, warehouseRestock, catman, product.notBuying ? 'Stop' : 'Buying', ...numbers, buying, processing, product.northWaiting, product.southWaiting, total, product.northTotal, product.southTotal];
      return fields.join('\t');
    });
    $scope.data.productTSV = headers + '\n' + products.join('\n');
    const copyText = $window.document.getElementById('productsCSV');
    $timeout(() => {
      /* Select the text field */
      copyText.select();
      /* Copy the text inside the text field */

      $window.document.execCommand('copy');
      FhdMessenger.success('Đã copy'); // $timeout(() => {
      //   $scope.data.productTSV = 'Nhấn vào nút Copy bảng để lấy dữ liệu...'
      // }, 2000)
    }, 2000);
  };

  $scope.editDisplayStock = product => {
    StockService.openEditDisplaySockModal(product).then(_product => {
      return setHighlightForSkuEdited(_product);
    });
  };

  hotkeys.bindTo($scope).add({
    combo: 'ctrl+d',
    description: 'Toggle View Mode',
    callback: $scope.switchView
  });
}]);
"use strict";

/* eslint-disable angular/controller-as */
angular.module('stocks').filter('filterCats', [function () {
  return function (cats, viewValue, catSearch) {
    const lowerCaseViewValue = viewValue.toLowerCase();

    const matchCat = _.find(cats, cat => {
      return cat.id.toLowerCase() === lowerCaseViewValue;
    });

    if (matchCat) {
      return [matchCat];
    }

    if (catSearch && viewValue !== catSearch) {
      return _.filter(cats, cat => {
        return cat.id.toLowerCase().includes(lowerCaseViewValue);
      });
    }

    return cats;
  };
}]).directive('fhdCategoryInput', [function () {
  return {
    templateUrl: '/modules/stocks/template/fhd-categories-input.client.template.html',
    restrict: 'E',
    scope: {
      tag: '=?',
      tags: '=?',
      labelColumn: '@',
      label: '@',
      hasRemoveButton: '=?',
      loadDefaultUser: '=?',
      onChange: '=?'
    },
    controller: 'FhdCategoryInputController',

    compile(tElm, tAttrs) {
      const fhdTypeaheadElm = tElm.find('fhd-typeahead');
      if (!tAttrs.staff) fhdTypeaheadElm.removeAttr('fhd-item');
      return {
        post(scope, element) {
          if (scope.labelColumn) {
            const labelElm = element.find('label');
            const inputElm = element.find('fhd-controls');
            labelElm.addClass(`col-sm-${scope.labelColumn}`);
            inputElm.addClass(`col-sm-${12 - scope.labelColumn}`);
          }
        }

      };
    },

    replace: true
  };
}]).controller('FhdCategoryInputController', ['$scope', 'FhdMessenger', 'Authentication', 'TetCategoriesService', function ($scope, FhdMessenger, Authentication, TetCategoriesService) {
  $scope.data = {};
  TetCategoriesService.getTags().then(tags => {
    $scope.data.tags = tags;
  });

  $scope.tagSearchSelected = item => {
    $scope.tag = item.id;
  };

  $scope.$watch('category', (newValue, oldValue) => {
    if (!_.trim(newValue) && $scope.tag) {
      $scope.tag = null;
    }
  });
}]);
"use strict";

angular.module('stocks').factory('OutletStockService', [function () {
  const outletRegionMap = {
    M6: 'SOUTH',
    E12: 'SOUTH',
    E15: 'SOUTH',
    E16: 'SOUTH',
    E30: 'SOUTH',
    E31: 'SOUTH',
    E32: 'SOUTH',
    E33: 'SOUTH',
    E63: 'NORTH',
    E64: 'NORTH',
    E66: 'NORTH',
    M1: 'NORTH',
    M2: 'NORTH',
    E1: 'NORTH',
    E5: 'NORTH',
    E6: 'NORTH',
    E7: 'NORTH',
    E8: 'NORTH',
    E9: 'NORTH',
    E11: 'NORTH',
    E13: 'NORTH',
    E14: 'NORTH',
    E17: 'NORTH',
    E18: 'NORTH',
    E19: 'NORTH',
    E20: 'NORTH',
    E22: 'NORTH',
    E24: 'NORTH',
    E26: 'NORTH',
    E27: 'NORTH',
    E28: 'NORTH',
    E69: 'NORTH',
    E0: 'NORTH',
    B1: 'NORTH',
    B2: 'NORTH',
    B3: 'NORTH',
    B4: 'NORTH',
    D2: 'NORTH',
    D4: 'NORTH',
    D5: 'NORTH',
    D6: 'SOUTH',
    D3: 'NORTH',
    D7: 'NORTH',
    D8: 'NORTH',
    D10: 'NORTH',
    D11: 'NORTH',
    D1: 'NORTH',
    KHOVH: 'NORTH',
    KHOVN: 'NORTH',
    KHOGL: 'NORTH',
    G1: 'NORTH',
    G2: 'NORTH',
    G3: 'NORTH',
    G4: 'SOUTH',
    G5: 'SOUTH',
    G7: 'SOUTH',
    G8: 'SOUTH',
    G9: 'SOUTH',
    S1: 'NORTH',
    S2: 'NORTH',
    S4: 'NORTH',
    S6: 'NORTH',
    S7: 'NORTH',
    S8: 'NORTH',
    S10: 'NORTH',
    S11: 'NORTH',
    S12: 'NORTH',
    S13: 'NORTH',
    S14: 'NORTH',
    S16: 'NORTH',
    S17: 'NORTH',
    S18: 'NORTH',
    S19: 'NORTH'
  };
  const specialExtendedWarehouseCodes = []; // ['D1']

  const cropDepotOutletCodes = ['D3', 'D7', 'D8', 'D10', 'D11'];

  const notMainWarehouseCodes = _.concat(specialExtendedWarehouseCodes, cropDepotOutletCodes);

  const outletCodes = _.keys(outletRegionMap);

  const southOutletCodes = _.reduce(outletCodes, (result, outletCode) => {
    if (outletRegionMap[outletCode] === 'SOUTH') {
      result.push(outletCode);
    }

    return result;
  }, []);

  const centralOutletCodes = _.reduce(outletCodes, (result, outletCode) => {
    if (outletRegionMap[outletCode] === 'CENTRAL') {
      result.push(outletCode);
    }

    return result;
  }, []);

  const abbyOutletCodes = _.filter(outletCodes, outletCode => {
    return outletCode.match(/[ME]\d+/);
  });

  const savorOutletCodes = _.filter(outletCodes, outletCode => {
    return outletCode.match(/[SB]\d+/) || ['SS', 'E18'].includes(outletCode);
  });

  const depotOutletCodes = _.filter(outletCodes, outletCode => {
    return outletCode.match(/[D]\d+/) && !notMainWarehouseCodes.includes(outletCode);
  });

  const packingOutletCodes = _.filter(outletCodes, outletCode => {
    return outletCode.match(/[G]\d+/);
  });

  const extendedWarehouseCodes = _.filter(outletCodes, outletCode => {
    return outletCode.match(/KHO/) || specialExtendedWarehouseCodes.includes(outletCode);
  });

  const abbyAndDepotOutletCodes = [...abbyOutletCodes, ...depotOutletCodes];
  const extendedOutletCodes = [...abbyAndDepotOutletCodes, ...extendedWarehouseCodes, ...cropDepotOutletCodes, ...packingOutletCodes];
  return {
    outletRegionMap,
    abbyOutletCodes,
    savorOutletCodes,
    depotOutletCodes,
    packingOutletCodes,
    extendedWarehouseCodes,
    abbyAndDepotOutletCodes,
    extendedOutletCodes,
    cropDepotOutletCodes,
    southOutletCodes,
    centralOutletCodes
  };
}]);
"use strict";

angular.module('stocks').factory('StockMap', ['$http', 'FhdMessenger', 'OutletService', function ($http, FhdMessenger, OutletService) {
  function fetchStockMapCache() {
    let promise = $http.get('/stock-map-cache').then(response => response.data).then(data => {
      return data;
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải hàng tồn được cache mỗi 15 phút...', promise, () => {
      FhdMessenger.success('Tải xong hàng tồn');
    });
    return promise;
  }

  function fetchStockMapWithProductInfo() {
    let promise = $http.get('/stock-map-with-product-info').then(response => response.data).then(data => {
      FhdMessenger.success('Tải xong hàng tồn');
      return data;
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải hàng tồn...', promise, () => {
      FhdMessenger.success('Tải xong hàng tồn');
    });
    return promise;
  }

  function fetchDisplayStock() {
    return $http.get('/display-stock-map').then(response => response.data);
  }

  return {
    getWarehouseTotalStockMap() {
      return Promise.all([fetchStockMapCache(), OutletService.getOutletCodes()]).then(([stockMap, outletCodes]) => {
        const {
          DEPOT_OUTLET_CODES,
          KITCHEN_OUTLET_CODES
        } = outletCodes;

        const OUTLET_CODES = _.concat(DEPOT_OUTLET_CODES, KITCHEN_OUTLET_CODES);

        return _.reduce(stockMap, (result, productStock, productId) => {
          const warehouseStock = _.sumBy(OUTLET_CODES, warehouseCode => {
            return _.get(productStock, warehouseCode, 0);
          });

          result[productId] = _.assignIn(productStock, {
            warehouseStock
          });
          return result;
        }, {});
      });
    },

    getStockMapCache() {
      return fetchStockMapCache();
    },

    getStockMapWithProductInfo() {
      return fetchStockMapWithProductInfo();
    },

    getDisplayStockMap() {
      return fetchDisplayStock();
    }

  };
}]);
'use strict';

