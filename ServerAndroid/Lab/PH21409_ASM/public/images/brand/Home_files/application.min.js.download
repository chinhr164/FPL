angular.module('outlets').controller('ModalEditProcessorsController', ['outletId', 'Authentication', 'Outlets', 'ObjectId', '$location', 'FhdMessenger', '$modalInstance', function (outletId, Authentication, Outlets, ObjectId, $location, FhdMessenger, $modalInstance) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {};
  vm.outletId = outletId;
  vm.outlet = Outlets.get({
    outletId: vm.outletId
  });

  vm.removeValueFromArray = function (array, index) {
    array.splice(index, 1);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.update = function (outlet) {
    outlet.$updateProcessors(function () {
      FhdMessenger.success('Cập nhật người phụ trách thành công');
      $modalInstance.close();
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  };
}]);
"use strict";

angular.module('outlets').controller('ModalEditShiftsController', ['helper', 'outletId', 'Authentication', 'Outlets', 'ObjectId', '$location', 'FhdMessenger', '$modalInstance', function (helper, outletId, Authentication, Outlets, ObjectId, $location, FhdMessenger, $modalInstance) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {};
  vm.outletId = outletId;
  vm.removeValueFromArray = helper.removeValueFromArray; // Find existing Outlet

  vm.addShift = () => {
    vm.outlet.shifts = vm.outlet.shifts || [];

    const matchShift = _.find(vm.outlet.shifts, {
      shift: vm.shift.code
    });

    if (matchShift) {
      return FhdMessenger.error('Đã có ca trực này rồi');
    }

    vm.outlet.shifts.push({
      shift: vm.shift.code
    });
    return FhdMessenger.success('Thêm thành công');
  };

  vm.init = function () {
    vm.outlet = Outlets.get({
      outletId: vm.outletId
    });
    vm.restockTime = null;
    vm.outlet.$promise.then(() => {
      _.forEach(vm.outlet.shifts, shift => {
        shift.startTime = moment(shift.startTime).toDate();
        shift.endTime = moment(shift.endTime).toDate();
      });

      vm.lastUserEdit = _.get(_.last(vm.outlet.shiftsHistorical), 'user');
      vm.lastTimeEdit = _.get(_.last(vm.outlet.shiftsHistorical), 'time');
    });
  };

  vm.caculateTime = function () {
    if (vm.outlet) {
      vm.outlet.shifts.forEach(shift => {
        shift.hours = helper.calculateDiffHours(shift.startTime, shift.endTime);
      });
    } else {
      vm.shifts.forEach(shift => {
        shift.hours = helper.calculateDiffHours(shift.startTime, shift.endTime);
      });
    }
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.update = function (outlet) {
    outlet.$updateShifts(function () {
      FhdMessenger.success('Cập nhật giờ ca trực thành công');
      $modalInstance.close();
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  };
}]);
'use strict'; // Outlets controller

angular.module('outlets').controller('OutletsController', ['$stateParams', '$state', '$location', '$timeout', 'Authentication', 'WorkDepartmentService', 'BusinessService', 'CustomerService', 'Outlets', 'OutletService', 'JsPrintService', 'NgTableParams', 'FhdMessenger', 'Address', function ($stateParams, $state, $location, $timeout, Authentication, WorkDepartmentService, BusinessService, CustomerService, Outlets, OutletService, JsPrintService, NgTableParams, FhdMessenger, Address) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  BusinessService.allAsync().then(businesses => {
    vm.data.businesses = businesses;
  });
  WorkDepartmentService.allAsync().then(workDepartments => {
    vm.data.workDepartments = workDepartments;
  });
  vm.data.districts = _.map(Address.getDistricts(), address => {
    // Bỏ hậu tố (Nội thành) và (Ngoại thành)
