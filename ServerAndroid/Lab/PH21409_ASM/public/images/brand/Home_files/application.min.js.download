angular.module('core').controller('WidgetController', ['Authentication', '$window', '$document', 'EnvironmentService', function (Authentication, $window, $document, EnvironmentService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  const [BASE_URL, token] = EnvironmentService.getChatwootCredentials();

  vm.loadWidget = () => {
    if (!vm.user) {
      return;
    }

    const widget = $document[0].querySelector('#widget');
    const script = $document[0].createElement('script');
    script.setAttribute('id', 'load-widget');
    const s = $document[0].getElementsByTagName('script')[0];
    script.src = BASE_URL + '/packs/js/sdk.js';
    s.parentNode.insertBefore(script, s);

    script.onload = function () {
      window.chatwootSettings = {
        hideMessageBubble: true,
        position: 'left',
        locale: 'vi',
        type: 'standard',
        showPopoutButton: true
      };
      window.chatwootSDK.run({
        websiteToken: token,
        baseUrl: BASE_URL
      });
    };

    widget.append(script);
  };
}]);
