angular.module('sale-entries').controller('ModalFindCustomerRequestController', ['$modalInstance', 'Authentication', 'FhdMessenger', 'Outlet', 'SaleEntryService', 'CustomerRequests', function ($modalInstance, Authentication, FhdMessenger, Outlet, SaleEntryService, CustomerRequests) {
  const vm = this;
  vm.currentOutlet = Outlet;
  vm.user = Authentication.user;
  vm.customerRequest = {};
  vm.isValid = false;
  vm.waiting = false;

  vm.find = crCode => {
    if (crCode.match(/\D+/)) {
      return FhdMessenger.error('Mã Customer Request chỉ chứa số');
    }

    vm.waiting = true;
    CustomerRequests.findByCode({
      code: crCode
    }).$promise.then(response => {
      vm.customerRequest = response;

      if (!vm.customerRequest.customerRequestId) {
        return FhdMessenger.error('Không tìm thấy Customer Request tương ứng');
      }

      if (vm.customerRequest.outlet.code !== _.get(vm.currentOutlet, 'code', null)) {
        return FhdMessenger.error('Không được phép tạo đơn hàng từ Customer Request được tạo từ cơ sở khác');
      }

      vm.customerRequest.totalDeposit = _.reduce(vm.customerRequest.deposits, (result, deposit) => {
        result += deposit.amount;
        return result;
      }, 0);

      if (vm.customerRequest.totalDeposit === 0) {
        return FhdMessenger.error('Customer Request không có tiền khách đặt trước');
      }

      if (vm.customerRequest.saleEntry) {
        return FhdMessenger.error('CR này đã tạo Sale Entry');
      }

      vm.isValid = true;
    }).catch(err => {
      FhdMessenger.error(err.message);
    }).finally(vm.waiting = false);
  };

  vm.confirm = () => {
    if (vm.isValid) {
      FhdMessenger.success('OK');
      return $modalInstance.close({
        success: true,
        customerRequest: vm.customerRequest
      });
    }

    FhdMessenger.error('Customer Request không hợp lệ');
    vm.close();
  };

  vm.close = () => $modalInstance.close({
    success: false
  });
}]);
'use strict';

angular.module('sale-entries').controller('ModalListSaleEntriesController', ['$scope', 'CustomerService', 'cellphone', 'SaleEntryService', 'Customers', 'FhdMessenger', function ($scope, CustomerService, cellphone, SaleEntryService, Customers, FhdMessenger) {
  const vm = $scope;

  function sum(items, path) {
    return _.reduce(items, (result, item) => {
      return _.get(item, path, 0) + result;
    }, 0);
  }

  vm.load = function () {
    vm.customer = Customers.getFromCustomerId({
      customerID: cellphone
    });
    CustomerService.getSaleEntries(cellphone)(function (err, saleEntries) {
      if (err) {
        FhdMessenger.errorFromServer(err);
        return;
      }

      vm.saleEntries = saleEntries;

      _.forEach(vm.saleEntries, saleEntry => {
        saleEntry.noLoyaltyTotal = _.reduce(saleEntry.order.items, (result, item) => {
          if (item.noLoyalty) return result + item.lineTotal;
          return result;
        }, 0);
        saleEntry.loyaltyTotal = saleEntry.order.saleTotal - saleEntry.noLoyaltyTotal;
      });

      vm.saleTotal = sum(vm.saleEntries, 'order.saleTotal');
      vm.noLoyaltyTotal = sum(vm.saleEntries, 'noLoyaltyTotal');
      vm.loyaltyTotal = sum(vm.saleEntries, 'loyaltyTotal');
      vm.prizePoint = sum(vm.saleEntries, 'prizePoint');
    });
    vm.openSaleEntry = SaleEntryService.viewSaleEntry;
  };
}]);
