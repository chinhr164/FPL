angular.module('pl-tasks').controller('PlTasksController', ['$http', '$location', '$stateParams', 'Authentication', 'FhdMessenger', 'PlTasks', 'ConfirmModal', '$state', 'NgTableParams', 'ObjectId', 'UserService', 'PlTaskService', function ($http, $location, $stateParams, Authentication, FhdMessenger, PlTasks, ConfirmModal, $state, NgTableParams, ObjectId, UserService, PlTaskService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.canDisablePlTask = PlTaskService.canDisablePlTask;
  vm.openModalViewPLTask = PlTaskService.openModalViewPLTask;

  vm.init = function () {
    vm.statusMap = {
      created: true,
      processing: true,
      delivered: true,
      received: false,
      done: false,
      skipped: false,
      disabled: false
    };
    vm.data = {
      statuses: PlTaskService.getStatuses(),
      plTaskTypes: PlTaskService.getPlTaskTypes()
    };
    vm.plTaskTypeMap = {
      new: true,
      redo: true,
      adhoc: true
    };
  };

  vm.searchKeyUp = function ($event) {
    if ($event.keyCode === 13) vm.find();
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      default:
    }
  };

  vm.findOne = function () {
    const plTaskId = $stateParams.plTaskId;
    vm.plTask = PlTasks.get({
      plTaskId
    });
    vm.plTask.$promise.then(() => {
      vm.plTask.assignedStaffs = vm.plTask.assignedStaffs || [];
      UserService.allStaffsAsync().then(staffs => {
        const assignedStaffId = ObjectId.getObjectId(vm.plTask.assignedStaff);

        const matchStaff = _.find(staffs, {
          _id: assignedStaffId
        });

        if (!_.get(vm.plTask, 'assignedStaffs.length') && matchStaff) {
          vm.plTask.assignedStaffs.push(matchStaff);
        }

        vm.plTask.assignedStaff = matchStaff;
      });
    });
  };

  vm.update = function () {
    vm.waiting = true;
    vm.plTask.product = ObjectId.getObjectId(vm.plTask.product);
    vm.plTask.$update().then(() => {
      FhdMessenger.success('Cập nhật thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
      vm.findOne();
    });
  };

  vm.disable = function (plTask) {
    PlTaskService.openDisablePlTaskModal(plTask).then(() => {
      const matchPlTaskIndex = _.findIndex(vm.plTasks, plTask);

      vm.plTasks.splice(matchPlTaskIndex, 1);
      vm.fetchPlTasksTable();
    });
  };

  vm.plTasksTable = new NgTableParams({});

  vm.fetchPlTasksTable = function () {
    vm.plTasksTable.settings({
      dataset: vm.plTasks
    });
    vm.plTasksTable.reload();
  };

  vm.find = function () {
    vm.staffId = null;

    if (!vm.searchConfirm) {
      vm.startDateConfirm = null;
      vm.endDateConfirm = null;
    }

    if (!vm.searchDelivered) {
      vm.startDateDelivered = null;
      vm.endDateDelivered = null;
    }

    if (vm.staff) {
      vm.staffId = vm.staff._id;
    }

    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const plTaskTypes = _.reduce(vm.plTaskTypeMap, (plTaskTypes, toShow, plTaskType) => {
      if (toShow) plTaskTypes.push(plTaskType);
      return plTaskTypes;
    }, []);

    vm.waiting = true;
    vm.plTasks = PlTasks.query({
      startDateDelivered: vm.startDateDelivered,
      endDateDelivered: vm.endDateDelivered,
      startDateConfirm: vm.startDateConfirm,
      endDateConfirm: vm.endDateConfirm,
      staff: vm.staffId,
      statuses,
      plTaskTypes,
      autoCreateStockEntry: false,
      searchText: vm.searchText
    });
    vm.plTasks.$promise.then(() => {
      vm.fetchPlTasksTable();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
      vm.staff = null;
    });
    FhdMessenger.notifyLoading('Đang tải...', vm.plTasks.$promise, () => {
      FhdMessenger.success('Đã tải xong!');
    });
  };

  vm.removeAssignedStaff = function (index) {
    if (!_.isArray(vm.plTask.assignedStaffs)) return;
    vm.plTask.assignedStaffs.splice(index, 1);
  };

  vm.countStaff = function (assignedStaffs) {
    const count = assignedStaffs.length;

    if (count > 1) {
      return count;
    }

    return 1;
  };

  vm.confirmChecked = function (plTask) {
    plTask.checked = true;
    plTask.$update().then(() => {
      FhdMessenger.success('Đã kiểm tra');
    }).catch(err => {
      return FhdMessenger.error(err.message);
    });
  };
}]);
"use strict";

angular.module('pl-tasks').controller('PrintPlTasksController', ['PlTasks', 'PlTaskService', 'NgTableParams', 'Authentication', 'FhdMessenger', function (PlTasks, PlTaskService, NgTableParams, Authentication, FhdMessenger) {
  const vm = this;
  vm.user = Authentication.user;
  vm.printPlTaskTable = new NgTableParams({
    count: 50
  });

  vm.openModalPrintPlTask = plTask => {
    if (_.intersection(vm.user.roles, ['admin', 'pl-task:print-test']) === 0) {
      return FhdMessenger.error('Bạn không có quyền in');
    }

    let printType = 'orange_abby';

    const printLabelType = _.get(plTask, 'labelAttributes.labelType');

    if (printLabelType) {
      printType = printLabelType;
    }

    if (plTask.selfDeclarationInfo) {
      printType += '_declaration';
    }

    PlTaskService.openModalPrintPlTask(plTask, printType);
  };

  vm.find = function () {
    vm.plTasks = PlTasks.query({
      status: 'processing'
    });
    vm.plTasks.$promise.then(() => {
      const printPlTaskData = [];

      _.forEach(vm.plTasks, plTask => {
        printPlTaskData.push({
          _id: plTask._id,
          sku: plTask.sku,
          description: plTask.description,
          confirmManufactureDate: plTask.confirmManufactureDate,
          confirmExpiryDate: plTask.confirmExpiryDate,
          ingredients: _.get(plTask, 'product.attributes.ingredients'),
          weightText: _.get(plTask, 'product.attributes.weightText'),
          usage: _.get(plTask, 'product.attributes.usage'),
          origin: _.get(plTask, 'product.attributes.origin'),
          condition: _.get(plTask, 'product.attributes.condition'),
          plTaskId: _.get(plTask, 'plTaskId'),
          rawProductDescription: _.get(plTask, 'product.rawProducts.0.description'),
          productGroup: _.get(plTask, 'product.category.group.name'),
          selfDeclarationInfo: _.get(plTask, 'product.wooProperties.selfDeclarationInfo'),
          labelAttributes: _.get(plTask, 'product.labelAttributes'),
          orderQuantity: _.get(plTask, 'orderQuantity')
        });
      });

      vm.printPlTaskTable.settings({
        dataset: printPlTaskData
      });
    });
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ProcessPlTaskController', ['PlTasks', '$stateParams', '$state', '$sce', 'FhdMessenger', 'UserService', 'ObjectId', 'PlTaskService', function (PlTasks, $stateParams, $state, $sce, FhdMessenger, UserService, ObjectId, PlTaskService) {
  const vm = this;
  vm.data = {
    rawStatuses: ['Hết hàng raw', 'Còn hàng raw']
  };

  vm.search = (searchString, plTask = vm.plTask) => {
    vm.searchString = '';
    vm.waiting = true;
    PlTaskService.search(searchString, plTask).then(stockEntry => {
      if (stockEntry) {
        plTask.stockEntryDistributes.push(stockEntry);
      }
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.removeStockEntryDistribute = index => {
    vm.plTask.stockEntryDistributes.splice(index, 1);
  };

  vm.findOne = function () {
    vm.plTask = PlTasks.process({
      plTaskId: $stateParams.plTaskId
    });
    vm.plTask.$promise.then(() => {
      _.forEach(vm.plTask.product.wrappers, wrapper => {
        wrapper.quantity = undefined;
        vm.plTask.wrapperProducts.push(wrapper);
      });

      _.forEach(vm.plTask.product.labels, label => {
        label.quantity = undefined;
        vm.plTask.labelProducts.push(label);
      });

      if (!vm.plTask.vendorProducts.length) {
        vm.plTask.vendorProducts = vm.plTask.product.vendorProducts;
      }

      vm.plTask.preservationInformation = vm.getPreservationInformation(vm.plTask.product.warehouseGroup);
      vm.plTask.condition = 'Chưa có thông tin. Vui lòng liên hệ team tech để xử lý';

      if (_.get(vm.plTask.product, 'warehouseGroup.name')) {
        if (_.get(vm.plTask.product, 'warehouseGroup.name') === 'Tủ đông') {
          vm.plTask.condition = 'Bảo quản tủ đông (-18 độ C)';
        } else if (_.get(vm.plTask.product, 'warehouseGroup.name') === 'Tủ mát') {
          vm.plTask.condition = 'Bảo quản tủ mát (2-8 độ C)';
        } else {
          vm.plTask.condition = 'Bảo quản nơi khô ráo, tránh nắng';
        }
      }

      vm.plTask.showVideo = vm.plTask.description.match(/^socola (compound|xanh|hồng|trắng)/i);
      vm.plTask.assignedStaffs = vm.plTask.assignedStaffs || [];
      vm.modifyVideoLink();
    });
    vm.plTask.$promise.catch(FhdMessenger.errorFromServer);
  };

  vm.removeAssignedStaff = function (index) {
    if (!_.isArray(vm.plTask.assignedStaffs)) return;
    vm.plTask.assignedStaffs.splice(index, 1);
  };

  vm.getPreservationInformation = warehouseGroup => {
    switch (warehouseGroup.name) {
      case 'Tủ đông':
        return 'Bảo quản tủ đông (-16 độ C)';

      case 'Tủ mát':
        return 'Bảo quản tủ mát (2-8 độ C)';

      default:
        return 'Bảo quản nơi khô ráo, tránh nắng';
    }
  };

  vm.deliver = function () {
    if (_.get(vm.plTask, 'sku', '').match(/B\d+/) && _.get(vm.plTask, 'outlet.code', '') !== 'G4') {
      if (!vm.plTask.checkedLabelStaff) {
        return FhdMessenger.error('Bạn phải thêm người kiểm tra nhãn của bạn!');
      } else {
        if (_.some(vm.plTask.assignedStaffs, staff => {
          return staff._id === vm.plTask.checkedLabelStaff._id;
        })) {
          return FhdMessenger.error('Nhân viên kiểm tra nhãn phải khác nhân viên được giao plTask!');
        }
      }
    }

    if (vm.plTask.deliverQuantity !== vm.plTask.orderQuantity && !vm.plTask.deliverReason) {
      return FhdMessenger.error('Nhân viên kiểm tra nhãn phải khác nhân viên được giao plTask!');
    }

    if (_.some(vm.plTask.labelProducts, labelProduct => {
      return !labelProduct.quantity;
    })) {
      return FhdMessenger.error('Chưa có số lượng nhãn sử dụng của sản phẩm');
    }

    if (_.some(vm.plTask.wrapperProducts, wrapperProduct => {
      return !wrapperProduct.quantity;
    })) {
      return FhdMessenger.error('Chưa có số lượng bao bì sử dụng của sản phẩm');
    }

    if (vm.plTask.plTaskType === 'new' && !_.get(vm.plTask, 'stockEntryDistributes', []).length) {
      return FhdMessenger.error('Chưa điền LE chuyển hàng RAW');
    }

    if (vm.plTask.plTaskType === 'new' && vm.plTask.deliverQuantity < vm.plTask.orderQuantity && !vm.plTask.rawStatus) {
      return FhdMessenger.error('Chưa chọn trạng thái hàng RAW');
    }

    vm.plTask.stillAvailableRAW = vm.plTask.rawStatus === 'Còn hàng raw';
    vm.waiting = true;
    vm.plTask.$deliver().then(() => {
      FhdMessenger.success('Ok');
      $state.go('receivePlTask');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.modifyVideoLink = function () {
    if (!_.get(vm.plTask, 'product.plProperties.video')) return;

    if (vm.plTask.product.plProperties.video.search('embed') === -1) {
      if (vm.plTask.product.plProperties.video.search('watch') === -1) {
        const url = vm.plTask.product.plProperties.video.replace('com', 'com/embed');
        vm.videoUrl = $sce.trustAsResourceUrl(url);
      } else {
        const url = vm.plTask.product.plProperties.video.replace('watch?v=', 'embed/');
        vm.videoUrl = $sce.trustAsResourceUrl(url);
      }
    } else {
      if (vm.plTask.product.plProperties.video.search('watch') === -1) {
        vm.videoUrl = $sce.trustAsResourceUrl(vm.plTask.product.plProperties.video);
      } else {
        const url = vm.plTask.product.plProperties.video.replace('embed/watch?v=', 'embed/');
        vm.videoUrl = $sce.trustAsResourceUrl(url);
      }
    }
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ProcessinglTasksController', ['Authentication', 'CurrentShift', 'PlTasks', 'FhdMessenger', 'NgTableParams', 'PlTaskService', 'StockEntryService', function (Authentication, CurrentShift, PlTasks, FhdMessenger, NgTableParams, PlTaskService, StockEntryService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.currentShift = CurrentShift.getCurrentShift();
  vm.destination = vm.currentShift.outlet;

  if (!vm.currentShift.created && !vm.user.roles.includes('admin') && !vm.user.roles.includes('flexi-time') && !vm.user.roles.includes('tro-ly-sx') && !vm.user.roles.includes('tro-ly-kho')) {
    return FhdMessenger.error('Chưa đăng nhập ca trực');
  }

  if (!_.get(vm.destination, '_id') && vm.user.roles.includes('flexi-time') && !vm.user.roles.includes('tro-ly-kho') && !vm.user.roles.includes('tro-ly-sx')) {
    vm.destination = _.get(vm.user, 'outlet');
  }

  vm.plTasksTable = new NgTableParams({
    count: 1000
  });
  vm.plTaskOptions = _.map(PlTaskService.getPlTaskTypes(), plTaskType => ({
    id: plTaskType.value,
    title: plTaskType.label
  }));

  vm.find = function () {
    vm.plTasks = PlTasks.getProcessing({});
    vm.plTasks.$promise.then(() => {
      vm.plTasksTable.settings({
        dataset: _.reject(vm.plTasks, plTask => {
          return _.get(plTask, 'outlet.code', '') === 'G4';
        })
      });
    });
  };

  vm.createStockEntry = function (plTask) {
    const vendorProducts = plTask.vendorProducts.length ? plTask.vendorProducts : plTask.product.vendorProducts;
    const data = {
      destination: plTask.outlet,
      plTaskId: plTask.plTaskId,
      plTask: plTask._id,
      vendorProducts: vendorProducts
    };
    return StockEntryService.openCreateStockEntryForPlTaskModal(data);
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ReceivePlTaskController', ['CurrentShift', 'PlTasks', '$state', 'FhdMessenger', '$timeout', function (CurrentShift, PlTasks, $state, FhdMessenger, $timeout) {
  const vm = this;
  vm.currentShift = CurrentShift.getCurrentShift();

  vm.checkActivePlTask = function () {
    vm.plTask = PlTasks.checkActive();
    return vm.plTask.$promise.then(() => {
      if (_.get(vm.plTask, '_id')) {
        $state.go('processPlTask', {
          plTaskId: vm.plTask._id
        });
      }
    });
  };

  vm.receivePlTask = function () {
    vm.checkActivePlTask().then(() => {
      if (!_.get(vm.currentShift, 'outlet._id')) {
        return FhdMessenger.error('Bạn chưa đăng nhập ca trực. Vui lòng đăng nhập ca trực để nhận task nhé');
      }

      vm.waiting = true;
      vm.receivedPlTask = PlTasks.receive({
        outlet: _.get(vm.currentShift, 'outlet._id')
      });
      vm.receivedPlTask.$promise.then(() => {
        $timeout(function () {
          vm.processPlTask();
        }, 2000);
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.processPlTask = function () {
    $state.go('processPlTask', {
      plTaskId: vm.receivedPlTask._id,
      firstTime: true
    });
  };
}]);
"use strict";

angular.module('pl-tasks').controller('SavorPlTasksController', ['PlTasks', '$location', '$state', '$scope', '$timeout', 'helper', 'Authentication', 'CurrentShift', 'ConfirmModal', 'CalendarEntries', 'JsPrintService', 'OutletService', 'PlTaskService', 'Products', 'FhdMessenger', function (PlTasks, $location, $state, $scope, $timeout, helper, Authentication, CurrentShift, ConfirmModal, CalendarEntries, JsPrintService, OutletService, PlTaskService, Products, FhdMessenger) {
  const vm = this;
  vm.outputQuantity = 1;
  vm.user = Authentication.user;
  vm.data = {};
  vm.requireFields = 'kitchen sku orderQuantity'.split(' ');
  vm.currentShift = CurrentShift.getCurrentShift();

  if (vm.currentShift.outlet) {
    if (['B2', 'B5', 'B6'].includes(_.get(vm.currentShift, 'outlet.code'))) {
      OutletService.findOutletFromCode('B1').then(destination => {
        vm.outlet = destination;
      });
    } else {
      vm.outlet = vm.currentShift.outlet;
    }

    vm.data.disableInputOutlet = true;
    vm.data.disableEditRawProduct = true;
  } else if (!_.intersection(vm.user.roles, ['admin', 'tro-ly-sx']).length) {
    CalendarEntries.isShiftLead({}).$promise.then(res => {
      if (!res.isShiftLead) {
        vm.data.disableEditRawProduct = true;
      }
    });
  }

  $scope.$watch(() => vm.product, () => {
    if (!vm.product) return;
    vm.detailedProduct = Products.getDetails({
      fields: 'sku description rawProducts quantityForAFormula onlyShiftLeadEdit',
      productId: vm.product._id
    });
    vm.detailedProduct.$promise.then(() => {
      vm.expectedInputItems = _.cloneDeep(vm.detailedProduct.rawProducts || []);
      vm.actualInputItems = _.map(_.cloneDeep(vm.detailedProduct.rawProducts || []), item => _.assign({}, item, {
        quantity: 0
      }));
    });
  });

  vm.changeFormulaQuantity = () => {
    vm.outputQuantity = vm.detailedProduct.quantityForAFormula * vm.formulaQuantity;
    vm.changeOutputQuantity();
    vm.changeActualInputQuantity();
  };

  vm.changeActualInputQuantity = () => {
    const originalRawProductMap = _.reduce(vm.detailedProduct.rawProducts, (result, product) => {
      result[product.product] = result[product.product] || [];
      result[product.product].push(product);
      return result;
    }, {});

    vm.actualInputItems = _.map(vm.actualInputItems, item => {
      const matchProducts = originalRawProductMap[item.product];

      if (!_.get(matchProducts, 'length')) {
        return item;
      }

      item.quantity = Math.round(_.head(matchProducts).quantity * vm.outputQuantity * 100) / 100;
      originalRawProductMap[item.product] = _.drop(originalRawProductMap[item.product], 1);
      return item;
    });
  };

  vm.changeOutputQuantity = () => {
    const originalRawProductMap = _.reduce(vm.detailedProduct.rawProducts, (result, product) => {
      result[product.product] = result[product.product] || [];
      result[product.product].push(product);
      return result;
    }, {});

    vm.expectedInputItems = _.map(vm.expectedInputItems, item => {
      const matchProducts = originalRawProductMap[item.product];

      if (!_.get(matchProducts, 'length')) {
        return item;
      }

      item.quantity = Math.round(_.head(matchProducts).quantity * vm.outputQuantity * 100) / 100;
      originalRawProductMap[item.product] = _.drop(originalRawProductMap[item.product], 1);
      return item;
    });
  };

  vm.addProduct = product => {
    vm.actualInputItems = vm.actualInputItems || [];
    vm.actualInputItems.push({
      product: product._id,
      sku: product.sku,
      description: product.description,
      quantity: 1
    });
  };

  vm.removeProduct = index => {
    vm.actualInputItems.splice(index, 1);
  };

  vm.print = () => {
    //  console.log(true)
    $timeout(() => {
      JsPrintService.printElementById('print-savor-pl-task', true);
    }, 100);
  };

  vm.removeValueFromArray = helper.removeValueFromArray;

  vm.create = event => {
    if (!_.get(vm, 'outlet.code')) {
      return FhdMessenger.error('Bạn chưa chọn cơ sở chế biến');
    }

    if (!_.get(vm, 'processingStaffs.length')) {
      return FhdMessenger.error('Bạn chưa chọn nhân viên chế biến');
    }

    event.preventDefault();
    vm.waiting = true;
    const plTask = new PlTasks({
      plTaskType: 'new',
      product: vm.detailedProduct._id,
      sku: vm.detailedProduct.sku,
      description: vm.detailedProduct.description,
      expectedInputItems: vm.expectedInputItems,
      actualInputItems: vm.actualInputItems,
      orderQuantity: vm.outputQuantity,
      outlet: vm.outlet,
      destination: vm.outlet,
      deliverQuantity: null,
      confirmQuantity: null,
      processingStaffs: vm.processingStaffs
    });
    plTask.$savorCreate().then(plTask => {
      vm.plTask = plTask;
      return plTask;
    }).then(plTask => {
      vm.print();
    }).then(() => {
      $timeout(() => {
        $state.go('viewSavorPlTask', {
          plTaskId: plTask._id
        });
      }, 500);
    }).catch(function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  function isAllValidField(field) {
    return _.some(vm.plTasks, item => {
      return !_.get(item, field);
    });
  }

  vm.import = function () {
    const errors = _.reduce(vm.requireFields, (result, requireField) => {
      if (isAllValidField(requireField)) {
        result.push(`Bạn chưa điền đủ ${requireField}`);
      }

      return result;
    }, []);

    if (errors.length) {
      return FhdMessenger.error(errors.join('\n'));
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ import create ${vm.plTasks.length} Pl Task?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      PlTasks.import({
        plTasks: vm.plTasks
      }).$promise.then(() => {
        $state.go('listSavorPlTask');
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ModalSkipPlTaskController', ['$modalInstance', 'FhdMessenger', 'plTask', function ($modalInstance, FhdMessenger, plTask) {
  const vm = this;

  vm.submit = function () {
    plTask.skipReason = vm.reason;
    vm.waiting = true;
    plTask.$skip().then(() => $modalInstance.close(plTask)).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ModalSplitPlTaskController', ['$modalInstance', 'FhdMessenger', 'PlTasks', 'plTaskId', '$state', function ($modalInstance, FhdMessenger, PlTasks, plTaskId, $state) {
  const vm = this;

  vm.findOne = function () {
    vm.plTask = PlTasks.get({
      plTaskId
    });
  };

  vm.submit = function () {
    if (!vm.plTask.numPlTasks && vm.plTask.numPlTasks <= 1) {
      FhdMessenger.error('Bạn cần điền số lớn hơn 1');
    }

    vm.waiting = true;
    vm.plTask.$splitPlTask().then(plTasks => {
      $modalInstance.close(plTasks);
      $state.reload();
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ViewPlTasksController', ['$http', '$stateParams', '$location', 'Authentication', 'ComplaintService', 'FhdMessenger', 'PlTasks', 'PlTaskService', 'StockEntries', 'ConfirmModal', 'ObjectId', 'UserService', '$state', function ($http, $stateParams, $location, Authentication, ComplaintService, FhdMessenger, PlTasks, PlTaskService, StockEntries, ConfirmModal, ObjectId, UserService, $state) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.canDisablePlTask = PlTaskService.canDisablePlTask;
  vm.openCreateComplaintModal = ComplaintService.openCreateComplaintModal;

  vm.search = (searchString, plTask = vm.plTask) => {
    vm.searchString = '';
    vm.waiting = true;
    PlTaskService.search(searchString, plTask).then(stockEntry => {
      if (stockEntry) {
        plTask.stockEntryDistributes.push(stockEntry);
      }
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.removeStockEntryDistribute = index => {
    vm.plTask.stockEntryDistributes.splice(index, 1);
  };

  vm.findOne = function () {
    const plTaskId = $stateParams.plTaskId;
    vm.plTask = PlTasks.get({
      plTaskId
    });
    vm.plTask.$promise.then(() => {
      vm.plTask.assignedStaffs = vm.plTask.assignedStaffs || [];
      vm.plTask.raws = [];

      if (_.get(vm.plTask, 'vendorProducts.length', null)) {
        vm.plTask.raws = vm.plTask.vendorProducts;
      } else if (_.get(vm.plTask.product, 'vendorProducts.length', null)) {
        vm.plTask.raws = vm.plTask.product.vendorProducts;
      }

      vm.plTask.raws = _.map(vm.plTask.raws, raw => ({
        sku: raw.sku,
        description: raw.description,
        quantity: Number(vm.plTask.orderQuantity) * raw.quantity
      }));
      UserService.allStaffsAsync().then(staffs => {
        const assignedStaffId = ObjectId.getObjectId(vm.plTask.assignedStaff);

        const matchStaff = _.find(staffs, {
          _id: assignedStaffId
        });

        if (!_.get(vm.plTask, 'assignedStaffs.length') && matchStaff) {
          vm.plTask.assignedStaffs.push(matchStaff);
        }

        vm.plTask.assignedStaff = matchStaff;
      });
    });
  };

  vm.openEditPlTaskModal = () => {
    PlTaskService.openEditPlTaskModal().then(() => {
      vm.findOne();
    });
  };

  vm.openEditRawProductForPlTaskModal = () => {
    PlTaskService.openEditRawProductForPlTaskModal().then(() => {
      vm.findOne();
    });
  };

  vm.update = function () {
    const region = _.get(vm.plTask, 'outlet.region');

    if (vm.plTask.assignedStaff && _.get(vm.plTask.assignedStaff, 'outlet.region') !== region) {
      return FhdMessenger.error('Không được thêm nhân viên khác miền vào PL Task');
    }

    if (vm.plTask.assignedStaffs.length && _.difference(_.map(vm.plTask.assignedStaffs, 'outlet.region'), [region]).length) {
      return FhdMessenger.error('Không được thêm nhân viên khác miền vào PL Task');
    }

    vm.waiting = true;
    vm.plTask.product = ObjectId.getObjectId(vm.plTask.product);
    vm.plTask.$update().then(() => {
      FhdMessenger.success('Cập nhật thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
      vm.findOne();
    });
  };

  vm.disable = function (plTask) {
    vm.waiting = true;
    PlTaskService.openDisablePlTaskModal(plTask).then(() => {
      $location.path('pl-tasks');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.removeAssignedStaff = function (index) {
    if (!_.isArray(vm.plTask.assignedStaffs)) return;
    vm.plTask.assignedStaffs.splice(index, 1);
  };

  vm.addVendorProduct = product => {
    vm.plTask.vendorProducts.push({
      product: product._id,
      sku: product.sku,
      description: product.description
    });
  };

  vm.removeVendorProducts = function (index) {
    if (!_.isArray(vm.plTask.vendorProducts)) return;
    vm.plTask.vendorProducts.splice(index, 1);
  };
}]);
"use strict";

angular.module('pl-tasks').controller('ViewSavorPlTaskController', ['CalendarEntries', 'PlTasks', '$location', '$stateParams', '$timeout', 'helper', 'FhdMessenger', 'JsPrintService', 'PlTaskService', 'Authentication', 'StockEntries', function (CalendarEntries, PlTasks, $location, $stateParams, $timeout, helper, FhdMessenger, JsPrintService, PlTaskService, Authentication, StockEntries) {
  const vm = this;

  vm.changeOutputQuantity = () => {
    vm.expectedInputItems = _.map(vm.plTask.expectedInputItems, item => {
      return _.assign({}, item, {
        quantity: item.quantity / vm.plTask.confirmQuantity * vm.outputQuantity
      });
    });
  };

  vm.changeFormulaQuantity = () => {
    vm.plTask.orderQuantity = vm.plTask.product.quantityForAFormula * vm.plTask.formulaQuantity;
    vm.updateActualInputItems();
  };

  vm.updateActualInputItems = () => {
    const expectedInputItems = _.map(vm.plTask.product.rawProducts, rawProduct => {
      const quantity = Math.round(_.get(rawProduct, 'quantity', 0) * vm.plTask.orderQuantity * 100) / 100;
      return {
        quantity,
        product: rawProduct.product,
        sku: rawProduct.sku,
        description: rawProduct.description
      };
    });

    vm.expectedInputItems = expectedInputItems;
    vm.actualInputItems = expectedInputItems;
  };

  vm.user = Authentication.user;
  vm.canDisablePlTask = PlTaskService.canDisablePlTask;
  vm.isAdminMechandise = _.intersection(vm.user.roles, ['admin', 'admin-merchandise']).length;
  vm.data = {
    updating: false
  };

  if (!vm.isAdminMechandise) {
    CalendarEntries.isShiftLead({}).$promise.then(res => {
      vm.data.isShiftLead = res.isShiftLead;
    });
  }

  vm.disable = function (plTask) {
    vm.waiting = true;
    PlTaskService.openDisablePlTaskModal(plTask).then(() => {
      $location.path('savor-pl-tasks');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findLinkedStockEntry = plTask => {
    vm.stockEntries = StockEntries.fromPlTask({
      plTask: plTask._id
    });
  };

  vm.findOne = () => {
    vm.plTask = PlTasks.get({
      plTaskId: $stateParams.plTaskId
    });
    vm.plTask.$promise.then(() => {
      vm.expectedInputItems = _.cloneDeep(vm.plTask.expectedInputItems);
      vm.actualInputItems = _.cloneDeep(vm.plTask.actualInputItems);
      vm.outputQuantity = vm.plTask.confirmQuantity;
      vm.processingStaffs = vm.plTask.processingStaffs;
      vm.findLinkedStockEntry(vm.plTask);
      vm.calculateCogs();
      vm.changeOutputQuantity();
    });
  };

  vm.getNewPlTask = plTask => {
    const newPlTask = new PlTasks(plTask);

    _.assign(newPlTask, {
      expectedInputItems: vm.expectedInputItems,
      actualInputItems: vm.actualInputItems,
      deliverQuantity: vm.outputQuantity,
      confirmQuantity: vm.outputQuantity,
      processingStaffs: vm.processingStaffs
    });

    return newPlTask;
  };

  vm.done = plTask => {
    if (!_.isFinite(vm.outputQuantity)) {
      return FhdMessenger.error('Chưa có số lượng thành phẩm thực tế.');
    }

    const newPlTask = vm.getNewPlTask(vm.plTask);
    newPlTask.status = 'done';
    newPlTask.done = moment().toDate();

    _.set(vm.data, 'updating', true);

    newPlTask.$savorUpdate().then(newPlTask => {
      vm.plTask = newPlTask;
    }).then(() => {
      FhdMessenger.success('Ok');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      _.set(vm.data, 'updating', false);
    });
  };

  vm.update = () => {
    const newPlTask = vm.getNewPlTask(vm.plTask);

    if (newPlTask.status === 'pending') {
      if (!newPlTask.orderQuantity) {
        return FhdMessenger.error('Chưa có số lượng thành phẩm ban đầu');
      }

      if (!_.get(newPlTask, 'processingStaffs.length')) {
        return FhdMessenger.error('Chưa có nhân viên chế biến');
      }

      newPlTask.status = 'created';
    }

    _.set(vm.data, 'updating', true);

    newPlTask.$savorUpdate().then(newPlTask => {
      vm.plTask = newPlTask;
    }).then(() => {
      FhdMessenger.success('Ok');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      _.set(vm.data, 'updating', false);
    });
  };

  function calculateTotalCogs(items) {
    return _.reduce(items, (result, item) => {
      result += item.quantity * item.product.cogs;
      return result;
    }, 0);
  }

  vm.removeValueFromArray = helper.removeValueFromArray;

  vm.calculateCogs = () => {
    vm.totalCogs = calculateTotalCogs(vm.actualInputItems);
    vm.cogsPerItem = vm.totalCogs / vm.outputQuantity;
  };

  vm.print = () => {
    $timeout(() => {
      JsPrintService.printElementById('print-savor-pl-task', true);
    }, 100);
  };
}]);
"use strict";

angular.module('pl-tasks').component('fhdFindPlTask', {
  templateUrl: 'modules/pl-tasks/templates/fhd-find-pl-task.client.template.html',
  controller: 'FhdFindPlTaskController',
  transclude: true,
  controllerAs: 'vm',
  bindings: {
    plTask: '=',
    label: '@',
    labelColumn: '@'
  }
}).controller('FhdFindPlTaskController', ['FhdMessenger', 'PlTasks', '$http', function (FhdMessenger, PlTasks, $http) {
  const vm = this;
  vm.labelColumn = Number(vm.labelColumn) || 3;
  vm.inputColumn = Number(vm.inputColumn) || 12 - vm.labelColumn;
  vm.waiting = false;

  vm.find = () => {
    if (!vm.plTaskId) {
      return FhdMessenger.error('Bạn chưa nhập mã plTask');
    }

    vm.waiting = true;
    $http.get('/pl-tasks/get-by-pl-task-id', {
      params: {
        plTaskId: vm.plTaskId.trim()
      }
    }).then(({
      data
    }) => {
      vm.plTask = data;
      vm.plTaskId = 'null';
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('pl-tasks').directive('fhdPlTaskStatus', [function () {
  return {
    restrict: 'E',
    scope: {
      status: '='
    },
    template: `<span class="label" ng-class="{
        'label-primary': status === 'created',
        'label-default': status === 'processing',
        'label-info': status === 'delivered',
        'label-danger': status === 'received',
        'label-success': status === 'done',
        'label-warning': status === 'pending',
        'label-ready': status === 'disabled' ||  status === 'skipped',
      }" data-cy="pl-task-status-text">{{status}}</span>`
  };
}]);
'use strict';

angular.module('pl-tasks').filter('plTaskTypes', [function () {
  return function (input) {
    switch (input) {
      case 'new':
        return 'Mới';

      case 'redo':
        return 'Tái chế';

      case 'adhoc':
        return 'Ad Hoc';

      default:
        return 'N/A';
    }
  };
}]);
'use strict';

angular.module('pl-tasks').filter('plTypes', [function () {
  return function (input) {
    switch (input) {
      case 'sack':
        return 'Bao tải';

      case 'vacuum':
        return 'Hút chân không';

      case 'non-food':
        return 'Phi thực phẩm';

      case 'other':
        return 'Khác';

      default:
        return 'Chưa chọn';
    }
  };
}]);
"use strict";

angular.module('pl-tasks').factory('PlTaskService', ['$http', '$modal', 'StockEntries', 'FhdMessenger', function ($http, $modal, StockEntries, FhdMessenger) {
  const statuses = [{
    id: 'created',
    title: 'Chờ DG',
    idName: 'showCreated',
    class: 'primary'
  }, {
    id: 'processing',
    title: 'Đang DG',
    idName: 'showProcessing',
    class: 'default'
  }, {
    id: 'delivered',
    title: 'Đã DG',
    idName: 'showTerminated',
    class: 'info'
  }, {
    id: 'received',
    title: 'Confirm (Sai số)',
    idName: 'showReceived',
    class: 'danger'
  }, {
    id: 'done',
    title: 'Confirm (Đúng số)',
    idName: 'showDone',
    class: 'success'
  }, {
    id: 'skipped',
    title: 'Skip',
    idName: 'showSkip',
    class: 'warning'
  }, {
    id: 'disabled',
    title: 'Disabled',
    idName: 'showDisabled',
    class: 'ready'
  }];
  return {
    getStatuses: () => statuses,
    openModalPrintPlTask: (plTask, printType) => $modal.open({
      animation: true,
      templateUrl: '/modules/pl-tasks/templates/modal-print-pl-task.client.template.html',
      controller: 'ModalPrintPlTaskController',
      controllerAs: 'vm',
      size: 'md',
      resolve: {
        plTask: () => plTask,
        printType: () => printType
      }
    }).result,
    openCreatePlTaskModal: (recycleStockEntry = {}) => $modal.open({
      animation: true,
      templateUrl: '/modules/pl-tasks/templates/create-pl-task-modal.client.template.html',
      controller: 'CreatePlTaskModalController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        recycleStockEntry: () => recycleStockEntry
      }
    }).result,
    openConfirmPlTaskModal: plTask => $modal.open({
      animation: true,
      templateUrl: '/modules/pl-tasks/templates/confirm-pl-task-modal.client.template.html',
      controller: 'ConfirmPlTaskModalController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        plTask: () => plTask
      }
    }).result,
    openSkipPlTaskModal: plTask => $modal.open({
      animation: true,
      templateUrl: '/modules/pl-tasks/templates/skip-pl-task-modal.template.html',
      controller: 'ModalSkipPlTaskController',
      controllerAs: 'vm',
      size: 'sm',
      resolve: {
        plTask: () => plTask
      }
    }).result,
    openMarkDeliverPlTaskModal: plTask => $modal.open({
      animation: true,
      templateUrl: '/modules/pl-tasks/templates/mark-deliver-pl-task-modal.client.template.html',
      controller: 'MarkDeliverPlTaskModalController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        plTask: () => plTask
      }
    }).result,
    openDisablePlTaskModal: plTask => $modal.open({
      animation: true,
      templateUrl: '/modules/pl-tasks/templates/disable-pl-task-modal.template.html',
      controller: 'ModalDisablePlTaskController',
      controllerAs: 'vm',
      resolve: {
        plTask: () => plTask
      }
    }).result,
    openSplitPlTaskModal: plTaskId => $modal.open({
      animation: true,
      templateUrl: '/modules/pl-tasks/templates/split-pl-task-modal.template.html',
      controller: 'ModalSplitPlTaskController',
      controllerAs: 'vm',
      resolve: {
        plTaskId: () => plTaskId
      }
    }).result,
    openViewDetailPointPlTaskModal: plTask => $modal.open({
      animation: true,
      templateUrl: '/modules/pl-tasks/templates/modal-view-pl-task-points.html',
      controller: 'ModalViewPlTaskPointsController',
      controllerAs: 'vm',
      resolve: {
        plTask: () => plTask
      }
    }).result,
    openEditPlTaskModal: plTask => $modal.open({
      animation: true,
      templateUrl: 'modules/pl-tasks/views/modal-edit-pl-task.client.view.html',
      controller: 'ModalEditPlTaskController',
      controllerAs: 'vm',
      resolve: {
        plTask: () => plTask
      }
    }).result,
    openEditRawProductForPlTaskModal: plTask => $modal.open({
      animation: true,
      templateUrl: 'modules/pl-tasks/views/modal-edit-raw-product-for-pl-task.client.view.html',
      controller: 'ModalEditRawProductForPlTaskController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        plTask: () => plTask
      }
    }).result,
    openModalViewPLTask: plTaskId => $modal.open({
      animation: true,
      templateUrl: 'modules/pl-tasks/views/modal-view-pl-task.client.view.html',
      controller: 'ModalViewPlTaskController',
      controllerAs: 'vm',
      resolve: {
        plTaskId: () => plTaskId
      }
    }).result,

    getToConfirmItems() {
      return $http.get('/pl-tasks/to-confirm').then(response => response.data);
    },

    canDisablePlTask(user) {
      return _.intersection(user.roles, ['superadmin', 'pl-task:disable']).length;
    },

    mergePlTask(plTasks) {
      return $http.post('/pl-tasks/merge-pl-tasks', plTasks).then(response => response.data);
    },

    myPlTasks(startDate, endDate) {
      return $http.get('/pl-tasks/my-pl-tasks', {
        params: {
          startDate,
          endDate
        }
      }).then(response => response.data);
    },

    getPlTasksByExpiryDate(startDate, endDate) {
      return $http.get('/pl-tasks/filter-by-date', {
        params: {
          startDate,
          endDate
        }
      }).then(response => response.data);
    },

    getPlTaskTypes(plTask) {
      return [{
        value: 'new',
        label: 'Mới'
      }, {
        value: 'redo',
        label: 'Tái chế'
      }, {
        value: 'adhoc',
        label: 'Ad Hoc'
      }];
    },

    search(searchString, plTask) {
      const promise = StockEntries.search({
        searchString
      });
      return promise.$promise.then(stockEntry => {
        plTask.stockEntryDistributes = plTask.stockEntryDistributes || [];

        const isExistsStockEntry = _.find(plTask.stockEntryDistributes, _stockEntry => {
          return _.get(_stockEntry, 'stockEntryId') === _.get(stockEntry, 'stockEntryId');
        });

        if (isExistsStockEntry) {
          return FhdMessenger.error('Logistic Entry đã có trong PL Task rồi');
        }

        return stockEntry;
      }).catch(FhdMessenger.errorFromServer);
    }

  };
}]);
"use strict";

angular.module('pl-tasks').factory('PlTasks', ['$resource', function ($resource) {
  return $resource('pl-tasks/:plTaskId', {
    plTaskId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    process: {
      method: 'GET',
      url: 'pl-tasks/:plTaskId/process'
    },
    checkActive: {
      method: 'GET',
      url: '/pl-tasks/check-active'
    },
    receive: {
      method: 'POST',
      url: '/pl-tasks/receive'
    },
    deliver: {
      method: 'POST',
      url: '/pl-tasks/:plTaskId/deliver'
    },
    confirm: {
      method: 'POST',
      url: '/pl-tasks/:plTaskId/confirm'
    },
    skip: {
      method: 'POST',
      url: '/pl-tasks/:plTaskId/skip'
    },
    updateRawProduct: {
