angular.module('reports').controller('AssessUsersController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'UserService', function (Authentication, FhdMessenger, NgTableParams, UserService) {
  const vm = this;

  vm.init = function () {
    vm.startDate = moment().startOf('day').subtract(2, 'month').format('YYYY-MM-DD');
    vm.endDate = moment().endOf('day').format('YYYY-MM-DD');
    vm.filterByDate = false;
  };

  vm.user = Authentication.user;
  vm.assessUserTable = new NgTableParams({
    count: 100
  });

  vm.find = function () {
    vm.waiting = true;
    let promise = UserService.getAssessUsers(vm.startDate, vm.endDate, vm.filterByDate).then(response => {
      vm.assessUserTable.settings({
        dataset: response
      });
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải ...', promise, () => {
      FhdMessenger.success('Đã tải xong');
    });
  };

  vm.openModalViewAssessUser = UserService.openModalViewAssessUser;
}]);
"use strict";

/* eslint-disable angular/controller-as-vm */
angular.module('reports').controller('AvailabilityTableController', ['NgTableParams', '$http', 'FhdMessenger', 'ProductService', '$filter', function (NgTableParams, $http, FhdMessenger, ProductService, $filter) {
  const vm = this;
  vm.saleOutletCodes = ['M6', 'E12', 'E15', 'E16', 'E30', 'E31', 'E32', 'E33', 'M1', 'M2', 'E1', 'E5', 'E6', 'E7', 'E8', 'E9', 'E11', 'E13', 'E14', 'E17', 'E18', 'E19', 'E20', 'E22', 'E24', 'E25', 'E26', 'E27', 'E28'];
  vm.outletCodes = [...vm.saleOutletCodes, 'D1', 'D2', 'D3', 'D4', 'D7', 'D8', 'D9'];
  vm.startDate = moment().subtract(1, 'days').format('YYYY-MM-DD');

  vm.getStyle = (availabilityPercent = 0) => {
    const opacity = 1 - (availabilityPercent / 100).toFixed(1);
    let styles = {
      'background-color': `rgba(255, 0, 0, ${opacity})`
    };

    if (opacity >= 0.3) {
      styles.color = 'white';
    }

    return styles;
  };

  vm.availabilityTable = new NgTableParams({
    count: 50
  });
  vm.quickEditProduct = ProductService.quickEditProduct;
  vm.quickEditProductAttributes = ProductService.quickEditProductAttributes;

  function indexCol($scope, row, rowIndex) {
    return `<span>${rowIndex + 1}</span>`;
  }

  function normalValue($scope, row) {
    const value = _.get(row, this.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${_.get(row, this.field) || ''}</span>`;
  }

  function numberValue($scope, row) {
    const value = _.get(row, this.field, '');

    return `<span>${$filter('number')(value, 0)}</span>`;
  }

  function getStyle(row) {
    const availabilityPercent = _.get(row, this.field, 0);

    const opacity = 1 - (availabilityPercent / 100).toFixed(1);
    let styles = {
      'background-color': `rgba(255, 0, 0, ${opacity})`
    };

    if (opacity >= 0.3) {
      styles.color = 'white';
    }

    return styles;
  }

  function getSkuCell($scope, row) {
    return `<a ng-click="vm.quickEditProduct(row)">${row._id}</a>`;
  }

  function getDescriptionCell($scope, row) {
    return `<a ng-click="vm.quickEditProductAttributes(row)">${row.product.description}</a>`;
  }

  vm.cols = [{
    title: 'STT',
    getValue: indexCol
  }, {
    field: '_id',
    title: 'SKU',
    sortable: '_id',
    filter: {
      _id: 'text'
    },
    getValue: getSkuCell
  }, {
    field: 'product.description',
    title: 'Description',
    sortable: 'product.description',
    filter: {
      'product.description': 'text'
    },
    getValue: getDescriptionCell,
    getStyle: () => {
      return {
        'min-width': 200
      };
    }
  }, {
    field: 'product.toBuy',
    title: 'Buying',
    filter: {
      'product.toBuy': 'select'
    },
    filterData: [{
      id: 'Buying',
      title: 'Buying'
    }, {
      id: 'Stop',
      title: 'Not Buying'
    }],
    sortable: 'product.toBuy',
    getValue: normalValue
  }, ...vm.saleOutletCodes.map(outletCode => {
    return {
      field: `availabilityPercentMap.${outletCode}`,
      title: outletCode,
      sortable: `${outletCode}`,
      getStyle: getStyle,
      getValue: numberValue
    };
  })];

  vm.find = () => {
    FhdMessenger.success('Đang lấy dữ liệu. Có thể mất 1 khoảng thời gian. ');
    vm.isLoading = true;
    $http.get('/reports/availability-items', {
      params: {
        startDate: vm.startDate,
        endDate: vm.endDate
      }
    }).then(res => res.data).then(items => {
      _.forEach(items, item => {
        item.product.toBuy = item.product.notBuying ? 'Stop' : 'Buying';
        item.availabilityPercentMap = {};

        _.forEach(item.outlets, outlet => {
          item.availabilityPercentMap[outlet.outletCode] = _.get(outlet, 'availHours', 0) / _.get(outlet, 'displayHours', 0) * 100;
        }); // Remove not important data.


        delete item.outlets;
      });

      vm.availabilityTable.settings({
        dataset: items
      });
      FhdMessenger.success('Đã lấy dữ liệu thành công !');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.isLoading = false;
    });
  };
}]);
"use strict";

angular.module('reports').controller('BusinessCustomerSaleController', ['ProductService', '$http', 'FhdMessenger', 'NgTableParams', '$scope', '$timeout', '$window', 'TetCategoriesService', '$filter', function (ProductService, $http, FhdMessenger, NgTableParams, $scope, $timeout, $window, TetCategoriesService, $filter) {
  const vm = this;
  vm.metrics = [{
    id: 'sale',
    title: 'Sale'
  }, {
    id: 'quantity',
    title: 'Quantity'
  }];
  vm.data = {
    metric: 'sale',
    cols: [],
    inputDescriptionFilter: '',
    allProducts: [],
    productTSV: 'Nhấn vào nút Copy bảng để lấy dữ liệu...'
  };
  vm.summary = {};
  vm.specialFilter = {
    description: {
      using: false,
      data: []
    },
    catman: {
      using: false,
      data: []
    }
  };

  function intersectionBySku(arr1, arr2) {
    const skuArr1 = _.map(arr1, 'sku');

    const skuArr2 = _.map(arr2, 'sku');

    const skuIntersection = _.intersection(skuArr1, skuArr2);

    return _.filter(vm.data.allProducts, _product => {
      return _.includes(skuIntersection, _product.sku);
    });
  }

  function mergeFilter(defaultData, withDefaultFilter) {
    const isUsingCatman = vm.specialFilter.catman.using;
    const isUsingDescription = vm.specialFilter.description.using;

    if (withDefaultFilter) {
      if (isUsingCatman) {
        return intersectionBySku(defaultData, vm.specialFilter.catman.data);
      }

      if (isUsingDescription) {
        return intersectionBySku(defaultData, vm.specialFilter.description.data);
      }
    }

    if (!isUsingDescription || !isUsingCatman) {
      return defaultData;
    }

    return intersectionBySku(vm.specialFilter.description.data, vm.specialFilter.catman.data);
  }

  $scope.$watch(() => vm.data.inputDescriptionFilter, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const originalText = vm.data.inputDescriptionFilter;

    const hasSpecialFilter = _.includes(originalText, '*');

    if (hasSpecialFilter) {
      const splited = originalText.replace(/\s/g, '').split('*');

      const regexString = _.reduce(splited, (result, word) => {
        result += `(.*?)${word}`;
        return result;
      }, '');

      let matchDescription = _.filter(vm.data.allProducts, _product => {
        return _.get(_product, 'description', '').replace(/\s/g, '').match(new RegExp(regexString, 'gi'));
      });

      vm.specialFilter.description.data = matchDescription;
      vm.specialFilter.description.using = true;
      vm.productsTable.filter()['description'] = '';
      const mergeData = mergeFilter(matchDescription);
      feedDataToTable(mergeData);
    } else {
      vm.specialFilter.description.using = false;
      const mergeData = mergeFilter(vm.data.allProducts, true);
      feedDataToTable(mergeData);
      vm.productsTable.filter()['description'] = originalText;
    }
  });
  $scope.$watch(() => vm.data.categoryName, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    if (!newValue) {
      vm.specialFilter.catman.using = false;
      const mergeData = mergeFilter(vm.data.allProducts, true);
      feedDataToTable(mergeData);
    } else {
      const matchCategory = _.filter(vm.data.allProducts, _product => {
        return _.get(_product, 'tetCategory.name', '').match(new RegExp(`^(${newValue})$`));
      });

      vm.specialFilter.catman.data = matchCategory;
      vm.specialFilter.catman.using = true;
      const mergeData = mergeFilter(matchCategory);
      return feedDataToTable(mergeData);
    }
  });

  vm.getTotalField = idMetric => {
    return _.camelCase(`total ${idMetric}`);
  };

  function indexCol($scope, row, rowIndex) {
    return `<span>${rowIndex + 1}</span>`;
  }

  function getSkuCell($scope, row) {
    return `<a ng-click="vm.quickEditProduct(row.product)" target="_blank">${row.sku}</a>`;
  }

  function getDescriptionCell($scope, row) {
    return ` <a ng-click="vm.quickEditProductAttributes(row.product)"
          >${row.description}</a>`;
  }

  function getValueByMetric($scope, row) {
    // eslint-disable-next-line angular/controller-as-vm
    const businessCustomerId = this.field;

    const metricMap = _.get(row, businessCustomerId, {});

    const metric = _.get(metricMap, vm.data.metric, 0);

    return `<span>${$filter('number')(metric, 0)}</span>`;
  }

  function getFinalMetric($scope, row) {
    const vm = this; // eslint-disable-next-line angular/controller-as-vm

    let metric = _.get(row, this.field, 0);

    if (_.isFunction(vm.field)) {
      metric = _.get(row, vm.field(), 0);
    }

    return `<span>${$filter('number')(metric, 0)}</span>`;
  }

  function normalValue($scope, row) {
    const vm = this;

    let value = _.get(row, vm.field);

    if (!value) {
      value = 'Khác';
    }

    return `<span>${value}</span>`;
  }

  function getSize(field) {
    switch (field) {
      case 'stt':
        return 10;

      case 'sku':
        return 100;

      case 'description':
        return 200;

      default:
        return 50;
    }
  }

  function getStyle(row) {
    const vm = this;
    const isPrimary = ['stt', 'sku', 'description'].includes(vm.field);

    if (isPrimary) {
      if (row.justEdited) {
        return {
          'background-color': '#ff0',
          'min-width': getSize(vm.field)
        };
      } else {
        return {
          'min-width': getSize(vm.field)
        };
      }
    }

    return {};
  }

  const defineBusinessSaleTableCols = businessCustomers => {
    vm.data.cols = [{
      field: 'stt',
      title: 'STT',
      show: true,
      getValue: indexCol,
      getStyle: getStyle
    }, {
      field: 'sku',
      title: 'SKU',
      sortable: 'sku',
      filter: {
        sku: '/modules/stocks/template/input-sku-filter.client.template.html'
      },
      show: true,
      getValue: getSkuCell,
      getStyle: getStyle
    }, {
      field: 'description',
      title: 'Description',
      sortable: 'description',
      filter: {
        description: '/modules/reports/templates/input-description-filter.client.template.html'
      },
      show: true,
      getValue: getDescriptionCell,
      getStyle: getStyle
    }, {
      field: 'tag',
      title: 'Tag',
      sortable: 'tag',
      filter: {
        tag: 'select'
      },
      filterData: ProductService.getAllProductsTagsFromServer,
      getValue: normalValue
    }, {
      field: 'tetCategory.name',
      title: 'Cat Man',
      sortable: 'tetCategory.name',
      filter: {
        'tetCategory.name': '/modules/reports/templates/select-categories-filter.client.template.html'
      },
      filterData: TetCategoriesService.getTags,
      getValue: normalValue
    }, {
      field: 'warehouseRestock',
      title: 'Warehouse',
      sortable: 'warehouseRestock',
      filter: {
        warehouseRestock: 'select'
      },
      filterData: [{
        id: 'D1',
        title: 'D1'
      }, {
        id: 'D2',
        title: 'D2'
      }, {
        id: 'D3',
        title: 'D3'
      }, {
        id: 'D4',
        title: 'D4'
      }, {
        id: 'D5',
        title: 'D5'
      }, {
        id: 'D7',
        title: 'D7'
      }, {
        id: 'D10',
        title: 'D10'
      }, {
        id: 'B1',
        title: 'B1'
      }, {
        id: 'B2',
        title: 'B2'
      }, {
        id: 'B3',
        title: 'B3'
      }, {
        id: '',
        title: 'Tất cả'
      }],
      getValue: normalValue
    }];

    _.forEach(businessCustomers, businessCustomer => {
      const outletCol = {
        field: businessCustomer._id,
        title: businessCustomer.city,
        sortable: () => `${businessCustomer._id}.${vm.data.metric}`,
        getValue: getValueByMetric,
        getStyle: getStyle
      };
      vm.data.cols.push(outletCol);
    });

    vm.data.cols.push({
      field: () => vm.data.metric,
      title: () => vm.data.metric,
      sortable: () => vm.data.metric,
      show: true,
      getValue: getFinalMetric
    });
  };

  vm.productsTable = new NgTableParams({});

  vm.init = () => {
    vm.endDate = moment().startOf('day').format('YYYY-MM-DD');
    vm.startDate = moment(vm.startDate).subtract(1, 'week').startOf('day').format('YYYY-MM-DD');
    vm.find();
  };

  function getTotalForBusinessCustomer(fields, productsTable, businessCustomer) {
    if (!productsTable) return null;
    return _.reduce(fields, (result, field) => {
      result[field] = _.sumBy(productsTable.data, `${businessCustomer._id}.${field}`);
      return result;
    }, {});
  }

  $scope.$watch(() => vm.productsTable.data, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    if (!_.get(vm, 'businessCustomers.length')) return;

    const fields = _.map(vm.metrics, 'id');

    const summary = _.reduce(vm.businessCustomers, (result, businessCustomer) => {
      result[businessCustomer._id] = getTotalForBusinessCustomer(fields, vm.productsTable, businessCustomer);
      return result;
    }, {});

    summary.total = _.reduce(fields, (result, field) => {
      result[field] = _.sumBy(vm.productsTable.data, field);
      return result;
    }, {});
    vm.summary = summary;
  });

  const feedDataToTable = data => {
    let feedingProducts = data;
    vm.productsTable.settings({
      dataset: feedingProducts
    });
    vm.productsTable.reload();
    return feedingProducts;
  };

  const getBusinessCustomerSale = ({
    startDate,
    endDate,
    businessCode
  }) => {
    let promise = $http.get('/reports/business-customer-sale', {
      params: {
        startDate,
        endDate,
        businessCode
      }
    }).then(response => {
      return response.data;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
    return promise;
  };

  vm.find = () => {
    vm.data.allProducts = [];
    feedDataToTable([]);
    vm.getData = getBusinessCustomerSale({
      startDate: vm.startDate,
      endDate: vm.endDate,
      businessCode: vm.data.business
    }).then(({
      businessCustomerSale,
      businessCustomers
    }) => {
      vm.businessCustomers = businessCustomers;
      defineBusinessSaleTableCols(businessCustomers);
      vm.data.allProducts = _.map(businessCustomerSale, product => {
        product.warehouseRestock = _.get(product, 'warehouseRestock.code', '');
        return product;
      });
      return businessCustomerSale;
    }).then(feedDataToTable).catch(FhdMessenger.errorFromServer);
    return vm.getData;
  };

  vm.copyProductTSV = async () => {
    const headers = ['STT', 'SKU', 'Description', ..._.map(vm.businessCustomers, businessCustomer => {
      return `${businessCustomer.brand || businessCustomer.name} - ${businessCustomer.city}`;
    }), 'total'];
    vm.data.productTSV = 'Đang tạo dữ liệu...';

    const products = _.map(vm.data.allProducts, (product, index) => {
      const fields = [index + 1, _.get(product, 'sku', ''), _.get(product, 'description', ''), ..._.map(vm.businessCustomers, businessCustomer => {
        return _.get(product, `${businessCustomer._id}.${vm.data.metric}`, 0);
      }), _.get(product, vm.data.metric, 0)];
      return fields.join('\t');
    });

    vm.data.productTSV = `Cập nhật lúc ${moment().format('YYYY-MM-DD HH:mm')}\n` + headers.join('\t') + '\n' + products.join('\n');
    const copyText = $window.document.getElementById('productsCSV');
    vm.copying = true;
    const copyPromise = $timeout(() => {
      /* Select the text field */
      copyText.select();
      /* Copy the text inside the text field */

      $window.document.execCommand('copy');
    }, 2000);
    FhdMessenger.notifyLoading('Đang copy bảng', copyPromise, () => {
      FhdMessenger.success('Đã copy');
    });
  };
}]);
"use strict";

angular.module('reports').controller('CompareLogisticsRestockController', ['StockEntries', 'NgTableParams', 'FhdMessenger', 'CompareLogisticsRestocks', function (StockEntries, NgTableParams, FhdMessenger, CompareLogisticsRestocks) {
