/* eslint-disable angular/controller-as */
angular.module('core').controller('HeaderController', ['$scope', '$location', 'Authentication', 'BirthdayService', 'Menus', 'CurrentShift', 'UserAccounts', 'toaster', 'FhdMessenger', '$localStorage', '$http', '$window', '$timeout', 'Sockets', 'OutletService', 'UserService', 'hotkeys', '$rootScope', 'SearchFunctionWebsiteModal', '$state', '$element', 'SwitchAccountFunctionWebsiteModal', 'EnvironmentService', 'OutletReports', function ($scope, $location, Authentication, BirthdayService, Menus, CurrentShift, UserAccounts, toaster, FhdMessenger, $localStorage, $http, $window, $timeout, Sockets, OutletService, UserService, hotkeys, $rootScope, SearchFunctionWebsiteModal, $state, $element, SwitchAccountFunctionWebsiteModal, EnvironmentService, OutletReports) {
  OutletService.all();
  UserService.allStaffs(_.noop);
  $scope.authentication = Authentication;
  $scope.user = Authentication.user;
  const user = Authentication.user;
  $scope.isCollapsed = false;
  $scope.menu = Menus.getMenu('topbar');
  $scope.currentShift = CurrentShift.getCurrentShift();
  $scope.emailEncrypt = $window.md5(Authentication.user.email);
  $scope.isAdminStory = _.intersection($scope.user.roles, ['story:add', 'admin']).length;
  $scope.environment = EnvironmentService.getEnvironment();
  $scope.notDoneOutletReports = [];

  $scope.hasRoles = function (roles) {
    // console.log(!!_.intersection(user.roles, roles).length)
    return !!_.intersection(user.roles, roles).length;
  };

  $scope.toggleCollapsibleMenu = function () {
    $scope.isCollapsed = !$scope.isCollapsed;
  };

  $scope.hideForWeakPassword = () => {
    if (Authentication.user && $localStorage.get('needChangePassword') === 'true') {
      $state.go('password');
      $rootScope.hideMenu = true;
      FhdMessenger.errorStick('Password của bạn đang ở chế độ mặc định. Vì lý do bảo mật, hãy đổi sang password khác nhé!');
    }
  };
  /* infinite scroll for memo notices */


  const noticeListElements = $element.find('#list-memo-notices');
  noticeListElements.on('scroll', function () {
    if (noticeListElements[0].scrollTop + noticeListElements[0].offsetHeight >= noticeListElements[0].scrollHeight) {
      $scope.findNotice();
    }
  });
  $scope.isLoadingMemoNotices = false;
  $scope.notices = [];

  $scope.findNotice = function () {
    if (!user) return;

    if ($scope.isLoadingMemoNotices) {
      return;
    }

    $scope.isLoadingMemoNotices = true;
    const skip = $scope.notices.length;
    UserAccounts.Notices.query({
      skip
    }).$promise.then(notices => {
      if (!notices) $scope.unreadNotices = 0;else {
        $scope.notices = [...$scope.notices, ...notices];

        _.forEach($scope.notices, function (notice) {
          notice.timeFromNow = moment(notice.created).fromNow();
          notice.emailEncrypt = notice.user ? $window.md5(notice.user.email) : null;
        });

        $scope.groupNotice = _.groupBy($scope.notices, notice => {
          if (notice.link && (notice.link.includes('memos') || notice.message.match(/vừa thêm story/gi))) {
            return 'MEMO';
          }

          return 'OTHER';
        });
        $scope.unreadMemoNotices = _.filter($scope.groupNotice.MEMO, function (notice) {
          return _.includes(notice.receivers, user._id);
        }).length;
        $scope.unreadOtherNotices = _.filter($scope.groupNotice.OTHER, function (notice) {
          return _.includes(notice.receivers, user._id);
        }).length;
      }
    }).finally(() => {
      $scope.isLoadingMemoNotices = false;
    });
  };

  $scope.readAllNotice = function (type) {
    if (_.get($scope.groupNotice, `${type}.length`, 0) === 0) return;
    $http.get('/notices/read-all', {
      params: {
        type
      }
    }).then(function () {
      type === `MEMO` ? $scope.unreadMemoNotices = 0 : $scope.unreadOtherNotices = 0;
    }, function (err) {
      const data = err.data;
      FhdMessenger.errorFromServer(data);
    });
  };

  $scope.findOutletReportNotDone = function () {
    if (!_.get($scope.currentShift, '_id') || !_.get($scope.currentShift, 'shiftRecordId', '').match(/[MES]\d+/) || !_.get($window, 'location.href', '').match(/my-home/)) {
      return;
    }

    OutletReports.getOutletReportNotDone({
      currentShiftOutlet: _.get($scope.currentShift, 'outlet._id')
    }).$promise.then(data => {
      $scope.notDoneOutletReports = data;
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  $scope.readNotice = function (notice, index) {
    const ntc = new UserAccounts.Notices(notice);
    ntc.$read(function () {
      $scope.notices.splice(index, 1);
    }, function (err) {
      toaster.error(err.data.message);
    });
  };

  $scope.viewNotice = function (notice) {
    if (notice.link) {
      $location.path(notice.link);
    }
  };

  $scope.openCurrentShiftModal = function () {
    const currentShiftModal = CurrentShift.currentShiftModal();
    currentShiftModal.result.then(function (shiftRecord) {
      $scope.currentShift = shiftRecord;
      $localStorage.setObject('currentShift', shiftRecord);
      $scope.findOutletReportNotDone();
    });
  };

  $scope.exitCurrentShift = function () {
    CurrentShift.resetCurrentShift();
  };

  Sockets.on('notice', function (data) {
    const userId = Authentication.user._id;

    if (_.includes(data.receivers, userId)) {
      $scope.notices = [];
      $scope.notices.unshift(data);
      $scope.findNotice();
      FhdMessenger.notifyNotice(data);
    }
  });
  Sockets.on('new version', function (data) {
    if (data && data.message) {
      FhdMessenger.notifySticky(data.message);
    } else {
      const roles = _.get(user, 'roles') || [];

      if (_.includes(roles, 'admin') || _.includes(roles, 'admin-merchandise')) {
        FhdMessenger.notifySticky('Hệ thống có cập nhật mới. Nhấn CTRL + SHIFT + R để tải lại trang web.');
      } else {
        const fullUrl = $window.encodeURIComponent($location.absUrl());
        FhdMessenger.notifySticky(`
            Có cập nhật mới. Trang web sẽ tự động tải lại trong 30 giây.
            <br/>
            <a class="label labe-success" href="/refresh?url=${fullUrl}">
              <strong>Tải lại ngay</strong>
            </a>
          `);
        $timeout(() => {
          $window.location.reload();
        }, 30000);
      }
    }

    $scope.$apply();
  });
  Sockets.on('newOnlineOrder', function (onlineOrder) {
    FhdMessenger.notifySticky(`
        Có đơn hàng online mới. Mã ${onlineOrder.onlineOrderId}
        <br/>
        <a href="/#!/online-orders" target="_blank">
          Xem online orders
        </a>
      `);
    $scope.$apply();
  }); // Collapsing the menu after navigation

  $scope.$on('$stateChangeSuccess', function () {
    $scope.isCollapsed = false;
  }); //  4handy Birthday

  $scope.abbyBirthday = function () {
    if (['cypress', 'test'].includes($scope.environment)) return;

    if (!$scope.authentication.user) {
      return;
    }

    $scope.showWelcome = false;
    const viedAbbyBirthdayModal = $localStorage.get('viedAbbyBirthdayModal');
    const now = moment();

    if (moment().isBefore('2022-01-09')) {
      return;
    }

    if (moment().isAfter('2022-01-18')) {
      return;
    }

    if (!viedAbbyBirthdayModal || [true, 'true', 'null', 'undenfined', null, undefined].includes(viedAbbyBirthdayModal) || moment(now).diff(viedAbbyBirthdayModal, 'days') >= 1) {
      $scope.showWelcome = true;
      BirthdayService.showInvitationCardModal();
      $localStorage.set('viedAbbyBirthdayModal', now);
    }
  };

  hotkeys.bindTo($rootScope).add({
    combo: 'ctrl+shift+f',
    description: 'Print',
    callback: SearchFunctionWebsiteModal.view
  });

  if ($scope.environment === 'development') {
    hotkeys.bindTo($rootScope).add({
      combo: 'ctrl+shift+u',
      description: 'swich user',
      callback: SwitchAccountFunctionWebsiteModal.view
    });
  }
}]);
'use strict';

angular.module('core').controller('HomeController', ['$scope', 'Authentication', '$location', '$window', 'Sockets', 'FhdMessenger', '$timeout', '$localStorage', function ($scope, Authentication, $location, $window, Sockets, FhdMessenger, $timeout, $localStorage) {
  // This provides Authentication context.
  const vm = this;
  vm.user = Authentication.user;

