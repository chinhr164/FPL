angular.module('support-entries').controller('ModalUpdateSupportEntryController', ['supportEntryId', 'Authentication', '$state', 'CurrentShift', 'NgTableParams', 'OutletService', 'SupportEntries', 'SupportOptions', 'FhdMessenger', 'ObjectId', 'UserPhotoService', function (supportEntryId, Authentication, $state, CurrentShift, NgTableParams, OutletService, SupportEntries, SupportOptions, FhdMessenger, ObjectId, UserPhotoService) {
