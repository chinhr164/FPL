    }
  });
}]);
'use strict';

angular.module('deliver-entries').controller('DeliverEntriesController', ['$location', '$scope', '$state', '$stateParams', '$timeout', '$window', 'helper', 'toaster', 'Authentication', 'ComplaintService', 'CurrentShift', 'ConfirmModal', 'DeliverEntries', 'DeliverEntryService', 'JsPrintService', 'FhdMessenger', 'hotkeys', 'NgTableParams', 'ObjectId', 'ResourcesService', 'StockEntries', 'StockEntryService', 'ExpenseEntryService', function ($location, $scope, $state, $stateParams, $timeout, $window, helper, toaster, Authentication, ComplaintService, CurrentShift, ConfirmModal, DeliverEntries, DeliverEntryService, JsPrintService, FhdMessenger, hotkeys, NgTableParams, ObjectId, ResourcesService, StockEntries, StockEntryService, ExpenseEntryService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.toCheck = false;
  vm.openCreateComplaintModal = ComplaintService.openCreateComplaintModal;
  vm.isAdmin = _.intersection(['admin', 'accountant'], vm.user.roles).length;
  vm.deliverEntry = {
    stockEntries: [],
    transporter: {
      transporterService: '',
      billNumber: ''
    },
    shippingTools: DeliverEntryService.getShippingTools()
  };
  vm.removeValueFromArray = helper.removeValueFromArray;
  vm.data = {};

  vm.getTransporterService = function () {
    vm.listTransporterServices = DeliverEntryService.getTransporterService();
    async.parallel([ResourcesService.staffs(false)], function (err, results) {
      if (err) {
        toaster.error(err.message);
        return;
      }

      vm.data.staffs = results[0];
    });
    vm.deliverEntry.processStaffs = [];
  };

  vm.pushTypeAhead = function (item) {
    vm.deliverEntry.processStaffs = vm.deliverEntry.processStaffs || [];
    if (!item) return;

    const checkDuplicate = _.find(vm.deliverEntry.processStaffs, item);

    if (!checkDuplicate) {
      vm.deliverEntry.processStaffs.push(_.cloneDeep(item));
    }

    item = null;
    clearInput();
  };

  function clearInput() {
    vm.staffSearch = null;
  }

  vm.openConfirmDeliverEntryModal = function (deliverEntry) {
    DeliverEntryService.openConfirmDeliverEntryModal(deliverEntry).result.then(({
      deliverEntry,
      returnDeliverEntry,
      stockEntries
    }) => {
      FhdMessenger.success('Confirm thành công');
      vm.stockEntries = stockEntries;

      if (returnDeliverEntry) {
        vm.returnDeliverEntry = returnDeliverEntry;
        $timeout(() => {
          JsPrintService.printElementById('return-deliver-entry', false);
        }, 500);
      }

      vm.savedDeliverEntry = deliverEntry;
      vm.deliverEntry = deliverEntry;
      $timeout(() => {
        JsPrintService.printElementById('deliver-entry-print', false);
      }, 500);
    });
  };

  vm.openAddBillNumberModal = deliverEntry => {
    DeliverEntryService.openAddBillNumberModal(deliverEntry).result.then(deliverEntry => {
      vm.deliverEntry = deliverEntry;
    });
  };

  vm.openEditDeliverEntryModal = DeliverEntryService.openEditDeliverEntryModal;
  vm.openViewModalStockEntry = StockEntryService.openViewModalStockEntry;

  vm.initFind = function () {
    vm.statusMap = {
      delivered: true,
      received: false
    };
    vm.endDate = moment().format('YYYY-MM-DD');
    vm.startDate = moment(vm.endDate).subtract(3, 'week').format('YYYY-MM-DD');
  };

  vm.findOne = function () {
    vm.deliverEntry = DeliverEntries.get({
      deliverEntryId: $stateParams.deliverEntryId
    });
  };

  vm.create = function () {
    const outletCode = _.get(vm.deliverEntry, 'outlet.code', '');

    const destinationCode = _.get(vm.deliverEntry, 'destination.code', '');

    if (outletCode === destinationCode) {
      return FhdMessenger.error('Cơ sở nhận không được trùng với cơ sở gửi');
    }

    const transporterService = _.get(vm.deliverEntry, 'transporter.transporterService');

    if (!transporterService) {
      return FhdMessenger.error('Chưa chọn đơn vị vận chuyển');
    }

    if (!_.get(vm.deliverEntry, 'stockEntries.length') && transporterService !== 'chuHung') {
      return FhdMessenger.error('Chưa có danh sách Logistic Entries chuyển đi');
    }

    if (vm.deliverEntry.outlet.region === 'NORTH' && vm.deliverEntry.destination.region === 'NORTH' && _.some(vm.deliverEntry.shippingTools, shippingTool => {
      return !_.isNumber(shippingTool.quantity);
    })) {
      return FhdMessenger.error('Bạn chưa điền số lượng thùng nhựa/nắp thùng nhựa đã sử dụng');
    }

    if (transporterService === 'chuHung') {
      vm.deliverEntry.deliverFee = 20000;
    } else if (['ahamove', 'Lalamove'].includes(transporterService) && !vm.deliverEntry.transporter.billNumber) {
      return FhdMessenger.error('Chưa điền mã Ahamove hoặc Lalamove');
    } else if (['khoStaff', 'tricycle'].includes(transporterService) && !vm.deliverEntry.deliverFee) {
      return FhdMessenger.error('Chưa điền chi phí ');
    }

    if (!_.get(vm.deliverEntry, 'processStaffs.length')) {
      return FhdMessenger.error('Chưa có danh sách nhân viên xử lý');
    }

    if (_.some(vm.deliverEntry.stockEntries, stockEntry => {
      return stockEntry.destination.code !== destinationCode;
    })) {
      return FhdMessenger.error(`Có LE trong danh sách không cùng nơi nhận với DE`);
    }

    if (vm.notScannedStockEntries.length > 0) {
      ConfirmModal.showModal({}, {
        closeButtonText: 'Kiểm tra lại',
        actionButtonText: 'Tạo DE',
        headerText: `Bạn còn ${vm.notScannedStockEntries.length} Logistic Entry chưa có trong DE, bạn có muốn tạo không?`
      }).then(() => {
        create();
      });
    } else {
      create();
    }
  };

  function create() {
    vm.deliverEntry.notes = vm.note ? [{
      content: vm.note,
      user: ObjectId.getObjectId(vm.user)
    }] : [];
    const deliverEntry = new DeliverEntries(vm.deliverEntry);
    vm.waiting = true;
    deliverEntry.$save().then(deliverEntry => {
      FhdMessenger.success('Tạo xong!');
      return DeliverEntries.get({
        deliverEntryId: _.get(deliverEntry, '_id')
      }).$promise.then(newDeliverEntry => {
        vm.savedDeliverEntry = newDeliverEntry;
        $timeout(() => {
          JsPrintService.printElementById('deliver-entry-print', false);
        }, 500);
      });
    });
    vm.deliverEntry = {
      processStaffs: [],
      outlet: null,
      destination: null,
      transporter: {
        billNumber: null
      },
      deliverFee: null,
      stockEntries: []
    };
    vm.note = '';
  }

  vm.printRemainStockEntry = function () {
    $timeout(() => {
      JsPrintService.printElementById('remain-stock-entry-print', true);
    }, 200);
  };

  vm.addStockEntry = function (id) {
    const stockEntry = StockEntries.search({
      searchString: id
    });
    stockEntry.$promise.then(() => {
      vm.stockEntryId = null;

      if (!stockEntry) {
        return FhdMessenger.error('Logistic vừa nhập không nằm trong danh sách được chuyển đi từ cơ sơ');
      }

      if (vm.deliverEntry.destination.code !== stockEntry.destination.code) {
        return FhdMessenger.error(`Logistic ${stockEntry.stockEntryId} có cơ sở nhận là ${stockEntry.destination.code} khác với cơ sở nhận của DE là ${vm.deliverEntry.destination.code}`);
      }

      if (stockEntry.deliverEntry) {
        if (_.get(stockEntry, 'outlet.region') === _.get(stockEntry, 'destination.region') || _.get(stockEntry, 'destination.code') === _.get(stockEntry, 'deliverEntry.destination.code')) {
          return FhdMessenger.error('LE đã nằm trong danh sách của DE khác');
        }
      }

      if (stockEntry.disableTranfer) {
        return FhdMessenger.error('LE này không được chuyển đi cơ sở do cơ sở hết chỗ chứa');
      }

      let newStockEntry = null;
      newStockEntry = {
        stockEntry: ObjectId.getObjectId(stockEntry),
        stockEntryId: stockEntry.stockEntryId,
        destination: stockEntry.destination,
        inputTime: moment().toDate()
      };

      const matchStockEntryIndex = _.findIndex(vm.deliverEntry.stockEntries, stockEntry => {
        return stockEntry.stockEntryId === newStockEntry.stockEntryId;
      });

      if (matchStockEntryIndex > -1) {
        ConfirmModal.showModal({}, {
          closeButtonText: 'Không xóa',
          actionButtonText: 'Xóa LE',
          headerText: `Xóa Logistic Entry ${id} ra khỏi danh sách?`
        }).then(() => {
          vm.deliverEntry.stockEntries.splice(matchStockEntryIndex, 1);
          refeshListNotScanedStockEntries();
        });
      } else {
        vm.deliverEntry.stockEntries.push(newStockEntry);
        refeshListNotScanedStockEntries();
      }
    });
    stockEntry.$promise.catch(FhdMessenger.errorFromServer);
  };

  vm.deliverEntriesTable = new NgTableParams({
    count: 10
  });

  vm.find = function () {
    const searchText = vm.searchText;

    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const currentShift = CurrentShift.getCurrentShift();

    const currentShiftOutlet = _.get(currentShift, 'outlet._id');

    const startDate = vm.startDate ? moment(vm.startDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    const endDate = vm.endDate ? moment(vm.endDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    FhdMessenger.info('Đang tìm kiếm');
    vm.deliverEntries = DeliverEntries.query({
      searchText,
      statuses,
      startDate,
      endDate,
      currentShiftOutlet
    }, function () {
      FhdMessenger.success('Đã tìm xong');
      vm.deliverEntries = _.map(vm.deliverEntries, deliverEntry => {
        deliverEntry.paymentStatus = deliverEntry.paymentStatus || 'unpaid';
        return deliverEntry;
      });
      vm.deliverEntriesTable.settings({
        dataset: vm.deliverEntries
      });
    });
  };

  vm.createExpenseEntryForDE = function () {
    const deliverEntries = _.filter(vm.deliverEntriesTable.data, 'value');

    if (!deliverEntries.length) {
      return FhdMessenger.error('Chưa có DE nào được chọn');
    }

    if (!_.every(deliverEntries, 'deliverFee')) {
      return FhdMessenger.error('Có DE chưa có chi phí');
    }

    if (_.some(deliverEntries, deliverEntry => deliverEntry.paymentStatus === 'paid')) {
      return FhdMessenger.error('Có DE đã tạo khoản chi');
    }

    const transporterService = _.get(_.head(deliverEntries), 'transporter.transporterService', null);

    if (!_.every(deliverEntries, deliverEntry => deliverEntry.transporter.transporterService === transporterService)) {
      return FhdMessenger.error('Có DE không cùng loại vận chuyển');
    }

    ExpenseEntryService.createExpenseEntry(null, deliverEntries);
  };

  vm.selectAll = function () {
    _.forEach(vm.deliverEntriesTable.data, deliverEntry => {
      deliverEntry.value = vm.toCheck;
    });
  };

  vm.transporterService = () => {
    const listTransporterServices = DeliverEntryService.getTransporterService();
    return _.map(listTransporterServices, transporter => ({
      title: transporter.name,
      id: transporter.value
    }));
  };

  vm.selectAllStatus = function () {
    let changeValue = true;
    if (_.every(vm.statusMap)) changeValue = false;

    _.forEach(vm.statusMap, (value, key) => {
      vm.statusMap[key] = changeValue;
    });
  };

  vm.searchKeyUp = function ($event) {
    if ($event.keyCode === 13) {
      vm.addStockEntry(vm.stockEntryId);
    }
  };

  vm.removeStockEntry = function (index, id) {
    vm.stockEntries.splice(index, 1);
  };

  vm.calculateTransportTime = function (received, delivered) {
    if (!received) {
      return 'Chưa về hàng';
    }

    const totalTransportTime = moment(received).diff(moment(delivered));
    const duration = moment.duration(totalTransportTime);
    const day = duration.days();
    const dayDisplay = day ? `${day}d` : '';
    const hours = duration.hours();
    const hoursDisplay = hours ? `${hours}h` : '';
    const minutes = duration.minutes();
    const minutesDisplay = minutes ? `${minutes}'` : '';
    return `${dayDisplay}${hoursDisplay}${minutesDisplay}`;
  };

  vm.printDeliverEntry = function () {
    vm.savedDeliverEntry = vm.deliverEntry;
    $timeout(() => {
      JsPrintService.printElementById('deliver-entry-print', true);
    }, 0);
  };

  vm.selectBusinessCustomer = businessCustomer => {
    vm.deliverEntry.businessCustomer = businessCustomer;
    vm.getNumNeedScannedStockEntries();
  };

  vm.getNumNeedScannedStockEntries = () => {
    vm.waiting = true;
    const outletId = ObjectId.getObjectId(vm.deliverEntry.outlet);
    const destinationId = ObjectId.getObjectId(vm.deliverEntry.destination);
    const businessCustomerId = ObjectId.getObjectId(vm.deliverEntry.businessCustomer);
    if (outletId === destinationId) return;
    StockEntries.checkNotScanned({
      outlet: outletId,
      businessCustomerId,
      destination: destinationId
    }).$promise.then(res => {
      vm.needScannedStockEntries = _.map(res.result, stockEntry => {
        stockEntry.totalWeight = _.sumBy(stockEntry.items, item => {
          return _.get(item, 'product.netWeight', 0) * item.quantity;
        });
        return stockEntry;
      });
      refeshListNotScanedStockEntries();
    }).finally(() => {
      vm.waiting = false;
    });
  };

  function refeshListNotScanedStockEntries() {
    vm.notScannedStockEntries = _.reject(vm.needScannedStockEntries, needScanedStockEntry => {
      return _.some(vm.deliverEntry.stockEntries, stockEntry => {
        return stockEntry.stockEntry === needScanedStockEntry._id;
      });
    });
  }

  hotkeys.bindTo($scope).add({
    combo: 'ctrl+p',
    description: 'Print',
    callback: vm.printDeliverEntry
  });

  vm.delete = () => {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xóa`,
      headerText: `Bạn có muốn xóa Deliver Entry này?`,
      bodyText: `Bạn chắc chắn muốn xóa Deliver Entry này?`
    }).then(() => {
      vm.waiting = true;
      vm.deliverEntry.$delete().then(() => {
        FhdMessenger.success('Đã xóa Deliver Entry này!');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(vm.waiting = false);
    });
  };
}]);
'use strict';

angular.module('deliver-entries').controller('EditDeliverEntryController', ['$state', '$stateParams', 'Authentication', 'CurrentShift', 'DeliverEntries', 'DeliverEntryService', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'StockEntries', function ($state, $stateParams, Authentication, CurrentShift, DeliverEntries, DeliverEntryService, FhdMessenger, NgTableParams, ObjectId, StockEntries) {
  const vm = this;
  vm.user = Authentication.user;
  vm.stockEntries = [];
  vm.listTransporterServices = DeliverEntryService.getTransporterService();

  vm.findOne = function () {
    vm.deliverEntry = DeliverEntries.get({
      deliverEntryId: $stateParams.deliverEntryId
    });
  };

  vm.addStockEntry = function (id, type) {
    const stockEntry = StockEntries.search({
      searchString: id
    });
    stockEntry.$promise.then(() => {
      vm.stockEntryId = null;

      if (!stockEntry) {
        return FhdMessenger.error('Logistic vừa nhập không nằm trong danh sách được chuyển đi từ cơ sơ');
      }

      let newStockEntry = null;
      newStockEntry = {
        stockEntry: ObjectId.getObjectId(stockEntry),
        stockEntryId: stockEntry.stockEntryId
      };
      let matchStockEntryIndex = null;

      switch (type) {
        case 'stockEntry':
          matchStockEntryIndex = _.findIndex(vm.deliverEntry.stockEntries, stockEntry => {
            return stockEntry.stockEntryId === newStockEntry.stockEntryId;
          });

          if (matchStockEntryIndex > -1) {
            FhdMessenger.error('Logistic Entry này đã có trong danh sách chuyển đi');
          } else {
            vm.deliverEntry.stockEntries.push(newStockEntry);
          }

          vm.restockEntryId = '';
          break;

        case 'returnStockEntry':
          matchStockEntryIndex = _.findIndex(vm.deliverEntry.returnStockEntries, stockEntry => {
            return stockEntry.stockEntryId === newStockEntry.stockEntryId;
          });

          if (matchStockEntryIndex > -1) {
            FhdMessenger.error('Logistic Entry này đã có trong danh sách thu hồi');
          } else {
            vm.deliverEntry.returnStockEntries.push(newStockEntry);
          }

          vm.returnStockEntryId = '';
          break;

        default:
          FhdMessenger.error('Có lỗi khi thêm stock entry');
          break;
      }
    });
  };

  vm.removeStockEntry = function (index, type) {
    switch (type) {
      case 'stockEntry':
        vm.deliverEntry.stockEntries.splice(index, 1);
        break;

      case 'returnStockEntry':
        vm.deliverEntry.returnStockEntries.splice(index, 1);
        break;

      default:
        FhdMessenger.error('Có lỗi khi xóa danh sách stock entry');
        break;
    }
  };

  vm.update = function () {
    if (vm.newNote) {
      vm.deliverEntry.notes.push({
        content: vm.newNote,
        user: vm.user
      });
    }

    vm.waiting = true;
    vm.deliverEntry.$update().then(() => {
      $state.reload();
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = true;
    });
  };

  vm.searchKeyUp = function ($event, type) {
    if ($event.keyCode === 13) {
      switch (type) {
        case 'stockEntry':
          vm.addStockEntry(vm.stockEntryId, 'stockEntry');
          break;

        case 'returnStockEntry':
          vm.addStockEntry(vm.returnStockEntryId, 'returnStockEntry');
          break;

        default:
          return FhdMessenger.error('Lỗi khi thêm Ligistic Entry');
      }
    }
  };
}]);
"use strict";

angular.module('deliver-entries').controller('ModalAddBillNumberForDeliverEntryController', ['deliverEntry', 'DeliverEntries', '$modalInstance', 'FhdMessenger', function (deliverEntry, DeliverEntries, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.deliverEntry = DeliverEntries.get({
    deliverEntryId: deliverEntry._id
  });

  vm.addBillNumber = function () {
    if (!vm.billNumber) {
      return FhdMessenger.error('Chưa có mã đơn ahamove');
    }

    vm.deliverEntry.transporter = vm.deliverEntry.transporter || {};
    vm.deliverEntry.transporter.billNumber = vm.billNumber;
    vm.deliverEntry.$addBillNumber().then(deliverEntry => {
      $modalInstance.close(deliverEntry);
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
'use strict';

angular.module('deliver-entries').controller('ConfirmDeliverEntryModalController', ['$modalInstance', 'deliverEntry', 'Authentication', 'CurrentShift', 'DeliverEntries', 'DeliverEntryService', 'FhdMessenger', 'ObjectId', 'StockEntries', '$state', function ($modalInstance, deliverEntry, Authentication, CurrentShift, DeliverEntries, DeliverEntryService, FhdMessenger, ObjectId, StockEntries, $state) {
  const vm = this;
  vm.user = Authentication.user;
  vm.shippingTools = DeliverEntryService.getShippingTools();

  vm.init = function () {
    vm.deliverEntry = deliverEntry;

    if (vm.deliverEntry.outlet.code === 'D2') {
      vm.hideReturnStockEntry = true;
      vm.noReturnStockEntries = true;
    }

    vm.stockEntries = [];
  };

  vm.addReturnStockEntry = function () {
    const stockEntry = StockEntries.search({
      searchString: vm.returnStockEntryId
    });
    stockEntry.$promise.then(() => {
      vm.stockEntries = vm.stockEntries || [];
      vm.returnStockEntryId = undefined;

      if (!stockEntry) {
        return FhdMessenger.error('Không tìm thấy Logistic Entry tương ứng');
      }

      if (stockEntry.outlet.region === 'NORTH' && (!ObjectId.equals(stockEntry.destination, vm.deliverEntry.outlet) || !ObjectId.equals(stockEntry.outlet, vm.deliverEntry.destination))) {
        return FhdMessenger.error('LE có nơi gửi và nơi nhận không khớp với DE thu hồi');
      }

      let newStockEntry = null;
      newStockEntry = {
        stockEntry: ObjectId.getObjectId(stockEntry),
        stockEntryId: stockEntry.stockEntryId
      };

      const matchStockEntry = _.find(vm.stockEntries, {
        stockEntryId: newStockEntry.stockEntryId
      });

      if (matchStockEntry) {
        return FhdMessenger.error('Logistic Entry này đã có trong danh sách');
      }

      vm.stockEntries.push(newStockEntry);
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.addWrongStockEntry = function () {
    const stockEntry = StockEntries.search({
      searchString: vm.wrongStockEntryId
    });
    stockEntry.$promise.then(() => {
      vm.wrongStockEntries = vm.wrongStockEntries || [];
      vm.wrongStockEntryId = undefined;

      if (!stockEntry) {
        return FhdMessenger.error('Không tìm thấy Logistic Entry tương ứng');
      }

      let newStockEntry = null;
      newStockEntry = {
        stockEntry: ObjectId.getObjectId(stockEntry),
        stockEntryId: stockEntry.stockEntryId,
        wrongType: 'missing'
      };

      const matchStockEntry = _.find(vm.wrongStockEntries, {
        stockEntryId: newStockEntry.stockEntryId
      });

      if (matchStockEntry) {
        return FhdMessenger.error('Logistic Entry này đã có trong danh sách');
      }

      vm.wrongStockEntries.push(newStockEntry);
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.searchKeyUpReturn = function ($event) {
    if ($event.keyCode === 13) {
      vm.addReturnStockEntry();
    }
  };

  vm.searchKeyUpWrong = function ($event) {
    if ($event.keyCode === 13) {
      vm.addWrongStockEntry();
    }
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.confirm = function () {
    if (!vm.noProblem && !vm.newNote) {
      return FhdMessenger.error('Chưa có ghi chú các vấn đề chuyển hàng đến cơ sở');
    }

    if (!vm.noReturnStockEntries && !vm.stockEntries.length) {
      return FhdMessenger.error('Chưa có danh sách logistic entry thu hồi');
    }

    const notes = [vm.newNote, vm.stockEntriesNote];
    vm.returnStockEntries = vm.stockEntries;
    vm.deliverEntry.receivedBy = vm.user;
    vm.waiting = true;
    DeliverEntries.confirm({
      _id: _.get(vm.deliverEntry, '_id'),
      returnStockEntries: vm.stockEntries,
      wrongStockEntries: vm.wrongStockEntries,
      // shippingTools: vm.shippingTools,
      receivedBy: vm.user,
      deliverFee: vm.deliverEntry.deliverFee,
      notes
    }).$promise.then(({
      deliverEntry,
      returnDeliverEntry,
      stockEntries
    }) => {
      $modalInstance.close({
        deliverEntry,
        returnDeliverEntry,
        stockEntries
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
      $modalInstance.close();
    });
  };

  vm.removeStockEntry = function (index, stockEntries) {
    stockEntries.splice(index, 1);
  };

  vm.updateNoProblem = function () {
    if (vm.noProblem) {
      vm.wrongStockEntries = [];
      vm.newNote = 'Hàng chuyển đến không có vấn đề';
    }
  };

  vm.updateNoReturnStockEntries = function () {
    if (vm.noReturnStockEntries) {
      vm.stockEntries = [];
      vm.stockEntriesNote = 'Không có hàng thu hồi';
    }
  };
}]);
'use strict';

angular.module('deliver-entries').controller('AddDeliverFeeModalController', ['$modalInstance', 'Authentication', 'deliverEntry', 'DeliverEntries', 'DeliverEntryService', 'FhdMessenger', 'ObjectId', 'StockEntries', function ($modalInstance, Authentication, deliverEntry, DeliverEntries, DeliverEntryService, FhdMessenger, ObjectId, StockEntries) {
