// Outlet Report controller
angular.module('outlet-reports').controller('OutletReportsController', ['CurrentShift', 'FhdMessenger', 'JsPrintService', 'OutletReports', 'StockMap', '$stateParams', 'NgTableParams', 'OnlineOrderService', '$location', '$state', 'ConfirmModal', 'OutletReportService', 'Authentication', 'ObjectId', 'helper', '$window', function (CurrentShift, FhdMessenger, JsPrintService, OutletReports, StockMap, $stateParams, NgTableParams, OnlineOrderService, $location, $state, ConfirmModal, OutletReportService, Authentication, ObjectId, helper, $window) {
  const vm = this;
  vm.user = Authentication.user;
  vm.data = {
    statuses: ['created', 'processing', 'done', 'void']
  };
  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus;
  vm.data.allTypes = OutletReportService.getTypes();
  vm.data.types = _.reject(vm.data.allTypes, type => {
    return ['update-stock', 'transfer'].includes(type.id);
  });
  const defaultState = 'listOutletReports';
  vm.outletReport = {
    outlets: []
  };
  vm.statusMap = {
    created: true,
    processing: true,
    done: false,
    void: false
  };
  vm.typeMap = {
    'check-label': false,
    'update-stock': false,
    transfer: false,
    'check-product': false,
    'check-store': false,
    'checklist-entry': false,
    other: false
  };

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.selectedOutletIds = _.map(selectedOutlets, '_id');
    vm.selectedOutletCodes = _.map(selectedOutlets, 'code');
  };

  vm.autoCreateTitle = () => {
    if (vm.outletReport.type === 'checklist-entry') {
      vm.outletReport.title = 'Xử lý vấn đề trong checklist cơ sở ';
    }
  };

  vm.updateProductTable = products => {
    vm.productTable.settings({
      dataset: products
    });
    vm.productTable.reload();
  };

  vm.productSearchSelected = item => {
    vm.outletReport.products = vm.outletReport.products || [];
    vm.outletReport.products.push(_objectSpread({}, item, {
      product: ObjectId.getObjectId(item)
    }));
    vm.updateProductTable(vm.outletReport.products);
  };

  vm.removeItem = index => {
    vm.outletReport.products.splice(index, 1);
    vm.updateProductTable(vm.outletReport.products);
  };

  vm.getStatuses = () => {
    return _.map(vm.statuses, status => {
      return {
        id: status,
        title: status
      };
    });
  };

  vm.create = function () {
    const outletReport = new OutletReports(vm.outletReport);
    outletReport.outlets = vm.selectedOutletIds; // send outlet codes to req.body to get list for noti

    outletReport.outletCodes = vm.selectedOutletCodes;
    const err = OutletReportService.validateCreateOutletReport(outletReport, true);

    if (err) {
      return FhdMessenger.error(err);
    }

    vm.waiting = true;
    return outletReport.$save().then(() => {
      $location.path('/outlet-reports/create');
      FhdMessenger.success(`Tạo Outlet Report thành công`);
      $state.reload();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = function (forEdit) {
    OutletReports.get({
      outletReportId: $stateParams.outletReportId
    }).$promise.then(outletReport => {
      if (forEdit && !outletReport.outlets.length) {
        return $state.go('doneOutletReport', {
          outletReportId: outletReport._id
        });
      }

      vm.outletReport = outletReport;

      if (vm.outletReport.products.length && vm.outletReport.outlet) {
        StockMap.getStockMapCache().then(stockMap => {
          vm.outletReport.products = _.map(vm.outletReport.products, product => {
            product.stock = Math.round(_.get(stockMap, `${product.product._id}.${vm.outletReport.outlet.code}`, 0) * 100) / 100;
            return product;
          });
          vm.updateProductTable(vm.outletReport.products);
        });
      }
    });
  };

  vm.update = function () {
    const outletReport = vm.outletReport;
    vm.waiting = true;
    return outletReport.$update().then(() => {
      $state.go('summarizeOutletReport');
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.done = function () {
    const outletReport = vm.outletReport;
    const err = OutletReportService.validateDoneOutletReport(outletReport, false);

    if (err) {
      return FhdMessenger.error(err);
    }

    vm.waiting = true;
    return outletReport.$done().then(() => {
      $state.go(defaultState);
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.markFailed = function () {
    const outletReport = vm.outletReport;
    vm.waiting = true;
    return outletReport.$markFailed().then(() => {
      $state.go(defaultState);
      FhdMessenger.success('Đánh dấu không đạt thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.addNote = function () {
    if (!vm.outletReport.content) {
      return FhdMessenger.error('Chưa nhập ghi chú');
    }

    const outletReport = vm.outletReport;
    outletReport.$addNote().then(outletReport => {
      vm.outletReport = outletReport;
      FhdMessenger.success('Thêm ghi chú thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.changeDeadline = function () {
    if (vm.outletReport.changeDeadline) {
      FhdMessenger.success('Outlet Report này đã được đổi deadline rồi');
    }

    const outletReport = vm.outletReport;
    vm.waiting = true;
    return outletReport.$changeDeadline().then(() => {
      FhdMessenger.success('Đổi deadline thành công');
      $state.reload();
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.outletReportsTable = new NgTableParams({
    count: 50
  });
  vm.productTable = new NgTableParams({
    count: 100
  });
  vm.summaryOutletReportsTable = new NgTableParams({
    count: 50
  });
  vm.startDate = moment().subtract(2, 'week').startOf('day').format('YYYY-MM-DD');
  vm.endDate = moment().startOf('day').format('YYYY-MM-DD');

  const processContent = outletReport => {
    const userContent = helper.convertObjectToText(outletReport.user, ['code', 'displayName'], ' - ');
    const outletContent = helper.convertObjectToText(outletReport.outlet, ['code', 'name'], ' - ');
    const region = OutletReportService.convertRegionToZone(_.get(outletReport, 'outlet.region'));
    const processorsContent = helper.joinArrayWithProperties(outletReport.processors, ['displayName'], ' - ');
    return {
      userContent,
      outletContent,
      region,
      processorsContent
    };
  };

  vm.find = function () {
    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const type = _.reduce(vm.typeMap, (types, toShow, type) => {
      if (toShow) types.push(type);
      return types;
    }, []);

    vm.waiting = true;
    OutletReports.query({
      startDate: vm.startDate,
      endDate: vm.endDate,
      outlets: vm.selectedOutletIds,
      currentShiftOutlet: _.get(CurrentShift.getCurrentShift(), 'outlet._id'),
      statuses,
      type
    }).$promise.then(outletReports => {
      vm.outletReports = _.map(outletReports, outletReport => {
        _.assign(outletReport, processContent(outletReport));

        return outletReport;
      });
      vm.outletReportsTable.settings({
        dataset: vm.outletReports
      });
      vm.summarize(outletReports);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.summarize = outletReports => {
    const summary = _.reduce(_.values(_.groupBy(outletReports, 'outlet.code')), (result, outletReports) => {
      const outletCode = _.get(_.head(outletReports), 'outlet.code');

      const total = outletReports.length;

      const doneTotal = _.filter(outletReports, {
        status: 'done'
      }).length;

      const processingTotal = _.filter(outletReports, {
        status: 'created'
      }).length;

      const lateTotal = _.filter(outletReports, outletReport => {
        if (outletReport.failed) {
          return false;
        }

        if (outletReport.status === 'created' && moment().isAfter(moment(outletReport.deadline))) {
          return true;
        }

        if (outletReport.status === 'done' && moment(outletReport.firstDone || outletReport.done).isAfter(moment(outletReport.deadline))) {
          return true;
        }

        return false;
      }).length;

      const latePercentage = Math.round(lateTotal / total * 10000) / 100;
      result.push({
        outletCode,
        total,
        doneTotal,
        processingTotal,
        lateTotal,
        latePercentage
      });
      return result;
    }, []);

    vm.summaryOutletReportsTable.settings({
      dataset: summary
    });
  };

  vm.changeProcessor = function (user) {
    vm.processor = null;
    vm.outletReport.processors = vm.outletReport.processors || [];

    if (_.some(vm.outletReport.processors, processor => {
      return _.isEqual(ObjectId.getObjectId(processor), ObjectId.getObjectId(user));
    })) {
      return FhdMessenger.error('Người xử lý đã tồn tại');
    }

    vm.outletReport.processors.push(user);
  };

  vm.removeProcessor = index => {
    vm.outletReport.processors.splice(index, 1);
  };

  vm.addProblem = product => {
    const problem = $window.prompt('Nhập thông tin vấn đề', _.get(product, 'problem', ''));

    if (!problem) {
      return FhdMessenger.error('Bạn chưa nhập thông tin vấn đề');
    }

    product.problem = problem;
  };

  vm.changeProcessor = function (user) {
    vm.processor = null;
    vm.outletReport.processors = vm.outletReport.processors || [];

    if (_.some(vm.outletReport.processors, processor => {
      return _.isEqual(ObjectId.getObjectId(processor), ObjectId.getObjectId(user));
    })) {
      return FhdMessenger.error('Người xử lý đã tồn tại');
    }

    vm.outletReport.processors.push(user);
  };

  vm.removeProcessor = index => {
    vm.outletReport.processors.splice(index, 1);
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      case 'type':
        let changeValue = true;
        if (_.every(vm.typeMap)) changeValue = false;

        _.forEach(vm.typeMap, (value, key) => {
          vm.typeMap[key] = changeValue;
        });

        break;

      default:
    }
  };

  vm.addProblem = product => {
    const problem = $window.prompt('Nhập thông tin vấn đề', _.get(product, 'problem', ''));

    if (!problem) {
      return FhdMessenger.error('Bạn chưa nhập thông tin vấn đề');
    }

    product.problem = problem;
  };

  vm.remove = function (outletReport, index) {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Huỷ',
      actionButtonText: 'Xóa',
      headerText: 'Xóa Outlet Report?',
      bodyText: `Bạn có chắc là bạn muốn xóa Outlet Report: ${outletReport.title} của cơ sở ${outletReport.outletContent}?`
    }).then(() => {
      vm.waiting = true;
      outletReport.$remove().then(() => {
        FhdMessenger.success(`Đã xoá !`); // Xoá một phần tử trong table tại index của phần tử đó

        vm.outletReportsTable.data.splice(index, 1);
        vm.outletReportsTable.settings({
          dataset: vm.outletReportsTable.data
        });
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.print = () => {
    if ($window.Cypress) return;
    const customStyle = true;
    const autoPrint = true;
    JsPrintService.printElementById('product-table', autoPrint, customStyle);
  };

  vm.now = () => {
    return moment().format('DD/MM HH:mm');
  };

  vm.min = () => {
    return moment().format('yyyy-MM-DDTHH:mm');
  };
}]);
