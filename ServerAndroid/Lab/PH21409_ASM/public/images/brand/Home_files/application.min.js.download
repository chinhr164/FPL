angular.module('sale-entries').controller('ModalComboInputController', ['$modalInstance', '$scope', 'FhdMessenger', 'comboProduct', function ($modalInstance, $scope, FhdMessenger, comboProduct) {
  const vm = this;

  vm.init = function () {
    vm.comboProduct = angular.copy(comboProduct);
  };

  function getMatchElemAndOption(item) {
    let matchComboElement;
    let matchItemOption;

    _.forEach(vm.comboProduct.comboElements, comboElement => {
      _.forEach(comboElement.itemOptions, itemOption => {
        if (itemOption.product === item._id) {
          matchItemOption = itemOption;
          matchComboElement = comboElement;
        }
      });
    });

    return [matchComboElement, matchItemOption];
  }

  vm.selectItem = function (item) {
    const [matchComboElement, matchItemOption] = getMatchElemAndOption(item);

    if (!matchItemOption) {
      FhdMessenger.error(`Không có sản phẩm ${item.sku} ${item.description} trong combo.`);
      return;
    }

    const currentQuantity = _.reduce(matchComboElement.selectedItems || [], (result, selectedItem) => {
      return result + selectedItem.countQuantity;
    }, 0);

    const countQuantity = matchItemOption.countAs || 1;
    const newQuantity = currentQuantity + countQuantity;

    if (newQuantity > matchComboElement.maxQuantity) {
      FhdMessenger.error(`Sản phẩm nhóm ${matchComboElement.name} vượt quá số lượng cho phép combo`);
      return;
    }

    const matchSelectedItem = _.find(matchComboElement.selectedItems || [], selectedItem => selectedItem.item._id === item._id);

    if (matchSelectedItem) {
      matchSelectedItem.countQuantity += countQuantity;
      matchSelectedItem.quantity += 1;
    } else {
      matchComboElement.selectedItems = matchComboElement.selectedItems || [];
      matchComboElement.selectedItems.push({
        item,
        countQuantity,
        quantity: 1
      });
    }
  };

  function hasAllComboElements(comboProduct) {
    return _.every(comboProduct.comboElements, comboElement => {
      if (comboElement.name.match(/tùy chọn/)) {
        return true;
      }

      const currentQuantity = _.reduce(comboElement.selectedItems || [], (result, selectedItem) => {
        return result + selectedItem.countQuantity;
      }, 0);

      return currentQuantity === comboElement.maxQuantity;
    });
  }

  vm.submit = function () {
    if (!hasAllComboElements(vm.comboProduct)) {
      FhdMessenger.error('Chưa có đủ sản phẩm trong combo.');
      return;
    }

    const selectedItems = _.compact(_.flatten(_.map(vm.comboProduct.comboElements, 'selectedItems')));

    $modalInstance.close(selectedItems);
  };

  vm.removeItem = function (index, items) {
    if (_.isArray(items)) {
      items.splice(index, 1);
    }
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
'use strict';

