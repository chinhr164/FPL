  }

  function openInfoModal(applicationForm) {
    return $modal.open({
      templateUrl: './modules/application-forms/views/modal-info-application-forms.client.view.html',
      controller: 'ModalInfoApplicationFormController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        applicationForm: () => applicationForm
      }
    });
  }

  function openModalSendEmail(applicationForm, emailType) {
    return $modal.open({
      templateUrl: './modules/application-forms/views/modal-send-email-for-application-forms.client.view.html',
      controller: 'ModalSendEmailForApplicationFormController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        applicationForm: () => applicationForm,
        emailType: () => emailType
      }
    });
  }

  function openModalSelectEmailType(applicationForm, type) {
    return $modal.open({
      templateUrl: './modules/application-forms/views/modal-select-email-type-for-application-forms.client.view.html',
      controller: 'ModalSelectEmailTypeForApplicationFormController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        applicationForm: () => applicationForm,
        type: () => type
      }
    });
  }

  function openCreateEvaluationForm(applicationForm) {
    return $modal.open({
      templateUrl: '/modules/application-forms/views/modal-create-evaluation-form.client.view.html',
      controller: 'ModalCreateEvaluationFormController',
      controllerAs: 'vm',
      resolve: {
        applicationForm: () => applicationForm
      }
    });
  }

  function openModalEditProcessorsApplicationForm(applicationForm) {
    return $modal.open({
      templateUrl: 'modules/application-forms/views/modal-edit-processors-application-form.client.view.html',
      controller: 'ModalEditProcessorsApplicationFormController',
      controllerAs: 'vm',
      resolve: {
        applicationForm: () => applicationForm
      }
    });
  }

  function openSendEmailModal() {
    return $modal.open({
      template: `
<div class="modal-header""><h2>Bạn có muốn gửi email cho ứng viên không?</h2></div>
<div class="modal-body">
  <form class="text-center">
    <button class="btn btn-primary" ng-click="vm.yes()">Có, gửi email ngay</button>
    <button class="btn btn-default" ng-click="vm.no()">Không gửi email</button>
  </form>
</div>
`,
      controllerAs: 'vm',
      controller: ['$modalInstance', function ($modalInstance) {
        const vm = this;

        vm.yes = () => {
          $modalInstance.close(true);
        };

        vm.no = () => {
          $modalInstance.close(false);
        };
      }]
    });
  }

  return {
    openArchivedApplicationFormModal,
    openViewApplicationFormModal,
    openModalSendEmail,
    openInputBlackListNote,
    openCreateStaffApplicationFormModal,
    openEmliminateApplicationFormModal,
    openSendEmailModal,
    openModalSelectEmailType,
    openCreateEvaluationForm,
    openSelectProbationShiftEntriesModal,
    openInfomationProbationShiftsModal,
    openInfoModal,
    openModalEditProcessorsApplicationForm
  };
}]);
