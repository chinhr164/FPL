angular.module('carton-entries').controller('CartonEntriesController', ['$document', '$stateParams', '$state', '$location', '$timeout', 'CurrentShift', 'JsPrintService', 'NgTableParams', 'OnlineOrderService', 'ObjectId', 'CartonEntryService', 'CartonEntries', 'FhdMessenger', 'Authentication', 'ConfirmModal', function ($document, $stateParams, $state, $location, $timeout, CurrentShift, JsPrintService, NgTableParams, OnlineOrderService, ObjectId, CartonEntryService, CartonEntries, FhdMessenger, Authentication, ConfirmModal) {
  const vm = this;
  vm.user = Authentication.user;
  vm.outlet = _.get(CurrentShift.getCurrentShift(), 'outlet');
  vm.cartonEntryTable = new NgTableParams({
    count: 1000
  });
  vm.now = new Date();

  vm.init = () => {
    vm.data = {
      statuses: ['created', 'done', 'deleted']
    };
    vm.statusMap = {
      created: true,
      done: false,
      deleted: false
    };
    vm.endDate = moment().format('YYYY-MM-DD');
    vm.startDate = moment(vm.endDate).subtract(1, 'month').format('YYYY-MM-DD');
  };

  vm.openEditCartonEntryModal = function (cartonEntry) {
    CartonEntryService.openEditCartonEntryModal(cartonEntry).then(() => {
      vm.find();
    });
  };

  vm.openDetailCartonEntryModal = CartonEntryService.openDetailCartonEntryModal;

  vm.openDeleteCartonEntryModal = function (cartonEntry) {
    CartonEntryService.openDeleteCartonEntryModal(cartonEntry);
  };

  vm.print = function (cartonEntries) {
    vm.cartonEntries = _.isArray(cartonEntries) ? cartonEntries : [cartonEntries];
    $timeout(() => {
      convertQrCodeSaleEntryToImage(cartonEntries);
      JsPrintService.printElementById('carton-entry-tag');
    }, 500);
  };

  vm.printCartonEntries = function () {
    const cartonEntries = _.filter(vm.cartonEntryTable.data, 'checked');

    ConfirmModal.showModal({}, {
      actionButtonText: `Đồng ý`,
      headerText: `Bạn muốn in các Carton Entries?`,
      bodyText: ''
    }).then(() => {
      vm.print(cartonEntries);
    });
  };

  function convertQrCodeSaleEntryToImage(cartonEntries) {
    _.forEach(cartonEntries, (cartonEntry, index) => {
      let id = '#qrcode-' + index;
      const qrCodeCanvas = $document[0].querySelector(id + ' > canvas');
      if (!qrCodeCanvas) return;
      let img = $document[0].createElement('img');
      img.src = qrCodeCanvas.toDataURL('image/png');
      const qrCode = $document[0].querySelector(id);
      qrCode.removeChild(qrCodeCanvas);
      qrCode.appendChild(img);
    });
  }

  vm.getLabelFromStatus = OnlineOrderService.getLabelFromStatus;

  vm.find = function () {
    const outlet = _.get(vm.outlet, '_id');

    const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
      if (toShow) statuses.push(status);
      return statuses;
    }, []);

    const startDate = vm.startDate ? moment(vm.startDate).subtract(1, 'month').format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    const endDate = vm.endDate ? moment(vm.endDate).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD');
    vm.waiting = true;
    CartonEntries.query({
      outlet,
      statuses,
      startDate,
      endDate
    }).$promise.then(cartonEntries => {
      vm.cartonEntryTable.settings({
        dataset: cartonEntries
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }
    }
  };

  vm.create = function () {
    if (!_.get(vm.vendor, '_id')) {
      return FhdMessenger.error('Bạn chưa chọn Vendor tương ứng');
    }

    if (!_.get(vm.outlet, '_id')) {
      return FhdMessenger.error('Bạn chưa đăng nhập ca trực');
    }

    if (!_.get(vm, 'numCartonEntry')) {
      return FhdMessenger.error('Bạn chưa nhập số lượng kiện về');
    }

    const vendor = vm.vendor._id;
    const outlet = vm.outlet._id;
    const numCartonEntry = vm.numCartonEntry;
    vm.waiting = true;
    CartonEntryService.createMulti(vendor, outlet, numCartonEntry).then(cartonEntries => {
      FhdMessenger.success('Bạn đã tạo thành công ' + cartonEntries.length + ' kiện');
      $state.go('listCartonEntries');
    }).catch(error => {
      return FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.checkAll = function () {
    _.forEach(vm.cartonEntryTable.data, cartonEntry => {
      cartonEntry.checked = vm.toCheck;
    });
  };
}]);
'use strict'; // Outlets controller

angular.module('carton-entries').controller('ModalDeleteCartonEntryController', ['cartonEntry', '$modalInstance', 'CartonEntries', 'FhdMessenger', '$state', function (cartonEntry, $modalInstance, CartonEntries, FhdMessenger, $state) {
  const vm = this;
  vm.cancel = $modalInstance.dismiss;
  vm.cartonEntry = CartonEntries.get({
    cartonEntryId: cartonEntry._id
  });
  vm.data = {};

  vm.delete = function () {
    if (!vm.cartonEntry.deleteNote) {
      return FhdMessenger.error('Bạn chưa nhập lý do');
    }

    vm.waiting = true;
    vm.cartonEntry.$delete().then(cartonEntry => {
      FhdMessenger.success('Đã xóa');
      $modalInstance.close(cartonEntry);
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
      $state.reload();
    });
  };
}]);
