angular.module('vendors').component('createVendor', {
  bindings: {
    vendor: '='
  },
  templateUrl: 'modules/vendors/templates/create-vendor.client.template.html',
  controllerAs: 'vm',
  controller: ['ReviewRanks', 'VendorService', 'FhdMessenger', function (ReviewRanks, VendorService, FhdMessenger) {
    const vm = this;
    vm.reviewRanks = ReviewRanks.query();
    vm.vendor = {
      payment: 'cash',
      salesMan: []
    };
    vm.timeForPayments = [0, 7, 15, 30, 45, 90];

    vm.getCode = function (code) {
      VendorService.getCode(code).then(code => {
        vm.vendor.code = code;
      }).catch(FhdMessenger.errorFromServer);
    };

    vm.removeValueFromArray = function (array, index) {
      array.splice(index, 1);
    };

    vm.addSaleMan = function () {
      vm.vendor.salesMan = vm.vendor.salesMan || [];

      if (vm.personName && vm.phone) {
        vm.vendor.salesMan.push({
          personName: vm.personName,
          phone: vm.phone
        });
      }

      vm.personName = '';
      vm.phone = '';
    };

    vm.removeValueFromArray = function (array, index) {
      array.splice(index, 1);
    };
  }]
});
"use strict";

