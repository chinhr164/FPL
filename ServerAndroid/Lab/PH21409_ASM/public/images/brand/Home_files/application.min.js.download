angular.module('users').controller('ImportSalaryController', ['$http', 'Authentication', 'FhdMessenger', 'SalariesService', function ($http, Authentication, FhdMessenger, SalariesService) {
  const vm = this;
  vm.positions = SalariesService.getPositions();

  const positionMap = _.reduce(vm.positions, (result, position) => {
    result[position.name] = position.value;
    return result;
  }, {});

  vm.user = Authentication.user;
  vm.requireFields = 'code outletCode position startDate endDate actualSalary'.split(' ');

  function isAllValidField(field) {
    return _.some(vm.rawItems, item => {
      return !_.get(item, field) && _.get(item, field) !== 0;
    });
  }

  function validateItems() {
    let errors = _.reduce(vm.requireFields, (result, requireField) => {
      if (isAllValidField(requireField)) {
        result.push(`Bạn chưa điền đủ ${requireField}`);
      }

      return result;
    }, []);

    return errors;
  }

  vm.import = () => {
    const errors = validateItems();

    if (errors.length) {
      return FhdMessenger.error(errors.join(', '));
    }

    _.forEach(vm.rawItems, item => {
      if (_.get(positionMap, item.position)) {
        item.position = _.get(positionMap, item.position);
      }
    });

    FhdMessenger.info('Đang cập nhật...');
    vm.waiting = true;
    $http.post('/imported-salaries/import', {
      rawItems: vm.rawItems
    }).then(res => {
      FhdMessenger.success('Import thành công');
      vm.salaries = res.data;
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict'; // User controller

angular.module('users').controller('ModalAddKeptSalaryController', ['userSalaries', '$modalInstance', 'FhdMessenger', '$scope', function (userSalaries, $modalInstance, FhdMessenger, $scope) {
  const vm = this;
  vm.userSalaries = userSalaries;

  function caculateKeptSalary() {
    const percent = _.get(vm, 'percent', 0);

    vm.mapUserKeptSalary = _.reduce(vm.userSalaries, (result, user) => {
      result[user.user.code] = 100 - Number(percent);
      return result;
    }, {});
  }

  vm.close = () => {
    $modalInstance.close();
  };

  vm.confirmKept = () => {
    vm.userSalaries = _.map(vm.userSalaries, user => {
      user.actualSalaryPercent = vm.mapUserKeptSalary[user.user.code];
      user.keptSalary = vm.percent * user.finalSalary / 100;
      user.actualSalary = user.finalSalary * user.actualSalaryPercent / 100 + _.get(user, 'repaySalary', 0);
      user.keptSalaryReason = vm.reason;
      return user;
    });
    FhdMessenger.success('Thêm thành công');
    $modalInstance.close(true);
  };

  $scope.$watch(() => vm.percent, () => {
    caculateKeptSalary();
  });
}]);
"use strict";

angular.module('users').controller('ModalAssessUserController', ['user', '$location', '$modalInstance', '$state', 'Authentication', 'BusinessService', 'FhdMessenger', 'Users', 'UserService', function (user, $location, $modalInstance, $state, Authentication, BusinessService, FhdMessenger, Users, UserService) {
  const vm = this;
  vm.data = {};
  vm.theUser = Authentication.user;
  const defaultContents = [{
    title: 'Các đánh giá khác đối với Nhân viên ngoài các yếu tố trên?',
    isEssay: true
  }, {
    title: 'Bạn có đồng ý để bạn này lên chính thức không?',
    isEssay: true
  }];
  vm.points = [1, 2, 3, 4, 5];
  vm.assessContents = [{
    group: 'Thái độ',
    title: '1/ Thái độ của Nhân viên với Khách hàng như thế nào?'
  }, {
    group: 'Thái độ',
    title: '2/ Khả năng tuân thủ quy định của Cơ sở/ Bộ phận/ Công ty như thế nào?'
  }, {
    group: 'Thái độ',
    title: '3/ Tinh thần chủ động của Nhân viên như thế nào?'
  }, {
    group: 'Thái độ',
    title: '4/ Ý thức chịu trách nhiệm khi có lỗi xảy ra của Nhân viên như thế nào?'
  }, {
    group: 'Thái độ',
    title: '5/ Tính trung thực của Nhân viên như thế nào?'
  }, {
    group: 'Kỹ năng',
    title: '1/ Kỹ năng giao tiếp của Nhân viên như thế nào?'
  }, {
    group: 'Kỹ năng',
    title: '2/ Kỹ năng sắp xếp, kiểm soát hàng hóa của Nhân viên như thế nào?'
  }, {
    group: 'Kỹ năng',
    title: '3/ Kỹ năng phối hợp, làm việc nhóm của Nhân viên như thế nào?'
  }, {
    group: 'Kỹ năng',
    title: '4/ Kỹ năng xử lý tình huống của Nhân viên như thế nào?'
  }, {
    group: 'Kỹ năng',
    title: '5/ Tình hình sức khỏe và khả năng thích nghi với môi trường làm việc của Nhân viên như thế nào'
  }, {
    group: 'Kiến thức',
    title: '1/ Kiến thức về quy trình của Nhân viên như thế nào?'
  }, {
    group: 'Kiến thức',
    title: '2/ Mức độ hiểu biết của Nhân viên về vị trí đang đảm nhiệm như thế nào?'
  }, {
    group: 'Kiến thức',
    title: '3/ Kiến thức về quy định của Nhân viên như thế nào?'
  }, {
    group: 'Kiến thức',
    title: '4/ Hiểu biết về sản phẩm mà công ty đang kinh doanh của Nhân viên như thế nào?'
  }, {
    group: 'Kiến thức',
    title: '5/ Khả năng tự học của Nhân viên như thế nào?'
  }].concat(defaultContents);
  vm.user = Users.get({
    userId: user._id
  });
  vm.user.$promise.then(user => {
    const outletCode = _.get(user, 'outlet.code', '');

    if (outletCode.match(/[GBD]\d+/)) {
      vm.assessContents = [{
        group: 'Thái độ',
        title: '1/ Thái độ của Nhân viên trong khi làm việc như thế nào?'
      }, {
        group: 'Thái độ',
        title: '2/ Khả năng tuân thủ quy định của Cơ sở/ Bộ phận/ Công ty như thế nào?'
      }, {
        group: 'Thái độ',
        title: '3/ Tinh thần chủ động của Nhân viên như thế nào?'
      }, {
        group: 'Thái độ',
        title: '4/ Ý thức chịu trách nhiệm khi có lỗi xảy ra của Nhân viên như thế nào?'
      }, {
        group: 'Thái độ',
        title: '5/ Tính trung thực của Nhân viên như thế nào?'
      }, {
        group: 'Kỹ năng',
        title: '1/ Kỹ năng giao tiếp của Nhân viên như thế nào?'
      }, {
        group: 'Kỹ năng',
        title: '2/ Kỹ năng sắp xếp, kiểm soát hàng hóa của Nhân viên như thế nào?'
      }, {
        group: 'Kỹ năng',
        title: '3/ Kỹ năng phối hợp, làm việc nhóm của Nhân viên như thế nào?'
      }, {
        group: 'Kỹ năng',
        title: '4/ Kỹ năng xử lý tình huống của Nhân viên như thế nào?'
      }, {
        group: 'Kỹ năng',
        title: '5/ Tình hình sức khỏe và khả năng thích nghi với môi trường làm việc của Nhân viên như thế nào'
      }, {
        group: 'Kiến thức',
        title: '1/ Kiến thức về quy trình của Nhân viên như thế nào?'
      }, {
        group: 'Kiến thức',
        title: '2/ Mức độ hiểu biết của Nhân viên về vị trí đang đảm nhiệm như thế nào?'
      }, {
        group: 'Kiến thức',
        title: '3/ Kiến thức về quy định của Nhân viên như thế nào?'
      }, {
        group: 'Kiến thức',
        title: '4/ Hiểu biết về sản phẩm mà công ty đang kinh doanh của Nhân viên như thế nào?'
      }, {
        group: 'Kiến thức',
        title: '5/ Khả năng tự học của Nhân viên như thế nào?'
      }];
    } else if (outletCode.match(/MKT/)) {
      vm.assessContents = [{
        title: 'Mức độ chủ động học hỏi',
        require: 'Chủ động hỏi các kiến thức liên quan đến quy trình làm việc (VD: Các nguyên liệu, dụng cụ, layout,... ); Chủ động hỏi các thao tác máy tính nếu chưa nắm rõ,...'
      }, {
        title: 'Tốc độ đánh máy',
        require: ''
      }, {
        title: 'Mức độ nhanh nhẹn trong tác phong làm việc\n',
        require: 'Tốc độ tìm kiếm thông tin khi trả lời khách'
      }, {
        title: 'Mức độ tiếp thu nhanh quy trình vận hành \n',
        require: 'Sử dụng kênh liên lạc slack, web work và biết cách rep khách hàng, chỉ cần nhắc nhở 1-2 lần\n'
      }, {
        title: 'Mức độ ngoan ngoãn, lễ phép với khách hàng\n',
        require: 'Trả lời khách hàng lễ phép, có chủ ngữ, vị ngữ, "vâng", "dạ"\nTrả lời khách nhiệt tình (VD: Khách hỏi gì mà NV không biết sẽ tự động google hoặc hỏi lại người khác)'
      }, {
        title: 'Mức độ hòa đồng với đồng nghiệp',
        require: 'Nhân viên cởi mở, vui vẻ nói chuyện với đồng nghiệp'
      }, {
        title: 'Mức độ hợp tác với các bộ phận khác\n',
        require: 'Vui vẻ nói chuyện với nhân viên cửa hàng, khi có nhân viên cơ sở/QL bộ phận gọi đến'
      }, {
        title: 'Mức độ nghe theo sự phân công của Quản lý/Trưởng ca',
        require: 'Khi QLCS phân công việc gì sẽ làm đúng việc đó'
      }];
    } else if (outletCode.match(/HR/)) {
      vm.assessContents = [{
        title: 'Mức độ chủ động học hỏi',
        require: 'Chủ động hỏi các kiến thức liên quan đến quy trình làm việc (VD: quy trình tuyển dụng, các team làm việc cùng); Chủ động hỏi các thao tác máy tính nếu chưa nắm rõ,...'
      }, {
        title: 'Mức độ nhanh nhẹn trong tác phong làm việc\n',
        require: 'Tốc độ xử lý hồ sơ, phỏng vấn ứng viên'
      }, {
        title: 'Mức độ tiếp thu nhanh quy trình tuyển dụng\n',
        require: 'Sử dụng kênh liên lạc slack, work và biết cách lọc hồ sơ, các chức năng liên quan đến tuyển dụng, Trợ lý/QLCS chỉ cần nhắc nhở 1-2 lần'
      }, {
        title: 'Mức độ khéo léo khi giao tiếp với ứng viên\n',
        require: 'Offer sang vị trí khác, ứng viên hỏi nhiều nhưng vẫn tận tình giải đáp,...'
      }, {
        title: 'Mức độ chăm chỉ, trách nhiệm với công việc',
        require: 'Đi làm đúng giờ, tích cực xử lý hồ sơ'
      }, {
        title: 'Mức độ hòa đồng với đồng nghiệp',
        require: 'Vui vẻ nói chuyện với đồng nghiệp; Chủ động giao tiếp và làm quen với nhân viên cũ,...'
      }, {
        title: 'Mức độ hợp tác với các bộ phận khác\n',
        require: 'Vui vẻ nói chuyện với các team training, đánh giá, lịch trực, QLCS,.. Có sử dụng đầy đủ chủ ngữ, vị ngữ'
      }, {
        title: 'Mức độ nghe theo sự phân công của Quản lý/Trưởng ca',
        require: 'Khi QLCS phân công việc gì sẽ làm đúng việc đó'
      }];
    }

    if (!_.some(vm.assessContents, assessContent => {
      return assessContent.title === 'Bạn có đồng ý để bạn này lên chính thức không?';
    })) {
      vm.assessContents = vm.assessContents.concat(defaultContents);
    }
  });

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.sendAssess = function () {
    if (_.some(vm.assessContents, assessContent => {
      return !assessContent.point && !assessContent.isEssay;
    })) {
      return FhdMessenger.error('Có mục đánh giá chưa có số điểm');
    }

    vm.user.assessContents = vm.assessContents;
    vm.user.probationOutlet = vm.outlet;
    vm.waiting = true;
    vm.user.$sendAssess().then(user => {
      FhdMessenger.success('Gửi đánh giá thành công');
      $modalInstance.close(user);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict'; // User controller

angular.module('users').controller('ModalDisableUserController', ['$http', '$location', '$modalInstance', '$state', 'user', 'Authentication', 'BusinessService', 'FhdMessenger', 'Users', 'UserService', function ($http, $location, $modalInstance, $state, user, Authentication, BusinessService, FhdMessenger, Users, UserService) {
  const vm = this;
  vm.data = {};
  vm.theUser = Authentication.user;
  vm.user = user;
  vm.cancel = $modalInstance.dismiss;
  vm.waiting = false;
  vm.calculateSalaryTypes = UserService.getCalculateSalaryTypes();

  vm.disable = function () {
    if (_.isEmpty(vm.calculateSalaryType)) {
      return FhdMessenger.error('Chưa chọn phần trăm tính lương');
    }

    if (!vm.disableReason) {
      return FhdMessenger.error('Chưa nhập lý do khóa tài khoản');
    }

    vm.waiting = true;
    $http.post(`/users/${user._id}/disable`, {
      calculateSalary: vm.calculateSalaryType['isCalculateSalary'],
      disableReason: vm.disableReason,
      calculateSalaryPercent: vm.calculateSalaryType['wage']
    }).then(response => response.data).then(() => {
      FhdMessenger.success('Đã khóa');
      $modalInstance.close(user);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict'; // User controller

angular.module('users').controller('ModalCreateStoryController', ['Authentication', 'FhdMessenger', 'Stories', '$modalInstance', '$state', '$scope', '$sce', 'StoryService', function (Authentication, FhdMessenger, Stories, $modalInstance, $state, $scope, $sce, StoryService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.story = {};
  vm.previewMode = false;
  vm.linkYoutube = '';

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  $scope.$watch(() => vm.story.linkYoutube, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.linkYoutube = StoryService.getLinkYoutube(newValue);
    vm.unavaiableLink = !vm.linkYoutube && newValue;
  });

  $scope.trustSrc = function (src) {
    return $sce.trustAsResourceUrl(src);
  };

  vm.create = () => {
    if (!_.intersection(vm.user.roles, ['story:add', 'admin']).length) {
      return FhdMessenger.error('Bạn không có quyền tạo story');
    }

    if (!vm.story.title) {
      return FhdMessenger.error('Chưa có tiêu đề');
    }

    if (!vm.story.thumbnail.length) {
      return FhdMessenger.error('Story chưa có ảnh');
    }

    if (!vm.story.content) {
      return FhdMessenger.error('Story chưa có nội dung');
    }

    const story = new Stories(vm.story);
    story.$save(function (response) {
      FhdMessenger.success('Tạo story thành công');
      vm.cancel();
      vm.story = {};
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  };
}]);
"use strict";

// User controller
angular.module('users').controller('ModalEditStoryController', ['Authentication', 'FhdMessenger', '$modalInstance', '$state', 'Stories', 'story', '$scope', '$sce', 'StoryService', function (Authentication, FhdMessenger, $modalInstance, $state, Stories, story, $scope, $sce, StoryService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.linkYoutube = '';
  $scope.$watch(() => vm.story.linkYoutube, (newValue, oldValue) => {
    if (newValue === oldValue) return;
    vm.linkYoutube = StoryService.getLinkYoutube(newValue);
    vm.unavaiableLink = !vm.linkYoutube && newValue;
  });

  $scope.trustSrc = function (src) {
    return $sce.trustAsResourceUrl(src);
  };

  vm.cancel = () => {
    $modalInstance.close();
  };

  vm.findOne = () => {
    vm.story = Stories.get({
      storyId: story._id
    }).$promise.then(matchedStory => {
      vm.story = matchedStory;
      vm.images = [vm.story.thumbnail];
      vm.linkYoutube = StoryService.getLinkYoutube(vm.story.linkYoutube);
    });
  };

  vm.update = () => {
    if (vm.user.code !== vm.story.user.code) {
      return FhdMessenger.error('Bạn không có quyền sửa story của người khác');
    }

    if (!vm.story.title) {
      return FhdMessenger.error('Chưa có tiêu đề');
    }

    if (!vm.images.length) {
      return FhdMessenger.error('Story chưa có ảnh');
    }

    if (!vm.story.content) {
      return FhdMessenger.error('Story chưa có nội dung');
    }

    vm.story.thumbnail = vm.images;
    vm.story.$update().then(response => {
      FhdMessenger.success('Update thành công');
      vm.cancel();
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => $state.reload());
  };
}]);
'use strict'; // User controller

angular.module('users').controller('ModalEditUsersController', ['userId', '$location', '$modalInstance', '$state', 'Authentication', 'BusinessService', 'FhdMessenger', 'Users', 'UserService', 'Address', 'WorkDepartmentService', 'WorkPositions', function (userId, $location, $modalInstance, $state, Authentication, BusinessService, FhdMessenger, Users, UserService, Address, WorkDepartmentService, WorkPositions) {
  const vm = this;
  vm.data = {};
  vm.theUser = Authentication.user;
  vm.isShow = _.intersection(vm.theUser.roles, ['tro-ly-ns', 'admin', 'user:edit']).length;

  vm.init = () => {
    vm.districts = Address.getDistricts();
    BusinessService.allAsync().then(businesses => {
      vm.data.businesses = businesses;
    });
    WorkDepartmentService.allAsync().then(workDepartments => {
      vm.data.workDepartments = workDepartments;
    });
    WorkPositions.query().$promise.then(workPositions => {
      vm.data.workPositions = workPositions;
    });
    vm.date = Date.now();
    UserService.getRoleMap().then(roleMap => {
      vm.roleMap = _.assign({}, roleMap, {
        'rank-a': true,
        user: true,
        staff: true,
        employee: true
      });
    });
    UserService.getRolesInTypes().then(roleTypes => {
      vm.roleTypes = roleTypes;
      vm.rolePositionsMap = _.find(vm.roleTypes, {
        id: 'positions'
      }).roles;
      vm.rolePositions = _.map(vm.rolePositionsMap, 'id');
    });
    UserService.getRoleHideMap().then(roleHideMap => {
      vm.roleHideMap = roleHideMap;
      vm.rolePositionsMap = _.find(vm.roleTypes, {
        id: 'positions'
      }).roles;
      vm.user.rolePositions = _.map(vm.rolePositionsMap, 'id');
    });
  };

  vm.findOne = function () {
    vm.user = Users.get({
      userId
    });
    vm.user.$promise.then(() => {
      vm.user.roles.forEach(role => {
        if (!_.get(vm.user.businesses, 'length', 0)) {
          vm.user.businesses = [vm.user.business];
        }

        if (!['deleted', 'inactive'].includes(role)) {
          vm.roleMap[role] = true;
        }
      });
    });
  };

  vm.removeBusiness = function (index) {
    vm.user.businesses.splice(index, 1);
  };

  vm.changeBusiness = function () {
    vm.user.businesses = vm.user.businesses || [];
    vm.user.businesses.push(vm.business);
    vm.user.businesses = _.union(vm.user.businesses);
  };

  vm.changeWorkDepartment = choosenWorkDepartment => {
    vm.workDepartment = null;
    vm.user.workDepartments = vm.user.workDepartments || [];

    if (!_.some(vm.user.workDepartment, workDepartment => _.isEqual(workDepartment._id, choosenWorkDepartment._id))) {
      vm.user.workDepartments.push(choosenWorkDepartment);
    }
  };

  vm.changeWorkPosition = choosenWorkPosition => {
    vm.workPosition = null;
    vm.user.workPositions = vm.user.workPositions || [];

    if (!_.some(vm.user.workPositions, workPosition => _.isEqual(workPosition._id, choosenWorkPosition._id))) {
      vm.user.workPositions.push(choosenWorkPosition);

      _.forEach(choosenWorkPosition.roles, role => {
        vm.roleMap[role] = true;
      });
    }
  };

  vm.removeWorkPosition = function (index) {
    vm.user.workPositions.splice(index, 1);
  };

  vm.removeWorkDepartment = function (index) {
    vm.user.workDepartments.splice(index, 1);
  };

  vm.update = function () {
    const roles = _.reduce(vm.roleMap, (roles, toShow, role) => {
      if (toShow) roles.push(role);
      return roles;
    }, []);

    if (!_.get(vm.user.businesses, 'length', 0)) {
      return FhdMessenger.error('Người dùng chưa có business');
    }

    vm.user.business = _.head(vm.user.businesses);

    if (!(roles.includes('outlet') || vm.user.roles.includes('deleted')) && !_.intersection(roles, vm.rolePositions).length) {
      return FhdMessenger.error('Người dùng phải có ít nhất một quyền tại Positions');
    }

    vm.user.roles = roles;

    if (vm.theUser.roles.includes('admin')) {
      vm.user.$update(function () {
        $modalInstance.close();
        $state.reload();
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
        FhdMessenger.error(vm.error);
      });
    } else {
      vm.user.$updateByAssistant(function () {
        $modalInstance.close();
        $state.reload();
      }, function (errorResponse) {
        vm.error = errorResponse.data.message;
        FhdMessenger.error(vm.error);
      });
    }
  };
}]);
'use strict'; // User controller

angular.module('users').controller('ModalRepaySalaryController', ['userSalaries', '$modalInstance', 'FhdMessenger', '$scope', '$http', function (userSalaries, $modalInstance, FhdMessenger, $scope, $http) {
  const vm = this;
  vm.data = {};
  vm.data.firstSalaries = [];
  vm.reason = 'Thưởng thâm niên (bằng chi phí đào tạo, đồng phục tháng đầu tiên)';

  vm.init = () => {
    vm.userSalaries = userSalaries;

    const mapIds = _.map(_.map(vm.userSalaries, 'user'), '_id');

    let promise = $http.get('/staff-salary-monthly-reports/check-repay-salary', {
      params: {
        users: mapIds
      }
    }).then(response => {
      vm.data.firstSalaries = response.data;
      vm.userSalaries = _.map(vm.userSalaries, user => {
        const firstSalary = _.find(vm.data.firstSalaries, salary => _.isEqual(salary.staff._id, user.user._id));

        user.repaySalary = _.get(firstSalary, 'salary.keptSalary', 0);
        user.actualSalary = user.finalSalary + _.get(user, 'repaySalary', 0) - _.get(user, 'keptSalary', 0);
        return user;
      });
      vm.data.firstSalaries = _.sortBy(vm.data.firstSalaries, 'staff.code');
      vm.userSalaries = _.sortBy(vm.userSalaries, 'user.code');
    }).catch(err => {
      FhdMessenger.error(err.message);
    });
    FhdMessenger.notifyLoading('Đang tải dữ liệu...', promise, () => {
      FhdMessenger.success('Tải dữ liệu thành công!');
    });
  };

  vm.close = () => {
    $modalInstance.close();
  };

  vm.confirmRepay = () => {
    vm.userSalaries = _.map(vm.userSalaries, user => {
      user.actualSalary = user.finalSalary + _.get(user, 'repaySalary', 0) - _.get(user, 'keptSalary', 0);
      user.repaySalaryReason = vm.reason;
      return user;
    });
    FhdMessenger.success('Thêm thành công');
    $modalInstance.close(true);
  };
}]);
'use strict'; // User controller

angular.module('users').controller('ModalCreateRetireRequestController', ['$location', '$modalInstance', '$sce', '$window', 'Authentication', 'FhdMessenger', 'Users', 'TrainingDocument', function ($location, $modalInstance, $sce, $window, Authentication, FhdMessenger, Users, TrainingDocument) {
  const vm = this;
  vm.data = {};
  vm.theUser = Authentication.user;
  vm.cancel = $modalInstance.dismiss;
  vm.retireType = 'completely';
  vm.waiting = false;

  function processHtml(content) {
    const parseDOM = new $window.DOMParser();
    const descriptionDOM = parseDOM.parseFromString(content, 'text/html');

    _.forEach(descriptionDOM.querySelectorAll('table'), table => {
      table.classList.add('table');
      table.classList.add('table-bordered');
    });

    return $sce.trustAsHtml(descriptionDOM.body.innerHTML);
  }

  TrainingDocument.get({
    trainingDocumentId: '610e416cc02c4f5a2c6bcbe2'
  }).$promise.then(trainingDocument => {
    const data = trainingDocument.description.split('<p>----- </p>');
    vm.completelyContent = processHtml(data[1]);
    vm.provisionallyContent = processHtml(data[0]);
  });

  vm.requestRetire = function () {
    if (!vm.reason) {
      return FhdMessenger.error('Chưa có lý do xin nghỉ việc');
    }

    if (vm.retireType === 'completely') {
      if (!vm.retireDate) {
        return FhdMessenger.error('Ngày dự kiến nghỉ');
      }

      if (moment(vm.retireDate).startOf('day').isBefore(moment().endOf('day').add(1, 'month'))) {
        return FhdMessenger.error('Ngày dự kiến nghỉ phải sau thời điểm hiện tại ít nhất 1 tháng');
      }
    } else {
      if (!vm.startRetireDate) {
        return FhdMessenger.error('Chưa có ngày bắt đầu nghỉ');
      }

      if (!vm.endRetireDate) {
        return FhdMessenger.error('Chưa có ngày kết thúc');
      }

      if (moment(vm.endRetireDate).diff(vm.startRetireDate, 'days') > 14) {
        return FhdMessenger.error('Bạn chỉ có thể xin nghỉ tạm thời tối đa 14 ngày');
      }

      if (!vm.retireImages.length) {
        return FhdMessenger.error('Bạn cần phải chụp ảnh giấy tờ liên quan');
      }
    }

    if (!vm.confirmRules) {
      return FhdMessenger.error('Bạn cần phải xác nhận đồng ý quy định. Nếu có vấn đề gì thắc mắc bạn vui lòng liên hệ team HR để được xử lý');
    }

    vm.waiting = true;
    Users.requestRetire({
      retireType: vm.retireType,
      startRetireDate: vm.startRetireDate,
      endRetireDate: vm.endRetireDate,
      reason: vm.reason,
      retireDate: vm.retireDate,
      retireImages: vm.retireImages
    }).$promise.then(user => {
      $modalInstance.close(user);
      FhdMessenger.success('Gửi yêu cầu thành công');
      $location.path('/my-home');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('users').controller('ModalSalaryController', ['$scope', 'salaryData', '$modalInstance', function ($scope, salaryData, $modalInstance) {
