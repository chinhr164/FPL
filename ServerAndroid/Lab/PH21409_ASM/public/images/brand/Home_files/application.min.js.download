angular.module('error-stocks').controller('ErrorStockController', ['$stateParams', '$location', 'ErrorStock', 'NgTableParams', 'FhdMessenger', 'ErrorStockService', function ($stateParams, $location, ErrorStock, NgTableParams, FhdMessenger, ErrorStockService) {
  const vm = this;
  vm.startDate = moment().subtract(1, 'week').format('YYYY-MM-DD');
  vm.endDate = moment().format('YYYY-MM-DD');

  vm.find = function () {
    vm.waiting = true;
    const searchText = _.isString(vm.searchText) ? vm.searchText.toUpperCase() : null;
    const startDate = vm.startDate || moment().startOf('week').format('YYYY-MM-DD');
    const endDate = vm.endDate || moment().endOf('week').format('YYYY-MM-DD');
    vm.errorStocks = ErrorStock.query({
      startDate,
      endDate,
      searchText
    });
    vm.errorStocks.$promise.then(() => {
      vm.errorStocksTable.settings({
        dataset: vm.errorStocks
      });
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = () => {
    vm.errorStocks = ErrorStock.get({
      errorStockId: $stateParams.errorStockId
    });
    vm.errorStocks.$promise.then(errorStock => {
      vm.errorStock = errorStock;
      vm.errorStocksTable.settings({
        dataset: vm.errorStock.items
      });
    });
  };

  vm.errorStocksTable = new NgTableParams({
    count: 100
  });

  vm.searchKeyUp = function ($event) {
    if ($event.keyCode === 13) vm.find();
  };

  vm.noteReasonProductError = ErrorStockService.openNoteReasonProductError;
}]);
"use strict";

angular.module('error-stocks').controller('ModalNoteReasonProductErrorController', ['errorStock', '$modalInstance', 'FhdMessenger', 'itemIndex', function (errorStock, $modalInstance, FhdMessenger, itemIndex) {
  const vm = this;

  vm.submit = () => {
