angular.module('order-entries').controller('ModalCancelOrderEntriesController', ['$modalInstance', '$scope', 'FhdMessenger', 'orderEntries', 'OrderEntriesService', 'Vendors', function ($modalInstance, $scope, FhdMessenger, orderEntries, OrderEntriesService, Vendors) {
