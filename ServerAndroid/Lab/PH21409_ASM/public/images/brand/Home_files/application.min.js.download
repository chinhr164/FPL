'use strict';

angular.module('outlets').factory('OutletService', ['Outlets', 'ngStore', 'ngDexie', '$q', 'FhdMessenger', '$modal', '$rootScope', '$localStorage', 'helper', function (Outlets, ngStore, ngDexie, $q, FhdMessenger, $modal, $rootScope, $localStorage, helper) {
  let initialSync = null;
  let loadAllOutlets = null;
  const formats = ['HCM', 'Normal', '900', '1200', '1500', 'Big Store', 'online', 'other'];

  function getOutletCodesByCondition(outlets, condition) {
    const filteredOutlets = _.filter(outlets, condition);

    return _.map(filteredOutlets, 'code');
  }

  function isAbbyStoreOutlet(outlet) {
    return outlet.isStore && outlet.business.code === 'ABBY';
  }

  function isExpress(outlet) {
    return outlet.code.match(/E\d+/);
  }

  function isMetro(outlet) {
    if (outlet.code === 'E14') return false;
    return outlet.code.match(/M\d+/) || ['1500', 'Big Store'].includes(outlet.format);
  }

  function filterOutletByRegion(outlets, region) {
    return _.filter(outlets, {
      region
    });
  }

  function getOutletCodes() {
    return ngDexie.list('outlets').then(outlets => {
      const filteredOutlets = _.cloneDeep(_.filter(outlets, {
        deleted: false,
        hasStaff: true
      }));

      const sortedOutlets = helper.sortByProperty(filteredOutlets, 'code');

      const outletCodes = _.map(sortedOutlets, outlet => outlet.code);

      const abbyStoreOutlets = _.filter(sortedOutlets, isAbbyStoreOutlet);

      const KITCHEN_OUTLET_CODES = _.filter(outletCodes, outletCode => outletCode.match(/^B\d+/));

      const PACKING_OUTLET_CODES = _.filter(outletCodes, outletCode => outletCode.match(/^G\d+/));

      const abbyNorthStoreOutlets = filterOutletByRegion(abbyStoreOutlets, 'NORTH');
      const abbySouthStoreOutlets = filterOutletByRegion(abbyStoreOutlets, 'SOUTH');
      const abbyCentralStoreOutlets = filterOutletByRegion(abbyStoreOutlets, 'CENTRAL');
      const METRO_SOUTH_OUTLET_CODES = getOutletCodesByCondition(abbySouthStoreOutlets, isMetro);
      const METRO_NORTH_OUTLET_CODES = getOutletCodesByCondition(abbyNorthStoreOutlets, isMetro);
      const METRO_CENTRAL_OUTLET_CODES = getOutletCodesByCondition(abbyCentralStoreOutlets, isMetro);
      const EXPRESS_SOUTH_OUTLET_CODES = getOutletCodesByCondition(abbySouthStoreOutlets, isExpress);
      const EXPRESS_NORTH_OUTLET_CODES = getOutletCodesByCondition(abbyNorthStoreOutlets, isExpress);
      const EXPRESS_CENTRAL_OUTLET_CODES = getOutletCodesByCondition(abbyCentralStoreOutlets, isExpress);
      const SOUTH_OUTLET_CODES = [...METRO_SOUTH_OUTLET_CODES, ...EXPRESS_SOUTH_OUTLET_CODES];
      const NORTH_OUTLET_CODES = [...METRO_NORTH_OUTLET_CODES, ...EXPRESS_NORTH_OUTLET_CODES];
      const CENTRAL_OUTLET_CODES = [...METRO_CENTRAL_OUTLET_CODES, ...EXPRESS_CENTRAL_OUTLET_CODES];

      const DEPOT_OUTLET_CODES = _.filter(outletCodes, outletCode => outletCode.match(/^D\d+/));

      const SAVOR_OUTLET_CODES = _.filter(outletCodes, outletCode => outletCode.match(/^S\d+/));

      const ABBY_OUTLET_CODES = _.uniq([...SOUTH_OUTLET_CODES, ...CENTRAL_OUTLET_CODES, ...NORTH_OUTLET_CODES]);

      const OUTLET_CODES = _.uniq([...ABBY_OUTLET_CODES, ...SAVOR_OUTLET_CODES, ...DEPOT_OUTLET_CODES]);

      const SALE_OUTLET_CODES = ABBY_OUTLET_CODES;
      return {
        PACKING_OUTLET_CODES,
        SOUTH_OUTLET_CODES,
        CENTRAL_OUTLET_CODES,
        NORTH_OUTLET_CODES,
        SAVOR_OUTLET_CODES,
        DEPOT_OUTLET_CODES,
        SALE_OUTLET_CODES,
        ABBY_OUTLET_CODES,
        OUTLET_CODES,
        KITCHEN_OUTLET_CODES
      };
    });
  }

  function syncOutletsFromServer() {
    const loadedOutlets = ngStore.get('loadedOutlets');
    const localOutletsUpdated = ngStore.get('outletsUpdated');
    let outletsUpdated = localOutletsUpdated && moment(localOutletsUpdated).isValid() ? moment(localOutletsUpdated).valueOf() : null;

    if (!loadedOutlets || !_.isNumber(outletsUpdated)) {
      clearLocalSettings();
      return $q.when(null); // Lưu ý hàm này luôn trả về 1 promise để còn .then được dù thế nào đi chăng nữa
    }

    return Outlets.getUpdatedOutlets({
      date: outletsUpdated
    }).$promise.then(outlets => {
      const promises = [];

      if (outlets && outlets.length) {
        FhdMessenger.success(`Cập nhật thành công outlet từ máy chủ!`);

        const deletedOutles = _.filter(outlets, {
          deleted: true
        });

        if (deletedOutles && deletedOutles.length) {
          const deletedIds = _.map(deletedOutles, '_id');

          promises.push(ngDexie.getDb().outlets.bulkDelete(deletedIds));
        }

        _.forEach(outlets, outlet => {
          if (_.get(outlet, 'code') && _.get(outlet, 'code', 'W').match(/(M|E|S|B|D)\d+/)) {
            outlet.priority = Number(outlet.code.slice(1));
            outlet.codeText = outlet.code.slice(0, 1);
          } else {
            outlet.codeText = outlet.code;
          }
        });

        const sortedOutlets = _.sortBy(outlets, ['codeText', 'priority']);

        if (loadedOutlets) {
          promises.push(ngDexie.getDb().outlets.bulkPut(_.filter(sortedOutlets, {
            deleted: false
          })).then(() => {
            $rootScope.$apply();
            $rootScope.$broadcast('outletsUpdated', outlets);
          }));
        }

        saveMaxUnixUpdated(outlets);
      }

      return $q.all(promises);
    }).catch(() => {
      // Cứ có lỗi thì đảm bảo dữ liệu clean và bắt buộc hàm load allAsync()
      // sẽ gọi dữ liệu từ server
      FhdMessenger.error('Có lỗi khi tải Outlet cập nhật. Sẽ tải lại từ đầu.');
      clearLocalSettings();
    });
  }

  function initInitialSync() {
    if (!initialSync) {
      initialSync = syncOutletsFromServer();
    }

    return initialSync;
  }

  function saveMaxUnixUpdated(outlets) {
    const maxUnixUpdated = Math.max(..._.map(outlets, outlet => {
      const value = outlet.unixUpdated && moment(outlet.unixUpdated).isValid() ? moment(outlet.unixUpdated).valueOf() : null;
      return value;
    }));

    if (outlets && outlets.length && moment(maxUnixUpdated).isValid()) {
      ngStore.set('outletsUpdated', maxUnixUpdated);
    }
  }

  function getAllOulets() {
    return Outlets.query().$promise.then(outlets => {
      saveMaxUnixUpdated(outlets);
      return ngDexie.getDb().outlets.clear().then(() => ngDexie.getDb().outlets.bulkAdd(outlets)).then(() => {
        ngStore.set('loadedOutlets', true);
        $rootScope.$apply();
        return outlets;
      }).catch(err => {
        FhdMessenger.error(err.message);
        throw err;
      });
    });
  }

  function allAsync() {
    function getOutletsAndNotify() {
      return getAllOulets().then(outlets => {
        FhdMessenger.success('Tải xong danh sách outlet từ máy chủ');
        $localStorage.set('clientOutletUpdated', moment().toDate());
        return outlets;
      });
    }

    const clientOutletUpdated = $localStorage.get('clientOutletUpdated');

    if (!clientOutletUpdated || moment(clientOutletUpdated).diff(moment(), 'day') > 1) {
      return getOutletsAndNotify();
    }

    if (!loadAllOutlets) {
      loadAllOutlets = initInitialSync().then(() => {
        const outletsUpdated = ngStore.get('outletsUpdated');
        const loadedOutlets = ngStore.get('loadedOutlets');

        if (!_.isNumber(outletsUpdated) || !loadedOutlets) {
          return getOutletsAndNotify();
        }

        return ngDexie.list('outlets').then(outlets => {
          if (!outlets || !outlets.length) {
            return getOutletsAndNotify();
          } else {
            FhdMessenger.success('Tải xong Outlets từ bộ nhớ');

            _.forEach(outlets, outlet => {
              if (outlet.code.match(/(M|E|S|B|D)\d+/)) {
                outlet.priority = Number(outlet.code.slice(1));
                outlet.codeText = outlet.code.slice(0, 1);
              } else {
                outlet.codeText = outlet.code;
              }
            });

            const result = _.sortBy(outlets, ['codeText', 'priority']);

            return result;
          }
        });
      }).then(outlets => {
        return _.orderBy(outlets, ['codeText', 'priority']);
      });
    }

    return loadAllOutlets;
  }

  function clearLocalSettings(all) {
    ngStore.remove('outletsUpdated');
    ngStore.remove('outlets');

    if (all) {
      if (ngDexie.getDb().outlets) {
        ngDexie.getDb().outlets.clear();
      }
    }
  } // Code cũ


  var outlets;
  var outletsAsync;
  var outletsWithAllAsync;

  function load() {
    outletsAsync = allAsync();
  }

  var all = function (callback) {
    if (!outletsAsync) outletsAsync = allAsync();
    outletsAsync.then(function (allOutlets) {
      outlets = allOutlets;
      if (callback) callback(null, allOutlets);
    }, function (err) {
      load();
      if (callback) callback(err);
    });
    return outletsAsync;
  };

  function attachAllOutletsOption(outlets) {
    var _outlets = _.cloneDeep(outlets);

    _outlets.push({
      code: 'Không',
      name: '== Chưa chọn =='
    });

    return _outlets;
  } // function generateOutletsFromIds(ids) {
  //   return _.map(ids, function(id) {
  //     return _.find(outlets, { _id: id }) || id
  //   })
  // }


  return {
    clearLocalSettings: clearLocalSettings,
    getAllOulets: getAllOulets,
    getOutletCodes: getOutletCodes,
    all: all,
    load: load,
    withAllOption: function (callback) {
      all(function (err, outlets) {
        if (err) return callback(err);
        callback(null, attachAllOutletsOption(outlets));
      });
    },

    getFormats() {
      return formats;
    },

    allAsync() {
      if (!outletsAsync) {
        load();
      }

      return outletsAsync;
    },

    withAllOptionAsync() {
      if (!outletsAsync) {
        load();
      }

      if (!outletsWithAllAsync) {
        outletsWithAllAsync = outletsAsync.then(attachAllOutletsOption);
      }

      return outletsWithAllAsync;
    },

    openModalEditShifts(outletId) {
      return $modal.open({
        templateUrl: 'modules/outlets/templates/modal-edit-shifts.client.view.html',
        controller: 'ModalEditShiftsController',
        controllerAs: 'vm',
        resolve: {
          outletId: () => outletId
        }
      }).result;
    },

    openModalEditProcessors(outletId) {
      return $modal.open({
        templateUrl: 'modules/outlets/templates/modal-edit-outlet-processors.client.view.html',
        controller: 'ModalEditProcessorsController',
        controllerAs: 'vm',
        size: 'lg',
        resolve: {
          outletId: () => outletId
        }
      }).result;
    },

    loadDefaultOutlet: function (user, _outlets) {
      if (!_outlets) {
        if (outletsAsync.$resolved === false) {
          //  console.log('Outlets not yet loaded')
          return null;
        } else {
          _outlets = outlets;
        }
      }

      var defaultOutlet = null;
      if (user.outlet) defaultOutlet = _.find(_outlets, {
        _id: user.outlet._id
      });
      if (defaultOutlet) return defaultOutlet;
      return _.last(_outlets || outlets);
    },
    getFromId: function (id) {
      return _.find(outlets, {
        _id: id
      });
    },
    findOutletFromCode: code => {
      const outletFromCodeAndOutlets = _.curry((code, outlets) => _.find(outlets, {
        code
      }));

      const outletFromOutlets = outletFromCodeAndOutlets(code);
      return all().then(outletFromOutlets);
    },
    getOutletRegion: function (outlet) {
      return _.get(outlet, 'region', 'SOUTH');
    },
    loadProcessors: function (processorType) {
      return all().then(outlets => {
        const outletGroupByProcessorMap = _.reduce(outlets, (result, outlet) => {
          if (!_.get(outlet, `${processorType}.length`)) {
            return result;
          }

          _.forEach(_.get(outlet, processorType), processor => {
            result[processor.code] = result[processor.code] || {
              code: processor.code,
              displayName: processor.displayName,
              outlets: []
            };
            result[processor.code].outlets.push({
              code: outlet.code,
              name: outlet.name
            });
          });

          return result;
        }, {});

        return outletGroupByProcessorMap;
      });
    },

    getFormatPriority(format) {
      if (format === 'HCM') {
        return 0;
      }

      if (format === 'Normal') {
        return 2;
      }

      if (format === '900') {
        return 4;
      }

      if (format === '1200') {
        return 6;
      }

      if (format === '1500') {
        return 8;
      }

      if (format === 'Big Store') {
        return 10;
      }

      return 100;
    }

  };
}]);
