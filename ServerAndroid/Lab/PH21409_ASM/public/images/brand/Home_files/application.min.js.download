angular.module('training-documents').controller('TrainingDocumentsController', ['helper', 'Authentication', 'ConfirmModal', 'FhdMessenger', 'TrainingDocument', 'NgTableParams', 'WorkDepartments', '$sce', '$stateParams', '$state', '$window', 'AnchorSmoothScroll', '$location', '$timeout', '$scope', function (helper, Authentication, ConfirmModal, FhdMessenger, TrainingDocument, NgTableParams, WorkDepartments, $sce, $stateParams, $state, $window, AnchorSmoothScroll, $location, $timeout, $scope) {
  const vm = this;
  vm.removeValueFromArray = helper.removeValueFromArray;
  vm.url = $location.absUrl().replace(/#[^!]+/, '');
  vm.idContent = $location.hash().replace(/^scrollTo_/, '');

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.trainingDocument.targetOutlets = _.map(selectedOutlets, '_id');
  };

  vm.trainingDocument = {};
  vm.matchedTrainingDocuments = [];
  vm.trainingDocumentTable = new NgTableParams({
    count: 100
  });
  vm.user = Authentication.user;
  vm.isAdmin = !!_.intersection(vm.user.roles, ['admin', 'training-documents:edit-all', 'training-documents:view-all']).length;
  vm.type = '';
  vm.roles = {
    sale: true,
    sx: true,
    ship: true,
    'rank-b': true,
    'tro-ly-ns': true,
    'tro-ly-dt': true,
    'rank-f': true,
    marketing: true,
    'tro-ly': true,
    admin: true,
    kho: true,
    kitchen: true
  };
  vm.data = {
    outletMap: {}
  };
  vm.outlestCheckAll = true;
  vm.rolesCheckAll = true;
  vm.workDepartmentPromise = WorkDepartments.query({}).$promise.then(workDepartments => {
    vm.data.workDepartments = _.map(workDepartments, workDepartment => ({
      _id: workDepartment._id,
      name: workDepartment.name,
      value: false
    }));
  }).catch(FhdMessenger.errorFromServer);
  vm.selectedWorkDepartments = [];

  vm.selectWorkDepartments = () => {
    vm.selectedWorkDepartments = _.map(_.filter(vm.data.workDepartments, 'value'), '_id');
  };

  function validateTrainingDocument(trainingDocument) {
    if (!trainingDocument.title) {
      return 'Bạn chưa điền tiêu đề tài liệu';
    }

    if (trainingDocument.link && trainingDocument.link.match(/^https?:\/\//) === null) {
      return 'Bạn cần nhập đúng đường dẫn tài liệu';
    }

    if (!trainingDocument.description) {
      return 'Bạn cần nhập mô tả tài liệu';
    }

    if (trainingDocument.description.length > 500000) {
      return 'Nội dung tài liệu phải dưới 500.000 kí tự';
    }

    return '';
  }

  vm.selectAllRoles = () => {
    vm.roles = _.reduce(vm.roles, (result, value, key) => {
      result[key] = !vm.rolesCheckAll;
      return result;
    }, {});
    vm.rolesCheckAll = !vm.rolesCheckAll;
  };

  vm.onChangeContent = content => {
    const generateTableOfContent = generateTOCAndFormatHtml(content);
    vm.tableOfContent = generateTableOfContent.tableOfContent;
  };

  vm.create = () => {
    let roles = _.reduce(vm.roles, function (roles, value, role) {
      if (value) roles.push(role);
      return roles;
    }, []);

    if (vm.selectedWorkDepartments.length > 0) {
      roles = [];
    }

    vm.trainingDocument.roles = roles;
    vm.trainingDocument.targetWorkDepartments = vm.selectedWorkDepartments;
    const trainingDocument = new TrainingDocument(vm.trainingDocument);
    const errorText = validateTrainingDocument(trainingDocument);

    if (errorText) {
      return FhdMessenger.error(errorText);
    }

    vm.creating = true;
    FhdMessenger.info('Đang tạo...');
    trainingDocument.$save().then(trainingDocument => {
      FhdMessenger.success('OK');
      if (trainingDocument.documentType === 'rule') $state.go('viewRule', {
        trainingDocumentId: trainingDocument._id
      });else {
        $state.go('viewTrainingDocument', {
          trainingDocumentId: trainingDocument._id
        });
      }
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.creating = false;
    });
  };

  vm.findTrainings = () => {
    TrainingDocument.query({
      documentType: 'training'
    }).$promise.then(trainingDocuments => {
      vm.trainingDocuments = trainingDocuments;
      vm.trainingDocumentTable.settings({
        dataset: trainingDocuments
      });
    });
  };

  vm.findRules = () => {
    TrainingDocument.query({
      documentType: 'rule'
    }).$promise.then(trainingDocuments => {
      vm.trainingDocuments = trainingDocuments.filter(trainingDocument => _.intersection(vm.user.roles, ['admin', 'training-documents:edit-all', 'training-documents:view-all']).length || _.intersection(trainingDocument.targetRoles, vm.user.roles).length);
      vm.trainingDocumentTable.settings({
        dataset: trainingDocuments
      });
    });
  };

  const generateTOCAndFormatHtml = htmlStr => {
    var parseDOM = new $window.DOMParser();
    const descriptionDOM = parseDOM.parseFromString(htmlStr, 'text/html');
    let tableOfContent = [];

    _.forEach(descriptionDOM.querySelectorAll('h2,h3,h4,h5'), (heading, index) => {
      tableOfContent.push({
        type: heading.tagName,
        index,
        title: heading.innerText,
        childrens: []
      });
      heading.setAttribute('id', 'scrollTo_' + index);
    });

    _.forEach(descriptionDOM.querySelectorAll('table'), table => {
      table.classList.add('table');
      table.classList.add('table-bordered');
    });

    return {
      tableOfContent,
      description: descriptionDOM.body.innerHTML
    };
  };

  vm.jumpTo = id => {
    AnchorSmoothScroll.scrollTo('scrollTo_' + id); // $anchorScroll('scrollTo_' + id)
  };

  vm.findOne = type => {
    TrainingDocument.get({
      trainingDocumentId: $stateParams.trainingDocumentId
    }).$promise.then(trainningDocument => {
      vm.trainingDocument = trainningDocument;
      const generatedData = generateTOCAndFormatHtml(vm.trainingDocument.description);
      vm.trainingDocument.description = $sce.trustAsHtml(generatedData.description);
      vm.trainingDocument.tableOfContent = generatedData.tableOfContent;

      _.forEach(vm.roles, (value, key) => {
        if (_.includes(vm.trainingDocument.targetRoles, key)) {
          vm.roles[key] = true;
        } else {
          vm.roles[key] = false;
        }
      });

      vm.data.workDepartments = _.filter(vm.data.workDepartments, workDepartment => {
        if (_.includes(vm.trainingDocument.targetWorkDepartments, workDepartment._id)) {
          workDepartment.value = true;
        } else {
          workDepartment.value = false;
        }

        return workDepartment;
      });
      vm.selectedWorkDepartments = _.map(_.filter(vm.data.workDepartments, 'value'), '_id');
      vm.modifyVideoUrl();
      $timeout(function () {
        vm.jumpTo(vm.idContent);
      }, 500);

      if (type === 'VIEW') {
        $timeout(function () {
          vm.updateViews();
        }, 60000);
      }
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.modifyVideoUrl = () => {
    if (vm.trainingDocument && vm.trainingDocument.link && _.isString(vm.trainingDocument.link)) {
      if (vm.trainingDocument.link.includes('https://www.youtube.com/watch') === true) {
        const url = vm.trainingDocument.link.replace('watch?v=', 'embed/');
        return $sce.trustAsResourceUrl(url);
      }
    }
  };

  vm.update = () => {
    const trainingDocument = vm.trainingDocument;

    const roles = _.reduce(vm.roles, function (roles, value, role) {
      if (value) roles.push(role);
      return roles;
    }, []);

    if (vm.selectedWorkDepartments.length > 0) {
      trainingDocument.targetRoles = [];
      trainingDocument.targetOutlets = [];
      trainingDocument.targetWorkDepartments = vm.selectedWorkDepartments;
    } else {
      trainingDocument.targetRoles = roles;
      trainingDocument.targetWorkDepartments = [];
    }

    const errorText = validateTrainingDocument(trainingDocument);

    if (errorText) {
      return FhdMessenger.error(errorText);
    }

    vm.updating = true;
    trainingDocument.$update().then(trainingDocument => {
      FhdMessenger.success('OK');
      if (trainingDocument.documentType === 'rule') $state.go('viewRule', {
        trainingDocumentId: trainingDocument._id
      });else {
        $state.go('viewTrainingDocument', {
          trainingDocumentId: trainingDocument._id
        });
      }
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.updating = false;
    });
  };

  vm.updateViews = () => {
    vm.trainingDocument.$updateViews().then(trainingDocument => {
      if (trainingDocument) {
        vm.trainingDocument.views = trainingDocument.views;
        const generatedData = generateTOCAndFormatHtml(vm.trainingDocument.description);
        vm.trainingDocument.description = $sce.trustAsHtml(generatedData.description);
        vm.trainingDocument.tableOfContent = generatedData.tableOfContent;
      }
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.review = () => {
    ConfirmModal.show().then(() => {
      vm.trainingDocument.$review().then(trainingDocument => {
        FhdMessenger.success('Đã đánh dấu là hoàn thành review');
        $state.reload();
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
    });
  };

  vm.remove = trainingDocument => {
    ConfirmModal.show().then(() => {
      trainingDocument.$remove().then(trainingDocument => {
        if (trainingDocument.documentType === 'rule') $state.reload('listRules');else $state.reload('listTrainingDocuments');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
    });
  };

  vm.search = () => {
    const roles = _.reduce(vm.roles, (result, value, key) => {
      if (value) {
        result.push(key);
      }

      return result;
    }, []);

    const outlets = vm.trainingDocument.targetOutlets;

    if (vm.searchText) {
      let searchText = vm.searchText.trim().toLowerCase();
      vm.matchedTrainingDocuments = vm.trainingDocuments.filter(trainingDocument => {
        return _.includes(trainingDocument.title.toLowerCase(), searchText);
      });
    } else {
      vm.matchedTrainingDocuments = vm.trainingDocuments;
    }

    vm.matchedTrainingDocuments = vm.matchedTrainingDocuments.filter(trainingDocument => {
      if (vm.selectedWorkDepartments.length === 0) {
        const matchTargetRoles = _.intersection(trainingDocument.targetRoles, roles);

        const matchTargetOutlets = _.intersection(_.map(trainingDocument.targetOutlets, '_id'), outlets); // Hiển thị khi không có cơ sở.


        let showOutlets = false;

        if (trainingDocument.targetOutlets.length === 0 || matchTargetOutlets.length > 0) {
          showOutlets = true;
        }

        return matchTargetRoles.length > 0 && showOutlets;
      } else {
        const mathTargetWorkDepartments = _.intersection(_.map(trainingDocument.targetWorkDepartments, '_id'), vm.selectedWorkDepartments);

        return mathTargetWorkDepartments.length > 0;
      }
    });
    vm.trainingDocumentTable.settings({
      dataset: vm.matchedTrainingDocuments
    });
  };

  vm.simditorConfig = {
    allowedAttributes: {
      img: ['src', 'alt', 'width', 'height', 'data-non-image'],
      a: ['href', 'target'],
      font: ['color'],
      code: ['class']
    },
    allowedStyles: {
      span: [],
      b: [],
      i: [],
      strong: [],
      strike: [],
      u: [],
      p: ['text-align'],
      h1: ['text-align'],
      h2: ['text-align'],
      h3: ['text-align'],
      h4: ['text-align'],
      h5: ['text-align']
    }
  };
}]);
'use strict';

angular.module('training-documents').factory('TrainingDocument', ['$resource', function ($resource) {
  return $resource('training-documents/:trainingDocumentId', {
    trainingDocumentId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    review: {
      method: 'PUT',
      url: 'training-documents/:trainingDocumentId/review'
    },
    updateViews: {
      method: 'PUT',
      url: 'training-documents/:trainingDocumentId/update-view'
    }
  });
}]);
'use strict'; // Setting up route

angular.module('training-entries').config(['$stateProvider', function ($stateProvider) {
  // Vendors state routing
  $stateProvider.state('listTrainingEntries', {
    url: '/training-entries',
    templateUrl: 'modules/training-entries/views/list-training-entries.client.view.html',
    resolve: {
      $title: _.constant('List Training Entries')
    }
  }).state('createTrainingEntry', {
    url: '/training-entries/create',
    templateUrl: 'modules/training-entries/views/create-training-entry.client.view.html',
    resolve: {
      $title: _.constant('Create Training Entry')
    }
  }).state('editTrainingEntry', {
    url: '/training-entries/:trainingEntryId/edit',
    templateUrl: 'modules/training-entries/views/edit-training-entry.client.view.html',
    resolve: {
      $title: _.constant('Edit Training Entry')
    }
  });
}]);
'use strict'; // Vendors controller

angular.module('training-entries').controller('TrainingEntriesController', ['$scope', '$stateParams', '$location', '$http', 'Authentication', 'BusinessService', 'Outlets', 'NgTableParams', 'TrainingEntries', 'FhdMessenger', 'ConfirmModal', 'WorkDepartments', 'TrainingEntriesService', 'TrainingProgressesService', function ($scope, $stateParams, $location, $http, Authentication, BusinessService, Outlets, NgTableParams, TrainingEntries, FhdMessenger, ConfirmModal, WorkDepartments, TrainingEntriesService, TrainingProgressesService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.data.questionType = [{
    id: 'essay',
    name: 'Tự luận'
  }, {
    id: 'sort',
    name: 'Sắp xếp'
  }, {
    id: 'sortTable',
    name: 'Nối bảng'
  }, {
    id: 'chooseCorrectAnswer',
    name: 'Chọn đáp án đúng'
  }, {
    id: 'checklist',
    name: 'Cần học'
  }];

  vm.checkAll = function () {
    _.forEach(vm.trainingEntriesTable.data, buyingEntry => {
      buyingEntry.checked = vm.toCheck;
    });
  };

  vm.data.roles = TrainingProgressesService.getRoles();
  $scope.$watch(() => vm.quickImportSort, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const lines = vm.quickImportSort.split('\n');
    vm.data.sortQuestion = _.reduce(lines, (result, line) => {
      const splited = line.split('. ');
      result.push({
        serial: +splited[0],
        description: splited[1]
      });
      return result;
    }, []);
  });
  $scope.$watch(() => vm.quickImportSortTableA, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const lines = vm.quickImportSortTableA.split('\n');
    vm.data.sortTable.groupA = _.reduce(lines, (result, line) => {
      result.push({
        description: line
      });
      return result;
    }, []);
  });
  $scope.$watch(() => vm.quickImportSortTableB, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const lines = vm.quickImportSortTableB.split('\n');
    vm.data.sortTable.groupB = _.reduce(lines, (result, line) => {
      const splited = line.split('. ');
      result.push({
        answer: +splited[0],
        description: splited[1]
      });
      return result;
    }, []);
  });
  $scope.$watch(() => vm.quickImportChoose, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const lines = vm.quickImportChoose.split('\n');
    vm.data.chooseCorrectAnswer = _.reduce(lines, (result, line) => {
      const splited = line.split('. ');
      result.push({
        isCorrect: splited[0] === 'x',
        description: splited[1]
      });
      return result;
    }, []);
  });

  vm.addQuestion = (questionType, trainingEntry, group) => {
    let data = trainingEntry || vm.data;

    switch (questionType) {
      case 'sort':
        return data.sortQuestion.push({
          serial: '',
          description: ''
        });

      case 'sortTable':
        if (group === 'A') {
          return data.sortTable.groupA.push({
            description: ''
          });
        }

        if (group === 'B') {
          return data.sortTable.groupB.push({
            description: '',
            answer: ''
          });
        }

        return FhdMessenger.error('Hmmm Something was wrong!');

      case 'chooseCorrectAnswer':
        return data.chooseCorrectAnswer.push({
          isCorrect: false,
          description: ''
        });

      default:
    }
  };

  vm.removeItem = (index, questionType, trainingEntry, group) => {
    let data = trainingEntry || vm.data;

    switch (questionType) {
      case 'sort':
        return data.sortQuestion.splice(index, 1);

      case 'sortTable':
        if (group === 'A') {
          return data.sortTable.groupA.splice(index, 1);
        }

        if (group === 'B') {
          return data.sortTable.groupB.splice(index, 1);
        }

        return FhdMessenger.error('Hmmm Something was wrong!');

      case 'chooseCorrectAnswer':
        return data.chooseCorrectAnswer.splice(index, 1);

      default:
    }
  };

  vm.init = () => {
    vm.trainingEntry = vm.trainingEntry || {};
    vm.data = vm.data || {};
    vm.data.outlets = Outlets.query();
    BusinessService.allAsync().then(businesses => {
      vm.data.businesses = businesses;
    });
    WorkDepartments.query().$promise.then(workDepartments => {
      vm.data.workDepartments = workDepartments;
    });
    vm.data.blocks = _.reduce(new Array(26), (result, item, index) => {
      result.push(index + 1);
      return result;
    }, []);
    vm.data.sortQuestion = [];
    vm.data.sortTable = {
      groupA: [],
      groupB: []
    };
    vm.data.chooseCorrectAnswer = [];
    vm.data.employeeTypes = [{
      id: 'all',
      name: 'Tất cả'
    }, {
      id: 'employee',
      name: 'Chính thức'
    }, {
      id: 'collaborator',
      name: 'Cộng tác viên'
    }, {
      id: 'collaborator-to-employee',
      name: 'Cộng tác viên lên chính thức'
    }];
    vm.data.roleMap = _.reduce(vm.data.roles, (result, role) => {
      result[role.id] = false;
      return result;
    }, {});
    vm.questionType = vm.data.questionType[0].id;
  };

  vm.getRoles = function () {
    return _.map(vm.data.roles, role => {
      return {
        id: role.id,
        title: role.name
      };
    });
  };

  vm.getQuestionType = () => {
    return _.map(vm.data.questionType, questionType => {
      return {
        id: questionType.id,
        title: questionType.name
      };
    });
  };

  vm.removeBusiness = function (index) {
    vm.trainingEntry.businesses.splice(index, 1);
  };

  vm.changeBusiness = function () {
    vm.trainingEntry.businesses = vm.trainingEntry.businesses || [];
    vm.trainingEntry.businesses.push(vm.business);
    vm.trainingEntry.businesses = _.union(vm.trainingEntry.businesses);
  };

  vm.changeWorkDepartment = function () {
    vm.trainingEntry.workDepartment = vm.workDepartment;
  };

  vm.create = () => {
    const roles = _.reduce(vm.data.roleMap, (rolesValue, toShow, role) => {
      if (toShow) rolesValue.push(role);
      return rolesValue;
    }, []);

    const err = TrainingEntriesService.validateTrainingEntry(vm.trainingEntry, roles, vm.questionType, vm.data);

    if (err) {
      return FhdMessenger.error(err);
    }

    vm.trainingEntry.content = vm.data.content;

    switch (vm.questionType) {
      case 'essay':
        break;

      case 'sort':
        vm.trainingEntry.sortQuestion = vm.data.sortQuestion;
        break;

      case 'sortTable':
        vm.trainingEntry.sortTable = vm.data.sortTable;
        break;

      case 'chooseCorrectAnswer':
        vm.trainingEntry.chooseCorrectAnswer = vm.data.chooseCorrectAnswer;
        break;

      case 'checklist':
        vm.trainingEntry.detail = vm.data.detail;
        break;

      default:
        return FhdMessenger.error('Không xác định được loại câu hỏi');
    }

    const trainingEntry = new TrainingEntries(vm.trainingEntry);
    trainingEntry.roles = roles;
    trainingEntry.questionType = vm.questionType;
    vm.waiting = true; // Redirect after save

    trainingEntry.$save().then(function () {
      vm.quickImportSort = '';
      vm.quickImportSortTableA = '';
      vm.quickImportSortTableB = '';
      vm.quickImportChoose = '';
      vm.data.content = '';
      vm.data.sortQuestion = [];
      vm.data.sortTable = {};
      vm.data.chooseCorrectAnswer = [];
      vm.trainingEntry.content = null;
      vm.trainingEntry.sortQuestion = null;
      vm.trainingEntry.sortTable = null;
      vm.trainingEntry.chooseCorrectAnswer = null;
      FhdMessenger.success('Đã tạo!');
    }, function (errorResponse) {
      FhdMessenger.error(errorResponse.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.trainingEntriesTable = new NgTableParams({
    count: 100
  });

  vm.find = () => {
    TrainingEntries.query().$promise.then(trainingEntries => {
      vm.trainingEntries = trainingEntries;

      _.forEach(vm.trainingEntries, trainingEntry => {
        trainingEntry.rolesStr = convertArrayToString(trainingEntry.roles);
        trainingEntry.outletsStr = convertArrayToString(trainingEntry.outlets, 'code');
        trainingEntry.businessesStr = convertArrayToString(trainingEntry.businesses, 'code');
      });

      vm.trainingEntriesTable.settings({
        dataset: vm.trainingEntries
      });
    });
  };

  function convertArrayToString(array, property) {
    const str = _.map(array, object => {
      if (property) {
        return _.get(object, property);
      }

      return object;
    }).join(', ');

    return str;
  }

  vm.deleteMultiTrainingEntries = function () {
    // * filter out the selected trainingEntries
    const selectedTrainingEntries = _.filter(vm.trainingEntriesTable.data, trainingEntry => trainingEntry.checked);

    if (!selectedTrainingEntries.length) {
      return FhdMessenger.error('Bạn chưa chọn training entry nào');
    }

    ConfirmModal.show({}, {
      headerText: `Xác nhận xóa các Training Entries đã chọn?`,
      bodyText: `Bạn có thực sự muốn xóa các Training Entries này ?`,
      actionButtonText: 'Xóa'
    }).then(() => {
      vm.waiting = true;
      $http.post('/training-entries/delete', {
        trainingEntryIds: _.map(selectedTrainingEntries, '_id')
      }).then(response => {
        vm.trainingEntriesTable.settings({
          dataset: _.reject(vm.trainingEntriesTable.data, {
            checked: true
          })
        });
      }).finally(() => {
        vm.waiting = false;
      }); // * remove the selected trainingEntries from the table
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.deleteTrainingEntries = function (trainingEntryItem, trainingEntry) {
    ConfirmModal.show({}, {
      headerText: `Xác nhận Xóa Training Entry ?`,
      bodyText: `Bạn có thực sự muốn  xóa Training Entry này ?`,
      actionButtonText: 'Xóa Training Entry'
    }).then(() => {
      trainingEntry.$delete().then(() => {
        vm.trainingEntries.splice(trainingEntryItem, 1);
        vm.trainingEntriesTable.reload();
      }).catch(FhdMessenger.errorFromServer);
    });
  };

  vm.findOne = () => {
    vm.trainingEntry = TrainingEntries.get({
      trainingEntryId: $stateParams.trainingEntryId
    });
    vm.trainingEntry.$promise.then(() => {
      _.forEach(vm.trainingEntry.roles, role => {
        vm.data.roleMap[role] = true;
      });
    });
  };

  vm.update = function () {
    const trainingEntry = vm.trainingEntry;

    const roles = _.reduce(vm.data.roleMap, (rolesValue, toShow, role) => {
      if (toShow) rolesValue.push(role);
      return rolesValue;
    }, []);

    if (!_.get(roles, 'length')) {
      return FhdMessenger.error('Chưa chọn vị trí áp dụng');
    }

    trainingEntry.roles = roles;
    trainingEntry.$update(function () {
      $location.path(`training-entries`);
      FhdMessenger.success('Cập nhật thành công!');
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };
}]);
'use strict';

angular.module('training-entries').factory('TrainingEntriesService', ['TrainingEntries', '$modal', '$http', function (TrainingEntries, $modal, $http) {
  return {
    validateTrainingEntry(trainingEntry, roles, questionType, data) {
      if (!_.get(trainingEntry, 'businesses.length')) {
        return 'Chưa chọn business';
      }

      if (!_.get(trainingEntry, 'employeeType')) {
        return 'Chưa chọn kiểu nhân viên';
      }

      if (!_.get(trainingEntry, 'block')) {
        return 'Chưa chọn buổi';
      }

      if (!_.get(roles, 'length')) {
        return 'Chưa chọn vị trí áp dụng';
      }

      if (!_.get(data, 'content')) {
        return 'Chưa có nội dung cho câu hỏi';
      }
    }

  };
}]);
'use strict'; // Vendors service used to communicate Vendors REST endpoints

angular.module('training-entries').factory('TrainingEntries', ['$resource', function ($resource) {
  return $resource('training-entries/:trainingEntryId', {
    trainingEntryId: '@_id'
  }, {
    update: {
      method: 'PUT'
    }
  });
}]);
"use strict";

angular.module('training-meetings').config(['$stateProvider', function ($stateProvider) {
  $stateProvider.state('createTrainingMeeting', {
    url: '/training-meetings/create',
    templateUrl: 'modules/training-meetings/views/create-training-meeting.client.view.html',
    resolve: {
      $title: _.constant('Create Training Meeting')
    }
  }).state('trainingMeetingCalendar', {
    url: '/training-meetings/calendar',
    templateUrl: 'modules/training-meetings/views/training-meetings-calendar.client.view.html',
    resolve: {
      $title: _.constant('Training Meetings Calendar')
    }
  }).state('editTrainingMeeting', {
    url: '/training-meetings/:trainingMeetingId/edit',
    templateUrl: 'modules/training-meetings/views/edit-training-meeting.client.view.html',
    resolve: {
      $title: _.constant('Edit Training Meeting')
    }
  });
}]);
"use strict";

angular.module('training-meetings').controller('CreateTrainingMeetingsController', ['$state', '$stateParams', 'helper', 'BusinessService', 'Outlets', 'NgTableParams', 'Authentication', 'ShiftEntries', 'TrainingMeetings', 'TrainingMeetingsService', 'TrainingProgressesService', 'FhdMessenger', function ($state, $stateParams, helper, BusinessService, Outlets, NgTableParams, Authentication, ShiftEntries, TrainingMeetings, TrainingMeetingsService, TrainingProgressesService, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.removeValueFromArray = helper.removeValueFromArray; // init when create

  vm.trainingMeeting = {
    type: 'newOfficialStaff',
    topic: '',
    description: '',
    notes: [],
    attendants: [],
    businesses: []
  };
  vm.data = {
    types: TrainingMeetingsService.getTypes(),
    businessMap: {}
  };
  BusinessService.allAsync().then(businesses => {
    vm.data.businesses = _.reject(businesses, {
      code: '4HANDY'
    });
  });

  vm.selectAttendant = attendant => {
    vm.trainingMeeting.attendants.push({
      staff: attendant,
      registeredBy: vm.user._id
    });
    attendant = null;
  };

  function validationTrainingMeeting() {
    if (!vm.trainingMeeting.topic) {
      return 'Vui lòng điền topic';
    }

    if (!vm.trainingMeeting.outlet) {
      return 'Vui lòng chọn outlet';
    }

    if (!vm.trainingMeeting.description) {
      return 'Vui lòng điền description';
    }

    if (!vm.trainingMeeting.startDate) {
      return 'Vui lòng điền ngày bắt đầu';
    }

    if (!_.get(vm.trainingMeeting, 'businesses.length')) {
      return 'Vui lòng chọn business';
    }

    if (!vm.trainingMeeting.endDate) {
      return 'Vui lòng điền ngày kết thúc';
    }

    if (moment(vm.trainingMeeting.startDate).isAfter(moment(vm.trainingMeeting.endDate))) {
      return 'Ngày bắt đầu > Ngày kêt thúc';
    }

    if (!vm.trainingMeeting.minSlot || !vm.trainingMeeting.maxSlot) {
      return 'Vui lòng nhập giới hạn số lượng người tham gia (tối thiểu và tối đa)';
    }

    if (vm.trainingMeeting.attendants.length < vm.trainingMeeting.minSlot || vm.trainingMeeting.attendants.length > vm.trainingMeeting.maxSlot) {
      return 'Số người tham dự phải lớn hơn số người tối thiểu và lớn hớn số người tối đa';
    }

    return false;
  }

  vm.create = function () {
    vm.trainingMeeting.businesses = _.reduce(vm.data.businessMap, (result, value, business) => {
      if (value) result.push(business);
      return result;
    }, []);
    const error = validationTrainingMeeting(vm.trainingMeeting);

    if (error) {
      return FhdMessenger.error(error);
    }

    const trainingMeeting = new TrainingMeetings(vm.trainingMeeting);
    vm.waiting = true;
    trainingMeeting.$save().then(() => {
      FhdMessenger.success('Tạo Training Meeting thành công');
      $state.reload();
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.getStaff = function (array) {
    const staffCodes = _.compact(vm.inputStaffs.split('\n'));

    const combinedCodes = _.map(staffCodes, code => code.trim().toLowerCase().replace(/(^|\s)\S/g, l => l.toUpperCase()));

    const sticketGetStaff = ShiftEntries.checkAndGetStaffs({
      query: combinedCodes
    });
    sticketGetStaff.$promise.then(staffs => {
      const mapCodeStaffs = _.map(staffs, 'code');

      const diffStaffs = _.difference(combinedCodes, mapCodeStaffs);

      if (diffStaffs.length > 0) {
        return FhdMessenger.error(`Nhân viên: ${diffStaffs.join(' ')} bị sai`);
      }

      _.forEach(staffs, staff => {
        if (!staff) return;

        const checkDuplicate = _.find(array, element => {
          return element.staff.code === staff.code;
        });

        if (!checkDuplicate) {
          array.push({
            staff: _.cloneDeep(staff),
            registeredBy: vm.user._id
          });
        }
      });

      vm.clearInput();
    });
  };
}]);
"use strict";

angular.module('training-meetings').controller('EditTrainingMeetingsController', ['$stateParams', '$location', '$scope', 'Authentication', 'TrainingMeetings', 'FhdMessenger', 'TrainingMeetingsService', 'helper', function ($stateParams, $location, $scope, Authentication, TrainingMeetings, FhdMessenger, TrainingMeetingsService, helper) {
  const vm = this;
  vm.user = Authentication.user;
  vm.removeValueFromArray = helper.removeValueFromArray;
  vm.data = {
    types: TrainingMeetingsService.getTypes()
  };

  vm.findOne = async () => {
    vm.trainingMeeting = TrainingMeetings.get({
      trainingMeetingId: $stateParams.trainingMeetingId
    }).$promise.then(trainingMeeting => {
      vm.trainingMeeting = trainingMeeting;
      vm.trainingMeeting.startDate = moment(vm.trainingMeeting.startDate).toDate();
      vm.trainingMeeting.endDate = moment(vm.trainingMeeting.endDate).toDate();
    });
  };

  vm.selectAttendant = attendant => {
    vm.trainingMeeting.attendants.push({
      staff: attendant,
      registeredBy: vm.user._id
    });
    attendant = null;
  };

  vm.addNote = () => {
    if (!vm.newNote) return;
    vm.trainingMeeting.notes.push({
      content: vm.newNote,
      user: vm.user,
      time: moment()
    });
    vm.newNote = '';
    vm.update();
  };

  vm.update = () => {
    vm.waiting = true;
    vm.trainingMeeting.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('training-meetings/calendar');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('training-meetings').controller('ModalViewTrainingMeetingController', ['Authentication', '$modalInstance', 'trainingMeeting', 'TrainingMeetings', '$window', '$http', 'FhdMessenger', function (Authentication, $modalInstance, trainingMeeting, TrainingMeetings, $window, $http, FhdMessenger) {
  const vm = this;
  vm.trainingMeeting = TrainingMeetings.get({
    trainingMeetingId: trainingMeeting._id
  });
  vm.user = Authentication.user;

  vm.close = () => $modalInstance.dismiss();

  vm.checkIn = attendant => {
    const confirm = $window.confirm(`Bạn chắc chắn muốn cập nhật trạng thái checkin của nhân viên ${attendant.staff.displayName}`);

    if (!confirm) {
      // đảo ngược boolean khi cancel
      attendant.hasCheckIn = !attendant.hasCheckIn;
      return;
    }

    vm.waiting = true;
    vm.trainingMeeting.attendant = attendant;
    vm.trainingMeeting.$checkIn().then(() => {
      if (attendant.hasCheckIn) return FhdMessenger.success('Check in thành công');
      if (!attendant.hasCheckIn) return FhdMessenger.success('Huỷ check in thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.attendantNote = attendant => {
    const confirm = $window.confirm(`Bạn chắc chắn muốn cập nhật note của nhân viên ${attendant.staff.displayName}`);

    if (!confirm) {
      return;
    }

    vm.trainingMeeting.attendant = attendant;
    vm.trainingMeeting.$addNote().then(() => {
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('training-meetings').controller('TrainingMeetingsController', ['$stateParams', '$location', '$scope', 'Authentication', 'TrainingMeetings', 'FhdMessenger', 'NgTableParams', 'ObjectId', '$compile', 'TrainingMeetingsService', function ($stateParams, $location, $scope, Authentication, TrainingMeetings, FhdMessenger, NgTableParams, ObjectId, $compile, TrainingMeetingsService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;

  vm.eventClick = event => {
    TrainingMeetingsService.openModalViewTrainingMeeting(event);
  };

  vm.eventRender = (event, element) => {
    const {
      topic,
      startDate,
      endDate,
      staff,
      outlet
    } = event;
    const startEventText = moment(startDate).format('HH:mm');
    const endEventText = moment(endDate).format('HH:mm');
    const header = `<strong>${topic}</strong><br/><span>${startEventText} - ${endEventText}</span><br/><strong>${_.get(outlet, 'code', '')}</strong><br/><span>${_.get(staff, 'code', '')} - ${_.get(staff, 'displayName', '')}</span>`;
    const contentElm = element.find('.fc-content');
    contentElm.prepend(`<div class=".fc-time">${header}</div>`);
    $compile(element)($scope);
  };

  vm.uiConfig = {
    height: 800,
    editable: true,
    header: {
      left: 'title',
      center: '',
      right: 'today month basicWeek prev,next'
    },
    firstDay: 1,
    weekNumbers: 4,
    defaultView: 'basicWeek',
    businessHours: {
      start: '08:00',
      end: '22:00'
    },
    eventClick: vm.eventClick,
    timezone: 'Asia/Ho_Chi_Minh',
    displayEventTime: false,
    eventOrder: ['start'],
    weekNumberCalculation: 'ISO',
    eventRender: vm.eventRender,
    lang: 'vi'
  };
  vm.eventSources = [{
    url: '/training-meetings/calendar',
    color: 'white',
    textColor: '#191919',
    borderColor: '#ABABAC',
    cache: true
  }];

  vm.findOne = async () => {
    vm.trainingMeeting = TrainingMeetings.get({
      trainingMeetingId: $stateParams.trainingMeetingId
    }).$promise.then(trainingMeeting => {
      vm.trainingMeeting = trainingMeeting;
    });
  };

  vm.update = () => {
    vm.waiting = true;
    vm.trainingMeeting.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('training-meetings');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

