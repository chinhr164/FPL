    resolve: {
      $title: _.constant('Create Payment Request')
    }
  }).state('viewPaymentRequest', {
    url: '/payment-requests/:paymentRequestId',
    templateUrl: 'modules/payment-requests/views/view-payment-request.client.view.html',
    resolve: {
      $title: _.constant('View Payment Request')
    }
  }); // .state('editPaymentRequest', {
