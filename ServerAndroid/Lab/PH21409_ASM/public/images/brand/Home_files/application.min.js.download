angular.module('job-posts').controller('JobPostsController', ['$stateParams', '$location', '$scope', 'Authentication', 'JobPosts', 'JobPostService', 'FhdMessenger', 'NgTableParams', 'ObjectId', '$state', '$sce', function ($stateParams, $location, $scope, Authentication, JobPosts, JobPostService, FhdMessenger, NgTableParams, ObjectId, $state, $sce) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.content = '';
  vm.types = JobPostService.getTypes();
  vm.domainOptions = [{
    label: 'FB Abby.vn',
    value: 'fb.com/abbyvietnam'
  }, {
    label: 'FB Savor.vn',
    value: 'fb.com/savor.vn'
  }, {
    label: 'FB Tuyển dụng Abby',
    value: 'fb.com/TuyenDungAbby'
  }, {
    label: 'FB Tuyển dụng Savor',
    value: 'fb.com/TuyendungSavor'
  }, {
    label: 'FB Abby Baking Space',
    value: 'fb.com/lambanhgato'
  }, {
    label: 'FB Bánh Đa Shop',
    value: 'fb.com/banhda'
  }, {
    label: 'we.abby.vn',
    value: 'we.abby.vn'
  }, {
    label: 'hr.savor.vn',
    value: 'hr.savor.vn'
  }, {
    label: 'JobsGo',
    value: 'jobsgo.vn'
  }, {
    label: 'TopCV',
    value: 'topcv.vn'
  }, {
    label: 'YBox',
    value: 'ybox.vn'
  }, {
    label: 'Group',
    value: 'group'
  }, {
    label: 'Instagram',
    value: 'instagram'
  }, {
    label: 'Khác',
    value: 'other'
  }];
  vm.statusMap = {
    active: true,
    inactive: false
  };
  vm.domainFilterData = vm.domainOptions.map(d => ({
    id: d.value,
    title: d.label
  }));
  vm.jobPost = {
    hrTasks: []
  };
  vm.newNote = '';

  vm.addHrTask = (hrTasks, hrTask) => {
    const matchHrTask = _.find(hrTasks, {
      _id: hrTask._id
    });

    if (!matchHrTask) {
      hrTasks.push(hrTask);
    } else {
      FhdMessenger.error(`Đã có HR Task ${hrTask.position} - ${hrTask.outlet.code} trong danh sách`);
    }
  };

  vm.removeHrTask = (hrTasks, hrTask) => {
    _.remove(hrTasks, {
      _id: hrTask._id
    });
  };

  vm.create = function () {
    if (!vm.jobPost.hrTasks || !vm.jobPost.hrTasks.length) {
      return FhdMessenger.error('Chưa chọn HR Task');
    }

    vm.jobPost.notes = [{
      content: vm.content,
      user: vm.user
    }];
    const jobPost = new JobPosts(vm.jobPost);
    jobPost.$save().then(() => {
      FhdMessenger.success('Tạo Job Post thành công');
      $state.go('listJobPosts');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    });
  };

  vm.jobPostsTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    vm.waiting = true;

    const statuses = _.reduce(vm.statusMap, (result, value, key) => {
      if (value) result.push(key);
      return result;
    }, []);

    JobPosts.query({
      statuses
    }).$promise.then(jobPosts => {
      vm.jobPosts = jobPosts;

      _.forEach(jobPosts, jobPost => {
        jobPost.hrTaskText = jobPost.hrTasks.map(hrTask => {
          return `${hrTask.position} - ${hrTask.outlet.code}`;
        }).join(' | ');
      });

      vm.jobPostsTable.settings({
        dataset: vm.jobPosts
      });
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  function trustNoteContent(jobPost, $sce) {
    jobPost.notes.forEach(note => {
      note.trustedContent = $sce.trustAsHtml(note.content);
    });
  }

  vm.findOne = () => {
    vm.jobPost = JobPosts.get({
      jobPostId: $stateParams.jobPostId
    }).$promise.then(jobPost => {
      vm.jobPost = jobPost;
      trustNoteContent(vm.jobPost, $sce);
    });
  };

  vm.update = () => {
    vm.waiting = true;

    try {
      if (vm.newNote) {
        vm.jobPost.newNote = vm.newNote;
      }

      if (!vm.jobPost.hrTasks || !vm.jobPost.hrTasks.length) {
        throw new Error('Chưa chọn HR Task nào!');
      }

      vm.jobPost.$update().then(response => {
        FhdMessenger.success('Cập nhật thành công');
        trustNoteContent(vm.jobPost, $sce);
        vm.newNote = '';
        $state.go('listJobPosts');
      }).catch(err => {
        FhdMessenger.error(err.data.message);
      }).finally(() => {
        vm.waiting = false;
      });
    } catch (err) {
      FhdMessenger.error(err.message);
    } finally {
      vm.waiting = false;
    }
  };

  vm.remove = jobPost => {
    vm.waiting = true;
    jobPost.$remove().then(response => {
      FhdMessenger.success('Xóa thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.onCopied = () => {
    FhdMessenger.success('Đã copy!');
  };
}]);
"use strict";

