angular.module('pop-quiz-questions').controller('PopQuizQuestionsController', ['$stateParams', '$location', '$scope', 'Authentication', 'PopQuizQuestions', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'ConfirmModal', function ($stateParams, $location, $scope, Authentication, PopQuizQuestions, FhdMessenger, NgTableParams, ObjectId, ConfirmModal) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.popQuizQuestion = {
    content: ''
  };
  vm.popQuizQuestionsTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    PopQuizQuestions.query().$promise.then(popQuizQuestions => {
      vm.popQuizQuestions = popQuizQuestions;
      vm.popQuizQuestionsTable.settings({
        dataset: vm.popQuizQuestions
      });
    });
  };

  vm.findOne = async () => {
    vm.popQuizQuestion = PopQuizQuestions.get({
      popQuizQuestionId: $stateParams.popQuizQuestionId
    }).$promise.then(popQuizQuestion => {
      vm.popQuizQuestion = popQuizQuestion;
    });
  };

  vm.update = () => {
    vm.waiting = true;
    vm.popQuizQuestion.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('pop-quiz-questions');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.import = () => {
    if (!vm.googleSheetLink) {
      return FhdMessenger.error('Bạn chưa điền link google sheet');
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ import question từ link gg sheet?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      PopQuizQuestions.import({
        googleSheetLink: vm.googleSheetLink
      }).$promise.then(questions => {
        return FhdMessenger.success(`Import ${questions.length} Questions thành công`);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

