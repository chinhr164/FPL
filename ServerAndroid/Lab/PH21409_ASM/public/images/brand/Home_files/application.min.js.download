  Menus.addSubMenuItem('topbar', 'stocks', 'Inventory Count', '/divider/', null, null, ['admin', 'tro-ly', 'tro-ly-kho', 'tro-ly-sx', 'inventory-counts:create', 'inventory-counts:view'], 24);
  Menus.addSubMenuItem('topbar', 'stocks', 'Create An Inventory Count', 'inventory-counts/create', null, false, ['admin', 'admin-stock', 'inventory-counts:create'], 25);
  Menus.addSubMenuItem('topbar', 'stocks', 'List Inventory Counts', 'inventory-counts', null, false, ['kho', 'sx', 'kitchen', 'tro-ly', 'tro-ly-kho', 'tro-ly-sx', 'admin', 'admin-stock', 'inventory-counts:create', 'inventory-counts:view'], 26);
  Menus.addSubMenuItem('topbar', 'stocks', 'Create An Inventory Count Schedule', 'inventory-count-schedules/create', null, false, ['admin', 'admin-stock'], 27);
  Menus.addSubMenuItem('topbar', 'stocks', 'List Inventory Counts Schedule', 'inventory-count-schedules', null, false, ['admin', 'admin-stock'], 28);
  Menus.addSubMenuItem('topbar', 'stocks', 'Stock Modifier', '/divider/', null, null, ['superadmin', 'admin', 'stock:edit', 'tro-ly', 'tro-ly-kho', 'tro-ly-sx', 'admin-stock', 'stock-count-entry:create'], 29);
  Menus.addSubMenuItem('topbar', 'stocks', 'Create A Stock Modifier', 'stock-modifiers/create', null, false, ['superadmin', 'admin', 'stock:edit', 'tro-ly', 'tro-ly-kho', 'tro-ly-sx', 'admin-stock', 'stock-count-entry:create'], 30);
  Menus.addSubMenuItem('topbar', 'stocks', 'Import A Stock Modifier', 'stock-modifiers/import', null, false, ['superadmin', 'stock:edit', 'admin'], 31);
  Menus.addSubMenuItem('topbar', 'stocks', 'List Stock Modifiers', 'stock-modifiers', null, false, ['superadmin', 'admin', 'stock:edit', 'tro-ly', 'tro-ly-kho', 'tro-ly-sx', 'admin-stock', 'stock-count-entry:create'], 32);
  Menus.addSubMenuItem('topbar', 'stocks', 'List Error Stocks', 'error-stocks', null, false, ['admin', 'tro-ly'], 33);
  Menus.addSubMenuItem('topbar', 'stocks', 'List Stock Explains', 'stock-explains', null, false, ['sale', 'marketing', 'kho', 'sx', 'ship', 'kitchen', 'tro-ly', 'tro-ly-kho', 'tro-ly-sx', 'admin', 'accountant', 'purchaser', 'probation-purchaser', 'stock-explaint:edit', 'stock-entries:find-by-outlet'], 34);
  Menus.addSubMenuItem('topbar', 'stocks', 'Logistics Request', '/divider/', null, null, ['user'], 35);
  Menus.addSubMenuItem('topbar', 'stocks', 'Create Logistics Request', 'logistics-requests/create', null, null, ['user'], 36);
  Menus.addSubMenuItem('topbar', 'stocks', 'List Logistics Requests', 'logistics-requests', null, null, ['user'], 37);
}]);
'use strict'; // Setting up route

angular.module('stocks').config(['$stateProvider', function ($stateProvider) {
  // Stocks state routing
  $stateProvider.state('listStocks', {
    url: '/stocks?business',
    templateUrl: 'modules/stocks/views/list-stocks.client.view.html',
    resolve: {
      $title: _.constant('Current Stock')
    }
  }).state('daysLeft', {
    url: '/days-left',
    templateUrl: 'modules/stocks/views/days-left.client.view.html',
    resolve: {
      $title: _.constant('Days Left')
    }
  }).state('availabilityTable', {
    url: '/availability-table',
    templateUrl: 'modules/reports/views/availability-table.client.view.html',
    resolve: {
      $title: _.constant('Availability Table')
    }
  }).state('savorStock', {
    url: '/savor-stock',
    templateUrl: 'modules/stocks/views/savor-stock.client.view.html',
    resolve: {
      $title: _.constant('Savor Stock')
    }
  }).state('rawStock', {
    url: '/raw-stock',
    templateUrl: 'modules/stocks/views/raw-stock.client.view.html',
    resolve: {
      $title: _.constant('Raw Stock')
    }
  }).state('stockMap', {
    url: '/stock-map',
    templateUrl: 'modules/stocks/views/view-stock-map.client.view.html',
    resolve: {
      $title: _.constant('Stock Map')
    }
  });
}]);
