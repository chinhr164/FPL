angular.module('display-stock-entries').controller('DisplayStockEntriesController', ['$scope', '$http', 'Authentication', 'FhdMessenger', 'OutletService', 'DisplayStockEntries', '$stateParams', '$state', 'NgTableParams', 'ProductService', function ($scope, $http, Authentication, FhdMessenger, OutletService, DisplayStockEntries, $stateParams, $state, NgTableParams, ProductService) {
  const vm = this;
  vm.user = Authentication.user;
  const formats = OutletService.getFormats();

  vm.getState = () => {
    vm.startDate = moment($stateParams.startDate).isValid() ? $stateParams.startDate : moment().startOf('week').format('YYYY-MM-DD');
    vm.endDate = moment($stateParams.endDate).isValid() ? $stateParams.endDate : moment().endOf('week').format('YYYY-MM-DD');
    vm.changeState();
  };

  vm.changeState = () => {
    $state.go('listDisplayStockEntries', {
      startDate: moment(vm.startDate).format('YYYY-MM-DD'),
      endDate: moment(vm.endDate).format('YYYY-MM-DD')
    });
  };

  vm.displayStockEntriesTable = new NgTableParams({}, {
    sorting: {
      created: 'desc'
    }
  });

  vm.find = () => {
    if (!vm.startDate || !vm.endDate) return;
    vm.waiting = true;
    const queryPromise = DisplayStockEntries.query({
      startDate: vm.startDate,
      endDate: vm.endDate
    }).$promise.then(displayStockEntries => {
      _.forEach(displayStockEntries, displayStockEntry => {
        displayStockEntry.diff = displayStockEntry.displayStock - displayStockEntry.oldDisplayStock;
      });

      vm.displayStockEntriesTable.settings({
        dataset: displayStockEntries
      });
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải', queryPromise, () => {
      FhdMessenger.success('Tải xong');
    });
  };

  vm.import = () => {
    if (!_.intersection(vm.user.roles, ['admin', 'purchaser', 'display-stock-entry:view']).length && _.some(vm.items, item => {
      return item.outletCode !== _.get(vm.user, 'outlet.code');
    })) {
      return FhdMessenger.error('Bạn chỉ được tạo yêu cầu đổi DS cho cơ sở của mình');
    }

    if (_.some(vm.items, item => {
      return !item.sku;
    })) {
      return FhdMessenger.error('Bạn chưa điền mã sản phẩm cần sửa DS');
    }

    if (_.some(vm.items, item => {
      return !item.outletCode && !formats.includes(_.toString(item.sellingProfile));
    })) {
      return FhdMessenger.error('Bạn chưa điền mã cơ sở/format cần sửa DS');
    }

    if (_.some(vm.items, item => {
      return !_.isNumber(item.displayStock) && !item.minimumStock && !item.stopSell;
    })) {
      return FhdMessenger.error('Bạn chưa điền DS/minDS/StopSell mới của sản phẩm');
    }

    vm.waiting = true;
    $http.post('display-stock-entries/import', vm.items).then(response => {
      FhdMessenger.success('Tạo thành công');
      $state.go('listDisplayStockEntries');
      return response.data;
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.quickEditProduct = ProductService.quickEditProduct;
}]);
"use strict";

