angular.module('review-events').controller('ReviewEventsController', ['$filter', '$compile', '$scope', 'ReviewRanks', 'ReviewEvents', 'FhdMessenger', '$location', '$stateParams', '$state', function ($filter, $compile, $scope, ReviewRanks, ReviewEvents, FhdMessenger, $location, $stateParams, $state) {
  const vm = this;
  vm.data = {};
  vm.data.reviewRanks = ReviewRanks.query();

  vm.initialValues = () => {
    vm.date = moment().startOf('day').format('YYYY-MM-DD');
    vm.data.reviewRanks.$promise.then(() => {
      vm.reviewRank = _.head(vm.data.reviewRanks)._id;
    });
  };

  vm.findOne = () => {
    vm.reviewEvent = ReviewEvents.get({
      reviewEventId: $stateParams.reviewEventId
    });
  };

  vm.update = () => {
    vm.reviewEvent.$update().then(() => FhdMessenger.success('Ok')).catch(FhdMessenger.errorFromServer);
  };

  vm.remove = () => {
    if (vm.reviewEvent) {
      vm.reviewEvent.$remove().then(() => {
        FhdMessenger.success('Ok');
        $state.go('listReviewEvents');
      });
    }
  };

  vm.create = () => {
    const date = moment(vm.date).startOf('day');
    const reviewEvent = new ReviewEvents({
      date,
      reviewRank: vm.reviewRank,
      reviewRankCode: _.get(_.find(vm.data.reviewRanks, {
        _id: vm.reviewRank
      }), 'code')
    });
    reviewEvent.$save().then(() => FhdMessenger.success('Ok')).catch(FhdMessenger.errorFromServer);
  };

  vm.calendarSources = [{
    url: '/review-events/calendar',
    color: 'white',
    textColor: '#191919',
    borderColor: '#ABABAC',
    cache: true
  }];

  vm.eventRender = function (event, element) {
    element.find('.fc-time').css({
      display: 'none'
    });

    if (!event.title) {
      const titleElm = element.find('.fc-title');
      titleElm.css({
        display: 'none'
      });
    }

    $compile(element)($scope);
  };

  vm.eventClick = reviewEvent => {
    $location.path(`/review-events/${reviewEvent._id}/edit`);
  };

  vm.calendarConfig = {
    height: 800,
    editable: true,
    header: {
      left: 'title',
      center: '',
      right: 'today month basicWeek prev,next'
    },
    firstDay: 1,
    weekNumbers: 4,
    defaultView: 'month',
    timezone: 'Asia/Ho_Chi_Minh',
    eventClick: vm.eventClick,
    eventDrop: vm.alertOnDrop,
    eventResize: vm.alertOnResize,
    weekNumberCalculation: 'ISO',
    eventRender: vm.eventRender,
    lang: 'vi'
  };
}]);
