angular.module('application-forms').controller('ModalCreateEvaluationFormController', ['applicationForm', '$modalInstance', '$http', 'FhdMessenger', function (applicationForm, $modalInstance, $http, FhdMessenger) {
  const vm = this;
  vm.isDisabledSubmitFormEntries = false;
  vm.answers = [];

  function getSlugFromPosition(position) {
    let searchSlug;

    switch (applicationForm.position) {
      case 'Trợ lý QLCS':
        searchSlug = 'danh-gia-tro-ly-co-so';
        break;

      case 'Nhân viên bán hàng':
        searchSlug = 'danh-gia-nhan-vien-ban-hang';
        break;

      case 'CTV bán hàng':
        searchSlug = 'danh-gia-nhan-vien-ban-hang';
        break;

      default:
        break;
    }

    return searchSlug;
  }

  vm.dismiss = () => {
    $modalInstance.close(true);
  };

  vm.init = () => {
    /* Get workforms by postions */
    $http.get(`/work-forms/${getSlugFromPosition(applicationForm.position)}`).then(evaluationWorkForms => {
      vm.evaluationWorkFormsGroups = _.groupBy(evaluationWorkForms.data.fields, 'fieldGroup');
      vm.evaluationWorkForms = evaluationWorkForms.data;
    }).catch(err => {
      FhdMessenger.error('Không tìm thấy phiếu đánh giá yêu cầu !');
      $modalInstance.close(true);
    });
  };

  vm.submitEvaluationWorkForms = () => {
    let formEntryFields = [];
    let applicationFormIdField = {};

    _.forEach(vm.evaluationWorkForms.fields, field => {
      if (vm.answers[field._id]) {
        let matchAnswers;

        if (field.fieldType === 'scale') {
          matchAnswers = _.find(field.answerOptions, {
            answerValue: vm.answers[field._id]
          });
        } else {
          matchAnswers = {
            answerLabel: '',
            answerValue: vm.answers[field._id]
          };
        }

        if (matchAnswers) {
          formEntryFields.push({
            fieldId: field._id,
            fieldLabel: field.fieldLabel,
            fieldGroup: field.fieldGroup,
            answers: [matchAnswers]
          });
        }
      }

      if (field.fieldLabel === 'ApplicationFormId') {
        applicationFormIdField = {
          fieldId: field._id,
          fieldLabel: field.fieldLabel,
          fieldGroup: field.fieldGroup,
          answers: [{
            answerValue: applicationForm._id
          }]
        };
      }
    });

    if (formEntryFields.length === 0) {
      return FhdMessenger.error('Nhập đầy đủ thông tin vào phiếu !');
    }

    vm.isDisabledSubmitFormEntries = true;
    $http.post('/form-entries', {
      formId: vm.evaluationWorkForms._id,
      formTitle: vm.evaluationWorkForms.title,
      fields: [...formEntryFields, applicationFormIdField]
    }).then(() => {
      FhdMessenger.success('Tạo phiếu đánh giá thành công !');
      $modalInstance.close(true);
    }).catch(err => {
      FhdMessenger.error(err.message);
    }).finally(() => {
      vm.isDisabledSubmitFormEntries = false;
    });
  };
}]);
'use strict';

angular.module('application-forms').controller('ModalCreateStaffApplicationFormController', ['applicationForm', 'Users', 'UserService', 'FhdMessenger', 'BusinessService', '$modalInstance', function (applicationForm, Users, UserService, FhdMessenger, BusinessService, $modalInstance) {
  const vm = this;
  vm.user = {};
  UserService.getRoleMap().then(roleMap => {
    vm.user.roleMap = _.clone(roleMap);
  });
  vm.data = {};

  vm.init = () => {
    // Check Exist User
    UserService.getUserInfo(applicationForm.cellphone).then(user => {
      if (user) {
        vm.staffUser = user;
      }
    }).catch(FhdMessenger.errorFromServer);
    BusinessService.allAsync().then(businesses => {
      vm.data.businesses = businesses;

      _.forEach(vm.data.businesses, business => {
        if (applicationForm.business.code === business.code) {
          vm.user.business = business;
          vm.user.businesses = [vm.user.business];
        }
      });
    });
    const fullNameMap = applicationForm.fullName.split(' ');
    vm.user.firstName = fullNameMap.pop();
    vm.user.lastName = _.reduce(fullNameMap, (result, item) => {
      return `${result} ${item}`;
    }, ``).trim();
    vm.user.address = _.get(_.find(applicationForm.formFields, field => field.label === 'Địa chỉ hiện tại'), 'value', null);
    vm.user.college = _.get(_.find(applicationForm.formFields, field => field.label === 'Bạn đang theo học tại trường nào?'), 'value', null);
    const splitBirthday = applicationForm.birthday.split('/');

    if (splitBirthday.length) {
      vm.user.birthday = moment(`${splitBirthday[2]}-${splitBirthday[1]}-${splitBirthday[0]}`).format('YYYY-MM-DD');
    }

    vm.user.cellphone = applicationForm.cellphone;
    vm.user.email = applicationForm.email;
    vm.user.outlet = applicationForm.outlet;
    vm.user.facebookLink = applicationForm.linkFacebook;
    vm.user.images = applicationForm.images;
    let position = '';

    if (applicationForm.position.match(/^CTV/)) {
      position = applicationForm.position.slice(4, applicationForm.position.length);
      vm.user.roleMap['CTV'] = true;
      vm.user.roleMap[position] = true;
    } else {
      position = applicationForm.position;
      vm.user.roleMap[position] = true;
    }
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.create = function () {
    if (!vm.user.code) {
      FhdMessenger.error('Please fill user code');
      return;
    }

    if (!_.get(vm.user.businesses, 'length', 0)) {
      return FhdMessenger.error('Người dùng chưa có business');
    }

    vm.user.business = _.head(vm.user.businesses);

    if (!vm.user.birthday) {
      return FhdMessenger.error('Thiếu ngày sinh nhân viên');
    }

    if (!vm.user.address) {
      return FhdMessenger.error('Thiếu hộ khẩu thường trú nhân viên');
    } // if (!vm.user.college) {
    //   return FhdMessenger.error('Thiếu trường đại học')
    // }
    // if (!vm.user.graduationYear) {
    //   return FhdMessenger.error('Thiếu năm tốt nghiệp')
    // }


    const roles = _.reduce(vm.user.roleMap, (rolesValue, toShow, role) => {
      if (toShow) rolesValue.push(role);
      return rolesValue;
    }, []);

    if (!roles.includes('outlet') && !_.intersection(roles, vm.user.rolePositions).length) {
      return FhdMessenger.error('Người dùng phải có ít nhất một quyền tại Positions');
    }

    vm.user.password = '12345678';
    vm.user.roles = roles;
    vm.user.username = vm.user.email;
    vm.user.applicationForm = applicationForm._id;
    const user = new Users(vm.user);
    vm.waiting = true;
    user.$save().then(staff => {
      /* Update application status after creating staff */
      applicationForm.$training().then(applicationForm => {
        $modalInstance.close(staff);
      }).catch(FhdMessenger.errorFromServer);
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('application-forms').controller('ModalEditProcessorsApplicationFormController', ['Authentication', 'applicationForm', 'FhdMessenger', '$modalInstance', '$http', function (Authentication, applicationForm, FhdMessenger, $modalInstance, $http) {
  const vm = this;
  vm.user = Authentication.user;
  vm.applicationForm = applicationForm;

  vm.removeValueFromArray = function (array, index) {
    array.splice(index, 1);
  };

  vm.cancel = function () {
