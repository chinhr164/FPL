angular.module('staff-salary-monthly-reports').component('parttimeShipSalaryTable', {
  templateUrl: '/modules/staff-salary-monthly-reports/templates/parttime-ship-salary-table.client.template.html',
  bindings: {
    salaryData: '='
  },
  controllerAs: 'vm',
  controller: ['SalaryTable', function (SalaryTable) {
    const vm = this;
    const allRanks = ['A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7', 'A8'];
    vm.doc = vm.salaryData;

    vm.init = () => {
      vm.hasSalaryRanks = _.filter(allRanks, rank => {
        if (_.get(vm.doc, `${rank}SalaryPerHour`, 0) > 0) {
          return true;
        }
      });

      _.set(vm.doc, _.head(vm.ranks), true);

      vm.mapSalary = _.reduce(vm.hasSalaryRanks, (result, rank) => {
        result[rank] = {
          hours: _.get(vm.doc, `${rank}Hours`, 0),
          resSalary: _.get(vm.doc, `${rank}ResSalary`, 0),
          revenue: _.get(vm.doc, `${rank}Revenue`, 0),
          addedSalary: _.get(vm.doc, `${rank}AddedSalary`, 0),
          salaryPerHour: _.get(vm.doc, `${rank}SalaryPerHour`, 0)
        };
        return result;
      }, {});
      vm.summarySalary = _.reduce(allRanks, (result, rank) => {
        result.resSalary += _.get(vm.mapSalary[rank], 'resSalary', 0);
        result.hours += _.get(vm.mapSalary[rank], 'hours', 0);
        result.revenue += _.get(vm.mapSalary[rank], 'revenue', 0);
        result.addedSalary += _.get(vm.mapSalary[rank], 'addedSalary', 0);
        return result;
      }, {
        hours: 0,
        resSalary: 0,
        revenue: 0,
        addedSalary: 0
      });
    };

    vm.viewSaleReport = () => {
      SalaryTable.viewShifts(vm.doc);
    };

    vm.viewSaleEntry = () => {
      SalaryTable.viewSaleEntries(vm.doc);
    };

    vm.viewBonus = () => {
      SalaryTable.viewBonuses(vm.doc);
    };

    vm.viewThumbup = () => {
      SalaryTable.viewThumbUps(vm.doc);
    };

    vm.viewSticket = () => {
      SalaryTable.viewTickets(vm.doc);
    };
  }]
});
"use strict";

