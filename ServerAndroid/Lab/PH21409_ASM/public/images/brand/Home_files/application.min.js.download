    scope: {
      stockEntryId: '=',
      stockEntryNumber: '=',
      labelColumn: '@',
      date: '='
    },
    link: function postLink(scope, element, attrs) {
      if (scope.labelColumn) {
        var labelElm = element.find('label');
        var inputElm = element.find('fhd-controls');
        labelElm.addClass('col-sm-' + scope.labelColumn);
        inputElm.addClass('col-sm-' + (12 - scope.labelColumn));
