angular.module('roles').controller('RolesController', ['FhdMessenger', '$window', '$location', 'Roles', function (FhdMessenger, $window, $location, Roles) {
  const vm = this;
  vm.role = {
    hideWithoutAdmin: false
  };

  vm.getRoles = function () {
    Roles.query().$promise.then(roles => {
      vm.roles = roles;
    });
  };

  vm.create = function () {
    if (!vm.role.roleId) {
      return FhdMessenger.error('Bạn chưa điền id của role');
    }

    if (!vm.role.label) {
      return FhdMessenger.error('Bạn chưa điền tên hiển thị của role');
    }

    if (!vm.role.type) {
      return FhdMessenger.error('Bạn chưa điền kiểu của role');
    }

    vm.waiting = true;
    const role = new Roles(vm.role);
    role.$save().then(() => {
      $location.path('/roles');
      FhdMessenger.success('Tạo role thành công.');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
