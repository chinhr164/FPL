angular.module('expense-entries').filter('expenseEntryStatus', [function () {
  return function (status) {
    switch (status) {
      case 'open':
        return 'Chờ duyệt';

      case 'closed':
        return 'Đã duyệt';

      case 'void':
        return 'Đã xóa';

      default:
        return 'Không xác định';
    }
  };
}]);
