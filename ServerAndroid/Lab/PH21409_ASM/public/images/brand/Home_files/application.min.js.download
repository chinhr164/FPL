angular.module('buying-entries').controller('ModalDoneBuyingEntryComplaintController', ['buyingEntry', 'BuyingEntries', 'index', '$modalInstance', 'FhdMessenger', function (buyingEntry, BuyingEntries, index, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.index = index;
  vm.buyingEntry = BuyingEntries.get({
    buyingEntryId: buyingEntry._id
  });

  vm.doneComplaint = function () {
    if (!vm.doneComplaintContent) {
      return FhdMessenger.error('Chưa có nội dung khiếu nại');
    }

    vm.buyingEntry.complaintWithVendors[vm.index].doneContent = vm.doneComplaintContent;
    vm.buyingEntry.complaintWithVendors[vm.index].done = moment();
    vm.buyingEntry.doneComplaintContent = vm.doneComplaintContent;
    vm.buyingEntry.$doneComplaint().then(buyingEntry => {
      $modalInstance.close(buyingEntry);
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
'use strict'; // Buying entries controller

angular.module('buying-entries').controller('ModalFindMultiBuyingEntriesController', ['$modalInstance', '$scope', 'FhdMessenger', 'BuyingEntryService', function ($modalInstance, $scope, FhdMessenger, BuyingEntryService) {
  const vm = this;
  vm.dismiss = $modalInstance.dismiss;
  vm.buyingEntries = [];

  vm.removeBuyingEntry = index => {
    vm.buyingEntries.splice(index, 1);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.find = function () {
    vm.waiting = true;
    let buyingEntryIds = vm.buyingEntryIds;
    BuyingEntryService.findBuyingEntriesByBuyingEntryIds(buyingEntryIds).then(buyingEntries => {
      FhdMessenger.success('Tìm thành công');
      vm.buyingEntries = buyingEntries;
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.import = function () {
    if (!vm.buyingEntries.length) {
      return FhdMessenger.error('Chưa có Buying Entry nào');
    }

    $modalInstance.close(vm.buyingEntries);
  };
}]);
"use strict";

angular.module('buying-entries').controller('ModalNotiProductsNoBeController', ['$modalInstance', 'Authentication', 'FhdMessenger', '$scope', 'BuyingEntries', function ($modalInstance, Authentication, FhdMessenger, $scope, BuyingEntries) {
  const vm = this;
  vm.user = Authentication.user;
  vm.items = [];
  vm.processStaffs = [];
  vm.waiting = false;
  vm.item = {};

  vm.add = () => {
    if (!vm.item.description) {
      return FhdMessenger.error('Chưa có tên sản phẩm');
    }

    if (!vm.item.quantity) {
      return FhdMessenger.error('Chưa có số lượng sản phẩm');
    }

    vm.items.push(vm.item);
    vm.item = {};
  };

  vm.remove = index => {
    vm.items.splice(index);
  };

  vm.removeStaff = index => {
    vm.processStaffs.splice(index);
  };

  $scope.$watch(() => vm.staff, (newValue, oldValue) => {
    if (newValue === oldValue || !newValue) return;
    vm.processStaffs.push(vm.staff);
    vm.staff = null;
  });

  vm.dismiss = () => {
    $modalInstance.dismiss();
  };

  vm.confirm = () => {
    if (!vm.items.length) {
      return FhdMessenger.error('Chưa có sản phẩm nào');
    }

    if (!_.every(vm.items, 'description')) {
      return FhdMessenger.error('Có sản phẩm chưa có tên');
    }

    if (!_.every(vm.items, 'quantity')) {
      return FhdMessenger.error('Có sản phẩm chưa có số lượng');
    }

    if (!vm.billImages.length) {
      return FhdMessenger.error('Chưa có ảnh hóa đơn');
    }

    if (!vm.productImages.length) {
      return FhdMessenger.error('Chưa có ảnh sản phẩm');
    }

    if (!vm.processStaffs.length) {
      return FhdMessenger.error('Chưa có nhân viên xử lý');
    }

    vm.waiting = true;
    BuyingEntries.noticeProductNoBuyingEntry({
      items: vm.items,
      billImages: vm.billImages,
      productImages: vm.productImages,
      processStaffs: vm.processStaffs,
      note: vm.note
    }).$promise.then(response => {
      vm.items = [];
      FhdMessenger.success('OK');
      vm.dismiss();
    }).catch(err => FhdMessenger.error(err.message)).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict'; // Buying entries controller

angular.module('buying-entries').controller('ModalUpdateDueDateBuyingEntriesController', ['$modalInstance', '$scope', 'Authentication', 'FhdMessenger', 'buyingEntries', 'BuyingEntryService', function ($modalInstance, $scope, Authentication, FhdMessenger, buyingEntries, BuyingEntryService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.buyingEntries = buyingEntries;

  _.forEach(vm.buyingEntries, buyingEntry => {
    buyingEntry.dueDate = moment(buyingEntry.dueDate).toDate();
  });

  vm.data = {};

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.dismiss = $modalInstance.dismiss;

  vm.updateDueDateBuyingEntries = function () {
    if (!vm.user.roles.includes('admin') && _.some(vm.buyingEntries, buyingEntry => {
      return !buyingEntry.note;
    })) {
      return FhdMessenger.error('Có Buying Entry chưa có lý do lùi hạn xử lý');
    }

    vm.waiting = true;
    let newBuyingEntries = vm.buyingEntries;
    BuyingEntryService.updateDueDateBuyingEntries(newBuyingEntries).then(buyingEntries => {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close(buyingEntries);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.autoDueDate = function (day) {
    _.forEach(vm.buyingEntries, buyingEntry => {
      buyingEntry.dueDate = moment(buyingEntry.created).add(day, 'day').toDate();
    });
  };

  $scope.$watch(() => vm.dueDateAll, function (newValue, oldValue) {
    if (newValue === oldValue) return;

    _.forEach(vm.buyingEntries, buyingEntry => {
      buyingEntry.dueDate = vm.dueDateAll;
    });
  });
  $scope.$watch(() => vm.noteAll, function (newValue, oldValue) {
    if (newValue === oldValue) return;

    _.forEach(vm.buyingEntries, buyingEntry => {
      buyingEntry.note = vm.noteAll;
    });
  });
}]);
"use strict";

angular.module('buying-entries').controller('ModalUpdatePaymentDeadlineController', ['buyingEntries', 'FhdMessenger', 'BuyingEntryService', '$modalInstance', function (buyingEntries, FhdMessenger, BuyingEntryService, $modalInstance) {
  const vm = this;
  vm.vendors = _.reduce(_.groupBy(buyingEntries, 'vendor.code'), (result, buyingEntries, vendorCode) => {
    return result.concat({
      vendor: buyingEntries[0].vendor,
      arrivedDates: _.map(_.groupBy(buyingEntries, buyingEntry => buyingEntry.arrived ? moment(buyingEntry.arrived).format('YYYY-MM-DD') : 'Chưa có ngày về'), (buyingEntries, arrivedDate) => {
        return {
          date: arrivedDate,
          buyingEntries: buyingEntries
        };
      })
    });
  }, []);

  vm.updatePaymentDeadline = function () {
    if (!vm.paymentDeadline) {
      return FhdMessenger.error('Chưa đặt ngày thanh toán');
    }

    BuyingEntryService.updatePaymentDeadline(_.map(buyingEntries, '_id'), vm.paymentDeadline).then(() => {
      FhdMessenger.success('Đã cập nhật');
      buyingEntries.forEach(buyingEntry => {
        buyingEntry.paymentDeadline = vm.paymentDeadline;
      });
      $modalInstance.close(buyingEntries);
    }).catch(FhdMessenger.errorFromServer);
  };
}]);
"use strict";

angular.module('buying-entries').controller('ModalUpdatePaymentStatusController', ['buyingEntries', 'BuyingEntryService', '$modalInstance', 'FhdMessenger', function (buyingEntries, BuyingEntryService, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.buyingEntries = buyingEntries;

  vm.updatePaymentStatus = () => {
    BuyingEntryService.updatePaymentStatus(_.map(buyingEntries, '_id'), vm.paymentStatus).then(() => {
      buyingEntries.forEach(buyingEntry => {
        buyingEntry.paymentStatus = vm.paymentStatus;
      });
      FhdMessenger.success('Update payment status successfully');
      $modalInstance.close();
    }).catch(FhdMessenger.errorFromServer);
  };
}]);
"use strict";

