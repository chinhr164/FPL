angular.module('sale-entries').controller('RefundedSaleEntriesController', ['$http', 'FhdMessenger', function ($http, FhdMessenger) {
  const vm = this;
  vm.data = {};
  vm.data.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD');

  vm.find = function () {
