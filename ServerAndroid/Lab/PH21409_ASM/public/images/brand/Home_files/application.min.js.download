      }
    });
  }

  function openTotalReportsBySupportStaffModal(staffId, reports, startDate, endDate) {
    return $modal.open({
      templateUrl: 'modules/thumb-ups/views/modal-total-reports-by-support-staff.client.view.html',
      controller: 'ModalReportsBySupportStaffController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        staffId: () => staffId,
        reports: () => reports,
        startDate: () => startDate,
        endDate: () => endDate
      }
    }).result;
  }

  return {
    addThumbUpModal,
    openThumbUpsByUserModal,
    openThumbUpsBySupportStaffModal,
    openTotalReportsBySupportStaffModal
  };
}]);
