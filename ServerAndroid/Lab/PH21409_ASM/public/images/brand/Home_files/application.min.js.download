  const vm = this;
  vm.workTask = WorkTasks.get({
    workTaskId: workTask._id
  });
  vm.user = Authentication.user;
  vm.isQcOrAdmin = true;

  if (!_.intersection(vm.user.roles, ['admin', 'QC']).length) {
    vm.isQcOrAdmin = false;
  }

  vm.changeWorkDepartment = function (workDepartment) {
    WorkTaskService.changeWorkDepartment(vm.workTask, workDepartment);
  };

  vm.createOutletReport = OutletReportService.openCreateOutletReportModal;

  vm.updateNote = () => {
    vm.updating = true;

    if (vm.newNote) {
      vm.workTask.note = vm.newNote;
    }

    const workTask = vm.workTask;
    workTask.$updateNote().then(() => {
      vm.newNote = '';
    }).catch(error => vm.error = error.data.messagge).finally(() => {
      vm.updating = false;
    });
  };

  vm.update = () => {
    vm.waiting = true;
    vm.workTask.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close();
      $state.reload();
      vm.waiting = false;
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.done = () => {
    vm.waiting = true;
    vm.workTask.$done().then(response => {
      FhdMessenger.success('QC task đã chuyển sang done');
      $modalInstance.close();
      $state.reload();
      vm.waiting = false;
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.doneWorkDepartment = workDepartment => {
    vm.workTask.workDepartment = workDepartment;
    WorkTaskService.openModalDoneWorkDepartmentForWorkTask(vm.workTask);
  };

  vm.openModalUpdateWorkDepartment = () => {
    PortraitService.openChooseProcessWorkDepartmentModal(vm.workTask).then(() => {
      vm.workTask.$updateWorkDepartment().then(res => {
        vm.portrait = res;
      }).catch(err => {
        FhdMessenger.error(err.message);
      });
    });
  };

  vm.removeValueFromArray = helper.removeValueFromArray;

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
