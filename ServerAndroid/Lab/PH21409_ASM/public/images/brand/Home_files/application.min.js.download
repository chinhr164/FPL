    name: 'Tự luận',
    code: 'ESSAY'
  }, {
    name: 'Điền chỗ trống',
    code: 'FILLBLANK'
  }, {
    name: 'Nối bảng',
    code: 'JOINTABLE'
  }, {
    name: 'Sắp xếp',
    code: 'SORT'
  }];
  vm.data.questionCategories = [{
    name: 'Tình huống',
    code: 'TINHHUONG'
  }, {
    name: 'Sản phẩm',
    code: 'SANPHAM'
  }, {
    name: 'Quy trình',
    code: 'QUYTRINH'
  }];
  $scope.$watch(() => vm.quickImportSortTableA, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const lines = vm.quickImportSortTableA.split('\n');
    vm.data.sortTable.groupA = _.reduce(lines, (result, line) => {
      result.push({
        description: line
      });
      return result;
    }, []);
  });
  $scope.$watch(() => vm.quickImportSortTableB, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const lines = vm.quickImportSortTableB.split('\n');
    vm.data.sortTable.groupB = _.reduce(lines, (result, line) => {
      const splited = line.split('. ');
      result.push({
        answer: +splited[0],
        description: splited[1]
      });
      return result;
    }, []);
  });
  $scope.$watch(() => vm.quickImportFillBlankAnswers, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const lines = vm.quickImportFillBlankAnswers.split('\n');
    vm.data.fillBlank = _.reduce(lines, (result, line) => {
      const splited = line.split('. ');
      result.push({
        key: +splited[0],
        answer: +splited[1]
      });
      return result;
    }, []);
  });
  $scope.$watch(() => vm.quickImportSort, (newValue, oldValue) => {
    if (newValue === oldValue) {
      return;
    }

    const lines = vm.quickImportSort.split('\n');
    vm.data.sortQuestion = _.reduce(lines, (result, line) => {
      const splited = line.split('. ');
      result.push({
        serial: +splited[0],
        description: splited[1]
      });
      return result;
    }, []);
  });

  vm.addQuestion = (questionType, question, group) => {
    let data = question || vm.data;

    switch (questionType) {
      case 'sort':
        return data.sortQuestion.push({
          serial: '',
          description: ''
        });

      case 'sortTable':
        if (group === 'A') {
          return data.sortTable.groupA.push({
            description: ''
          });
        }

        if (group === 'B') {
          return data.sortTable.groupB.push({
            description: '',
            answer: ''
          });
        }

        return FhdMessenger.error('Hmmm Something was wrong!');

      default:
    }
  };

  vm.loadDefault = function () {
    vm.question.answers = [];
    vm.question.questionType = vm.data.questionTypes[0];
    vm.question.questionCategory = vm.data.questionCategories[0];
    vm.question.point = 1;
    vm.data.sortQuestion = [];
    vm.data.sortTable = {
      groupA: [],
      groupB: []
    };
    vm.data.fillBlank = [];
    $http.get('/questions/get-question-id').success(function (data) {
      vm.question.questionId = data.questionId;

      if (data.message) {
        toaster.info(data.message);
      }
    }).error(function (errorResponse) {
      toaster.error(errorResponse.data.message);
    });
  };

  vm.addAnswer = function (event) {
    event.preventDefault();

    if (!vm.newAnswer) {
      toaster.error('Ô điền thêm lưạ chọn còn trống');
      return;
    }

    if (vm.newAnswer) {
      const answer = {
        isKey: false
      };

      if (vm.newAnswer && vm.newAnswer.match(/^https?:\/\/.*\.(jpg|png|jpeg)$/)) {
        answer.imageLink = vm.newAnswer;
      } else {
        answer.content = vm.newAnswer;
      }

      vm.question.answers.push(answer);
      vm.newAnswer = null;
    }
  };

  vm.removeAnswer = function (index) {
    vm.question.answers.splice(index, 1);
  };

  vm.removeItem = (index, questionType, question, group) => {
    let data = question || vm.data;

    switch (questionType) {
      case 'sort':
        return data.sortQuestion.splice(index, 1);

      case 'sortTable':
        if (group === 'A') {
          return data.sortTable.groupA.splice(index, 1);
        }

        if (group === 'B') {
          return data.sortTable.groupB.splice(index, 1);
        }

        return FhdMessenger.error('Hmmm Something was wrong!');

      default:
    }
  }; // Create new Question


  vm.create = function () {
    if (!vm.question.business) {
      return FhdMessenger.error('Chưa nhập business cho câu hỏi');
    }

    if (vm.question.questionType.code === 'MULTIPLE' && vm.question.answers.length === 0) {
      return FhdMessenger.error('Câu hỏi trắc nghiệm cần có danh sách đáp án');
    }

    if (vm.question.questionType.code === 'MULTIPLE' && !_.some(vm.question.answers, {
      isKey: true
    })) {
      return FhdMessenger.error('Câu hỏi trắc nghiệm cần có ít nhất 1 câu trả lời đúng');
    }

    if (vm.question.questionType.code === 'FILLBLANK') {
      vm.question.fillBlank = vm.data.fillBlank;

      if (vm.question.fillBlank.length === 0) {
        return FhdMessenger.error('Câu hỏi điền vào chỗ trống cần có đáp án');
      }
    }

    if (vm.question.questionType.code === 'FILLBLANK' && !vm.question.answer) {
      return FhdMessenger.error('Câu hỏi điền vào chỗ trống cần có đáp án');
    }

    if (vm.question.questionType.code === 'ESSAY' && !vm.question.point) {
      return FhdMessenger.error('Câu hỏi tự luận cần nhập thang điểm');
    }

    if (vm.question.questionType.code === 'JOINTABLE') {
      vm.question.sortTable = vm.data.sortTable;
    }

    if (vm.question.questionType.code === 'SORT') {
      vm.question.sortQuestion = vm.data.sortQuestion;
    } // Create new Question object


    var question = new Questions(vm.question); // Process question

    question.questionType = question.questionType.code;
    question.questionCategory = question.questionCategory.code; // console.log('question', question)
    // Redirect after save

    question.$save(function (response) {
      $state.reload();
      FhdMessenger.success('Tạo câu hỏi thành công'); // Clear form fields

      vm.name = '';
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Remove existing Question


  vm.remove = function (question) {
    if (question) {
      question.$remove();

      for (var i in vm.questions) {
        if (vm.questions[i] === question) {
          vm.questions.splice(i, 1);
        }
      }
    } else {
      vm.question.$remove(function () {
        $location.path('questions');
      });
    }
  };

  vm.bindBreakLine = QuestionService.bindBreakLine; // Update existing Question

  vm.update = function () {
    if (!vm.question.business) {
      return FhdMessenger.error('Chưa nhập business cho câu hỏi');
    }

    if (vm.question.questionType === 'MULTIPLE' && vm.question.answers.length === 0) {
      return FhdMessenger.error('Câu hỏi tự luận cần có danh sách đáp án');
    }

    if (vm.question.questionType === 'MULTIPLE' && !_.some(vm.question.answers, {
      isKey: true
    })) {
      return FhdMessenger.error('Câu hỏi tự luận cần có ít nhất 1 câu trả lời đúng');
    }

    if (vm.question.questionType === 'FILLBLANK') {
      for (let i = 0; i < vm.question.fillBlank.length; i++) {
        if (_.isNull(vm.question.fillBlank[i].key) || vm.question.fillBlank[i].answer === '') {
          return FhdMessenger.error('Câu hỏi điền vào chỗ trống cần có đáp án');
        }
      }
    }

    if (vm.question.questionType.code === 'FILLBLANK' && !vm.question.answer) {
      return FhdMessenger.error('Câu hỏi điền vào chỗ trống cần có đáp án');
    }

    var question = vm.question;

    if (vm.question.questionType !== 'MULTIPLE') {
      question.answers = [];
    }

    if (vm.question.questionType !== 'FILLBLANK') question.answer = null;
    question.$update(function () {
      $location.path('questions/' + question._id);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  };

  vm.questionsTable = new NgTableParams({
    count: 50
  }); // Find a list of Questions

  vm.find = function () {
    vm.questions = Questions.query(() => {
      vm.questionsTable.settings({
        dataset: vm.questions
      });
    });
    let promise = vm.questions.$promise.then(questions => {
      return questions;
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong!');
    });
  }; // Find existing Question


  vm.findOne = function () {
    vm.question = Questions.get({
      questionId: $stateParams.questionId
    });
  };

  vm.openEditQuestionModal = question => {
    QuestionService.openEditQuestionModal(question).result.then(quest => {
      const index = vm.questions.findIndex(q => quest.questionId === q.questionId);

      if (index >= 0) {
        vm.questions[index] = quest;
        vm.questionsTable.reload();
      }
    });
  };

  vm.openViewQuestionModal = QuestionService.openViewQuestionModal;
  vm.openDeleteQuestionModal = QuestionService.openDeleteQuestionModal;
}]);
"use strict";

angular.module('questions').filter('questionType', [function () {
  return function (type) {
    switch (type) {
      case 'ESSAY':
        return 'Tự luận';

      case 'FILLBLANK':
        return 'Điền ô trống';

      case 'MULTIPLE':
        return 'Trắc nghiệm';

      case 'SORT':
        return 'Sắp xếp';

      case 'JOINTABLE':
        return 'Nối bảng';

      default:
        return 'Không xác định';
    }
  };
}]);
'use strict';

angular.module('questions').factory('QuestionService', ['$modal', function ($modal) {
  return {
    openEditQuestionModal(question) {
      return $modal.open({
        templateUrl: 'modules/questions/views/modal-edit-question.client.view.html',
        controller: 'ModalEditQuestionsController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          questionId: () => question._id
        }
      });
    },

    openViewQuestionModal(question) {
      return $modal.open({
        templateUrl: 'modules/questions/views/modal-view-question.client.view.html',
        controller: 'ModalViewQuestionsController',
        size: 'lg',
        controllerAs: 'vm',
        resolve: {
          questionId: () => question._id
        }
      });
    },

    openDeleteQuestionModal(question) {
      return $modal.open({
        templateUrl: 'modules/questions/views/modal-delete-question.client.view.html',
        controller: 'ModalDeleteQuestionsController',
        size: 'sm',
        controllerAs: 'vm',
        resolve: {
          questionId: () => question._id
        }
      });
    },

    bindBreakLine(data) {
      if (!data) return;
      return data.replace(/(\n)/g, '<br />');
    }

  };
}]);
'use strict'; // Questions service used to communicate Questions REST endpoints

angular.module('questions').factory('Questions', ['$resource', function ($resource) {
  return $resource('questions/:questionId', {
    questionId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    importQuestions: {
      method: 'POST',
      url: '/questions/import',
      isArray: true
    }
  });
}]);
'use strict'; // Setting up route

angular.module('quizzes').config(['$stateProvider', function ($stateProvider) {
  // Quizzes state routing
  $stateProvider.state('listQuizzes', {
    url: '/quizzes',
    templateUrl: 'modules/quizzes/views/list-quizzes.client.view.html',
    resolve: {
      $title: _.constant('List Quizzes')
    }
  }).state('createQuiz', {
    url: '/quizzes/create',
    templateUrl: 'modules/quizzes/views/create-quiz.client.view.html',
    resolve: {
      $title: _.constant('Create Quizz')
    }
  }).state('viewQuiz', {
    url: '/quizzes/:quizId',
    templateUrl: 'modules/quizzes/views/view-quiz.client.view.html',
    resolve: {
      $title: _.constant('View Quizz')
    }
  }).state('editQuiz', {
    url: '/quizzes/:quizId/edit',
    templateUrl: 'modules/quizzes/views/edit-quiz.client.view.html',
    resolve: {
      $title: _.constant('Edit Quizz')
    }
  }).state('doQuiz', {
    url: '/quizzes/:quizId/do',
    templateUrl: 'modules/quizzes/views/do-quiz.client.view.html',
    resolve: {
      $title: _.constant('Do Quizz')
    }
  });
}]);
"use strict";

// Quizzes controller
angular.module('quizzes').controller('QuizzesController', ['$http', '$scope', '$stateParams', '$location', 'Authentication', 'NgTableParams', 'BusinessService', 'ObjectId', 'Quizzes', 'Questions', 'UserService', 'FhdMessenger', 'toaster', 'Outlets', '$state', 'ConfirmModal', '$localStorage', function ($http, $scope, $stateParams, $location, Authentication, NgTableParams, BusinessService, ObjectId, Quizzes, Questions, UserService, FhdMessenger, toaster, Outlets, $state, ConfirmModal, $localStorage) {
  const vm = this;
  vm.authentication = Authentication;
  const user = Authentication.user;
  vm.user = user;

  if (!_.intersection(user.roles, ['admin', 'tro-ly', 'tro-ly-ns', 'tro-ly-dt']).length) {
    $location.path('/');
  }

  BusinessService.allAsync().then(businesses => {
    vm.data.businesses = businesses;
  });
  vm.quizzInfo = 'Nothing';
  vm.rolesMap = {};
  vm.roles = [{
    id: 'sale',
    label: 'Bán hàng'
  }, {
    id: 'kitchen',
    label: 'Bếp'
  }, {
    id: 'kho',
    label: 'Kho'
  }, {
    id: 'ship',
    label: 'Ship'
  }, {
    id: 'marketing',
    label: 'Marketing'
  }, {
    id: 'sx',
    label: 'Đóng gói'
  }, {
    id: 'tro-ly',
    label: 'Trọ lý'
  }, {
    id: 'rank-b',
    label: 'Rank B'
  }, {
    id: 'rank-f',
    label: 'Rank F'
  }];
  vm.data = {
    outlets: Outlets.query({
      deleted: false
    }),
    draftQuestions: []
  };
  vm.questionTypeMap = {
    ESSAY: 'Tự luận',
    MULTIPLE: 'Trắc nghiệm',
    FILLBLANK: 'Điền ô trống',
    SORT: 'Sắp xếp',
    JOINTABLE: 'Nối bảng'
  };

  function getQuizInfo({
    ESSAY,
    MULTIPLE,
    FILLBLANK,
    SORT,
    JOINTABLE
  }) {
    return ` <p>Tự luận: ${ESSAY.length} câu </p>
        <p>Trắc nghiệm: ${MULTIPLE.length} câu </p>
        <p>Điền ô trống: ${FILLBLANK.length} câu </p>
        <p>Sắp xếp: ${SORT.length} câu </p>
        <p>Nối bảng: ${JOINTABLE.length} câu </p>
      `;
  }

  $scope.$watch(() => _.get(vm.quiz, 'questions.length'), (newValue, oldValue) => {
    if (newValue) {
      vm.quizzInfo = vm.getInfoQuestion(vm.quiz);
    }
  });
  $scope.$watch(() => _.get(vm.quiz, 'outlets.length'), (newValue, oldValue) => {
    if (newValue) {
      vm.quiz.outlets = _.filter(vm.quiz.outlets, (outlet, pos, arr) => {
        const index = _.findIndex(arr, _outlet => _outlet.code === outlet.code);

        return index === pos;
      });
      vm.outlet = '';
    }
  });
  $scope.$watch(() => {
    return _.get(vm, 'data.draftQuestions');
  }, () => {
    vm.questionsDraft = _.filter(vm.data.questions, question => {
      return _.includes(vm.data.draftQuestions, question._id);
    });
  });
  vm.questionsTable = new NgTableParams({
    count: 10
  }, {
    counts: []
  });
  vm.data.sourceQuestions = Questions.query(function () {
    _.forEach(vm.data.sourceQuestions, function (question) {
      question.fullDescription = question.questionId + ' ' + (question.business ? question.business.code : '') + ' ' + question.content;
      question.combinedType = vm.questionTypeMap[question.questionType];
    });

    vm.data.questions = vm.data.sourceQuestions;
    vm.questionsTable.settings({
      dataset: vm.data.sourceQuestions
    });
    $scope.$watch(() => _.get(vm, 'quiz.questions'), () => {
      if (!vm.quiz) return;

      _.forEach(vm.quiz.questions, question => {
        const matchQuestion = _.find(vm.data.questions, {
          _id: question._id
        });

        if (matchQuestion) matchQuestion.added = true;
      });
    });
  });

  vm.findStaffCanDo = function () {
    const business = vm.quiz.business;
    UserService.allStaffs(function (err, staffs) {
      vm.staffs = _.map(_.filter(staffs, staff => {
        const staffBussinesses = _.concat([ObjectId.getObjectId(staff.business)], _.map(staff.businesses, ObjectId.getObjectId));

        if (!_.some(staffBussinesses, _business => {
          return ObjectId.equals(_business, business);
        })) {
          return false;
        }

        if (vm.quiz.outlets.length && !_.some(vm.quiz.outlets, outlet => {
          return ObjectId.equals(outlet, staff.outlet);
        })) {
          return false;
        }

        return _.intersection(vm.quiz.targetRoles, staff.roles).length;
      }), staff => {
        return _.pick(staff, ['outlet', 'code', 'displayName']);
      });
      if (err) FhdMessenger.errorFromServer(err);
    });
  };

  function severQuestionByType(quiz) {
    return {
      ESSAY: _.filter(quiz.questions, ['questionType', 'ESSAY']),
      MULTIPLE: _.filter(quiz.questions, ['questionType', 'MULTIPLE']),
      FILLBLANK: _.filter(quiz.questions, ['questionType', 'FILLBLANK']),
      SORT: _.filter(quiz.questions, ['questionType', 'SORT']),
      JOINTABLE: _.filter(quiz.questions, ['questionType', 'JOINTABLE'])
    };
  }

  vm.addToPreview = function (_id) {
    if (_.findIndex(_.get(vm.quiz, 'questions', []), question => question._id === _id) === -1) {
      vm.data.draftQuestions.push(_id);
      vm.questionsDraft = _.filter(vm.data.questions, question => {
        return _.includes(vm.data.draftQuestions, question._id);
      });
    }
  };

  vm.removeQuestionPreview = function (e) {
    e.preventDefault();
    vm.data.draftQuestions = [];
  };

  vm.selectedBusiness = {
    ABBY: true,
    SAVOR: true,
    OTHER: true
  };

  vm.initCreate = () => {
    const copyQuestions = $localStorage.getObject('copyQuestions');

    if (_.get(copyQuestions, 'length') > 0) {
      $scope.$watch(() => _.get(vm, 'data.questions.length'), () => {
        _.forEach(vm.data.questions, question => {
          if (_.includes(copyQuestions, question._id)) {
            question.added = true;
            vm.quiz.questions.push(_.cloneDeep(question));
          }
        });

        $localStorage.setObject('copyQuestions', null);
      });
    }
  };

  vm.loadDefault = function () {
    vm.quiz = {
      title: null,
      questions: [],
      papers: []
    };
  };

  vm.newPaper = function () {
    vm.paper = {
      quiz: $stateParams.quizId,
      questions: []
    };
  };

  vm.addQuestionToQuizz = function (e) {
    e.preventDefault();

    _.forEach(vm.questionsDraft, question => {
      if (_.every(vm.quiz.questions, q => q._id !== question._id)) {
        const matchQuestion = _.find(vm.data.questions, {
          _id: question._id
        });

        matchQuestion.added = true;
        vm.quiz.questions.push(_.cloneDeep(question));
      }
    });

    vm.data.draftQuestions = [];
  };

  vm.removeQuestion = function (index) {
    const matchQuestion = _.find(vm.data.questions, {
      _id: vm.quiz.questions[index]._id
    });

    matchQuestion.added = false;
    vm.quiz.questions.splice(index, 1);
  }; // Chấm lại bài quiz khi thay đổi đáp án


  vm.reviewQuiz = function (quiz) {
    if (!quiz.hasUpdateQuestion) {
      return FhdMessenger.error('Không thể chấm lại bài quiz này');
    }

    quiz.$reviewQuiz().then(() => {
      FhdMessenger.success('Chấm lại bài quiz thành công');
      $state.reload();
    });
  };

  vm.getInfoQuestion = quiz => {
    return getQuizInfo(severQuestionByType(quiz));
  }; // Create new Quiz


  vm.create = function () {
    const roles = _.reduce(vm.roleMap, function (roles, value, role) {
      if (value) roles.push(role);
      return roles;
    }, []); // Create new Quiz object


    const quiz = new Quizzes(vm.quiz);

    if (!_.sum([quiz.numberOfEssayQuestions, quiz.numberOfSortQuestions, quiz.numberOfMultipleQuestions, quiz.numberOfFillBlankQuestions, quiz.numberOfJoinTableQuestions])) {
      return FhdMessenger.error('Bạn chưa nhập số lượng câu hỏi phải làm.');
    }

    const {
      ESSAY,
      MULTIPLE,
      FILLBLANK,
      SORT,
      JOINTABLE
    } = severQuestionByType(quiz);

    if (quiz.numberOfEssayQuestions > ESSAY.length) {
      return FhdMessenger.error('Số lượng câu hỏi tự luận phải làm đang không đủ trong quiz.');
    }

    if (quiz.numberOfSortQuestions > SORT.length) {
      return FhdMessenger.error('Số lượng câu hỏi sắp xếp phải làm đang không đủ trong quiz.');
    }

    if (quiz.numberOfJoinTableQuestions > JOINTABLE.length) {
      return FhdMessenger.error('Số lượng câu hỏi nối bảng phải làm đang không đủ trong quiz.');
    }

    if (quiz.numberOfFillBlankQuestions > FILLBLANK.length) {
      return FhdMessenger.error('Số lượng câu hỏi điền chỗ trống phải làm đang không đủ trong quiz.');
    }

    if (quiz.numberOfMultipleQuestions > MULTIPLE.length) {
      return FhdMessenger.error('Số lượng câu hỏi trắc nghiệm phải làm đang không đủ trong quiz.');
    }

    if (!quiz.percentRightToPass || quiz.percentRightToPass < 60) {
      return FhdMessenger.error('Phần trăm đúng để qua chưa hợp lệ');
    } // quiz.deadline = quiz.endDate


    quiz.targetRoles = roles;
    quiz.questions = _.map(quiz.questions, '_id');
    quiz.outlets = _.map(quiz.outlets, '_id'); // Redirect after save

    quiz.$save(function (response) {
      $location.path('training'); // Clear form fields

      vm.name = '';
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
      toaster.error(errorResponse.data.message);
    });
  }; // Remove existing Quiz


  vm.remove = function (quiz) {
    vm.waiting = true;
    quiz.$remove().then(() => {
      FhdMessenger.success('Đổi trạng thái deleted thành công');
      $location.path('quizzes');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Update existing Quiz


  vm.update = function () {
    var quiz = vm.quiz;

    var roles = _.reduce(vm.roleMap, function (roles, value, role) {
      if (value) roles.push(role);
      return roles;
    }, []);

    quiz.targetRoles = roles;
    vm.waiting = true;
    quiz.$update().then(() => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('quizzes/' + quiz._id);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = true;
    });
  }; // Update solved status


  vm.updateSolvedStatus = function () {
    vm.waiting = true;
    vm.quiz.$updateSolvedStatus().then(() => {
      updateStatusPaper(vm.quiz);
      vm.quizStaffsTable.settings({
        dataset: vm.quiz.papers
      });
      FhdMessenger.success('Cập nhật trạng thái đã xử lý thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.quizzesTable = new NgTableParams({
    count: 50
  }); // Find a list of Quizzes

  vm.find = function () {
    vm.quizzes = Quizzes.query({});
    vm.quizzes.$promise.then(() => {
      vm.quizzesTable.settings({
        dataset: vm.quizzes
      });
      FhdMessenger.success('Tải xong');
    });
  };

  vm.quizStaffsTable = new NgTableParams({
    count: 50
  }); // Find existing Quiz

  vm.findOne = function (loadAvailbleStaff) {
    vm.isDisplay = false;
    Quizzes.get({
      quizId: $stateParams.quizId
    }).$promise.then(quiz => {
      if (quiz.startDate) quiz.startDate = new Date(quiz.startDate);
      if (quiz.endDate) quiz.endDate = new Date(quiz.endDate);
      if (quiz.deadline) quiz.deadline = new Date(quiz.deadline);
      if (quiz.closeTime) quiz.closeTime = new Date(quiz.closeTime);
      if (quiz.openTime) quiz.openTime = new Date(quiz.openTime);
      vm.roleMap = _.reduce(quiz.targetRoles, function (roles, value, role) {
        roles[value] = true;
        return roles;
      }, {});
      vm.quiz = quiz;
      updateStatusPaper(vm.quiz);

      if (loadAvailbleStaff) {
        vm.findStaffCanDo();
      }

      vm.quizStaffsTable.settings({
        dataset: _.sortBy(vm.quiz.papers, paper => paper.paper && -paper.paper.created)
      });
      FhdMessenger.success('Tải xong');
    });
  };

  function updateStatusPaper(quiz) {
    _.forEach(quiz.papers, _paper => {
      if (!_paper.paper) return;
      _paper.paper.doTime = moment(_paper.paper.submited) - moment(_paper.paper.created);
      _paper.paper.sumQuesRight = _.reduce(_paper.paper.questions, (result, item) => {
        if (item.point > 0) {
          result += 1;
        }

        return result;
      }, 0);
      _paper.isSolved = _paper.isSolved || false;
    });

    quiz.papers = _.map(vm.quiz.papers, paper => {
      if (_.get(paper.paper, 'comments.length', 0)) {
        paper.isReply = true;
      } else {
        paper.isReply = false;
      }

      return paper;
    });
  }

  vm.displayQuiz = function () {
    if (vm.isDisplay === false) {
      vm.isDisplay = true;
    } else {
      vm.isDisplay = false;
    }
  };

  vm.tryQuiz = function () {
    $location.path(`/training/${$stateParams.quizId}`);
  };

  vm.open = function ($event) {
    $event.preventDefault();
    $event.stopPropagation();
    vm.opened = true;
  };

  vm.sortQuestion = function () {
    if (!vm.searchText) {} else {
      const wordArray = _.compact(vm.searchText.split(' '));

      _.forEach(vm.data.questions, question => {
        const score = _.sumBy(wordArray, word => {
          return _.includes(question.content, word) ? word.length : 0;
        });

        _.assign(question, {
          score
        });
      });

      vm.data.questions.sort((a, b) => {
        return b.score - a.score;
      });
    }
  };

  vm.pending = quiz => {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Hành động này sẽ chuyển Quiz (${quiz.title}) sang trạng thái pending`,
      bodyText: `Bạn chắc chắn muốn chuyển  ???`
    }).then(() => {
      vm.waiting = true;
      quiz.$pending().then(() => {
        FhdMessenger.success('Chuyển trạng thái thành công');
        $location.path('quizzes');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.pendingToCreated = quiz => {
    vm.waiting = true;
    quiz.$pendingToCreated().then(() => {
      FhdMessenger.success('Chuyển trạng thái thành công');
      $location.path('quizzes');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.copyToNewQuiz = quiz => {
    const questions = _.get(quiz, 'questions', []);

    $localStorage.setObject('copyQuestions', _.map(questions, '_id'));
    $state.go('createQuiz');
  };
}]);
'use strict'; // Quizzes service used to communicate Quizzes REST endpoints

angular.module('quizzes').factory('Quizzes', ['$resource', function ($resource) {
  return $resource('quizzes/:quizId', {
