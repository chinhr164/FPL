angular.module('sale-reports').config(['$stateProvider', function ($stateProvider) {
  // Sale reports state routing
  $stateProvider.state('listSaleReports', {
    url: '/sale-reports',
    templateUrl: 'modules/sale-reports/views/list-sale-reports.client.view.html',
    resolve: {
      $title: _.constant('Sale Reports')
    }
  }).state('createSaleReport', {
    url: '/sale-reports/create',
    templateUrl: 'modules/sale-reports/views/create-sale-report.client.view.html',
    resolve: {
      $title: _.constant('Create Sale Report')
    }
  }).state('tableSaleReports', {
    url: '/sale-reports/table',
    templateUrl: 'modules/sale-reports/views/table-sale-reports.client.view.html',
    resolve: {
      $title: _.constant('Table Sale Reports')
    }
  }).state('tableKPI', {
    url: '/sale-reports/table-kpi',
    templateUrl: 'modules/sale-reports/views/table-KPI.client.view.html',
    resolve: {
      $title: _.constant('Table KPI')
    }
  }).state('requestTransferLate', {
    url: '/sale-reports/request-transfer-late',
    templateUrl: 'modules/sale-reports/views/request-transfer-late.client.view.html',
    resolve: {
      $title: _.constant('Request Transfer Late')
    }
  }).state('viewSaleReport', {
    url: '/sale-reports/:saleReportId',
    templateUrl: 'modules/sale-reports/views/view-sale-report.client.view.html',
    resolve: {
      $title: _.constant('View Sale Report')
    }
  }).state('editSaleReport', {
    url: '/sale-reports/:saleReportId/edit',
    templateUrl: 'modules/sale-reports/views/edit-sale-report.client.view.html',
    resolve: {
      $title: _.constant('Edit Sale Report')
    }
  });
}]);
"use strict";

function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

// Sale reports controller
angular.module('sale-reports').controller('SaleReportsController', ['$scope', '$stateParams', '$location', '$window', 'helper', 'Authentication', 'BusinessService', 'BuyingEntryService', 'ExpenseEntries', 'ExpenseSubCategories', 'ExpenseEntryService', 'JsPrintService', 'MoneyEntryService', 'NgTableParams', 'SaleReports', 'SaleReportService', 'StockEntries', 'Outlets', '$http', 'CurrentShift', 'ObjectId', 'ShiftPositions', 'ConfirmModal', 'FhdMessenger', '$state', 'SaleEntryService', 'OfflineMode', 'UserPhotoService', 'Vendors', 'ShiftEntryService', 'CustomerRequests', 'CustomerRequestService', 'OutletReports', 'OnlineOrders', 'BuyingEntries', function ($scope, $stateParams, $location, $window, helper, Authentication, BusinessService, BuyingEntryService, ExpenseEntries, ExpenseSubCategories, ExpenseEntryService, JsPrintService, MoneyEntryService, NgTableParams, SaleReports, SaleReportService, StockEntries, Outlets, $http, CurrentShift, ObjectId, ShiftPositions, ConfirmModal, FhdMessenger, $state, SaleEntryService, OfflineMode, UserPhotoService, Vendors, ShiftEntryService, CustomerRequests, CustomerRequestService, OutletReports, OnlineOrders, BuyingEntries) {
  const vm = this;
  vm.user = Authentication.user;
  vm.offlineModeData = OfflineMode.offlineModeData;
  vm.adminStaff = _.intersection(['admin', 'accountant'], vm.user.roles).length;
  vm.removeValueFromArray = helper.removeValueFromArray;
  const typeMoneys = [500000, 200000, 100000, 50000, 20000, 10000, 5000, 2000, 1000, 1];
  vm.needImageExpenses = ['Dụng cụ/ Đồ dùng vận hành', 'Gas', 'Internet', 'Nước sinh hoạt', 'Điện sinh hoạt', 'Thẻ điện thoại', 'Vệ sinh môi trường', 'Tài sản cố định', 'Chi phí khác', 'Chi phí sửa chữa, thay thế CSVC', 'Cho vay', 'Thuế', 'Đồ văn phòng phẩm']; // Available values for fields

  vm.data = {};
  vm.data.shifts = MoneyEntryService.getShifts();
  vm.addCustomer = SaleEntryService.addCustomerToSaleEntry;

  vm.printTypeOfBankNote = function () {
    JsPrintService.printElementById('print-type-of-bank-note-client', true);
  };

  function getTotalShipCash(saleEntry) {
    if (saleEntry.paymentType === 'transfer') {
      return 0 - _.get(saleEntry, 'shipping.pay', 0);
    }

    return _.get(saleEntry, 'shipping.collect', 0) - _.get(saleEntry, 'shipping.pay', 0);
  }

  vm.staffsInShiftEntry = [];
  vm.shiftMap = _.reduce(vm.data.shifts, (result, shift) => {
    result[shift._id] = false;
    return result;
  }, []);

  if (vm.user && vm.user.roles.includes('admin')) {
    BusinessService.allAsync().then(businesses => {
      vm.data.businesses = businesses;
      vm.businessMap = _.reduce(vm.data.businesses, (result, business) => {
        result[business._id] = true;
        return result;
      }, {});
    });
  }

  vm.choosePhotos = function () {
    UserPhotoService.view().then(photos => {
      photos.forEach(photo => vm.expenseEntry.images.push({
        link: photo.link
      }));
    });
  };

  vm.isProcessing = false;

  vm.hideSaleEntry = function (saleEntry) {
    if (vm.isProcessing === true) return;
    vm.isProcessing = true;
    SaleEntryService.confirmHideSaleEntry(saleEntry).result.then(function () {
      vm.isProcessing = false;
      FhdMessenger.success('Chuyển thành công');
      $state.reload();
    }).catch(() => {
      vm.isProcessing = false;
    });
  };

  vm.selectAll = function (field) {
    const map = vm[`${field}Map`];
    let newValue = true;
    if (_.every(map)) newValue = false;

    _.forEach(map, (value, key) => {
      map[key] = newValue;
    });
  };

  vm.data.startDate = moment().startOf('day').format('YYYY-MM-DD');
  vm.data.endDate = moment().startOf('day').format('YYYY-MM-DD');
  $http.get('/users/staffs').success(function (users) {
    vm.data.staffs = users;

    _.forEach(users, function (user) {
      user.fullDescription = `${user.code} - ${user.displayName} - ${user.outlet ? user.outlet.name : ''}`;
    });
  }).error(function (errorRespond) {
    FhdMessenger.errorFromServer(errorRespond);
  }); // Initialization values for new saleReport

  vm.init = function () {
    const currentShift = CurrentShift.getCurrentShift();
    vm.currentShift = currentShift;

    if (!currentShift || !currentShift._id) {
      return FhdMessenger.error('Bạn chưa nhập ca trực hiện tại!');
    }

    vm.staffs = currentShift.staffs;
    vm.saleReport = {
      initialPettyCash: currentShift.initialPettyCash,
      totalExpense: 0,
      totalRevenue: 0,
      totalDeposit: 0,
      estimatedCash: 0,
      drawerCash: currentShift.initialPettyCash,
      differentCash: 0,
      totalCash: 0,
      saleEntries: [],
      customerRequests: [],
      staffs: currentShift.staffs || [],
      shift: currentShift.shift,
      date: currentShift.date,
      outlet: currentShift.outlet,
      typeBankNote: _.map(typeMoneys, typeOfMoney => {
        return {
          typeOfMoney
        };
      }),
      bankNoteReal: 0,
      numDoneViettelOrder: null,
      outletReports: [],
      unreceivedStockEntries: [],
      unconfirmDirectBuyingEntries: []
    };

    if (_.get(vm.saleReport, 'outlet.code', '').match(/[MES]\d+/) && _.get(vm.saleReport, 'outlet.numCooler')) {
      vm.saleReport.coolerTemperatures = _.map(new Array(_.get(vm.saleReport, 'outlet.numCooler')), (coolerTemperature, index) => {
        return {
          num: index + 1
        };
      });
    }

    vm.expenseEntry = {};
    Vendors.getIceVendors().$promise.then(vendors => {
      vm.data.vendors = vendors;
    });
    vm.loadCustomerRequest();
    vm.updateSaleEntries();
    vm.updateExpenseEntries();

    if (currentShift.outlet) {
      vm.positions = ShiftPositions.getPostions(vm.saleReport.outlet);
      vm.positions = vm.positions.concat(ShiftPositions.PROBATION_POSITIONS);
    }

    vm.expenseEntry.images = vm.expenseEntry.images || [];
  };

  vm.loadUnconfirmedDocument = currentShift => {
    vm.waiting = true;
    Promise.all([vm.getReadyOnlineOrders(currentShift), vm.loadOutletReports(currentShift.outlet._id), vm.loadUnreceivedStockEntries(currentShift.date, currentShift.outlet), vm.loadUnconfirmDirectBuyingEntries(currentShift.date, currentShift.outlet._id, currentShift.shift)]).then(() => {
      vm.doneFindUnconfirmedDocument = true;
      vm.waiting = false;
    });
  };

  vm.getReadyOnlineOrders = currentShift => {
    OnlineOrders.getReady({
      outlet: currentShift.outlet._id
    }).$promise.then(readyOnlineOrders => {
      vm.readyOnlineOrders = readyOnlineOrders;
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    });
  };

  vm.loadUnreceivedStockEntries = (date, outlet) => {
    if (moment(date).diff(moment().startOf('day')) <= 0) {
      return;
    }

    StockEntries.getUnreceivedStockEntries({
      date,
      destination: ObjectId.getObjectId(outlet)
    }).$promise.then(unreceivedStockEntries => {
      vm.saleReport.unreceivedStockEntries = unreceivedStockEntries;
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    });
  };

  vm.loadUnconfirmDirectBuyingEntries = (date, outletId, shift) => {
    if (shift !== 'T') {
      return;
    }

    BuyingEntries.getUnconfirmDirectBuyingEntries({
      destinationId: outletId,
      date
    }).$promise.then(unconfirmDirectBuyingEntries => {
      vm.saleReport.unconfirmDirectBuyingEntries = unconfirmDirectBuyingEntries;
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    });
  };

  vm.loadOutletReports = outletId => {
    OutletReports.getCreated({
      outlet: outletId
    }).$promise.then(outletReports => {
      vm.saleReport.outletReports = outletReports;
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    });
  };

  vm.currentShiftEntry = () => {
    const currentShift = CurrentShift.getCurrentShift();

    if (!_.get(currentShift, 'outlet._id')) {
      return;
    }

    ShiftEntryService.findShiftEntry({
      outlet: currentShift.outlet._id,
      shift: currentShift.shift,
      date: currentShift.date
    }).then(shiftEntry => {
      if (shiftEntry) {
        const staffWithPositions = _.reduce(shiftEntry.employees, (result, employee) => {
          result[employee.staff] = employee.positions;
          return result;
        }, {});

        vm.saleReport.staffs = _.map(vm.staffs, staff => {
          const positions = staffWithPositions[staff._id];

          _.forEach(positions, position => {
            _.set(staff, `${position}`, true);
          });

          staff.hasPosition = true;
          return staff;
        });
        vm.staffsInShiftEntry = _.cloneDeep(vm.saleReport.staffs);
      }
    });
  };

  vm.loadExpenseEntrySubCategory = function () {
    ExpenseSubCategories.query({
      isPrivate: false
    }).$promise.then(expenseSubCategories => {
      vm.data.expenseCategories = _.reduce(expenseSubCategories, (result, expenseSubCategory) => {
        result.push({
          expenseSubCategory: {
            _id: ObjectId.getObjectId(expenseSubCategory),
            name: expenseSubCategory.name
          },
          expenseCategory: expenseSubCategory.expenseCategory
        });
        return result;
      }, []);
    });
  };

  vm.openModalViewCR = customerRequest => {
    CustomerRequestService.showRequestHistory(customerRequest);
  };

  vm.loadCustomerRequest = function () {
    const currentShift = CurrentShift.getCurrentShift();
    CustomerRequests.query({
      shift: _.get(currentShift, 'shift'),
      date: _.get(currentShift, 'date'),
      outlets: [_.get(currentShift, 'outlet')._id],
      isSaleReport: true
    }).$promise.then(customerRequests => {
      vm.saleReport.customerRequests = getCustomerRequestsWithDeposits(customerRequests);
      vm.saleReport.totalDeposit = getTotalDepositInCustomerRequests(vm.saleReport.customerRequests);
      vm.saleReport.totalDepositTypeCustomerRequest = getTotalDepositTypeInCustomerRequests(vm.saleReport.customerRequests);
      vm.calculate();
    });
  };

  function getTotalDepositInCustomerRequests(customerRequests) {
    return _.reduce(customerRequests, (result, customerRequest) => {
      result += _.get(customerRequest, 'totalDeposit', 0);
      return result;
    }, 0);
  }

  function getTotalDepositTypeInCustomerRequests(customerRequests) {
    return _.reduce(customerRequests, (result, customerRequest) => {
      _.forEach(customerRequest.totalDepositType, (amount, depositType) => {
        if (!result[depositType]) {
          result[depositType] = 0;
        }

        result[depositType] += amount;
      });

      return result;
    }, {});
  }

  function getCustomerRequestsWithDeposits(customerRequests) {
    const _customerRequestWithDeposits = _.map(customerRequests, customerRequest => {
      const totalDeposit = _.reduce(customerRequest.deposits, (result, deposit) => {
        result += deposit.amount;
        return result;
      }, 0);

      const totalDepositType = _.reduce(customerRequest.deposits, (result, deposit) => {
        if (!result[deposit.depositType]) {
          result[deposit.depositType] = 0;
        }

        result[deposit.depositType] += deposit.amount;
        return result;
      }, {});

      customerRequest.totalDepositType = totalDepositType;
      return _objectSpread({}, customerRequest, {
        totalDeposit,
        totalDepositType
      });
    });

    return _customerRequestWithDeposits;
  }

  vm.updateSaleEntries = function () {
    if (!vm.saleReport.outlet) return;

    if (vm.offlineModeData.offlineMode) {
      FhdMessenger.error('Chưa kết nối được với server.');
      return;
    }

    vm.updatingSaleEntries = true;
    vm.checkStaff();
    $http.get('/sale-entries/sale-entries-in-shift', {
      params: {
        outlet: ObjectId.getObjectId(vm.saleReport.outlet),
        shift: vm.saleReport.shift,
        date: vm.saleReport.date
      }
    }).success(function (saleEntries) {
      vm.saleReport.saleEntries = saleEntries;
      vm.updatingSaleEntries = false;
      vm.calculate();
    }).error(function (err) {
      vm.updatingSaleEntries = false;
      vm.saleReport.saleEntries = [];
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.updateExpenseEntries = function () {
    if (!vm.saleReport.outlet) return;
    vm.updatingExpenseEntries = true;
    $http.get('/expense-entries/expense-entries-in-shift', {
      params: {
        outlet: ObjectId.getObjectId(vm.saleReport.outlet),
        shift: vm.saleReport.shift,
        date: vm.saleReport.date
      }
    }).success(function (expenseEntries) {
      vm.saleReport.expenseEntries = expenseEntries;
      vm.updatingExpenseEntries = false;
      vm.calculate();
    }).error(function (err) {
      vm.updatingSaleEntries = false;
      vm.saleReport.expenseEntries = [];
      FhdMessenger.errorFromServer(err);
    });
  };

  vm.calculate = function () {
    vm.saleReport.totalReceivable = _.get(vm.saleReport, 'totalDepositTypeCustomerRequest.vnpay', 0) + _.get(vm.saleReport, 'totalDepositTypeCustomerRequest.momo', 0) + _.get(vm.saleReport, 'totalDepositTypeCustomerRequest.airpay', 0);
    vm.saleReport.totalRevenue = 0;
    vm.saleReport.totalInAccount = _.get(vm.saleReport, 'totalDepositTypeCustomerRequest.card', 0) + _.get(vm.saleReport, 'totalDepositTypeCustomerRequest.transfer', 0);
    vm.saleReport.totalDepositInSE = 0;
    vm.saleReport.totalTransfer = 0;
    vm.saleReport.totalExpense = 0;
    vm.saleReport.totalRevenueByCashier = [];
    vm.saleReport.totalPrePay = 0;

    _.forEach(vm.saleReport.expenseEntries, function (expenseEntry) {
      vm.saleReport.totalExpense += expenseEntry.amount;
    });

    _.forEach(vm.saleReport.saleEntries, function (saleEntry) {
      if (saleEntry.paymentType === 'card') {
        vm.saleReport.totalInAccount += saleEntry.order.saleTotal - _.get(saleEntry, 'order.deposit', 0);
      }

      let totalTransfer = 0;

      if (saleEntry.paymentType === 'transfer') {
        totalTransfer += saleEntry.order.saleTotal - _.get(saleEntry, 'order.deposit', 0);
      }

      saleEntry.totalShipCash = getTotalShipCash(saleEntry);

      const cashierIndex = _.findIndex(vm.saleReport.totalRevenueByCashier, cashier => {
        return ObjectId.getObjectId(cashier) === ObjectId.getObjectId(saleEntry.cashier);
      });

      if (cashierIndex > -1) {
        vm.saleReport.totalRevenueByCashier[cashierIndex].totalRevenue += saleEntry.order.saleTotal;
        vm.saleReport.totalRevenueByCashier[cashierIndex].totalInAccount += saleEntry.paymentType === 'card' ? saleEntry.order.saleTotal - _.get(saleEntry, 'order.deposit', 0) : 0;
        vm.saleReport.totalRevenueByCashier[cashierIndex].totalTransfer += totalTransfer;
        vm.saleReport.totalRevenueByCashier[cashierIndex].totalShipCash += saleEntry.totalShipCash;
        vm.saleReport.totalRevenueByCashier[cashierIndex].totalReceivable += _.get(saleEntry, 'partnership.receivableAmount', 0);
        vm.saleReport.totalRevenueByCashier[cashierIndex].totalCommission += _.get(saleEntry, 'partnership.commissionAmount', 0);
      } else {
        vm.saleReport.totalRevenueByCashier.push({
          _id: ObjectId.getObjectId(saleEntry.cashier),
          cashierName: saleEntry.cashier.displayName,
          cashierCode: saleEntry.cashier.code,
          totalRevenue: saleEntry.order.saleTotal,
          totalReceivable: _.get(saleEntry, 'partnership.receivableAmount', 0),
          totalCommission: _.get(saleEntry, 'partnership.commissionAmount', 0),
          totalShipCash: _.get(saleEntry, 'totalShipCash', 0),
          totalInAccount: saleEntry.paymentType === 'card' ? saleEntry.order.saleTotal : 0,
          totalTransfer
        });
      }

      vm.saleReport.totalPrePay += _.get(saleEntry.order, 'deposit', 0);
      vm.saleReport.totalRevenue += saleEntry.order.saleTotal;
      vm.saleReport.totalTransfer += totalTransfer;
    });

    vm.saleReport.totalShipCash = _.sumBy(vm.saleReport.saleEntries, 'totalShipCash');
    vm.saleReport.totalReceivable = _.reduce(vm.saleReport.saleEntries, (result, saleEntry) => {
      return result + _.get(saleEntry, 'partnership.receivableAmount', 0);
    }, vm.saleReport.totalReceivable);
    vm.saleReport.totalDepositInSE = _.reduce(vm.saleReport.saleEntries, (result, saleEntry) => {
      return result + _.get(saleEntry, 'order.deposit', 0);
    }, 0);
    vm.saleReport.totalCommission = _.reduce(vm.saleReport.saleEntries, (result, saleEntry) => {
      return result + _.get(saleEntry, 'partnership.commissionAmount', 0);
    }, 0);

    _.forEach(vm.saleReport.totalRevenueByCashier, cashier => {
      cashier.totalCash = cashier.totalRevenue + cashier.totalShipCash - cashier.totalReceivable - cashier.totalCommission - cashier.totalInAccount - cashier.totalTransfer;
    });

    vm.saleReport.estimatedCash = vm.saleReport.totalRevenue - vm.saleReport.totalExpense + vm.saleReport.totalShipCash - vm.saleReport.totalReceivable - vm.saleReport.totalCommission;
    vm.saleReport.totalCash = vm.saleReport.estimatedCash - vm.saleReport.totalInAccount + vm.saleReport.totalDeposit - vm.saleReport.totalPrePay - vm.saleReport.totalTransfer;
    vm.saleReport.drawerCash = vm.saleReport.totalCash + vm.saleReport.initialPettyCash;
  };

  vm.totalCashChanged = function () {
    vm.saleReport.differentCash = vm.saleReport.totalCash - vm.saleReport.estimatedCash;
  };

  vm.staffSearchSelected = function (staff) {
    if (!staff) return;

    const checkDuplicate = _.find(vm.saleReport.staffs, {
      _id: staff._id
    });

    if (!checkDuplicate) {
      staff = _.find(vm.staffsInShiftEntry, s => s._id === staff._id) || staff;
      vm.saleReport.staffs.push(_.cloneDeep(staff));
    }

    vm.checkStaff();
    vm.staffSearch = null;
  };

  vm.findBuyingEntry = function (buyingEntryId) {
    if (!buyingEntryId) {
      return FhdMessenger.error('Chưa nhập mã Buying Entry để tìm');
    }

    BuyingEntryService.findByBuyingEntryId(buyingEntryId).then(buyingEntry => {
      vm.currentShift = CurrentShift.getCurrentShift();

      if (vm.currentShift && vm.currentShift.outlet && buyingEntry.destination.code !== vm.currentShift.outlet.code) {
        vm.buyingEntryId = null;
        return FhdMessenger.error('Buying này không thuộc về cơ sở của bạn. Vui lòng kiểm tra lại');
      } else {
        vm.expenseEntry.buyingEntries = vm.expenseEntry.buyingEntries || [];
        vm.expenseEntry.buyingEntries.push(buyingEntry);
        vm.buyingEntryId = null;
        vm.expenseEntry.description = `Nhập hàng Buying Entry ${_.reduce(vm.expenseEntry.buyingEntries, (result, buyingEntry) => {
          return `${result} ${buyingEntry.buyingEntryId}`;
        }, '')}`;
      }
    });
  };

  vm.removeBuyingEntry = index => {
    vm.expenseEntry.buyingEntries.splice(index, 1);
  };

  vm.checkStaff = _.noop;

  vm.createExpenseEntry = function (event) {
    event.preventDefault();
    vm.currentShift = CurrentShift.getCurrentShift();

    if (!vm.currentShift.outlet) {
      return FhdMessenger.error('Bạn chưa đăng nhập ca trực');
    }

    if (!vm.expenseEntry.description) {
      return FhdMessenger.error('Chưa có mô tả của khoản chi');
    }

    if (!vm.expenseEntry.category.expenseSubCategory || !vm.expenseEntry.category.expenseCategory) {
      return FhdMessenger.error('Chưa có phân loại khoản chi');
    }

    if (!vm.expenseEntry.amount) {
      return FhdMessenger.error('Chưa có tổng tiền của khoản chi');
    }

    if (_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/Điện sinh hoạt/)) {
      if (!_.get(vm.expenseEntry, 'images.length')) {
        return FhdMessenger.error('Khoản chi điện sinh hoạt bắt buộc có ảnh hóa đơn');
      }

      if (!_.get(vm.expenseEntry, 'electricalNumber')) {
        return FhdMessenger.error('Khoản chi điện sinh hoạt bắt buộc có số công tơ điện cuối kì');
      }
    }

    if (_.get(vm.expenseEntry, 'category.expenseCategory', '').match(/Nhận thêm tiền doanh thu/)) {
      if (vm.expenseEntry.amount > 0) {
        return FhdMessenger.error('Khoản chi nhận thêm doanh thu phải là số âm');
      }
    }

    if (!vm.adminStaff && _.get(vm.expenseEntry, 'category.expenseCategory', '') === 'Chênh lệch doanh thu' || _.get(vm.expenseEntry, 'category.expenseSubCategory.name', '') === 'Chi phí nhân sự' && Authentication.user.business.code === 'SAVOR') {
      if (!vm.expenseEntry.saleEntry) {
        return FhdMessenger.error('Chưa điền mã đơn hàng');
      }
    }

    if (!vm.adminStaff && vm.needImageExpenses.includes(_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '')) && !_.get(vm.expenseEntry.images, 'length', 0)) {
      return FhdMessenger.error('Khoản chi bắt buộc phải có ảnh');
    }

    if (_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/Trả lại khách đơn/)) {
      if (!vm.expenseEntry.saleEntry) {
        return FhdMessenger.error('Bạn cần nhập mã Sale Entry tại cửa hàng');
      }
    }

    if (_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/Mua đá cơ sở/)) {
      if (!_.get(vm.expenseEntry, 'vendor')) {
        return FhdMessenger.error('Khoản chi đá cơ sở cần có vendor');
      }

      if (!_.get(vm.expenseEntry, 'iceQuantity')) {
        return FhdMessenger.error('Khoản chi đá cơ sở cần có số lượng đá đã nhập');
      }
    }

    if (_.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/Nhập hàng/) && !_.get(vm.expenseEntry, 'buyingEntries.length')) {
      return FhdMessenger.error('Khoản chi nhập hàng cần có Buying Entry');
    }

    if (vm.expenseEntry.category.expenseCategory.match(/Cho vay/) && !vm.expenseEntry.borrowStaff) {
      return FhdMessenger.error('Khoản cho vay cần có nhân viên vay tiền');
    }

    vm.expenseEntry.outlet = vm.currentShift.outlet;

    if (!vm.forCreatedSaleReport) {
      vm.expenseEntry.shift = vm.currentShift.shift;
      vm.expenseEntry.date = vm.currentShift.date;
    } else {
      vm.expenseEntry.shift = vm.expenseEntry.shift.code;

      if (ExpenseEntryService.canCreateExpenseEntryForCreatedSaleReport(vm.expenseEntry)) {
        return FhdMessenger.error('Chỉ khoản vay hoặc Nhập hàng Buying mới được dùng doanh thu của ca khác để chi');
      }
    }

    if (!vm.expenseEntry.shift) {
      return FhdMessenger.error('Chưa có ca trực của khoản chi');
    }

    if (!vm.expenseEntry.date) {
      return FhdMessenger.error('Chưa có ngày của khoản chi');
    }

    vm.expenseEntry.date = moment(vm.expenseEntry.date).startOf('day').toDate();

    if (vm.expenseEntry.shift //  &&
    // _.get(vm.expenseEntry, 'outlet.code', '') === 'M1' &&
    // _.get(vm.expenseEntry, 'category.expenseSubCategory.name', '').match(/(Cho vay)/)
    ) {
        vm.expenseEntry.status = 'open';
      } else {
      vm.expenseEntry.status = 'closed';
    }

    if (vm.content) {
      vm.expenseEntry.notes.push({
        content: vm.content,
        user: vm.user
      });
    }

    vm.expenseEntry.forCreatedSaleReport = vm.forCreatedSaleReport;
    vm.expenseEntry.staffType = 'cashier';
    const expenseEntry = new ExpenseEntries(_.cloneDeep(vm.expenseEntry));
    vm.waiting = true;
    expenseEntry.$save().then(response => {
      vm.expenseEntry = {};
      FhdMessenger.success('Tạo khoản chi thành công');
      vm.updateExpenseEntries();
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
      vm.loadExpenseEntrySubCategory();
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.addExpenseEntryImage = newImage => {
    if (newImage) {
      vm.expenseEntry.images.push({
        data: newImage
      });
    }
  };

  vm.removeExpenseEntryImage = index => {
    vm.expenseEntry.images.splice(index, 1);
  };

  vm.removeExpense = (expenseEntry, index) => {
    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc muốn xóa khoản chi ${expenseEntry.description}?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      ExpenseEntryService.hideExpenseEntry(expenseEntry).then(response => {
        vm.updateExpenseEntries();
      }).catch(error => {
        FhdMessenger.errorFromServer(error);
      });
    });
  };

  vm.removeStaff = function (index) {
    vm.saleReport.staffs.splice(index, 1);
  }; //  Create new Sale report


  vm.create = function () {
    if (vm.saleReport.totalCash < 0 && _.get(vm.saleReport, 'expenseEntries.length')) {
      return FhdMessenger.error('Các bạn check lại khoản chi và số tiền trong két.');
    }

    if (vm.offlineModeData.offlineMode) {
      return FhdMessenger.error('Không tạo được Sale Report trong chế độ Offline');
    }

    if (_.some(vm.saleReport.saleEntries, {
      hiddenRequest: true
    })) {
      FhdMessenger.error('Có Sale Entry chưa ấn đồng ý hay không đồng ý ẩn');
      return;
    }

    if (vm.saleReport.drawerCash && vm.saleReport.outlet.format !== 'online') {
      vm.calculateBankNote();

      if (!vm.saleReport.bankNoteReal) {
        if (_.some(vm.saleReport.typeBankNote, bankNote => {
          return !_.isNumber(bankNote.amount);
        })) {
          return FhdMessenger.error('Chưa nhập đủ các mệnh giá tiền. Các mệnh giá tiền không có vui lòng điền 0');
        }
      }
    }

    if (_.get(vm.saleReport, 'outlet.code', '').match(/[MES]\d+/) && _.get(vm.saleReport, 'outlet.numCooler') && _.some(vm.saleReport.coolerTemperatures, coolerTemperature => {
      return !coolerTemperature.temperature;
    })) {
      return FhdMessenger.error('Bạn chưa điền nhiệt độ tủ mát cơ sở');
    } // if (['M1', 'M2'].includes(vm.saleReport.outlet.code) && _.isNumber(vm.saleReport.numDoneViettelOrder)) {
    //   return FhdMessenger.error(`Cơ sở M1, M2 phải điển số đơn Viettel done trong ca.`)
    // }
    // Create new Sale report object


    const saleReport = new SaleReports(_.cloneDeep(vm.saleReport));
    const date = new Date(saleReport.date);
    const dateString = moment(date).format('YYYY-MM-DD');
    saleReport.saleReportId = `${saleReport.outlet.code}_${dateString}_${saleReport.shift}`;
    saleReport.employees = _.map(saleReport.staffs, function (staff) {
      const positions = _.reduce(vm.positions, function (positions, position) {
        if (staff[position.code]) positions.push(position.code);
        return positions;
      }, []);

      return {
        staff: ObjectId.getObjectId(staff),
        staffName: staff.displayName,
        code: staff.code,
        cellphone: staff.cellphone,
        isManager: staff.isManager,
        positions
      };
    });
    saleReport.staffs = _.map(saleReport.staffs, '_id');
    saleReport.saleEntries = _.map(saleReport.saleEntries, '_id'); // Redirect after save

    vm.waiting = true;
    return saleReport.$save().then(response => {
      CurrentShift.resetCurrentShift();
      $location.path(`sale-reports/${response._id}`); // Clear form fields

      vm.name = '';
    }).catch(error => {
      return FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Remove existing Sale report


  vm.remove = function () {
    vm.saleReport.deleteNote = $window.prompt('Nhập lý do xóa');

    if (!vm.saleReport.deleteNote) {
      return FhdMessenger.error('Chưa có lý do xóa Sale Report');
    }

    vm.saleReport.$requestRemove(function () {
      $location.path('sale-reports');
    });
  };

  function getEmployees(staffs) {
    return _.map(staffs, function (staff) {
      const positions = _.reduce(vm.positions, function (positions, position) {
        if (staff[position.code]) positions.push(position.code);
        return positions;
      }, []);

      return {
        staff: ObjectId.getObjectId(staff),
        staffName: staff.displayName,
        cellphone: staff.cellphone,
        positions
      };
    });
  } // Update existing Sale report


  vm.update = function () {
    vm.saleReport.employees = getEmployees(vm.saleReport.staffs);
    const saleReport = vm.saleReport;
    vm.waiting = true;
    saleReport.$update().then(function () {
      $location.path(`sale-reports/${saleReport._id}`);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  }; // Open sale entry


  vm.openSaleEntry = SaleEntryService.viewSaleEntry;
  vm.saleReportsTable = new NgTableParams({
    count: 200
  }); // Find a list of Sale reports

  vm.find = function () {
    const businesses = _.reduce(vm.businessMap, (result, value, business) => {
      if (value) result.push(business);
      return result;
    }, []);

    vm.saleReports = SaleReports.query({
      businesses,
      startDate: vm.data.startDate,
      endDate: vm.data.endDate,
      outlet: ObjectId.getObjectId(vm.outlet),
      shift: _.get(vm.shift, 'code', undefined),
      findRequestTransferLate: vm.findRequestTransferLate
    }, function () {
      vm.totalDiscount = 0;
      vm.totalCash = 0;
      vm.totalDeposit = 0;
      vm.totalRevenue = 0;
      vm.totalExpense = 0;
      vm.totalShipCash = 0;
      vm.totalInAccount = 0;
      vm.totalTransfer = 0;
      vm.totalCommission = 0;
      vm.totalReceivable = 0;
      vm.totalPrePay = 0;
      vm.total = {};

      _.forEach(vm.saleReports, function (saleReport) {
        saleReport.late = !!saleReport.approvedTransferLate;
        vm.totalCash += saleReport.totalCash;
        vm.totalRevenue += saleReport.totalRevenue;
        vm.totalDeposit += saleReport.totalDeposit || 0;
        vm.totalExpense += saleReport.totalExpense;
        vm.totalShipCash += saleReport.totalShipCash || 0;
        vm.totalInAccount += saleReport.totalInAccount || 0;
        vm.totalTransfer += saleReport.totalTransfer || 0;
        vm.totalCommission += saleReport.totalCommission || 0;
        vm.totalReceivable += saleReport.totalReceivable || 0;
        vm.totalPrePay += saleReport.totalPrePay || 0;
        saleReport.totalDiscount = 0;
        saleReport.theDate = moment(saleReport.date).format('YYYY-MM-DD');

        _.forEach(saleReport.saleEntries, function (saleEntry) {
          saleReport.totalDiscount += saleEntry.order.discount;
        });

        vm.totalDiscount += saleReport.totalDiscount;
      });

      vm.saleReportsTable.settings({
        dataset: vm.saleReports
      });
    }, function (err) {
      FhdMessenger.error(err);
    });
    FhdMessenger.notifyLoading('Đang tải...', vm.saleReports.$promise, () => {
      FhdMessenger.success('Tải xong!');
    });
  };

  vm.getLateSaleReport = () => [{
    title: 'True',
    id: true
  }, {
    title: 'Fasle',
    id: false
  }]; // Find existing Sale report


  vm.findOne = function () {
    vm.saleReport = SaleReports.get({
      saleReportId: $stateParams.saleReportId
    });
    vm.saleReport.$promise.then(saleReport => {
      vm.saleReport.customerRequests = getCustomerRequestsWithDeposits(saleReport.customerRequest);
      vm.positions = ShiftPositions.getPostions(vm.saleReport.outlet);
      vm.positions = vm.positions.concat(ShiftPositions.PROBATION_POSITIONS);

      _.forEach(saleReport.employees, employee => {
        const matchStaff = _.find(saleReport.staffs, {
          _id: ObjectId.getObjectId(employee.staff)
        });

        _.forEach(employee.positions, position => {
          matchStaff[position] = true;
        });
      });
    });
  }; // Date stuff //


  vm.open = function ($event) {
    $event.preventDefault();
    $event.stopPropagation();
    vm.opened = true;
  };

  vm.dateOptions = {
    formatYear: 'yy',
    startingDay: 1
  };
  vm.minDate = new Date();
  vm.minDate.setDate(vm.minDate.getDate() - 6);

  vm.changeDate = function () {
    vm.find();
  };

  vm.calculateBankNote = function () {
    vm.saleReport.bankNoteReal = _.sumBy(vm.saleReport.typeBankNote, bankNote => {
      return bankNote.amount * bankNote.typeOfMoney;
    });
  };

  vm.removeSaleReportDay = function (index) {
    vm.saleReportDays.splice(index, 1);
  };

  vm.addSaleReportDay = function () {
    vm.saleReportDays = vm.saleReportDays || [];

    const dayIndex = _.findIndex(vm.saleReportDays, day => {
      return moment(vm.date).startOf('day').diff(moment(day.date).startOf('day')) === 0;
    });

    if (dayIndex > -1) {
      return FhdMessenger.error('Đã có ngày này trong danh sách');
    }

    vm.saleReportDays.push({
      date: moment(vm.date).startOf('day'),
      shiftMap: _.cloneDeep(vm.shiftMap)
    });
  };

  vm.requestTransferLate = function () {
    if (!vm.saleReportDays.length) {
      return FhdMessenger.error('Chưa chọn ngày chuyển doanh thu');
    }

    _.forEach(vm.saleReportDays, day => {
      day.shifts = _.reduce(vm.data.shifts, (result, shift) => {
        if (day.shiftMap[shift._id]) {
          result.push(shift._id);
        }

        return result;
      }, []);
    });

    if (vm.saleReportDays.length && _.some(vm.saleReportDays, day => {
      return !day.shifts.length;
    })) {
      return FhdMessenger.error('Có ngày chưa chọn các ca chuyển doanh thu');
    }

    if (!vm.outlet) {
      return FhdMessenger.error('Có ngày chưa chọn các ca chuyển doanh thu');
    }

    if (!vm.reason) {
      return FhdMessenger.error('Có lý do chuyển muộn doanh thu');
    }

    if (vm.reason === 'Cây CDM bị lỗi/đầy tiền' && !vm.images.length) {
      return FhdMessenger.error('Lỗi CDM phải có hình ảnh');
    }

    if (vm.reason === 'Khác' && !vm.note) {
      return FhdMessenger.error('Nhập chi tiết lý do');
    }

    vm.note = vm.note || '';
    vm.images = vm.images || [];
    vm.waiting = true;
    SaleReportService.requestTransferLate({
      outletId: vm.outlet._id,
      reason: vm.reason,
      saleReportDays: vm.saleReportDays,
      note: vm.note,
      images: vm.images
    }).then(response => {
      FhdMessenger.success('Gửi yêu cầu thành công');
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('sale-reports').controller('TableKPIController', ['$http', 'Authentication', 'NgTableParams', 'FhdMessenger', '$location', '$window', '$timeout', function ($http, Authentication, NgTableParams, FhdMessenger, $location, $window, $timeout) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.data = {};
  vm.tableKPI = new NgTableParams({
    count: 50
  });
  vm.waiting = false;

  vm.submit = function () {
    vm.tableKPI.settings({
      dataset: []
    });
    vm.waiting = true;
    let promise = $http.get('/sale-reports/get-KPI-by-day', {
      params: {
        startDate: vm.startDate || moment().toDate(),
        endDate: vm.endDate || moment().toDate()
      }
    }).then(({
      data
    }) => {
      vm.kpiByOutlets = data;
      vm.tableKPI.settings({
        dataset: vm.kpiByOutlets
      });
    }).catch(err => {
      return FhdMessenger.error(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong!');
    });
  };

  vm.copyTableKPI = () => {
    const dataTableKPI = vm.tableKPI.data;
    const header = ['STT', 'Cơ sở', 'KPI'].join('\t');
    const outletsKPI = dataTableKPI.map((outlet, index) => [index + 1, outlet.code, Math.round(outlet.averageRevenue)].join('\t'));
    vm.data.copyTableKPI = header + '\n' + outletsKPI.join('\n');
    const copyText = $window.document.getElementById('dataCopiedTableKPI');
    $timeout(() => {
      copyText.select();
      $window.document.execCommand('copy');
      FhdMessenger.success('Đã copy');
    }, 1000);
  };

  vm.init = function () {
    if (!vm.user.roles.includes('admin') && !vm.user.roles.includes('tro-ly-lich-truc')) {
      return $location.path('home');
    }

    vm.submit();
  };

  vm.exportFile = function () {
    const outletsKPI = _.map(vm.kpiByOutlets, outlet => ({
      'Cơ sở': outlet.code,
      KPI: Math.floor(outlet.averageRevenue).toLocaleString(),
      'Từ ngày': moment(vm.startDate).format('YYYY-MM-DD'),
      'Đến ngày': moment(vm.endDate).format('YYYY-MM-DD')
    }));

    const now = moment().startOf('day').format('YYYY-MM-DD');
    alasql(`SELECT * INTO XLSX("outlets-kpi-${now}.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [outletsKPI]);
  };

  vm.onChange = () => {
    vm.tableKPI.settings({
      dataset: []
    });
  };
}]);
'use strict';

angular.module('sale-reports').filter('expenseCategories', [function () {
  return function (input) {
    switch (input) {
      case 'directBuying':
        return 'Nhập hàng';

      case 'lend':
        return 'Cho vay';

      case 'other':
        return 'Khác';

      default:
        return input;
    }
  };
}]);
'use strict';

angular.module('sale-reports').filter('searchCustomerType', [function () {
  return function (input) {
    switch (input) {
      case 'cellphone':
        return 'SĐT';

      case 'card':
        return 'Thẻ';

      case 'app':
        return 'App';

      default:
        return input;
    }
  };
}]);
'use strict';

angular.module('sale-reports').factory('SaleReportService', ['$http', 'ConfirmModal', 'FhdMessenger', '$state', '$modal', 'ProductWeight', function ($http, ConfirmModal, FhdMessenger, $state, $modal, ProductWeight) {
  return {
    requestTransferLate(data) {
      return $http.post('/sale-reports/request-transfer-late', data).then(response => response.data);
    }

  };
}]);
'use strict'; // Sale reports service used to communicate Sale reports REST endpoints

angular.module('sale-reports').factory('SaleReports', ['$resource', function ($resource) {
  return $resource('sale-reports/:saleReportId', {
    saleReportId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    requestRemove: {
      method: 'PUT',
      url: '/sale-reports/:saleReportId/request-remove'
    }
  });
}]);
'use strict'; // Setting up route

angular.module('savor-restocks').config(['$stateProvider', function ($stateProvider) {
  // Sale reports state routing
  $stateProvider.state('savorRestocks', {
    url: '/savor-restocks',
    templateUrl: 'modules/savor-restocks/views/savor-restocks.client.view.html',
    resolve: {
      $title: _.constant('Savor Restocks')
    }
  }).state('importSavorRestocks', {
    url: '/savor-restocks/import',
    templateUrl: 'modules/savor-restocks/views/import-savor-restocks.client.view.html',
    resolve: {
      $title: _.constant('Import Savor Restocks')
    }
  });
}]);
"use strict";

angular.module('savor-restocks').controller('SavorRestocksController', ['$window', '$http', '$location', '$timeout', '$state', 'Authentication', 'FhdMessenger', 'JsPrintService', 'NgTableParams', 'ObjectId', 'OutletService', 'ProductService', 'PlTasks', 'StockEntries', 'SavorRestocks', 'NumberService', 'StockMap', '$q', function ($window, $http, $location, $timeout, $state, Authentication, FhdMessenger, JsPrintService, NgTableParams, ObjectId, OutletService, ProductService, PlTasks, StockEntries, SavorRestocks, NumberService, StockMap, $q) {
  const vm = this;
  vm.date = moment().format('YYYY-MM-DD');
  vm.user = Authentication.user;
  vm.products = [];
  vm.shifts = [{
    code: 'S_1',
    name: 'Sáng 7h'
  }, {
    code: 'S_2',
    name: 'Sáng 11h'
  }, {
    code: 'C',
    name: 'Chiều'
  }, {
    code: 'C_2',
    name: 'Adhoc'
  }, {
    code: 'T',
    name: 'Tối'
  }];

  vm.getShiftName = function (shift) {
    return _.get(_.find(vm.shifts, {
      code: shift
    }), 'name');
  };

  ProductService.getAllProductsFromServer().then(products => {
    vm.products = products;
  });
  vm.types = ['Món mặn', 'Món ngọt'];
  vm.type = _.head(vm.types);
  StockMap.getStockMapCache().then(stockMap => {
    vm.B1StockMap = _.reduce(stockMap, (result, productStock) => {
      result[productStock.sku] = productStock.B1;
      return result;
    }, {});
  });
  PlTasks.getSavorProcessing().$promise.then(items => {
    vm.processingMap = _.reduce(items, (result, item) => {
      result[item._id] = item.processing;
      return result;
    }, {});
  });
  vm.showReceived = false;
  vm.savorRestockTable = new NgTableParams({
    count: 1000
  });

  function fixedNumber(number) {
    return NumberService.numberWithCommas(Number(number).toFixed(0));
  }

  const getSku = ($scope, row) => `<span> ${row.sku} </span>`;

  const getDescription = ($scope, row) => `<span> ${row.description} </span>`;

  const getType = ($scope, row) => `<span> ${row.type} </span>`;

  defineTableCols();

  async function defineTableCols() {
    const {
      SAVOR_OUTLET_CODES
    } = await OutletService.getOutletCodes();
    vm.cols = [{
      field: 'sku',
      title: 'Sku',
      show: true,
      sortable: 'sku',
      filter: {
        sku: 'text'
      },
      getValue: getSku
    }, {
      field: 'description',
      title: 'Description',
      sortable: 'description',
      show: true,
      filter: {
        description: 'text'
      },
      getValue: getDescription
    }, {
      field: 'type',
      title: 'Type',
      sortable: 'type',
      show: true,
      filter: {
        type: 'text'
      },
      getValue: getType
    }];

    const outletsCols = _.map(SAVOR_OUTLET_CODES, code => {
      return {
        field: code,
        title: code,
        show: true,
        getValue: getInfoRestock
      };
    });

    vm.cols.push(...outletsCols);
    vm.cols.push({
      field: 'processing',
      title: 'Processing',
      show: true,
      sortable: 'processing',
      getValue: getProcessing
    });
    vm.cols.push({
      field: 'totalRestock',
      title: 'Total Restock',
      show: true,
      sortable: 'totalRestock',
      getValue: getTotalRestock
    });
    vm.cols.push({
      field: 'stockB1',
      title: 'Stock B1',
      show: true,
      sortable: 'stockB1',
      getValue: getStockB1
    });
    vm.renderCreateRestock = _.map(SAVOR_OUTLET_CODES, code => {
      return `<a ng-click="vm.createStockEntry('${code}')">${code}</a>`;
    });
    vm.renderPrintColumn = _.map(SAVOR_OUTLET_CODES, code => {
      return `<a ng-click="vm.printColumn('${code}')">${code}</a>`;
    });

    function getTotalRestock($scope, row) {
      let totalRestock = 0;

      _.forEach(SAVOR_OUTLET_CODES, outletCode => {
        totalRestock += _.get(row, outletCode, 0);
      });

      row.totalRestock = totalRestock;
      return `<strong>${fixedNumber(totalRestock)}</strong>`;
    }

    function getStockB1($scope, row) {
      const productStock = _.get(vm.B1StockMap, row.sku, 0);

      row.stockB1 = productStock;
      return `<strong>${fixedNumber(productStock)}</strong>`;
    }

    function getProcessing($scope, row) {
      const processing = _.get(vm.processingMap, row.sku, 0);

      row.processing = processing;
      return `<strong>${fixedNumber(processing)}</strong>`;
    }
  }

  function getInfoRestock($scope, row) {
    // eslint-disable-next-line
    const outletCode = this.field;

    const value = _.get(row, outletCode, 0);

    const RValue = _.get(row, `R_${outletCode}`, 0);

    const stockValue = _.get(row, `stock_${outletCode}`, 0);

    const saleValue = _.get(row, `sale_${outletCode}`, 0);

    const adjustedRestock = _.get(row, `adjustedRestock_${outletCode}`, 0);

    const transferedValue = _.get(row, `transfer_${outletCode}`, 0);

    return `<span ng-class="{
        'has-restock': ${value > 0},
      }">
        <small ng-show="!row.R_${outletCode}">(<span ng-if="vm.showReceived">${fixedNumber(transferedValue)}/</span>${fixedNumber(value)})</small>  
        <small ng-show="row.R_${outletCode} && vm.showReceived">(<span ng-if="vm.showReceived">${fixedNumber(transferedValue)}/</span>${fixedNumber(value)}</del>)</small>
        <a ng-click="vm.inputQuantity(row, '${outletCode}')" ng-show="!row.R_${outletCode}">N</a>
        <a ng-click="vm.inputQuantity(row, '${outletCode}')" ng-show="row.R_${outletCode}"
          >${fixedNumber(RValue)}</a
        >
        <br ng-if="vm.showStock" />
        <p ng-if="vm.showStock">${fixedNumber(stockValue)}</p>
        <br ng-if="vm.showSale" />
        <p ng-if="vm.showSale">${fixedNumber(saleValue)}</p>
        <br ng-if="vm.showAjustedRestock" />
        <p ng-if="vm.showAjustedRestock">${fixedNumber(adjustedRestock)}</p>
      </span>
      `;
  }

  vm.find = function () {
    vm.waiting = true;
    vm.savorRestockTable.settings({
      dataset: []
    });
    $q.all([SavorRestocks.query({
      warehouseRestock: '5ac8fedea4ba632eecca65e8',
      startDate: vm.date,
      endDate: vm.date,
      shift: vm.shift,
      type: _.get(vm, 'type', 'Món mặn'),
      limit: 1500
    }).$promise, SavorRestocks.getTransferQuantity({
      startDate: vm.date,
      endDate: vm.date,
      shift: vm.shift
    }).$promise]).then(([savorRestocks, transferItems]) => {
      const savorRestockGroupByProductMap = {};

      _.forEach(savorRestocks, savorRestock => {
        savorRestockGroupByProductMap[savorRestock.sku] = savorRestockGroupByProductMap[savorRestock.sku] || {
          product: savorRestock.product,
          sku: savorRestock.sku,
          description: savorRestock.description,
          type: savorRestock.type
        };

        if (savorRestock.outletCode.match(/[SK]\d+/)) {
          savorRestockGroupByProductMap[savorRestock.sku][savorRestock.outletCode] = savorRestock.restock;
          savorRestockGroupByProductMap[savorRestock.sku][`C_${savorRestock.outletCode}`] = undefined;
          savorRestockGroupByProductMap[savorRestock.sku][`stock_${savorRestock.outletCode}`] = savorRestock.stock;
          savorRestockGroupByProductMap[savorRestock.sku][`sale_${savorRestock.outletCode}`] = savorRestock.spd;
          savorRestockGroupByProductMap[savorRestock.sku][`adjustedRestock_${savorRestock.outletCode}`] = savorRestock.adjustedRestock;
        }
      });

      _.forEach(transferItems, stockEntry => {
        const sku = stockEntry._id.sku;
        const destination = stockEntry._id.destinationCode;
        const quantity = stockEntry.quantity;

        if (savorRestockGroupByProductMap[sku]) {
          savorRestockGroupByProductMap[sku][`transfer_${destination}`] = quantity;
        }
      });

      const savorRestockGroupByProducts = _.sortBy(_.map(savorRestockGroupByProductMap), ['type', 'description']);

      vm.savorRestockGroupByProducts = savorRestockGroupByProducts;
      vm.savorRestockTable.settings({
        dataset: savorRestockGroupByProducts
      });
      FhdMessenger.success('Đã tải xong');
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.print = function (savorRestockTable) {
    vm.savorRestockTable = savorRestockTable;
    $timeout(() => {
      JsPrintService.printElementById('print-savor-restocks', true);
    }, 100);
  };

  vm.inputQuantity = function (savorRestock, outletCode) {
    savorRestock[`R_${outletCode}`] = $window.prompt('Nhập số lượng');
  };

  vm.printColumn = outletCode => {
    vm.printColumnData = {};
    vm.printColumnData.printTime = moment().format('YYYY-MM-DD HH:mm');
    vm.printColumnData.outletCode = outletCode;
    const data = vm.savorRestockTable.data;

    const products = _.reduce(data, (result, product) => {
      const restock = _.get(product, outletCode, 0);

      if (restock) {
        result.push({
          sku: product.sku,
          description: product.description,
          value: restock
        });
      }

      return result;
    }, []);

    vm.printColumnData.products = products;
    $timeout(() => {
      JsPrintService.printElementById('print-column-savor-restocks', true);
    }, 100);
  };

  vm.createStockEntry = async function (outletCode) {
    const data = vm.savorRestockTable.data;
    vm.items = _.reduce(data, (result, product) => {
      if ([0, '0'].includes(_.get(product, `R_${outletCode}`))) {
        return result;
      }

      if (_.isUndefined(_.get(product, `R_${outletCode}`)) && !_.get(product, outletCode)) {
        return result;
      }

      const matchProduct = _.find(vm.products, {
        sku: product.sku
      });

      result.push({
        product: product.product || _.get(matchProduct, '_id'),
        sku: product.sku || _.get(matchProduct, 'sku'),
        description: product.description || _.get(matchProduct, 'description'),
        quantity: _.get(product, `R_${outletCode}`, _.get(product, outletCode))
      });
      return result;
    }, []);

    if (!vm.items.length) {
      return FhdMessenger.error(`Bạn chưa nhập số lượng cho sản phẩm nào trong restock ${outletCode}`);
    }

    if (_.some(vm.items, item => {
      return !item.product;
    })) {
      return FhdMessenger.error(`Có sản phẩm không tìm thấy thông tin tương ứng`);
    }

    vm.outlet = ObjectId.getObjectId('5ac8fedea4ba632eecca65e8');
    await OutletService.findOutletFromCode(outletCode).then(outlet => {
      vm.destination = outlet._id;
    });

    const SKUs = _.map(vm.items, 'sku');

    let stockEntries = [];
    await StockEntries.query({
      outlet: vm.outlet,
      destination: vm.destination,
      type: 'restock',
      created: moment().subtract(1, 'h').toDate(),
      SKUs
    }).$promise.then(data => {
      stockEntries = data;
    });

    if (stockEntries.length) {
      const confirm = $window.confirm('Có sản phẩm trong danh sách này đã được tạo Logistic Entry trong vòng 1 tiếng trước, bạn có chắc chắn vẫn muốn tạo Logistic Entry!!!');
      if (!confirm) return;
    }

    const stockEntry = new StockEntries({
      outlet: vm.outlet,
      destination: vm.destination,
      staff: vm.user,
      user: vm.user,
      items: vm.items,
      currentStaff: vm.user,
      currentStatus: 'delivered',
      history: [{
        status: 'delivered',
        time: new Date(),
        staff: vm.user,
        outlet: vm.outlet
      }],
      date: moment().startOf('day').toDate()
    });
    stockEntry.$save().then(response => {
      vm.items = [];
      FhdMessenger.success('Tạo Logistic Entry');
      $window.open(`${$location.protocol()}://${$location.host()}${$location.port() !== 80 ? `:${$location.port()}` : ''}/#!/stock-entries/${response._id}`, '_blank');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  function checkHasNotNumberProp(array, prop) {
    if (_.some(array, object => {
      const value = _.get(object, prop);

      return !_.isNumber(value) || _.isNaN(value);
    })) {
      return true;
    }

    return false;
  }

  function checkHasNotProp(array, prop) {
    if (_.some(array, object => {
      return !_.get(object, prop);
    })) {
      return true;
    }

    return false;
  }

  vm.canPrintRestock = function () {
    return moment(vm.date).isSame(moment(), 'date');
  };

  vm.import = function () {
    if (checkHasNotProp(vm.savorRestocks, 'sku')) {
      return FhdMessenger.error('Có Savor Restock chưa có mã sản phẩm');
    }

    if (checkHasNotProp(vm.savorRestocks, 'description')) {
      return FhdMessenger.error('Có Savor Restock chưa có tên sản phẩm');
    }

    if (checkHasNotProp(vm.savorRestocks, 'warehouseRestock')) {
      return FhdMessenger.error('Có Savor Restock chưa có cơ sở chuyển hàng');
    }

    if (checkHasNotProp(vm.savorRestocks, 'outletCode')) {
      return FhdMessenger.error('Có Savor Restock chưa có cơ sở nhận hàng');
    }

    if (checkHasNotNumberProp(vm.savorRestocks, 'stock')) {
      return FhdMessenger.error('Có Savor Restock chưa có số tồn cơ sở');
    }

    if (checkHasNotNumberProp(vm.savorRestocks, 'spd')) {
      return FhdMessenger.error('Có Savor Restock chưa có SPD');
    }

    if (checkHasNotNumberProp(vm.savorRestocks, 'restock')) {
      return FhdMessenger.error('Có Savor Restock chưa có số Restock');
    }

    if (checkHasNotNumberProp(vm.savorRestocks, 'shift')) {
      return FhdMessenger.error('Có Savor Restock chưa có ca trực');
    }

    let created = moment().toDate();
    const hour = moment().hour();

    if (hour >= 17) {
      created = moment().add(10, 'hours').toDate();
    }

    _.forEach(vm.savorRestocks, savorRestock => {
      savorRestock.created = created;
    });

    vm.waiting = true;
    SavorRestocks.import({
      savorRestocks: vm.savorRestocks
    }).$promise.then(() => {
      FhdMessenger.success(`Import ${vm.savorRestocks.length} Savor Restocks thành công`);
      $state.go('savorRestocks');
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
'use strict';

angular.module('savor-restocks').factory('SavorRestocks', ['$resource', function ($resource) {
  return $resource('savor-restocks/:savorRestockId', {
    savorRestockId: '@_id'
  }, {
    update: {
      method: 'PUT'
    },
    import: {
      method: 'POST',
      url: 'savor-restocks/import',
      isArray: true
    },
    getTransferQuantity: {
      method: 'GET',
      url: '/savor-restocks/transfered-items',
      isArray: true
    }
  });
}]);
'use strict';

angular.module('search-function-website').factory('SearchFunctionWebsiteModal', ['$modal', 'Authentication', function ($modal, Authentication) {
  return {
    view: () => {
      const user = Authentication.user;

      if (!_.includes(user.roles, 'admin')) {
        return;
      }

      return $modal.open({
        animation: true,
        templateUrl: '/modules/search-function-website/templates/search-function-website-modal.client.template.html',
        controller: 'SearchFunctionWebsiteController',
        controllerAs: 'vm',
        backdrop: 'static',
        windowClass: 'modal-search-function-website-modal',
        size: 'lg'
      });
    }
  };
}]).controller('SearchFunctionWebsiteController', ['Authentication', '$state', '$modalInstance', '$http', '$timeout', function (Authentication, $state, $modalInstance, $http, $timeout) {
  const vm = this;
  vm.user = Authentication.user;
  $timeout(() => {
    angular.element('#search-function-input').focus();
  }, 200);
  $http.get('../../../states.json').success(function (data) {
    const filteredData = _.filter(data, d => {
      if (_.get(d, 'roles')) {
        if (_.intersection(d.roles, vm.user.roles).length === 0) {
          return false;
        }
      }

      return true;
    });

    vm.functions = filteredData;
  });

  vm.selectLink = item => {
    $state.go(item.state);
    $modalInstance.close();
  };
}]);
"use strict";

angular.module('savor-tags').factory('SavorTagService', ['$http', function ($http) {
  let savorTagPromise = null;
  return {
    getSavorTags() {
      if (!savorTagPromise) {
        savorTagPromise = $http.get('/savor-tags').then(response => {
          const tags = response.data;
          return _.map(tags.sort((a, b) => {
            return a.name.localeCompare(b.name);
          }), tag => ({
            id: tag.name,
            title: tag.name
          }));
        });
      }

      return savorTagPromise;
    }

  };
}]);
"use strict";

