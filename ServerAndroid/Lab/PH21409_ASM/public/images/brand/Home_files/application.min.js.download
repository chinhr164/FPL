    resolve: {
      $title: _.constant('Upload User photo')
    }
  }).state('list-user-photos', {
    url: '/user-photos',
    templateUrl: 'modules/user-photos/views/list-user-photos.client.view.html',
    resolve: {
      $title: _.constant('List User Photo')
    }
  }).state('view-user-photo', {
    url: '/user-photos/:userPhotoId',
    templateUrl: 'modules/user-photos/views/view-user-photo.client.view.html',
    resolve: {
      $title: _.constant('View User Photo')
    }
  });
}]);
'use strict';

angular.module('user-photos').controller('ListUserPhotosController', ['$scope', 'Authentication', 'UserPhotos', 'UserPhotoService', 'ConfirmModal', 'FhdMessenger', function ($scope, Authentication, UserPhotos, UserPhotoService, ConfirmModal, FhdMessenger) {
  const vm = this;
  vm.user = Authentication.user;
  vm.userPhotos = [];
  vm.selectedImages = [];
  vm.isSelectedAll = false;
  vm.userPhotos = UserPhotos.query({
    sort: '-created'
  });

  vm.onClickImage = function (userPhoto) {
    const imageIndex = vm.selectedImages.findIndex(imageId => imageId === userPhoto._id);

    if (imageIndex !== -1) {
      vm.selectedImages.splice(imageIndex, 1);
    } else {
      vm.selectedImages.push(userPhoto._id);
    }
  };

  $scope.$watch(() => vm.isSelectedAll, (newValue, oldValue) => {
    if (newValue === oldValue) return;

    if (newValue) {
      vm.selectedImages = vm.userPhotos.map(userPhoto => {
        return userPhoto._id;
      });
    } else {
      vm.selectedImages = [];
    }
  });

  vm.removeImage = function () {
    if (vm.selectedImages.length <= 0) return FhdMessenger.error('Số lượng ảnh không hợp lệ !');
    ConfirmModal.showModal({}, {
      bodyText: `Bạn có chắc muốn xóa ${vm.selectedImages.length} tấm ảnh này không ?`
    }).then(() => {
      vm.waiting = true;
      UserPhotoService.removeMany(vm.selectedImages).then(data => {
        vm.userPhotos = vm.userPhotos.filter(userPhoto => !vm.selectedImages.includes(userPhoto._id));
        vm.selectedImages = [];
        FhdMessenger.success('Đã xóa ảnh thành công!');
        vm.waiting = false;
      }).catch(err => {
        FhdMessenger.error(err.data.message);
        vm.waiting = false;
      });
    });
  };
}]);
'use strict';

angular.module('user-photos').controller('ModalChooseUserPhotosController', ['UserPhotos', '$modalInstance', function (UserPhotos, $modalInstance) {
  const vm = this;
  vm.userPhotos = [];
  vm.userPhotosSelect = [];
  vm.userPhotos = UserPhotos.query();

  vm.confirm = () => $modalInstance.close(vm.userPhotosSelect);

  vm.close = () => $modalInstance.dismiss();

  vm.choosePhoto = userPhoto => {
    const photoIndex = vm.userPhotosSelect.findIndex(photo => photo._id === userPhoto._id);

    if (photoIndex === -1) {
      vm.userPhotosSelect.push(userPhoto);
    } else {
      vm.userPhotosSelect.splice(photoIndex, 1);
    }
  };
}]);
'use strict';

angular.module('user-photos').controller('UploadUserPhotosController', ['Authentication', 'UserPhotos', 'FhdMessenger', '$location', '$http', function (Authentication, UserPhotos, FhdMessenger, $location, $http) {
  const vm = this;
  vm.user = Authentication.user;
  vm.userPhoto = {};
  vm.userPhoto.images = [];
  vm.userPhoto.user = vm.user.username;

  vm.uploadImage = () => {
    if (vm.userPhoto.images.length > 10) {
      return FhdMessenger.error('Bạn đã đạt giới hạn 10 ảnh mỗi lần tải lên, vui lòng xóa bớt ảnh và đăng vào lần sau');
    }

    vm.uploading = true;
    $http.post('/user-photos', {
      images: vm.userPhoto.images
    }).then(() => {
      FhdMessenger.success('Upload thành công');
      $location.path('/user-photos');
    }).catch(error => {
      vm.uploading = false;
      FhdMessenger.errorFromServer(error);
    });
  };
}]);
'use strict';

