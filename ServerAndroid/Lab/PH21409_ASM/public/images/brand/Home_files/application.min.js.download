/* eslint-disable angular/controller-as */
angular.module('training').controller('TrainingController', ['$http', '$stateParams', '$location', 'Authentication', '$localStorage', 'ConfirmModal', 'toaster', 'CurrentShift', '$window', function ($http, $stateParams, $location, Authentication, $localStorage, ConfirmModal, toaster, CurrentShift, $window) {
  const vm = this;
  vm.user = Authentication.user;

  vm.loadQuizzes = function () {
    const {
      outlet
    } = CurrentShift.getCurrentShift();
    $http.get('/my-quizzes', {
      params: {
        outlet: outlet && outlet._id ? outlet._id : outlet
      }
    }).success(function (quizzes) {
      vm.quizzes = _.map(quizzes, function (quiz) {
        var papers = _(quiz.papers).filter({
          staff: vm.user._id
        });

        quiz.highestPercentage = Math.max(_.map(papers, 'percentage'));
        quiz.myAttempt = papers.value().length;
        quiz.papers = papers.value();
        if (papers.some({
          isPass: true
        })) quiz.status = 'pass';
        if (!papers.some({
          isPass: true
        }) && quiz.myAttempt) quiz.status = 'fail';
        var now = new Date();
        var deadline = new Date(quiz.deadline);
        if (deadline > now && quiz.myAttempt < 3) quiz.canDo = true;
        return quiz;
      });
    }).error(function (errorResponse) {
      toaster.error(errorResponse.message);
    });
  };

  vm.doOne = function () {
    ConfirmModal.showModal({}, {
      bodyText: `
          Lưu ý:
  - Khi đã bắt đầu làm mà bạn thoát ra hệ thống vẫn sẽ đếm ngược thời gian. Hết thời gian bạn không thể làm tiếp và bị tính là trượt.
  - Nếu hệ thống không báo lỗi nhưng bạn không thấy hiện danh sách câu hỏi, vui lòng load lại trang này.

          Bạn có muốn bắt đầu?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Không đồng ý'
    }).then(() => {
      $http.get('/quizzes/' + $stateParams.quizId + '/do').success(function (response) {
        vm.paper = response.paper;

        _.forEach(vm.paper.questions, question => {
          question.sortTable = question.question.sortTable;
          question.fillBlank = question.question.fillBlank;
          const questionType = question.question.questionType;

          switch (questionType) {
            case 'SORT':
              question.sortQuestion = _.shuffle(question.question.sortQuestion);
              break;

            case 'JOINTABLE':
              question.sortTable.groupB = _.shuffle(question.question.sortTable.groupB);
              break;
          }

          question.answers = [];

          if (_.get(question, 'question.answers.length')) {
            if (!_.some(question.question.answers, answer => {
              return answer.content && answer.content.match(/^([A-E]|[1-9])\./);
            })) {
              question.question.answers = _.shuffle(question.question.answers);
            }
          } // ESSAY


          if (question.question.questionType === 'ESSAY') {
            question.essayAnswer = $localStorage.get(`answerByUser${question._id}`);
          } // MULTIPLE
          else if (question.question.questionType === 'MULTIPLE') {
              question.answers = $localStorage.get(`answerByUser${question._id}`);
            } // FILLBLANK
            else if (question.question.questionType === 'FILLBLANK') {
                if (question.question.answer) {
                  question.fillBlankAnswer = Number($localStorage.get(`answerByUser${question._id}`));
                } else {
                  _.forEach(question.fillBlank, answer => {
                    answer.userAnswer = Number($localStorage.get(`answerByUser${answer._id}`));
                  });
                }
              } // JOINTABLE
              else if (question.question.questionType === 'JOINTABLE') {
                  _.forEach(question.sortTable.groupB, answer => {
                    answer.userAnswer = parseInt($localStorage.get(`answerByUser${answer._id}`));
                  });
                } // SORT
                else if (question.question.questionType === 'SORT') {
                    _.forEach(question.sortQuestion, answer => {
                      answer.userAnswer = parseInt($localStorage.get(`answerByUser${answer._id}`));
                    });
                  }
        });

        if (response.timeLeft) {
          vm.timeLeft = moment.duration(response.timeLeft).asSeconds();

          if (vm.timeLeft <= 0) {
            vm.outOfTime();
          }
        } else {
          vm.timeLeft = null;
        }
      }).error(function (errorResponse) {
        toaster.error(errorResponse.message);
        $location.path('/training');
      });
    });
  };

  vm.outOfTime = function () {
    toaster.info('Bạn đã hết giờ');
    vm.submitPaper();
  };

  vm.onChangeAnswers = function (answer, questionId) {
    $localStorage.set(`answerByUser${questionId}`, answer);
  }; // Submit Paper


  vm.submitPaper = function () {
    const {
      outlet,
      shift,
      date
    } = CurrentShift.getCurrentShift();
    vm.waiting = true;
    $http.put('/quizzes/' + $stateParams.quizId + '/do', {
      outlet,
      shift,
      date,
      questions: vm.paper.questions
    }).success(function (response) {
      for (const key in $window.localStorage) {
        if (key.startsWith('answerByUser')) {
          $window.localStorage.removeItem(key);
        }
      }

      $location.path('/papers/' + response._id);
    }).error(function (errorResponse) {
      toaster.error('errorResponse', errorResponse.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

