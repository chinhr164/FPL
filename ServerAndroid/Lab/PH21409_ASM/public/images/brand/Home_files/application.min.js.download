});
"use strict";

angular.module('angel-diary').config(['$stateProvider', function ($stateProvider) {
  $stateProvider.state('listAngelDiary', {
    url: '/angel-diary',
    templateUrl: 'modules/angel-diary/views/list-angel-diary.client.view.html',
    resolve: {
      $title: _.constant('List Angel Diary')
    }
  }).state('createAngelDiary', {
    url: '/angel-diary/create',
    templateUrl: 'modules/angel-diary/views/create-angel-diary.client.view.html',
    resolve: {
      $title: _.constant('Create Angel Diary')
    }
  }).state('pendingApprovalAngelDiary', {
    url: '/angel-diary/pendingApproval',
    templateUrl: 'modules/angel-diary/views/pending-approval-angel-diary.client.view.html',
    resolve: {
      $title: _.constant('Pending Approval Angel Diary')
    }
  });
}]);
'use strict';

angular.module('angel-diary').controller('AngelDiaryController', ['$state', 'Authentication', 'AngelDiary', 'FhdMessenger', 'UserService', '$http', function ($state, Authentication, AngelDiary, FhdMessenger, UserService, $http) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.firstName = _.last(vm.user.displayName.split(' '));
  vm.emojis = ['like', 'heart', 'haha', 'sad', 'angry'];
  vm.waiting = false;
  vm.comments = {};

  vm.create = function () {
    var angelDiary = new AngelDiary(vm.angelDiary);
    angelDiary.$save(function (response) {
      $state.go('listAngelDiary');
      vm.angelDiary = {};
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  };

  vm.addComment = angelDiary => {
    vm.angelDiary = angelDiary;
    vm.waiting = true;
    vm.angelDiary.$comment({
      comment: vm.comment[angelDiary._id]
    }).then(response => {
      FhdMessenger.success(`Ok`);
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.comment = {};
      vm.waiting = false;
      vm.find();
    });
  };

  vm.emotion = _.debounce((angelDiary, type) => {
    vm.angelDiary = angelDiary;
    vm.angelDiary.$emotion({
      type: type
    }).then(response => {
      FhdMessenger.success(`Ok`);
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => vm.find());
  }, 200);

  vm.find = function () {
    AngelDiary.query().$promise.then(data => {
      vm.angelDiaries = _.map(data, angelDiary => {
        const countDefault = {
          like: 0,
          haha: 0,
          sad: 0,
          heart: 0,
          angry: 0
        };

        const countByEmoji = _.countBy(angelDiary.emotions, emotion => emotion.type);

        angelDiary.count = _.assign(countDefault, countByEmoji);
        return angelDiary;
      });
    });
  };
}]);
'use strict';

angular.module('angel-diary').controller('PendingApprovalEngelDiaryController', ['$state', 'Authentication', 'AngelDiary', 'FhdMessenger', function ($state, Authentication, AngelDiary, FhdMessenger) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;

  vm.find = function () {
    AngelDiary.query({
      status: 'pending'
    }).$promise.then(pendingAngelDiaries => {
      vm.pendingAngelDiaries = pendingAngelDiaries;
    });
  };

  vm.approve = angelDiary => {
    vm.isDisableBtn = true;
    angelDiary.$approve().then(response => {
      _.remove(vm.pendingAngelDiaries, angelDiary);

      vm.isDisableBtn = false;
      FhdMessenger.success(`Đã duyệt !`);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      vm.isDisableBtn = false;
    });
  };

  vm.disapprove = angelDiary => {
    vm.isDisableBtn = true;
    angelDiary.$disapprove().then(response => {
      _.remove(vm.pendingAngelDiaries, angelDiary);

      vm.isDisableBtn = false;
      FhdMessenger.success(`Đã loại !`);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
      vm.isDisableBtn = false;
    });
  };
}]);
'use strict'; // Articles service used for communicating with the articles REST endpoints

angular.module('angel-diary').factory('AngelDiary', ['$resource', function ($resource) {
  return $resource('angel-diary/:angelDiaryId', {
    angelDiaryId: '@_id'
  }, {
    comment: {
      method: 'PUT',
      url: 'angel-diary/:angelDiaryId/comment'
    },
    emotion: {
      method: 'PUT',
      url: 'angel-diary/:angelDiaryId/emotion'
    },
    approve: {
      method: 'PUT',
      url: 'angel-diary/:angelDiaryId/approve'
    },
    disapprove: {
      method: 'PUT',
      url: 'angel-diary/:angelDiaryId/disapprove'
    }
  });
}]);
"use strict";

