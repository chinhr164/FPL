/* eslint-disable angular/controller-as */
angular.module('products').controller('ModalQuickEditProductAttributesController', ['$scope', 'Products', 'product', 'FhdMessenger', '$modalInstance', 'WooProductCategoryService', 'WooProductTags', 'ProductService', 'Authentication', function ($scope, Products, product, FhdMessenger, $modalInstance, WooProductCategoryService, WooProductTags, ProductService, Authentication) {
  const vm = this;
  vm.user = Authentication.user;
  vm.removeTagsDescription = '';
  vm.attributes = ProductService.getProductAttributes();

  vm.findOne = function () {
    vm.product = Products.get({
      productId: product._id
    }, function () {
      vm.product.wooProperties = vm.product.wooProperties || {};
      vm.product.wooProperties.categories = _.map(vm.product.wooProperties.categories, WooProductCategoryService.getCategoryWithDescription);
      vm.product.wooProperties.images = vm.product.wooProperties.images || [{
        src: ''
      }];

      if (!vm.product.wooProperties.images.length) {
        vm.product.wooProperties.images = [{
          src: ''
        }];
      }

      if (_.every(vm.product.wooProperties.images, 'src')) {
        vm.product.wooProperties.images.push({
          src: ''
        });
      }

      vm.product.attributes = vm.product.attributes || {};
      $scope.$watch(() => vm.product.wooProperties.description, (newValue, oldValue) => {
        if (!newValue || newValue === oldValue) return;

        if (vm.product.wooProperties.description) {
          vm.removeTagsDescription = vm.product.wooProperties.description.replace(/<\/?\w+((\s+\w+(\s*=\s*(?:".*?"|'.*?'|[\^'">\s]+))?)+\s*|\s*)\/?>/gi, ' ').replace(/((&nbsp|&amp|amp|lt|gt);|br)/gi, ' ').replace(/\s{2,}/gi, ' ');
        }
      });
    });
  };

  WooProductCategoryService.withoutChildrenAsync().then(function (categories) {
    vm.wooProductCategories = _.map(categories, WooProductCategoryService.getCategoryWithDescription);
  });
  vm.wooProductTags = WooProductTags.query();

  function isSrcBlank(image) {
    return !image.src;
  }

  vm.imagesChanged = function () {
    vm.product.wooProperties = vm.product.wooProperties || {};
    vm.product.wooProperties.images = vm.product.wooProperties.images || [];

    const numberOfBlankImages = _.filter(vm.product.wooProperties.images, isSrcBlank).length;

    if (numberOfBlankImages >= 2) {
      const matchIndex = _.findIndex(vm.product.wooProperties.images, isSrcBlank);

      vm.product.wooProperties.images.splice(matchIndex, 1);
    }

    if (numberOfBlankImages < 1) {
      vm.product.wooProperties.images.push({
        src: ''
      });
    }
  };

  vm.update = function (updateWeb) {
    if (vm.removeTagsDescription.length - 2 > 5000) {
      return FhdMessenger.error('Chỉ được nhập dưới 5000 kí tự');
    }

    if (_.get(vm.product, 'wooProperties.images.length') && !_.get(vm.product, 'wooProperties.categories.length')) {
      return FhdMessenger.error('Bạn chưa chọn Web Categories cho sản phẩm');
    }

    if (_.get(vm.product, 'wooProperties.images.length')) {
      vm.product.wooProperties.images = _.reject(vm.product.wooProperties.images, image => !image.src);

      _.forEach(vm.product.wooProperties.images, image => {
        if (!image.title) image.title = `${vm.product.sku} ${vm.product.description}`;
        if (!image.alt) image.alt = vm.product.description;
      });
    }

    vm.waiting = true;
    vm.product.$update({
      updateWeb
    }).then(function () {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close(vm.product);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.requestWorkTask = (product, request) => {
    vm.waiting = true;
    ProductService.requestWorkTask(product, request).then(response => {
      FhdMessenger.success('Đã gửi yêu cầu');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  }; // upload images


  vm.addImage = newImage => {
    vm.rawImages = vm.rawImages || [];

    if (newImage) {
      vm.rawImages.push({
        data: newImage
      });
    }

    if (vm.product.srcImg && vm.product.srcImg.match(/(https?:\/\/.*\.(?:png|jpg))/i)) {
      vm.rawImages.push({
        inputLink: vm.product.srcImg
      });
    }
  };

  vm.removeImage = index => {
    vm.rawImages.splice(index, 1);
  };

  vm.updateImages = () => {
    const product = vm.product;
    product.rawImages = vm.rawImages;
    vm.waiting = true;
    product.$uploadLinkImages().then(() => {
      FhdMessenger.success('Cập nhật ảnh thành công!');
      vm.rawImages = [];
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

/* eslint-disable angular/controller-as */
angular.module('products').controller('ModalQuickEditProductController', ['$scope', 'helper', 'Products', 'product', 'Authentication', '$modalInstance', 'SavorTagService', 'BusinessService', 'ProductService', 'FhdMessenger', 'ProductCatService', 'ProductDepartmentService', 'ProductSubCatsService', 'ProductStringTagsService', '$http', '$q', 'OutletService', 'ReviewRanksService', 'WarehouseGroupService', 'ValentineCategoriesService', 'VendorService', 'MooncakeCategoriesService', 'TetCategoriesService', 'SellingProfiles', 'BuyingProfiles', '$filter', '$sce', 'ObjectId', 'openTab', 'InventoryLocations', 'ProductGroupsService', function ($scope, helper, Products, product, Authentication, $modalInstance, SavorTagService, BusinessService, ProductService, FhdMessenger, ProductCatService, ProductDepartmentService, ProductSubCatsService, ProductStringTagsService, $http, $q, OutletService, ReviewRanksService, WarehouseGroupService, ValentineCategoriesService, VendorService, MooncakeCategoriesService, TetCategoriesService, SellingProfiles, BuyingProfiles, $filter, $sce, ObjectId, openTab, InventoryLocations, ProductGroupsService) {
  const vm = this;
  const user = Authentication.user;
  vm.user = user;
  vm.removeValueFromArray = helper.removeValueFromArray;

  const isSomeOne = _.curry(function (role, user) {
    return _.includes(user.roles, role);
  });

  vm.isSavor = () => {
    return _.get(vm.product, 'business.code', '').includes('SAVOR');
  };

  vm.canUpdateProductionTime = regionAttribute => {
    return vm.user.roles.includes(`product:update-${_.toLower(_.get(regionAttribute, 'region', 'all'))}-production-time`);
  };

  const isAdmin = isSomeOne('admin');
  const isAdminMerchandise = isSomeOne('admin-merchandise');
  const isPurchasing = isSomeOne('purchaser');
  const isEditProduct = isSomeOne('product:edit');
  vm.allOutletRegion = [{
    code: 'NORTH',
    name: 'Miền Bắc'
  }, {
    code: 'CENTRAL',
    name: 'Miền Trung'
  }, {
    code: 'SOUTH',
    name: 'Miền Nam'
  }]; // set default tab active

  if (openTab) {
    vm[openTab] = true;
  } // Determine if user can see anything at all


  vm.canView = false;

  if (isAdmin(user) || isAdminMerchandise(user) || isPurchasing(user) || isEditProduct(user)) {
    vm.canView = true;
  } else {
    $modalInstance.close('cancel'); // $state.go('home')
  }

  vm.createRawProductModal = function () {
    ProductService.createProductModal().result.then(product => {
      vm.product.rawProducts.push({
        sku: product.sku,
        description: product.description,
        product: product._id
      });
    });
  }; // Determine if user can change cogs


  vm.canChangeCogs = false;

  if (isAdmin(user) || isPurchasing(user) || isEditProduct(user)) {
    vm.canChangeCogs = true;
  } // Determine if user can change salary percentage


  vm.canChangeSalary = false;

  if (isAdmin(user) || isAdminMerchandise(user) || isPurchasing(user) || isEditProduct(user)) {
    vm.canChangeSalary = true;
  } // Determine if user can change sale price


  vm.canChangeSalePrice = false;

  if (isAdmin(user) || isEditProduct(user)) {
    vm.canChangeSalePrice = true;
  } // Determine if user can change sale price


  vm.canChangePrice = false;

  if (isAdmin(user) || isAdminMerchandise(user) || isPurchasing(user) || isEditProduct(user)) {
    vm.canChangePrice = true;
  } // Determine if user can delete product


  vm.canDelete = false;

  if (isAdmin(user) || isAdminMerchandise(user)) {
    vm.canDelete = true;
  } // Determine if user can change properties of product


  vm.canChangeProperties = false;

  if (isAdmin(user) || isAdminMerchandise(user) || isPurchasing(user) || isEditProduct(user)) {
    vm.canChangeProperties = true;
  }

  vm.data = {};
  vm.business = null;
  BusinessService.allAsync().then(businesses => {
    vm.data.businesses = businesses;
  });
  vm.data.vendors = VendorService.getVendors();
  vm.data.reviewRanks = ReviewRanksService.getReviewRanks();
  vm.data.warehouseGroups = WarehouseGroupService.getWarehouseGroups();
  vm.data.tetCategories = TetCategoriesService.getTetCategories();
  vm.data.orderPlatform = {};
  vm.data.inventoryLocations = InventoryLocations.query();
  SavorTagService.getSavorTags().then(savorTags => {
    vm.data.savorTags = savorTags;
  });
  ProductStringTagsService.getProductStringTags().then(tags => {
    vm.data.productStringTags = tags;
  });
  vm.openModalEditRegionAttribute = ProductService.openModalEditRegionAttribute;
  vm.openModalComboElement = ProductService.openModalComboElement;
  vm.data.addonProducts = [];
  vm.data.variantTypes = ProductService.getVariantTypes();

  vm.addComboElement = function () {
    vm.product.comboElements = vm.product.comboElements || [];
    vm.product.comboElements.push({
      name: 'Chưa rõ'
    });
  };

  vm.findOne = () => {
    // Load current product
    vm.product = Products.get({
      productId: product._id || product
    }, function () {
      vm.product.updatedBusiness = vm.product.business ? vm.product.business._id || vm.product.business : null;

      if (vm.product.tags && vm.product.tags.length) {
        vm.product.joinedTags = vm.product.tags.join(', ');
      }

      _.forEach(vm.product.outletAttributes, (outlet, idex) => {
        outlet.minDSExpiryDate = outlet.minDSExpiryDate ? new Date(outlet.minDSExpiryDate) : null;
      }); // Category stuff


      vm.product.category = vm.product.category || {};
      $q.all([ProductGroupsService.getProductGroups(), ProductDepartmentService.getProductDepartments(), ProductCatService.getProductCats()]).then(([groups, departments, cats]) => {
        vm.catOptions = _.map(groups, group => {
          return _.assign(group, {
            type: 'group',
            productGroup: group._id,
            description: `[Group] ${group.name}`
          });
        }).concat(_.map(departments, department => {
          return _.assign(department, {
            type: 'cat',
            productDepartment: department._id,
            description: `[Deparment] ${department.productGroup.name} -> ${department.name}`
          });
        })).concat(_.map(cats, cat => {
          return _.assign(cat, {
            type: 'cat',
            productCat: cat._id,
            description: `[Cat] ${cat.productGroup.name} -> ${cat.productDepartment.name} -> ${cat.name}`
          });
        }));

        if (_.get(vm.product, 'category.cat')) {
          vm.product.catOption = _.find(vm.catOptions, {
            _id: ObjectId.getObjectId(vm.product.category.cat)
          });
        } else if (_.get(vm.product, 'category.department')) {
          vm.product.catOption = _.find(vm.catOptions, {
            _id: ObjectId.getObjectId(vm.product.category.department)
          });
        } else if (_.get(vm.product, 'category.group')) {
          vm.product.catOption = _.find(vm.catOptions, {
            _id: ObjectId.getObjectId(vm.product.category.group)
          });
        }
      });
      vm.product.rawProductCogs = _.reduce(vm.product.rawProducts || [], (result, rawProduct) => {
        return result + _.get(rawProduct, 'product.cogs', 0) * rawProduct.quantity;
      }, 0);
    }); // Outlet stuff

    $q.all([vm.product.$promise, vm.data.outletsPromise.$promise]).then(function () {
      vm.product.outletAttributes = vm.product.outletAttributes || [];

      _.forEach(_.get(vm.product, 'directBuyingOutlets'), directOutlet => {
        const matchOutlet = _.find(vm.data.outlets, outlet => outlet._id === directOutlet);

        if (matchOutlet) matchOutlet.value = true;
      });

      const notFoundOutlets = _.reject(vm.data.outlets, function (outlet) {
        return _.some(vm.product.outletAttributes, function (outletAttribute) {
          return outlet._id === outletAttribute.outlet;
        });
      });

      _.forEach(notFoundOutlets, function (outlet) {
        vm.product.outletAttributes.push({
          outlet: outlet._id,
          outletCode: outlet.code,
          minStock: 0,
          displayStock: 0,
          shelfLocations: []
        });
      });

      _.forEach(vm.product.outletAttributes, outletAttribute => {
        const matchOutlet = _.get(vm.data.outletMap, ObjectId.getObjectId(outletAttribute.outlet));

        outletAttribute.region = _.get(matchOutlet, 'region', 'N/A');
        outletAttribute.format = _.get(matchOutlet, 'format', 'N/A');
        outletAttribute.formatPriority = OutletService.getFormatPriority(outletAttribute.format);

        if (matchOutlet) {
          const outletCode = outletAttribute.outletCode;
          outletAttribute.toShow = vm.product.sku.match(/^([BZWT]|LB)\d+/) && outletCode.match(/^[ME]\d+/) || vm.product.sku.match(/^[VXZ]\d+/) && (outletCode.match(/^[SKB]\d+/) || _.get(matchOutlet, 'sellBirthdayCake'));
        }

        outletAttribute.displayStock = outletAttribute.displayStock || 0;
      });

      vm.product.outletAttributes = _.sortBy(sortByAlphabet(vm.product.outletAttributes, 'outletCode'), 'formatPriority');
    });
    return vm.product;
  };

  function sortByAlphabet(array = [], property) {
    return array.sort((a, b) => {
      return _.get(a, property, '').localeCompare(_.get(b, property, ''), undefined, {
        numeric: true,
        sensitivity: 'base'
      });
    });
  }

  ProductService.allAsync().then(products => {
    vm.data.products = products;
    vm.data.productMap = _.reduce(products, (result, product) => {
      result[product._id] = _.pick(product, ['_id', 'sku', 'cogs', 'computedCogs']);
      return result;
    }, {});
    vm.data.addonProducts = _.filter(products, product => {
      return product.sku.match(/^V/) && product.isModifier;
    });
  });
  $scope.$watch(() => {
    return {
      productMap: vm.data.productMap,
      bundledProducts: vm.product.bundledProducts,
      defaultModifierCogs: vm.product.defaultModifierCogs,
      price: vm.product.price,
      salePrice: vm.product.salePrice
    };
  }, () => {
    if (vm.data.productMap && vm.product) {
      _.forEach(vm.product.bundledProducts, bundledProduct => {
        bundledProduct.unitCogs = _.get(vm.data.productMap, `${bundledProduct.product}.cogs`, _.get(vm.data.productMap, `${bundledProduct.product}.computedCogs`, 0)) > 0 ? _.get(vm.data.productMap, `${bundledProduct.product}.cogs`, _.get(vm.data.productMap, `${bundledProduct.product}.computedCogs`, 0)) : _.get(vm.data.productMap, `${bundledProduct.product}.computedCogs`, 0);
        bundledProduct.totalCogs = bundledProduct.unitCogs * bundledProduct.quantity;
      });

      vm.product.bundledProductCogs = _.reduce(vm.product.bundledProducts, (result, product) => {
        return result + product.totalCogs || 0;
      }, 0);
      vm.product.defaultModifierCogs = _.reduce(vm.product.defaultModifiers, (result, defaultModifier) => {
        let quantity = 1;

        if (vm.product.description && vm.product.description.match(/Bánh mì.*(to)|\(L\)/)) {
          quantity = defaultModifier.normalQuantity;
        }

        if (vm.product.description && vm.product.description.match(/Bánh mì.*(nhỏ)|\(M\)/)) {
          quantity = defaultModifier.miniQuantity;
        }

        defaultModifier.quantity = quantity;

        const cogs = _.reduce(defaultModifier.bundledProducts, (result, bundledProduct) => {
          const cogs = _.get(vm.data.productMap, `${bundledProduct.product}.cogs`, 0);

          bundledProduct.cogs = cogs;
          bundledProduct.totalCogs = cogs * bundledProduct.quantity;
          return result + bundledProduct.totalCogs;
        }, 0);

        defaultModifier.cogs = cogs || defaultModifier.cogs;
        defaultModifier.totalCogs = defaultModifier.cogs * quantity;
        return result + defaultModifier.totalCogs;
      }, 0);
      vm.product.computedCogs = vm.product.bundledProductCogs + vm.product.defaultModifierCogs;
      vm.product.profitPercentage = Math.round((1 - vm.product.computedCogs / vm.product.price) * 10000) / 100;
    }
  }, true);
  BuyingProfiles.query().then(buyingProfiles => {
    vm.data.buyingProfiles = buyingProfiles;
  });
  vm.data.partner = ['SAVOR_SHOP', 'NOW', 'GRAB_FOOD', 'BE_FOOD', 'GO_FOOD', 'BAEMIN'];
  vm.data.outletsPromise = OutletService.allAsync().then(function (outlets) {
    vm.data.outlets = _.filter(outlets, outlet => {
      return !outlet.deleted && outlet.isPos && outlet.isStorage || outlet.code.match(/[BD]\d/);
    });
    vm.data.outletMap = helper.makeMap(outlets, '_id');
  });

  vm.setVendorForRegion = (vendorForRegion, product, regionCode) => {
    const outletsToEdit = _.filter(product.outletAttributes, outlet => {
      return outlet.toShow && outlet.region === regionCode;
    });

    _.forEach(outletsToEdit, outlet => {
      return outlet.vendor = vendorForRegion;
    });
  };

  vm.editRestockByRegion = (fieldToEdit, region, data) => {
    if (['displayStock', 'minimumStock', 'maxDisplayStock'].includes(fieldToEdit) && !_.isNumber(data)) {
      return;
    }

    const outletsToEdit = _.filter(vm.product.outletAttributes, outlet => {
      return outlet.toShow && outlet.region === region;
    });

    const checkStopSell = _.every(outletsToEdit, outlet => {
      return outlet.stopSell;
    });

    const checkDirect = _.every(outletsToEdit, outlet => {
      return outlet.isDirect;
    });

    _.forEach(outletsToEdit, outlet => {
      switch (fieldToEdit) {
        case 'displayStock':
          outlet.displayStock = data;
          outlet.displayStockEditTime = new Date();

          if (data <= 0) {
            outlet.stopSell = true;
          }

          break;

        case 'minimumStock':
          outlet.minimumStock = data;
          outlet.minimumStockEditTime = new Date();
          break;

        case 'maxDisplayStock':
          outlet.maxDisplayStock = data;
          break;

        case 'minDSExpiryDate':
          outlet.minDSExpiryDate = data;
          break;

        case 'stopSell':
          outlet.stopSell = !checkStopSell;
          break;

        case 'isDirect':
          outlet.isDirect = !checkDirect;
          break;
      }
    });
  };

  vm.updateOutletAttributeBySellingAttribute = (sellingAttribute, prop) => {
    const value = _.get(sellingAttribute, prop);

    const outletsToEdit = _.filter(vm.product.outletAttributes, outlet => {
      const matchOutlet = vm.data.outletMap[ObjectId.getObjectId(outlet.outlet)];
      return outlet.toShow && matchOutlet.format === sellingAttribute.sellingProfile;
    });

    _.forEach(outletsToEdit, outlet => {
      switch (prop) {
        case 'displayStock':
          outlet.displayStock = value;
          outlet.displayStockEditTime = new Date();

          if (value <= 0) {
            outlet.stopSell = true;
          }

          break;

        case 'minimumStock':
          outlet.minimumStock = value;
          outlet.minimumStockEditTime = new Date();
          break;

        case 'toSell':
          outlet.stopSell = !value;
          break;

        case 'isDirect':
          outlet.isDirect = value;
          break;
      }
    });
  };

  vm.checkDelayBuying = function (product) {
    let {
      delayBuying
    } = product;

    if (!delayBuying) {
      product.expectedBuyingDate = null;
      product.notBuying = false;
    } else {
      product.notBuying = true;
    }
  };

  vm.checkNotBuying = function (product) {
    let {
      notBuying
    } = product;

    if (!notBuying) {
      product.expectedBuyingDate = null;
      product.delayBuying = false;

      if (_.get(product, 'tetCategory.isMooncake')) {
        const displayStock = 1;
        const minimumStock = 0;
        changeAllOutletAttributeProperty('displayStock')(displayStock);
        changeAllOutletAttributeProperty('minimumStock')(minimumStock);
      }
    } else {
      product.markNotBuyingTime = moment().toDate();
    }
  };

  vm.update = function (updateWeb) {
    const validator = ProductService.validate(vm.product);
    let errors = validator.checkDelayBuying();
    errors = validator.checkBundlePrice(errors); // if (vm.product.privateLabel) {
    //   errors = validator.checkRawProducts(errors)
    // }

    if (!_.isEmpty(errors)) {
      const errorsMessage = errors.join('</br>');
      return FhdMessenger.error(errorsMessage, true);
    } // const errorRawProduct = ProductService.validateRawProduct(vm.product)
    // if (errorRawProduct) {
    //   return FhdMessenger.error(errorRawProduct)
    // }


    if (!_.isNumber(vm.product.salePrice)) {
      vm.product.salePrice = null;
    }

    vm.product.business = vm.product.updatedBusiness;

    if (_.get(vm.product, 'catOption._id')) {
      vm.product.category = {
        group: ObjectId.getObjectId(_.get(vm.product, 'catOption.productGroup')),
        department: ObjectId.getObjectId(_.get(vm.product, 'catOption.productDepartment')),
        cat: ObjectId.getObjectId(_.get(vm.product, 'catOption.productCat'))
      };
    }

    vm.product.directBuyingOutlets = _.map(_.filter(vm.data.outlets, outlet => outlet.value), '_id');
    vm.waiting = true;
    vm.product.$update({
      updateWeb
    }, function (product) {
      FhdMessenger.success('Cập nhật thành công');
      $modalInstance.close(product);
    }, function (error) {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateStock = function () {
    vm.waiting = true;
    $http.post('/web-products/update-stock', {
      productIds: [product._id]
    }).then(() => FhdMessenger.success('Ok!')).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };

  vm.changeBusiness = function (business) {
    vm.product.business = business;
    vm.product.updatedBusiness = business;
  };

  vm.calculateBundledProductQuantity = function ($index) {
    if (!_.get(vm, 'product.bundledProducts.length')) {
      return;
    }

    vm.product.bundledProducts[$index].quantity = _.get(vm.product.bundledProducts[$index], 'formulaQuantity', 0) * (_.get(vm.product.bundledProducts[$index], 'wastageRate', 0) / 100 + 1);
  }; // Insert in tab Pl


  vm.insertWrapper = wrapper => {
    vm.product.wrappers = vm.product.wrappers || [];
    vm.product.wrappers.push({
      product: wrapper._id,
      sku: wrapper.sku,
      description: wrapper.description,
      quantity: 1
    });
  };

  vm.insertLabel = label => {
    vm.product.labels = vm.product.labels || [];
    vm.product.labels.push({
      product: label._id,
      sku: label.sku,
      description: label.description,
      quantity: 1
    });
  };

  vm.insertTool = tool => {
    vm.product.tools = vm.product.tools || [];
    vm.product.tools.push({
      product: tool._id,
      sku: tool.sku,
      description: tool.description,
      quantity: 1
    });
  };

  vm.vendorProductSelected = vendorProduct => {
    vm.product.vendorProducts = vm.product.vendorProducts || [];

    const vendorProductMatchIndex = _.findIndex(vm.product.vendorProducts, {
      sku: vendorProduct.sku
    });

    if (vendorProductMatchIndex === -1) {
      vm.product.vendorProducts.push({
        product: vendorProduct._id,
        sku: vendorProduct.sku,
        description: vendorProduct.description,
        quantity: 1
      });
    } else {
      return FhdMessenger.error('Sản phẩm đã có trong danh sách');
    }
  };

  vm.tranferTogetherProductSelected = tranferTogetherProduct => {
    vm.product.tranferTogetherProducts = vm.product.tranferTogetherProduct || [];

    const tranferTogetherProductMatchIndex = _.findIndex(vm.product.tranferTogetherProducts, {
      sku: tranferTogetherProduct.sku
    });

    if (tranferTogetherProductMatchIndex === -1) {
      vm.product.tranferTogetherProducts.push({
        product: tranferTogetherProduct._id,
        sku: tranferTogetherProduct.sku,
        description: tranferTogetherProduct.description,
        quantity: 1
      });
    } else {
      return FhdMessenger.error('Sản phẩm đã có trong danh sách');
    }
  };

  vm.insertRawProduct = rawProduct => {
    vm.product.rawProducts = vm.product.rawProducts || [];
    vm.product.rawProducts.push({
      product: rawProduct._id,
      sku: rawProduct.sku,
      description: rawProduct.description,
      quantity: 1
    });
  };

  vm.insertConvertProduct = rawProduct => {
    vm.product.convertProducts = vm.product.convertProducts || [];
    vm.product.convertProducts.push({
      product: rawProduct._id,
      sku: rawProduct.sku,
      description: rawProduct.description,
      quantity: 1
    });
  }; // End insert in tab Pl


  vm.removeLabel = (object, index) => {
    if (!_.isArray(object.labels)) return;
    object.labels.splice(index, 1);
  };

  vm.removeTool = index => {
    if (!_.isArray(vm.product.tools)) return;
    vm.product.tools.splice(index, 1);
  }; // End remove in tab Pl


  vm.insertBundledProduct = bundledProduct => {
    vm.product.bundledProducts = vm.product.bundledProducts || [];
    vm.product.bundledProducts.push({
      product: bundledProduct._id,
      sku: bundledProduct.sku,
      description: bundledProduct.description,
      quantity: 1,
      required: true
    });
  };

  vm.data.variantDraft = null;

  vm.insertVariantToDraft = product => {
    vm.data.variantDraft = {
      group: {
        size: 'default'
      }
    };
    vm.data.variantDraft.product = product._id;
    vm.data.variantDraft.sku = product.sku;
    vm.data.variantDraft.price = product.price;
    vm.data.variantDraft.salePrice = product.salePrice;
  };

  vm.insertVariantToProduct = () => {
    if (!vm.data.variantDraft.description) return FhdMessenger.error('Description is required !');
    vm.product.variants.push({
      product: {
        _id: vm.data.variantDraft.product,
        price: vm.data.variantDraft.price,
        salePrice: vm.data.variantDraft.salePrice
      },
      sku: vm.data.variantDraft.sku,
      description: vm.data.variantDraft.description
    });
    vm.data.variantDraft = null;
  };

  vm.insertOrderPlatformToProduct = () => {
    if (!vm.data.orderPlatform.code) return FhdMessenger.error('Code is required !'); // if (!vm.data.orderPlatform.normalPrice)
    //   return FhdMessenger.error('Normal Price is required !')

    vm.product.orderPlatforms.push(vm.data.orderPlatform);
    vm.data.orderPlatform = {};
  };

  vm.removeBundledProduct = index => {
    if (!_.isArray(vm.product.bundledProducts)) return;
    vm.product.bundledProducts.splice(index, 1);
  };

  vm.addBundlePrice = object => {
    if (object) {
      object.bundlePrices = object.bundlePrices || [];
      object.bundlePrices.push({});
    } else {
      vm.product.bundlePrices = vm.product.bundlePrices || [];
      vm.product.bundlePrices.push({});
    }

    vm.generateWholesalePriceTag();
  };

  vm.allRegion = {};

  vm.changeExpectedBuyingDateAllRegion = newDate => {
    const value = newDate ? moment(newDate).format('YYYY-MM-DD') : null;

    _.forEach(vm.product.regionAttributes, regionAttribute => {
      regionAttribute.expectedBuyingDate = value;
    });
  };

  vm.changeDelayBuyingAllRegion = delayBuying => {
    _.forEach(vm.product.regionAttributes, regionAttribute => {
      regionAttribute.delayBuying = delayBuying;

      if (delayBuying) {
        regionAttribute.markDelayBuyingTime = moment().toDate();
      }
    });

    if (!delayBuying) {
      vm.allRegion.expectedBuyingDate = null;
    }
  };

  vm.changeDelayBuyingRegion = regionAttribute => {
    if (!regionAttribute.delayBuying) {
      regionAttribute.expectedBuyingDate = null;
    } else {
      regionAttribute.markDelayBuyingTime = moment().toDate();
    }

    if (_.every(vm.product.regionAttributes, regionAttribute => {
      return regionAttribute.delayBuying;
    })) {
      vm.allRegion.delayBuying = true;
    } else {
      vm.allRegion.delayBuying = false;
    }
  };

  vm.removeRegionBundlePrice = regionAttribute => {
    regionAttribute.bundlePrices = [];
  };

  vm.changeSellingProfile = function (sellingProfileId) {
    _.forEach(vm.product.outletAttributes, outletAttribute => {
      const outlet = _.find(vm.data.outlets, {
        code: outletAttribute.outletCode
      });

      const region = _.get(outlet, 'region', 'NORTH');

      const format = _.get(outlet, 'format');

      const stopSell = SellingProfiles.getStopSell(sellingProfileId, outletAttribute.outletCode, region, format);
      outletAttribute.stopSell = stopSell !== null ? stopSell : _.get(outletAttribute, 'stopSell', false);
    });
  };

  vm.changeBuyingProfile = function (buyingProfileId) {
    _.forEach(vm.product.outletAttributes, outletAttribute => {
      const outlet = _.find(vm.data.outlets, {
        code: outletAttribute.outletCode
      });

      const region = _.get(outlet, 'region', 'NORTH');

      const isDirect = BuyingProfiles.getIsDirect(buyingProfileId, outletAttribute.outletCode, region);
      outletAttribute.isDirect = isDirect;
    });
  };

  vm.last2weeks = moment().subtract(14, 'day').format('YYYY-MM-DD');
  vm.yesterday = moment().subtract(1, 'day').format('YYYY-MM-DD');

  vm.createVendorModal = () => {
    VendorService.createVendorModal().result.then(vendor => {
      vm.data.vendors = vm.vendors || [];
      vm.data.vendors.push(vendor);
      vm.product.vendor = vendor._id;
    });
  };

  vm.changeDisplayStock = (displayStock, outlet) => {
    if (displayStock > 0) outlet.stopSell = false;
    if (displayStock === 0) outlet.stopSell = true;
    outlet.displayStockEditTime = new Date();
  };

  $scope.changeMinimumStock = outlet => {
    outlet.minimumStockEditTime = new Date();
  };

  vm.generateWholesalePriceTag = () => {
    const filterNumber = $filter('number');
    vm.product.wholesalePriceTag = _.get(vm.product, 'wholesalePriceTag.content') ? vm.product.wholesalePriceTag : {};
    vm.product.wholesalePriceTag.content = _.reduce(vm.product.bundlePrices, (result, bundlePrice) => {
      return `${result}\n<h4 style="text-align: center;">≥${bundlePrice.quantity}: ${filterNumber(bundlePrice.price, 0)}/${vm.product.unit || 'sp'}</h4>`;
    }, `<h1 style="text-align: center;">Giá sỉ ${vm.product.description}</h1>`);
  };

  vm.updateIsWholesale = function () {
    if (vm.product.isWholesale) {
      vm.product.noLoyalty = true;
    }
  };

  $scope.$watch(() => _.get(vm.product, 'wholesalePriceTag.content'), (newValue, oldValue) => {
    if (newValue !== oldValue && newValue) {
      vm.contentHtml = $sce.trustAsHtml(_.get(vm.product, 'wholesalePriceTag.content'));
    }
  });

  vm.calculateInterest = (defaultCogs, price, region) => {
    let cogs = defaultCogs;

    if (region) {
      const matchRegionAttribute = _.find(vm.product.regionAttributes, {
        region
      });

      if (_.get(matchRegionAttribute, 'cogs')) {
        cogs = _.get(matchRegionAttribute, 'cogs');
      }
    }

    return (price - cogs) * 100 / price;
  };

  vm.addBarcodes = function (barcode) {
    vm.product.barcodes = vm.product.barcodes || [];

    if (!_.some(vm.product.barcodes, productBarcode => {
      return productBarcode === barcode;
    })) {
      vm.product.barcodes.push(barcode);
    }

    barcode = '';
  };

  vm.addReorderLink = function (reorderLink) {
    vm.product.reorderLinks = vm.product.reorderLinks || [];

    if (!_.some(vm.product.reorderLinks, productReorderLink => {
      return productReorderLink === reorderLink;
    })) {
      vm.product.reorderLinks.push(reorderLink);
    }

    reorderLink = '';
  };

  vm.addProductTags = function () {
    vm.product.tags.push(vm.data.tag);
  };

  vm.changeScaleDS = function () {
    if (!vm.data.mathDS) return FhdMessenger.error('Chưa chọn kiểu tăng giảm DS');
    if (!vm.data.scaleDS) return FhdMessenger.error('Chưa nhập giá trị tăng giảm DS');

    _.forEach(vm.product.outletAttributes, outletAttribute => {
      if (outletAttribute.stopSell) return;

      if (outletAttribute.displayStock) {
        let newValue = 0;

        if (vm.data.mathDS === 'multiplication') {
          newValue = Math.ceil(outletAttribute.displayStock * vm.data.scaleDS);
        } else if (vm.data.mathDS === 'summation') {
          newValue = Math.ceil(outletAttribute.displayStock + vm.data.scaleDS);
        } else {
          return FhdMessenger.error('Lỗi');
        }

        outletAttribute.isError = false;

        if (outletAttribute.maxDisplayStock && newValue > outletAttribute.maxDisplayStock) {
          outletAttribute.isError = true;
          return FhdMessenger.info('Giá trị mới lớn hơn Max DS');
        } else if (outletAttribute.minimumStock && newValue < outletAttribute.minimumStock) {
          outletAttribute.isError = true;
          return FhdMessenger.info('Giá trị mới nhỏ hơn Min DS');
        } else {
          outletAttribute.displayStock = newValue;
          outletAttribute.displayStockEditTime = new Date();
        }
      }
    });
  };

  function changeAllOutletAttributeProperty(property) {
    return function (val) {
      _.forEach(vm.product.outletAttributes, outletAttribute => {
        outletAttribute[property] = val;

        if (property === 'minimumStock') {
          outletAttribute.minimumStockEditTime = new Date();
        }

        if (property === 'displayStock') {
          const outlet = _.find(vm.data.outlets, {
            code: outletAttribute.outletCode
          });

          const region = _.get(outlet, 'region', 'NORTH');

          const format = _.get(outlet, 'format');

          outletAttribute.displayStockEditTime = new Date();

          if (val <= 0) {
            outletAttribute.stopSell = true;
          } else {
            const stopSell = SellingProfiles.getStopSell(vm.product.sellingProfile, outletAttribute.outletCode, region, format);
            outletAttribute.stopSell = stopSell !== null ? stopSell : _.get(outletAttribute, 'stopSell', false);
          }
        }
      });
    };
  }

  vm.changeDisplayStockAll = changeAllOutletAttributeProperty('displayStock');
  vm.changeMinimumStockAll = changeAllOutletAttributeProperty('minimumStock');
  vm.changeMaxDisplayStockAll = changeAllOutletAttributeProperty('maxDisplayStock');
  vm.stopSellAll = changeAllOutletAttributeProperty('stopSell');
  vm.directAll = changeAllOutletAttributeProperty('isDirect');
  vm.quickEditProduct = ProductService.quickEditProduct;
  vm.roundNumber = Math.round;

  vm.removeStandardPrice = index => {
    const standardPrices = _.get(vm.product, 'standardPrices');

    if (_.get(standardPrices, 'length')) {
      standardPrices.splice(index, 1);
    }
  };

  vm.addStandardPrice = () => {
    vm.product.standardPrices = vm.product.standardPrices || [];
    vm.product.standardPrices.push({
      price: vm.product.price,
      quantity: 1
    });
  };
  /**
   * Thêm outlet vào product.warehouseRestocks
   * @param {Outlet} outlet
   */


  vm.addWarehouseOutlet = outlet => {
    vm.product.warehouseOutlets = vm.product.warehouseOutlets || [];
    vm.product.warehouseOutlets.push(outlet);
  };
  /**
   * Bỏ outlet có index trong product.warehouseOutlets
   * @param {number} index
   */


  vm.removeWarehouseOutlet = index => {
    vm.product.warehouseOutlets = vm.product.warehouseOutlets || [];
    vm.product.warehouseOutlets.splice(index, 1);
  };
}]);
'use strict';

angular.module('products').controller('ModalViewProductAttributesController', ['$scope', 'Products', 'product', '$modalInstance', 'ProductService', 'CurrentShift', 'OutletService', 'FhdMessenger', function ($scope, Products, product, $modalInstance, ProductService, CurrentShift, OutletService, FhdMessenger) {
  const vm = this;
  vm.product = Products.get({
    productId: product._id || product.product
  }, function () {
    vm.productAttributes = _.reduce(vm.product.attributes, function (result, value, attribute) {
      if (value && attribute) result.push({
        attribute: attribute,
        value: value
      });
      return result;
    }, []);
  });
  vm.outletCode = _.get(CurrentShift.getCurrentShift(), 'outlet.code');
  vm.productSku = _.get(product, 'sku');

  vm.getStock = () => {
    const outlet = _.get(CurrentShift.getCurrentShift(), 'outlet');

    vm.outlet = outlet;
    let promise = ProductService.getProductStock(product._id || product.product).then(({
      productStockMapCache,
      lastModified
    }) => {
      vm.matchOutletStock = _.get(productStockMapCache, _.get(outlet, 'code'));
      vm.lastModified = lastModified;
      return OutletService.allAsync().then(outlets => _.filter(outlets, outlet => outlet.code.match(/^(\w\d+|SHIP)$/i) && outlet.isStorage && outlet.hasStaff)).then(outlets => _.orderBy(outlets, ['order', 'asc'])).then(outlets => _.map(outlets, outlet => {
        let address = outlet.address;
        let phone = outlet.phone;

        if (!outlet.code.match(/[ME]\d+/)) {
          address = '';
          phone = '';
        }

        return _.assign({}, outlet, {
          address,
          phone,
          quantity: _.get(productStockMapCache, _.get(outlet, 'code'))
        });
      })).then(outlets => {
        vm.outlets = outlets;
      });
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải số lượng hàng tồn...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
  };

  vm.ok = function () {
    $modalInstance.dismiss();
  };

  vm.hasValue = function (value) {
    return value;
  };
}]);
'use strict';

angular.module('products').controller('PrintedBarcodeController', ['Authentication', 'FhdMessenger', 'NgTableParams', 'ProductService', '$timeout', 'JsPrintService', function (Authentication, FhdMessenger, NgTableParams, ProductService, $timeout, JsPrintService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.productsNeedPrintBarcodeTable = new NgTableParams({
    count: 50
  });

  vm.find = function () {
    FhdMessenger.info('Đang load các SKU khó quét...');
    ProductService.getAllSellingProductsFromServer().then(products => {
      vm.productsNeedPrintBarcode = _.sortBy(_.filter(products, {
        needPrintedBarcode: true
      }), 'sku');
      vm.productsNeedPrintBarcodeTable.settings({
        dataset: vm.productsNeedPrintBarcode
      });
    });
  };

  vm.print = function () {
    if (!vm.productsNeedPrintBarcode.length) {
      return FhdMessenger.error('Không có SKU nào khó quét');
    }

    $timeout(() => {
      JsPrintService.printElementById('print-need-printed-barcode', true);
    }, 100);
  };

  vm.barcodeOptions = {
    format: 'CODE128',
    lineColor: '#000000',
    background: 'rgba(255, 0, 0, 0)',
    width: 1.5,
    height: 45,
    displayValue: true,
    fontOptions: '',
    font: 'LatoWeb',
    textAlign: 'center',
    textPosition: 'bottom',
    textMargin: 2,
    fontSize: 8,
    margin: 0,
    marginTop: 0,
    marginBottom: 0,
    marginLeft: 0,
    marginRight: 0
  };

  vm.now = function () {
    return moment().toDate();
  };
}]);
'use strict'; // Products controller

angular.module('products').controller('ProductsController', ['$document', '$filter', '$scope', '$stateParams', '$location', 'Authentication', 'Products', 'BusinessService', 'BundlePricesService', 'CurrentShift', 'OutletService', 'ProductService', 'ObjectId', 'NgTableParams', '$state', 'FhdMessenger', 'SavorTagService', 'ProductGroups', 'ProductDepartments', 'ProductCats', 'ProductSubCats', '$q', '$http', 'Vendors', 'WarehouseGroups', 'ReviewRanks', 'VendorService', 'ConfirmModal', 'TetCategories', '$sce', '$timeout', '$window', '$compile', function ($document, $filter, $scope, $stateParams, $location, Authentication, Products, BusinessService, BundlePricesService, CurrentShift, OutletService, ProductService, ObjectId, NgTableParams, $state, FhdMessenger, SavorTagService, ProductGroups, ProductDepartments, ProductCats, ProductSubCats, $q, $http, Vendors, WarehouseGroups, ReviewRanks, VendorService, ConfirmModal, TetCategories, $sce, $timeout, $window, $compile) {
  const vm = this;
  vm.authentication = Authentication;
  const user = Authentication.user;
  vm.user = Authentication.user;
  vm.canSeeCogs = _.intersection(user.roles, ['admin', 'product:view-cogs']).length;
  vm.importContent = '';
  vm.isExporting = false;
  vm.checkDone = ProductService.checkDone();
  OutletService.getOutletCodes().then(({
    ABBY_OUTLET_CODES
  }) => {
    vm.ABBY_OUTLET_CODES = ABBY_OUTLET_CODES;
  });

  vm.now = function () {
    return moment().toDate();
  };

  vm.markProducts = () => {
    const skus = _.get(vm, 'skus', '').split('\n');

    vm.bulkEditProducts = _.reduce(vm.products, (result, product) => {
      if (skus.includes(product.sku)) {
        result.push(product);
      }

      return result;
    }, []);
  };

  vm.redirect = function () {
    // If user is not admin then redirect back home
    if (!_.intersection(vm.user.roles, ['admin', 'admin-merchandise', 'purchaser', 'info', 'marketing', 'product:view-all']).length) {
      $state.go('home');
    }
  };

  vm.canChangeProperties = false;

  if (_.intersection(vm.user.roles, ['admin', 'admin-merchandise', 'purchaser']).length) {
    vm.canChangeProperties = true;
  }

  vm.data = {
    cat: 'tet'
  };
  SavorTagService.getSavorTags().then(tags => {
    vm.data.savorTags = tags;
  });
  BusinessService.allAsync().then(businesses => {
    vm.data.businesses = businesses;
  });
  vm.data.vendors = Vendors.query();
  vm.tetCategories = [];
  vm.data.tetCategories = TetCategories.query();
  vm.data.tetCategoriesSelect = vm.data.tetCategories.$promise.then(tetCategories => {
    vm.tetCategories = tetCategories;
    return _.map(tetCategories, tetCategory => {
      return {
        id: tetCategory.name,
        title: tetCategory.name
      };
    });
  });
  vm.category = {};
  vm.category.groups = [];
  vm.data.groups = ProductGroups.query(function (groups) {
    vm.category.groups = groups;
  });
  vm.data.warehouseGroups = WarehouseGroups.query();
  vm.data.reviewRanks = ReviewRanks.query();

  vm.filterProducts = function () {
    vm.filter = vm.filter || {};

    _.forEach(vm.tableParams.filter(), function (value, key) {
      delete vm.tableParams.filter()[key];
    });

    _.forEach(vm.filter, function (value, key) {
      if (value) {
        vm.tableParams.filter()[`category.${key}.name`] = value.name;
      }
    });
  };

  function editProductModal(method) {
    return function (product, openTab) {
      return ProductService[method](product, openTab).then(_product => {
        if (_.get(_product, '$promise.then')) {
          _product.$promise.then(newProduct => {
            _.assign(product, newProduct);

            vm.checkDoneProduct(product);
            vm.checkAndDone(product);
          });
        }
      });
    };
  }

  vm.quickEditProduct = editProductModal('quickEditProduct');
  vm.quickEditProductAttributes = editProductModal('quickEditProductAttributes');
  vm.editBuyerInfo = editProductModal('editBuyerInfo');
  vm.editInfoInfo = editProductModal('editInfoInfo');
  vm.editInventoryInfo = editProductModal('editInventoryInfo');
  vm.bulkEditProducts = [];

  vm.toggleProductCheck = function (product) {
    if (product.checked) {
      if (!vm.importContent.includes(product.sku)) {
        vm.importContent += `${product.sku} `;
      }

      vm.bulkEditProducts.push(product);
    } else {
      let regex = new RegExp(product.sku + ' *', 'g');
      vm.importContent = vm.importContent.replace(regex, '');

      _.remove(vm.bulkEditProducts, product);
    }
  };

  vm.findAllProduct = function () {
    vm.products = Products.findAllProduct(function (products) {
      vm.products = products;
      vm.tableParams.settings({
        dataset: _.map(vm.products, function (product) {
          return _.assign({}, product, {
            vendorFull: `${_.get(product, 'vendor.code')} ${_.get(product, 'vendor.name')}`,
            profit: (1 - product.cogs / product.price) * 100
          });
        })
      });
    });
    FhdMessenger.notifyLoading('Đang tải sản phẩm...', vm.products.$promise, () => {
      FhdMessenger.success('Đã xong');
    });
  };

  vm.import = function () {
    vm.skus = vm.importContent.match(/B\d{4}/g); // reset array for synchronize

    _.forEach(vm.bulkEditProducts, product => {
      product.checked = false;
    });

    vm.bulkEditProducts = [];

    _.forEach(vm.skus, sku => {
      const matchProduct = _.find(vm.wholesaleProducts, {
        sku: sku
      });

      if (!matchProduct) FhdMessenger.error(`Không thấy mã ${sku}`);
      matchProduct.checked = true;
      return vm.bulkEditProducts.push(matchProduct);
    });
  };

  $scope.$watch(function () {
    return vm.checkAll;
  }, function (newValue, oldValue) {
    if (newValue === oldValue) {
      return;
    }

    let data;

    if (_.get(vm, 'tableParams.data.length')) {
      data = vm.tableParams.data;
    } else if (_.get(vm, 'wholesaleProductsTable.data.length')) {
      data = vm.wholesaleProductsTable.data;
    } else {
      data = vm.pendingProductsTable.data;
    }

    if (newValue) {
      angular.forEach(data, function (product) {
        product.checked = true;

        if (!_.some(vm.bulkEditProducts, function (bulkEditProduct) {
          return product._id === bulkEditProduct._id;
        })) {
          vm.bulkEditProducts.push(product);
        }
      });
    } else {
      angular.forEach(data, function (product) {
        product.checked = false;
        vm.bulkEditProducts = _.reject(vm.bulkEditProducts, function (bulkEditProduct) {
          return product._id === bulkEditProduct._id;
        });
      });
    }
  }); // Add or remove product from bulk update list

  vm.editChecked = function (toAdd, product) {
    if (toAdd) {
      vm.bulkEditProducts.push(product);
    } else {
      vm.bulkEditProducts = _.reject(vm.bulkEditProducts, function (bulkEditProduct) {
        return product._id === bulkEditProduct._id;
      });
    }
  };

  vm.bulkUploadProducts = function () {
    ProductService.bulkUploadProducts(vm.bulkEditProducts).finally(() => {
      FhdMessenger.info('Có thể bạn cần refresh cửa sổ để thấy các thay đổi vừa tạo.');
    });
  };

  vm.bulkRequestWorkTask = function (request) {
    vm.waiting = true;
    $q.all(_.map(vm.bulkEditProducts, (product, index) => {
      return $timeout(() => {
        return ProductService.requestWorkTask(product, request).then(product => {
          FhdMessenger.success(`Đã gửi Work Task cho ${product.sku} ${product.description}`);
        }).catch(err => {
          FhdMessenger.error(`Không gửi được Work Task cho ${product.sku} ${product.description}. Lỗi: ${err.data.message}`);
        });
      }, index * 2000);
    })).then(() => {
      FhdMessenger.info('Đã gửi photo request xong');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.calculateLT = function (vendorId, warehouseGroupId) {
    vm.leadTime = 0;

    if (!vendorId) {
      return;
    }

    const vendor = _.find(vm.data.vendors, {
      _id: vendorId
    });

    if (vendor.leadTime) {
      vm.leadTime = vendor.leadTime + 1.7;

      if (!vm.privateLabel) {
        return;
      }

      if (!warehouseGroupId) {
        return;
      }

      const warehouseGroup = _.find(vm.data.warehouseGroups, {
        _id: warehouseGroupId
      });

      if (warehouseGroup.name === 'Tủ đông' || warehouseGroup.name === 'Tủ mát') {
        vm.leadTime = vm.leadTime + 1;
      } else {
        vm.leadTime = vm.leadTime + 1.5;
      }
    }
  }; // Create new Product


  vm.create = function () {
    if (!vm.sku) {
      return FhdMessenger.error('Chưa có SKU.');
    }

    if (vm.sku.match(/^R/)) {
      vm.isRaw = true;
    }

    if (vm.sku.match(/^B/)) {
      if (!vm.warehouseRestock) {
        return FhdMessenger.error('Chưa có kho chứa sản phẩm');
      }

      if (!vm.netWeight) {
        return FhdMessenger.error('Chưa nhập khối lượng tịnh');
      }

      if (!vm.tetCategory) {
        return FhdMessenger.error('Chưa chọn Catman');
      }

      if (!vm.productGroup) {
        return FhdMessenger.error('Chưa chọn Group');
      }

      if (!vm.warehouseGroup) {
        return FhdMessenger.error('Chưa chọn Điều kiện bảo quản');
      }
    } // Create new Product object


    const product = new Products({
      sku: vm.sku,
      description: vm.description,
      business: vm.business,
      vendorDescription: vm.vendorDescription,
      category: {
        group: vm.productGroup
      },
      wooProperties: {
        images: _.reject(vm.images, {
          src: ''
        })
      },
      tetCategory: vm.tetCategory,
      warehouseGroup: vm.warehouseGroup,
      cogs: vm.cogs,
      price: vm.price,
      packageQuantity: vm.packageQuantity,
      netWeight: vm.netWeight,
      reorderLinks: [vm.reorderLink],
      buyingCode: vm.buyingCode,
      vendor: vm.vendor,
      reviewRak: vm.reviewRank,
      leadTime: vm.leadTime,
      backUpPercentage: vm.backUpPercentage,
      isRaw: vm.isRaw,
      productType: vm.productType,
      buyingWeight: vm.buyingWeight,
      minimumBuyingQuantity: vm.minimumBuyingQuantity,
      privateLabel: vm.privateLabel,
      savorTag: vm.savorTag,
      warehouseRestock: vm.warehouseRestock
    });

    if (vm.images && vm.images.length) {
      product.imageLink = _.head(vm.images).src;
    }

    vm.waiting = true; // Redirect after save

    return product.$save(function () {
      $location.path('products/create');
      FhdMessenger.success(`Tạo SKU ${product.sku} thành công`); // Clear form fields

      vm.sku = '';
      $state.reload();
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Update existing Product


  vm.update = function () {
    const product = vm.product;
    product.business = product.business._id;
    product.$update(function () {
      $location.path(`products/${product._id}`);
    }, function (errorResponse) {
      vm.error = errorResponse.data.message;
    });
  }; // Update featured product


  vm.featureOptions = ['Có', 'Không'];

  vm.updateFeatured = function (product) {
    $http.put(`/products/${product._id}/feature`).then(function (response) {
      const data = response.data;
      product.wooProperties = product.wooProperties || {};
      product.wooProperties.featured = _.get(data, 'wooProperties.featured', false);
      FhdMessenger.success('Cập nhật thành công!');
    }, function (response) {
      FhdMessenger.errorFromServer(response);
    });
  };

  vm.updateWholesaleFeatured = function (product) {
    $http.put(`/products/${product._id}/wholesale-feature`).then(function (response) {
      const data = response.data;
      product.wooProperties = product.wooProperties || {};
      product.wooProperties.wholesaleFeatured = _.get(data, 'wooProperties.wholesaleFeatured', false);
      FhdMessenger.success('Cập nhật thành công!');
    }, function (response) {
      FhdMessenger.errorFromServer(response);
    });
  }; // Updat NOOS product


  vm.updateNoos = function (product) {
    $http.put(`/products/${product._id}/noos`).then(function (response) {
      const updatedProduct = response.data;
      product.noos = updatedProduct.noos;
      FhdMessenger.success('Cập nhật thành công');
    }, function (response) {
      FhdMessenger.errorFromServer(response);
    });
  };

  vm.tableParams = new NgTableParams({}); // Find a list of Products

  vm.find = function (deleted) {
    vm.products = Products.query({
      deleted
    }, function (products) {
      vm.products = products;

      if ($stateParams.vendor) {
        vm.products = _.filter(vm.products, product => {
          return _.get(product, 'vendor._id') === $stateParams.vendor;
        });
      }

      vm.tableParams.settings({
        dataset: _.map(vm.products, function (product) {
          return _.assign({}, product, {
            vendorFull: `${_.get(product, 'vendor.code')} ${_.get(product, 'vendor.name')}`,
            profit: (1 - product.cogs / product.price) * 100
          });
        })
      });
    });
    FhdMessenger.notifyLoading('Đang tải sản phẩm...', vm.products.$promise, () => {
      FhdMessenger.success('Đã xong');
    });
  };

  vm.pendingProductsTable = new NgTableParams({
    count: 50
  });
  vm.pendingProducts = [];

  vm.checkDoneProduct = function (product) {
    product.doneBuyer = vm.checkDone.doneBuyer(product);
    product.doneInfo = vm.checkDone.doneInfo(product);
    product.doneImage = vm.checkDone.doneImage(product);
    product.doneInventory = vm.checkDone.doneInventory(product);
    product.doneUpWork = vm.checkDone.doneUpWork(product);
    product.doneUpAbby = vm.checkDone.doneUpAbby(product);
    product.isReady = vm.checkDone.isReady(product);
    product.canUpWork = vm.checkDone.canUpWork(product);
    product.canUpAbby = vm.checkDone.canUpAbby(product);
    product.canUpFb = vm.checkDone.canUpFb(product);
    product.canDone = vm.checkDone.canDone(product);
  };

  vm.checkAndDone = function (product) {
    if (product.doneBuyer && product.doneInfo && product.doneImage && product.doneInventory && product.doneUpWork && product.doneUpAbby && product.essentialPropertiesConfirmed) {
      vm.done(product);
    }
  };

  vm.done = function (product) {
    return $http.put(`/products/${product._id}/done`).then(function (response) {
      const _product = response.data;

      if (_product.isReady) {
        FhdMessenger.success('Done!');

        const index = _.findIndex(vm.pendingProductsTable.data, {
          sku: product.sku
        });

        if (index > -1) {
          vm.pendingProductsTable.data.splice(index, 1);
          vm.pendingProductsTable.settings({
            dataset: vm.pendingProductsTable.data
          });
        }
      }
    }, function (response) {
      FhdMessenger.errorFromServer(response);
    });
  };

  vm.markDone = function (product) {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Xác nhận`,
      bodyText: `Bạn xác nhận muốn bỏ sản phẩm ${product.sku} - ${product.description} ra khỏi danh sách pending products`
    }).then(() => {
      vm.done(product);
    });
  };

  vm.addDate = function (product) {
    product.date = moment(product.created).format('DD/MM/YYYY');
  };

  vm.findPendingProducts = function () {
    FhdMessenger.info('Đang load các SKU Pending...');
    Products.query({
      isPending: true,
      select: '-wooProperties.description -wooProperties.shortDescription -locations'
    }, function (products) {
      FhdMessenger.success('Đã xong.');
      vm.pendingProducts = products;

      _.forEach(vm.pendingProducts, vm.checkDoneProduct);

      _.forEach(vm.pendingProducts, vm.addDate);

      _.forEach(vm.pendingProducts, vm.doubleCheckProperties);

      vm.pendingProductsTable.settings({
        dataset: vm.pendingProducts
      });
      vm.pendingProductsTable.sorting({
        created: 'desc',
        sku: 'asc'
      });
    });
  };

  vm.generateWholesalePriceTag = product => {
    const filterNumber = $filter('number');
    product.wholesalePriceTag = _.get(product, 'wholesalePriceTag.content') ? product.wholesalePriceTag : {};
    product.wholesalePriceTag.content = _.reduce(product.bundlePrices, (result, bundlePrice) => {
      return `${result}\n<h4 style="text-align: center;">≥${bundlePrice.quantity}: ${filterNumber(bundlePrice.price, 0)}/${product.unit || 'sp'}</h4>`;
    }, `<h1 style="text-align: center;">Giá sỉ ${product.description}</h1>`);
  };

  vm.wholesaleProductsTable = new NgTableParams({
    count: 1000
  });

  vm.findWholesaleProducts = function () {
    FhdMessenger.info('Đang load các SKU bán sỉ...');
    Products.query({
      bundlePrices: true
    }, function (products) {
      const region = _.get(CurrentShift.getCurrentShift(), 'outlet.region', 'NORTH');

      _.forEach(products, product => {
        product.bundlePrices = BundlePricesService.getBundlePrices(product, region);
        vm.generateWholesalePriceTag(product);
        product.contentHtml = $sce.trustAsHtml(_.get(product, 'wholesalePriceTag.content', ''));
      });

      FhdMessenger.success('Đã xong.');
      vm.wholesaleProducts = products;
      vm.wholesaleProductsTable.settings({
        dataset: vm.wholesaleProducts
      });
    });
  };

  const isSomeOne = _.curry(function (role, user) {
    return _.includes(user.roles, role);
  });

  const isAdmin = isSomeOne('admin');

  vm.doubleCheckProperties = function (product) {
    const validator = ProductService.validateUpdateToSell(product);
    validator.checkSKU().checkDescription().checkCogs().checkPrice().checkCategory().checkCategoryGroup().checkDS().checkStopSell().checkProductTime().checkMinWeight().checkMaxWeight().checkNetWeight();
    product.errors = validator.errors();
  };

  vm.errorsContent = errors => {
    return errors.join('<br />');
  };

  vm.showWarning = product => {
    let warningMessage = `- Bạn đã tick Direct Buying đủ chưa?`;

    if (!product.toSell) {
      warningMessage = `${warningMessage}\n- Sản phẩm chưa được tick toSell.`;
    }

    if (!product.privateLabel) {
      warningMessage = `${warningMessage}\n- Sản phẩm này không phải hàng PL.`;
    }

    return $window.confirm(warningMessage);
  };

  vm.upSell = function (product, index) {
    if (!isAdmin(user)) {
      return FhdMessenger.error('Bạn không có quyền thực hiện chức năng này!');
    }

    return $http.put(`/products/${product._id}/to-sell`).then(function (response) {
      const _product = response.data;
      product.toSell = _product.toSell;

      if (product.toSell) {
        FhdMessenger.success(`Đã up sell sku ${product.sku}`);
        vm.checkAndDone(product, index);
      } else {
        FhdMessenger.info(`Đã hủy up sell sku ${product.sku}`);
      }
    }, function (response) {
      FhdMessenger.errorFromServer(response, true);
    });
  }; // vm.init = () => {}


  vm.findSellingProducts = function () {
    ProductService.allAsync().then(products => {
      return _.filter(products, {
        toSell: true
      });
    }).then(products => {
      vm.products = _.map(products, function (product) {
        let typeGroup = '2. Non-food';

        if (_.get(product, 'warehouseGroup') && (product.warehouseGroup.name === 'Tủ đông' || product.warehouseGroup.name === 'Tủ mát')) {
          typeGroup = '3. Hàng lạnh';
        } else if (_.get(product, 'category')) {
          if (ProductService.isFoodProduct(product)) typeGroup = '1. Food';
        }

        product.wooProperties = product.wooProperties || {};
        product.wooProperties.wholesaleFeatured = product.wooProperties.wholesaleFeatured || false;
        product.wooProperties.featured = product.wooProperties.featured || false;
        return _.assign({}, product, {
          vendorFull: `${_.get(product, 'vendor.code')} ${_.get(product, 'vendor.name')}`,
          profit: (1 - product.cogs / product.price) * 100,
          featured: product.wooProperties ? product.wooProperties.featured || false : false,
          typeGroup
        });
      });

      if ($stateParams.vendor) {
        vm.products = _.filter(vm.products, product => {
          return _.get(product, 'vendor._id') === $stateParams.vendor;
        });
      }

      if ($location.search().isRaw === 'true') {
        vm.tableParams.filter().isRaw = true;
        vm.tableParams.filter().sku = 'B';
      }

      vm.tableParams.settings({
        dataset: vm.products
      });
      vm.tableParams.filter().toSell = true;
      vm.tableParams.filter().notBuying = false;
    });
  };

  function convertToCamelCase(fieldName) {
    switch (fieldName) {
      case 'SKU':
      case 'Description':
      case 'Price':
      case 'COGS':
      case 'Profit':
      case 'Tag':
        return fieldName.toLowerCase();

      case 'Sale':
        return 'salePrice';

      case 'Kho restock':
        return 'warehouseRestockCode';

      case 'Cat Man':
        return 'tetCategoryName';

      case 'Abby':
        return 'wooPropertiesWebsiteId';

      case 'Featured':
        return 'wooPropertiesFeatured';

      case 'Wholesale Featured':
        return 'wooPropertiesWholesaleFeatured';

      case 'Vendor':
        return 'vendorVendorFull';

      case 'Private Label':
        return 'privateLabel';

      case 'Country':
        return 'vendorCountry';

      case 'Link đặt hàng':
        return 'productReorderLinks';

      case 'RT':
        return 'vendorReviewRankCode';

      case 'LT':
        return 'leadTime';

      case 'VAT':
        return 'canExportVATBill';

      case 'Type':
        return 'typeGroup';

      default:
        break;
    }
  }

  function convertToPath(fieldName) {
    switch (fieldName) {
      case 'warehouseRestockCode':
        return 'warehouseRestock.code';

      case 'tetCategoryName':
        return 'tetCategory.name';

      case 'valentineCategoryName':
        return 'valentineCategory.name';

      case 'mooncakeCategoryName':
        return 'mooncakeCategory.name';

      case 'wooPropertiesWebsiteId':
        return 'wooProperties.websiteId';

      case 'wooPropertiesFeatured':
        return 'wooProperties.featured';

      case 'wooPropertiesWholesaleFeatured':
        return 'wooProperties.wholesaleFeatured';

      case 'vendorVendorFull':
        return 'vendor.vendorFull';

      case 'vendorCountry':
        return 'vendor.country';

      case 'vendorReviewRankCode':
        return 'vendor.reviewRank.code';

      default:
        return fieldName;
    }
  }

  $scope.$watchGroup(['vm.tableParams.data', 'vm.showReorderLink', 'vm.showCountryAndPL', 'vm.data.cat'], () => {
    const selectToExportRow = $document[0].querySelector("tr[id='printCols']");

    if (selectToExportRow) {
      selectToExportRow.remove();
      vm.isExporting = false;
    }
  }); // default export sku and description

  vm.selected = {};
  vm.selected.sku = true;
  vm.selected.description = true;

  vm.exportSelectedColumn = () => {
    let keys = _.filter(_.keys(vm.selected), key => {
      return vm.selected[key];
    });

    const products = _.reduce(vm.products, (result, product) => {
      result = result || [];
      const obj = {};

      _.forEach(keys, key => {
        obj[key] = _.get(product, convertToPath(key));
      });

      result.push(obj);
      return result;
    }, []);

    const now = moment().startOf('day').format('YYYY-MM-DD');
    alasql(`SELECT * INTO XLSX("dssp-${now}.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [products]);
    vm.selected = {};
  };

  vm.showSelectColumnToExport = function () {
    if (!_.includes(vm.user.roles, 'admin')) {
      return;
    }

    vm.isExporting = true;
    const selectToExportRow = $document[0].querySelector("tr[id='printCols']");

    if (selectToExportRow) {
      return;
    } // lấy tên các cột đang hiện


    const cols = $document[0].querySelectorAll("span[ng-bind='$column.title(this)']");
    const colNames = [];

    _.forEach(cols, col => {
      colNames.push(col.innerText);
    }); // bỏ phần từ ở cột action


    colNames.splice(-1, 1); // tạo dòng mới

    const newRow = $document[0].createElement('TR');
    newRow.setAttribute('id', 'printCols');
    newRow.setAttribute('class', 'text-center'); // tạo ô trống ở trước cột sku

    const blankTD = $document[0].createElement('TD'); // tạo cột có button export

    const exportButtonTD = $document[0].createElement('TD');
    const exportButton = $document[0].createElement('BUTTON');
    exportButton.setAttribute('ng-click', 'vm.exportSelectedColumn()');
    exportButton.setAttribute('class', 'btn btn-primary');
    exportButton.appendChild($document[0].createTextNode('Export'));
    exportButtonTD.appendChild(exportButton); // tạo cột có checkbox để chọn cột in ra

    const td = $document[0].createElement('TD');
    const checkboxInput = $document[0].createElement('INPUT');
    checkboxInput.setAttribute('type', 'checkbox');
    td.appendChild(checkboxInput); // import khoảng trắng ở cột đầu

    newRow.appendChild(blankTD); // in ra các cột có checkbox

    for (let i = 0; i < colNames.length; i++) {
      checkboxInput.setAttribute('ng-model', `vm.selected.${convertToCamelCase(colNames[i])}`);
      newRow.appendChild(td.cloneNode(true)); // ô cuối để button export

      if (i === colNames.length - 1) {
        newRow.appendChild(exportButtonTD);
      }
    } // compile để sử dụng ng-model ng-click các thứ


    $compile(newRow)($scope);
    const thead = $document[0].querySelector('thead'); // gán dòng mới vào thead

    thead.appendChild(newRow);
  };

  vm.exportDisplayStockFile = function () {
    if (!_.includes(vm.user.roles, 'admin')) {
      return;
    }

    const products = _.map(vm.products, function (product) {
      const outletAttributeMap = _.reduce(product.outletAttributes, (result, outletAttribute) => {
        result[outletAttribute.outletCode] = outletAttribute.stopSell ? 'N/A' : outletAttribute.displayStock;
        return result;
      }, {});

      _.forEach(vm.ABBY_OUTLET_CODES, outletCode => {
        product[`DS ${outletCode}`] = _.get(outletAttributeMap, outletCode);
      });

      return product;
    });

    const now = moment().startOf('day').format('YYYY-MM-DD');
    alasql(`SELECT * INTO XLSX("dssp-cogs-${now}.xlsx",{headers:true, utf8Bom: true}) FROM ?`, [products]);
  };

  vm.images = [{
    src: ''
  }];

  function isSrcBlank(image) {
    return !image.src;
  }

  vm.imagesChanged = function () {
    const numberOfBlankImages = _.filter(vm.images, isSrcBlank).length;

    if (numberOfBlankImages >= 2) {
      const matchIndex = _.findIndex(vm.images, isSrcBlank);

      vm.images.splice(matchIndex, 1);
    }

    if (numberOfBlankImages < 1) {
      vm.images.push({
        src: ''
      });
    }
  };

  vm.sku = null;

  vm.newSku = function (productType) {
    if (!vm.business) {
      return FhdMessenger.info('Chưa chọn business');
    } else {
      const businessCode = _.get(vm.business, 'code');

      ProductService.newSku(productType, businessCode).then(sku => {
        vm.sku = sku;
      });
    }
  };

  vm.createVendorModal = () => {
    VendorService.createVendorModal().result.then(vendor => {
      vm.data.vendors = vm.data.vendors || [];
      vm.data.vendors.push(vendor);
      vm.vendor = _.get(vendor, '_id');
    });
  };

  vm.uploadAbby = (product, index) => {
    if (product.waiting) return FhdMessenger.error('Đang thực hiện lệnh cũ');
    product.waiting = true;
    $http.put(`/products/${product._id}/update-website`, {
      editImages: true
    }).then(response => {
      const permalink = _.get(response, 'data.permalink');

      product.wooProperties.websiteId = _.get(response, 'data.id');
      FhdMessenger.notifySticky(`Đã up Abby.vn. <a href="${permalink}">Link</a>`, 'success', 3);
      vm.checkDoneProduct(product);
      vm.checkAndDone(product, index);
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      product.waiting = false;
    });
  };

  vm.confirmProperties = product => {
    if (product.errors.length) {
      return FhdMessenger.error('Sản phẩm này chưa thỏa mãn các thuộc tính yêu cầu. Bạn hãy kiểm tra lại nhé !');
    }

    if (!product.essentialPropertiesConfirmed) {
      const confirm = vm.showWarning(product);

      if (!confirm) {
        return;
      }

      vm.waiting = true;
      product.$confirmProperties(_product => {
        FhdMessenger.success('Confirm thuộc tính thành công');
        vm.checkDoneProduct(product);
        vm.checkAndDone(product);
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    }
  };

  vm.updateVAT = product => {
    $http.post(`/products/${product._id}/change-VAT-status`).then(res => {
      product.canExportVATBill = res.data.canExportVATBill;
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    });
  };

  vm.standardPriceProductsTable = new NgTableParams({
    count: 100
  });

  vm.findStandardPriceProducts = function () {
    FhdMessenger.info('Đang load các SKU giá sỉ kinh doanh...');
    ProductService.allAsync().then(products => {
      return _.filter(products, product => _.get(product, 'standardPrices', []).length > 0);
    }).then(filteredProducts => {
      vm.standardPriceProductsTable.settings({
        dataset: filteredProducts
      });
    });
  }; // dynamic table for standard price product


  function indexCol($scope, row, rowIndex) {
    return `<span>${rowIndex + 1}</span>`;
  }

  function getSkuCell($scope, row) {
    return `<a ng-click="vm.quickEditProduct(row,'standardPrice')">${row.sku}</a>`;
  }

  function getStandardPrices($scope, row) {
    const vm = this;

    const standardPrices = _.get(row, vm.field);

    let printContent = '';

    _.forEach(standardPrices, standardPrice => {
      printContent += `<strong>≥${standardPrice.quantity}: </strong><span>${$filter('number')(standardPrice.price, 0)}</span></br>`;
    });

    return printContent;
  } // function numberValue($scope, row) {
  //   const vm = this
  //   const value = _.get(row, vm.field, '')
  //   return `<span>${$filter('number')(value, 0)}</span>`
  // }


  function getImage($scope, row) {
    const vm = this;

    const imageLink = _.get(row, vm.field, '');

    return `<img ng-src="${imageLink}" style="width: 200px; height: 200px" />`;
  }

  function normalValue($scope, row) {
    const vm = this;

    const value = _.get(row, vm.field);

    if (angular.isUndefined(value) || value === null) {
      return '';
    }

    return `<span>${_.get(row, vm.field) || ''}</span>`;
  }

  vm.cols = [{
    title: 'STT',
    show: true,
    getValue: indexCol
  }, {
    field: 'sku',
    title: 'SKU',
    sortable: 'sku',
    filter: {
      sku: 'text'
    },
    show: true,
    getValue: getSkuCell
  }, {
    title: 'Ảnh sản phẩm',
    field: 'imageLink',
    show: true,
    getValue: getImage
  }, {
    field: 'description',
    title: 'Description',
    sortable: 'description',
    filter: {
      description: 'text'
    },
    show: true,
    getValue: normalValue
  }, {
    title: 'Giá sỉ kinh doanh',
    field: 'standardPrices',
    show: true,
    getValue: getStandardPrices
  }];

  vm.printWholesalePriceTags = () => {
    const printContents = $document[0].getElementById('print-content').innerHTML; // eslint-disable-line angular/document-service no-undef

    const popupWin = window.open(); // eslint-disable-line angular/window-service

    popupWin.document.open();
    popupWin.document.write(`
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="Content-type" content="text/html;charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <link rel="stylesheet" type="text/css" href="${$document[0].location.origin}/css/bootstrap-theme.css"/>
    <link rel="stylesheet" type="text/css" href="${$document[0].location.origin}/modules/core/css/core.css"/>
    <link rel="stylesheet" type="text/css" href="${$document[0].location.origin}/modules/info-tags/css/info-tags.css"/>
    <script type="text/javascript" src="${$document[0].location.origin}/lib/jquery/dist/jquery.min.js"></script>
  </head>
  <body>
    ${printContents}
    <script>
    $(function(){
          setTimeout(
            function() {
              if (window.jsPrintSetup)  {
                jsPrintSetup.setOption('orientation', jsPrintSetup.kPortraitOrientation);
                jsPrintSetup.setPaperSizeData(11)

                // set top margins in millimeters
                jsPrintSetup.setOption('marginTop', 0);
                jsPrintSetup.setOption('marginRight', 0);
                jsPrintSetup.setOption('marginLeft', 0);
                // jsPrintSetup.setOption('headerStrRight', '&PT');
                // set empty page footer
                jsPrintSetup.setOption('footerStrLeft', '');
                jsPrintSetup.setOption('footerStrCenter', '');
                jsPrintSetup.setOption('footerStrRight', '');

                // Suppress print dialog
                jsPrintSetup.setSilentPrint(true);/** Set silent printing */
                // Do Print

                // Restore print dialog
                jsPrintSetup.print();
              } else {
                window.print()
              }
            },
            1000
          )

      })
    </script>
  </body>
</html>
        `);
    popupWin.document.close();
  };
}]);
"use strict";

angular.module('products').controller('SavorProductsController', ['Products', 'NgTableParams', 'ProductService', 'FhdMessenger', 'Authentication', '$scope', '$localStorage', '$http', '$filter', 'OutletService', function (Products, NgTableParams, ProductService, FhdMessenger, Authentication, $scope, $localStorage, $http, $filter, OutletService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.canSeeProtectColumns = _.includes(vm.user.roles, 'admin');
  vm.productsTable = new NgTableParams();
  vm.data = {
    outletSale: {
      startDate: moment().subtract(1, 'day').startOf('hour').toDate(),
      endDate: moment().startOf('hour').toDate()
    },
    columnMap: {
      categories: false,
      tags: false,
      notBuying: true,
      toSell: true,
      toUse: true,
      stockControl: true,
      privateLabel: false,
      isRaw: false,
      isMenuItem: false,
      outletStock: true,
      orderPoint: false,
      packageQuantity: false,
      minimumBuyingQuantity: false,
      minimumDeliverQuantity: false,
      outletSale: false,
      currentStock: false
    },
    columns: ['categories', 'tags', 'notBuying', 'toSell', 'toUse', 'stockControl', 'privateLabel', 'isRaw', 'isMenuItem', 'outletStock', 'orderPoint', 'packageQuantity', 'minimumBuyingQuantity', 'minimumDeliverQuantity', 'outletSale', 'currentStock'],
    booleanColumns: ['notBuying', 'toSell', 'toUse', 'stockControl', 'privateLabel', 'isRaw', 'isMenuItem'],
    textColumns: ['category.department.name', 'category.cat.name', 'orderPoint', 'packageQuantity', 'minimumBuyingQuantity', 'minimumDeliverQuantity']
  };

  vm.init = () => {
    const savorProductState = $localStorage.getObject('savorProductState8');

    if (savorProductState && _.keys(savorProductState).length > 0) {
      _.assign(vm.data, savorProductState);
    }

    defineColsTable();
    $scope.$watch(() => vm.data, (newValue, oldValue) => {
      if (_.isEqual(newValue, oldValue)) return;
      $localStorage.setObject('savorProductState8', vm.data);
    }, true);
  };

  const getIndex = ($scope, row, rowIndex) => `<span>${rowIndex + 1}</span>`;

  const getSku = ($scope, row) => `<a ng-click="vm.quickEditProduct(row)" data-cy="a-sku"> ${row.sku} </a>`;

  const getDesc = ($scope, row) => `<a ng-click="vm.quickEditProductAttributes(product)">${row.description}</a>`;

  function getPercent($scope, row) {
    // eslint-disable-next-line
    const value = $filter('number')(_.get(row, this.field), 1);

    if (!value) {
      return '';
    }

    return `<span>${value}%</span>`;
  }

  function getNumber($scope, row) {
    // eslint-disable-next-line
    let value = _.get(row, this.field);

    if (_.isNull(value) || _.isUndefined(value)) {
      return '';
    } // eslint-disable-next-line


    value = $filter('number')(_.get(row, this.field, ''), 0);
    return `<span>${value}</span>`;
  }

  function getInStock($scope, row) {
    // eslint-disable-next-line
    const value = _.get(row, this.field);

    if (value === true) return `<span>Còn</span>`;
    if (value === false) return `<span>Hết</span>`;
    return '';
  }

  function getNormalValue($scope, row) {
    // eslint-disable-next-line
    const value = _.get(row, this.field, '');

    return `<span>${value}</span>`;
  }

  const stockDataFilter = [{
    id: true,
    title: 'Còn'
  }, {
    id: false,
    title: 'Hết'
  }];
  const controlDataFilter = [{
    id: true,
    title: 'true'
  }, {
    id: false,
    title: 'false'
  }];

  function getStatusStyle(row) {
    // eslint-disable-next-line
    const value = _.get(row, this.field); // Nếu "Hết" => tô màu đỏ


    if (value === false) {
      return {
        color: '#FF0000'
      };
    }
  }

  const defineColsTable = () => {
    OutletService.getOutletCodes().then(outletCodes => {
      const {
        SAVOR_OUTLET_CODES
      } = outletCodes;
      const SAVOR_AND_DEPOT_CODES = [...SAVOR_OUTLET_CODES, 'D1'];
      vm.cols = [{
        title: 'STT',
        show: true,
        getValue: getIndex
      }, {
        field: 'sku',
        title: 'SKU',
        sortable: 'sku',
        filter: {
          sku: 'text'
        },
        show: true,
        getValue: getSku
      }, {
        field: 'description',
        title: 'Description',
        sortable: 'description',
        filter: {
          description: 'text'
        },
        show: true,
        getValue: getDesc
      }, {
        field: 'category.group.name',
        title: 'Group',
        sortable: 'category.group.name',
        show: () => vm.data.columnMap.categories,
        getValue: getNormalValue
      }, {
        field: 'price',
        title: 'Price',
        sortable: 'price',
        getValue: getNumber
      }, {
        field: 'finalCogs',
        title: 'COGS',
        sortable: 'finalCogs',
        show: () => vm.canSeeProtectColumns,
        getValue: getNumber
      }, {
        field: 'profitPercentage',
        title: '%profit',
        sortable: 'profitPercentage',
        show: () => vm.canSeeProtectColumns,
        getValue: getPercent
      }, {
        field: 'salePrice',
        title: 'Sale',
        sortable: 'salePrice',
        getValue: getNumber
      }, {
        field: 'savorCategory.name',
        title: 'S-tag',
        sortable: 'savorCategory.name',
        show: () => vm.data.columnMap.tags,
        getValue: getNormalValue
      }, {
        field: 'tag',
        title: 'Tag',
        sortable: 'tag',
        filter: {
          tag: 'text'
        },
        show: () => vm.data.columnMap.tags,
        getValue: getNormalValue
      }];

      const outletStatusCols = _.map(SAVOR_OUTLET_CODES, code => {
        return {
          field: `outletMap.${code}.inStock`,
          title: `Status ${code}`,
          sortable: `outletMap.${code}.inStock`,
          filter: {
            [`outletMap.${code}.inStock`]: 'select'
          },
          show: () => vm.data.columnMap.outletStock,
          getStyle: getStatusStyle,
          filterData: stockDataFilter,
          getValue: getInStock
        };
      });

      const outletsSaleCols = _.map([...SAVOR_OUTLET_CODES, 'total'], code => {
        return {
          field: `outletSaleMap.${code}`,
          title: `Sale ${code}`,
          sortable: `outletSaleMap.${code}`,
          show: () => vm.data.columnMap.outletSale,
          getValue: getNumber
        };
      });

      const outletsStockCols = _.map([...SAVOR_AND_DEPOT_CODES, 'total'], code => {
        return {
          field: `stockMap.${code}`,
          title: `Stock ${code}`,
          sortable: `stockMap.${code}`,
          show: () => vm.data.columnMap.currentStock,
          getValue: getNumber
        };
      });

      vm.cols.push(...['notBuying', 'toSell', 'toUse', 'stockControl', 'privateLabel', 'isRaw', 'isMenuItem'].map(name => ({
        field: name,
        title: name,
        sortable: name,
        filter: {
          [name]: 'select'
        },
        filterData: controlDataFilter,
        show: () => vm.data.columnMap[name],
        getValue: getNormalValue
      })));
      vm.cols.push(...outletStatusCols);
      vm.cols.push(...['orderPoint', 'packageQuantity', 'minimumBuyingQuantity', 'minimumDeliverQuantity'].map(name => ({
        field: name,
        title: name,
        filter: {
          [name]: 'text'
        },
        sortable: name,
        show: () => vm.data.columnMap[name],
        getValue: getNumber
      })));
      vm.cols.push(...outletsSaleCols, ...outletsStockCols);
    });
  };

  vm.fetchTable = products => {
    vm.productsTable.settings({
      dataset: products
    });
    vm.productsTable.reload();
  };

  vm.getFilteredProducts = () => {
    const products = vm.products;
    vm.fetchTable(products);
  };

  function calculateProduct(product) {
    product.finalCogs = product.bundledProducts && product.bundledProducts.length ? product.computedCogs : product.cogs;
    product.profitPercentage = Math.round((1 - product.finalCogs / product.price) * 10000) / 100;
    product.profitPercentage = isFinite(product.profitPercentage) ? product.profitPercentage : 'N/A';
  }

  vm.find = () => {
    vm.products = Products.listSavorProducts({
      businessCode: 'SAVOR',
      select: 'sku description category price salePrice cogs computedCogs savorCategory tag outletAttributes notBuying toSell isMenuItem toUse stockControl packageQuantity minimumBuyingQuantity minimumDeliverQuantity orderPoint privateLabel isRaw isMenuItem bundledProducts tags',
      populations: ['category.group', 'savorCategory']
    });
    vm.products.$promise.then(() => {
      vm.products = _.map(vm.products, product => {
        calculateProduct(product);

        const outletMap = _.reduce(product.outletAttributes, (result, outlet) => {
          result[outlet.outletCode] = outlet;
          result[outlet.outletCode].inStock = _.get(outlet, 'inStock', '');
          return result;
        }, {});

        return _.assign(product, {
          outletMap
        });
      });
      vm.data.savorTags = _.uniq(_.map(vm.products, 'savorTag'));
      vm.getFilteredProducts();

      _.assign(vm.productsTable.filter(), {
        notBuying: 'false' // toUse: 'false',

      });
    }).catch(FhdMessenger.errorFromServer);
    FhdMessenger.notifyLoading('Đang tải ...', vm.products.$promise, () => {
      FhdMessenger.success('Đã tải xong');
    });
  };

  function editProductModal(method) {
    return function (product) {
      ProductService[method](product).then(_product => {
        if (_.get(_product, '$promise.then')) {
          _product.$promise.then(newProduct => {
            _.assign(product, newProduct);

            calculateProduct(product);
          });
        }
      });
    };
  }

  vm.quickEditProduct = editProductModal('quickEditProduct');

  const getOutletSale = ({
    startDate,
    endDate
  }) => {
    let promise = $http.get('/reports/outlet-sale', {
      params: {
        startDate,
        endDate
      }
    }).then(response => {
      return response.data;
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
    return promise;
  };

  vm.loadOutletSale = () => {
    getOutletSale({
      startDate: vm.data.outletSale.startDate,
      endDate: vm.data.outletSale.endDate
    }).then(products => {
      const productMap = _.reduce(products, (result, product) => {
        const S1sale = _.get(product, 'outletMap.S1.quantity', 0);

        const S2sale = _.get(product, 'outletMap.S2.quantity', 0);

        result[_.get(product, 'product._id')] = {
          S1: S1sale,
          S2: S2sale,
          total: (S1sale || 0) + (S2sale || 0)
        };
        return result;
      });

      _.forEach(vm.products, product => {
        const matchProduct = _.get(productMap, product._id);

        if (matchProduct) {
          _.assign(product, {
            outletSaleMap: matchProduct
          });
        } else {
          _.assign(product, {
            outletSaleMap: {
              S1: 0,
              S2: 0,
              total: 0
            }
          });
        }
      });
    }).catch(FhdMessenger.errorFromServer);
  };

  $scope.$watch(() => ({
    data: vm.productsTable.data,
    columnMap: vm.data.columnMap
  }), (newValue, oldValue) => {
    if (newValue === oldValue) return;
    const columnMap = newValue.columnMap;
    const columns = ['sku', 'description', 'price', 'salePrice'];

    if (vm.canSeeProtectColumns) {
      columns.push('cogs');
    }

    _.forEach(vm.data.booleanColumns, column => {
      if (columnMap[column]) {
        columns.push(column);
      }
    });

    _.forEach(vm.data.textColumns, column => {
      if (columnMap[column]) {
        columns.push(column);
      }
    });

    if (columnMap.categories) {
      columns.push('category.group.name');
    }

    if (columnMap.tags) {
      columns.push('savorCategory.name');
      columns.push('tag');
    }

    if (columnMap.outletStock) {
      columns.push('outletMap.S1.inStock');
      columns.push('outletMap.S2.inStock');
    }

    if (columnMap.outletSale) {
      columns.push('outletSaleMap.S1');
      columns.push('outletSaleMap.S2');
      columns.push('outletSaleMap.total');
    }

    if (columnMap.currentStock) {
      columns.push('stockMap.S1');
      columns.push('stockMap.S2');
      columns.push('stockMap.total');
    }

    const header = columns.join('\t');
    const products = newValue.data;
    const body = products.map(product => _.map(columns, column => _.get(product, column, '')).join('\t')).join('\n');
    vm.productsCSV = header + '\n' + body;
  }, true);
}]);
