angular.module('sale-entries').factory('SaleEntries', ['$resource', function ($resource) {
  return $resource('sale-entries/:saleEntryId', {
    saleEntryId: '@_id'
  }, {
    save: {
      method: 'POST',
      url: '/sale-entries'
    },
    update: {
      method: 'PUT'
    },
    addCustomer: {
      method: 'PUT',
      url: '/sale-entries/:saleEntryId/add-customer'
    },
    updatePermissionReturnItems: {
      method: 'PUT',
      url: '/sale-entries/:saleEntryId/update-permission-return-items'
    },
    addBillNumber: {
      method: 'PUT',
      url: '/sale-entries/:saleEntryId/add-bill-number'
    },
    softRemove: {
      method: 'PUT',
      url: '/sale-entries/:saleEntryId/soft-remove'
    },
    searchSaleEntry: {
      url: '/sale-entries/search'
    }
  });
}]);
