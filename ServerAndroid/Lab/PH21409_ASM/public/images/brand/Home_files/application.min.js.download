  vm.copySalaryTSV = () => {
    let headers = ['STT', 'Mã NV', 'CS', 'Họ và tên'];
    let additionalHeader = ['Rank', 'Giờ trực', 'Lương trách nhiệm', 'Lương doanh thu bán hàng', 'Lương doanh thu ship', 'Công ty bù lương tối thiểu', 'Bonus', 'Thumb Up', 'Ticket', 'Lương Final', 'Lương/Giờ'];

    if (vm.data.position === 'fulltime-ship') {
      additionalHeader = ['Lương trách nhiệm', 'Phụ cấp ăn trưa', 'Số ca trực lý thuyết', 'Số ca trực thực tế', 'Số ca trực nghỉ phép', 'Lương doanh thu', 'Bonus', 'Bảo hiểm', 'Thumb Up', 'Ticket', 'Lương Final'];
    } else if (vm.data.position === 'parttime-ship') {
      additionalHeader = ['Rank', 'Giờ trực', 'Lương trách nhiệm', 'Lương doanh thu', 'Lương bù mức tối thiểu', 'Bonus', 'Ticket', 'Lương Final', 'Lương/h'];
    } else if (vm.data.position === 'packing') {
      additionalHeader = ['Rank', 'Giờ trực', 'Lương trách nhiệm', 'Phút ĐG', 'Lương năng suất', 'Chỉ số năng suất', 'Bonus', 'Thumb Up', 'Ticket', 'Lương Final', 'Lương/h'];
    } else if (vm.data.position === 'warehousing') {
      additionalHeader = ['Rank', 'Lương/phút', 'Phút Buying', 'Phút Logistics', 'Phút Storing', 'Tổng phút làm việc', 'Sai số quét đơn Logistics', 'Tỉ lệ missing', 'Hệ số lương Buying', 'Hệ số lương Logistics', 'Hệ số lương Storing', 'Phút tính lương', 'Bonus', 'Thumb Up', 'Ticket', 'Tổng lương', 'Lương/giờ'];
    } else if (vm.data.position === 'CTV-warehousing') {
      additionalHeader = ['Giờ Buying', 'Giờ Logistics', 'Giờ Storing', 'Lương Buying', 'Lương Logistic', 'Lương Storing', 'Thumb Up', 'Ticket', 'Tổng lương'];
    } else if (vm.data.position === 'order') {
      additionalHeader = ['Rank', 'Giờ trực', 'Lương trách nhiệm', 'Lương doanh thu', 'Bonus', 'Thumb Up', 'Ticket', 'Lương Final', 'Lương/h'];
    } else if (vm.data.position === 'kitchen') {
      additionalHeader = ['Rank', 'Giờ làm việc', 'Lương trên giờ', 'Hệ số lương', 'Số ca trực từ 5h-8h', 'Lương/ ca trực từ 5h-8h', 'Bonus', 'Thumb Up', 'Ticket', 'Lương Final', 'Lương trên giờ Final'];
    } else if (vm.data.position === 'hr2-parttime') {
      additionalHeader = ['Giờ trực', 'Lương trực', 'Lương KPI', 'Bonus', 'Thumb Up', 'Ticket', 'Lương Final'];
    } else if (vm.data.position === 'marketing') {
      additionalHeader = ['Giờ trực', 'Lương trực', 'Lương task', 'Bonus', 'Thumb Up', 'Ticket', 'Lương Final'];
    }

    headers = [...headers, ...additionalHeader, '% lương thực nhận', 'Thưởng thâm niên', 'Lương thực nhận'].join('\t');

    const salaries = _.map(vm.staffs, (staff, index) => {
      let fields = [];

      switch (vm.data.position) {
        case 'sale':
          {
            fields = [index + 1, staff.user.code, staff.outlet.code, staff.user.displayName, staff.rank, roundNumber(staff.hours), roundNumber(staff.resSalary), roundNumber(staff.revSalary), roundNumber(staff.shipSalary), roundNumber(staff.addedSalary), roundNumber(staff.bonus), roundNumber(staff.prizeMoney), roundNumber(staff.fineMoney), roundNumber(staff.finalSalary), roundNumber(staff.salaryPerHour), roundNumber(staff.actualSalaryPercent), roundNumber(staff.repaySalary), roundNumber(staff.actualSalary)];
            break;
          }

        case 'fulltime-ship':
          {
            fields = [index + 1, staff.user.code, staff.user.outlet.code, staff.user.displayName, roundNumber(staff.totalBasicSalary), roundNumber(staff.lunchSupport), staff.numBaseShift, staff.numberShiftBySaleReport, staff.numberShiftSalary - staff.numberShiftBySaleReport, roundNumber(staff.revenueSalary), roundNumber(staff.supportSalary), roundNumber(staff.insurance), roundNumber(staff.prizeMoney), roundNumber(staff.fineMoney), roundNumber(staff.finalSalary), roundNumber(staff.actualSalaryPercent), roundNumber(staff.repaySalary), roundNumber(staff.actualSalary) || roundNumber(staff.finalSalary)];
            break;
          }

        case 'parttime-ship':
          {
            fields = [index + 1, staff.user.code, staff.user.outlet.code, staff.user.displayName, staff.rank, roundNumber(staff.hours), roundNumber(staff.resSalary), roundNumber(staff.revSalary), roundNumber(staff.addedSalary), roundNumber(staff.supportSalary), roundNumber(staff.prizeMoney), roundNumber(staff.fineMoney), roundNumber(staff.finalSalary), roundNumber(staff.salaryPerHour), roundNumber(staff.actualSalaryPercent), roundNumber(staff.repaySalary), roundNumber(staff.actualSalary) || roundNumber(staff.finalSalary)];
            break;
          }

        case 'packing':
          {
            fields = [index + 1, staff.user.code, staff.user.outlet.code, staff.user.displayName, staff.rank, roundNumber(staff.hours), roundNumber(staff.shiftSalary), roundNumber(staff.packingMinutes), roundNumber(staff.packingSalary), roundNumber(staff.productivityPercent * 100), roundNumber(staff.bonus), roundNumber(staff.prizeMoney), roundNumber(staff.fineMoney), roundNumber(staff.finalSalary), roundNumber(staff.salaryPerHour), roundNumber(staff.actualSalaryPercent), roundNumber(staff.repaySalary), roundNumber(staff.actualSalary) || roundNumber(staff.finalSalary)];
            break;
          }

        case 'warehousing':
          {
            fields = [index + 1, staff.user.code, staff.user.outlet.code, staff.user.displayName, staff.rank, roundNumber(staff.salaryPerMinute), roundNumber(staff.buyingMinutes), roundNumber(staff.logisticsMinutes), roundNumber(staff.storingMinutes), roundNumber(staff.scanMinutes), roundNumber(staff.userScanErrorRate * 100), roundNumber(staff.userMissingRestockRate * 100), roundNumber(staff.buyingFactor), roundNumber(staff.logisticsFactor), roundNumber(staff.storingFactor), roundNumber(staff.salaryMinutes), roundNumber(staff.supportSalary), roundNumber(staff.prizeMoney), roundNumber(staff.fineMoney), roundNumber(staff.finalSalary), roundNumber(staff.salaryPerHour), roundNumber(staff.actualSalaryPercent), roundNumber(staff.repaySalary), roundNumber(staff.actualSalary) || roundNumber(staff.finalSalary)];
            break;
          }

        case 'CTV-warehousing':
          {
            fields = [index + 1, staff.user.code, staff.user.outlet.code, staff.user.displayName, roundNumber(staff.buyingHours), roundNumber(staff.logisticsHours), roundNumber(staff.storingHours), roundNumber(staff.buyingSalary), roundNumber(staff.logisticsSalary), roundNumber(staff.storingSalary), roundNumber(staff.prizeMoney), roundNumber(staff.fineMoney), roundNumber(staff.finalSalary), roundNumber(staff.actualSalaryPercent), roundNumber(staff.repaySalary), roundNumber(staff.actualSalary)];
            break;
          }

        case 'order':
          {
            fields = [index + 1, staff.user.code, staff.user.outlet.code, staff.user.displayName, staff.rank, roundNumber(staff.officialHours), roundNumber(staff.resSalary), roundNumber(staff.revSalary), roundNumber(staff.bonus), roundNumber(staff.prizeMoney), roundNumber(staff.fineMoney), roundNumber(staff.finalSalary), roundNumber(staff.salaryPerHour), roundNumber(staff.actualSalaryPercent), roundNumber(staff.repaySalary), roundNumber(staff.actualSalary) || roundNumber(staff.finalSalary)];
            break;
          }

        case 'kitchen':
          {
            fields = [index + 1, staff.user.code, staff.user.outlet.code, staff.user.displayName, staff.rank, roundNumber(staff.hours), roundNumber(staff.rankSalaryPerHour), roundNumber(staff.salaryFactor), roundNumber(staff.numFixedShiftRecord), roundNumber(staff.fixedShiftSalary), roundNumber(staff.supportSalary), roundNumber(staff.prizeMoney), roundNumber(staff.fineMoney), roundNumber(staff.finalSalary), roundNumber(staff.salaryPerHour), roundNumber(staff.actualSalaryPercent), roundNumber(staff.repaySalary), roundNumber(staff.actualSalary) || roundNumber(staff.finalSalary)];
            break;
          }

        case 'hr2-parttime':
          {
            fields = [index + 1, staff.user.code, staff.user.outlet.code, staff.user.displayName, roundNumber(staff.hours), roundNumber(staff.shiftSalary), roundNumber(staff.hrSalary), roundNumber(staff.bonus), roundNumber(staff.prizeMoney), roundNumber(staff.fineMoney), roundNumber(staff.finalSalary), roundNumber(staff.actualSalaryPercent), roundNumber(staff.repaySalary), roundNumber(staff.actualSalary) || roundNumber(staff.finalSalary)];
            break;
          }

        case 'marketing':
          {
            fields = [index + 1, staff.user.code, staff.user.outlet.code, staff.user.displayName, roundNumber(staff.hours), roundNumber(staff.shiftSalary), roundNumber(staff.marketingSalary), roundNumber(staff.bonus || 0), roundNumber(staff.prizeMoney), roundNumber(staff.fineMoney), roundNumber(staff.finalSalary), roundNumber(staff.actualSalaryPercent), roundNumber(staff.repaySalary), roundNumber(staff.actualSalary) || roundNumber(staff.finalSalary)];
            break;
          }

        default:
          fields = [];
      }

      return fields.join('\t');
    });

    vm.data.salaryTSV = headers + '\n' + salaries.join('\n');
    const copyText = $window.document.getElementById('salaryTSV');
    $timeout(() => {
      /* Select the text field */
      copyText.select();
      /* Copy the text inside the text field */

      $window.document.execCommand('copy');
      FhdMessenger.success('Đã copy');
    }, 2000);
  };
}]);
"use strict";

/* eslint-disable angular/controller-as */
angular.module('users').controller('SettingsController', ['$scope', '$http', '$location', 'Users', 'Authentication', '$localStorage', '$window', '$rootScope', '$state', 'FhdMessenger', 'UserService', 'Address', function ($scope, $http, $location, Users, Authentication, $localStorage, $window, $rootScope, $state, FhdMessenger, UserService, Address) {
  const vm = this;
  vm.districts = Address.getDistricts();
  vm.user = Authentication.user;
  vm.openModalCreateRetireRequest = UserService.openModalCreateRetireRequest;
  vm.disabledAddress = vm.user.address || false;
  vm.disabledCollage = vm.user.college || false;
  vm.disabledGraduationYear = vm.user.graduationYear || false;
  vm.data = {};
  vm.data.college = vm.user.college || null;

  vm.checkPersonalInformationStatus = () => {
    if (vm.user.informationStatus === 'unconfirmed') {
      vm.openModalUpdatePersonalInformation();
    }
  };

  vm.openModalUpdatePersonalInformation = UserService.openModalUpdatePersonalInformation; // If user is not signed in then redirect back home

  if (!vm.user) $location.path('/'); // Check if there are additional accounts

  vm.hasConnectedAdditionalSocialAccounts = function (provider) {
    for (var i in vm.user.additionalProvidersData) {
      return true;
    }

    return false;
  }; // Check if provider is already in use with current user


  vm.isConnectedSocialAccount = function (provider) {
    return vm.user.provider === provider || vm.user.additionalProvidersData && vm.user.additionalProvidersData[provider];
  }; // Remove a user social account


  vm.removeUserSocialAccount = function (provider) {
    vm.success = vm.error = null;
    $http.delete('/users/accounts', {
      params: {
        provider: provider
      }
    }).success(function (response) {
      // If successful show success message and clear form
      vm.success = true;
      vm.user = Authentication.user = response;
    }).error(function (response) {
      vm.error = response.message;
    });
  }; // Update a user profile


  vm.updateUserProfile = function () {
    vm.user.college = vm.data.college;
    const user = new Users(vm.user);
    vm.waiting = true;
    user.$updateProfile(function (response) {
      vm.success = true;
      Authentication.user = response;
    }, function (response) {
      vm.error = response.data.message;
    }).finally(() => {
      vm.waiting = false;
    });
  }; // Change user password


  vm.changeUserPassword = function () {
    vm.success = vm.error = null;
    $http.post('/users/password', vm.passwordDetails).success(function (response) {
      $localStorage.setObject('needChangePassword', false);
      $rootScope.hideMenu = false; // If successful show success message and clear form

      vm.success = true;
      vm.passwordDetails = null;
      $state.go('home');
      FhdMessenger.success('Đổi mật khẩu thành công.');
    }).error(function (response) {
      vm.error = response.message;
    });
  };
}]);
"use strict";

angular.module('users').controller('UpdateRankUsersController', ['FhdMessenger', 'Users', function (FhdMessenger, Users) {
  const vm = this;
  vm.isLoading = false;
  vm.users = [];
  vm.placeholder = `code    rank\nE01   A4\nE02   A5`;

  vm.submit = () => {
    if (vm.users.length === 0) {
      return FhdMessenger.error('Bạn chưa điền danh sách nhân viên !');
    }

    const isCorrectFormat = !_.some(vm.users, user => {
      return !user.code || !user.rank;
    });

    if (!isCorrectFormat) {
      return FhdMessenger.error('Phát hiện dòng không có code hoặc rank !');
    }

    const promise = Users.updateRankUsers({
      users: vm.users
    }).$promise.then(res => {
      vm.isLoading = true;
      FhdMessenger.success(`Đã update rank thành công ${vm.users.length} Users`);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    });
    FhdMessenger.notifyLoading('Đang update rank', promise);
  };
}]);
'use strict'; // Rank a points controller

angular.module('rank-a-points').controller('UserRankAPointsController', ['$stateParams', '$location', '$http', 'Authentication', 'RankAPoints', 'FhdMessenger', 'RankAPointService', 'ThumbUpService', '$state', 'UserService', function ($stateParams, $location, $http, Authentication, RankAPoints, FhdMessenger, RankAPointService, ThumbUpService, $state, UserService) {
  const vm = this;
  vm.authentication = Authentication;

  vm.init = function () {
    vm.ranks = UserService.getAvailableRanks();
  };

  vm.findUserRank = function () {
    $http.get(`/rank-a-points/users/${$stateParams.userId}/summary-points`).then(function (response) {
      const data = response.data;
      vm.staff = response.data.user;
      vm.staff._id = $stateParams.userId;
      vm.points = vm.staff.points || 0;

      const currentRankIndex = _.findLastIndex(vm.ranks, function (rank) {
        return vm.points >= rank.point;
      });

      vm.currentRank = vm.ranks[currentRankIndex];

      if (currentRankIndex < vm.ranks.length - 1) {
        vm.nextRank = vm.ranks[currentRankIndex + 1];
      }

      const entries = data.entries;
      vm.addPointEntries = _.filter(entries, {
        isMinus: false
      });
      vm.minusPointEntries = _.filter(entries, {
        isMinus: true
      });
    }, function (response) {
      const data = response.data;
      FhdMessenger.errorFromServer(data);
    });
    $http.get(`/users/${$stateParams.userId}/stickets`).then(function (response) {
      vm.tickets = _.filter(response.data, ticket => {
        return ['done', 'complainted'].includes(ticket.status);
      });
      vm.deletedTickets = _.filter(response.data, ticket => {
        return ['deleted'].includes(ticket.status);
      });

      _.forEach(vm.tickets, function (ticket) {
        ticket.content = _.truncate(ticket.content, 80);
      });
    });
    $http.get(`/users/${$stateParams.userId}/thumb-ups`).then(function (response) {
      vm.thumbUps = response.data;
      vm.totalThumbUpTickets = Math.floor(vm.thumbUps.length / 3);
    }); // $http.get(`/users/${$stateParams.userId}/backup-stickets`).then(function(response) {
    //   vm.backUpTickets = response.data
    // })

    $http.get(`/users/${$stateParams.userId}/support-salaries`).then(function (response) {
      vm.supportSalaries = response.data;
    });
    $http.get('/papers', {
      params: {
        userId: $stateParams.userId
      }
    }).then(function (response) {
      vm.papers = _.filter(response.data, paper => {
        if (angular.isUndefined(_.get(paper, 'isPass'))) return false;
        return true;
      });
    });
    $http.get(`/users/${$stateParams.userId}/over-time-shifts`).then(function (response) {
      vm.overShifts = response.data;
    });
  };

  vm.viewRankAPoint = RankAPointService.viewRankAPointModal;
  vm.addRankAPoint = RankAPointService.addRankAPointModal;

  vm.addThumbUps = function (userId) {
    ThumbUpService.addThumbUpModal(userId).then(() => {
      $state.reload();
    });
  };
}]);
"use strict";

angular.module('users').controller('UsersProductivityController', ['UsersProductivity', 'NgTableParams', 'FhdMessenger', function (UsersProductivity, NgTableParams, FhdMessenger) {
  const vm = this;
  vm.usersProductivityTable = new NgTableParams({
    count: 100
  });

  vm.find = () => {
    vm.usersProductivity = UsersProductivity.query({
