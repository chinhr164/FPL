angular.module('users').factory('UserAccounts', ['$resource', 'FhdMessenger', '$http', function ($resource, FhdMessenger, $http) {
  var all = $resource('users/all', {}, {
    switch: {
      method: 'POST',
      url: '/users/switch'
    }
  });
  var notices = $resource('my-notices/:noticeId', {
    noticeId: '@_id'
  }, {
    read: {
      method: 'PUT'
    }
  });
  return {
    progress: function () {
      return $resource('users/progress', {}, {});
    },

    listDisabledUsers(outlets) {
      return $http.get('users/disabled-users', {
        params: outlets
      }).then(response => response.data).catch(FhdMessenger.errorFromServer);
    },

    all: all,
    Notices: notices,
    list: () => $http.get('users/rank-a-points').then(response => response.data).catch(FhdMessenger.errorFromServer)
  };
}]);
'use strict';

angular.module('users').factory('UserService', ['$http', '$q', '$modal', 'OutletService', 'Authentication', 'ngDexie', 'ngStore', 'FhdMessenger', 'Roles', '$rootScope', 'Users', function ($http, $q, $modal, OutletService, Authentication, ngDexie, ngStore, FhdMessenger, Roles, $rootScope, Users) {
  let staffs = [];
  let staffsDefered;
  let includeDeletedQuery;
  let initialSync;
  let roleQuery;
  let roles;
  let roleMap;
  let roleHideMap;
  let roleWithTypes;

  function processRole(_roles) {
    roles = _.map(_roles, role => {
      role.id = role.roleId;
      return role;
    });
    roleMap = _.reduce(roles, (result, role) => {
      result[role.id] = false;
      return result;
    }, {});
    roleHideMap = _.reduce(roles, (result, role) => {
      result[role.id] = role.hideWithoutAdmin;
      return result;
    }, {});
    roleWithTypes = [{
      id: 'rank',
      label: 'Rank',
      roles: _.filter(roles, {
        type: 'rank'
      })
    }, {
      id: 'type',
      label: 'Type',
      roles: _.filter(roles, {
        type: 'type'
      })
    }, {
      id: 'features',
      label: 'Features',
      roles: _.filter(roles, {
        type: 'features'
      })
    }, {
      id: 'positions',
      label: 'Positions',
      roles: _.filter(roles, {
        type: 'positions'
      })
    }];
  }

  function loadRole() {
    return Roles.availables().$promise.then(roles => {
      return processRole(roles);
    });
  }

  const ranks = [{
    point: 0,
    rank: 'A1',
    salaryPercentage: 8
  }, {
    point: 100,
    rank: 'A2',
    salaryPercentage: 9
  }, {
    point: 300,
    rank: 'A3',
    salaryPercentage: 10
  }, {
    point: 1000,
    rank: 'A4',
    salaryPercentage: 11
  }, {
    point: 2000,
    rank: 'A5',
    salaryPercentage: 12
  }, {
    point: 3500,
    rank: 'A6',
    salaryPercentage: 13
  }, {
    point: 8000,
    rank: 'A7'
  }, {
    point: 15000,
    rank: 'A8'
  }];

  function addFullDescription(staffs) {
    return _.map(staffs, function (staff) {
      const _staff = _.cloneDeep(staff);

      if (_staff.outlet && !_staff.outlet.name) {
        _staff.outlet = OutletService.getFromId(_staff.outlet);
      }

      _staff.fullDescription = (_staff.code ? `${_staff.code} - ` : '') + _staff.displayName + ' - ' + _.get(staff, 'outlet.code', '');
      return _staff;
    });
  }

  function clearLocalSettings(all) {
    ngStore.remove('staffsUpdated');
    ngStore.remove('staffs');
    ngStore.remove('loadedStaffs');

    if (all) {
      if (ngDexie.getDb().staffs) {
        ngDexie.getDb().staffs.clear();
      }
    }
  }

  function syncStaffsFromServer() {
    if (!Authentication.user) return $q.when(null);
    const localStaffsUpdated = ngStore.get('staffsUpdated');
    const loadedStaffs = ngStore.get('loadedStaffs');
    let staffsUpdated = localStaffsUpdated && moment(localStaffsUpdated).isValid() ? moment(localStaffsUpdated).valueOf() : null;

    if (!loadedStaffs || !_.isNumber(staffsUpdated)) {
      clearLocalSettings();
      return $q.when(null); // Lưu ý hàm này luôn trả về 1 promise để còn .then được dù thế nào đi chăng nữa
    }

    return Users.getUpdatedStaffs({
      date: staffsUpdated
    }).$promise.then(_staffs => {
      const promises = [];

      if (_staffs && _staffs.length) {
        FhdMessenger.success(`Cập nhật thành công ${_staffs.length} nhân viên từ máy chủ!`);

        if (loadedStaffs) {
          promises.push(ngDexie.getDb().staffs.bulkPut(_staffs).then(() => {
            $rootScope.$apply();
            $rootScope.$broadcast('staffsUpdated', _staffs);
            staffs = addFullDescription(_staffs);
          }));
        }

        const deletedStaffs = _.filter(_staffs, staff => staff.roles.includes('deleted'));

        if (deletedStaffs && deletedStaffs.length) {
          const deletedIds = _.map(deletedStaffs, '_id');

          promises.push(ngDexie.getDb().staffs.bulkDelete(deletedIds));
        }

        saveMaxUnixUpdated(_staffs);
      }

      return $q.all(promises);
    }).catch(() => {
      // Cứ có lỗi thì đảm bảo dữ liệu clean và bắt buộc các hàm load allAsync() và essentialProductsAsync()
      // sẽ gọi dữ liệu từ server
      FhdMessenger.error('Có lỗi khi tải DSNV cập nhật. Sẽ tải lại từ đầu.');
      clearLocalSettings();
    });
  }

  function saveMaxUnixUpdated(staffs) {
    const maxUnixUpdated = Math.max(..._.map(staffs, staff => {
      const value = staff.unixUpdated && moment(staff.unixUpdated).isValid() ? moment(staff.unixUpdated).valueOf() : null;
      return value;
    }));

    if (staffs && staffs.length && moment(maxUnixUpdated).isValid()) {
      ngStore.set('staffsUpdated', maxUnixUpdated);
    }
  }

  function initInitialSync() {
    if (!initialSync) {
      initialSync = syncStaffsFromServer();
    }

    return initialSync;
  }

  function loadStaffs(resolve, reject) {
    FhdMessenger.info('Bắt đầu tải Full DSNV từ máy chủ và lưu vào bộ nhớ. Xin vui lòng đợi trong giây lát...');
    return $http.get('/users/staffs').success(function (_staffs) {
      ngDexie.getDb().staffs.clear().then(() => ngDexie.getDb().staffs.bulkAdd(_staffs)).then(() => {
        ngStore.set('loadedStaffs', true);
        $rootScope.$apply();
        staffs = addFullDescription(_staffs);
        saveMaxUnixUpdated(_staffs);
        resolve(staffs);
      }).catch(err => {
        FhdMessenger.error(err.message);
        throw err;
      });
    }).error(function (errorRespond) {
      reject(errorRespond);
    });
  }

  function load() {
    staffsDefered = $q(function (resolve, reject) {
      const staffsUpdated = ngStore.get('staffsUpdated');
      const loadedStaffs = ngStore.get('loadedStaffs');

      if (_.isNumber(staffsUpdated) && loadedStaffs) {
        ngDexie.list('staffs').then(_staffs => {
          if (!_staffs || !_staffs.length) {
            loadStaffs(resolve, reject);
          } else {
            staffs = addFullDescription(_staffs);
            resolve(staffs);
          }
        });
      } else {
        loadStaffs(resolve, reject);
      }
    });
  }

  function allStaffs(callback) {
    initInitialSync().then(() => {
      if (!staffsDefered) load();
      staffsDefered.then(function () {
        callback(null, staffs);
      }, function (err) {
        load();
        callback(err);
      });
    });
  }

  function includeDeleted(callback) {
    if (!includeDeletedQuery) {
      includeDeletedQuery = Users.includeDeleted();
    }

    return includeDeletedQuery.$promise.then(staffs => {
      const _staffs = addFullDescription(staffs);

      callback(null, _staffs);
    });
  }

  function openViewUserModal(userId) {
    return $modal.open({
      templateUrl: '/modules/users/views/user/modal-view-user.client.view.html',
      controller: 'ModalViewUserController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        userId: () => userId
      }
    });
  }

  function openUniformReceivedModal(userId) {
    return $modal.open({
      templateUrl: '/modules/users/views/user/modal-uniform-received.client.view.html',
      controller: 'ModalUniformReceivedController',
      controllerAs: 'vm',
      resolve: {
        userId: () => userId
      }
    });
  }

  function openUpdateBaseSalaryUserModal(userId) {
    return $modal.open({
      templateUrl: '/modules/users/views/user/modal-update-base-salary.client.view.html',
      controller: 'ModalUpdateBaseSalaryUserController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        userId: () => userId
      }
    });
  }

  function openEditUserModal(userId) {
    return $modal.open({
      templateUrl: '/modules/users/views/user/modal-edit-user.client.view.html',
      controller: 'ModalEditUsersController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        userId: () => userId
      }
    });
  }

  function openCreateStoryModal() {
    return $modal.open({
      templateUrl: '/modules/users/views/account/modal-create-story.client.view.html',
      controller: 'ModalCreateStoryController',
      controllerAs: 'vm',
      size: 'lg',
      backdrop: 'static'
    });
  }

  function openEditStoryModal(story) {
    return $modal.open({
      templateUrl: '/modules/users/views/account/modal-edit-story.client.view.html',
      controller: 'ModalEditStoryController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        story: () => story
      }
    });
  }

  function openModalCreateRetireRequest() {
    return $modal.open({
      templateUrl: '/modules/users/views/user/modal-create-retire-request.client.view.html',
      controller: 'ModalCreateRetireRequestController',
      controllerAs: 'vm',
      size: 'lg'
    });
  }

  function openModalAssessUser(user) {
    return $modal.open({
      templateUrl: '/modules/users/views/user/modal-assess-user.client.view.html',
      controller: 'ModalAssessUserController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        user: () => user
      }
    });
  }

  function openModalViewAssessUser(assess) {
    return $modal.open({
      templateUrl: '/modules/users/views/user/modal-view-assess-user.client.view.html',
      controller: 'ModalViewAssessUserController',
      controllerAs: 'vm',
      size: 'lg',
      resolve: {
        assess: () => assess
      }
    });
  }

  function openModalDisableUser(user) {
    return $modal.open({
      templateUrl: '/modules/users/views/account/modal-confirm-disable-user.client.view.html',
      controller: 'ModalDisableUserController',
      controllerAs: 'vm',
      size: 'md',
      resolve: {
        user: () => user
      }
    }).result;
  }

  function openSolveRetireRequest(user) {
    return $modal.open({
      templateUrl: '/modules/users/views/user/modal-solve-retire-request.client.view.html',
      controller: 'ModalSolveRetireRequestController',
      controllerAs: 'vm',
      size: 'md',
      resolve: {
        user: () => user
      }
    });
  }

  function openModalUpdatePersonalInformation() {
    return $modal.open({
      templateUrl: '/modules/users/views/account/modal-update-personal-infomation.client.view.html',
      controller: 'ModalUpdatePersonalInformationController',
      controllerAs: 'vm',
      size: 'lg'
    });
  }

  function addNoneOption(staffs) {
    const _staffs = _.cloneDeep(staffs);

    _staffs.push({
      code: null,
      fullDescription: 'Không có'
    });

    return _staffs;
  }

  function generateStaffsFromIds(ids) {
    return _.map(ids, function (id) {
      return _.find(staffs, {
        _id: id
      }) || id;
    });
  }

  return {
    clearLocalSettings,
    loadStaffs,
    includeDeleted,
    allStaffs,

    allStaffsAsync() {
      if (!staffsDefered) load();
      return staffsDefered;
    },

    load,

    allStaffsWithNoneOption(callback) {
      allStaffs(function (err, staffs) {
        if (err) return callback(err);
        return callback(null, addNoneOption(staffs));
      });
    },

    getFromId(id, _staffs) {
      if (!_staffs) _staffs = staffs;
      if (!_staffs.length) return null;
      return _.find(_staffs, {
        _id: id
      });
    },

    getRoleMap() {
      if (!roleQuery) {
        roleQuery = loadRole();
      }

      return roleQuery.then(() => {
        return roleMap;
      });
    },

    getRolesInTypes() {
      if (!roleQuery) {
        roleQuery = loadRole();
      }

      return roleQuery.then(() => {
        return roleWithTypes;
      });
    },

    getRoleHideMap() {
      if (!roleQuery) {
        roleQuery = loadRole();
      }

      return roleQuery.then(() => {
        return roleHideMap;
      });
    },

    addFullDescription,
    generateStaffsFromIds,
    openModalCreateRetireRequest,
    openViewUserModal,
    openUniformReceivedModal,
    openEditUserModal,
    openModalAssessUser,
    openCreateStoryModal,
    openEditStoryModal,
    openModalViewAssessUser,
    openUpdateBaseSalaryUserModal,
    openModalUpdatePersonalInformation,
    openSolveRetireRequest,
    openModalDisableUser,

    getCode(code) {
      return $http.get('/users/get-code', {
        params: {
          code
        }
      }).then(response => {
        return response.data.code;
      }).catch(function (error) {
        FhdMessenger.errorFromServer(error); // eslint-disable-line
      });
    },

    getAssessUsers(startDate, endDate, filterByDate) {
      return $http.get(`/assess-users?startDate=${startDate}&endDate=${endDate}&filterByDate=${filterByDate}`).then(response => {
        return response.data;
      }).catch(function (error) {
        console.log(error); // eslint-disable-line
      });
    },

    getAvailableRanks: () => ranks,
    getTotalProductionTime: (startDate, endDate) => {
      const paramStartDate = moment(startDate).format('YYYY-MM-DD');
      const paramEndDate = moment(endDate).format('YYYY-MM-DD');
      const user = Authentication.user;
      return $http.get(`/users/${user._id}/production-time`, {
        params: {
          startDate: paramStartDate,
          endDate: paramEndDate
        }
      }).then(response => response.data);
    },
    getUserInfo: cellphone => {
      return $http.get(`/users/getUserInfo`, {
        params: {
          cellphone
        }
      }).then(response => response.data);
    },
    getRewardAndPunishment: () => {
      return $http.get(`/users/get-user-reward-and-punishment`, {}).then(response => response.data);
    },

    getLogisticsKPIsByUser(user) {
      return $http.put('/reports/logistics-kpis-by-user', {
        user: user._id
      }).then(response => response.data);
    },

    getMyRetireRequests() {
      return $http.get('/users/retire-requests', {
        params: {
          isMy: true
        }
      }).then(response => response.data);
    },

    getRoles() {
      return roles;
    },

    getUniformTypes() {
      return [{
        name: 'Tạp dề Abby',
        value: 'apronAbby'
      }, {
        name: 'Tạp dề Savor',
        value: 'apronSavor'
      }, {
        name: 'Tạp dề Trợ lý',
        value: 'apronAssistant'
      }, {
        name: 'Bảng tên Abby',
        value: 'nameplateAbby'
      }, {
        name: 'Mũ Bếp',
        value: 'kitchenHat'
      }, {
        name: 'Mũ Đóng gói',
        value: 'packingHat'
      }, {
        name: 'Áo gile Kho',
        value: 'warehouseShirt'
      }, {
        name: 'Tạp dề Bếp',
        value: 'kitchenApron'
      }];
    },

    getCalculateSalaryTypes() {
      return [{
        wage: 0,
        isCalculateSalary: false,
        eliminatedReasons: ['Đơn phương nghỉ việc (không đi thử việc, bỏ khi đang thử việc)', 'Nghỉ ngang sau khi lên chính thức', 'Đã nghỉ, đã nhận đủ lương nhưng chưa khóa TK', 'Đã viết đơn xin nghỉ nhưng nghỉ trước thời hạn', 'Lọc hồ sơ không đạt yêu cầu', 'Ứng viên không đến phỏng vấn', 'Ứng viên không đến học việc', 'Ứng viên không đến thử việc', 'Ứng viên xin thôi', 'Không qua vòng phỏng vấn', 'Không qua vòng học việc', 'Không nghe máy nhiều lần (>3)', 'Cơ sở dừng tuyển - không offer được - hẹn cơ hội khác']
      }, {
        wage: 85,
        eliminatedReasons: ['Loại trong thời gian thử việc - Áp dụng với Fulltime', 'Loại trong sau thời gian thử việc - Áp dụng với Fulltime'],
        isCalculateSalary: true
      }, {
        wage: 100,
        eliminatedReasons: ['Nhân viên đang đi làm nhưng nghỉ gấp có lý do chính đáng (được xác thực) VD: bị tai nạn', 'Đã viết đơn xin nghỉ, đúng thời hạn và được duyệt', 'Team Training cho thôi việc', 'Loại trong thời gian thử việc', 'Loại sau thời gian thử việc', 'Quản lý cho thôi việc'],
        isCalculateSalary: true
      }].map(function (caculateSalaryType) {
        caculateSalaryType.eliminatedReasons.sort((a, b) => {
          return a.localeCompare(b);
        });
        return caculateSalaryType;
      });
    },

    getActiveStaffsByOutlet(outletCode) {
      return Users.getActiveUsersByOutlet({
        outletCode
      }).$promise.then(staffs => {
        return staffs;
      });
    }

  };
}]);
