angular.module('staff-salary-monthly-reports').component('fulltimeShipSalaryTable', {
  templateUrl: '/modules/staff-salary-monthly-reports/templates/fulltime-ship-salary-table.client.template.html',
  bindings: {
    salaryData: '='
  },
  controllerAs: 'vm',
  controller: ['SalaryTable', function (SalaryTable) {
    const vm = this;
    vm.doc = vm.salaryData;
    vm.doc.lunchSupport = _.find(vm.doc.listSupportSalaries, {
      content: 'Phụ cấp ăn trưa'
    });
    vm.doc.listSupportSalaries = _.reject(vm.doc.listSupportSalaries, {
      content: 'Phụ cấp ăn trưa'
    });
    vm.doc.saleEntries = _.map(vm.doc.saleEntries, saleEntry => {
      const salaryPercent = Number(vm.doc.revenueSalaryPercent);
      const combinedSaleEntry = saleEntry;
      combinedSaleEntry.revenueSalary = saleEntry.revenueByStep * salaryPercent / 100;
      return combinedSaleEntry;
    });

    vm.viewTickets = () => {
      SalaryTable.viewTickets(vm.doc);
    };

    vm.viewBonuses = () => {
      SalaryTable.viewBonuses(vm.doc);
    };

    vm.viewThumbUps = () => {
      SalaryTable.viewThumbUps(vm.doc);
    };

    vm.viewShifts = () => {
      SalaryTable.viewShifts(vm.doc);
    };

    vm.viewSaleEntry = () => {
      SalaryTable.viewSaleEntries(vm.doc);
    };
  }]
});
