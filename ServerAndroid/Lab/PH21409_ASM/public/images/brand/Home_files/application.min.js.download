    openDetailCartonEntryModal(cartonEntry) {
      return $modal.open({
        templateUrl: 'modules/carton-entries/views/modal-detail-carton-entry.client.view.html',
        controller: 'ModalDetailCartonEntryController',
        controllerAs: 'vm',
        resolve: {
          cartonEntry: () => cartonEntry
        }
      }).result;
    },

    openDeleteCartonEntryModal(cartonEntry) {
      return $modal.open({
        templateUrl: 'modules/carton-entries/views/modal-delete-carton-entry.client.view.html',
        controller: 'ModalDeleteCartonEntryController',
        controllerAs: 'vm',
        resolve: {
          cartonEntry: () => cartonEntry
        }
      }).result;
    }

  };
}]);
