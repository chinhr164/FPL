  $scope.$watch(function () {
    return $scope.chartData;
  }, function (newValue, oldValue) {
    if (newValue === oldValue) return;
    $scope.dataset = [_.map($scope.chartData, $scope.valueName || 'value')];
    $scope.labels = _.map($scope.chartData, function (item) {
      var result = '';

      _.forEach(item[$scope.labelName || 'mode'], function (attr) {
        result = result ? result + '-' + attr.toString() : result + attr.toString();
      });

      return result;
    });
  });
  $scope.series = ['All dimensions'];
}]);
