angular.module('licenses').factory('InvoicesService', ['$modal', 'helper', 'LicenseTypes', function ($modal, helper, LicenseTypes) {
  const supplierTypes = ['Savor', 'Vendor', 'D2'].map(d => {
    return {
      id: d,
      title: d
    };
  });
  return {
    openViewInvoiceFileModal(files, name) {
      return $modal.open({
        templateUrl: 'modules/invoices/templates/modal-view-invoice-files.client.view.html',
        controller: 'ModalViewInvoiceFilesController',
        controllerAs: 'vm',
        resolve: {
          files: () => files,
          name: () => name
        }
      });
    },

    getSupplierTypes: () => supplierTypes,
    validate: function (invoice) {
      if (!invoice.code) {
        return 'Bạn chưa nhập mã giấy tờ';
      }

      if (!invoice.supplierType) {
        return 'Bạn chưa chọn kiểu đối tượng';
      }

      if (invoice.supplierType === 'Vendor' && !invoice.vendor) {
        return 'Bạn chưa chọn vendor cho hóa đơn';
      }

      if (!invoice.startDate) {
        return 'Chưa có ngày bắt đầu';
      }

      if (!invoice.endDate) {
        return 'Chưa có ngày kết thúc';
      }

      if (!invoice.outlet) {
        return 'Bạn chưa chọn cơ sở cho hóa đơn';
      }

      if (!_.get(invoice, 'products.length')) {
        return 'Bạn chưa chọn sản phẩm nào cho hóa đơn';
      }

      return false;
    }
  };
}]);
"use strict";

