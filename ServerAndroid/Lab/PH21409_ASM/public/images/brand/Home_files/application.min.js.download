angular.module('buying-entries').controller('ArrivingBuyingEntriesController', ['$location', '$state', '$window', 'Authentication', 'BuyingEntries', 'BuyingEntryService', 'OutletService', 'CalendarEntryService', 'CurrentShift', 'FhdMessenger', 'NgTableParams', 'ShiftEntryService', function ($location, $state, $window, Authentication, BuyingEntries, BuyingEntryService, OutletService, CalendarEntryService, CurrentShift, FhdMessenger, NgTableParams, ShiftEntryService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.currentShift = CurrentShift.getCurrentShift();
  vm.destination = vm.currentShift.outlet;
  vm.buyingEntriesTable = new NgTableParams({
    count: 100
  });

  if (!vm.currentShift.created && !_.intersection(vm.user.roles, ['admin', 'accountant', 'tro-ly-sx', 'tro-ly', 'flexi-time', 'purchaser', 'probation-purchaser', 'tro-ly-kho']).length) {
    return FhdMessenger.error('Chưa đăng nhập ca trực');
  }

  vm.openNotiProductsNoBeModal = BuyingEntryService.openNotiProductsNoBeModal; // Find a list of Buying entries

  vm.find = function () {
    findArrivingBuyingEntries();
  };

  const outletMap = {
    B3: ['SS'],
    D2: ['SS'],
    B1: ['D3'],
    D8: ['G8'],
    D5: ['G5'],
    D6: ['M6'],
    D4: ['B4', 'G3']
  };

  async function findArrivingBuyingEntries() {
    const destinations = [];

    if (vm.destination) {
      destinations.push(vm.destination._id);
      const destinationCode = vm.destination.code;
      const relativeOutletCodes = outletMap[destinationCode];

      if (_.get(relativeOutletCodes, 'length')) {
        await Promise.each(relativeOutletCodes, async relativeOutletCode => {
          await OutletService.findOutletFromCode(relativeOutletCode).then(outlet => {
            destinations.push(outlet._id);
          });
        });
      }
    }

    vm.updating = true;
    vm.buyingEntries = BuyingEntries.query({
      destinations,
      statuses: ['ordered', 'received'],
      sortByCreated: 'asc',
      limit: 1000
    });
    let promise = vm.buyingEntries.$promise.then(function (buyingEntries) {
      const notReceivedBuyingEntries = _.reject(buyingEntries, buyingEntry => {
        if (buyingEntry.orderItems.length > 0 && _.every(buyingEntry.orderItems, item => {
          if (item.arrivingQuantity === 0) {
            return true;
          }
        })) {
          return true;
        }
      });

      return notReceivedBuyingEntries;
    }).then(notReceivedBuyingEntries => {
      vm.notReceivedBuyingEntries = notReceivedBuyingEntries;
      vm.buyingEntriesTable.settings({
        dataset: notReceivedBuyingEntries
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.updating = false;
    });
    FhdMessenger.notifyLoading('Đang tải danh sách...', promise, () => {
      FhdMessenger.success('Đã tải xong');
    });
  }

  function getIncludesScore(elm1, elm2) {
    return _.includes(_.toUpper(elm1), _.toUpper(elm2)) ? elm2.length : 0;
  }

  vm.search = () => {
    if (vm.searchText) {
      let searchText = vm.searchText.trim();
      let elements = searchText.split(' ');
      elements = _.compact(elements);

      _.forEach(vm.notReceivedBuyingEntries, buyingEntry => {
        let score = _.max(_.map(buyingEntry.orderItems, item => {
          return _.sum(_.map(elements, elm => {
            return getIncludesScore(item.description + ' ' + item.sku, elm);
          }));
        }));

        score += _.sum(_.map(elements, elm => {
          return getIncludesScore(_.get(buyingEntry, 'vendor.name', '') + ' ' + buyingEntry.buyingEntryId.toString(), elm);
        }));

        _.assign(buyingEntry, {
          score
        });
      });

      vm.matchBuyingEntries = _.filter(vm.notReceivedBuyingEntries, buyingEntry => buyingEntry.score > 0);
      vm.buyingEntriesTable.settings({
        dataset: vm.matchBuyingEntries
      });
      vm.buyingEntriesTable.reload();
    } else {
      vm.buyingEntriesTable.settings({
        dataset: vm.notReceivedBuyingEntries
      });
      vm.buyingEntriesTable.reload();
    }
  };
}]);
"use strict";

angular.module('buying-entries').controller('ArrivingChinaItemsController', ['$http', '$scope', '$window', 'Authentication', 'BuyingEntryService', 'ConfirmModal', 'ReportStats', 'NgTableParams', 'FhdMessenger', function ($http, $scope, $window, Authentication, BuyingEntryService, ConfirmModal, ReportStats, NgTableParams, FhdMessenger) {
  const vm = this;
  vm.data = {
    statuses: _.reject(BuyingEntryService.getStatuses(), status => {
      return ['pending', 'cancelled', 'terminated'].includes(status.id);
    }),
    actions: [{
      id: 'order',
      title: 'Chốt nhập'
    }, {
      id: 'change-shop',
      title: 'Tìm shop khác'
    }, {
      id: 'change-price',
      title: 'Đổi giá bán'
    }]
  };
  vm.statusMap = _.reduce(vm.data.statuses, (result, status) => {
    result[status.id] = !!['created', 'ordered', 'received'].includes(status.id);
    return result;
  }, {});

  vm.checkAll = function () {
    _.forEach(vm.arrivingItemsTable.data, item => {
      item.checked = vm.toCheck;
    });
  };

  vm.selectAll = function (field) {
    const map = vm[`${field}Map`];
    let newValue = true;
    if (_.every(map)) newValue = false;

    _.forEach(map, (value, key) => {
      map[key] = newValue;
    });
  };

  $scope.$watch(() => vm.arrivingItemsTable.data, (newItems, oldItems) => {
    if (newItems === oldItems) return;
    vm.totalOrderValue = _.sumBy(newItems, item => {
      return item.orderValue || 0;
    });
  });
  vm.user = Authentication.user;
  vm.isVendor = vm.user.roles.includes('vendor');

  if (vm.isVendor) {
    vm.data.actions = _.reject(vm.data.actions, {
      id: 'change-price'
    });
  }

  vm.arrivingItemsTable = new NgTableParams({
    count: 50
  });

  vm.getArrivingChinaItems = function () {
    const statuses = _.reduce(vm.statusMap, (result, value, status) => {
      if (value) result.push(status);
      return result;
    }, []);

    let startDate;
    let endDate;

    if (vm.searchCreated) {
      startDate = vm.startDate;
      endDate = vm.endDate;
    }

    ReportStats.getArrivingChinaItems({
      statuses,
      startDate,
      endDate
    }).then(items => {
      _.forEach(items, item => {
        item.reorderLinks = _.filter(item.reorderLinks, link => {
          return !!link;
        });
        item.newOrderQuantity = item.orderQuantity;
        item.newOrderCogs = item.orderCogs;
        item.buyingValue = item.buyingQuantity * item.currentCogs;

        if (vm.isVendor && item.action === 'change-price') {
          item.action = 'order';
        }

        vm.calculateOrderValue(item);
        vm.calculateDiffCogs(item);
      });

      vm.arrivingItemsTable.settings({
        dataset: items
      });
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.getActionName = item => {
    const matchAction = _.find(vm.data.actions, {
      id: item.action
    });

    return _.get(matchAction, 'title', 'Chưa rõ');
  };

  vm.removeReorderLinks = (index, item) => {
    item.reorderLinks.splice(index, 1);
    item.updateReorderLink = true;
  };

  vm.inputOrderCogs = item => {
    item.newOrderCogs = _.toNumber($window.prompt('Nhập giá vốn mới'));
    vm.calculateDiffCogs(item);
    vm.calculateOrderValue(item);
  };

  vm.inputNoteForItem = item => {
    item.noteContent = $window.prompt('Nhập ghi chú mới');
    item.updateNote = true;
    item.notes = item.notes || [];
    item.notes.push({
      content: item.noteContent,
      user: vm.user._id
    });
  };

  vm.inputReorderLinkForItem = item => {
    const link = $window.prompt('Nhập link đặt hàng mới');
    item.reorderLinks = item.reorderLinks || [];
    item.reorderLinks.push(link);
    item.updateReorderLink = true;
  };

  vm.addOrderForItem = item => {
    const id = $window.prompt('Nhập mã đơn hàng mới');
    item.orders = item.orders || [];
    item.orders.push({
      id
    });
    item.updateOrders = true;
  };

  vm.inputOrderQuantity = item => {
    item.newOrderQuantity = _.toNumber($window.prompt('Nhập số lượng nhập mới'));
    const noteContent = $window.prompt('Nhập ghi chú lý do sửa số lượng');
    item.noteContent = 'Thay đổi số lượng đặt do: ' + noteContent;
    item.updateNote = true;
    item.notes = item.notes || [];
    item.notes.push({
      content: item.noteContent,
      user: vm.user._id
    });
    vm.calculateOrderValue(item);
  };

  vm.calculateOrderValue = item => {
    const orderQuantity = item.newOrderQuantity || item.orderQuantity;
    const orderCogs = item.newOrderCogs || item.orderCogs;

    if (_.isNumber(orderCogs) && _.isNumber(orderQuantity)) {
      item.orderValue = orderCogs * orderQuantity;
    }
  };

  vm.calculateDiffCogs = item => {
    if (_.isNumber(item.currentCogs)) {
      const orderCogs = item.newOrderCogs || item.orderCogs;
      item.oldProfit = 1 - item.currentCogs / item.price;

      if (_.isNumber(orderCogs)) {
        item.diffCogs = orderCogs - item.currentCogs;
        item.newProfit = 1 - orderCogs / item.price;
        item.diffProfit = item.newProfit - item.oldProfit;
      }
    }
  };

  vm.updateItemInBuyingEntry = item => {
    FhdMessenger.info('Đang cập nhật');
    vm.waiting = true;
    $http.put('/buying-entries/update-item', {
      item
    }).then(res => {
      if (_.get(res, 'data.action')) {
        item.action = _.get(res, 'data.action');
      }

      if (_.get(res, 'data.orderQuantity')) {
        item.orderQuantity = _.get(res, 'data.orderQuantity');
      }

      if (_.get(res, 'data.orderCogs')) {
        item.orderCogs = _.get(res, 'data.orderCogs');
      }

      item.editing = false;
      item.updateNote = false;
      item.updateOrders = false;
      item.updateReorderLink = false;
      FhdMessenger.success('Đã cập nhật thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateItemAction = item => {
    FhdMessenger.info('Đang cập nhật action cho sản phẩm');
    vm.waiting = true;
    item.actionName = vm.getActionName(item);
    $http.put('/buying-entries/update-action-for-items', {
      items: [item]
    }).then(res => {
      if (_.get(res, 'data.action')) {
        item.action = _.get(res, 'data.action');
      }

      item.editingAction = false;
      FhdMessenger.success('Đã cập nhật action thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateActionForItems = action => {
    const checkedItems = _.filter(vm.arrivingItemsTable.data, 'checked');

    if (!checkedItems.length) {
      return FhdMessenger.error('Bạn chưa chọn BE nào');
    }

    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Chuyển thành ${action.title}`,
      bodyText: `Bạn chắc chắn muốn chuyển các sản phẩm đã chọn thành ${action.title}`
    }).then(() => {
      const items = _.map(checkedItems, item => {
        item.action = action.id;
        item.actionName = vm.getActionName(item);
        return item;
      });

      $http.put('/buying-entries/update-action-for-items', {
        items
      }).then(res => {
        if (_.get(res, 'data.action')) {
          _.forEach(checkedItems, item => {
            item.action = _.get(res, 'data.action');
          });
        }

        FhdMessenger.success('Đã cập nhật action thành công');
      }).catch(FhdMessenger.errorFromServer).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.cancelEdit = item => {
    item.editing = false;
    item.updateNote = false;
    item.updateOrders = false;
    item.updateReorderLink = false;
    item.newOrderQuantity = item.orderQuantity;
    item.newOrderCogs = item.orderCogs;
    vm.calculateOrderValue(item);
  };
}]);
"use strict";

angular.module('buying-entries').controller('ArrivingItemsController', ['ReportStats', 'NgTableParams', 'FhdMessenger', 'MooncakeCategories', function (ReportStats, NgTableParams, FhdMessenger, MooncakeCategories) {
  const vm = this;
  vm.mooncakeCategoriesTags = MooncakeCategories.query().$promise.then(xs => _.map(xs, x => ({
    id: x.name,
    title: x.name
  })));
  vm.arrivingItemsTable = new NgTableParams();

  vm.getArrivingItems = function () {
    ReportStats.getArrivingItems().then(products => {
      vm.arrivingItemsTable.settings({
        dataset: products
      });
    }).catch(FhdMessenger.errorFromServer);
  };
}]);
'use strict'; // Buying entries controller

angular.module('buying-entries').controller('BuyingEntriesController', ['$scope', '$stateParams', '$location', '$window', 'Authentication', 'BuyingEntries', 'ConfirmModal', '$http', 'NgTableParams', 'FhdMessenger', '$state', 'BuyingService', 'Vendors', 'BuyingEntryService', 'OutletService', 'PaymentRequestsService', 'ExpenseEntryService', function ($scope, $stateParams, $location, $window, Authentication, BuyingEntries, ConfirmModal, $http, NgTableParams, FhdMessenger, $state, BuyingService, Vendors, BuyingEntryService, OutletService, PaymentRequestsService, ExpenseEntryService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.openModalViewPaymentRequest = PaymentRequestsService.openModalViewPaymentRequest;
  vm.endDate = moment().format('YYYY-MM-DD');
  vm.startDate = moment(vm.endDate).startOf('month').format('YYYY-MM-DD');

  vm.openUpdateDueDateBuyingEntriesModal = function name() {
    const buyingEntries = _.filter(vm.buyingEntriesTable.data, 'checked');

    BuyingEntryService.openUpdateDueDateBuyingEntriesModal(buyingEntries).result.then(() => {
      vm.find();
    });
  };

  vm.openModalCreatePaymentRequest = () => {
    const buyingEntries = _.filter(vm.buyingEntriesTable.data, 'checked');

    PaymentRequestsService.openModalCreatePaymentRequest({
      buyingEntries,
      workTask: null,
      complaint: null
    });
  };

  vm.createExpenseEntry = () => {
    const buyingEntries = _.filter(vm.buyingEntriesTable.data, 'checked');

    ExpenseEntryService.createExpenseEntry(buyingEntries);
  };

  vm.approveBuyingEntries = function name() {
    const buyingEntries = _.filter(vm.buyingEntriesTable.data, 'checked');

    vm.waiting = true;

    if (!_.every(buyingEntries, {
      status: 'pending'
    })) {
      return FhdMessenger.error('Có BE không ở trạng thái pending');
    }

    ConfirmModal.showModal({}, {
      actionButtonText: `Đồng ý`,
      headerText: `Bạn muốn đổi trạng thái các BE này thành Đã tạo?`,
      bodyText: ''
    }).then(() => {
      BuyingEntryService.approveBuyingEntries(buyingEntries).then(buyingEntries => {
        FhdMessenger.success('Cập nhật thành công');
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.orderBuyingEntries = function name() {
    const buyingEntries = _.filter(vm.buyingEntriesTable.data, 'checked');

    vm.waiting = true;

    if (!_.every(buyingEntries, buyingEntry => {
      return ['created', 'pending'].includes(buyingEntry.status);
    })) {
      return FhdMessenger.error('Có BE không ở trạng thái pending hoặc created');
    }

    ConfirmModal.showModal({}, {
      actionButtonText: `Đồng ý`,
      headerText: `Bạn muốn đổi trạng thái các BE này thành Đã đặt?`,
      bodyText: ''
    }).then(() => {
      BuyingEntryService.orderBuyingEntries(buyingEntries).then(buyingEntries => {
        FhdMessenger.success('Cập nhật thành công');
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.cancelBuyingEntries = function name() {
    const buyingEntries = _.filter(vm.buyingEntriesTable.data, 'checked');

    vm.waiting = true;

    if (!_.every(buyingEntries, buyingEntry => {
      return ['created', 'pending', 'ordered'].includes(buyingEntry.status);
    })) {
      return FhdMessenger.error('Có BE không ở trạng thái pending, created hoặc ordered');
    }

    ConfirmModal.showModal({}, {
      actionButtonText: `Đồng ý`,
      headerText: `Bạn muốn đổi trạng thái các BE này thành Hủy?`,
      bodyText: ''
    }).then(() => {
      BuyingEntryService.cancelBuyingEntries(buyingEntries).then(buyingEntries => {
        FhdMessenger.success('Cập nhật thành công');
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.destinations = _.map(selectedOutlets, '_id');
  };

  vm.openViewBuyingNoteForBuyingEntryModal = BuyingEntryService.openViewBuyingNoteForBuyingEntryModal;

  vm.translatePrivateLabel = privateLabel => {
    switch (privateLabel) {
      case 'has_pl':
        return 'PL';

      case 'non_pl':
        return 'No PL';
    }
  };

  vm.init = () => {
    vm.data = {
      statuses: BuyingEntryService.getStatuses(),
      buyingEntryTypes: [{
        title: 'direct',
        id: 'direct',
        className: 'info'
      }, {
        title: 'nondirect',
        id: 'nondirect',
        className: 'default'
      }],
      outlets: [],
      stages: ['arrived', 'created', 'ordered', 'pending'],
      countries: [{
        title: 'Việt Nam',
        id: 'Việt Nam',
        className: 'primary'
      }, {
        title: 'Trung Quốc',
        id: 'Trung Quốc',
        className: 'danger'
      }]
    };
    vm.summary = {};

    if (vm.user.roles.includes('purchaser') || vm.user.roles.includes('probation-purchaser')) {
      if (_.intersection(['buying-entries:view-parttime'], vm.user.roles).length) {
        vm.data.statuses = _.filter(vm.data.statuses, status => {
          if (['created', 'ordered', 'pending'].includes(status.id)) {
            return true;
          }
        });
        vm.data.countries = [{
          title: 'Việt Nam',
          id: 'Việt Nam',
          className: 'primary'
        }];
      }
    } else {
      if (_.intersection(vm.user.roles, ['flexi-time', 'tro-ly-kho']).length) {
        vm.data.statuses = _.filter(vm.data.statuses, status => {
          if (['received', 'arrived'].includes(status.id)) {
            return true;
          }
        });
      }
    } // Build status map


    vm.statusMap = _.reduce(vm.data.statuses, (result, status) => {
      result[status.id] = false;
      return result;
    }, {});
    vm.statusMap.pending = true;
    vm.statusMap.created = true;
    vm.statusMap.ordered = true;
    vm.statusMap.received = true;

    if (vm.user.roles.includes('purchaser') || vm.user.roles.includes('probation-purchaser')) {
      if (_.intersection(['buying-entries:view-parttime'], vm.user.roles).length) {
        vm.statusMap.received = false;
      }
    }

    if (vm.user.roles.includes('admin') || vm.user.roles.includes('accountant')) {
      vm.data.forPurchaser = false;
    }

    if (vm.user.roles.includes('accountant')) {
      vm.statusMap.arrived = true;
      vm.statusMap.created = false;
      vm.statusMap.ordered = false;
      vm.statusMap.received = false;
    } // Build buyingEntryType map


    vm.buyingEntryTypeMap = _.reduce(vm.data.buyingEntryTypes, (result, buyingEntryType) => {
      result[buyingEntryType.id] = true;
      return result;
    }, {});
    vm.complaintStatusesMap = _.reduce(vm.data.complaintStatuses, (result, status) => {
      result[status.id] = false;
      return result;
    }, {}); // Build country map

    vm.countryMap = _.reduce(vm.data.countries, (result, country) => {
      result[country.id] = true;
      return result;
    }, {}); // Build buying entries table

    vm.buyingEntriesTable = new NgTableParams({
      count: 100
    });
  };

  $scope.$watch(() => vm.buyingEntriesTable.data, (newBuyingEntries, oldBuyingEntries) => {
    if (newBuyingEntries === oldBuyingEntries) return;
    vm.totalBuyingValue = _.reduce(newBuyingEntries, (result, buyingEntry) => result + buyingEntry.totalBuyingValue || 0, 0);
  });

  vm.exportEmail = function (type) {
    vm.checkedBuyingEntries = _.sortBy(_.map(_.filter(vm.buyingEntriesTable.data, 'checked'), buyingEntry => {
      return {
        destination: buyingEntry.destination,
        assistantContent: buyingEntry.assistantContent,
        vendor: buyingEntry.vendor,
        items: type === 'vendor' ? buyingEntry.orderItems : buyingEntry.items
      };
    }), 'vendor.code');
    vm.emailParagraph = _.map(vm.checkedBuyingEntries, buyingEntry => {
      const destination = `Giao đến: ${buyingEntry.destination.name}
Địa chỉ: ${buyingEntry.destination.address} - SĐT: ${buyingEntry.destination.phone}
Quản lý: ${buyingEntry.assistantContent}
`;

      const items = _.map(buyingEntry.items, item => {
        let productInfo = `${item.description} x ${item.buyingQuantity}`;

        if (item.sku.match(/LB\d+/) && item.product.reorderLinks.length) {
          const labelFile = item.product.reorderLinks.join('\n');
          productInfo += `\n+ file: ${labelFile}`;
        }

        return productInfo;
      }).join('\n');

      return `${destination}
${items}\n`;
    }).join('\n');
  };

  function getDeadlineLabelForBuyingEntryDeadline(buyingEntry) {
    if (!buyingEntry.dueDate || buyingEntry.status !== 'ordered') {
      return;
    }

    if (moment(moment(buyingEntry.dueDate).endOf('day')).isBefore(moment())) {
      buyingEntry.dueDateLabel = 'danger';
    }
  } // Find a list of Buying entries


  vm.find = function () {
    const statuses = _.reduce(vm.statusMap, (result, value, status) => {
      if (value) result.push(status);
      return result;
    }, []);

    const countries = _.reduce(vm.countryMap, (result, value, country) => {
      if (value) result.push(country);
      return result;
    }, []);

    const buyingEntryTypes = _.reduce(vm.buyingEntryTypeMap, (result, value, buyingEntryType) => {
      if (value) result.push(buyingEntryType);
      return result;
    }, []); // let limit
    // if (vm.user.roles.includes('accountant')) {
    //   limit = 100
    // }


    FhdMessenger.info('Đang tìm...');
    vm.waiting = true;
    vm.buyingEntries = BuyingEntries.query({
      statuses,
      countries,
      destinations: vm.destinations,
      buyingEntryTypes,
      searchText: vm.searchText // limit,

    });
    vm.buyingEntries.$promise.then(buyingEntries => {
      _.forEach(buyingEntries, buyingEntry => {
        const vendor = _.get(buyingEntry, 'vendor') || {};
        buyingEntry.vendor = vendor;
        buyingEntry.vendor.fullDescription = `${_.get(vendor, 'code', '')} - ${_.get(vendor, 'name', '')}`;
      });

      FhdMessenger.success(`Tìm thấy ${buyingEntries.length} kết quả`);
      return buyingEntries;
    }).then(function (buyingEntries) {
      vm.updateSummary();

      _.forEach(buyingEntries, buyingEntry => {
        getDeadlineLabelForBuyingEntryDeadline(buyingEntry);
      });

      vm.buyingEntriesData = buyingEntries;
      vm.buyingEntriesTable.settings({
        dataset: buyingEntries
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.searchKeyUp = function ($event) {
    if ($event.keyCode === 13) vm.find();
  };

  vm.updateSummary = function () {
    _.forEach(vm.data.statuses, status => {
      vm.summary[status.id] = _.filter(vm.buyingEntries, {
        status: status.id
      }).length;
    });

    _.forEach(vm.data.countries, country => {
      vm.summary[country.id] = _.filter(vm.buyingEntries, {
        country: country.id
      }).length;
    });

    _.forEach(vm.data.complaintStatuses, status => {
      vm.summary[status.id] = _.filter(vm.buyingEntries, buyingEntry => {
        if (status.id === 'needComplaint' && buyingEntry.needComplaint) {
          return true;
        }

        if (status.id === 'waitDoneComplaint' && buyingEntry.waitDoneComplaint) {
          return true;
        }

        if (status.id === 'doneAllComplaints' && buyingEntry.doneAllComplaints) {
          return true;
        }
      }).length;
    });

    _.forEach(vm.data.buyingEntryTypes, buyingEntryType => {
      vm.summary[buyingEntryType.id] = _.filter(vm.buyingEntries, buyingEntry => {
        if (buyingEntryType.id === 'direct') return buyingEntry.isDirect;
        return !buyingEntry.isDirect;
      }).length;
    });

    OutletService.allAsync().then(outlets => {
      _.forEach(outlets, outlet => {
        vm.summary[outlet._id] = _.filter(vm.buyingEntries, buyingEntry => {
          return _.get(buyingEntry, 'destination._id') === outlet._id;
        }).length;
      });
    });
  };

  vm.selectAll = function (field) {
    const map = vm[`${field}Map`];
    let newValue = true;
    if (_.every(map)) newValue = false;

    _.forEach(map, (value, key) => {
      map[key] = newValue;
    });
  };

  vm.checkAll = function () {
    _.forEach(vm.buyingEntriesTable.data, buyingEntry => {
      buyingEntry.checked = vm.toCheck;
    });
  };

  vm.orderRequested = function (buyingEntry) {
    buyingEntry.orderRequested = Date.now();
    buyingEntry.$update().then(FhdMessenger.success('Đã gửi đơn hàng')).catch(FhdMessenger.errorFromServer);
  };

  vm.order = function (buyingEntry) {
    vm.updatingOrdered = true;
    buyingEntry.$order().then(() => {
      FhdMessenger.success('Ok!');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.updatingOrdered = false;
    });
  };

  vm.cancel = function (buyingEntry) {
    buyingEntry.cancelNote = $window.prompt('Nhập lý do hủy');

    if (!buyingEntry.cancelNote) {
      return FhdMessenger.error('Chưa điền lý do hủy');
    }

    vm.updating = true;
    buyingEntry.$cancel().then(() => {
      FhdMessenger.success('Yêu cầu thành công');
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.updating = false;
    });
  };

  vm.star = function (buyingEntry) {
    vm.updating = true;
    buyingEntry.$star().then(() => {
      FhdMessenger.success('Ok!');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.updating = false;
    });
  };

  vm.terminate = function (buyingEntry) {
    vm.updating = true;
    buyingEntry.$terminate().then(() => {
      FhdMessenger.success('Ok!');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.updating = false;
    });
  };

  vm.mergeBuyingEntries = function () {
    vm.waiting = true;

    const buyingEntries = _.filter(vm.buyingEntriesTable.data, 'checked');

    const buyingEntryIds = _.map(buyingEntries, buyingEntry => {
      return buyingEntry._id;
    });

    BuyingEntryService.mergeBuyingEntries(buyingEntryIds).then(buyingEntry => {
      vm.buyingEntries = [];
      vm.find();
      $window.open(`${$location.protocol()}://${$location.host()}${$location.port() !== 80 ? `:${$location.port()}` : ''}/#!/buying-entries/${buyingEntry._id}`, '_blank');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.calculateOrderItems = function () {
    vm.waiting = true;

    const buyingEntries = _.filter(vm.buyingEntriesTable.data, 'checked');

    const buyingEntryIds = _.map(buyingEntries, buyingEntry => {
      return buyingEntry._id;
    });

    BuyingEntryService.calculateOrderItemsForBuyingEntries(buyingEntryIds).then(() => {
      FhdMessenger.success('Tính lại thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.changeShowProcessors = function (buyingEntry) {
    buyingEntry.showProcessor = !buyingEntry.showProcessor;
  };
}]);
'use strict';

angular.module('buying-entries').controller('ConfirmChinaBuyingEntryController', ['toaster', 'Authentication', 'BuyingEntryService', 'BuyingEntries', 'CurrentShift', 'FhdMessenger', 'ObjectId', 'ResourcesService', 'StockEntries', function (toaster, Authentication, BuyingEntryService, BuyingEntries, CurrentShift, FhdMessenger, ObjectId, ResourcesService, StockEntries) {
  const vm = this;
  vm.user = Authentication.user;
  vm.shippingVendors = ['Nhaphangkinhdoanh', 'Anh Phúc'];
  vm.items = [];
  vm.newItems = [];
  vm.badProductImages = [];
  vm.blockImages = [];
  vm.newProductImages = [];
  vm.data = {};
  async.parallel([ResourcesService.staffs(false)], function (err, results) {
    if (err) {
      toaster.error(err.message);
      return;
    }

    vm.data.staffs = results[0];
  });
  vm.processStaffs = [];

  vm.find = function () {
    const dataId = vm.dataId;
    vm.waiting = true;
    BuyingEntryService.findByBlockId(dataId).then(buyingEntry => {
      const transporterIndex = Math.max(_.findIndex(buyingEntry.transporters, {
        transporterId: dataId
      }), _.findIndex(buyingEntry.transporters, {
        blockId: dataId
      }));

      if (buyingEntry.transporters[transporterIndex].confirmed) {
        return FhdMessenger.error('Kiện đã được confirm');
      }

      vm.buyingEntry = buyingEntry;
      vm.items = _.cloneDeep(vm.buyingEntry.items);
      vm.currentDataId = _.cloneDeep(dataId);
      vm.dataId = '';
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.confirm = function () {
    if ((_.some(vm.items, item => {
      return item.badQuantity > 0;
    }) || _.some(vm.newItems, item => {
      return item.badQuantity > 0;
    })) && !vm.badProductImages.length) {
      return FhdMessenger.error('Chưa có ảnh hàng lỗi');
    }

    if (_.some(vm.items, item => {
      if (item.badQuantity && !item.note) {
        return true;
      }
    })) {
      return FhdMessenger.error('Có sản phẩm lỗi chưa có ghi chú');
    }

    if (vm.items.length && !_.every(vm.items, item => item.quantity > 0)) {
      return FhdMessenger.error('Có sản phẩm chưa có số lượng');
    }

    if (vm.newItems.length && !_.every(vm.newItems, item => item.quantity > 0)) {
      return FhdMessenger.error('Có sản phẩm mới chưa có số lượng');
    }

    if (vm.newItems.length && !vm.newProductImages.length) {
      return FhdMessenger.error('Chưa có ảnh sản phẩm mới');
    }

    if (!vm.actualBlockWeight) {
      return FhdMessenger.error('Chưa có cân nặng của kiện');
    }

    if (!vm.processStaffs.length) {
      return FhdMessenger.error('Chưa có danh sách nhân viên xử lý đơn kiện');
    }

    if (vm.buyingEntry) {
      vm.waiting = true;
      BuyingEntries.confirmChinaBuying({
        _id: _.get(vm.buyingEntry, '_id'),
        dataId: vm.currentDataId,
        items: vm.items.concat(vm.newItems),
        badProductImages: vm.badProductImages,
        blockImages: vm.blockImages,
        newProductImages: vm.newProductImages,
        note: vm.note,
        hasNewProduct: vm.hasNewProduct,
        actualBlockWeight: vm.actualBlockWeight,
        processStaffs: vm.processStaffs
      }).$promise.then(() => {
        FhdMessenger.success('Ok!');
        resetElements();
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    } else {
      const currentShift = CurrentShift.getCurrentShift();

      if (!currentShift || !currentShift.outlet) {
        return FhdMessenger.error('Chưa đăng nhập ca trực');
      }

      vm.waiting = true;
      BuyingEntries.confirmAnhPhucBuying({
        destination: currentShift.outlet,
        items: vm.items,
        newItems: vm.newItems,
        badProductImages: vm.badProductImages,
        blockImages: vm.blockImages,
        newProductImages: vm.newProductImages,
        note: vm.note,
        hasNewProduct: vm.hasNewProduct,
        actualBlockWeight: vm.actualBlockWeight,
        processStaffs: vm.processStaffs
      }).$promise.then(() => {
        FhdMessenger.success('Ok!');
        resetElements();
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    }
  };

  function resetElements() {
    vm.buyingEntry = null;
    vm.currentDataId = null;
    vm.badProductImages = [];
    vm.blockImages = [];
    vm.newProductImages = [];
    vm.items = [];
    vm.newItems = [];
    vm.hasNewProduct = false;
    vm.actualBlockWeight = 0;
  }

  vm.addNewProduct = function () {
    vm.newItems.push({
      description: '',
      quantity: 0
    });
  };

  vm.productSearchSelected = function (item) {
    if (!item) return;

    const matchItemIndex = _.findIndex(vm.items, currentItem => {
      return item.sku === currentItem.sku;
    });

    if (matchItemIndex > -1) {
      return FhdMessenger.error('Sản phẩm đã có trong danh sách');
    } else {
      vm.items.push({
        product: item._id,
        sku: item.sku,
        description: item.description,
        privateLabel: item.privateLabel,
        quantity: 0,
        badQuantity: 0
      });
    }
  };

  vm.removeItem = (index, items) => {
    items.splice(index, 1);
  };

  vm.addBadProductImage = newImage => {
    vm.badProductImages = vm.badProductImages || [];

    if (newImage) {
      vm.badProductImages.push({
        data: newImage
      });
    }
  };

  vm.removeBadProductImage = index => {
    vm.badProductImages.splice(index, 1);
  };

  vm.addBlockImage = newImage => {
    vm.blockImages = vm.blockImages || [];

    if (newImage) {
      vm.blockImages.push({
        data: newImage
      });
    }
  };

  vm.removeBlockImage = index => {
    vm.blockImages.splice(index, 1);
  };

  vm.addNewProductImage = newImage => {
    vm.newProductImages = vm.newProductImages || [];

    if (newImage) {
      vm.newProductImages.push({
        data: newImage
      });
    }
  };

  vm.removeNewProductImage = index => {
    vm.newProductImages.splice(index, 1);
  };

  vm.needImage = () => {
    return _.some(vm.items, item => {
      return item.badQuantity > 0;
    }) || _.some(vm.newItems, item => {
      return item.badQuantity > 0;
    });
  };

  vm.pushTypeAhead = function (item) {
    vm.processStaffs = vm.processStaffs || [];
    if (!item) return;

    const checkDuplicate = _.find(vm.processStaffs, item);

    if (!checkDuplicate) {
      vm.processStaffs.push(_.cloneDeep(item));
    }

    item = null;
    clearInput();
  };

  function clearInput() {
    vm.staffSearch = null;
  }
}]);
"use strict";

angular.module('buying-entries').controller('ConfirmOrderItemsInBuyingEntryController', ['$stateParams', '$state', 'toaster', 'Authentication', 'BuyingEntries', 'BuyingEntryService', 'CurrentShift', 'ConfirmModal', 'FhdMessenger', 'CartonEntries', 'ResourcesService', 'UserPhotoService', 'ProductService', function ($stateParams, $state, toaster, Authentication, BuyingEntries, BuyingEntryService, CurrentShift, ConfirmModal, FhdMessenger, CartonEntries, ResourcesService, UserPhotoService, ProductService) {
  const vm = this;
  vm.user = Authentication.user;
  vm.currentShift = CurrentShift.getCurrentShift();
  vm.data = {};
  vm.outlet = vm.currentShift.outlet;
  vm.billImages = [];
  vm.vendorProductImages = [];
  vm.showInputCartonEntry = false;

  if (!vm.currentShift.created && !vm.user.roles.includes('admin') && !vm.user.roles.includes('flexi-time') && !vm.user.roles.includes('tro-ly-kho') && !vm.user.roles.includes('tro-ly-sx')) {
    return FhdMessenger.error('Chưa đăng nhập ca trực');
  }

  vm.paymentType = 'debt';

  vm.findCartonEntry = item => {
    if (!item.cartonEntryId) {
      return FhdMessenger.error('Bạn chưa điền thông tin mã kiện');
    }

    vm.waiting = true;
    CartonEntries.search({
      cartonEntryId: item.cartonEntryId
    }).$promise.then(cartonEntry => {
      if (cartonEntry.status === 'done') {
        ConfirmModal.showModal({}, {
          bodyText: `Kiện này đã có trong BE ${_.get(cartonEntry, 'buyingEntry.buyingEntryId')}, bạn có muốn thêm vào BE hiện tại`,
          actionButtonText: 'Đồng ý',
          closeButtonText: 'Kiểm tra lại'
        }).then(() => {
          vm.addCartonEntry(item, cartonEntry);
        });
      } else {
        vm.addCartonEntry(item, cartonEntry);
      }
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.addCartonEntry = function (item, cartonEntry) {
    item.cartonEntries = item.cartonEntries || [];
    item.cartonEntries.push({
      cartonEntryId: cartonEntry.cartonEntryId,
      _id: cartonEntry._id
    });
    item.cartonEntryId = '';
  };

  vm.findOne = () => {
    const buyingEntry = BuyingEntries.get({
      buyingEntryId: $stateParams.buyingEntryId
    });
    buyingEntry.$promise.then(buyingEntry => {
      vm.buyingEntry = buyingEntry;

      if (['TQ001', 'TQ002', 'SG027'].includes(buyingEntry.vendor.code) && _.get(buyingEntry, 'destination.code') !== 'M6') {
        vm.showInputCartonEntry = true;
      }

      vm.orderItemReceiveds = _.filter(_.cloneDeep(vm.buyingEntry.orderItems), item => item.arrivingQuantity > 0);

      _.forEach(vm.orderItemReceiveds, item => {
        item.quantity = null;
      });
    });
    async.parallel([ResourcesService.staffs(false)], function (err, results) {
      if (err) {
        toaster.error(err.message);
        return;
      }

      vm.data.staffs = results[0];
    });
    vm.processStaffs = [];
    vm.pasteCodeStaffs = [];
  };

  vm.pushTypeAhead = function (item) {
    vm.processStaffs = vm.processStaffs || [];
    if (!item) return;

    const checkDuplicate = _.find(vm.processStaffs, item);

    if (!checkDuplicate) {
      vm.processStaffs.push(_.cloneDeep(item));
    }

    item = null;
    clearInput();
  };

  function clearInput() {
    vm.staffSearch = null;
  }

  vm.removeItem = (index, items) => {
    items.splice(index, 1);
  };

  vm.changeNoActualPayment = () => {
    vm.actualPayment = null;
  };

  vm.changeNoBillPayment = () => {
    vm.billImages = null;
    vm.billPayment = null;
  };

  const receiveOrderItemsInBuyingEntry = _.throttle(() => {
    vm.updating = true;
    BuyingEntries.receiveOrderItems({
      _id: _.get(vm.buyingEntry, '_id'),
      orderItemReceiveds: vm.orderItemReceiveds,
      actualPayment: vm.actualPayment,
      billPayment: vm.billPayment,
      noActualPayment: vm.noActualPayment,
      noBillPayment: vm.noBillPayment,
      billCode: vm.billCode,
      note: vm.note,
      billImages: vm.billImages,
      vendorProductImages: vm.vendorProductImages,
      paymentType: vm.paymentType,
      noBillReason: vm.noBillReason,
      processStaffs: vm.processStaffs,
      pasteCodeStaffs: vm.pasteCodeStaffs
    }).$promise.then(buyingEntry => {
      FhdMessenger.success('Confirm thành công');
      $state.go('arrivingBuyingEntry');
    }).catch(error => {
      FhdMessenger.errorFromServer(error);
    }).finally(() => {
      vm.updating = false;
    });
  }, 2000);

  vm.isFoodProduct = ProductService.isFoodProduct;

  vm.receiveOrderItems = () => {
    if (!vm.orderItemReceiveds || !vm.orderItemReceiveds.length) {
      return FhdMessenger.error('Chưa có sản phẩm nhận');
    }

    if (_.some(vm.orderItemReceiveds, item => {
      if (ProductService.isFoodProduct(item.product) && (!item.manufacturingDate || !item.expirationDate)) {
        return true;
      }
    })) {
      return FhdMessenger.error('Có sản phẩm chưa có NSX và HSD');
    }

    if (_.some(vm.orderItemReceiveds, item => {
      return item.manufacturingDate && moment().endOf('day').isBefore(item.manufacturingDate);
    })) {
      return FhdMessenger.error('NSX của các sản phẩm không được lớn hơn hôm nay');
    }

    if (_.some(vm.orderItemReceiveds, item => {
      return item.expirationDate && moment().isAfter(item.expirationDate);
    })) {
      return FhdMessenger.error('HSD của các sản phẩm phải lớn hơn ngày hôm nay');
    }

    if (_.some(vm.orderItemReceiveds, item => {
      if (!item.quantity || item.quantity === 0) {
        return true;
      }
    })) {
      return FhdMessenger.error('Có sản phẩm chưa nhập số lượng nhập kho');
    }

    if (vm.showInputCartonEntry && _.some(vm.orderItemReceiveds, item => {
      return !_.get(item, 'cartonEntries.length');
    })) {
      return FhdMessenger.error('Có sản phẩm chưa có mã kiện');
    }

    if (!vm.noBillPayment && (!vm.billImages || vm.billImages.length <= 0)) {
      return FhdMessenger.error('Chưa có ảnh hóa đơn');
    }

    if (_.get(vm.buyingEntry, 'vendor.requireBillCode') && !vm.noBillPayment) {
      if (!vm.billCode) {
        return FhdMessenger.error('Chưa có mã hóa đơn');
      }
    }

    if (vm.noBillPayment && !vm.noBillReason) {
      return FhdMessenger.error('Chưa có lý do không có hóa đơn');
    }

    if (!vm.vendorProductImages || vm.vendorProductImages.length <= 1) {
      return FhdMessenger.error('Số lượng ảnh sản phẩm nhận tối thiểu là 2');
    }

    if (!vm.noActualPayment && !vm.actualPayment) {
      return FhdMessenger.error('Chưa có số tiền thanh toán');
    }

    if (!vm.noBillPayment && !vm.billPayment) {
      return FhdMessenger.error('Chưa có số tiền trên hóa đơn thanh toán');
    }

    if (!vm.processStaffs.length) {
      return FhdMessenger.error('Chưa có danh sách nhân viên xử lý');
    }

    if (_.some(vm.orderItemReceiveds, item => {
      if (item.quantity !== item.arrivingQuantity) {
        return true;
      }
    })) {
      ConfirmModal.showModal({}, {
        bodyText: `Số lượng kiểm khác với số lượng đặt. Bạn có chắc chắn không?`,
        actionButtonText: 'Đồng ý',
        closeButtonText: 'Kiểm tra lại'
      }).then(() => {
        receiveOrderItemsInBuyingEntry();
      });
    } else {
      receiveOrderItemsInBuyingEntry();
    }
  };

  vm.updateExpirationDate = item => {
    if (!item.vendorShelfLife || !item.manufacturingDate) {
      return;
    }

    item.expirationDate = moment(item.manufacturingDate).add(item.vendorShelfLife, 'month').toDate();
  };
}]);
"use strict";

angular.module('buying-entries').controller('CreateBuyingEntryController', ['$scope', 'Authentication', 'FhdMessenger', 'NgTableParams', 'Vendors', 'BuyingEntries', '$location', 'BuyingEntryService', '$http', 'ObjectId', 'ConfirmModal', function ($scope, Authentication, FhdMessenger, NgTableParams, Vendors, BuyingEntries, $location, BuyingEntryService, $http, ObjectId, ConfirmModal) {
  const vm = this;
  vm.waiting = false;
  vm.user = Authentication.user;
  vm.totalStocks = {};
  vm.arrivingStocks = {};
  vm.salePerDayProducts = {};
  vm.openlDayLeftDetailModal = BuyingEntryService.openlDayLeftDetailModal;

  vm.initBuyingEntry = () => {
    vm.data = vm.data || {};
    vm.data.vendors = Vendors.query();
    vm.buyingEntry = {
      vendor: null,
      expectedArrivalDate: moment().startOf('day').format('YYYY-MM-DD'),
      items: []
    };
    vm.buyingEntry.itemsTable = new NgTableParams({}, {
      dataset: vm.buyingEntry.items
    });
  };

  vm.fetchTable = () => {
    vm.buyingEntry.itemsTable = new NgTableParams({
      count: 2000
    }, {
      dataset: vm.buyingEntry.items
    });
  };

  vm.creatingBuyingEntries = function (buyingEntries) {
    vm.waiting = true;
    BuyingEntryService.createBuyingEntries(buyingEntries).then(buyingEntries => {
      $location.path(`buying-entries`);
    }).catch(error => {
      FhdMessenger.error(error.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  $scope.$watch(() => vm.importItems, (newImportItems, oldImportItems) => {
    if (newImportItems === oldImportItems) return;
    if (!newImportItems.length) return;

    if (_.some(newImportItems, item => {
      return !item.sku;
    })) {
      return FhdMessenger.error('Có sản phẩm chưa có mã');
    }

    if (_.some(newImportItems, item => {
      return !item.quantity;
    })) {
      return FhdMessenger.error('Có sản phẩm chưa có số lượng');
    }

    if (_.some(newImportItems, item => {
      return !item.destination;
    })) {
      return FhdMessenger.error('Có sản phẩm chưa có nơi nhận');
    }

    vm.waiting = true;
    BuyingEntryService.calculateImportItems(newImportItems).then(buyingEntries => {
      vm.buyingEntries = buyingEntries;
      vm.getBuyingEntryStock(vm.buyingEntries);

      _.forEach(vm.buyingEntries, buyingEntry => {
        BuyingEntryService.findDuplicateBuyingEntry(buyingEntry).then(res => {
          buyingEntry.duplicateBuyingEntries = res;
        });
      }); // vm.buyingEntry.items = items
      // vm.fetchTable()
      // vm.calculateBuyingItems(vm.buyingEntry)

    }).catch(error => {
      FhdMessenger.error(error.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  });
  vm.calculateBuyingItems = BuyingEntryService.calculateBuyingItems;
  vm.calculateOrderItems = BuyingEntryService.calculateOrderItems;

  vm.calculateReceiveItems = function () {
    BuyingEntryService.calculateReceiveItems(vm.receiveItems);
    vm.totalReceiveItemsValue = _.sumBy(vm.receiveItems, 'buyingValue');
  };

  vm.getBuyingEntryStock = buyingEntries => {
    for (let buyingEntry of buyingEntries) {
      vm.calculateDayLeftForBuyingEntry(buyingEntry);
    }
  };

  vm.calculateDayLeftForBuyingEntry = async function (buyingEntry) {
    buyingEntry.items = await BuyingEntryService.calculateDayLeftForBuyingEntry(buyingEntry);
  };

  vm.addBuyingItem = product => {
    if (product.privateLabel && !_.get(product, 'vendorProducts.length')) {
      return FhdMessenger.error('Sản phẩm chưa có vendor product');
    }

    vm.buyingEntry.items = vm.buyingEntry.items || [];
    vm.buyingEntry.items.push({
      product: product._id,
      sku: product.sku,
      buyingWeight: product.buyingWeight,
      description: product.description,
      cogs: product.cogs,
      buyingQuantity: 1,
      buyingValue: product.cogs,
      arrivedQuantity: 0,
      arrivingQuantity: 1,
      warehouseRestock: product.warehouseRestock,
      leadTime: product.leadTime,
      privateLabel: product.privateLabel,
      shelfLife: product.shelfLife,
      vendorProducts: _.get(product, 'vendorProducts', [])
    });
    vm.calculateBuyingItems(vm.buyingEntry);
    vm.calculateDayLeftForBuyingEntry(vm.buyingEntry);
    vm.calculateOrderItems(vm.buyingEntry);
    vm.fetchTable();

    const matchVendor = _.find(vm.data.vendors, vendor => {
      return ObjectId.equals(vendor, product.vendor);
    });

    if (matchVendor) {
      vm.buyingEntry.vendor = ObjectId.getObjectId(matchVendor);
    }
  };

  vm.removeItem = function (item) {
    const matchBuyingItem = _.find(vm.buyingEntry.items, {
      product: item.product
    });

    _.pull(vm.buyingEntry.items, matchBuyingItem);

    const matchTableItem = _.find(vm.buyingEntry.itemsTable.data, {
      product: item.product
    });

    _.pull(vm.buyingEntry.itemsTable.data, matchTableItem);

    vm.calculateBuyingItems(vm.buyingEntry);
    vm.calculateReceiveItems();
  };

  vm.addSuggestToOrderItems = buyingEntry => {
    buyingEntry.orderItems = buyingEntry.suggestOrderItems;
    vm.calculateOrderItems(buyingEntry);

    const destinationCode = _.get(vm.buyingEntry, 'destination.code', '');

    if (vm.buyingEntry.items && destinationCode.match(/^D\d+/)) {
      const wrongKhoItems = _.filter(vm.buyingEntry.items, item => _.get(item, 'warehouseRestock.code', '') !== destinationCode);

      if (wrongKhoItems.length) {
        _.forEach(wrongKhoItems, item => {
          return FhdMessenger.error(`Sản phẩm ${item.sku} - ${item.description} chỉ có thể nhập về kho ${_.get(item.warehouseRestock, 'code')}`);
        });
      }
    }
  };

  vm.createBuyingEntry = () => {
    BuyingEntryService.findDuplicateBuyingEntry(vm.buyingEntry).then(duplicateBuyingEntries => {
      if (duplicateBuyingEntries.length) {
        const content = _.reduce(duplicateBuyingEntries, (result, duplicateBuyingEntry) => {
          let itemContent = '';

          _.forEach(duplicateBuyingEntry.items, item => {
            itemContent += `<li>${item.sku} - ${item.description} - S.lg: ${item.buyingQuantity}</li>`;
          });

          result += `<tr>
            <td>${duplicateBuyingEntry.buyingEntryId}</td>
            <td><ul style="margin-bottom:0">${itemContent}</ul></td>
            <td>${duplicateBuyingEntry.destination.code}</td>
            <td>${moment(duplicateBuyingEntry.created).format('DD/MM/YYYY h:mm a')}</td>
          </tr>`;
          return result;
        }, 'Có BE có vẻ trùng với BE đang import:');

        ConfirmModal.showModal({}, {
          actionButtonText: `Xác nhận`,
          headerText: 'Confirm Buying Entry mới',
          bodyText: `<table class="table table-bordered table-condensed table-hover table-striped">
              <thead>
              <th>BE</th>
              <th>Product bị trùng</th>
              <th>Destination</th>
              <th>Created</th>
              </thead>
              <tbody>${content}</tbody>
              </table>`
        }).then(() => {
          createBuyingEntry();
        });
      } else {
        createBuyingEntry();
      }
    });
  };

  const createBuyingEntry = () => {
    const buyingEntry = new BuyingEntries(vm.buyingEntry);
    buyingEntry.$save().then(({
      buyingEntry,
      content
    }) => {
      // console.log(buyingEntry, content)
      $location.path(`buying-entries/${buyingEntry._id}`);

      if (content) {
        FhdMessenger.errorStick(content);
      }
    }).catch(FhdMessenger.errorFromServer);
  };
}]);
"use strict";

angular.module('buying-entries').controller('DirectBuyingEntriesController', ['$scope', 'FhdMessenger', 'BuyingEntryService', 'CurrentShift', 'BuyingEntries', 'ObjectId', 'Authentication', function ($scope, FhdMessenger, BuyingEntryService, CurrentShift, BuyingEntries, ObjectId, Authentication) {
  const vm = this;

  vm.find = () => {
    vm.currentShift = CurrentShift.getCurrentShift();
    let {
      outlet
    } = vm.currentShift;
    const user = Authentication.user;
    let destinations;

    if (outlet) {
      destinations = [outlet._id];
    } else {
      if (!_.includes(user.roles, 'admin')) {
        outlet = user.outlet;
        vm.outlet = outlet;
        destinations = _.reduce(user.managingOutlets || [], (result, outlet) => {
          result.push(ObjectId.getObjectId(outlet));
          return result;
        }, outlet ? [ObjectId.getObjectId(outlet)] : []);
      }
    }

    const promise = BuyingEntries.listDirectBuyingEntries({
      destinations
    }).$promise.then(buyingEntries => {
      vm.buyingEntries = _.filter(buyingEntries, buyingEntry => {
        return _.some(buyingEntry.items, item => {
          return item.arrivingQuantity > 0;
        });
      });
    });
    FhdMessenger.notifyLoading('Đang tải...', promise, () => {
      FhdMessenger.success('Tải xong');
    });
  };

  vm.openConfirmBuyingEntryModal = BuyingEntryService.openConfirmBuyingEntryModal;
}]);
"use strict";

angular.module('buying-entries').controller('ListBuyingEntriesAccountingController', ['$scope', 'FhdMessenger', 'BuyingEntries', 'NgTableParams', 'BuyingEntryService', '$http', '$window', function ($scope, FhdMessenger, BuyingEntries, NgTableParams, BuyingEntryService, $http, $window) {
  const vm = this; // Find a list of Buying entries

  vm.buyingEntriesTable = new NgTableParams({});

  vm.init = () => {
    vm.createdStartDate = '2021-12-01';
    vm.data = {
      selectedBuyingEntries: [],
      statuses: BuyingEntryService.getStatuses(),
      paymentStatuses: BuyingEntryService.getPaymentStatuses(),
      buyingEntryTypes: [{
        title: 'direct',
        id: 'direct',
        className: 'info'
      }, {
        title: 'nondirect',
        id: 'nondirect',
        className: 'default'
      }],
      outlets: [],
      stages: ['arrived', 'created', 'ordered', 'pending'],
      countries: [{
        title: 'Việt Nam',
        id: 'Việt Nam',
        className: 'primary'
      }, {
        title: 'Trung Quốc',
        id: 'Trung Quốc',
        className: 'danger'
      }],
      summary: {
        totalBuyingValue: 0
      } // Build status map

    };
    vm.statusMap = _.reduce(vm.data.statuses, (result, status) => {
      result[status.id] = false;
      return result;
    }, {});
    vm.statusMap['arrived'] = true;
    vm.statusMap['received'] = true;
    vm.paymentStatusMap = _.reduce(vm.data.paymentStatuses, (result, status) => {
      result[status.id] = false;
      return result;
    }, {});
    vm.paymentStatusMap['unpaid'] = true;
    vm.noPaymentDeadline = true;
  };

  vm.find = function () {
    const statuses = _.reduce(vm.statusMap, (result, value, status) => {
      if (value) result.push(status);
      return result;
    }, []);

    const paymentStatuses = _.reduce(vm.paymentStatusMap, (result, value, status) => {
      if (value) result.push(status);
      return result;
    }, []);

    const countries = _.reduce(vm.countryMap, (result, value, country) => {
      if (value) result.push(country);
      return result;
    }, []);

    const buyingEntryTypes = _.reduce(vm.buyingEntryTypeMap, (result, value, buyingEntryType) => {
      if (value) result.push(buyingEntryType);
      return result;
    }, []);

    FhdMessenger.info('Đang tìm...');
    vm.waiting = true;
    vm.buyingEntries = BuyingEntries.query({
      'statuses[]': statuses,
      'countries[]': countries,
      'destinations[]': vm.destinations,
      'buyingEntryTypes[]': buyingEntryTypes,
      searchText: vm.searchText,
      'paymentStatuses[]': paymentStatuses,
      limit: 10000,
      createdStartDate: vm.createdStartDate,
      createdEndDate: vm.createdEndDate,
      noPaymentDeadline: vm.noPaymentDeadline,
      paymentStartDate: vm.paymentStartDate,
      paymentEndDate: vm.paymentEndDate
    });
    vm.buyingEntries.$promise.then(buyingEntries => {
      FhdMessenger.success(`Tìm thấy ${buyingEntries.length} kết quả`);
      return buyingEntries;
    }).then(function (buyingEntries) {
      vm.buyingEntriesData = buyingEntries;
      vm.buyingEntriesTable.settings({
        dataset: buyingEntries
      });
      vm.data.summary.totalBuyingValue = _.sumBy(vm.buyingEntries, 'totalBuyingValue');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.destinations = _.map(selectedOutlets, '_id');
  };

  vm.openModalUpdatePaymentDeadline = buyingEntries => {
    vm.modalUpdatePaymentDeadline.show(buyingEntries);
  };

  vm.exportTable = () => {
    vm.waiting = true;

    if (vm.linkGoogleSheet) {
      const confirm = $window.confirm('Bạn đã tạo link google sheet, bạn muốn tạo mới chứ?');

      if (!confirm) {
        return;
      }
    }

    FhdMessenger.info('Đang tạo');
    let sheetCols = ['Status', 'BE', 'Payment Status', 'Vendor Code', 'Vendor Name', 'Destination', 'Buying Value', 'Created', 'Done', 'Deadline'];
    const sheetData = [];

    _.forEach(vm.buyingEntries, buyingEntry => {
      const data = [buyingEntry.status, buyingEntry.buyingEntryId, buyingEntry.paymentStatus, buyingEntry.vendor.code, buyingEntry.vendor.name, buyingEntry.destination.code, buyingEntry.totalBuyingValue, moment(buyingEntry.created).format('YYYY-MM-DD'), buyingEntry.arrived ? moment(buyingEntry.arrived).format('YYYY-MM-DD') : '', moment(buyingEntry.paymentDeadline).format('YYYY-MM-DD')];
      sheetData.push(data);
    });

    $http.post('/sheet', {
      sheetData: sheetData,
      sheetTitle: `BE ${moment().format('YYYY-MM-DD')}`,
      sheetCols
    }).then(res => {
      vm.linkGoogleSheet = `https://docs.google.com/spreadsheets/d/${res.data.data.spreadsheetId}`;
      $window.open(vm.linkGoogleSheet);
      FhdMessenger.success('Đã tạo thành công');
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.updateSelectedBuyingEntries = () => {
    vm.data.selectedBuyingEntries = _.filter(vm.buyingEntries, 'checked');
  };

  vm.checkOne = buyingEntry => {
    buyingEntry.checked = !buyingEntry.checked;
    vm.updateSelectedBuyingEntries();
  };

  vm.checkAll = () => {
    vm.toCheck = !_.some(vm.buyingEntriesTable.data, buyingEntry => buyingEntry.checked);

    _.forEach(vm.buyingEntriesTable.data, buyingEntry => {
      buyingEntry.checked = vm.toCheck;
    });

    vm.updateSelectedBuyingEntries();
  };

  vm.updatePaymentDeadline = buyingEntries => {
    return BuyingEntryService.openUpdatePaymentDeadlineModal(buyingEntries);
  };

  vm.updatePaymentStatus = buyingEntries => {
    return BuyingEntryService.openUpdatePaymentStatusModal(buyingEntries);
  };
}]);
"use strict";

angular.module('buying-entries').controller('ListComplaintBuyingEntriesController', ['$scope', 'FhdMessenger', 'BuyingEntries', 'NgTableParams', 'BuyingEntryService', '$http', '$window', function ($scope, FhdMessenger, BuyingEntries, NgTableParams, BuyingEntryService, $http, $window) {
  const vm = this; // Find a list of Buying entries

  vm.buyingEntriesTable = new NgTableParams({});

  vm.init = () => {
    vm.startDate = moment().subtract(1, 'month').format('YYYY-MM-DD');
    vm.endDate = moment().format('YYYY-MM-DD');
    vm.data = {
      complaintStatuses: [{
        title: 'Cần khiếu nại',
        id: 'needComplaint',
        className: 'info'
      }, // {
      //   title: 'Chờ giải quyết',
      //   id: 'waitDoneComplaint',
      //   className: 'default',
      // },
      {
        title: 'Hoàn thành khiếu nại',
        id: 'doneAllComplaints',
        className: 'success'
      }]
    };
  };

  vm.find = function () {
    FhdMessenger.info('Đang tìm...');
    vm.waiting = true;

    const complaintStatuses = _.reduce(vm.complaintStatusesMap, (result, value, status) => {
      if (value) result.push(status);
      return result;
    }, []);

    vm.buyingEntries = BuyingEntries.query({
      limit: 10000,
      complaintStartDate: vm.startDate,
      complaintEndDate: vm.endDate,
      complaintStatuses
    });
    vm.buyingEntries.$promise.then(buyingEntries => {
      FhdMessenger.success(`Tìm thấy ${buyingEntries.length} kết quả`);
      return buyingEntries;
    }).then(function (buyingEntries) {
      _.forEach(buyingEntries, buyingEntry => {
        buyingEntry.item = _.head(_.head(buyingEntry.complaintWithVendors).items);
      });

      vm.buyingEntriesTable.settings({
        dataset: buyingEntries
      });
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('buying-entries').controller('ModalChangeBuyingVendorController', ['$modalInstance', 'FhdMessenger', 'buyingEntry', 'vendor', function ($modalInstance, FhdMessenger, buyingEntry, vendor) {
  const vm = this;
  vm.vendor = vendor;
  vm.buyingEntry = buyingEntry;

  vm.confirm = () => {
