angular.module('stories').controller('StoriesController', ['$stateParams', 'Authentication', 'FhdMessenger', 'Users', '$http', function ($stateParams, Authentication, FhdMessenger, Users, $http) {
  const vm = this;
  vm.authentication = Authentication;
  vm.stories = [];

  vm.init = () => {
    Users.myStories().$promise.then(response => {
      vm.stories = response;
      vm.stories = _.map(vm.stories, story => {
        story.reactInfo = _.map(story.reactions, reaction => {
          return `${reaction.user.code} - ${reaction.user.displayName} - ${reaction.user.outlet.code}`;
        });
        return story;
      });
    });
  };

  vm.selectStory = storyId => {
    if (vm.selectedStory === storyId) {
      delete vm.selectedStory;
    } else {
      vm.selectedStory = storyId;
    }
  };

  vm.remove = () => {
    if (!vm.selectedStory) {
      return FhdMessenger.error('Bạn chưa chọn story nào!');
    }

    $http.delete(`/stories/${vm.selectedStory}`).then(res => {
      FhdMessenger.success('Xóa story thành công');
      vm.stories = _.reject(vm.stories, story => story._id === vm.selectedStory);
      vm.selectedStory = null;
    }).catch(err => FhdMessenger.error(err.message));
  };
}]);
"use strict";

angular.module('stories').component('workStory', {
  bindings: {
    story: '=',
    addOption: '<'
  },
  templateUrl: 'modules/stories/views/work-story.client.template.html',
  controller: ['UserService', 'FhdMessenger', '$http', '$sce', '$scope', 'Authentication', 'Stories', 'StoryService', function (UserService, FhdMessenger, $http, $sce, $scope, Authentication, Stories, StoryService) {
    const vm = this;
    vm.user = Authentication.user;
    vm.newComment = '';
    vm.content = $sce.trustAsHtml(vm.story.content);
    vm.ownStory = _.isEqual(vm.story.user.code, vm.user.code);
    vm.reactionMap = {};
    vm.linkYoutube = StoryService.getLinkYoutube(vm.story.linkYoutube);

    $scope.trustSrc = function (src) {
      return $sce.trustAsResourceUrl(src);
    };

    vm.openEditStoryModal = () => {
      UserService.openEditStoryModal(vm.story);
    };

    function procressComment() {
      vm.story.comments = _.map(vm.story.comments, comment => {
        if (!_.get(comment.user, 'displayName', false) && comment.user === vm.user._id) {
          comment.user = {
            displayName: vm.user.displayName,
            firstName: vm.user.firstName,
            time: comment.time,
            email: vm.user.email
          };
        }

        return comment;
      });
    }

    function createReactionMap() {
      vm.reactionMap = _.countBy(vm.story.reactions, 'type');
    }

    vm.addComment = _.debounce(() => {
      if (!vm.newComment) return;
      vm.story.$comment({
        comment: vm.newComment
      }).then(story => {
        procressComment();
        FhdMessenger.success('Oke');
        vm.newComment = '';
      }).catch(err => FhdMessenger.error(err.data.message));
    }, 500);

    vm.keyup = $event => {
      if ($event.keyCode !== 13) return;
      vm.addComment();
    };

    vm.react = _.debounce((story, reaction) => {
      story.$react({
        type: reaction
      }).then(response => {
        story = response;
        FhdMessenger.success('Ok');
        createReactionMap();
      }).catch(error => {
        FhdMessenger.error(error.data.message);
      });
    }, 500);
    $scope.$watch(() => vm.story, () => {
      createReactionMap();
    });
  }],
  controllerAs: 'vm'
});
"use strict";

