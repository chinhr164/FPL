angular.module('birthday-articles').controller('BirthdayArticleController', ['$stateParams', 'Authentication', 'BirthdayArticles', 'FhdMessenger', '$scope', '$state', '$location', function ($stateParams, Authentication, BirthdayArticles, FhdMessenger, $scope, $state, $location) {
  const vm = this;
  vm.user = Authentication.user;
  vm.hasAuthorization = ['M31', 'M30', 'M32', 'M38'];
  vm.birthdayArticle = {
    authors: []
  };
  $scope.$watch(() => vm.author, () => {
    const findExistAuthor = _.find(vm.birthdayArticle.authors, author => _.get(vm.author, 'code') === _.get(author, 'code'));

    if (!findExistAuthor) {
      vm.birthdayArticle.authors.push(vm.author);
    }

    vm.author = null;
    vm.birthdayArticle.authors = _.compact(vm.birthdayArticle.authors);
  });

  vm.create = function () {
    if (!vm.user.roles.includes('admin') && !_.intersection([vm.user.code], vm.hasAuthorization).length) {
      return FhdMessenger.error('Bạn không có quyền tạo bài dự thi');
    }

    if (!vm.birthdayArticle.title) {
      return FhdMessenger.error('Thiếu tiêu đề');
    }

    if (!vm.birthdayArticle.content) {
      return FhdMessenger.error('Thiếu nội dung');
    }

    if (!vm.birthdayArticle.authors.length) {
      return FhdMessenger.error('Thiếu tác giả');
    }

    const birthdayArticle = new BirthdayArticles(vm.birthdayArticle); // Redirect after save

    birthdayArticle.$save(function (response) {
      FhdMessenger.success('Ok');
      $location.path('/birthday-articles');
    }, function (errorResponse) {
      FhdMessenger.errorFromServer(errorResponse);
    });
  }; // Find a list


  vm.find = function () {
    BirthdayArticles.query().$promise.then(result => {
      vm.birthdayArticles = result;
    });
  }; // Like


  vm.like = function () {
    if (vm.disbledVote) {
      FhdMessenger.error('Chỉ được vote một lần thôi nha');
    }

    vm.birthdayArticle.$like().then(result => {
      FhdMessenger.success('OK');
      $state.reload();
    }).catch(err => FhdMessenger.error(err.data.message));
  }; // Find existing


  vm.findOne = function () {
    BirthdayArticles.get({
      birthdayArticleId: $stateParams.birthdayArticleId
    }).$promise.then(result => {
      vm.birthdayArticle = result;
      vm.disabledVote = _.find(vm.birthdayArticle.liked, liker => _.isEqual(liker, vm.user._id));
    });
  };
}]);
"use strict";

