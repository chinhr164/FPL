angular.module('staff-salary-monthly-reports').component('collaboratorShipSalaryTable', {
  templateUrl: '/modules/staff-salary-monthly-reports/templates/collaborator-ship-salary-table.client.template.html',
  bindings: {
    salaryData: '='
  },
  controllerAs: 'vm',
  controller: ['SalaryTable', function (SalaryTable) {
    const vm = this;
    vm.doc = vm.salaryData;

    vm.viewSaleReport = () => {
      SalaryTable.viewShifts(vm.doc);
    };

    vm.viewSaleEntry = () => {
      SalaryTable.viewSaleEntries(vm.doc);
