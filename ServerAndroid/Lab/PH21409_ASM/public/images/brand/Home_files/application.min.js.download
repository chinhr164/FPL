angular.module('invoices').controller('InvoicesController', ['$state', '$stateParams', '$location', '$scope', 'helper', 'Authentication', 'ConfirmModal', 'Invoices', 'InvoicesService', 'FhdMessenger', 'NgTableParams', 'ObjectId', 'ProductService', '$http', function ($state, $stateParams, $location, $scope, helper, Authentication, ConfirmModal, Invoices, InvoicesService, FhdMessenger, NgTableParams, ObjectId, ProductService, $http) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.removeValueFromArray = helper.removeValueFromArray;
  vm.openViewInvoiceFileModal = InvoicesService.openViewInvoiceFileModal;
  vm.requireFields = 'code supplierType outletCode sku startDate'.split(' ');
  vm.data = {
    supplierTypes: InvoicesService.getSupplierTypes(),
    invoiceStatuses: ['Đã có hóa đơn', 'Chưa có hóa đơn'].map(d => {
      return {
        id: d,
        title: d
      };
    }),
    statusesDate: ['Hết hạn', 'Còn hạn'].map(d => {
      return {
        id: d,
        title: d
      };
    })
  };
  vm.invoice = {};

  vm.init = () => {
    ProductService.getProductWithSpecialSku().then(products => {
      vm.data.amisProducts = _.reduce(_.groupBy(_.filter(products, 'amisSku'), 'amisSku'), (result, _products) => {
        const firstProduct = _.head(_products);

        result.push({
          sku: firstProduct.amisSku,
          description: firstProduct.amisDescription,
          products: _products
        });
        return result;
      }, []);
      vm.data.householdBusinessProducts = _.reduce(_.groupBy(_.filter(products, 'householdBusinessSku'), 'householdBusinessSku'), (result, _products) => {
        const firstProduct = _.head(_products);

        result.push({
          sku: firstProduct.householdBusinessSku,
          description: firstProduct.householdBusinessDescription,
          products: _products
        });
        return result;
      }, []);
      vm.data.products = products;
    });
  };

  vm.autoEndDate = () => {
    vm.invoice.endDate = moment(vm.invoice.startDate).add(6, 'month').format('YYYY-MM-DD');
  };

  vm.searchBySpecialSku = product => {
    const products = product.products;

    if (!products.length) {
      return FhdMessenger.error('Không tìm thấy sản phẩm nào với mã ' + product.sku);
    }

    _.forEach(products, product => {
      vm.productSearchSelected(product);
    });
  };

  function isAllValidField(field) {
    return _.some(vm.invoices, item => {
      return !_.get(item, field);
    });
  }

  vm.import = () => {
    const errors = _.reduce(vm.requireFields, (result, requireField) => {
      if (isAllValidField(requireField)) {
        result.push(`Bạn chưa điền đủ ${requireField}`);
      }

      return result;
    }, []);

    if (_.some(vm.invoices, invoice => {
      return invoice.supplierType === 'Vendor' && !invoice.vendorCode;
    })) {
      errors.push('Có hóa đơn cung cấp bởi vendor nhưng chưa có mã vendor');
    }

    if (errors.length) {
      return FhdMessenger.error(errors.join('\n'));
    }

    ConfirmModal.showModal({}, {
      bodyText: `Hành động này sẽ import create ${vm.invoices.length} invoice?`,
      actionButtonText: 'Đồng ý',
      closeButtonText: 'Kiểm tra lại'
    }).then(() => {
      vm.waiting = true;
      Invoices.import({
        invoices: vm.invoices
      }).$promise.then(() => {
        $state.go('invoicesTracking');
      }).catch(err => {
        return FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.create = function () {
    const error = InvoicesService.validate(vm.invoice);

    if (error) {
      return FhdMessenger.error(error);
    }

    const invoice = new Invoices(vm.invoice);
    vm.waiting = true;
    invoice.$save().then(() => {
      FhdMessenger.success('Tạo Invoice thành công');
      vm.invoice = {};
    }).catch(err => {
      return FhdMessenger.errorFromServer(err.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.productSearchSelected = product => {
    vm.invoice.products = vm.invoice.products || [];

    const matchProduct = _.find(vm.invoice.product, {
      sku: product.sku
    });

    if (matchProduct) {
      return FhdMessenger.error(`Đã có sản phẩm ${product.sku} - ${product.description} trong danh sách`);
    }

    vm.invoice.products.push({
      product: product._id,
      sku: product.sku,
      description: product.description
    });
  };

  vm.productsTable = new NgTableParams({
    count: 50
  });
  vm.summarizeInvoicesTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    Invoices.tracking().$promise.then(({
      productsWithInvoice,
      licenses
    }) => {
      FhdMessenger.success('Đã tải xong');

      _.forEach(productsWithInvoice, invoice => {
        invoice.supplierName = invoice.supplierType === 'Vendor' ? invoice.vendor.code + '-' + invoice.vendor.name : invoice.supplierType;
      });

      vm.productsTable.settings({
        dataset: productsWithInvoice
      });
      vm.summaryProducts(productsWithInvoice, licenses);
    });
  };

  vm.summaryProducts = (products, licenses) => {
    const licenseMap = helper.makeMap(licenses, 'outlet.code');
    vm.summary = _.map(_.values(_.groupBy(products, 'outletCode')), _products => {
      const outletCode = _.head(_products).outletCode;

      const total = _products.length;

      const invoiceTotal = _.filter(_products, {
        invoiceStatus: 'Đã có hóa đơn'
      }).length;

      let outletCodes = [outletCode];

      if (outletCodes.includes('S2')) {
        outletCodes.push('E9');
      } else if (outletCodes.includes('S16')) {
        outletCodes.push('E14');
      } else if (outletCodes.includes('S10')) {
        outletCodes.push('E24');
      }

      let licenseStatus = _.some(outletCodes, _outletCode => licenseMap[_outletCode]) ? 'Có' : 'Không';
      return {
        outletCode,
        licenseStatus,
        total,
        invoiceTotal,
        noInvoiceTotal: total - invoiceTotal,
        invoicePerrcent: Math.round(invoiceTotal / total * 10000) / 100
      };
    });
    vm.summarizeInvoicesTable.settings({
      dataset: vm.summary
    });
  };

  vm.findOne = async () => {
    vm.invoice = Invoices.get({
      invoiceId: $stateParams.invoiceId
    }).$promise.then(invoice => {
      vm.invoice = invoice;
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    });
  };

  vm.update = () => {
    vm.waiting = true;
    vm.invoice.$update().then(response => {
      FhdMessenger.success('Cập nhật thành công');
      $location.path('invoices/tracking');
    }).catch(err => {
      FhdMessenger.error(err.data.message);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.remove = invoice => {
    ConfirmModal.showModal({}, {
      closeButtonText: 'Huỷ',
      actionButtonText: 'Xóa',
      headerText: 'Xóa Invoice ?',
      bodyText: `Bạn có chắc là bạn muốn xóa Invoice ${invoice.code}`
    }).then(() => {
      vm.waiting = true;
      $http.post(`invoices/${invoice._id}/delete`).then(() => {
        FhdMessenger.success('Đã xóa Invoice');

        _.reject(vm.productsTable.data, product => {
          return product.code === invoice.code;
        });

        vm.productsTable.reload();
      }).catch(err => {
        FhdMessenger.error(err.data.message);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };
}]);
"use strict";

