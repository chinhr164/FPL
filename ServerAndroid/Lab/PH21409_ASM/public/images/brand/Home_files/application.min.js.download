angular.module('sale-entries').controller('HiddenSaleEntriesController', ['$http', 'FhdMessenger', function ($http, FhdMessenger) {
  const vm = this;
  vm.data = {
    startDate: moment().startOf('day').format('YYYY-MM-DD'),
    endDate: moment().startOf('day').format('YYYY-MM-DD')
  };

  vm.find = function () {
    vm.waiting = true;
    $http.get('/sale-entries/hidden', {
      params: {
        startDate: vm.data.startDate,
        outlet: _.get(vm.data, 'outlet._id'),
        endDate: vm.data.endDate
      }
    }).then(response => {
      const saleEntries = response.data;
      vm.saleEntries = saleEntries;
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.open = function ($event) {
    $event.preventDefault();
    $event.stopPropagation();
    vm.opened = true;
  };

  vm.dateOptions = {
    formatYear: 'yy',
    startingDay: 1
  };
  vm.minDate = '2015-05-01';
}]);
"use strict";

angular.module('sale-entries').controller('ModalAddBillNumberForSaleEntryController', ['saleEntry', 'SaleEntries', '$modalInstance', 'FhdMessenger', function (saleEntry, SaleEntries, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.saleEntry = SaleEntries.get({
    saleEntryId: saleEntry._id
  });

  vm.addBillNumber = function () {
    if (!vm.billNumber) {
      return FhdMessenger.error('Chưa có mã đơn ahamove');
    }

    vm.saleEntry.shipping.billNumber = vm.billNumber;
    vm.saleEntry.$addBillNumber().then(saleEntry => {
      $modalInstance.close(saleEntry);
    }).catch(FhdMessenger.errorFromServer);
  };

  vm.cancel = function () {
    $modalInstance.dismiss();
  };
}]);
'use strict';

angular.module('sale-entries').controller('ModalAddCustomerToSaleEntryController', ['saleEntry', '$modalInstance', '$http', 'FhdMessenger', 'SaleEntries', 'CurrentShift', function (saleEntry, $modalInstance, $http, FhdMessenger, SaleEntries, CurrentShift) {
  const vm = this;
  vm.saleEntry = SaleEntries.get({
    saleEntryId: saleEntry._id
  });

  vm.addCustomer = function () {
    if (vm.saleEntry.wholesaleOrder) {
      return FhdMessenger.error('Bạn không thể yêu cầu thêm khách hàng vào đơn tạo từ wholesale order');
    }

    const currentShift = CurrentShift.getCurrentShift();
    vm.saleEntry.currentShift = currentShift;
    vm.waiting = true;
    vm.saleEntry.$addCustomer().then(saleEntry => {
      if (!saleEntry.customer) {
        FhdMessenger.info('Đã yêu cầu thêm khách hàng');
      } else {
        FhdMessenger.success('Thêm thành công');
      }

      $modalInstance.close(saleEntry);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };
}]);
"use strict";

angular.module('sale-entries').controller('ModalAddPaymentSaleEntryController', ['$scope', '$modalInstance', 'Authentication', 'FhdMessenger', 'saleEntry', 'customerRequest', 'editPaymentMethod', '$document', function ($scope, $modalInstance, Authentication, FhdMessenger, saleEntry, customerRequest, editPaymentMethod, $document) {
  const vm = this;
  vm.user = Authentication.user;
  vm.editPaymentMethod = editPaymentMethod;
  vm.customerRequest = customerRequest;
  vm.saleEntry = saleEntry;
  vm.saleEntry.notes = vm.saleEntry.notes || [];
  vm.saleEntry.paymentType = '';
  vm.paymentTypes = ['cash', 'vnpay', 'card', 'airpay', 'transfer', 'momo'];
  vm.gifts = ['Tặng quà', 'Tặng voucher', 'Không'];
  vm.hasGift = true;
  vm.paymentType = vm.saleEntry.paymentType || null;
  vm.is2010Day = moment().isSame('2019-10-20', 'day');
  vm.defaultSuggestCash = [100000, 200000, 500000];
  vm.suggestCash = vm.defaultSuggestCash;

  if (vm.customerRequest) {
    vm.saleEntry.customerRequest = vm.customerRequest;
  }

  vm.addOrderId = () => {
    if (!_.get(vm, 'orderId', '').match(/^\w{10}$/)) {
      return FhdMessenger.error('Nội dung giao dịch phải có 10 kí tự');
    }

    vm.orderIds = vm.orderIds || [];
    vm.orderIds.push(vm.orderId);
    vm.orderId = '';
  };

  vm.removeOrderId = index => {
    vm.orderIds.splice(index, 1);
  };

  vm.changePaymentType = paymentType => {
    vm.saleEntry.paymentType = paymentType;
  };

  vm.changeGift = gift => {
    vm.gift = gift;
  };

  vm.submit = () => {
    if (!vm.saleEntry.paymentType) {
      return FhdMessenger.error('Chưa chọn phương thức thanh toán');
    }

    if (vm.cashReceived > 0) vm.saleEntry.cashReceived = vm.cashReceived;

    if (vm.gift && vm.gift !== 'Không') {
      if (vm.gift === 'Tặng voucher') {
        vm.gift = 'Tặng voucher 20/10';
      }

      vm.saleEntry.notes.push({
        content: vm.gift,
        user: vm.user._id
      });
    }

    if (vm.saleEntry.paymentType === 'transfer') {
      if (!vm.transferCode) {
        return FhdMessenger.error('Phương thức thanh toán này cần mã giao dịch');
      }

      vm.saleEntry.transferCode = vm.transferCode;
    }

    const receivableAmount = vm.saleEntry.order.saleTotal + _.get(vm.saleEntry, 'shipping.collect', 0) - _.get(customerRequest, 'totalDeposit', 0);

    if (vm.saleEntry.paymentType === 'vnpay') {
      vm.saleEntry.partnership = {
        provider: 'vnpay',
        receivableAmount
      };
    }

    if (vm.saleEntry.paymentType === 'momo') {
      vm.saleEntry.partnership = {
        provider: 'momo',
        receivableAmount
      };
    }

    if (vm.saleEntry.paymentType === 'airpay') {
      if (!_.get(vm.orderIds, 'length')) {
        return FhdMessenger.error('Bạn chưa nhập mã giao dịch nào');
      }

      vm.saleEntry.partnership = {
        provider: 'airpay',
        receivableAmount,
        orderIds: vm.orderIds
      };
    }

    $modalInstance.close(vm.saleEntry);
  };

  vm.getSuggestCash = function () {
    if (!_.isNumber(vm.cashReceived)) {
      vm.suggestCash = vm.defaultSuggestCash;
    } else {
      let stepNumber = 1000;

      if (vm.cashReceived >= 1000) {
        stepNumber = 10;
      }

      vm.suggestCash = _.map([1, 10, 100], number => {
        return vm.cashReceived * stepNumber * number;
      });
    }
  };

  vm.getValueForInput = function (sugCash) {
    vm.cashReceived = sugCash;
  };

  vm.dismiss = () => $modalInstance.dismiss();

  vm.close = () => $modalInstance.close(); // handle shortCut with keyCode F8


  function handleF8(event) {
    if (event.key === 'F8') {
      var cashInput = $document[0].querySelector('#cashInput');
      cashInput.focus();
      cashInput.select();
    }

    $scope.$apply();
  }

  $document.on('keydown', handleF8);
  $scope.$on('$destroy', function () {
    $document.unbind('keydown', handleF8);
  });
}]);
"use strict";

angular.module('sale-entries').controller('ModalBubbleTeaComboController', ['comboProduct', '$modalInstance', 'FhdMessenger', function (comboProduct, $modalInstance, FhdMessenger) {
  const vm = this;
  vm.teaProducts = ['B1697', 'B1701', 'B1703', 'B1700', 'B1846', 'B1845'];
  vm.creamProducts = ['B1717', 'B1719', 'B1883', 'B1848'];
  vm.bubbleProducts = ['B1705', 'B1708'];

  vm.addToList = product => {
    if (!product) return;

    if (_.includes(vm.teaProducts, vm.product.sku)) {
      vm.teaProduct = product;
      return;
    }

    if (_.includes(vm.creamProducts, vm.product.sku)) {
      vm.creamProduct = product;
      return;
    }

    if (_.includes(vm.bubbleProducts, vm.product.sku)) {
      vm.bubbleProduct = product;
      return;
    }

    FhdMessenger.error(`Sản phẩm ${product.sku} ${product.description} không thuộc combo này.`);
  };

  vm.cancel = () => $modalInstance.dismiss();

  vm.submit = () => {
    if (!vm.teaProduct || !vm.creamProduct || !vm.bubbleProduct) {
      return FhdMessenger.error('Chưa có đủ sản phẩm trong combo');
    }

    return $modalInstance.close(_.compact([].concat(vm.teaProduct).concat(vm.creamProduct).concat(vm.bubbleProduct)));
  };
}]);
"use strict";

angular.module('sale-entries').controller('ModalChooseMooncakeGiftsController', ['avaiableGifts', '$modalInstance', 'FhdMessenger', 'NgTableParams', 'PromotionService', 'ShockSaleItems', function (avaiableGifts, $modalInstance, FhdMessenger, NgTableParams, PromotionService, ShockSaleItems) {
  const vm = this;
  vm.avaiableGifts = avaiableGifts;

  vm.submit = () => {
    vm.avaiableGifts = _.filter(vm.avaiableGifts, gift => {
      return gift.quantity > 0;
    });

    _.forEach(vm.avaiableGifts, gift => {
      gift.toLock = true;
      gift.giftProgram = 'mooncake';
      gift.soldPrice = 0;
    });

    $modalInstance.close(vm.avaiableGifts);
  };

  vm.checkQuantity = index => {
    if (vm.avaiableGifts[index].quantity > vm.avaiableGifts[index].maxQuantity) {
      vm.avaiableGifts[index].quantity = vm.avaiableGifts[index].maxQuantity;
      vm.avaiableGifts[index].toLock = true;
    }
  };

  vm.cancel = () => {
    $modalInstance.dismiss();
  };
}]);
