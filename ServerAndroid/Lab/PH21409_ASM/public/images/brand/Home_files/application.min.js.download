function _objectSpread(target) { for (var i = 1; i < arguments.length; i++) { var source = arguments[i] != null ? arguments[i] : {}; var ownKeys = Object.keys(source); if (typeof Object.getOwnPropertySymbols === 'function') { ownKeys = ownKeys.concat(Object.getOwnPropertySymbols(source).filter(function (sym) { return Object.getOwnPropertyDescriptor(source, sym).enumerable; })); } ownKeys.forEach(function (key) { _defineProperty(target, key, source[key]); }); } return target; }

function _defineProperty(obj, key, value) { if (key in obj) { Object.defineProperty(obj, key, { value: value, enumerable: true, configurable: true, writable: true }); } else { obj[key] = value; } return obj; }

angular.module('application-forms').controller('ApplicationFormsController', ['$timeout', '$stateParams', '$http', 'Authentication', 'ConfirmModal', 'NgTableParams', 'ApplicationForms', 'ApplicationFormService', 'ApplicationFormsKPIService', 'CustomerService', 'OutletService', 'ObjectId', 'FhdMessenger', 'BusinessService', '$scope', '$q', 'TrainingProgressesService', 'helper', 'UserService', function ($timeout, $stateParams, $http, Authentication, ConfirmModal, NgTableParams, ApplicationForms, ApplicationFormService, ApplicationFormsKPIService, CustomerService, OutletService, ObjectId, FhdMessenger, BusinessService, $scope, $q, TrainingProgressesService, helper, UserService) {
  const vm = this;
  vm.authentication = Authentication;
  vm.user = Authentication.user;
  vm.review = [];
  const seeAllRoles = ['admin', 'tro-ly-ns', 'marketing'];
  vm.openModalViewNewTrainingProgressbyUser = TrainingProgressesService.openModalViewNewTrainingProgressbyUser;

  vm.onChangeSelectedOutlet = selectedOutlets => {
    vm.outlets = _.map(selectedOutlets, '_id');
  };

  vm.openModalCreateTrainingProgress = applicationForm => {
    TrainingProgressesService.openModalCreateTrainingProgress(applicationForm).then(trainingProgress => {
      const roles = UserService.getRoles();

      const matchRole = _.find(roles, {
        id: trainingProgress.role
      });

      vm.applicationForm.note = `Đã tạo training progress cho vị trí ${trainingProgress.employeeType === 'employee' ? 'Chính thức' : 'CTV'} - ${_.get(matchRole, 'label', 'Chưa rõ')}`;
      vm.applicationForm.$updateNote().then(res => {
        FhdMessenger.success(`Đã cập nhật note`);
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
    });
  };

  vm.data = {};
  vm.data.positionInOutlets = ['Nhân viên parttime', 'Nhân viên fulltime', 'Trợ lý parttime', 'Trợ lý fulltime'];
  vm.data.shifts = [{
    name: 'Sáng',
    code: 'S'
  }, {
    name: 'Chiều',
    code: 'C'
  }, {
    name: 'Tối',
    code: 'T'
  }];

  vm.canEditField = function (field) {
    return ['Vị trí ứng tuyển', 'Position', 'Source'].includes(field.label) || field.label.match(/UTM/);
  };

  function convertInterviewerToText(interviewer) {
    return helper.convertObjectToText(interviewer, ['code', 'displayName'], ' - ') || 'Chưa có';
  }

  vm.isShowPositon = false;
  vm.startDate = moment().startOf('day').subtract(1, 'month').format('YYYY-MM-DD');
  vm.endDate = moment().endOf('day').format('YYYY-MM-DD');

  vm.changeHrTask = hrTask => {
    vm.applicationForm.hrTask = hrTask;
    vm.waiting = true;
    vm.applicationForm.$updateHrTask().then(res => {
      vm.applicationForm.interviewerText = convertInterviewerToText(vm.applicationForm.interviewer);
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.loadProcessors = function () {
    OutletService.loadProcessors('hrProcessors').then(_outletGroupByProcessorMap => {
      vm.outletByProcessorTable = _.map(_outletGroupByProcessorMap, byProcessor => {
        return {
          code: byProcessor.code,
          displayName: byProcessor.displayName,
          outletContent: helper.sortByProperty(_.map(byProcessor.outlets, 'code')).join(', ')
        };
      });
    });
  };

  vm.stagesTable = new NgTableParams({
    count: 50
  });

  vm.init = () => {
    vm.stageParams = {}; // load business

    vm.businessPromise = BusinessService.allAsync().then(businesses => {
      vm.data.businesses = _.filter(businesses, {
        deleted: false
      });
      vm.showBusinessMap = _.reduce(vm.data.businesses, (result, business, value) => {
        result[business._id] = {
          value: true,
          business
        };
        return result;
      }, {});
    }); // load position

    vm.positionPromise = ApplicationForms.getAvailablePositions({
      startDate: vm.startDate,
      endDate: vm.endDate
    }).$promise.then(positions => {
      vm.positionMap = _.reduce(positions, (result, position) => {
        result[position] = {
          value: true,
          name: position
        };
        return result;
      }, {});
    }); // load status

    vm.statusMap = {
      created: true,
      confirmed: true,
      interviewed: true,
      probationary: true,
      training: true,
      archived: false,
      employee: false,
      eliminated: false
    };
  };

  $scope.$watch(() => {
    return {
      businessMap: vm.showBusinessMap,
      showOutletMap: vm.showOutletMap
    };
  }, () => {
    _.forEach(_.values(vm.showBusinessMap), business => {
      const businessId = _.get(business, 'business._id');

      const outlets = _.filter(vm.showOutletMap, outlet => {
        return _.get(outlet, 'outlet.business._id') === businessId;
      });

      _.forEach(outlets, outlet => {
        outlet.enable = business.value;
      });
    });
  }, true);
  vm.applicationFormsTable = new NgTableParams({
    count: 50
  });

  vm.find = () => {
    if (!vm.user) return;
    $q.all([vm.businessPromise]).then(() => {
      const statuses = _.reduce(vm.statusMap, (statuses, toShow, status) => {
        if (toShow) statuses.push(status);
        return statuses;
      }, []);

      const positions = _.reduce(vm.positionMap, (result, position, name) => {
        if (position.value) result.push(name);
        return result;
      }, []);

      vm.waiting = true;
      vm.calculatePositionsKpiByStages(vm.outlets, positions);
      vm.applicationForms = ApplicationForms.query({
        omniSearch: vm.omniSearch,
        startDate: vm.startDate,
        endDate: vm.endDate,
        positions: vm.isShowPositon ? positions : undefined,
        statuses,
        outlets: vm.outlets
      });
      vm.applicationForms.$promise.then(() => {
        _.forEach(vm.applicationForms, applicationForm => {
          if (applicationForm.user) {
            applicationForm.user.info = helper.convertObjectToText(applicationForm.user, ['code', 'displayName'], ' ');
          }

          applicationForm.interviewerText = convertInterviewerToText(applicationForm.interviewer);

          if (applicationForm.interviewDate) {
            applicationForm.textInterviewDate = moment(applicationForm.interviewDate).format('DD/MM');
          }

          if (applicationForm.interviewTime) {
            applicationForm.textInterviewTime = moment(applicationForm.interviewTime).format('HH:mm');
          }

          applicationForm.mobileProvider = CustomerService.checkProvider(applicationForm.cellphone) || 'Khác';
        });

        const countByStatus = _.groupBy(vm.applicationForms, 'status');

        vm.allStatuses = _.map(vm.allStatuses, status => _objectSpread({}, status, {
          total: _.get(countByStatus[status.value], 'length', 0)
        }));
        vm.applicationFormsTable.settings({
          dataset: vm.applicationForms
        });

        if (vm.applicationForms && vm.applicationForms.length === 500) {
          FhdMessenger.info('Chỉ hiển thị 500 kết quả đầu tiên. Hãy lọc theo cơ sở hoặc trạng thái để lấy toàn bộ kết quả.');
        }
      }).finally(() => {
        vm.waiting = false;
      });
      FhdMessenger.notifyLoading('Đang tải danh sách ứng viên...', vm.applicationForms.$promise, () => {
        FhdMessenger.success('Tải xong danh sách ứng viên.');
      });
    });
  };

  function getStatusForProbationShiftEntry(probationShiftEntry) {
    if (moment(probationShiftEntry.endTime).isAfter(moment())) {
      return 'Chưa diễn ra';
    }

    if (!probationShiftEntry.hasCome) {
      return 'Không đến';
    }

    if (probationShiftEntry.assessType === 'eliminated') {
      return 'Loại';
    }

    if (probationShiftEntry.assessType === 'choosen') {
      return 'Chọn';
    }

    return 'Chưa rõ';
  }

  vm.getTrainingProgressContent = trainingProgress => {
    if (!trainingProgress.incompletedBlocks.length && !trainingProgress.completedBlock) {
      return 'Chưa có câu hỏi nào trong training progress';
    }

    if (!trainingProgress.incompletedBlocks.length) {
      return 'Đã hoàn thành';
    }

    return trainingProgress.incompletedBlocks.join(', ');
  };

  vm.findTrackingApplicationForm = () => {
    vm.waiting = true;
    vm.applicationForms = ApplicationForms.tracking({
      outlets: vm.outlets
    });
    vm.applicationForms.$promise.then(() => {
      _.forEach(vm.applicationForms, applicationForm => {
        if (!applicationForm.numShift) {
          applicationForm.numShift = 0;
        }

        applicationForm.shiftPercent = Math.round(applicationForm.numShift / _.get(applicationForm, 'workPosition.numProbationShift', 1) * 100);
        applicationForm.mobileProvider = CustomerService.checkProvider(applicationForm.cellphone) || 'Khác';

        _.forEach(applicationForm.probationShiftEntries, probationShiftEntry => {
          probationShiftEntry.status = getStatusForProbationShiftEntry(probationShiftEntry);
        });
      });

      vm.applicationFormsTable.settings({
        dataset: vm.applicationForms
      });
    }).finally(() => {
      vm.waiting = false;
    });
    FhdMessenger.notifyLoading('Đang tải danh sách ứng viên...', vm.applicationForms.$promise, () => {
      FhdMessenger.success('Tải xong danh sách ứng viên.');
    });
  };

  vm.changeAddedToGroup = applicationForm => {
    vm.waiting = true;
    applicationForm.$changeAddedToGroup().then(applicationForm => {
      FhdMessenger.success(`Đánh dấu ${applicationForm.addedToGroup ? 'đã' : 'chưa'} thêm vào nhóm thử việc thành công`);
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.changeAddedToSlack = applicationForm => {
    vm.waiting = true;
    applicationForm.$changeAddedToSlack().then(applicationForm => {
      FhdMessenger.success(`Đánh dấu ${applicationForm.addedToSlack ? 'đã' : 'chưa'} thêm vào slack thành công`);
    }).catch(err => FhdMessenger.errorFromServer(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.isSameDate = (startDate, endDate) => {
    return moment(startDate).isSame(endDate, 'day');
  };

  vm.calculateStages = () => {
    if (vm.stageParams.startDate && vm.stageParams.endDate && moment(vm.stageParams.startDate).isAfter(vm.stageParams.endDate)) {
      return FhdMessenger.error('Ngày bắt đầu phải nhỏ hơn ngày kết thúc');
    }

    vm.waiting = true;
    let promise = $q(resolve => {
      const applicationsForms = $http.get('/application-forms/calculate-stages', {
        params: vm.stageParams
      });
      resolve(applicationsForms);
    });
    FhdMessenger.notifyLoading('Đang tính toán...', promise);
    promise.then(({
      data
    }) => {
      const {
        totalStages,
        usersStages
      } = data;
      FhdMessenger.success('Tính toán xong !');
      vm.totalStages = totalStages;
      vm.stagesTable.settings({
        dataset: usersStages
      });
    }).catch(err => {
      return FhdMessenger.errorFromServer(err);
    }).finally(() => {
      vm.waiting = false;
    });
  };

  vm.findOne = () => {
    ApplicationForms.get({
      applicationFormId: $stateParams.applicationFormId
    }).$promise.then(applicationForm => {
      vm.applicationForm = applicationForm;
      vm.oldHrTask = applicationForm.hrTask;
      vm.applicationForm.interviewerText = convertInterviewerToText(vm.applicationForm.interviewer);
    });
  };

  vm.selectAll = function (selectType) {
    switch (selectType) {
      case 'status':
        {
          let changeValue = true;
          if (_.every(vm.statusMap)) changeValue = false;

          _.forEach(vm.statusMap, (value, key) => {
            vm.statusMap[key] = changeValue;
          });

          break;
        }

      case 'outlet':
        {
          let changeValue = true;
          if (_.every(_.map(vm.showOutletMap, 'value'))) changeValue = false;

          _.forEach(vm.showOutletMap, (outlet, key) => {
            vm.showOutletMap[key].value = changeValue;
          });

          break;
        }

      case 'positions':
        {
          let changeValue = true;
          if (_.every(_.map(vm.positionMap, 'value'))) changeValue = false;

          _.forEach(vm.positionMap, (value, key) => {
            vm.positionMap[key].value = changeValue;
          });

          break;
        }

      default:
    }
  };

  vm.activeStatuses = [{
    value: 'created',
    className: 'label-default'
  }, {
    value: 'confirmed',
    className: 'label-primary'
  }, {
    value: 'interviewed',
    className: 'label-ready'
  }, {
    value: 'probationary',
    className: 'label-primary'
  }, {
    value: 'training',
    className: 'label-warning'
  }, {
    value: 'employee',
    className: 'label-success'
  }, {
    value: 'archived',
    className: 'label-primary'
  }];
  vm.allStatuses = [...vm.activeStatuses, {
    value: 'eliminated',
    className: 'label-danger'
  }];

  vm.updateStatus = status => {
    if (!vm.applicationForm.hrTask) {
      return FhdMessenger.error('Bạn chưa cập nhật HR Task cho hồ sơ này');
    }

    if (!vm.applicationForm.positionInOutlet) {
      return FhdMessenger.error('Bạn chưa cập nhật vị trí tại cơ sở cho hồ sơ này');
    }

    if (status === 'interviewed' && !_.get(vm.applicationForm, 'interviewer')) {
      return FhdMessenger.error('Chưa có người phỏng vấn. Vui lòng điền người phỏng vấn sau đó ấn cập nhật để lưu người phỏng vấn rồi mới chuyển trạng thái');
    }

    vm.applicationForm.status = status;
    let notice = '';

    switch (status) {
      case 'created':
        notice = 'Mới tạo';
        break;

      case 'confirmed':
        notice = 'Đã xác nhận phỏng vấn';
        break;

      case 'interviewed':
        notice = 'Đã phỏng vấn';
        break;

      case 'probationary':
        notice = 'Học việc';
        break;

      case 'training':
        notice = 'Thử việc';
        break;

      case 'employee':
        notice = 'Nhân viên chính thức';
        break;

      default:
        break;
    }

    vm.waiting = true;
    $http.put(`/application-forms/${vm.applicationForm._id}/${vm.applicationForm.status}`).then(response => {
      const note = {
        content: `Đã chuyển trạng thái <strong>${notice}</strong>`,
        user: vm.user
      };
      $http.put(`/application-forms/${vm.applicationForm._id}/update-notes`, note).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
      FhdMessenger.success(`Đã chuyển thành trạng thái: ${notice}`);
    }).catch(err => {
      FhdMessenger.errorFromServer(err);
    }).finally(() => $timeout(() => {
      vm.waiting = false;
    }, 500));
  };

  vm.restore = () => {
    vm.updateStatus('created');
  };

  vm.showPosition = () => {
    vm.isShowPositon = !vm.isShowPositon;
  };

  vm.outdate = () => {
    ConfirmModal.showModal({}, {
      bodyText: 'Bạn có chắc muốn bỏ qua hồ sơ này? Ứng viên sẽ KHÔNG nhận một email nào thông báo về tình trạng hồ sơ bị bỏ qua.'
    }).then(() => {
      vm.applicationForm.status = 'outdate';
      vm.waiting = true;
      $http.put(`/application-forms/${$stateParams.applicationFormId}/outdate`).then(response => {
        FhdMessenger.success('Đã bỏ qua hồ sơ này!');
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      }).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.eliminate = () => {
    ApplicationFormService.openEmliminateApplicationFormModal(vm.applicationForm);
  };

  vm.archived = () => {
    ApplicationFormService.openArchivedApplicationFormModal(vm.applicationForm);
  };

  vm.openCreateEvaluationForm = () => {
    ApplicationFormService.openCreateEvaluationForm(vm.applicationForm);
  };

  vm.openSelectProbationShiftEntriesModal = ApplicationFormService.openSelectProbationShiftEntriesModal;

  vm.openCreateStaffApplicationFormModal = function (applicationForm) {
    ApplicationFormService.openCreateStaffApplicationFormModal(applicationForm).result.then(staff => {
      applicationForm.staff = staff._id;
      applicationForm.note = `Đã tạo người dùng ${staff.code} - ${staff.displayName}`;
      vm.waiting = true;
      applicationForm.$update().then(applicationForm => {
        FhdMessenger.success(`Đã tạo người dùng ${staff.code} - ${staff.displayName} thành công`);
      }).catch(err => FhdMessenger.error(err)).finally(() => {
        vm.waiting = false;
      });
    });
  };

  vm.openInfoModal = function (applicationForm) {
    ApplicationFormService.openInfoModal(vm.applicationForm);
  };

  vm.openModalSendEmail = ApplicationFormService.openModalSendEmail;
  vm.openModalSelectEmailType = ApplicationFormService.openModalSelectEmailType;

  vm.openModalEditProcessorsApplicationForm = function (applicationForm) {
    ApplicationFormService.openModalEditProcessorsApplicationForm(applicationForm);
  };

  vm.update = () => {
    if (vm.cellphone && vm.fullName) {
      vm.applicationForms = vm.applicationForms || [];
      vm.applicationForms.push({
        fullName: vm.fullName,
        phone: vm.cellphone
      });
    }

    if (vm.newNote) {
      vm.applicationForm.note = vm.newNote;
    }

    const applicationForm = vm.applicationForm;
    vm.waiting = true;
    applicationForm.$update().then(res => {
      vm.applicationForm.interviewerText = convertInterviewerToText(vm.applicationForm.interviewer);
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.changeMarkBlackList = (applicationForm, index) => {
    if (!applicationForm.isBlackList) {
      ApplicationFormService.openInputBlackListNote(applicationForm._id).result.then(newApplicationForm => {
        vm.applicationForms[index].isBlackList = true;
        vm.applicationForms[index].status = 'eliminated';
      });
    } else {
      applicationForm.$changeMarkBlackList().then(() => {
        if (applicationForm.isBlackList) {
          FhdMessenger.success('Đã đánh dấu Black List');
        } else {
          FhdMessenger.success('Đã bỏ đánh dấu Black List');
        }
      }).catch(err => {
        FhdMessenger.errorFromServer(err);
      });
    }
  };

  vm.kpisTable = new NgTableParams({
    count: 50,
    sorting: {
      position: 'asc'
    }
  });

  vm.calculatePositionsKpiByStages = function (outlets, positions) {
    if (seeAllRoles) {
      OutletService.allAsync().then(() => {
        vm.waiting = true;
        const promise = ApplicationFormsKPIService.calculatePositionsKpiByStages({
          startDate: vm.startDate,
          endDate: vm.endDate,
          outlets,
          positions: vm.isShowPositon ? positions : undefined
        });
        promise.then(positionsKPIs => {
          vm.kpisTable.settings({
            dataset: positionsKPIs
          });
          return FhdMessenger.success('Tính KPI thành công');
        }).catch(err => {
          return FhdMessenger.errorFromServer(err);
        }).finally(() => {
          vm.waiting = false;
        });
        FhdMessenger.notifyLoading('Đang tính toán KPI...', promise);
      });
    }
  };

  vm.viewApplicationForms = ApplicationFormService.openViewApplicationFormModal;

  vm.sendApplicationForm = function () {
    vm.waiting = true;
    new ApplicationForms(vm.importForm).$importForm().then(res => {
      FhdMessenger.success('Thêm thành công'); // reset form

      vm.importData = '';
      vm.importForm = [];
    }).catch(FhdMessenger.errorFromServer).finally(() => {
      vm.waiting = false;
    });
  };

  vm.removeProbationShiftEntry = (probationShiftEntry, index) => {
    ConfirmModal.showModal({}, {
      actionButtonText: `Xác nhận`,
      headerText: `Xóa lịch học việc `,
      bodyText: `Bạn chắc chắn muốn xoá lịch học việc thí sinh: ${vm.applicationForm.fullName}
          Ngày: ${moment(probationShiftEntry.date).format('L')}
          Thời gian: ${moment(probationShiftEntry.startTime).format('LTa')} - ${moment(probationShiftEntry.endTime).format('LTa')}
          Cơ sở: ${probationShiftEntry.outletCode}`
    }).then(() => {
      $http.put(`/application-forms/${vm.applicationForm._id}/remove-probation-shift`, probationShiftEntry).then(() => {
        FhdMessenger.success('Xoá thành công');
      }).catch(err => {
        return FhdMessenger.error(err.message);
      });
    });
  };

  vm.changeCurrentTab = tab => {
    vm.currentTab = tab;
  };

  vm.convertDataToAplicationForm = () => {
    vm.importForm = [];
    let lines = vm.importData.split(/\r?\n/);

    _.forEach(lines, line => {
      if (!line.includes(':')) {
        const lastImportForm = _.last(vm.importForm);

        lastImportForm.value += ', ' + line;
        return;
      }

      let name;
      let value;

      if (line.includes('Bạn có thể làm được bao nhiêu')) {
        name = line.split(/(.+):/)[1].trim();
        value = line.split(/(.+):/)[2].trim();
      } else {
        name = line.split(/:(.+)/)[0].trim(); // split từ dấu hai chấm đầu tiên

        value = line.split(/:(.+)/)[1].trim();
      }

      let form = {
        name: name,
        value: value
      };
      vm.importForm.push(form);
    });
  };

  vm.addNote = note => {
    vm.applicationForm.note = note;
    vm.waiting = true;
    vm.applicationForm.$update().then(res => {
      vm.applicationForm.interviewerText = convertInterviewerToText(vm.applicationForm.interviewer);
      FhdMessenger.success('Cập nhật thành công');
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.onUploadChange = files => {
    vm.applicationForm.files = files;
    vm.waiting = true;
    vm.applicationForm.$updateFiles().then(() => {
      return FhdMessenger.success('Cập nhật hồ sơ cho application form thành công !');
    }).catch(err => FhdMessenger.error(err)).finally(() => {
      vm.waiting = false;
    });
  };

  vm.showButtonSendInterviewedEmail = () => {
    return _.get(vm.applicationForm, 'email') && _.get(vm.applicationForm, 'linkGoogleMeet') && _.get(vm.applicationForm, 'interviewTime') && _.get(vm.applicationForm, 'interviewer') && _.get(vm.applicationForm, 'hrTask') && _.get(vm.applicationForm, 'positionInOutlet') && _.get(vm.applicationForm, 'interviewDate');
  };

  vm.showButtonSendTrainingEmail = () => {
    return ['probationary'].includes(_.get(vm.applicationForm, 'status')) && vm.applicationForm.probationShiftEntries.length;
  };

  vm.showButtonSendInterviewedResultEmail = () => {
    return ['confirmed'].includes(_.get(vm.applicationForm, 'status'));
  };
}]);
'use strict';

angular.module('application-forms').controller('CalendarProbationShiftsController', ['$scope', 'FhdMessenger', '$compile', 'ApplicationFormService', 'ObjectId', 'uiCalendarConfig', 'ProbationShiftEntries', function ($scope, FhdMessenger, $compile, ApplicationFormService, ObjectId, uiCalendarConfig, ProbationShiftEntries) {
  const vm = this;
  vm.events = []; // vm.positions = []

  vm.eventClick = event => {
    ApplicationFormService.openInfomationProbationShiftsModal(event);
  };

  vm.find = async function () {
    vm.waiting = true;
    const calendar = uiCalendarConfig.calendars.probationShiftCalendar;
    await calendar.fullCalendar('refetchEvents');
    vm.waiting = false;
  };

  $scope.$watch(() => vm.workPosition, function (newValue, oldValue) {
    if (newValue === oldValue) return;
    vm.find();
  });

  function numStaffApplicationFormByStatus(applicationForms, _id, prop) {
    return _.size(_.filter(applicationForms, applicationForm => {
      return _.filter(applicationForm.applicationForm.probationShiftEntries, shift => {
        return ObjectId.equals(shift._id, _id) && _.get(shift, prop);
      }).length;
    }));
  }

  vm.eventRender = (event, element) => {
    const {
      outlet,
      startTime,
      applicationForms,
      workPositions,
      endTime,
      _id
    } = event;

    const header = `<strong>${outlet.code}: ${moment(startTime).format('LT')} - ${moment(endTime).format('LT')} </br> (${numStaffApplicationFormByStatus(applicationForms, _id, 'hasCome')}
      /${numStaffApplicationFormByStatus(applicationForms, _id, 'confirmed')}
      /${_.get(applicationForms, 'length', 0)})</strong></br>` + _.map(workPositions, 'name').join('<br>');

    const contentElm = element.find('.fc-content');
    contentElm.prepend(`<div class=".fc-time">${header}</div>`);
    $compile(element)($scope);
  };

  vm.uiConfig = {
    height: 800,
    editable: true,
    header: {
      left: 'title',
      center: '',
      right: 'today month basicWeek prev,next'
    },
    firstDay: 1,
    weekNumbers: 4,
    defaultView: 'basicWeek',
    businessHours: {
      start: '08:00',
      end: '22:00'
    },
    eventClick: vm.eventClick,
    timezone: 'Asia/Ho_Chi_Minh',
    displayEventTime: false,
    eventOrder: ['start'],
    weekNumberCalculation: 'ISO',
    eventRender: vm.eventRender,
    lang: 'vi'
  };
  vm.eventSources = [{
    url: '/probation-shift-entries/calendar',
    data: {
      workPosition: () => _.get(vm, 'workPosition._id')
    },
    color: 'white',
    textColor: '#191919',
    borderColor: '#ABABAC',
    cache: true
  }];
}]);
"use strict";

angular.module('application-forms').controller('ModalArchivedApplicationFormController', ['$modalInstance', 'applicationForm', 'Authentication', '$http', 'FhdMessenger', '$state', function ($modalInstance, applicationForm, Authentication, $http, FhdMessenger, $state) {
  const vm = this;
  vm.user = Authentication.user;
