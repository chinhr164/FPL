<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/cdn/bootstrap/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/cdn/datatables/css/dataTables.bootstrap5.css" />
  <link rel="stylesheet" href="/cdn/datatables/css/dataTables.semanticui.css" />
  <link rel="stylesheet" href="/stylesheets/signin.css" />
  <link rel="shortcut icon" href="/images/brand/logoH'Patisserie.png" type="image/x-icon">
