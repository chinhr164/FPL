      <nav class="navbar py-0 navbar-expand-sm navbar-light bg-light px-3">
        <div class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link active" href="/">H'Patisserie</a>
          </li>
        </div>
        <div class="nav-item dropdown me-3 d-sm-none">
