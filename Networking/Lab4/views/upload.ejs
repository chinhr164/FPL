<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../public/stylesheets/output.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Upload</title>
  </head>
  <body class="mx-6">
    <form action="" method="post" enctype="multipart/form-data">
      <input type="hidden" name="type" id="add" />
      <!-- <input type="file" name="img" id="" /> -->
      <div class="font-[sans-serif] max-w-md mx-auto">
        <input
          type="file"
          name="img"
          class="w-full my-2 text-gray-400 font-semibold text-sm bg-white border file:cursor-pointer cursor-pointer file:border-0 file:py-3 file:px-4 file:mr-4 file:bg-gray-100 file:hover:bg-gray-200 file:text-gray-500 rounded"
        />

        <label
          class="flex bg-gray-800 hover:bg-gray-700 text-white text-base px-5 py-3 outline-none rounded w-max cursor-pointer mx-auto font-[sans-serif]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 mr-2 fill-white inline"
            viewBox="0 0 32 32"
          >
            <path
              d="M23.75 11.044a7.99 7.99 0 0 0-15.5-.009A8 8 0 0 0 9 27h3a1 1 0 0 0 0-2H9a6 6 0 0 1-.035-12 1.038 1.038 0 0 0 1.1-.854 5.991 5.991 0 0 1 11.862 0A1.08 1.08 0 0 0 23 13a6 6 0 0 1 0 12h-3a1 1 0 0 0 0 2h3a8 8 0 0 0 .75-15.956z"
              data-original="#000000"
            />
            <path
              d="M20.293 19.707a1 1 0 0 0 1.414-1.414l-5-5a1 1 0 0 0-1.414 0l-5 5a1 1 0 0 0 1.414 1.414L15 16.414V29a1 1 0 0 0 2 0V16.414z"
              data-original="#000000"
            />
          </svg>
          <button type="submit">Upload</button>
        </label>
      </div>
    </form>
    <h2 class="text-4xl font-extrabold text-center text-gray-800 mt-6 mb-5">
      Bộ sưu tập
    </h2>
    <div
      class="grid grid-cols-1 md:grid-cols-2 m lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-6 items-center"
    >
      <% image.forEach(img => {%>
      <div
        class="rounded-xl cursor-pointer hover:scale-[1.03] transition-all relative overflow-hidden"
      >
        <img src="../images/uploads/<%= img %>" alt="" />
      </div>
      <% }); %>
    </div>
  </body>
</html>
